                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} g^{r-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &gt;
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r \gt R
              then by assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo −
                            %mn 1
                            %mo ,
                            %mi t
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g^{r-1}|_{D^{s-1,t}} = 0
              and so then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mrow
                          %mi r
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(d_{r-1}) = im(h)
            %p
              (Beware this subtlety: while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %msub
                          %mi R
                          %mrow
                            %mi s
                            %mo ,
                            %mi t
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo −
                            %mn 1
                            %mo ,
                            %mi t
                  %annotation{:encoding => "application/x-tex"} g^{R_{s,t}}|_{D^{s-1,t}}
              vanishes by the convergence assumption, the expression
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %msub
                          %mi R
                          %mrow
                            %mi s
                            %mo ,
                            %mi t
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                            %mo ,
                            %mi t
                            %mo −
                            %mi r
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} g^{R_{s,t}}|_{D^{s+r-1,t-r+1}}
              need not vanish yet. Only the higher power
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %msub
                          %mi R
                          %mrow
                            %mi s
                            %mo ,
                            %mi t
                        %mo +
                        %msub
                          %mi R
                          %mrow
                            %mi s
                            %mo +
                            %mn 1
                            %mo ,
                            %mi t
                            %mo +
                            %mn 2
                        %mo +
                        %mn 2
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                            %mo ,
                            %mi t
                            %mo −
                            %mi r
                            %mo +
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} g^{R_{s,t}+ R_{s+1,t+2}+2}|_{D^{s+r-1,t-r+1}}
              is again guaranteed to vanish. )
            %p#InfinityPage It follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mn ∞
                              %mrow
                                %mi p
                                %mo ,
                                %mi n
                                %mo −
                                %mi p
                          %mtd
                            %mo =
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mi R
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mi R
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mi R
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mi R
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mi f
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mi R
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mrow
                                %mi R
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ∩
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E_\infty^{p,n-p}
                    \&amp; =
                    ker(d_R)/im(d_R)
                    \\\
                    \&amp;
                    \\simeq
                    f^{-1}(im(g^{R-1}))/im(h)
                    \\\
                    \&amp;
                    \\simeq
                    f^{-1}(im(g^{R-1}))/ker(f)
                    \\\
                    \&amp;
