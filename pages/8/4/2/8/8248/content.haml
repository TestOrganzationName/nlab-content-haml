                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 3
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 2
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    X_3
                    \&amp;\stackrel{f_2}{\longrightarrow}&amp;
                    X_2
                    \&amp;\stackrel{f_2}{\longrightarrow} &amp;
                    X_1
                    \&amp;\stackrel{f_1}{\longrightarrow}&amp;
                    X
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; A_3 &amp;&amp; A_2 &amp;&amp; A_1 &amp;&amp; A_0
                    }
            %p
              and its induced
              %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              %a.maruku-ref{:href => "#UnrolledExactCoupleOfAFiltrationOnASpectrum"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi k
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D} &amp;\stackrel{i}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    \&amp;{}_{\mathllap{k}}\nwarrow&amp; \downarrow^{\mathrlap{j}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
                    \\;\;\;\;\;\,\;\;\;\;\;\;
                    \\array{
                    \\mathcal{D} &amp;\stackrel{(-1,-1)}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    \&amp;{}_{\mathllap{(1,0)}}\nwarrow&amp; \downarrow^{\mathrlap{(0,0)}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
            %p with bigrading as shown on the right.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://ncatlab.org/nlab/files/adamstypedifferentials.jpg", :width => "360"}/
            %p
              As we pass to derived exact couples, by def.
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is preserved, but that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              increases by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,1)
              in each step, since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ∘
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(\tilde j) = deg( j \circ im(i)^{-1}) = deg(j) + (1,1)
                    \\,.
            %p
              Therefore the induced
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              has differentials of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ⟶
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo +
                        %mi r
                        %mo ,
                        %mi t
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_r \;\colon\; \mathcal{E}_r^{s,t} \longrightarrow \mathcal{E}_r^{s+r, t+r-1}
                    \\,.
          %h2#references References
          %p The original article is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/W.+S.+Massey"}> W. S. Massey
              ,
              = succeed "," do
                %em Exact Couples in Algebraic Topology (Parts I and II)
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/massey6.pdf"} pdf
          %p also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"}> Beno Eckmann
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
              = succeed "," do
                %em Exact couples in an abelian category
              = succeed ")" do
                %a{:href => "http://www.sciencedirect.com/science/article/pii/0021869366900196"} jorunal
          %p
            A class of examples leading to what later came to be known as the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            is discussed in section XV.7 of
          %ul
            %li#CartanEilenberg56
              %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} Samuel Eilenberg
              = succeed "," do
                %em Homological algebra
          %p Textbook accounts include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
                , part III, section 7 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Stable+homotopy+and+generalised+homology"} Stable homotopy and generalised homology
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 2.2 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#McCleary01
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+McCleary"}> John McCleary
                , section 2.2 (from p. 37 on) in
                = succeed "," do
                  %em
                    %a{:href => "https://pages.vassar.edu/mccleary/books/users-guide-to-spectral-sequences/"} A user’s guide to spectral sequences
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                , section 5.9
                %em
                  %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
          %p
            Another review with an eye towards application to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"}> Doug Ravenel
              , chapter 2, section 1 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Complex+cobordism+and+stable+homotopy+groups+of+spheres"} Complex cobordism and stable homotopy groups of spheres
