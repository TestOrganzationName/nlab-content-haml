                    D_2 &amp;&amp; \stackrel{g_2}{\longrightarrow} &amp;&amp; D_2
                    \\\
                    \&amp; {}_{\mathllap{f_2}}\nwarrow &amp;&amp; \swarrow_{\mathrlap{h_2}}
                    \\\
                    \&amp;&amp; E_2
                    }
            %p is itself an exact couple. Accordingly there is induced a sequence of exact couples
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi D
                              %mi r
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mi r
                          %mtd
                          %mtd
                            %msub
                              %mi D
                              %mi r
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mi r
                            %mo ↖
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi h
                                    %mi r
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D_r &amp;&amp; \stackrel{g_r}{\longrightarrow} &amp;&amp; D_r
                    \\\
                    \&amp; {}_{\mathllap{f_r}}\nwarrow &amp;&amp; \swarrow_{\mathrlap{h_r}}
                    \\\
                    \&amp;&amp; E_r
                    }
                    \\,.
            %p
              If the abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are equipped with
              %a.existingWikiWord{:href => "/nlab/show/bigraded+object"} bigrading
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    deg(f) = (0,0)\,,\;\;\;\; deg(g) = (-1,1)\,,\;\;\; deg(h) = (1,0)
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo ,
                    %msub
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E_r^{\bullet,\bullet}, d_r\}
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi r
                          %mtd
                            %mo ≔
                            %msub
                              %mi h
                              %mi r
                            %mo ∘
                            %msub
                              %mi f
                              %mi r
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi h
                            %mo ∘
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi r
                                %mo +
                                %mn 1
                            %mo ∘
                            %mi f
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_r &amp; \coloneqq h_r \circ f_r
                    \\\
                    \&amp; = h \circ g^{-r+1} \circ f
                    \\end{aligned}
            %p
              is a cohomological spectral sequence, def.
              = succeed "." do
                %a.maruku-ref{:href => "#CohomologySpectralSequence"}
            %p
              (As before in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CohomologicalSpectralSequenceOfAnExactCouple"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                  %annotation{:encoding => "application/x-tex"} g^{-n}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              denotes the function given by choosing, on representatives, a
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mi n
                      %mo =
                      %munder
                        %munder
                          %mrow
                            %mi g
                            %mo ∘
                            %mi ⋯
                            %mo ∘
                            %mi g
                            %mo ∘
                            %mi g
                          %mo ⏟
                        %mrow
                          %mi n
                          %mspace{:width => "thickmathspace"}
                          %mi times
                    %annotation{:encoding => "application/x-tex"} g^n = \underset{n\;times}{\underbrace{g \circ \cdots \circ g \circ g}}
            %p
              If for every bidegree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s,t)
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ≫
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} R_{s,t} \gg 1
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %msub
                      %mi R
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} r \geq R_{s,t}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo +
                            %mi R
                            %mo ,
                            %mi t
                            %mo −
                            %mi R
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo +
                            %mi R
                            %mo −
                            %mn 1
                            %mo ,
                            %mi t
                            %mo −
                            %mi R
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} g \colon D^{s+R,t-R} \stackrel {\simeq}{\longrightarrow} D^{s+R -1, t-R-1}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo −
                            %mi R
                            %mo +
                            %mn 1
                            %mo ,
                            %mi t
                            %mo +
                            %mi R
                            %mo −
                            %mn 2
                        %mover
                          %mo ⟶
                          %mn 0
                        %msup
                          %mi D
                          %mrow
                            %mi s
                            %mo −
                            %mi R
                            %mo ,
                            %mi t
                            %mo +
                            %mi R
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} g\colon D^{s-R+1, t+R-2} \stackrel{0}{\longrightarrow} D^{s-R,t+R-1}
            %p
              then this spectral sequence converges to the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mo •
                    %mo ≔
                    %munder
                      %mi lim
                      %mrow
                    %mrow
                      %mo (
                      %mi ⋯
                      %mover
                        %mo →
                        %mi g
                      %msup
                        %mi D
                        %mrow
                          %mi s
                          %mo ,
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi s
                      %mover
                        %mo ⟶
                        %mi g
                      %msup
                        %mi D
                        %mrow
                          %mi s
                          %mo −
                          %mn 1
                          %mo ,
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi s
                          %mo +
                          %mn 1
                      %mover
                        %mo →
                        %mi g
                      %mi ⋯
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    G^\bullet \coloneqq \underset{}{\lim}
                    \\left(
                    \\cdots \stackrel{g}{\to} D^{s,\bullet-s} \stackrel{g}{\longrightarrow} D^{s-1, \bullet - s + 1}
                    \\stackrel{g}{\to}
                    \\cdots
                    \\right)
            %p filtered by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi p
                    %msup
                      %mi G
                      %mo •
                    %mo ≔
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mo •
                    %mo →
                    %msup
                      %mi D
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                        %mo ,
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^p G^\bullet \coloneqq ker(G^\bullet \to D^{p-1, \bullet - p+1})
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Kochmann96"} Kochmann 96, lemma 2.6.2
          .proof
            %h6#proof Proof
            %p
              We check the claimed form of the
              = succeed "-page:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(h) = im(g)
              in the exact couple, the kernel
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ∘
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi r
                        %mo +
                        %mn 2
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ker(d_{r-1}) \coloneqq ker(h \circ g^{-r+2} \circ f)
            %p
              consists of those elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi r
                          %mo +
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g^{-r+2} (f(x)) = g(y)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ≃
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mrow
                        %mi s
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                        %mo ,
                        %mi t
                        %mo −
                        %mi r
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ker(d_{r-1})^{s,t} \simeq f^{-1}(g^{r-1}(D^{s+r-1,t-r+1}))
                    \\,.
            %p
              By assumption there is for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s,t)
              an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} R_{s,t}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %msub
                      %mi R
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} r \geq R_{s,t}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} ker(d_{r-1})^{s,t}
              is independent of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mrow
                        %mi r
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(d_{r-1})
              consists of the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              of those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi D
                      %mrow
                        %mi s
                        %mo −
                        %mn 1
                        %mo ,
                        %mi t
                  %annotation{:encoding => "application/x-tex"} x \in D^{s-1,t}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mi r
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g^{r-2}(x)
              is in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(f) = ker(g)
              by exactness of the exact couple) such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mi r
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g^{r-2}(x)
              is in the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is in the kernel of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mrow
