                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    im(g) &amp;&amp; \stackrel{g}{\longrightarrow} &amp;&amp; im(g)
                    \\\
                    \&amp; {}_{\mathllap{f}}\nwarrow &amp;&amp; \swarrow_{\mathrlap{h \circ g^{-1}}}
                    \\\
                    \&amp;&amp; H(E, h \circ f)
                    }
                    \\,.
          %p
            Here and in the following we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} g^{-1}
            etc. for the operation of choosing a
            %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
            under a given function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
