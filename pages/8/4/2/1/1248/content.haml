                %a.existingWikiWord{:href => "/nlab/show/Lawvere%27s+fixed+point+theorem"} Lawvere's fixed point theorem
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\colon S \to (S \to V)
              be any function, and consider the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} g\colon S \to V
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} g(a) = n(f(a)(a)) .
            %p
              That is, if one uses
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
              to interpret
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as a function from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S \times S
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is defined using the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+map"} diagonal map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \Delta_S
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Δ
                          %mi S
                    %mi S
                    %mo ×
                    %mi S
                    %mover
                      %mo →
                      %mi f
                    %mi V
                    %mover
                      %mo →
                      %mi n
                    %mi V
                    %mo .
                  %annotation{:encoding => "application/x-tex"} S \stackrel{\Delta_S}\to S \times S \stackrel{f}\to V \stackrel{n}\to V .
            %p
              Now suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
