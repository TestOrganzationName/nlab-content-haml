                %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
          #johnstone.num_theorem
            %h6#theorem_4 Theorem
            %p (Johnstone's version.)
            %p
              Given a set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}S
              cannot be expressed as a
              %a.existingWikiWord{:href => "/nlab/show/subquotient"} subquotient
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          .proof
            %h6#proof_4 Proof
            %p
              Suppose we had a set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ↪
                    %mi S
                  %annotation{:encoding => "application/x-tex"} i\colon B \hookrightarrow S
              and a surjection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo →
                      %mi 𝒫
                      %mi S
                    %annotation{:encoding => "application/x-tex"} f\colon B \to \mathcal{P}S
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒫
                    %mi S
                    %mo →
                    %mi 𝒫
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i^*\colon\mathcal{P}S \to \mathcal{P}B
              would be a surjection (because
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %msub
                        %mo ∃
                        %mi i
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi 𝒫
                          %mi B
                    %annotation{:encoding => "application/x-tex"} i^\ast \exists_i = 1_{\mathcal{P}B}
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒫
                    %mi B
                    %mo →
                    %mi 𝒫
                    %mi 𝒫
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \exists_f\colon \mathcal{P}B \to \mathcal{P}\mathcal{P}S
              (because
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mi f
                      %msup
                        %mi f
                        %mo *
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi 𝒫
                          %mi 𝒫
                          %mi S
                    %annotation{:encoding => "application/x-tex"} \exists_f f^\ast = 1_{\mathcal{P}\mathcal{P}S}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %mi S
                      %mo →
                      %mi 𝒫
                      %mi 𝒫
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}S \to \mathcal{P}\mathcal{P}S
              = succeed "." do
                %a.maruku-ref{:href => "#cantor"}
          %h2#interpretation Interpretation
          %p
            Note that there exists an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}S
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            map. So in the arithmetic of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cardinal+numbers"} cardinal numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi 𝒫
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo .
                %annotation{:encoding => "application/x-tex"} {|S|} \leq {|\mathcal{P}S|} .
          %p
            But as there is no such surjection, there certainly is no
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo ≠
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi 𝒫
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo .
                %annotation{:encoding => "application/x-tex"} {|S|} \ne {|\mathcal{P}S|} .
          %p So we conclude that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi 𝒫
                    %mi S
                    %mo{:stretchy => "false"} |
                  %mo .
                %annotation{:encoding => "application/x-tex"} {|S|} \lt {|\mathcal{P}S|} .
          %p That is, each set is strictly smaller in cardinality than its power set.
          %p
            This interpretation relies on a good relationship between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                %annotation{:encoding => "application/x-tex"} =
            on the class of cardinal numbers; in particular, the Cantor–Schroeder–Bernstein theorem that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/antisymmetric+relation"} antisymmetric
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            = succeed "," do
              %a.maruku-ref{:href => "#taylor"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            as relative size is problematic —indeed almost as problematic as the idea that there are fewer even integers than integers!
          %p
            %a.existingWikiWord{:href => "/nlab/show/Paul+Taylor"} Paul Taylor
            has argued that the essential value of Cantor's Theorem is the lemma, implicit in Cantor's proof, that
            %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
            isolated as Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#lawvere"}
            %a.maruku-ref{:href => "#cantor"}
            is meaningful only in a specific set-theoretic context (particularly, one where the Cantor–Schroeder–Bernstein theorem holds), it may not survive a ‘revolution’ that overthrows the primacy of that context. But Lawvere's lemma will survive, since it ‘does the work’ while Cantor's theorem ‘takes the credit’. (See
            %a{:href => "#Taylor2009"} Taylor 2009
            below for further discussion of ‘Lemmas that do the work and Theorems that take the credit’.)
          %h2#in_posets In posets
          %p
            A theorem analogous to Cantor’s theorem for sets can be formulated for other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mn 2
                    %mi X
                %annotation{:encoding => "application/x-tex"} X \to 2^X
            between posets, where the base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is not the discrete poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0, 1\}
            but rather the order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ≤
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0 \leq 1\}
          %p
            The answer is there is no such surjection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mn 2
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f: X \to 2^X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            by invoking existence of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo →
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2 \to 2
            that has no
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            (there is no such poset map
            = succeed "!)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo →
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \to 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the ordinal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 2
                    %mi X
                %annotation{:encoding => "application/x-tex"} 2^X
            is the order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                  %mo ⊔
                  %msup
                    %mi ω
                    %mi op
                %annotation{:encoding => "application/x-tex"} \bot \sqcup \omega^{op}
            (freely adjoin a bottom element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊥
                %annotation{:encoding => "application/x-tex"} \bot
            to
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \omega^{op}
          %p
            Proving there is no surjection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msup
                    %mn 2
                    %mi X
                %annotation{:encoding => "application/x-tex"} X \to 2^X
            is an amusing exercise. One line of attack (which internalizes to any topos) may be found
            = succeed "." do
              %a{:href => "https://ncatlab.org/toddtrimble/published/Cantor's+theorem+for+posets"} here
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lawvere%27s+fixed+point+theorem"} Lawvere's fixed point theorem
          %h2#references References
          %ul
            %li
              %p#Taylor2009
                Taylor 2009 June 20: On the categories mailing list, Message-ID
                = succeed "." do
                  %a{:href => "http://www.mta.ca/~cat-dist/archive/2009/09-6"} E1MJ5TV-00066b-BI@mailserv.mta.ca
            %li
              %p
                On constructivenews, a
                %a{:href => "https://groups.google.com/group/constructivenews/browse_thread/thread/5f65c7ac479c15dd"} discussion
                about Theorem
                %a.maruku-ref{:href => "#taylor"}
                in the case where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                are both the set of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                = succeed "es.)" do
                  %a.existingWikiWord{:href => "/nlab/show/realizability+topos"} realizability topos
