            %em
              %a.existingWikiWord{:href => "/nlab/show/Practical+Foundations"} Practical Foundations
            (although I don't know if it really originated there).
          #taylor.num_theorem
            %h6#theorem_3 Theorem
            %p (Taylor's version.)
            %p
              Given a set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}S
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
