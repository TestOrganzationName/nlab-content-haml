                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the
              %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}S
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be the set of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
