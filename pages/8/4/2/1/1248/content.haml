          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒫
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} i\colon \mathcal{P}S \to S
              be any function. Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi 𝒫
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f\colon S \to \mathcal{P}S
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ∀
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒫
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mi b
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f(a) = \{ b\colon S \;|\; \forall (U\colon \mathcal{P}S),\; i(U) = a \;\Rightarrow\; b \in U \} .
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is an injection, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
