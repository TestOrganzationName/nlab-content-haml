                              %mo |
                              %mi a
                              %mo −
                              %mi b
                              %msup
                                %mi d
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi c
                              %mo |
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mtext if
                            %mspace{:width => "thickmathspace"}
                            %mi d
                            %mo ≠
                            %mn 0
                        %mtr
                          %mtd
                            %mrow
                              %mo |
                              %mi b
                              %mo |
                            %mo ⋅
                            %mrow
                              %mo |
                              %mi d
                              %msup
                                %mi b
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi a
                              %mo −
                              %mi c
                              %mo |
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mtext if
                            %mspace{:width => "thickmathspace"}
                            %mi b
                            %mo ≠
                            %mn 0
                        %mtr
                          %mtd
                            %mrow
                              %mo |
                              %mi c
                              %mo |
                            %mo ⋅
                            %mrow
                              %mo |
                              %mi a
                              %msup
                                %mi c
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mi d
                              %mo −
                              %mi b
                              %mo |
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mtext if
                            %mspace{:width => "thickmathspace"}
                            %mi c
                            %mo ≠
                            %mn 0
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    det_D\left(
                    \\array{
                    a &amp; b
                    \\\
                    c &amp; d
                    }
                    \\right)
                    \\;=\;
                    \\left\{
                    \\begin{array}{cl}
                    0
                    \&amp;
                    \\;\text{if}\; a = b = c = d = 0
                    \\\
                    \\left\vert
                    a
                    \\right\vert
                    \\cdot
                    \\left\vert
                    d - c a^{-1} b
                    \\right\vert
                    \&amp;
                    \\;\text{if}\; a \neq 0
                    \\\
                    \\left\vert
                    d
                    \\right\vert
                    \\cdot
                    \\left\vert
                    a - b d^{-1} c
                    \\right\vert
                    \&amp;
                    \\;\text{if}\; d \neq 0
                    \\\
                    \\left\vert
                    b
                    \\right\vert
                    \\cdot
                    \\left\vert
                    d b^{-1} a  - c
                    \\right\vert
                    \&amp;
                    \\;\text{if}\; b \neq 0
                    \\\
                    \\left\vert
                    c
                    \\right\vert
                    \\cdot
                    \\left\vert
                    a c^{-1} d - b
                    \\right\vert
                    \&amp;
                    \\;\text{if}\; c \neq 0
                    \\mathrlap{\,.}
                    \\end{array}
                    \\right.
            %p
              In this form they appear in
              = succeed "." do
                %a{:href => "#CohenDeLeo99"} Cohen &amp; De Leo 1999 p. 11
            %p
          %h2#properties Properties
          %h3#RelationToSp2
            Relation to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sp(2)
          %p
          #BasicPropertiesOfDDeterminant.num_lemma
            %h6 Lemma
            %p
              The above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi det
                      %mi D
                  %annotation{:encoding => "application/x-tex"} det_D
              %a.maruku-eqref{:href => "#eq:QuaternonicDeterminant"} (1)
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ∈
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi ℝ
                              %mrow
                                %mo ≥
                                %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi I
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ⋅
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi det
                              %mi D
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi A
                              %mo †
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    det_D(A)
                    \&amp; \in\; \mathbb{R}_{\geq 0}
                    \\\
                    det_D(I_2)
                    \&amp; =\; 1
                    \\\
                    det_D(A \cdot B)
                    \&amp;=\;
                    det_D(A) \cdot det_D(B)
                    \\\
                    det_D\big(
                    A^\dagger
                    \\big)
                    \&amp;=\;
                    det_D(A)
                    \\mathrlap{\,.}
                    \\end{aligned}
            %p
          (cf.
          = succeed ")" do
            %a{:href => "#CohenDeLeo99"} Cohen &amp; De Leo 1999 Thm. 5.1(5) &amp; Cor. 6.4
          %p
          #UnitarySubgroup.num_prop
            %h6 Proposition
            %p
              Every quaternionic
              %a.existingWikiWord{:href => "/nlab/show/unitary+matrix"} unitary matrix
              (hence in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Sp%282%29"} Sp(2)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieudonn%C3%A9+determinant"} Dieudonné determinant
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              inclusion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sp(2)
                    \\;\equiv\;
                    U(2,\mathbb{H})
                    \\;\subset\;
                    SL(2,\mathbb{H})
                    \\,.
            %p
          (
          %a{:href => "Dieudonne+determinant#CohenDeLeo99"}> Cohen-De Leo 99, Cor. 6.4
          )
          .proof
            %h6 Proof
            %p
              By definition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mat_{2 \times 2}(\mathbb{H})
              is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(2)
              iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⋅
                      %msup
                        %mi A
                        %mo †
                      %mo =
                      %msub
                        %mi I
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A \cdot A^\dagger = I_2
              %a.maruku-ref{:href => "#BasicPropertiesOfDDeterminant"}
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mo =
                            %msub
                              %mi det
                              %mi D
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi A
                            %mo ⋅
                            %msup
                              %mi A
                              %mo †
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi det
                              %mi D
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi A
                              %mo †
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi det
                              %mi D
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    1
                    \&amp; =
                    det_D\big(A \cdot A^\dagger \big)
                    \\\
                    \&amp; =
                    det_D(A) \cdot det_D\big(A^\dagger\big)
                    \\\
                    \&amp; =
                    \\big( det_D(A) \big)^2
                    \\,.
                    \\end{aligned}
            %p
              But the only element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi det
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} det_D(A) \in \mathbb{R}_{\geq 0}
              satisfying this equation is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi det
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} det_D(A) = 1
          %h3#RelationToSpin51
            Relation to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(5,1)
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo ×
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2 \times 2
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+matrices"} Hermitian matrices
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SL
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{H})
            is identified with
            %a.existingWikiWord{:href => "/nlab/show/Spin%285%2C1%29"} Spin(5,1)
            and its canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 5
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
          %p
            (cf.
            = succeed ")" do
              %a{:href => "#VenâncioBatista21"} Venâncio &amp; Batista 2021
          %p
            For more on this see at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            %em
              %a.existingWikiWord{:href => "/nlab/show/supersymmetry+and+division+algebras"} supersymmetry and division algebras
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/exceptional+isomorphism"} exceptional isomorphism
            is compatible with that between the
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
            and the
            %a.existingWikiWord{:href => "/nlab/show/quaternion+unitary+group"} quaternion unitary group
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29"} Sp(2)
