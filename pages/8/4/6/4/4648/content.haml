          %p
            The original version of the conjectured statement of
            %em geometric Langlands duality
            (going back to
            %a{:href => "#BeilinsonDrinfeld9x"} Beilinson-Drinfeld 9x
            and reviewed for instance in
            = succeed ")" do
              %a{:href => "#Frenkel05"} Frenkel 05
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/reductive+group"} reductive group
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
            of
            %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
            of, on the one hand,
            %a.existingWikiWord{:href => "/nlab/show/D-modules"} D-modules
            on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+G-principal+bundles"} moduli stack of G-principal bundles
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
