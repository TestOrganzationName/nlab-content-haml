                  %mi G
                %annotation{:encoding => "application/x-tex"} {}^L G
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Langlands+dual+group"} Langlands dual group
            %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian
            analogue of the
            %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+transform"} Fourier-Mukai
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            and takes
            %a.existingWikiWord{:href => "/nlab/show/skyscraper+sheaves"} skyscraper sheaves
            on the left (
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
            = succeed ")" do
