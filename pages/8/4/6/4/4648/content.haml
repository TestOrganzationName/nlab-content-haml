                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"} Dennis Gaitsgory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sam+Raskin"} Sam Raskin
                = succeed ":" do
