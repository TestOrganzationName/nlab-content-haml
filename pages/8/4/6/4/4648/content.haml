            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dima+Arinkin"}> Dima Arinkin
                , D. Beraldo, Justin Campbell, L. Chen,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dennis+Gaitsgory"} Dennis Gaitsgory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sam+Raskin"} Sam Raskin
                = succeed ":" do
