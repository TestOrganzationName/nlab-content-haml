          %p
            Also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Π
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi x
                  %msup
                    %mi Π
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
