                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A= \text{coend}(F^*\otimes F: C^{op} \times C \to Bmd(E))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mover
                    %mi R
                    %mo ˙
                  %mo ⊗
                  %mi R
                %annotation{:encoding => "application/x-tex"} E=\dot R\otimes R
            is equipped with a coalgebra structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi λ
                    %mo ˙
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi ν
                      %mo ∈
                      %mi I
                  %mover
                    %mi λ
                    %mo ˙
                  %mi ν
                  %mo ⊗
                  %mover
                    %mi ν
                    %mo ˙
                  %mi μ
                %annotation{:encoding => "application/x-tex"}
                  \\Delta(\dot\lambda \mu) = \sum_{\nu\in I} \dot\lambda \nu\otimes \dot\nu \mu
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi λ
                    %mo ˙
                  %mi μ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi δ
                    %mrow
                      %mi λ
                      %mo ,
                      %mi μ
                %annotation{:encoding => "application/x-tex"}
                  \\epsilon (\dot\lambda \mu) = \delta_{\lambda,\mu}
          %p
            It is important to note that, generally speaking,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            may admit other fiber functor to different module categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RMod
                  %annotation{:encoding => "application/x-tex"} RMod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rep(H)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            a Hopf algebra, which admits both the fiber functor described above, as well as a fiber functor to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext Vect
                  %annotation{:encoding => "application/x-tex"} \text{Vect}
          %p
            Even further, this statement generalizes to tensor
            %a.existingWikiWord{:href => "/nlab/show/C-star-category"} C-star-categories
            and
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C-star
            weak Hopf algebras (
            %a{:href => "#VV20"}> Vainerman &amp; Vallin 2020
            ).
          %h3#relation_to_frobenius_algebras Relation to Frobenius algebras
          %p
            As explained in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
          #WeakHopfAlgebraIsQuasiFrobeniusAlgebra.num_prop
            %h6#proposition Proposition
            %p
              Any finite-dimensional weak Hopf algebra can be given the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-Frobenius+algebra"} quasi-Frobenius algebra
          %p
            This is due to
            = succeed "." do
              %a{:href => "#BNS99"} Bohm, Nill, and Szlachanyi (1999)
            %a{:href => "Vec03"} Vecsernyés (2003)
            seems to show that finite-dimensional weak Hopf algebras can be turned into Frobenius algebras, it is observed in
            %a{:href => "IK08"} Iovanov &amp; Kadison (2008)
            that the proof only implies they are
            = succeed "Frobenius" do
              %em quasi-
          %h2#literature Literature
          %p Weak comultiplications were introduced in
          %ul
            %li
              G. Mack,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Volker+Schomerus"} Volker Schomerus
              = succeed "," do
                %em Quasi Hopf quantum symmetry in quantum theory
          %p where also weak quasi-bialgebras are considered and physical motivation is discussed in detail. Further work in this vain is in
          %ul
            %li
