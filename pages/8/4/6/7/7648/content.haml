                  %msup
                    %mi Π
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi^L(x\Pi^L(y)) = \Pi^L(x y)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Π
                      %mi R
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Π
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Π
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi y
