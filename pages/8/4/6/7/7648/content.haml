                            %mn 1
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mi Π
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Pi^L(\Pi^L(x)) &amp;=&amp; \epsilon\left(1_{(1')}\epsilon(1_{(1)}x) 1_{(2)}\right)1_{(2')}
                  \= \epsilon(1_{(1)}x)\epsilon(1_{(1')}1_{(2)}) 1_{(2')}
                  \\\ &amp;=&amp;\epsilon(1_{(1)}x)\epsilon(1_{(2)}) 1_{(3)}
                  \= \epsilon(1_{(1)}x)1_{(2)} = \Pi^L(x).
                  }
          %p
            Notice
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mn 1
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msup
                      %mi Π
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Π
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon(x z) = \epsilon(x 1 z)  = \epsilon(x 1_{(2)})\epsilon(1_{(1)}z)) = \epsilon(x \epsilon(1_{(1)}z))1_{(2)} = \epsilon(x\Pi^L(z)) = \epsilon(\Pi^R(x)z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi R
                  %mo =
                  %msup
                    %mi Π
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^R = \Pi^R(A)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi L
                  %mo =
                  %msup
                    %mi Π
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^L = \Pi^L(R)
            are dual as
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi L
                  %mo ⊗
                  %msup
                    %mi A
                    %mi R
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} A^L\otimes A^R\to k
            given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
