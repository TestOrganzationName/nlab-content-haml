          %h3#relation_to_fusion_categories Relation to fusion categories
          %p
            Under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            arises as the
            %a.existingWikiWord{:href => "/nlab/show/representation+category"} representation category
            of a
            %a.existingWikiWord{:href => "/nlab/show/weak+Hopf+algebra"} weak Hopf algebra
            (
            %a{:href => "#Ostrik"}> Ostrik
            ). However, this does not mean that every fusion category admits a
            %a.existingWikiWord{:href => "/nlab/show/fiber+functor"} fiber functor
            to the
            %a.existingWikiWord{:href => "/nlab/show/Vect"} category of vector spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext Vect
                    %mo =
                    %mi k
                    %mo −
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} \text{Vect}= k-Mod
          %p
            Given any multi-fusion category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi RMod
                %annotation{:encoding => "application/x-tex"} F:C\to RMod
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            the algebra spanned by a basis of orthogonal idempotents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi v
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{v_i\}_{i\in I}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            the equivalence classes of simple objects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %em generalized
            fiber functor. The endomorphisms of this functor then give a weak Hopf algebra that represents
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a{:href => "#Hayashi99"} Hayashi 1999
            (see there for the relevant definitions), this is computed as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≅
                  %mi Rep
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C\cong Rep(A)
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mtext coend
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
