              %a.existingWikiWord{:href => "/nlab/show/hyperbolic+solid+torus"} hyperbolic solid torus
            %a.existingWikiWord{:href => "/nlab/show/knot+complement"} knot complement
            of the
            %a.existingWikiWord{:href => "/nlab/show/unknot"} unknot
            in the
            = succeed "." do
