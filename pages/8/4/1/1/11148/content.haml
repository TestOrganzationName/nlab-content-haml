            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kirill+Krasnov"}> Kirill Krasnov
                ,
                = succeed "," do
                  %em Black Hole Thermodynamics and Riemann Surfaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/gr-qc/0302073"} arXiv:gr-qc/0302073
            %li#Gukov03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                , Appendix A of:
                = succeed "," do
                  %em Three-Dimensional Quantum Gravity, Chern-Simons Theory, and the A-Polynomial
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0306165"} arXiv:hep-th/0306165
            %li#Kraus06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Per+Kraus"}> Per Kraus
                ,
                = succeed "," do
                  %em
                    Lectures on black holes and the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
