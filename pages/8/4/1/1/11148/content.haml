                        %annotation{:encoding => "application/x-tex"} AdS_3/CFT_2
                    correspondence
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0609074"} arXiv:hep-th/0609074
            %li#BKR07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Micha+Berkooz"}> Micha Berkooz
                , Zohar Komargodski, Dori Reichmann,
                = succeed "," do
                  %em
                    Thermal
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi AdS
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} AdS_3
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0706.0610"} arXiv:0706.0610
            %li
              %p
                M. Cadoni, M. Melis,
                = succeed "," do
                  %em Holographic entanglement entropy of the BTZ black hole
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0907.1559"} arXiv:0907.1559
              %p
                (relation to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/holographic+entanglement+entropy"} holographic entanglement entropy
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ingmar+Saberi"}> Ingmar Saberi
                , around Figure 4.3 of:
                %em Knots, Trees, and Fields: Common Ground Between Physics and Mathematics
                (
                %a{:href => "https://thesis.library.caltech.edu/9896"}> doi:10.7907/Z9VX0DHZ
                ,
                = succeed ")" do
                  %a{:href => "https://thesis.library.caltech.edu/9896/1/Saberi_Ingmar_2016.pdf"} pdf
              %p
                (with generalization to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/p-adic+string+theory"} p-adic string theory
          %p See also:
          %ul
            %li
              %p
                Zhen-Ming Xu, Bin Wu, Wen-Li Yang,
                %em Thermodynamic curvature and isoperimetric inequality for the charged BTZ black hole
                (
                %a{:href => "https://arxiv.org/abs/2002.00117"}> arXiv:2002.00117
                )
              %p (not Euclidean, but thermodynamic)
          %div
