          %title Quantum information theory via String diagrams
          %h3#ReferencesQuantumInformationTheoryViaStringDiagrams Quantum information theory via String diagrams
          %h4#GeneralReferencesQuantumInformationTheoryViaStringDiagrams General
          %p
            The observation that a natural language for
            %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory"} quantum information theory
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+computation"} quantum computation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+circuit+diagrams"} quantum circuit diagrams
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            in
            %a.existingWikiWord{:href => "/nlab/show/%E2%80%A0-compact+categories"} †-compact categories
            (see
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+via+dagger-compact+categories"} quantum information theory via dagger-compact categories
          %ul
            %li#AbramskyCoecke04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                = succeed "," do
                  %em A categorical semantics of quantum protocols
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/quant-ph/0402130"} arXiv:quant-ph/0402130
                %a{:href => "https://doi.org/10.1109/LICS.2004.1319636"} doi:10.1109/LICS.2004.1319636
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#AbramskyCoecke05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                = succeed "," do
                  %em Abstract Physical Traces
                %strong 14
                6 (2005) 111-124. [
                %a{:href => "http://www.tac.mta.ca/tac/volumes/14/6/14-06abs.html"}> tac:14-06
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/0910.3144"} arXiv:0910.3144
            %li#AbramskyCoecke08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                = succeed "," do
                  %em Categorical quantum mechanics
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Quantum+Logic+and+Quantum+Structures"} Handbook of Quantum Logic and Quantum Structures
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0808.1023"} arXiv:0808.1023
                = succeed "," do
                  %a{:href => "https://www.sciencedirect.com/book/9780444528698/"} ISBN:9780080931661
                %a{:href => "https://doi.org/10.1109/LICS.2004.1319636"} doi:10.1109/LICS.2004.1319636
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#Coecke07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %em De-linearizing Linearity: Projective Quantum Axiomatics from Strong Compact Closure
                = succeed "," do
                  %a{:href => "https://www.mathstat.dal.ca/~selinger/qpl2005/"} 3rd International Workshop on Quantum Programming Languages (2005)
                %strong 170
                (2007) 49-72 [
                %a{:href => "https://doi.org/10.1016/j.entcs.2006.12.011"}> doi:10.1016/j.entcs.2006.12.011
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/quant-ph/0506134"} arXiv:quant-ph/0506134
          %p
            On the relation to
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+logic"} quantum logic
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
          %ul
            %li#AbramskyDuncan05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samson+Abramsky"}> Samson Abramsky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"} Ross Duncan
                = succeed "," do
                  %em A Categorical Quantum Logic
                %strong 16
                3 (2006)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/quant-ph/0512114"} arXiv:quant-ph/0512114
                %a{:href => "https://doi.org/10.1017/S0960129506005275"} doi:10.1017/S0960129506005275
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#Duncan06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Duncan"}> Ross Duncan
                ,
                = succeed "," do
                  %em Types for quantum mechanics
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://personal.strath.ac.uk/ross.duncan/papers/rduncan-thesis.pdf"} pdf
                %a{:href => "http://www.cs.ox.ac.uk/people/ross.duncan/talks/2005/pps-22-05-2005.pdf"} slides
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p
            Early exposition with introduction to
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %ul
            %li#CoeckeKindergarten
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                %em Kindergarten quantum mechanics
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "http://arxiv.org/abs/quant-ph/0510032"} arXiv:quant-ph/0510032
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#CoeckeIntroducing
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                %em Introducing categories to the practicing physicist
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "http://arxiv.org/abs/0808.1032"} arXiv:0808.1032
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#BaezStay09
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mike+Stay"} Mike Stay
                %em Physics, topology, logic and computation: a rosetta stone
                in:
                = succeed "," do
                  %em New Structures for Physics
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                (ed.), Lecture Notes in Physics
                = succeed "," do
                  %strong 813
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "http://arxiv.org/abs/0903.0340"} arxiv/0903.0340
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#CoeckePractising
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"}> Bob Coecke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eric+Oliver+Paquette"} Eric Oliver Paquette
                = succeed "," do
