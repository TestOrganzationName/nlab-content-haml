                %strong 52
                (2020) 445206 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1911.06390"}> arXiv:1911.06390
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1751-8121/ab8ef2"} doi:10.1088/1751-8121/ab8ef2
              %blockquote
                %p
                  (via
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/adjusted+Weil+algebras"} adjusted Weil algebras
            %li#LeeOberhauser23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Darrick+Lee"}> Darrick Lee
                , Harald Oberhauser,
                %em Random Surfaces and Higher Algebra
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2311.08366"}> arXiv:2311.08366
                \&amp;rbrack;
            %li
              %p
                Francis Bischoff,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Darrick+Lee"} Darrick Lee
                %em Thin homotopy and the signature of piecewise linear surfaces
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2506.16657"}> arXiv:2506.16657
                \&amp;rbrack;
          %p
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n = 3
            in
          %ul
            %li#MartinsPickenII
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%A3o+Faria+Martins"}> João Faria Martins
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Roger+Picken"} Roger Picken
                = succeed "," do
                  %em The fundamental Gray 3-groupoid of a smooth manifold and local 3-dimensional holonomy based on a 2-crossed module
                %strong 29
                2 (2011) 179-206 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0907.2566"}> arXiv:0907.2566
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.difgeo.2010.10.002"} doi:10.1016/j.difgeo.2010.10.002
            %li
              %p
                Matthew Cellot:
                %em Higher path groupoids and the holonomy of formal power series connections
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2506.23880"}> arXiv:2506.23880
                \&amp;rbrack;
          %p
            Further discussion and illustration and relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+networks"} tensor networks
          %ul
            %li#Parzygnat18
              %a.existingWikiWord{:href => "/nlab/show/Arthur+Parzygnat"}> Arthur Parzygnat
              ,
              = succeed "," do
                %em Two-dimensional algebra in lattice gauge theory
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1802.01139"} arXiv:1802.01139
              = succeed ")" do
                %a{:href => "https://doi.org/10.1063/1.5078532"} doi:10.1063/1.5078532
          %p Applications
          %p
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monopoles"} monopoles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Arthur+Parzygnat"}> Arthur Parzygnat
              ,
              = succeed "," do
                %em Gauge invariant surface holonomy and monopoles
              %strong 30
              42 (2015) 1319-1428 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/30/42/30-42abs.html"}> tac:30-42
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1410.6938"} arXiv:1410.6938
          %p
            to
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+connection"} Knizhnik-Zamolodchikov connection
          %ul
            %li
              Lucio Simone Cirio,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%A3o+Faria+Martins"} João Faria Martins
              = succeed "," do
                %em Categorifying the Knizhnik–Zamolodchikov connection
              %strong 30
              3 (2012) 238-261 [
              %a{:href => "https://doi.org/10.1016/j.difgeo.2012.03.004"}> doi:10.1016/j.difgeo.2012.03.004
              ,
              = succeed "]" do
                %a{:href => "https://arxiv.org/abs/1106.0042"} arXiv:1106.0042
          %p
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/BFCG+theory"} BFCG theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%A3o+Faria+Martins"}> João Faria Martins
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Aleksandar+Mikovi%C4%87"} Aleksandar Miković
                = succeed "," do
                  %em Lie crossed modules and gauge-invariant actions for 2-BF theories
                %strong 15
                4 (2011) 913-1199 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1006.0903"}> arXiv:1006.0903
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://projecteuclid.org/euclid.atmp/1339438351"} euclid:atmp/1339438351
            %li
              %p
                A.D. López-Hernández, Graciela Reyes-Ahumada, Javier Chagoya:
                %em Categorical generalization of BF theory coupled to gravity
                [
                %a{:href => "https://arxiv.org/abs/2408.02889"}> arXiv:2408.02889
                ]
          %p
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/data+science"} data science
          %ul
            %li
              Ilya Chevyrev,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joscha+Diehl"} Joscha Diehl
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kurusch+Ebrahimi-Fard"} Kurusch Ebrahimi-Fard
              %em A multiplicative surface signature through its Magnus expansion
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2406.16856"}> arXiv:2406.16856
              \&amp;rbrack;
          %p
            In the abelian case, parallel transport for
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            is discussed generally in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiyonori+Gomi"}> Kiyonori Gomi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yuji+Terashima"} Yuji Terashima
                %em Higher dimensional parallel transport
                Mathematical Research Letters 8, 25–33 (2001) (
                %a{:href => "http://mrlonline.org/mrl/2001-008-001/2001-008-001-004.pdf"}> pdf
                )
            %li
              %p
                David Lipsky,
                %em Cocycle constructions for topological field theories
                (2010) (
                %a.existingWikiWord{:href => "/nlab/files/LipskyThesis.pdf", :title => "pdf"}> pdf
                )
            %li
              %p
                Nino Scalbi:
                %em Differential Cohomology as Diffeological Homotopy Theory
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2408.02593"}> arXiv:2408.02593
                \&amp;rbrack;
          %p
            see also the discussion at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
          %p
            Realization of this as an
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ners%C3%A9s+Aramyan"}> Nersés Aramyan
                , Research statement (
                %a{:href => "http://math.illinois.edu/~aramyan2/research.pdf"}> pdf
                )Parallel transport with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/crossed+complexes"} crossed complexes
                %a.existingWikiWord{:href => "/nlab/show/strict+infinity-groupoids"} strict infinity-groupoids
                is discussed in
            %li#Kapranov15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                %em Membranes and higher groupoids
                (
                %a{:href => "http://arxiv.org/abs/1502.06166"}> arXiv:1502.06166
                )
          %p
            The integration of flat differential forms with values in chain complexes to flat
            = succeed "-parallel" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#AbadSchaetz
              %a.existingWikiWord{:href => "/nlab/show/Camilo+Arias+Abad"}> Camilo Arias Abad
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Florian+Schaetz"} Florian Schaetz
              %em
                The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
                de Rham theorem and integration of representations up to homotopy
              (
              %a{:href => "http://arxiv.org/abs/1011.4693"}> arXiv
              )
          %p based on
          %ul
            %li#BlockSmith
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Block"}> Jonathan Block
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Smith"} Aaron Smith
              %em A Riemann Hilbert correspondence for infinity local systems
              (
              %a{:href => "http://arxiv.org/abs/0908.2843"}> arXiv
              )
          %p in turn based on constructions in
          %ul#Igusa
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kiyoshi+Igusa"}> Kiyoshi Igusa
              ,
              %em Iterated integrals of superconnections
              (
              %a{:href => "http://arxiv.org/abs/0912.0249"}> arXiv
              )
          %p
            Remarks on what one might call
            = succeed "-parallel" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %ul
            %li#Stasheff
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"}> Jim Stasheff
              \:
              %em
                %a.existingWikiWord{:href => "/nlab/files/StasheffParallelTransportv02.pdf", :title => "Parallel transport, holonomy and all that -- a homotopy point of view"} Parallel transport, holonomy and all that – a homotopy point of view
          %p
            Understanding
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            of
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundles+with+connection"} circle n-bundles with connection
            as an
            %a.existingWikiWord{:href => "/nlab/show/extended+functorial+field+theory"} extended
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+field+theory"} homotopy field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lukas+M%C3%BCller"}> Lukas Müller
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lukas+Woike"} Lukas Woike
              = succeed "," do
