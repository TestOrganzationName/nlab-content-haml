              is the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ϕ
                      %mo *
                    %mo ∇
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\phi^* \nabla]
              of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mo ∇
                    %mo :
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^* \nabla : \Pi(\Sigma) \to \Gamma(A)
            %p
              in the
