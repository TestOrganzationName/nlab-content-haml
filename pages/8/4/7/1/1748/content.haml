                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} [0,1]\odot X\to Y
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power"} powers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo ⋔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\to \pitchfork([0,1],Y)
          %p
            There is a similar definition in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,1]
            with the 1-simplex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1
            %em simplicial homotopies
            need be composable even if they match correctly. (This depends on whether or not all (2,1)-
            %a.existingWikiWord{:href => "/nlab/show/horn"}> horn
            s in the simplicial set,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(X,Y)
            %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            we can use the “chain complex interval” to get a notion of
            = succeed "." do
              %em chain homotopy
          %h3#in_model_categories In model categories
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+in+a+model+category"} homotopy in a model category
          #PathAndCylinderObjectsInAModelCategory.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            %ul
              %li
                A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(X)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a factorization of the
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi X
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi X
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \nabla_X \colon X \to X \times X
                as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi i
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mn 0
                        %mo ,
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ×
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_X
                    \\;\colon\;
                    X \underoverset{\in W}{i}{\longrightarrow} Path(X) \overset{(p_0,p_1)}{\longrightarrow} X \times X
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X\to Path(X)
              is a weak equivalence. This is called a
              %strong good path object
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Path(X) \to X \times X
              is a fibration.
            %ul
              %li
                A
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cyl(X)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a factorization of the
                %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
                (or “fold map”)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi X
                      %mo :
                      %mi X
                      %mo ⊔
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Delta_X: X \sqcup X \to X
                as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⊔
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %msub
                          %mi i
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mi p
                      %mrow
                        %mo ∈
                        %mi W
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_X
                    \\;\colon\;
                    X \sqcup X \overset{(i_0,i_1)}{\longrightarrow} Cyl(X) \underoverset{p}{\in W}{\longrightarrow} X
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Cyl(X) \to X
              is a weak equivalence. This is called a
              %strong good cylinder object
              if in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊔
                    %mi X
                    %mo →
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \sqcup X \to Cyl(X)
              is a cofibration.
          #RemarkOnChoicesOfNonGoodPathAndCylinderObjects.num_remark
            %h6#remark Remark
            %p
              By the factorization axioms every object in a model category has both a good path object and as well as a good cylinder object according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            %p
              For instance in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X\times [0,1]
              is a cylinder object, but not a good cylinder unless
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              itself is cofibrant (a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              in this case).
            %p
              More generally, the path object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Path
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Path(X)
              of def.
              %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
              is analogous to the
              %a.existingWikiWord{:href => "/nlab/show/powering"} powering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋔
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pitchfork(I,X)
              with an
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              and the cylinder object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cyl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cyl(X)
              is analogous to the
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊙
                    %mi X
                  %annotation{:encoding => "application/x-tex"} I\odot X
              with an interval object. In fact, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is fibrant/cofibrant, then these powers and copowers are in fact examples of (good) path and cylinder objects if the
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              is sufficiently good.
          #LeftAndRightHomotopyInAModelCategory.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f,g \colon X \longrightarrow Y
              be two
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
              in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %ul
              %li
                A
                %strong left homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %msub
                        %mo ⇒
                        %mi L
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow_L g
                is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \eta \colon Cyl(X) \longrightarrow Y
                from a
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Cyl
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟵
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi η
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; Cyl(X) &amp;\longleftarrow&amp; X
                    \\\
                    \&amp; {}_{\mathllap{f}}\searrow &amp;\downarrow^{\mathrlap{\eta}}&amp; \swarrow_{\mathrlap{g}}
                    \\\
                    \&amp;&amp;
                    Y
                    }
                    \\,.
            %ul
              %li
                A
                %strong right homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %msub
                        %mo ⇒
                        %mi R
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow_R g
                is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta \colon X \to Path(Y)
                to some
                %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↙
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi η
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟵
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{f}}\swarrow &amp; \downarrow^{\mathrlap{\eta}} &amp; \searrow^{\mathrlap{g}}
                    \\\
                    Y &amp;\longleftarrow&amp; Path(Y) &amp;\longrightarrow&amp; Y
                    }
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              By remark
              %a.maruku-ref{:href => "#RemarkOnChoicesOfNonGoodPathAndCylinderObjects"}
              it follows that in a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              is a left homotopy if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is cofibrant and a right homotopy if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is fibrant. Similar remarks hold for other enrichments.
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+in+a+model+category"} homotopy in a model category
          %h3#in_cofibration_categories In (co-)fibration categories
          %p
            Clearly the concept of left homotopy in def.
            %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            only needs part of the model category axioms and thus makes sense more generally in suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cofibration+categories"} cofibration categories
            %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            makes sense more generally in suitable
            %a.existingWikiWord{:href => "/nlab/show/fibration+categories"} fibration categories
            such as
            %a.existingWikiWord{:href => "/nlab/show/categories+of+fibrant+objects"} categories of fibrant objects
            in the sense of Brown.
          %p
            Likewise if there is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cylinder+functor"} cylinder functor
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cylinder+objects"} cylinder objects
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
