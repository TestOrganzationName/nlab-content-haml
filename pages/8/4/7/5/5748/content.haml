                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \phi \colon V \to V
            is complex-linear iff it commutes with the complex structure in that:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ∘
                  %mi J
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mi J
                  %mo ∘
                  %mi ϕ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi \circ J \,=\, J \circ \phi
                  \\,.
          %h3#complex_structure_on_manifolds Complex structure on manifolds
          %p
            More generally, an almost complex structure on a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is a smoothly varying
            = succeed "wise" do
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            %a.maruku-ref{:href => "#LinearComplexStructure"}
            on its
            %a.existingWikiWord{:href => "/nlab/show/tangent+spaces"} tangent spaces
            (which
            %em a priori
            are
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
          .num_defn
            %h6#definition_2 Definition
            %p
              An
              %em almost complex structure
              on a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (of even
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,1)
              %a.existingWikiWord{:href => "/nlab/show/tensor+field"} tensor field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ∈
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo ⊗
                      %msup
                        %mi T
                        %mo *
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J \in \Gamma(T X \otimes T^* X)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is a linear complex structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#LinearComplexStructure"}
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T_x X
              under the canonical identification
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi End
                      %msub
                        %mi T
                        %mi x
                      %mi X
                      %mo ≃
                      %msub
                        %mi T
                        %mi x
                      %mi X
                      %mo ⊗
                      %msubsup
                        %mi T
                        %mi x
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} End T_x X \simeq T_x X\otimes T_x^* X
          %p Equivalently, stated more intrinsically:
          .num_defn
            %h6#definition_3 Definition
            %p
              An
              %em almost complex structure
              on a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2 n
              is a
              %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              to the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{C}) \hookrightarrow GL(2n,\mathbb{R})
          #InTermsOfSmoothStacks.num_remark
            %h6#remark Remark
            %p
              In terms of modulating maps of bundles into their
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoid"} smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi alm
