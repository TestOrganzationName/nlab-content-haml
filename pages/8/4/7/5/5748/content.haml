                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munderover
                              %mo →
                              %mi τ
                              %mrow
                                %mi tang
                                %mo .
                                %mspace{:width => "thinmathspace"}
                                %mi bund
                                %mo .
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi n
                            %mo ,
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathbf{B} GL(n,\mathbb{C})
                    \\\
                    \&amp; {}^{\mathllap{alm.compl.str.}}\nearrow &amp; \downarrow^{\mathrlap{}}
                    \\\
                    X
                    \&amp;\underoverset{\tau}{tang.\,bund.}{\to}&amp;
                    \\mathbf{B} GL(2n,\mathbb{R})
                    }
                    \\,.
            %p
              By further
              %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction
              along the
              %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
              inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              this yields an
              %a.existingWikiWord{:href => "/nlab/show/almost+Hermitian+structure"} almost Hermitian structure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
