                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \Gamma: F(1) \to \mathbf{P}
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(1)
                is the free braided monoidal category on one generator.
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                be any (permutative) operad valued in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi P
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} \mathbf{P} \to Set
                %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
                gives a functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo :
                        %mi El
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi P
                      %annotation{:encoding => "application/x-tex"} \Gamma: El(C) \to \mathbf{P}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                can be identified with those clubs for which the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \Gamma\colon C\to \mathbf{P}
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
          %h2#clubs_over_finite_sets Clubs over finite sets
          %p
            Essentially the same construction can be given replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi P
                %annotation{:encoding => "application/x-tex"} \mathbf{P}
            by (a skeleton of) the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            of finite sets and functions, or its opposite. The corresponding cartesian monads are those whose algebras are categories with strictly associative finite coproducts or strictly associative finite products, respectively. Examples of such clubs include categories with (not necessarily strictly associative) finite coproducts or products. Clubs of this sort were also defined in
            %a{:href => "#KellyMVFC"} MVFC
            and
            = succeed "," do
              %a{:href => "#KellyAAC"} AAC
            = succeed "." do
              %a{:href => "#KellyOCD"} OCD
          %h2#clubs_over_cartesian_monads Clubs over cartesian monads
          %p
            In fact, the foregoing constructions can be generalized to any
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monad"} cartesian monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
            %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Cat
                  %mo ,
                  %mi Cat
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S
            inherits a monoidal structure. We also have an “evaluate at
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Cat
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S \to Cat/S1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi S
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} A\to S1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{A}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            by the following pullbacks:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi A
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{ \hat{A}(X) &amp; \to &amp; A \\
                  \\downarrow &amp;&amp; \downarrow\\
                  S(X) &amp; \to &amp; S(1) }
          %p
            This right adjoint is fully faithful and embeds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Cat
                  %mo ,
                  %mi Cat
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S
            as the endofunctors equipped with a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformation"} cartesian natural transformation
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            is closed under the monoidal structure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Cat
                    %mo ,
                    %mi Cat
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            is, in the case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the symmetric strict monoidal category monad, exactly the substitution product defined above. Thus, a club is a monoid for this monoidal structure, and the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Cat
                  %mo ,
                  %mi Cat
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S
            thereby sends it to a monad over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Note, however, that this construction depends on no special features of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            on any category with finite limits. This generalization was performed by Kelly in
            = succeed "." do
              %a{:href => "#KellyCDT"} CDT
            %em in
            a suitable 2-category; see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/club+in+a+2-category"} club in a 2-category
          %h2#clubs_with_many_objects Clubs with many objects
          %p
            To describe structures on a family of categories rather than a single category (such as a monoidal functor between two monoidal categories), we can generalize to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cat
                    %mi Λ
                %annotation{:encoding => "application/x-tex"} Cat^\Lambda
            for any set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi Λ
                    %mo ×
                    %mi S
                    %mi Λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat/(\Lambda \times S\Lambda)
            %a{:href => "#KellyMVFC"} MVFC
            and
            = succeed ";" do
              %a{:href => "#KellyAAC"} AAC
            %a.existingWikiWord{:href => "/nlab/show/generalized+multicategories"} generalized multicategories
            for a cartesian monad (with a
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            of objects) rather than simply generalized operads (those with the
            %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            of objects).
          %h2#clubs_over__2
            Clubs over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
          %p
            In
            %a{:href => "#KellyCDT"} CDT
            Kelly described a further generalization of clubs over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            is replaced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            for functors into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo{:stretchy => "false"} /
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} CAT/Cat
            but on the
            %a.existingWikiWord{:href => "/nlab/show/lax+slice+2-category"} lax slice 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo ⫽
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} CAT\sslash Cat
            (which Kelly denoted
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CAT
                    %msup
                      %mo ∫
                      %mo *
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} CAT \int^* Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mon
                  %mo{:stretchy => "false"} (
                  %mi CAT
                  %mo ⫽
                  %mi Cat
                  %mo ,
                  %mo ∘
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Mnd
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mon(CAT\sslash Cat,\circ) \to Mnd(Cat)
            from clubs to
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
          %p
            There is an analogous generalization of the many-object case, though Kelly did not make this explicit. Similarly, there is a dual notion of club in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo ⫽
                  %msup
                    %mi Cat
                    %mi op
                %annotation{:encoding => "application/x-tex"} CAT\sslash Cat^{op}
            which generalizes clubs over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi FinSet
                      %mi op
                  %annotation{:encoding => "application/x-tex"} FinSet^{op}
          %p
            Kelly did not give any interesting examples of clubs in this generality, only remarking that one is “ineluctably led to” the generalization. But also worth noting is that there could be interesting morphisms between clubs over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            that are only visible when they are viewed as clubs in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo ⫽
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} CAT\sslash Cat
            (or equivalently as monads on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
          %h2#clubs_as_polynomial_monads Clubs as polynomial monads
          %p
            The cartesian monads
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that are used to define clubs over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi FinSet
                    %mi op
                %annotation{:encoding => "application/x-tex"} FinSet^{op}
            are in fact
            %a.existingWikiWord{:href => "/nlab/show/polynomial+monads"} polynomial monads
            (which immediately implies that they are cartesian). And an endofunctor equipped with a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+natural+transformation"} cartesian natural transformation
            to a
            %a.existingWikiWord{:href => "/nlab/show/polynomial+functor"} polynomial functor
            is itself automatically polynomial. Thus, the subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Cat
                  %mo ,
                  %mi Cat
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mi S
                %annotation{:encoding => "application/x-tex"} [Cat,Cat]/S
            identified with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            by the “clubs over cartesian monads” construction is equivalently the category of polynomial endofunctors of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            cartesianly-over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi S
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Cat/S1
            reduces to the identification of cartesian morphisms between polynomial functors with pullback squares of exponentiable morphisms. Similarly, considering cartesian natural transformations in the
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            of polynomial functors yields a description of clubs with many objects.
          %p
            This suggests that an arbitrary polynomial monad could be regarded as a “global club”, i.e. one not “over any base”. A polynomial endofunctor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            is determined by a single
            %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f:B\to A
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Conduche+functor"} Conduche functor
            %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                %annotation{:encoding => "application/x-tex"} A\to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo{:stretchy => "false"} /
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} CAT/Cat
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi Cat
                    %mi op
                %annotation{:encoding => "application/x-tex"} CAT/Cat^{op}
            are the obvious special cases when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cat
                    %mi op
                %annotation{:encoding => "application/x-tex"} Cat^{op}
            are embedded into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Prof
            by
            %a.existingWikiWord{:href => "/nlab/show/representable+profunctor"} representable
            and corepresentable profunctors and the pseudofunctor is strict; these correspond to polynomial endofunctors for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f:B\to A
            is a
            %a.existingWikiWord{:href => "/nlab/show/split+opfibration"} split opfibration
            or
            %a.existingWikiWord{:href => "/nlab/show/split+fibration"} split fibration
            respectively.
          %p
            Finally, recall that
            %em non-cartesian
            natural transformations between polynomial functors determined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} g:D\to C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f:B\to A
            have a similar description as consisting of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi C
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} h:C\to A
            and a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %msub
                    %mo ×
                    %mi A
                  %mi B
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C\times_A B \to D
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} A\to Prof
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} C\to Prof
            this corresponds to a triangle filled by a lax natural transformation whose components are functors. Thus in the cases of split (op)fibrations we recover Kelly’s lax slice 2-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CAT
                  %mo ⫽
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} CAT\sslash Cat
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CAT
                    %mo ⫽
                    %msup
                      %mi Cat
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CAT\sslash Cat^{op}
          %h2#clubs_of_mixed_variance Clubs of mixed variance
          %p
            The clubs described in the preceding sections are all examples of
            = succeed ":" do
              %em covariant clubs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are covariant functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D^n \to D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Cat
            %a.existingWikiWord{:href => "/nlab/show/extranatural+transformations"} extranatural transformations
            between them. For example, in the doctrine for closed monoidal categories, there is an extranatural transformation of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} ev_{X, Y}: [X, Y] \otimes X \to Y
          %p
            which is dinatural in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and natural in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            It turns out that many doctrines of “mixed variance” can also be described by an extension of the club notion. This applies particularly to closed monoidal, closed symmetric monoidal, and
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %h3#extranaturality_graphs Extranaturality graphs
          %p
            The underlying arity of an operation of mixed variance will be a
            = succeed "," do
              %em signed set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{1, 2, \ldots, n\}
            where a sign
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} -
            is assigned to each element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is given the sign
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            (resp.,
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} -
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mi th
                %annotation{:encoding => "application/x-tex"} j^{th}
            argument of the operation appears covariantly (resp., contravariantly). For example, for the operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %mi C
                  %mo ×
                  %mi C
                  %mo →
                  %mi C
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi c
                %annotation{:encoding => "application/x-tex"} C^{op} \times C \times C \to C: (a, b, c) \mapsto [a, b] \otimes c
          %p
            the underlying arity is an ordered list of signs
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-, +, +\}
          %p
            The underlying arity of an extranatural transformation for a given doctrine is an arrow of signed sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            called a
            %strong graph
            (or EKM graph, for Eilenberg, Kelly and Mac Lane), which by definition is a partition of the signed elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \cup B
            into mated pairs, such that
          %ul
            %li
              %p
                Mated elements, one in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and one in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p
                Mated elements, both in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                or both in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
          %p
            An EKM graph may be identified with a directed graph whose edges are mated pairs, oriented in the direction from an
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} -
            if the mates are
            = succeed "-elements," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} -
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                %annotation{:encoding => "application/x-tex"} +
            if the mates are
            = succeed "-elements." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p For example, the arity of the evaluation map in closed monoidal categories,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} ev_{X, Y}: [X, Y] \otimes X \to Y
          %p is an arrow with an oriented edge from the third placeholder of the domain to the first placeholder, and an oriented edge from the second placeholder of the domain to the placeholder of the codomain.
          %p Hence we obtain a directed graph whose vertices are signed sets and whose edges are EKM graphs between the signed sets. An immediate question is how to compose graphs to form a category, and in particular what to do about “loops” or “islands” which may arise in composing such 1-cobordisms. The first answer that may come to mind is simply to ignore them (in other words, regard the pairings as morphisms in a bicategory of co-relations, and compose them as such). An answer more relevant to clubs will emerge in the next section.
          %h3#doctrine_of_compact_closed_categories Doctrine of compact closed categories
          %p An example in which loops arise in compositions of extranatural transformations is the doctrine of compact closed (symmetric monoidal) categories. The classic example is the composition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mover
                    %mo →
                    %mi η
                  %msup
                    %mi c
                    %mo *
                  %mo ⊗
                  %mi c
                  %mover
                    %mo →
                    %mi ε
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1 \stackrel{\eta}{\to} c^* \otimes c \stackrel{\varepsilon}{\to} 1
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            denotes a monoidal unit,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            is a unit for an adjunction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ⊣
                    %msup
                      %mi c
                      %mo *
                  %annotation{:encoding => "application/x-tex"} c \dashv c^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            is a counit for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mo *
                  %mo ⊣
                  %mi c
                %annotation{:encoding => "application/x-tex"} c^* \dashv c
            (in a symmetric monoidal category, such adjunctions are inevitably
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/ambidextrous+adjunction"} ambidextrous
          %p
            This composition obviously does not define an extranatural transformation from a constant functor to itself, precisely because of dependence on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            (for example, when interpreted in the compact closed category of finite-dimensional vector spaces, the value is
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(c)
            = succeed "\u201D." do
              %a{:href => "http://en.wikipedia.org/wiki/Danger,_Will_Robinson"} Danger, Will Robinson!
          %p
            The lesson learned is that the doctrine of compact closed categories is not describable by a club, and that for the purposes of clubs there is no use for compositions of graphs which produce loops. If one insists on assigning a value to composition in such cases, it might as well be a junk value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
          %h3#definition_of_club_of_mixed_variance Definition of club of mixed variance
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            be the category enriched in pointed sets whose objects are finite signed sets, and whose morphisms are graphs as described above, composed as in the bicategory of cospans between sets unless this results in the creation of loops (in which case the composition is defined to be the basepoint of the hom-set it belongs to). There is no harm in thinking of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{G}
            as an ordinary category.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mstyle{:mathvariant => "bold"}
                    %mi G
                  %mo{:stretchy => "false"} )
                  %mo ′
                %annotation{:encoding => "application/x-tex"} (Cat/\mathbf{G})'
            be the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
