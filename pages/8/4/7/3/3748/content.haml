                  %mrow
                    %msup
                      %mi D
                      %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D^n \to D
          %p
            The free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
