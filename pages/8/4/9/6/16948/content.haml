                  %mi G
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/2
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Landweber"}> Peter Landweber
                ,
                = succeed "," do
                  %em On Equivariant Maps Between Spheres with Involutions
                = succeed ")" do
                  %a{:href => "http://www.jstor.org/stable/1970812"} jstor
            %li#ArakiIriye82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sh%C3%B4r%C3%B4+Araki"}> Shôrô Araki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kouyemon+Iriye"} Kouyemon Iriye
                = succeed "," do
                  %em Equivariant stable homotopy groups of spheres with involutions. I
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.ojm/1200774828"} Euclid:1200774828
            %li#Iriye82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kouyemon+Iriye"}> Kouyemon Iriye
                ,
                = succeed "," do
                  %em Equivariant stable homotopy groups of spheres with involutions. II
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.ojm/1200775536"} euclid:1200775536
            %li#DuggerIsaksen16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"} Daniel Isaksen
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
