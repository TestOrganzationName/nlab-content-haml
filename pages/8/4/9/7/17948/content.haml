          .num_example
            %h6#beispiel Beispiel
            %p
              Jeder
              %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normierte Vektorraum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo −
                      %mo{:stretchy => "false"} ‖
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, {\Vert -\Vert})
              wird ein
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metrischer Raum
              im Sinne von Definition
              %a.maruku-ref{:href => "#MetricSpace"}
              indem man setzt:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
