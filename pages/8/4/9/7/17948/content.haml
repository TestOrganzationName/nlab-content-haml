              sind, und deren
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} Morphismen
              solche
              %a.existingWikiWord{:href => "/nlab/show/function"} Funktionen
              sind die diese
              = succeed "-Wirkung" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
