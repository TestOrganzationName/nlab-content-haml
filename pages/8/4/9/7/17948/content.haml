                  %annotation{:encoding => "application/x-tex"} G
              irgend eine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} Gruppe
              %a.existingWikiWord{:href => "/nlab/show/category"} kategorie
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
