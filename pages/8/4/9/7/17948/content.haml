              deren
              %a.existingWikiWord{:href => "/nlab/show/objects"} Objekte
              die
              %a.existingWikiWord{:href => "/nlab/show/sets"} Mengen
              mit
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
