          #ContinuousMaps.num_defn
            %h6#definition_6 Definition
            %p
              %strong (stetige Abbildungen)
            %p
              Eine
              %em
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Abbildung
              zwischen
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologsichen Räumen
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi τ
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \colon (X, \tau_X) \to (Y, \tau_Y)
            %p
              ist eine
              %a.existingWikiWord{:href => "/nlab/show/function"} Funktion
              zwischen den unterliegenden Mengen,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              so dass
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} Urbilder
              unter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              von offenen Mengen in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              wieder offene Mengen in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              sind.
          %p
            Diese einfach Definition von
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} offenen Untermengen
            und das einfache
            %em Stetigkeitprinzip
            geben der Topologie ihr fundamentales und universelles Gepräge. Die kombinatoischen Natur dieser Definition macht dass Topologie enge Bezüge zur
            %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formalen Logik
            hat (mehr dazu siehe
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
          .num_remark
            %h6#bemerkung Bemerkung
            %p
              %strong (die Kategorie der topologischen Räume)
            %p
              Die
              %a.existingWikiWord{:href => "/nlab/show/composition"} Komposition
              von
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} stetigen Abbildungen
              ist offensichtlich
              %a.existingWikiWord{:href => "/nlab/show/associativity"} assoziativ
              und
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
            %p Man sagt dass
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologische Räume
                  sind die
                  %a.existingWikiWord{:href => "/nlab/show/objects"} Objekte
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} stetige Abbildungen
                  sind die
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} Morphismen
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"}> Homomorphismen
                  )
            %p
              einer
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+topological+spaces"} Kategorie der topologischen Räume
              (kurz:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              ).
            %p
              Es ist nützliche eine Ansammlung von
              %a.existingWikiWord{:href => "/nlab/show/objects"} Objekten
              mit
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} Morphismen
              dazwischen durch
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} Diagramme
              darzustellen, wie dieses:
            %p
              %img{:src => "https://ncatlab.org/nlab/files/AssociativityDiagram.png", :width => "400"}/
            %blockquote
              %p
                Illustration aus
                = succeed "." do
                  %a{:href => "#category+theory#LawvereSchanuel09"} Lawvere-Schanuel 09
          %p Unser motivierendes Beispiel ist also folgendes
          #MetricTopology.num_example
            %h6#beispiel_2 Beispiel
            %p
              %strong (metrische Topologie)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              ein
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metrischer Raum
              %a.maruku-ref{:href => "#OpenSubsetsOfAMetricSpace"}
              eine
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} Topologie
              auf
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              zu einem
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischen Raum
              im Sinne von def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalSpace"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metrische topologie
              genannt.
            %p
              Kurz gesagt, die
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} offenen Bälle
              in einem metrischen Raum sind die “
              %a.existingWikiWord{:href => "/nlab/show/basis+of+a+topology"}> Basis
              ” für die
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metrische Topologie
          %p
            Ein wichtiger Punkt der allgemeinen Definition von “
            %a.existingWikiWord{:href => "/nlab/show/topological+space"}> topologischem Raum
            ” ist dass sie Konstruktionen zulässt die intuitiv auf “stetigen Räumen” existieren sollten, aber dies sonst, zum Beispiel in metrischen Räumen, nicht tun:
          #DiscreteTopologicalSpace.num_example
            %h6#beispiel_3 Beispiel
            %p
              %strong (diskrete topologische Räume)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              eine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/set"} Menge
              %em
                %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} diskrete Topologie
              auf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              %em jede
              Untermenge von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              als
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} offene Untermenge
          #SubspaceTopology.num_example
            %h6#beispiel_4 Beispiel
            %p
              %strong (Unterraum Topologie)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/OpenSubsetsOfSquareInsidePlane.png", :width => "200"}/
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \tau_X)
              ein
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X
              eine
              %a.existingWikiWord{:href => "/nlab/show/subset"} Untermenge
              der zugrunde liegenden Menge. Die zugehörige
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} Unterraumtopologie
              hat dann
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} X_0
                  als ihre zugunde liegende Menge,
              %li
                %p
                  die offenen Untermengen sind die Untermengen von
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} X_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  sind.
            %p
              (Dies wird auch die
              %em
                %a.existingWikiWord{:href => "/nlab/show/initial+topology"} initiale Topologie
              der Injektionsabbildung genannt.)
            %p
              Die Illustration rechts zeigt zwei offene Untermengen in dem
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/square"} Quadrat
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topologischer Unterraum
              der
              %a.existingWikiWord{:href => "/nlab/show/plane"} Ebene
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            %blockquote
              %p
                Illustration aus
                %a{:href => "#Munkres75"} Munkres 75
          #QuotientTopologicalSpace.num_example
            %h6#beispiel_5 Beispiel
            %p
              %strong (topologischer Quotientenraum)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi τ
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau_X)
              ein
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo ∼
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    R_\sim \subset X \times X
            %p
              eine
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} Äquivalenzrelation
              auf der zugrunde liegenden Menge. Dann hat der
              %em
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} topologische Quotientenraum
            %ul
              %li
                als zugrunde liegende Menge die
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotientenmenge
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo ∼
                      %annotation{:encoding => "application/x-tex"} X_{\sim}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} Äquivalenzklassen
            %p und
            %ul
              %li
                %p
                  eine Untermenge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo ⊂
                        %msub
                          %mi X
                          %mo ∼
                      %annotation{:encoding => "application/x-tex"} O \subset X_{\sim}
                  wird als
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} offene Untermenge
                  betrachtet genau dann wenn ihr
                  %a.existingWikiWord{:href => "/nlab/show/preimage"} Urbild
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi π
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi O
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi^{-1}(O)
                  under der kanonischen
                  %a.existingWikiWord{:href => "/nlab/show/projection+map"} Projektionsabbildung
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi π
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %msub
                          %mi X
                          %mo ∼
                      %annotation{:encoding => "application/x-tex"}
                        \\pi \colon X \to X_\sim
                %p
                  eine offene Untermenge von
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  ist.
            %p
              (Dies wird auch die
              %em
                %a.existingWikiWord{:href => "/nlab/show/final+topology"} finale Topologie
              der Projektion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              genannt.)
          %p
            %img{:src => "https://ncatlab.org/nlab/files/QuotientOfSquareIsCylinderAndTorus.png", :width => "660"}/
          %p
            Die obige Illustration zeigt links das
            %a.existingWikiWord{:href => "/nlab/show/square"} Quadrat
            (ein
            %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topologischer Unterraum
            der
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/plane"} Ebene
            %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} topologischen Quotientenraum
            erhalten durch Identifizierung zweier gegenüberliegender eiten (der
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cylinder"} Zylinder
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/torus"} Torus
          %blockquote
            %p
              Illustration aus
              %a{:href => "#Munkres75"} Munkres 75
          #ProductTopologicalSpace.num_example
            %h6#beispiel_6 Beispiel
            %p
              %strong (topologischer Produktraum)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ProductTopology.png", :width => "300"}/
            %p
              Seien
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              und
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              zwei
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologische Räume
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} topologische Produktraum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
            %ul
              %li
                als zugrunde liegende Menge das
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} kartesische Produkt
                der unterliegenden Mengen
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %p und
            %ul
              %li
                seine
                %a.existingWikiWord{:href => "/nlab/show/open+sets"} offenen Mengen
                sind die Untermengen
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo ⊂
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} O \subset X \times Y
                des kartesischen Produktes für die gilt dass für alle Punkte
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi O
                    %annotation{:encoding => "application/x-tex"} (x,y) \in O
                offene Mengen
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi O
                        %mi x
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in O_x \subset X
                und
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %msub
                        %mi O
                        %mi Y
                      %mo ⊂
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y \in O_Y \subset Y
                existieren, so dass
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi O
                          %mi x
                        %mo ×
                        %msub
                          %mi O
                          %mi y
                        %mo ⊂
                        %mi O
                      %annotation{:encoding => "application/x-tex"} O_x \times O_y \subset O
            %blockquote
              %p
                Illustration aus
                %a{:href => "#Munkres75"} Munkres 75
          %p
            Diese Konstruktionen von
            %a.existingWikiWord{:href => "/nlab/show/discrete+topological+spaces"}> disketen topologischen Räumen
            ,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+spaces"} topologischen Quotientenräumen
            %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topologischen Unterräumen
            und von
            %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} topologischen Produkträumen
            snd einfache Beispiele für
            %strong
              %a.existingWikiWord{:href => "/nlab/show/limits"} Limiten
            und
            %strong
              %a.existingWikiWord{:href => "/nlab/show/colimits"} Kolimiten
            von topologischen Räumen. Die
            %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            von topologischen Räumen hat die nützliche Eigenschaft dass
            %em alle
            %a.existingWikiWord{:href => "/nlab/show/limits"} Limiten
            und
            %a.existingWikiWord{:href => "/nlab/show/colimits"} Kolimiten
            (über
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/small+diagrams"} kleine Diagramme
            = succeed ".)" do
              %em
                %a{:href => "Top#UniversalConstructions"} Top – Universelle Konstruktionen
          %h3#Homeomorphisms Homeomorphismen
          %p
            Mit den
            %a.existingWikiWord{:href => "/nlab/show/objects"} Objekten
            (
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"}> topologischen Räumen
            ) und den
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} Morphismen
            (
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"}> stetige Abbildungen
            ) der
            %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            der Topologie also definiert, erhalten wir den Begriff der “Gleichheit” in der Topologie.
          %p
            Um dies präzise zu machen sagt man dass ein
            %a.existingWikiWord{:href => "/nlab/show/morphism"} Morphismus
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  X \overset{f}{\to} Y
          %p
            in einer
            %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
            ein
            %em
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} Isomorphismus
            ist wenn ein weiterer Morphismus in die andere Richtung existiert
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟵
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mi Y
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  X \overset{f^{-1}}{\longleftarrow} Y
                  \\,,
          %p
            welcher
            %a.existingWikiWord{:href => "/nlab/show/inverse"} invers
            zu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            ist in dem Sinne dass
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %msub
                    %mi id
                    %mi Y
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi and
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %mi f
                  %mo =
                  %msub
                    %mi id
                    %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f \circ f^{-1} = id_Y \;\;\;\;\; and \;\;\;\;\; f^{-1} \circ f = id_X
                  \\,.
          #Homeomorphism.num_defn
            %h6#definition_7 Definition
            %p
              %strong (Homeomorphismen)
            %p
              Ein
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} Isomorphismus
              in der
              %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              von
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologischen Räumen
              mit
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} stetigen Abbildungen
              zwischen ihnen heisst
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} Homeomorphismus
            %p
              Das ist also eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Abbildung
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              so dass ein dazu
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverser
              %a.existingWikiWord{:href => "/nlab/show/morphism"} Morphismus
              existiert, nämich eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
              in der anderen Richtung
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟵
                    %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X \longleftarrow Y \;\colon\; f^{-1}
            %p so dass
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msub
                      %mi id
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi id
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \circ f^{-1} = id_{Y} \;\;\;and\;\;\; f^{-1} \circ f = id_{X}
                    \\,.
          %p
            %img{:src => "https://ncatlab.org/nlab/files/Homeomorphism.png", :width => "560"}/
          %blockquote
            %p
              Illustration aus
              %a{:href => "#Munkres75"} Munkres 75
          #OpenBallsHomeomorphicToRn.num_example
            %h6#beispiel_7 Beispiel
            %p
              %strong (offenes Intervall homöomorph zur reellen Geraden)
            %p
              Das offene
              %a.existingWikiWord{:href => "/nlab/show/interval"} Intervall
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1,1)
              ist
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              zu der gesamten
              %a.existingWikiWord{:href => "/nlab/show/real+line"} reellen Geraden
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ≃
                      %mi homeo
                    %msup
                      %mi ℝ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (0,1) \underset{homeo}{\simeq} \mathbb{R}^1
                    \\,.
            %p
              Ein
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverses
              Paar von
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} stetigen Funktionen
              ist zum Beispiel gegeben durch
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mi x
                              %msqrt
                                %mrow
                                  %mn 1
                                  %mo +
                                  %msup
                                    %mi x
                                    %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f &amp;\colon&amp;  \mathbb{R}^1 &amp;\longrightarrow&amp; (-1,+1)
                    \\\
                    \&amp;&amp; x &amp;\mapsto&amp; \frac{x}{\sqrt{1+ x^2}}
                    }
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mi x
                              %msqrt
                                %mrow
                                  %mn 1
                                  %mo −
                                  %msup
                                    %mi x
                                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f^{-1} &amp;\colon&amp;  (-1,+1) &amp;\longrightarrow&amp; \mathbb{R}^1
                    \\\
                    \&amp;&amp; x &amp;\mapsto&amp; \frac{x}{\sqrt{1 - x^2}}
                    }
                    \\,.
            %p
              Allgemein ist jeder
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} offene Ball
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBalls"}
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              zum ganzen
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          #HomeomorphismBetweenTopologicalAndCombinatorialCircle.num_example
            %h6#beispiel_8 Beispiel
            %p
              %strong (Intervall an den Endpunkten verklebt ist homöomorph zum Kreis)
            %p
              Als topologische Räume ist das
              %a.existingWikiWord{:href => "/nlab/show/interval"} Intervall
              mit identifizierten Endpunkten
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Homeomorphism"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/circle"} Einheitskreis
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ≃
                      %mi homeo
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [0,1]_{/(0 \sim 1)} \;\; \underset{homeo}{\simeq} \;\; S^1
                    \\,.
            %p Mehr im Detail: Sei
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \hookrightarrow \mathbb{R}^2
            %p
              der
              %a.existingWikiWord{:href => "/nlab/show/circle"} Einheitskreis
              in der
              %a.existingWikiWord{:href => "/nlab/show/plane"} Ebene
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ,
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    S^1 = \{(x,y) \in \mathbb{R}^2, x^2 + y^2 = 1\}
            %p
              ausgestattet mit der
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} Unterraumtopologie
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metrischen Topologie
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#MetricTopology"}
            %p Darüberhinaus, sei
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [0,1]_{/(0 \sim 1)}
            %p
              der
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} topologische Quotientenraum
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/interval"} Intervall
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} [0,1] \subset \mathbb{R}^1
              mit seine
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} Unterraumtopologie
              erhalten wird durch Anwendung der
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} Äquivalenzrelation
            %p Betrachte dann die Funktion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; [0,1] \longrightarrow S^1
            %p gegeben durch
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    t \mapsto (cos(t), sin(t))
                    \\,.
            %p
              Diese hat die Eigenschaft dass
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0) = f(1)
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} topologischen Quotientenraum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo ∼
                                %mn 1
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [0,1] &amp;\overset{}{\longrightarrow}&amp; [0,1]_{/(0 \sim 1)}
                    \\\
                    \&amp; {}_{\mathllap{f}}\searrow &amp; \downarrow^{\mathrlap{\tilde f}}
                    \\\
                    \&amp;&amp; S^1
                    }
                    \\,.
            %p
              Wir behaupten dann
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              ein
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} Homöomorphismus
              ist (Definition
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
            %p
              Zunächst ist es klar dass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
              ist. Das folgt direkt aus der tatsache dass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
              ist und per Definition der
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} Quotiententopologie
              (Beispiel
              = succeed ")." do
                %a.maruku-ref{:href => "#QuotientTopologicalSpace"}
            %p
              Wir müssen also prüfen dass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              eine stetige inverse Funtion hat. Offensichtlich hat die Einschränkung von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              selbst auf das offene Intervall
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1)
              ein stetiges Inverses. Es hat kein stetiges Inverses auf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,1)
              und auf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (0,1]
              und hat überhaupt kein Inverses auf [0,1], weil
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0) = f(1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ∼
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,1]_{/(0 \sim 1)}
              hat genau die Eigenschaft dass sie diese Probleme herausteilt.
          %p Analog gilt:
          %p
            Das
            %a.existingWikiWord{:href => "/nlab/show/square"} Quadrat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mn 2
                %annotation{:encoding => "application/x-tex"} [0,1]^2
            mit zwei seiner Seiten identifiziert ist der
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} Zylinder
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/torus"} Torus
          %p
            %img{:src => "https://ncatlab.org/nlab/files/TorusAsQuotientOfSquare.png", :width => "500"}/
          %p
            Wenn die Seiten hingegen mit umgekehrter Orientierung identifiziert werden, dann ist das Resultat das
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M%C3%B6bius+strip"} Möbiusband
          %p
            %img{:src => "https://ncatlab.org/nlab/files/MoebiusStripAsQuotientOfSquare.png", :width => "400"}/
          %blockquote
            %p
              Illustration aus
              %a{:href => "#Lawson03"} Lawson 03
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Wichtige Beispiele von topologischen Räumen die
            %em nicht
            homöomorph sind, enthalten die folgenden:
          #TopologicalInvarianceOfDimension.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"}> topologische Invarianz der Dimension
                )
            %p
              Seien
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2 \in \mathbb{N}
              aber
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo ≠
                      %msub
                        %mi n
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} n_1 \neq n_2
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} kartesischen Räume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              und
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              %em nicht
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
            %p
              Allgemeiner, eine
              %a.existingWikiWord{:href => "/nlab/show/open+set"} offene Menge
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_1}
              ist nie homöomorph zu einer offenen Menge in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n_2}
              wenn
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo ≠
                      %msub
                        %mi n
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} n_1 \neq n_2
          %p
            Der beweis des Theorems
            %a.maruku-ref{:href => "#TopologicalInvarianceOfDimension"}
            ist überraschend anspruchsvoll, angesichts wie offensichtlich die Aussage intuitiv erscheint. Man benötigt Werkzeuge der
            %em
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraischen Topologie
            (insbesondere
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Brouwer%27s+fixed+point+theorem"} den Fixpunktsatz von Brouwer
          %p
            Wir illustrieren nun die Werkzeuge der
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraischen Topologie
            und demonstrieren die Natur ihrer Anwednung durch den Beweis zweier sehr einfacher Spezialfälle der
            %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topologischen Invarianz der Dimension
            (prop.
            %a.maruku-ref{:href => "#TopologicalInvarianceOfDimensionFirstSimpleCase"}
            und prop.
            %a.maruku-ref{:href => "#topologicalInvarianceOfDimensionSecondSimpleCase"}
            unten).
          .num_example
            %h6#beispiel_9 Beispiel
            %p
              %strong (Homeomorphismusklassen von Flächen)
            %p
              Die
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 3
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msup
                      %mi y
                      %mn 2
                    %mo +
                    %msup
                      %mi z
                      %mn 2
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^2 = \{(x,y,z) \in \mathbb{R}^3 \vert x^2 + y^2 + z^2 = 1\}
              ist
              %em nicht
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              zu dem
              %a.existingWikiWord{:href => "/nlab/show/torus"} Torus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi T
                        %mn 2
                      %mo =
                      %msup
                        %mi S
                        %mn 1
                      %mo ×
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T^2 = S^1 \times S^1
            %p
              Allgemein ist die Homeomorphismusklasse einer
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} geschlossenen
              %a.existingWikiWord{:href => "/nlab/show/orientable"} orientierbaren
              %a.existingWikiWord{:href => "/nlab/show/surface"} Fläche
              durch die Anzahl der “Löcher” determiniert die die Fläche hat: ihr
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/genus+of+a+surface"} Geschlecht
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#Homotopy Homotopie
          %p
            Wir haben oben gesehen dass für
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \geq 1
            der
            %a.existingWikiWord{:href => "/nlab/show/open+ball"} offene Ball
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mn 0
                    %mo ∘
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B_0^\circ(1)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %em nicht
            %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
            zu, insbesondere, dem Punkt
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo =
                  %msup
                    %mi ℝ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \ast = \mathbb{R}^0
            ist (Beispiel
            = succeed "," do
              %a.maruku-ref{:href => "#OpenBallsHomeomorphicToRn"}
            = succeed ")." do
              %a.maruku-ref{:href => "#TopologicalInvarianceOfDimension"}
            = succeed "-Ball" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-Balles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Diese Intuition wird durch die Beobachtung präzisiert dass ein
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
            existiert auf dem
            %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} topologischen Produktraum
            (Beispiel
            = succeed ")" do
              %a.maruku-ref{:href => "#ProductTopologicalSpace"}
            %a.existingWikiWord{:href => "/nlab/show/interval"} Intervall
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %msubsup
                    %mi B
                    %mn 0
                    %mo ∘
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\eta \colon [0,1] \times B_0^\circ(1)  \longrightarrow \mathbb{R}^n
          %p gegeben durch Reskalierung:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi t
                  %mo ⋅
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (t,x) \mapsto t \cdot x
                  \\,.
          %p
            Dies interpoliert stetig zwischen dem offenen Ball und dem Punkt, in dem Sinne dass für
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} t = 1
            die Abbildung sich auf die definierende Einbettung einschränkt
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mn 0
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B_0^\circ(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} t = 0
            konstant ist.
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/ShrinkingBalls.png", :width => "200"}/
          %p
            Wir können diese Siutation zusammenfassen durch ein
            %a.existingWikiWord{:href => "/nlab/show/diagram"} Diagramm
            von
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetigen Abbildungen
            der folgenden Form:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi B
                            %mn 0
                            %mo ∘
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mi x
                                %mo ↦
                                %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                          %mo ×
                          %msubsup
                            %mi B
                            %mn 0
                            %mo ∘
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi t
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ↦
                              %mi t
                              %mo ⋅
                              %mi x
                        %mtd
                          %msup
                            %mi ℝ
                            %mi n
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mi inclusion
                      %mtr
                        %mtd
                          %msubsup
                            %mi B
                            %mn 0
                            %mo ∘
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  B_0^\circ(1) \times \{0\}
                  \\\
                  \\downarrow &amp; \searrow^{\mathrlap{x \mapsto 0}}
                  \\\
                  [0,1] \times B_0^\circ(1)
                  \&amp;\overset{(t,x) \mapsto t \cdot x}{\longrightarrow}&amp;
                  \\mathbb{R}^n
                  \\\
                  \\uparrow &amp; \nearrow_{\mathrlap{inclusion}}
                  \\\
                  B_0^\circ(1) \times \{1\}
                  }
          %p
            Solche “stetigen Deformationen” heissen
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopies"} Homotopien
          #LeftHomotopy.num_defn
            %h6#definition_8 Definition
            %p
              %strong (Homotopie)
            %p
              Seien
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f,g\colon X \longrightarrow Y
              zwei
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} stetige Funktionen
              zwischen
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologischen Räumen
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X,Y
              %em
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} (linke) Homotopie
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ⇒
                      %mi L
                    %mspace{:width => "thinmathspace"}
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \colon f \,\Rightarrow_L\, g
            %p
              eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mi I
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; X \times I \longrightarrow Y
            %p
              aus dem
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} topologischen Produktraum
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#ProductTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} kommutierendes Diagramm
              der folgenden Form passt:
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://www.ncatlab.org/nlab/files/AHomotopy.jpg", :width => "400"}/
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                            %mo ×
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {0} \times X
                    \\\
                    {}^{\mathllap{(id,\delta_0)}}\downarrow &amp; \searrow^{\mathrlap{f}}
                    \\\
                    [0,1] \times X  &amp;\stackrel{\eta}{\longrightarrow}&amp; Y
                    \\\
                    {}^{\mathllap{(id,\delta_1)}}\uparrow &amp; \nearrow_{\mathrlap{g}}
                    \\\
                    \\{1\} \times X
                    }
                    \\,.
            %blockquote
              %p
                Illustration von J. Tauber
                %a{:href => "http://jtauber.com/blog/2005/07/01/path_homotopy/"} here
          #HomotopyEquivalence.num_defn
            %h6#definition_9 Definition
            %p
              %strong (Homotopieäquivalenz)
            %p
              Eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              heisst
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} Homotopieäquivalenz
              wenn
            %ol
              %li
                %p
                  es eine stetige Abbildung in der anderen Richtung gibt,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi Y
                          %mo ⟶
                          %mi X
                        %annotation{:encoding => "application/x-tex"} g \;\colon\; Y \longrightarrow X
              %li
                %p
                  sowie
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/left+homotopies"} left homotopies
                  = succeed "," do
                    %a.maruku-ref{:href => "#LeftHomotopy"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ∘
                    %mi g
                    %msub
                      %mo ⇒
                      %mi L
                    %msub
                      %mi id
                      %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_1 \;\colon\; f\circ g \Rightarrow_L id_Y
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ∘
                    %mi f
                    %msub
                      %mo ⇒
                      %mi L
                    %msub
                      %mi id
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_2 \;\colon\; g\circ f \Rightarrow_L id_X
                    \\,.
          .num_example
            %h6#beispiel_10 Beispiel
            %p
              %strong (der offene Ball ist kontrahierbar)
            %p
              Jeder
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} offene Ball
              (oder geschlossene Ball) also (nach Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#OpenBallsHomeomorphicToRn"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} kartesische Raum
              ist
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopieäquivalent
              zum Punkt
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %munder
                      %mo ≃
                      %mi homotopy
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^n \underset{homotopy}{\simeq} \ast
                    \\,.
          .num_example
            %h6#beispiel_11 Beispiel
            %p
              Die folgenden drei
              %a.existingWikiWord{:href => "/nlab/show/graphs"} Graphen
            %p
              %img{:src => "https://ncatlab.org/nlab/files/ThreeNonHomeoButHomotopyEquivGraphs.png", :width => "400"}/
            %p
              (also die offensichtlichen
              %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topologischen Unterräume
              der
              %a.existingWikiWord{:href => "/nlab/show/plane"} Ebene
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              die diese Bilder anzeigen) sind nicht
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopieäquivalent
              %a.existingWikiWord{:href => "/nlab/show/disk"} Scheibe
              aus der zwei Punkte entnommen sind, kraft der Homotopien die in folgenden Bildern angedeutet sind:
            %p
              %img{:src => "https://ncatlab.org/nlab/files/HomotopyEquivalentsToBiAnnulus.png", :width => "400"}/
            %blockquote
              %p
                Illustration aus
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#ConnectedComponents Zusammenhangskomponenten
          %p
            Unter Verwendung des Begriffs der
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} Homotopie
            erhält man die grundlegnden Werkzeuge der
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraischen Topologie
            %a.existingWikiWord{:href => "/nlab/show/homotopy+invariants"} Homotopieinvarianten
            von topologischen Räumen. Wir führen hier die einfachsten dieser Werkzuge ein und illustrieren deren Anwendung.
          .num_example
            %h6#bespiel Bespiel
            %p
              Eine
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} Homotopie
              zwischen zwei Punkten
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \;\colon\; \ast \to X
            %p
              ist einfach ein stetiger
              %a.existingWikiWord{:href => "/nlab/show/path"} Pfad
              zwischen diesen Punkten.
          #pi0.num_defn
            %h6#definition_10 Definition
            %p
              %strong (Zusammenhangskomponenten)
            %p
              Die Megen der
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} Homotopieklassen
              von Punkten in einem topologischen Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              heisst die Menge der
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/connected+components"} Pfadzusammenhangskomponenten
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(X) \in Set
                    \\,.
            %p
              Wen
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_0(X) \simeq \ast
              ein einzelnes Element enthält, dann heisst
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ein
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} pfad-zusammenhängender topologischer Raum
            %p
              Wenn
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} stetige Abbildung
              zwischen
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologischen Räumen ist
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} Homotopieklassen
              von Punkten eine
              %a.existingWikiWord{:href => "/nlab/show/function"} Funktion
              zwischen den Zusammenhangskomponenten. Diese bezeichnen wir durch:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(f) \;\colon\; \pi_0(X) \longrightarrow \pi_0(Y)
                    \\,.
          %p
            Diese Konstruktion ist offenbar mit
            %a.existingWikiWord{:href => "/nlab/show/composition"} Komposition
            verträglich, in dem Sinne dass
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ∘
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0(g \circ f) = \pi_0(g) \circ \pi_0(f)
          %p
            und ist offensichtlich
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi id
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0(id_X) = id_{\pi_{0}(X)}
                  \\,.
          %p
            Man fasst diesen sachverhalt zusammen indem man sagt dass
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \pi_0
            %em
              %a.existingWikiWord{:href => "/nlab/show/functor"} Funktor
            ist von der
            %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            von
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologischen Räumen
            zu der
            %a.existingWikiWord{:href => "/nlab/show/category"} Kategorie
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            der
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sets"} Mengen
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Top
                  %mo ⟶
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_0 \;\colon\; Top \longrightarrow Set
                  \\,.
          %p Eine offensichtliche aber wichtige Konsequen ist dies:
          #ConnectedComponentsDistinctImpliesHeomeClassesDistinct.num_prop
            %h6#proposition_3 Proposition
            %p
              Wenn die Mengen von
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} Zusammenhangskomponenten
              zweier
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topologischer Räume
              nicht
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijektiv
              sind, dann können die beiden Räume nicht
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homöomorph
              zueinander sein:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %munder
                      %mo ≠
                      %mi homeo
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(X) \neq \pi_0(Y)
                    \\;\;\;
                    \\Rightarrow
                    \\;\;\,
                    X \underset{homeo}{\neq} Y
          .proof
            %h6#beweis Beweis
            %p
              Da
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              %a.existingWikiWord{:href => "/nlab/show/functor"} funktoriell
              ist, folgt sofort das es
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} Isomorphismen
              auf
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} Isomorphismen
              schickt, also
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} Homöomorphismen
              auf
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/bijections"} Bijektionen
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mi f
                            %mo ∘
                            %mi g
                            %mo =
                            %mi id
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi and
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi g
                            %mo ∘
                            %mi f
                            %mo =
                            %mi id
                        %mtr
                          %mtd
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∘
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi und
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ∘
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi id
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi und
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; f \circ g = id \;\;and\;\; g \circ f = id
                    \\\
                    \\Rightarrow \;\;\;\;\;\;&amp;
                    \\pi_0(f \circ g) = \pi_0(id) \;\;und \;\; \pi_0(g \circ f) = \pi_0(id)
                    \\\
                    \\Leftrightarrow \;\;\;\;\;\;
                    \&amp;
                    \\pi_0(f) \circ \pi_0(g) = id \;\;und \;\; \pi_0(g) \circ \pi_0(f) = id
                    \\end{aligned}
                    \\,.
          %p Dies bedeutet dass wir dir Zuammenhangskomponenten als eine erste “topologische Invariante” betrachten können, welche uns erlaubt manche topologischen Räume zu unterscheiden.
          .un_remark{:style => "border:solid #0000cc;background: #add8e6;border-width:2px 1px;padding:0 1em;margin:0 1em;"}
            %p
              %strong Prinzip der algebraischen Topologie
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,\,
              %em Verwende topologische Invarianten um topologische Räume zu unterscheiden.
          %p
            Als Anwendungsbeispiel haben wir den folgenden Beweis eines Spezialfalls der
            %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topologischen Invarianz der Dimension
            (Theorem
            = succeed "):" do
              %a.maruku-ref{:href => "#TopologicalInvarianceOfDimension"}
          #TopologicalInvarianceOfDimensionFirstSimpleCase.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topologische Invarianz der Dimension
                – erster einfacher Fall)
            %p
              Die
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} kartesische Räume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              und
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              sind nicht
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Homeomorphism"}
          .proof
            %h6#beweis_2 Beweis
            %p
              Wir nehmenn an e gäbe einen
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} Homöomorphismus
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \colon \mathbb{R}^1 \longrightarrow \mathbb{R}^2
            %p
              und werden einen Widerspruch erhalte. Sei also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              ein Homeomorphismus, dann ist offensichtlich auch seine Einschränkung auf den
              %a.existingWikiWord{:href => "/nlab/show/topological+subspaces"} topologischen Unterraum
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#SubspaceTopology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f(0) \in \mathbb{R}^2
              erhält ein Homeomorphismus:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\;\colon\;
                    (\mathbb{R}^1-\{0\})
                    \\longrightarrow
                    (\mathbb{R}^2 - \{f(0)\})
                    \\,.
            %p
              Es folgt also dass wir ein Bijektion zwischen den
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} Zusammenhangskomponenten
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\mathbb{R}^1 - \{0\})
              und
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\mathbb{R}^2  - \{f(0)\})
              erhalten würden. Aber eine solche existiert offensichtlich nicht, da letztere Menge nur ein Element enthält, aber erstere Menge zwei Elemente enhält (die negativen und die positiven Zahlen )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≠
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(\mathbb{R}^1-\{0\})
                    \\;\neq\;
                    \\pi_0(\mathbb{R}^2 - \{f(0)\})
                    \\,.
          %p
            Die Lehre aus dem beweis von prop.
            %a.maruku-ref{:href => "#TopologicalInvarianceOfDimensionFirstSimpleCase"}
            ist seine Strategie:
          .un_remark{:style => "border:solid #0000cc;background: #add8e6;border-width:2px 1px;padding:0 1em;margin:0 1em;"}
            %p
              %strong Prinzip der algebraischen Topologie
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,\,
              %em Verwende topologische Invarianten um topologische Räume zu unterscheiden.
          %p
            Natürlich verwendet man in der Praxis stärkere Invarianten als nur
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
          %p
            Die enächset topologische Invariante nach den
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} Zusammenhangskomponenten
            ist die
            %em
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"}> Fundamentalgruppe
              \:
          %h3#FundamentalGroups Fundamentalgruppe
          #FundamentalGroup.num_defn
            %h6#definition_11 Definition
            %p
              %strong (Fundamentalgruppe)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ein
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              und sein
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              ein gegebener Punkt. Dann schreiben wir
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(X,x)
                    \\;\in\;
                    Grp
            %p
              für, zunächst, die Menge von
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} Homotopieklassen
              von
              %a.existingWikiWord{:href => "/nlab/show/paths"} Pfaden
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              die bei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              starten und enden. Solche Pfade heissen stetige
              %a.existingWikiWord{:href => "/nlab/show/loops"} Schleifen
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              basiert bei
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %ol
              %li
                %p
                  Unter Aneinanderhängen von Schleifen wird
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  zu einer
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/semi-group"} Semigruppe
              %li
                %p
                  die konstante Schleife ist
                  %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutrales Element
                  und macht
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  zu einem “
                  %a.existingWikiWord{:href => "/nlab/show/monoid"}> Monoiden
                  ”.
              %li
                %p
                  Umkehrung von Schleifen schickt sie auf ihr
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/inverse"} Inverses
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  zu einer
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/group"} Gruppe
            %p
              Diese heisst die
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgrupp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              bei
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            Das folgende Bild deutet die vier nicht-trivialen Generatoren der
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgruppe
            der orientierten
            %a.existingWikiWord{:href => "/nlab/show/surface"} Fläche
            vom
            %a.existingWikiWord{:href => "/nlab/show/genus+of+a+surface"} Geschlecht
            2:
          %p
            %img{:src => "https://ncatlab.org/nlab/files/FundamentalGroupOfGenus2Surface.png", :width => "500"}/
          %blockquote
            %p
              Illustration aus
              %a{:href => "#Lawson03"} Lawson 03
          %p
            Auch diese Konstruktion ist
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor"} funktoriell
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Top
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} Top^{\ast/}
            von
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} punktierten topologischen Räumen
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Top
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo ⟶
                  %mi Grp
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1 \;\colon\; Top^{\ast/} \longrightarrow Grp
                  \\,.
          %p
            As
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1
            is a topological invariant. As before, we may use this to prove a simple case of the theorem of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topological invariance of dimension
          #SimplyConnected.num_defn
            %h6#definition_12 Definition
            %p
              Ein topologischer Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              für den
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \pi_0(X) \simeq \ast
                  (
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"}> pfad-zusammenhängend
                  , def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#pi0"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \pi_1(X,x) \simeq 1
                  (die Fundamentalgruppe ist
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
                  = succeed ")," do
                    %a.maruku-ref{:href => "#FundamentalGroup"}
            %p
              heisst
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} einfach zusammenhängend
          #topologicalInvarianceOfDimensionSecondSimpleCase.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+invariance+of+dimension"} topologische Invarianz der Dimension
                – zweites einfaches Beispiel)
            %p
              Es gibt
              %em keinen
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} Homöomorphismus
              zwischen
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              und
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
          .proof
            %h6#beweis_3 Beweis
            %p
              Wir nehmen an es gäbe einen Homeomorphismus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              und werden einen Widerspruch herleiten.
            %p
              Sei also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              ein Homeomorphismus, dann ist auch seine Einschränkung auf das Komplement eines Punktes einer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 3
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{R}^2 - \{0\})
                    \\longrightarrow
                    (\mathbb{R}^3 - \{f(0)\})
                    \\,.
            %p
              Diese Räume sind beide zusammenhängend, lassen sich also durch
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_0
              nicht unterscheiden.
            %p
              Aber ihre
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} Fundamentalgruppen
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              sind unterschiedlich:
            %ol
              %li
                %p
                  Die Fundamentalgruppe von
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 2
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2} - \{0\}
                  ist
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  (die Windungszahl von Schleifen um den entfernten Punkt). Wir diskutieren dies näher unten in Beispiel
                  = succeed "." do
                    %a.maruku-ref{:href => "#FundamentalGroupOfTheCircle"}
              %li
                %p
                  Die Fundamentalgruppe von
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 3
                        %mo −
                        %mo{:stretchy => "false"} {
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^3 - \{f(0)\}
                  its trivial: der einzelne fehlende Punkt hindert nicht daran Schleifen beliebig zusammenzuziehen.
            %p
              Aber weil die Konstrution der Fundamentalgruppe
              %a.existingWikiWord{:href => "/nlab/show/functor"} funktiell
              sit, so folgt, mit de gleichen Argument wie in dem Beweis von Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ConnectedComponentsDistinctImpliesHeomeClassesDistinct"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              kein
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} Isomorphismus
              sein kein, also kein
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} Homöomorphismus
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#CoveringSpaces Überlagerungsraum
          %p
            Wir diskutieren nun eine “duale Erscheinungsform” der Fundamentalgruppe
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
          #CoveringSpace.num_defn
            %h6#definition_13 Definition
            %p
              %strong (Überlagerungsraum)
            %p
              Ein
              %em
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} Überlagerungsraum
              über einem
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ist eine
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} stetige Abbildung
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    p \;\colon\; E \longrightarrow X
            %p
              so dass eine
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} offene Überdeckung
              existiert
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i}{\sqcup}U_i \longrightarrow X
            %p
              so dass die Einschränkung von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              auf jedes der
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homöomorph
              ist zu dem
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} topologischen Produktraum
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#ProductTopologicalSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              mit dem
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} diskreten topologischen Raum
              (Beispiel
              = succeed ")" do
                %a.maruku-ref{:href => "#DiscreteTopologicalSpace"}
              %a.existingWikiWord{:href => "/nlab/show/set"} Menge
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} F_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mi i
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msub
                              %mi F
                              %mi i
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mi i
                            %msub
                              %mi U
                              %mi i
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i}{\sqcup} U_i \times F_i &amp;\longrightarrow&amp;  E
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\underset{i}{\sqcup} U_i &amp;\underset{}{\longrightarrow}&amp; X
                    }
                    \\,.
            %p
              Für
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in U_i \subset X
              ein Punkt heissen die Element von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi x
                    %mo =
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_x  = F_i
              die
              %em
                %a.existingWikiWord{:href => "/nlab/show/leaf"} Blätter
              der Überlagerung an diesem Punkt.
          #kForlCovringOfCircle.num_example
            %h6#beispiel_12 Beispiel
            %p
              %strong (Überdeckung des Kreises durch den Kreis)
            %div{:style => "float:left;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/pFoldCoveringOfCircleB.png", :width => "180"}/
            %p
              Betrachte den
              %a.existingWikiWord{:href => "/nlab/show/circle"} Kreis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo ∈
                    %mi ℂ
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^1 = \{ z \in \mathbb{C}  \;\vert\; {\vert z\vert} = 1 \}
              als den
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topologischen Unterraum
              von Elementen mit
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} Betrag
              1 in der
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+plane"} komplexen Ebene
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    p \coloneqq (-)^k \;\colon\; S^1 \longrightarrow S^1
            %p
              die eine komplexe Zahl auf ihr
              = succeed "-te" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Man denk sich dies als “der Kreis windet sich
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              mal um sich selbst”. Präzise: für
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \geq 1
              ist dies ein
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} Überlagerungsraum
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              Blättern an jedem Punkt.
            %blockquote
              %p
                Illustration aus
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
          #CoveringOfCircleByRealLine.num_example
            %h6#beispiel_13 Beispiel
            %p
              %strong (Überlagerung des Kreises durch die reelle Gerade)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/UniversalCoveringOfCircle.png", :width => "150"}/
            %p
              Betrachte die
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} stetige Funktion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(2 \pi i(-)) \;\colon\; \mathbb{R}^1 \longrightarrow S^1
            %p
              von der
              %a.existingWikiWord{:href => "/nlab/show/real+line"} reellen Geraden
              zum
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle"} Kreis
            %ol
              %li
                %p
                  mit the Kreis betrachtet als der Einheitskreis in der
                  %a.existingWikiWord{:href => "/nlab/show/complex+plane"} komplexen Ebene
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                  durch
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ↦
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi i
                        %mi t
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        t \mapsto \exp(2\pi i t)
                %p gegeben ist
              %li
                %p
                  mit dem Kreis betrachtet als Einheitskreis in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
                  durch
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi cos
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi sin
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        t \mapsto ( cos(2\pi t), sin(2\pi t) )
                %p gegeben ist.
            %p Man darf sich dies vorstellen als “das unendliche Umwickeln des Kreises durch die reelle Achse”.
            %p
              Präzise: dies ist ein
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} Überlagerungsraum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpace"}
              %a.existingWikiWord{:href => "/nlab/show/leaves"} Blattmenge
              an jedem Punkt isomorph zur Menge
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              der
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} ganzen Zahlen
          #ActionOfFundamentalGroupOnFibersOfCovering.num_defn
            %h6#definition_14 Definition
            %p
              %strong (Wirkung der Fundamentalgruppe auf Blätter einer Überlagerung)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{\pi}{\longrightarrow} X
              ein
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} Überlagerungsraum
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CoveringSpace"}
            %p
              Dann gilt für jeden Punkt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              und jede Wahl von Element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %msub
                      %mi F
                      %mi x
                  %annotation{:encoding => "application/x-tex"} e \in F_x
              aus der
              %a.existingWikiWord{:href => "/nlab/show/leaf+space"} Blattmenge
              über
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} Homotopie
            %ul
              %li
                %p
                  eines Pfades in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  der ein Element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  der
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgruppe
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FundamentalGroup"}
              %li
                %p
                  zu einem stetigen Pfad in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  der bei
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                      %annotation{:encoding => "application/x-tex"} e
                  beginnt.
            %p Dieser Pfad endet notwendigerwise and einem (anderen) Punkt
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} gama
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi F
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_\gama(e) \in F_x
            %p
              in derselben
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} Faser
            %p
              Diese Kontruktion gibt eine
              %a.existingWikiWord{:href => "/nlab/show/function"} Funktion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ρ
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi F
                              %mi x
                            %mo ×
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi F
                              %mi x
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi γ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi ρ
                              %mi γ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\rho &amp;\colon&amp; F_x \times \pi_1(X,x) &amp;\longrightarrow&amp; F_x
                    \\\
                    \&amp;&amp; (e,\gamma) &amp;\mapsto&amp; \rho_\gamma(e)
                    }
            %p
              aus dem
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} kartesischen Produk
              des
              %a.existingWikiWord{:href => "/nlab/show/leaf+space"} Blattraumes
              mit der
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgruppe
              = succeed "-Struktur" do
                %a.existingWikiWord{:href => "/nlab/show/group"} Gruppen
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} Diagramme kommutieren
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi F
                              %mi x
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi const
                              %mi x
                            %mo{:stretchy => "false"} }
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %msub
                              %mi F
                              %mi x
                            %mo ×
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi F
