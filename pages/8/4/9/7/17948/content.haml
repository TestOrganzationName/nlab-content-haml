          #EpsilonDeltaDefinitionOfContinuity.num_defn
            %h6#definition_3 Definition
            %p
              %strong (epsilontische Definition von Stetigkeit)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/EpsilonDeltaBalls.png", :width => "250"}/
            %p
              Seien
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi d
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d_X)
              und
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi d
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,d_Y)
              zwei
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metrische Räume
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MetricSpace"}
              %a.existingWikiWord{:href => "/nlab/show/function"} Funktion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              %em
                stetig am Punkt
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              wenn für jedes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              ein
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta\gt 0
              existiert, so dass
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi d
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"}
                    d_X(x,y) \lt \delta \;\;\Rightarrow\;\; d_Y(f(x), f(y)) \lt \epsilon
            %p oder äquivalent dazu, so dass
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi B
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f(\;B_x^\circ(\delta)\;) \;\subset\; B^\circ_{f(x)}(\epsilon)
            %p
              wobei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} B^\circ
              den
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} offenen Ball
              bezeichnet (Definition
              = succeed ")." do
                %a.maruku-ref{:href => "#OpenBalls"}
            %p
              Die Funktion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              heisst
              %em stetig
              wenn sie an jedem Punkt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              stetig ist.
          %p
            Wir formulieren diese analytische Begriffsbildung nun um, durch den einfachen aber wichtigen Begriff der
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/open+set"} offenen Menge
          #OpenSubsetsOfAMetricSpace.num_defn
            %h6#definition_4 Definition
            %p
              %strong (Umgebung und offene Menge)
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              ein
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metrischer Raum
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MetricSpace"}
            %ol
              %li
                %p
                  Eine
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} Umgebung
                  eines Punktes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  ist eine
                  %a.existingWikiWord{:href => "/nlab/show/subset"} Untermenge
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi U
                          %mo ⊂
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in U \subset X
                  %a.existingWikiWord{:href => "/nlab/show/open+ball"} offen Ball
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi B
                          %mi x
                          %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B_x^\circ(\epsilon)
                  um
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  enthält (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#OpenBalls"}
              %li
                %p
                  Eine
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/open+subset"} offene Menge
                  von
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  ist eine
                  %a.existingWikiWord{:href => "/nlab/show/subset"} Untermenge
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  die für jedes
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                      %annotation{:encoding => "application/x-tex"} x \in U
                  auch noch eine
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} Umgebung
                  von
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  enthält.
          %p
            Das folgende Bild zeigt einen Punkt
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %a.existingWikiWord{:href => "/nlab/show/open+balls"} offene Bälle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
