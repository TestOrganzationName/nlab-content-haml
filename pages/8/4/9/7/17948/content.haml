          .num_example
            %h6#beispiel_14 Beispiel
            %p
              %strong (drei-blättrige Überdeckung des Kreises)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/The3SheetedCoveringsOfTheCircle.png", :width => "150"}/
            %p
              Es gibt, bis auf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} Isomorphismus
              %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} Überlagerungen
              des
              %a.existingWikiWord{:href => "/nlab/show/circle"} Kreises
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
            %p
              Die von Beeispiel
              %a.maruku-ref{:href => "#kForlCovringOfCircle"}
              für
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} k = 3
              %a.existingWikiWord{:href => "/nlab/show/permutation+actions"} Permutationswirkungen
              sind in dem bild rechts angedeutet.
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
          %p
            Wir sind jetzt bereit den Hauptsatz über die
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgruppe
            zu nennen.
          %p Wir bnötigen nur noch die folgende technische Bdingung. Diese ist für alle “sinnvollen” topologischen Räume erfüllt:
          #SemiLocallySimplyConnected.num_defn
            %h6#definition_15 Definition
            %p
              %strong (semi-lokal einfach zusammenhängend)
            %p
              Ein
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              heisst
            %ol
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/locally+path-connected"} lokal pfad-zusammenhängend
                  wenn für jeden Punkt
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  und für jede
                  %span.newWikiWord
                    neighbourhoodUmgebung
                    %a{:href => "/nlab/new/neighbourhoodUmgebung"} ?
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in U \subset X
                  gilt dass eine Umgebung
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi V
                        %mo ⊂
                        %mi U
                      %annotation{:encoding => "application/x-tex"} x \in V \subset U
                  existiert so dass
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} pfad-zusammenhängend
                  ist (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#pi0"}
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-lokal einfach zusammenhängend
                  wenn jeder Punkt
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  eine
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} Umgebung
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in U \subset X
                  hat so dass der induzierte Morphismus von
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} Fundamentalgruppen
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_1(U,x) \to \pi_1(X,x)
                  trivial ist (also jedes Element auf das
                  %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutrale Element
                  schickt).
          #FundamentalTheoremOfCoveringSpaces.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"}> Fundamentalsatz der Überlagerungstheorie
                )
            %p
              Sei
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              ein
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologischer Raum
              der
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} pfad-zusammenhängend
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#pi0"}
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} lokal pfad-zusammenhängend
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SemiLocallySimplyConnected"}
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-lokal einfach zusammenhängend
              ist (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SemiLocallySimplyConnected"}
            %p
              Dann ist für jedes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              der Funktor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Cov
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fib_x \;\colon\; Cov(X) \overset{}{\longrightarrow} \pi_1(X,x) Set
                    \\,.
            %p
              von def.
              %a.maruku-ref{:href => "#ActionOfFundamentalGroupOnFibersOfCovering"}
              der die
              %a.existingWikiWord{:href => "/nlab/show/action"} Wirkung
              der
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} Fundamentalgruppe
              von
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              auf die Menge der
              %a.existingWikiWord{:href => "/nlab/show/leaves"} Blätter
              über
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              konstruiert hat die folgenden Eigenschaften:
            %ol
              %li
                %p
                  jede
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} Isomorphieklasse
                  von
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
                  %a.existingWikiWord{:href => "/nlab/show/actions"} Wirkungen
                  ist im Bild des Funktors (man sagt: der Funktor ist
                  = succeed ");" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/essentially+surjective+functor"} essentiell surjectiv
              %li
                %p
                  für je zwei Überlagerungsräume
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                        %mo ,
                        %msub
                          %mi E
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} E_1, E_2
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  ist die Abbildung au
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} Morphismen-Mengen
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi x
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mrow
                            %mi Cov
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo ,
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Fib
                          %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi Fib
                          %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Fib_x \;\colon\; Hom_{Cov(X)}(E_1, E_2) \longrightarrow Hom( Fib_x(E_1), Fib_x(E_2) )
                %p
                  eine
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} Bijektion
                  (man sagt der Funktor ist
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} voll true
                  ).
            %p
              Ein Funktor mit diesen Eigenschaften heisst
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} Äquivalenz von Kategorien
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cov
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cov(X) \overset{\simeq}{\longrightarrow} \pi_1(X,x) Set
                    \\,.
          %p Dies hat einige interessante Konsequenzen…
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Every sufficiently nice topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as above has a covering which is
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#SimplyConnected"}
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
            (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#FundamentalTheoremOfCoveringSpaces"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X)
            on itself. This is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat X \to X
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            itself may be recovered as the
            %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            of the universal covering space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Aut
                    %mrow
                      %msub
                        %mi Cov
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1(X) \simeq Aut_{Cov_{/X}}(\hat X, \hat X)
                  \\,.
          #FundamentalGroupOfTheCircle.num_example
            %h6#example Example
            %p
              %strong (computing the fundamental group of the circle)
            %p
              The covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \exp(2\pi i(-)) \;\colon\; \mathbb{R}^1 \to S^1
              from example
              %a.maruku-ref{:href => "#CoveringOfCircleByRealLine"}
              is
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SimplyConnected"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %p
              It is fairly straightforward to see that the only
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              to itself over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              are given by
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              translations by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                      %mo ↪
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N} \hookrightarrow \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %mi t
                                %mo ↦
                                %mi t
                                %mo +
                                %mi n
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %mi i
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi exp
                                  %mo{:stretchy => "false"} (
                                  %mn 2
                                  %mi π
                                  %mi i
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^1
                    \&amp;&amp;
                    \\underoverset{\simeq}{t \mapsto t + n}{\longrightarrow}
                    \&amp;&amp;
                    \\mathbb{R}^1
                    \\\
                    \&amp; {}_{\mathllap{\exp(2 \pi i(-))}}\searrow &amp;&amp; \swarrow_{\mathrlap{\exp(2 \pi i(-))}}
                    \\\
                    \&amp;&amp; S^1
                    }
                    \\,.
            %p Hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mrow
                        %msub
                          %mi Cov
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msup
                      %mover
                        %mi S
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{Cov_{/S^1}}(\hat S^1, \hat S^1) \simeq \mathbb{Z}
            %p
              and hence the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              is the additive group of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(S^1) \simeq \mathbb{Z}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %hr/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#literatur Literatur
          %p Einführende Lehrbücher:
          %ul
            %li#Munkres75
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Munkres"}> James Munkres
                ,
                = succeed "," do
                  %em Topology
            %li#Lawson03
              %p
                Terry Lawson,
                = succeed "," do
                  %em Topology: A Geometric Approach
                = succeed ")" do
                  %a{:href => "http://users.metu.edu.tr/serge/courses/422-2014/supplementary/TGeometric.pdf"} pdf
          %p
            Siehe auch die Literatur unter
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraische Topologie
          %p Kurzeinführungen:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Friedhelm+Waldhausen"}> Friedhelm Waldhausen
                ,
                %em Topologie
                (
                %a{:href => "https://www.math.uni-bielefeld.de/~fw/ein.pdf"}> pdf
                )
            %li
              %p
                Alex Kuronya,
                = succeed "," do
                  %em Introduction to topology
                = succeed ")" do
                  %a{:href => "https://www.uni-\nfrankfurt.de/64271720/TopNotes_Spring10.pdf"} pdf
            %li
              %p
                Anatole Katok, Alexey Sossinsky,
                %em Introduction to modern topology and geometry
                (
                %a{:href => "http://www.personal.psu.edu/axk29/MASS-07/Background-forMASS.pdf"}> pdf
                )
          %p Siehe auch
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Topospaces"}> Topospaces
              , ein Wiki mit Grundlagen zur Topologie.
