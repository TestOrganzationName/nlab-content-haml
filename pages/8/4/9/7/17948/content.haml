                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d(x,y) \coloneqq {\Vert x-y\Vert}
                    \\,.
          #OpenBalls.num_defn
            %h6#definition_2 Definition
            %p
              Sei
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,d)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metrischer Raum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              und jede
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/real+number"} reelle Zahl
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{R}_+
              die Menge
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi y
                      %mo ∈
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    B^\circ_x(\epsilon)
                    \\;\coloneqq\;
                    \\left\{
                    y \in X \;\vert\; d(x,y) \lt \epsilon
                    \\right\}
            %p
              der
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+ball"} offene Ball
