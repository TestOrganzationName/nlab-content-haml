                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    [D,C]_{inj}
                    \\stackrel{\overset{Id}{\longleftarrow}}{\underset{Id}{\longrightarrow}}
                    [D,C]_{Reedy}
                    \\stackrel{\overset{Id}{\longleftarrow}}{\underset{Id}{\longrightarrow}}
                    [D,C]_{proj}
          %h3#functoriality_in_domain_and_codomain Functoriality in domain and codomain
          #QuillenFunctorialityInCodomain.num_prop
            %h6#proposition_4 Proposition
            %p
              The functor model structures depend
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen-functorially
              on their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                    %mover
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi L
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    D_1
                    \\stackrel
                    {\overset{L}{\longleftarrow}}
                    {\underset{R}{\longrightarrow}}
                    D_2
            %p
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{S}
              %a.existingWikiWord{:href => "/nlab/show/enriched+Quillen+adjunction"} enriched Quillen adjunction
              between
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{S}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+categories"} enriched model categories
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{S}
              %a.existingWikiWord{:href => "/nlab/show/enriched+Quillen+adjunctions"} enriched Quillen adjunctions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msub
                      %mi D
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %mi R
                          %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %mi L
                          %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msub
                      %mi D
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    [C,D_1]_{proj}
                    \\stackrel
                    {\overset{[C,L]}{\longleftarrow}}
                    {\underset{[C,R]}{\longrightarrow}}
                    [C,D_2]_{proj}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msub
                      %mi D
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %mi R
                          %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi C
                          %mo ,
                          %mi L
                          %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %msub
                      %mi D
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C,D_1]_{inj}
                    \\stackrel
                    {\overset{[C,L]}{\longleftarrow}}
                    {\underset{[C,R]}{\longrightarrow}}
                    [C,D_2]_{inj}
                    \\,.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L \dashv R)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi L
                      %mo{:stretchy => "false"} ]
