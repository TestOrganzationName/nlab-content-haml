                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([C,L] \dashv [C,R])
          %p
            For the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a small category this is &amp;lbrack;
            %a{:href => "#Lurie"}> Lurie, remark A.2.8.6
            \&amp;rbrack;, for the enriched case this is &amp;lbrack;
            %a{:href => "#Lurie"}> Lurie, prop. A.3.3.6
            \&amp;rbrack;.
          %p
            The Quillen-functoriality on the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            is more asymmetric.
          %p
          #QuillenFunctorialityInDomain.num_prop
            %h6 Proposition
            %p
              %strong (Quillen functoriality in the domain category)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi C
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p \colon C_1 \longrightarrow C_2
              a functor between small categories or an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{S}
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              between
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \mathbf{S}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mo !
                    %mo ⊣
                    %msup
                      %mi p
                      %mo *
                    %mo ⊣
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %munder
                          %mo ⟵
                          %mrow
                            %msub
                              %mi p
                              %mo *
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi p
                              %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi p
                            %mo !
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (p_! \dashv p^* \dashv p_*)
                    \\;\colon\;
                    [C_2,D]
                    \\stackrel{\overset{p_!}{\longleftarrow}}{\stackrel{\overset{p^*}{\longrightarrow}}{\underset{p_*}{\longleftarrow}}}
                    [C_1,D]
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p^*
              is precomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo !
                  %annotation{:encoding => "application/x-tex"} p_!
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} p_*
              are left and right
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Then we have
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mo !
                    %mo ⊣
                    %msup
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %munder
                        %mo ⟵
                        %mrow
                          %msup
                            %mi p
                            %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mo !
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    (p_! \dashv p^*)
                    \\;\colon\;
                    [C_1,D]_{proj} \stackrel{\overset{p_!}{\longrightarrow}}{\underset{p^*}{\longleftarrow}}
                    [C_2,D]_{proj}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mo *
                    %mo ⊣
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi p
                            %mo *
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (p^* \dashv p_*)
                    \\;\colon\;
                    [C_1,D]_{inj} \stackrel{\overset{p^*}{\longleftarrow}}{\underset{p_*}{\longrightarrow}}
                    [C_2,D]_{inj}
                    \\,.
            %p
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            not enriched this appears as &amp;lbrack;
            %a{:href => "#Lurie"}> Lurie, prop. A.2.8.7
            \&amp;rbrack;, for the enriched case it appears as &amp;lbrack;
            %a{:href => "#Lurie"}> Lurie, prop. A.3.3.7
            \&amp;rbrack;.
          .num_remark
            %h6#remark Remark
            %p
              In the
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msub
                      %mi D
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p : D_1 \longrightarrow D_2
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-categories"} model structure on sSet-categories
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %h3#relation_to_homotopy_kan_extensionslimitscolimits Relation to homotopy Kan extensions/limits/colimits
          %p
            Often functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ⟶
                  %mi C
                %annotation{:encoding => "application/x-tex"} D \longrightarrow C
            are thought of as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            or
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            or, generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi D
                  %mo ⟶
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} p : D \longrightarrow D'
            any functor, their left and right
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
          %p
            These are the left and right
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HoLan
                  %mo :
                  %mo =
                  %mi 𝕃
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} HoLan := \mathbb{L} p_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HoRan
                  %mo :
                  %mo =
                  %mi ℝ
                  %msub
                    %mi p
                    %mo *
                %annotation{:encoding => "application/x-tex"} HoRan := \mathbb{R} p_*
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi p
                        %mo !
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ′
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                %annotation{:encoding => "application/x-tex"}
                  [D,C]_{proj} \stackrel{p_!}{\longrightarrow}  [D',C]_{proj}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi inj
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi p
                        %mo *
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ′
                  %mo ,
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi inj
                %annotation{:encoding => "application/x-tex"}
                  [D,C]_{inj} \stackrel{p_*}{\longrightarrow} [D',C]_{inj}
          %p respectively.
          %p
            For more on this see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo ′
                  %mo =
                  %mo *
                %annotation{:encoding => "application/x-tex"} D' = *
            this reduces to
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %h3#RelationToInfinityFunctorCategories
            Relation to
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
          .num_prop
            %h6 Proposition
            %p For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \mathbf{D}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                  %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            %p
              then both the projective and the injective model structure on the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sFunc(\mathbf{D}, \mathbf{C})
              (which exist by the above discussion)
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} present
              the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-functors"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-category of
                  = succeed "-functors" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              of the functor model category on its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bifibrant+objects"} bifibrant objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi sFunc
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi D
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} \big(\mathbf{sFunc}(\mathbf{D}, \mathbf{C})\big)^\circ
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor+%28infinity%2C1%29-category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-functor
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              between the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerves"} homotopy coherent nerves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi sFunc
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ≃
                      %mi qCat
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Func
                      %mn ∞
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N \big( \mathbf{sFunc}(\mathbf{D}, \mathbf{C})^\circ \big)
                    \\;\;
                    \\underset{qCat}{\simeq}
                    \\;\;
                    Func_\infty
                    \\Big(
                    N(\mathbf{D})
                    ,\,
                    N\big( \mathbf{C}^\circ \big)
                    \\Big)
                    \\,.
            %p
          This is due to
          = succeed "." do
            %a{:href => "#Lurie"} Lurie (2009), Prop. 4.2.4.4
          %em
            %a{:href => "infinity1-category+of+infinity1-functors#ModelCategoryPresentation"} here
          at
          = succeed "." do
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-functors"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category of
                = succeed "-functors" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %h2#examples Examples
          %p
            Examples of cofibrant objects in the projective model structure are discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/projectively+cofibrant+diagram"} projectively cofibrant diagram
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"}> model structure on simplicial presheaves
                )
              %br/
              Model structures on
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
              and specifically in
              = succeed "-theory" do
                %a.existingWikiWord{:href => "/nlab/show/model+topos"} model topos
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-toposes
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              for more.
          %p Specifically:
          %p
          #BorelModelStructureOnSimplicialGroupActions.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Grp(sSet)
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              with
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              denoted
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi 𝒢
                      %mo ∈
                      %mi sSet
                      %mtext -
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \in sSet\text{-}Grpd
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo ⟶
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathcal{G} \longrightarrow sSet
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group+action"} simplicial group action
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p
              Under this identification, the projective model strcuture on
              %a.existingWikiWord{:href => "/nlab/show/simplicial+functors"} simplicial functors
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExistenceOfProjectiveStructureOnEnrichedFunctors"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Borel
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sFunc\big(
                    \\mathbf{B}\mathcal{G}
                    ,\,
                    sSet
                    \\big)_{proj}
                    \\;\;
                    \=
                    \\;\;
                    \\mathcal{G}Act(sSet)_{Borel}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ∈
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \in sSet\text{-}Grpd
              an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
              (Dwyer-Kan
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒳
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \pi_0(\mathcal{X}) \simeq \{[x]\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"}
                    \\iota
                    \\,\colon\,
                    \\mathbf{B}(\mathcal{X}(x,x))
                    \\xhookrightarrow{\phantom{---}}
                    \\mathcal{X}
            %p
              is an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+adjoint+equivalence"} enriched adjoint equivalence
              (see discussion
              = succeed ")" do
                %a{:href => "simplicial+groupoid#RelationToSimplicialGroups"} there
              %a.existingWikiWord{:href => "/nlab/show/simplicial+functors"} simplicial functors
              from Prop.
              %a.maruku-ref{:href => "#ExistenceOfProjectiveStructureOnEnrichedFunctors"}
              is
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred
              under the induced
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ι
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi ι
                            %mo !
                    %mi sFunc
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Borel
                  %annotation{:encoding => "application/x-tex"}
                    sFunc\big(
                    \\mathcal{X}
                    ,\,
                    sSet
                    \\big)_{proj}
                    \\underoverset
                    {\underset{\iota^\ast}{\longrightarrow}}
                    {\overset{\iota_!}{\longleftarrow}}
                    {\;\; \bot_{\simeq} \;\;}
                    sFunc\Big(
                    \\mathbf{B}\big(\mathcal{X}(x,x)\big)
                    ,\,
                    sSet
                    \\Big)_{proj}
                    \\;=\;
                    \\big(\mathcal{X}(x,x)\big) Act(sSet)_{Borel}
            %p
              By
              %a{:href => "transferred+model+structure#RightTransferAlongAdjointEquivalence"} this example
              it follows that morphisms in all three classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} W
                    %mo ,
                    %mi Fib
                    %mo ,
                    %mi Cof
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathrm{W}, Fib, Cof)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} sFunc(\mathcal{X}, \, sSet)_{proj}
              are those which restrict on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in Obj(\mathcal{X})
              to the respective class in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi 𝒳
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi Act
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Borel
                    %annotation{:encoding => "application/x-tex"} \big(\mathcal{X}(x,x)\big) Act(sSet)_{Borel}
            %p
              It follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %mtext -
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \,\in\, sSet\text{-}Grpd
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
              with any set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\mathcal{X})
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              %a{:href => "model+category#ProductModelStructure"} product model structure
              of the
              %a.existingWikiWord{:href => "/nlab/show/Borel+model+structures"} Borel model structures
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sFunc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mo ⊥
                          %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mrow
                          %msup
                            %mi ι
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi ι
                            %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mi sFunc
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %msub
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Borel
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    sFunc\big(
                    \\mathcal{X}
                    ,\,
                    sSet
                    \\big)_{proj}
                    \\underoverset
                    {\underset{\iota^\ast}{\longrightarrow}}
                    {\overset{\iota_!}{\longleftarrow}}
                    {\;\; \bot_{\simeq} \;\;}
                    \\underset{i \in \pi_0(\mathcal{X})}{\prod}
                    sFunc\Big(
                    \\mathbf{B}\big(\mathcal{X}(x_i,x_i)\big)
                    ,\,
                    sSet
                    \\Big)_{proj}
                    \\;=\;
                    \\underset{i \in \pi_0(\mathcal{X})}{\prod}
                    \\big(\mathcal{X}(x_i,x_i)\big) Act(sSet)_{Borel}
                    \\,.
            %p
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"}> Reedy model structure
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+model+structure"} generalized Reedy model structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sections"} model structure on sections
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/lim%5E1+and+Milnor+sequences"} lim^1 and Milnor sequences
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+homotopical+presheaves"}> model structure on homotopical presheaves
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+n-excisive+functors"} model structure for n-excisive functors
          %h2#references References
          %p
            The projective model structure on
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
          %ul
            %li#Piacenza91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Piacenza"} Robert Piacenza
                section 5 of
                = succeed "," do
                  %em Homotopy theory of diagrams and CW-complexes over a category
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Piazenza91.pdf", :title => "pdf"} pdf
              %p
                also chapter VI of
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                et al.,
                = succeed "," do
                  %em Equivariant homotopy and cohomology theory
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/alaska.pdf"} pdf
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alex+Heller"}> Alex Heller
              ,
              = succeed "," do
                %em Homotopy in functor categories
              = succeed ")" do
                %a{:href => "http://www.jstor.org/stable/1998955"} JSTOR
          %p Textbook account of the projective model structure
          %ul
            %li#Hirschhorn02
              %a.existingWikiWord{:href => "/nlab/show/Philip+Hirschhorn"}> Philip Hirschhorn
              , §6.11 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+Categories+and+Their+Localizations"} Model Categories and Their Localizations
              %strong 99
              (2002) &amp;lbrack;
              %a{:href => "https://bookstore.ams.org/surv-99-s/"}> ISBN:978-0-8218-4917-0
              ,
              = succeed "," do
                %a{:href => "http://www.gbv.de/dms/goettingen/360115845.pdf"} pdf toc
              = succeed "," do
                %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/pshmain.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/hirschhornloc.pdf"} pdf
          %p The injective model structure for unenriched diagrams of simplicial sets was first constructed by
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alex+Heller"}> Alex Heller
              ,
              %em Homotopy theories
          %p Probably the first general construction of injective model structures for enriched diagrams in combinatorial model categories was in
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , sections A.2.8 (unenriched) and section A.3.3 (enriched) of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            The projective model structure for functors to
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            on a
            %em
              %a.existingWikiWord{:href => "/nlab/show/large+category"} large
            domain is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Boris+Chorny"}> Boris Chorny
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"} William Dwyer
              = succeed "," do
                %em Homotopy theory of small diagrams over large categories
              %a{:href => "http://arxiv.org/abs/math/0607117"} arXiv:math/0607117
          %p The case of diagrams in a 2-category is a special case of
          %ul
            %li#Lack06
              %a.existingWikiWord{:href => "/nlab/show/Steve+Lack"}> Steve Lack
              ,
              = succeed "," do
                %em Homotopy-theoretic aspects of 2-monads
              %a{:href => "http://arxiv.org/abs/math.CT/0607646"} arXiv
          %p The use of accessible model structures to construct both projective and injective model structures on unenriched diagrams was introduced in
          %ul
            %li
              %p
                Marzieh Bayeh,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"} Kathryn Hess
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varvara+Karpova"} Varvara Karpova
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                %em Left-induced model structures and diagram categories
                (
                %a{:href => "http://arxiv.org/abs/1401.3651"}> arXiv:1401.3651
                )
            %li#HKRS15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"}> Kathryn Hess
                , Magdalena Kędziorek,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                %em A necessary and sufficient condition for induced model structures
                (
                %a{:href => "http://arxiv.org/abs/1509.08154"}> arXiv:1509.08154
                ). This paper contains an error, corrected by:
            %li#GKR18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                , Magdalena Kedziorek,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
                = succeed "," do
                  %em Lifting accessible model structures
                %a{:href => "https://arxiv.org/abs/1802.09889"} arXiv:1802.09889
          %p It was generalized to enriched diagrams in
          %ul
            %li#Moser
              Lyne Moser,
              = succeed "," do
                %em Injective and Projective Model Structures on Enriched Diagram Categories
              %a{:href => "https://arxiv.org/abs/1710.11388"} arXiv:1710.11388
          %p The more general result above on combinatoriality of injective model structures follows from Remark 3.8 of
          %ul
            %li{:id => "MakkaiRosický14"}
              %a.existingWikiWord{:href => "/nlab/show/M.+Makkai"}> M. Makkai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J.+Rosick%C3%BD"} J. Rosický
              = succeed "," do
                %em Cellular categories
              %strong 218
              (2014) 1652-1664 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1304.7572"}> arXiv:1304.7572
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2014.01.005"} doi:10.1016/j.jpaa.2014.01.005
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+White"}> David White
              ,
              %em Modified projective model structure
              (
              %a{:href => "http://mathoverflow.net/questions/76160/acyclic-models-via-model-categories/104423#104423"}> MO comment
              )
