          .num_cor
            %h6#corollary Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi D
