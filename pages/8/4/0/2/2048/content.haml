                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
          %ul
            %li
              %p
                %strong> finitely generated
                , or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/of+finite+type"} of finite type
                , if every point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                has an open neighbourhood such that there is a surjective morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒪
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                      %mo →
                      %mi ℰ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}^n|_U \to \mathcal{E}|_U
              %p
                from a
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℰ
