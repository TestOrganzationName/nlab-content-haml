                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mi i
                      %mo →
                      %msup
                        %mi 𝒪
                        %mrow
                          %msub
                            %mi J
                            %mi i
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mi i
