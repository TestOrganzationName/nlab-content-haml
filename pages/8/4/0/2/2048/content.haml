                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                finite.
              %p
                Every finitely presented
                = succeed "-module" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
            %li
              %p
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasi coherent
                if it is
                %em locally
                – on a cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
