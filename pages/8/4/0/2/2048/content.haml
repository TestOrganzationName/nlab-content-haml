                          %mo{:stretchy => "false"} |
                          %mi U
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}|_{U}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is finite.
            %li
              %p
                %strong coherent
                if it is
              %ol
                %li
                  %p finitely generated
                %li
                  %p
                    for every open
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                        %annotation{:encoding => "application/x-tex"} U
                    in the base space (resp. every object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                        %annotation{:encoding => "application/x-tex"} U
                    in the base site), every finite
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
