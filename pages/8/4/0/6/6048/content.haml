            %p
              Hence, by extension, any other sequence of finite-dimensional
              = succeed "-representations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              %a.existingWikiWord{:href => "/nlab/show/M2-M5+brane+bound+state"} M2-M5 brane bound state
              of sorts.
            %h4#FormalizationViaWeightSystems Formalization via weight systems on chord diagrams
            %p To make this precise, let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℂ
                    %msub
                      %mi MetMod
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{su}(2)_{\mathbb{C}} MetMod_{/\sim}
                    \\;\in\;
                    Set
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
              %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
              (hence
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional representations
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
              (
              %a{:href => "su2#Complexification"} hence
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+linear+Lie+algebra"} special linear Lie algebra
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔩
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi ℂ
                    %msub
                      %mi MetMod
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    Span
                    \\big(
                    \\mathfrak{su}(2)_{\mathbb{C}} MetMod_{/\sim}
                    \\big)
                    \\;\in\;
                    Vect_{\mathbb{C}}
            %p
              for its
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              (the
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              of
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combinations"} formal linear combinations
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
            %p Finally, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Span
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi 𝔰𝔲
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi ℂ
                            %msub
                              %mi MetMod
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mo ∼
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi 𝒲
