                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi N
                          %annotation{:encoding => "application/x-tex"} N^{(M2)}_i/N
                      (being the
                      = succeed "/" do
                        %a.existingWikiWord{:href => "/nlab/show/charge"} charge
                      %a.existingWikiWord{:href => "/nlab/show/light-cone+momentum"} light-cone momentum
                      carried by the
                      = succeed "th" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                            %annotation{:encoding => "application/x-tex"} i
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/M2-brane"} M2-brane
                  configuration corresponds to a
                  %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                  of such representations for which
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo →
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} N^{(M5)}_i \to \infty
                      (this being the relevant
                      = succeed ")" do
                        %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
                  %li
                    %p
                      for fixed
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 2
                                %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} N^{(M2)}_i
                      (being the number of M2-brane in the
                      = succeed "th" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
