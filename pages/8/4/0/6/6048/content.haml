                              %mi c
                              %mn 1
                            %mo ⋅
                            %msub
                              %mi V
                              %mn 1
                            %mo +
                            %msub
                              %mi c
                              %mn 2
                            %mo ⋅
                            %msub
                              %mi V
                              %mn 2
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi c
                              %mn 1
                            %mo ⋅
                            %msub
                              %mi w
                              %mrow
                                %msub
                                  %mi V
                                  %mn 1
                            %mo +
                            %msub
                              %mi c
                              %mn 2
                            %mo ⋅
                            %msub
                              %mi w
                              %mrow
                                %msub
                                  %mi V
                                  %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Span
                    \\big(
                    \\mathfrak{su}(2)_{\mathbb{C}}MetMod_{/\sim}
                    \\big)
                    \&amp;
                    \\longrightarrow
                    \&amp;
                    \\big(
                    \\mathcal{W}^{{}^{s}}
                    \\big)^{deg}
                    \\\
                    c_1 \cdot V_1
                    +
                    c_2 \cdot V_2
                    \&amp;\mapsto&amp;
                    c_1 \cdot w_{V_1}
                    +
                    c_2 \cdot w_{V_2}
                    }
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              which sends a
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
              of representations to the
              %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
              on
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+chord+diagrams"} Sullivan chord diagrams
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} deg \in \mathbb{N}
              chords which is given by
              %a.existingWikiWord{:href => "/nlab/show/trace"} tracing
              in the given representation.
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/M2-M5-brane+bound+state"} M2-M5-brane bound state
              as in the traditional discussion
              = succeed "," do
                %a{:href => "#TraditionalDiscussion"} above
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+system"} su(2)-weight system
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 2
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo }
                          %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi deg
                        %mo ∈
                        %mi ℕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi 𝒲
                      %mrow
                        %msup
                          %mrow
                          %mi{:mathvariant => "normal"} s
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi deg
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_{
                    \\left\{
                    N^{(M2)}_i, N^{(M5)}_i
                    \\right\}_{i}
                    }
                    \\;\in\;
                    \\underset{
                    deg \in \mathbb{N}
                    }{\prod}
                    \\big(
                    \\mathcal{W}^{{}^{\mathrm{s}}}
                    \\big)^{deg}
            %p
              hence a
              %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              closed to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+chord+diagrams"} Sullivan chord diagrams
              %a.existingWikiWord{:href => "/nlab/show/multi-trace+observables"} multi-trace observables
              on these) is
            #eq:M2M5BraneBoundStateInWeightSystems.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 2
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo }
                          %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mn 4
                          %mi π
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mn 2
                            %mrow
                              %mn 2
                              %mspace{:width => "thinmathspace"}
                              %mi deg
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi i
                          %msubsup
                            %mi N
                            %mi i
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi M
                              %mn 2
                              %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mrow
                      %mo (
                      %msubsup
                        %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %msup
                              %mrow
                                %mo (
                                %msqrt
                                  %mrow
                                    %msup
                                      %mrow
                                        %mo (
                                        %msubsup
                                          %mi N
                                          %mi i
                                          %mrow
                                            %mo{:stretchy => "false"} (
                                            %mi M
                                            %mn 5
                                            %mo{:stretchy => "false"} )
                                        %mo )
                                      %mn 2
                                    %mo −
                                    %mn 1
                                %mo )
                              %mrow
                                %mn 1
                                %mo +
                                %mn 2
                                %mi deg
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 5
                          %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_{
                    \\left\{
                    N^{(M2)}_i, N^{(M5)}_i
                    \\right\}_{i}
                    }
                    \\;\coloneqq\;
                    \\tfrac{
                    4 \pi \, 2^{2\,deg}
                    }{
                    \\sum_i N^{(M2)}_i
                    }
                    \\underset{i}{\sum}
                    \\left(
                    N^{(M2)}_i
                    \\cdot
                    \\tfrac{1}{
                    \\left(
                    \\sqrt{
                    \\left(
                    N^{(M5)}_i
                    \\right)^2 - 1
                    }
                    \\right)^{1 + 2 deg}
                    }
                    \\mathbf{N}^{(M5)}_i
                    \\right)
            %center
              %img{:src => "https://ncatlab.org/nlab/files/M2M5BraneBoundStatesAsWeightSystemsII.jpg", :width => "800"}/
            %blockquote
              %p
                (from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
            %p#M2M5BraneBoundStatesAsWeightSystemsGraphics
              %strong
                Normalization and large
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                limit.
              The first power of the square root in
              %a.maruku-eqref{:href => "#eq:M2M5BraneBoundStateInWeightSystems"} (3)
              reflects the
              %a.existingWikiWord{:href => "/nlab/show/volume"} volume
              measure on the
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              (by the formula
              = succeed ")," do
                %a{:href => "fuzzy+sphere#eq:FuzzyS2Integration"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mi deg
                  %annotation{:encoding => "application/x-tex"} 2\,deg
              (which is the number of operators in the
              %a.existingWikiWord{:href => "/nlab/show/multi-trace+observable"} multi-trace observable
              evaluating the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
              = succeed ")" do
                %a{:href => "fuzzy+sphere#eq:BasisFunctionsOnFuzzy2Sphere"} here
            %p
              Hence this normalization is such that the
              %a.existingWikiWord{:href => "/nlab/show/single-trace+observables"} single-trace observables
              among the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/multi-trace+observables"} multi-trace observables
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/round+chord+diagrams"} round chord diagrams
              %a.existingWikiWord{:href => "/nlab/show/M2-M5+brane+bound+states"} M2-M5 brane bound states
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 2
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo }
                          %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_{
                    \\left\{
                    N^{(M2)}_i, N^{(M5)}_i
                    \\right\}_{i}
                    }
              for which
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi N
                        %mi i
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi δ
                        %mi i
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %msup
                        %mi N
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N^{(M2)}_i = \delta_i^{i_0} N^{(M2)}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              = succeed ":" do
                %a{:href => "fuzzy+sphere#ShapeObservablesAsVassilievInvariants"} here
            %center
              %img{:src => "https://ncatlab.org/nlab/files/SingleTraceObservableOnBMNModel.jpg", :width => "740"}/
            %blockquote
              %p
                (from
                = succeed ")" do
                  %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
            %p
              Therefore, with this normalization, the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} N^{(M2)} \to \infty
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} N^{(M5)} \to \infty
              of
              %a.maruku-eqref{:href => "#eq:M2M5BraneBoundStateInWeightSystems"} (3)
              should exist in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
              to the
              %a.existingWikiWord{:href => "/nlab/show/round+sphere"} round
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            %p
              Notice that the
              %a.existingWikiWord{:href => "/nlab/show/multi+trace+observables"} multi trace observables
              on these states only see the relative
              %a.existingWikiWord{:href => "/nlab/show/radii"} radii
              of the constitutent
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-spheres"} fuzzy 2-spheres
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi N
                      %mi i
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi δ
                      %mi i
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                    %msup
                      %mi N
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 2
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N^{(M2)}_i = \delta_i^{i_0} N^{(M2)}
              then the
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi N
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N^{(M2)}
              %a.maruku-eqref{:href => "#eq:M2M5BraneBoundStateInWeightSystems"} (3)
              cancels out, reflecting the fact that then there is only a single constituent 2-sphere of which the observable sees only the radius fluctuations, not the absolute radius (proportional to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi N
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N^{(M2)}
