                        %mi ℕ
                        %mrow
                          %mo ≤
                          %mi cofinite
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mo •
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} cart
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℕ
                        %mrow
                          %mo ≤
                          %mi cofinite
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mo •
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} cart
                      %msup
                        %mo{:stretchy => "false"} )
