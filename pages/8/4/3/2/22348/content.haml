                  %annotation{:encoding => "application/x-tex"} \exists x \wedge_{i\leq n} \phi(x,y_i)
          %p
          .num_theorem
            %h6 Theorem
            %p
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
