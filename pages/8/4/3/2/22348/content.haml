          %h4#speculations_limits_and_contractible_models_ Speculations: limits and contractible models ?
          %p
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} sPhi
                %annotation{:encoding => "application/x-tex"} \sPhi
            the notions of homotopy and limit are closely related: the same construction in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} sPhi
                %annotation{:encoding => "application/x-tex"} \sPhi
            describes both picking a homotopy contracting a topological space (via singular complexes) and taking a limit of a filter on a topological space, and applies to an arbitrary morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} sPhi
                  %annotation{:encoding => "application/x-tex"} \sPhi
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mo •
                  %annotation{:encoding => "application/x-tex"} M_\bullet
          %p Below we sketch this construction; see [6,\S3] for more details. We warn the reader that our considerations here are unusually preliminary, and apologise for including them; our excuse is that we are likely unable to pursue them.
          %p
          #def:limit.num_defn
            %h6 Definition
            %p
              [(Limit in a generalised space)] Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔉
                      %mo •
                    %mo :
                    %msub
                      %mi F
                      %mo •
                    %mo ⟶
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathfrak{F}_\bullet : F_\bullet\longrightarrow X_\bullet
              be a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} sPhi
                    %annotation{:encoding => "application/x-tex"} \sPhi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mo •
                  %annotation{:encoding => "application/x-tex"} x_\bullet
              is said to be a {\em limit morphism} (or simply {\em a limit})
              %br>/
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔉
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathfrak{F}_\bullet
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mo ⟶
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet\longrightarrow X_\bullet
              factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mo ⟶
                    %msub
                      %mi X
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi x
                          %mo •
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet\longrightarrow X_\bullet\circ[+1] \xrightarrow{x_\bullet} X_\bullet
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Δ
                    %mo ⟶
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} [+1]:\Delta\longrightarrow\Delta
              is the shift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ↦
                    %mi n
                    %mo +
                    %mn 1
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                    %mspace{:width => "negativethinmathspace"}
                    %mi n
                    %mo →
                    %mi m
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} longmapsto
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mo ′
                    %mspace{:width => "negativethinmathspace"}
                    %mo :
                    %mspace{:width => "negativethinmathspace"}
                    %mi n
                    %mo +
                    %mn 1
                    %mo →
                    %mi m
                    %mo +
                    %mn 1
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mn 0
                    %mo ;
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mtext for
                    %mi i
                    %mo ≥
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} n\mapsto n+1, \ \ f\!:\!n\to m \,\longmapsto\, f'\!:\!n+1\to m+1, f'(0):=0; f'(i+1):=f(i) \text{ for }i\ge 0,
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet\circ[+1]\longrightarrow X_\bullet
              is the expected map “rgetting the first coordinate’’.
          %p
            To recover the Bourbaki definition of a limit of a filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔉
                %annotation{:encoding => "application/x-tex"} \mathfrak{F}
            on a topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔉
                  %mo ∈
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Ob
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} PPhi
                %annotation{:encoding => "application/x-tex"} \mathfrak{F}\in \Ob \PPhi
            the simplical set represented by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {F}_\bullet(n^\leqslant):=\Hom(n^\leqslant,X)
          %p
            equip
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mn 1
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_\bullet(1^\leqslant)=X
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔉
                  %annotation{:encoding => "application/x-tex"} \mathfrak{F}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {F}_\bullet(n^\leqslant):=\Hom(n^\leqslant,X)
            \%is equipped with the finest filter such that the diagonal map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mn 1
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {F}_\bullet(1^\leqslant)\longrightarrow  {F}_\bullet(n^\leqslant)
            is continuous. A verification shows that (possibly discontinuous) liftings correspond to points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (indeed, as simplicial sets,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F_\bullet
            is connected, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X_\bullet[+1]
            is the disjoint union of connected component which are copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            parametrised by
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
          .num_remark
            %h6 Example
            %p
              [Limit of the tree in NTP] Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi T
                        %mo •
                        %mo ⩽
                    %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi T
                      %msubsup
                        %mo{:stretchy => "false"} |
                        %mo •
                        %mtext NTP
                    %annotation{:encoding => "application/x-tex"} |T|^\text{NTP}_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi M
                      %mo •
                      %mrow
                        %mi ϕ
                        %mtext -NTP
                  %annotation{:encoding => "application/x-tex"} M_\bullet^{\phi\text{-NTP}}
              denote the objects corresponding to a tree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and a model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              appearing in the lifting property for NTP of formula
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            %p
              A limit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ⩽
                    %mo ⟶
                    %msubsup
                      %mi M
                      %mo •
                      %mrow
                        %mi ϕ
                        %mtext -NTP
                  %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet \longrightarrow M_\bullet^{\phi\text{-NTP}}
              is a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} a\in M
              such that the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ⩽
                    %mo ⟶
                    %msubsup
                      %mi M
                      %mo •
                      %mrow
                        %mi ϕ
                        %mo ′
                        %mtext -NTP
                  %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet \longrightarrow M_\bullet^{\phi'\text{-NTP}}
              is continuous where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi &amp;
                      %mspace{:width => "thinmathspace"}
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi'(x,y):=\phi(x,a) \,\&amp;\, \phi(x,y)
          %p
            To see this, first note that, as simplicial sets (i.e.~if we ignore the filters),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} M_\bullet^{\phi\text{-NTP}}[+1]
            is the disjoint union of connected component which are copies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                %annotation{:encoding => "application/x-tex"} M^{\phi\text{-NTP}}_\bullet
            parametrised by elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ⩽
                  %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msub
                    %mo{:stretchy => "false"} |
                    %mo •
                %annotation{:encoding => "application/x-tex"} |T|_\bullet
            are connected. Thus to give a map of simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ⩽
                  %mo ⟶
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet \longrightarrow M_\bullet^{\phi\text{-NTP}}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msub
                    %mo{:stretchy => "false"} |
                    %mo •
                  %mo ⟶
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                %annotation{:encoding => "application/x-tex"} |T|_\bullet \longrightarrow M_\bullet^{\phi\text{-NTP}}
            is the same as to pick a point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} a\in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ⩽
                  %mo ⟶
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet \longrightarrow M_\bullet^{\phi\text{-NTP}}
            means precisely that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi a
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(x,a_1),...,\phi(x,a_n)
            is consistent whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_1,...,a_n
            lie on the same branch of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ⩽
                  %mo ⟶
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} T^\leqslant_\bullet \longrightarrow M_\bullet^{\phi\text{-NTP}}[+1]
            means precisely that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ϕ
