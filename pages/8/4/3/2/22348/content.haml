                    %mrow
                      %mo ⋌
                      %mi lr
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  K_\bullet \circ [+1]\to K_\bullet \in
                  (\{\{o\},\{o,1\}\}^{\operatorname{cart}}_\bullet \cup  \{\{1\},\{o,1\}\}^{\operatorname{cart}}_\bullet\to  \{\{o,1\}\}^{\operatorname{cart}}_\bullet)^{\rightthreetimes lr}.
          %p
            Here
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %mi o
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi o
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
