                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mo •
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} diag
                    %mo ⋌
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{U}^{\operatorname{diag}}_\bullet
                    \\to (\mathfrak{U}\cup\{\infty\})^{\operatorname{diag}}_\bullet \rightthreetimes X_\bullet\to \top
          %p
            A topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
