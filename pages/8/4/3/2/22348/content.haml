                  %mi x
                  %mo ;
                  %msub
                    %mi a
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ;
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\phi(x;a_0),...\phi(x;a_n)\}
            is n-consistent but (n+1)-inconsistent.
          %p
            Recall that a simplicial object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mo •
                  %annotation{:encoding => "application/x-tex"} M_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
