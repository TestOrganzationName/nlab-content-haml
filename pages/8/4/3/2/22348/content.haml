                  %msubsup
                    %mo{:stretchy => "false"} }
                    %mo •
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} cart
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi o
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
