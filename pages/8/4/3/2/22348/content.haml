                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
                  has no finite cover property
              %li
                %p
                  the characteristic sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo &lt;
                        %msub
                          %mi P
                          %mi n
                        %mo &gt;
                      %annotation{:encoding => "application/x-tex"} \lt P_n\gt
                  has finite support (in terminology of
                  = succeed ")" do
                    %a{:href => "#Mallaris2010jsl"} Malliaris, Def.2.6
              %li
                %p
                  the situs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi M
                          %mo •
                          %mrow
                            %mo ∃
                            %mi ϕ
                      %annotation{:encoding => "application/x-tex"} M^{\exists\phi}_\bullet
                  has finite dimension, i.e. explicitly, for some
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  the filter on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi M
                          %mo •
                          %mrow
                            %mo ∃
                            %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi M
                          %mi n
                      %annotation{:encoding => "application/x-tex"} M^{\exists\phi}_\bullet(n)=M^n
                  is the coarsest filter such that all the simplicial maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi M
                          %mo •
                          %mrow
                            %mo ∃
                            %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi M
                          %mi n
                        %mo →
                        %msubsup
                          %mi M
                          %mo •
                          %mrow
                            %mo ∃
                            %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi M
                          %mi k
                      %annotation{:encoding => "application/x-tex"} M^{\exists\phi}_\bullet(n)=M^n\to M^{\exists\phi}_\bullet(k)=M^k
                  are continuous
              %li
                %p
                  there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  such that for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∃
                        %mi x
                        %msub
                          %mo ∧
                          %mrow
                            %mi i
                            %mo ≤
                            %mi n
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exists x \wedge_{i\leq n} \phi(x,y_i)
                  holds iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∃
                        %mi x
                        %msub
                          %mo ∧
                          %mrow
                            %mi i
                            %mo ≤
                            %mi n
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exists x \wedge_{i\leq n} \phi(x,y_i)
                  for any
                  = succeed "-element" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi y
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                        %mo ,
                        %mo .
                        %mo .
                        %mo .
                        %mo ,
                        %msub
                          %mi y
                          %mrow
                            %msub
                              %mi i
                              %mi k
                      %annotation{:encoding => "application/x-tex"} y_{i_1},...,y_{i_k}
              %li
                %p
                  there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  such that for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∃
                        %mi x
                        %msub
                          %mo ∧
                          %mrow
                            %mi i
                            %mo ≤
                            %mi n
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %msub
                          %mi y
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ↔
                        %msub
                          %mo ∧
                          %mrow
                            %mn 1
                            %mo ≤
                            %msub
                              %mi i
                              %mn 1
                            %mo ≤
                            %mo .
                            %mo .
                            %mo .
                            %mo ≤
                            %msub
                              %mi i
                              %mi k
                            %mo ≤
                            %mi n
                        %mo ∃
                        %mi x
                        %msub
                          %mo ∧
                          %mrow
                            %mn 1
                            %mo ≤
                            %mi l
                            %mo ≤
                            %mi k
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %msub
                          %mi y
                          %mrow
                            %msub
                              %mi i
                              %mi l
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exists x \wedge_{i\leq n} \phi(x,y_i)\leftrightarrow \wedge_{1\leq i_1\le ...\le i_k\le n}\exists x \wedge_{1\leq l\leq k} \phi(x,y_{i_l})
            %p
          .proof
            %h6 Proof
            %p
              Items 1 and 2 are Remark 2.7 of
              = succeed "," do
                %a{:href => "#Mallaris2010jsl"} Malliaris
          %h5#no_tree_property_ntp No tree property NTP
          %p
            The reformulation in terms of situses uses the definition of a simple first-order theory which says that each formula of the theory has NTP (“not the tree property”) see
            = succeed "," do
              %a{:href => "#TentZiegler"} Tent-Ziegler, Def.7.2.1
            %a{:href => "#3"} 3,\S9
            NTP is defined as a lifting property with respect to a morphism involving the following combinatorial structures.
          %p We recall the definition of NTP and a simple theory.
          %p
          .num_defn
            %h6 Definition
            %p
              [Tent-Ziegler,7.2.1] 1. A formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(x, y)
              has the tree property (with respect to k) if there is a tree of parameters
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ∅
                    %mo ≠
                    %mi s
                    %mo ∈
                    %msup
                      %mrow
                      %mrow
                        %mo &lt;
                        %mi ω
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_s\,\,|\,\,\emptyset \neq s \in {}^{\lt\omega}\omega )
              such that:
            %p
              a) For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %msup
                        %mrow
                        %mrow
                          %mo &lt;
                          %mi ω
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} s\in {}^{\lt\omega}\omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi a
                      %mi si
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi i
                    %mo &lt;
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\varphi(x, a_{si} )\,\,|\,\,i \lt\omega )
              is
              = succeed "-inconsistent." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              b) For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msup
                      %mrow
                      %mi ω
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \sigma\in {}^{\omega}\omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi a
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ∅
                    %mo ≠
                    %mi s
                    %mo ⊆
                    %mi σ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\varphi(x, a_s )\,\,|\,\,\emptyset \neq s\subseteq \sigma  \}
              is consistent.
            %ol
              %li
                A theory T is simple if there is no formula
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \varphi(x, y)
                with the tree property.
            %p
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo ≤
                %annotation{:encoding => "application/x-tex"} T^\leq
            be an infinitely branching tree of infinite depth, viewed as preorder, and equipped with the indiscrete filter.
            %br>/
            We may take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mo ≤
                %annotation{:encoding => "application/x-tex"} T^\leq
            to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mrow
                        %mo &lt;
                        %mi ω
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} {}^{\lt\omega}\omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ≤
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo ≤
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mo •
                    %mi cart
                %annotation{:encoding => "application/x-tex"} T^\leq_\bullet:=(T^\leq)^{cart}_\bullet
            denote the corresponding situs.
            %a{:href => "#PreordersAsSituses"} Recall
            that by definition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ≤
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^\leq_\bullet(n)
            is the set of ordered (weakly increasing)
            = succeed "-tuples" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            Note that to give a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ≤
                  %mo →
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mo ∃
                      %mi ϕ
                %annotation{:encoding => "application/x-tex"} T^\leq_\bullet \to M_\bullet^{\exists\phi}
            of the underlying simplicial sets is the same as to give a a tree of parameters
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ∅
                    %mo ≠
                    %mi s
                    %mo ∈
                    %msup
                      %mrow
                      %mrow
                        %mo &lt;
                        %mi ω
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_s\,\,|\,\,\emptyset \neq s \in {}^{\lt\omega}\omega )
            = succeed "-consistent" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ≤
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T^\leq_\bullet(n)
            of ordered tuples, for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msub
                    %mo{:stretchy => "false"} |
                    %mo •
                %annotation{:encoding => "application/x-tex"} |T|_\bullet
            be the simplicial set represented by the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi T
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |T|
            of vertices of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msub
                      %mo{:stretchy => "false"} |
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi n
                      %mo ≤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msup
                      %mo{:stretchy => "false"} |
                      %mi n
                  %annotation{:encoding => "application/x-tex"} |T|_\bullet(n^\leq)=|T|^n
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mo •
                      %mi TP
                  %annotation{:encoding => "application/x-tex"} |T|^{TP}_\bullet
              denote the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msub
                      %mo{:stretchy => "false"} |
                      %mo •
                  %annotation{:encoding => "application/x-tex"} |T|_\bullet
              equipped with the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi TP
                    %annotation{:encoding => "application/x-tex"} TP
                \-tautological
              filter on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msub
                      %mo{:stretchy => "false"} |
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi n
                      %mo ≤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} |T|_\bullet(n^\leq)
              defined as follows: a subset is not small iff it either contains
            %p 1) some tuple in weakly increasing order, or
            %p 2) all the lexicographically ordered tuples required to be inconsistent by the tree property with respect to a subtree-counterexample to the tree property.
            %p
              In more detail, a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              is large iff
            %p 1’) it contains the subset of tuples in weakly increasing order
            %p
              2’) for each isomorphic copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                    %mo =
                    %msup
                      %mrow
                      %mrow
                        %mo &lt;
                        %mi ω
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} T'={}^{\lt\omega}\omega
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo ≤
                  %annotation{:encoding => "application/x-tex"} T^\leq
              there is a vertex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi T
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v\in T'
              and its immediate (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} T'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %msub
                      %mo ≤
                      %mi lex
                    %mo .
                    %mo .
                    %mo .
                    %msub
                      %mo ≤
                      %mi lex
                    %msub
                      %mi v
                      %mi k
                  %annotation{:encoding => "application/x-tex"} v_1\leq_{lex}...\leq_{lex} v_k
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi v
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ϵ
                      %mo ∩
                      %mi T
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} (v_1,..,v_k) \in \epsilon \cap T'
          %p
            Note that by item (i) the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mo •
                    %mo ≤
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msubsup
                    %mo{:stretchy => "false"} |
                    %mo •
                    %mi TP
                %annotation{:encoding => "application/x-tex"} T^\leq_\bullet \to |T|_\bullet^{TP}
            is continuous. Also note that no tuple of increasing elements is required to be
            = succeed "-inconsistent" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
          %p
          .num_prop
            %h6 Proposition
            %p The following are equivalent:
            %p
              i. the formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              has NTP with respect
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in the model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %p
              ii. in sዋ there is no morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo :
                    %msubsup
                      %mi T
                      %mo •
                      %mo ≤
                    %mo →
                    %msubsup
                      %mi M
                      %mo •
                      %mrow
                        %mo ∃
                        %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \tau:T^\leq_\bullet\to M_\bullet^{\exists\phi}
              such that for each tuple
              = succeed "-tuple" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi v
                        %mi k
                    %annotation{:encoding => "application/x-tex"} v_1,..,v_k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊧
                    %mo ¬
                    %mo ∃
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo .
                    %mo .
                    %mo .
                    %mo ∧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \models\neg \exists x (\phi(x,\tau(v_1))\wedge ... \wedge \phi(x,\tau(v_n))
            %p
              iii. In sዋ the following lifting property holds:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ≤
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mo •
                      %mi TP
                    %mo ⋌
                    %msubsup
                      %mi M
                      %mo •
                      %mrow
                        %mo ∃
                        %mi ϕ
                    %mo →
                    %mo ⊤
                  %annotation{:encoding => "application/x-tex"}
                    T^\leq_\bullet \to |T|^{TP}_\bullet
                    \\rightthreetimes M_\bullet^{\exists\phi}\to \top
          .proof
            %h6 Proof
            %p
              ii. is exactly the definition of NTP for formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              as stated in (
              %a{:href => "#TentZiegler"}> Tent-Ziegler, Def.7.2.1
              ), cf.
              = succeed "." do
                %a{:href => "#3"} 3,\S9
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_1,...,v_k)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⊧
                    %mo ∃
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo .
                    %mo .
                    %mo .
                    %mo ∧
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \models \exists x (\phi(x,\tau(v_1))\wedge ... \wedge \phi(x,\tau(v_k))
              is large. By the definition of the filter, this set is large iff there is an infinitely branching subtree of infinite depth satisfying ii. This implies that ii. and iii. are equivalent.
            %p
              Finally, let us prove our
              = succeed "-tautological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TP
                    %annotation{:encoding => "application/x-tex"} TP
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∪
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\cup Y
              is small. Assume it is not small. Label each vertex of the tree with the largest
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &lt;
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} n\lt\omega
              such that the first small subset contains above the vertex all tuples required to be inconsisent in some copy of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                        %mrow
                          %mo &lt;
                          %mi n
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} {}^{\lt n}\omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there are at most finitely many vertices in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              labelled by the same or greater number. Removing them leaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∪
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\cup Y
              not small. But then we get that vertices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are labelled by numbers strictly decreasing along any branch, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is of finite depth. Now pick a vertex labelled
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is not small.
          %p
          .num_remark
            %h6 Remark
            %p
              One can similarly define
              = succeed "-tautological" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi TP
                        %mi i
                    %annotation{:encoding => "application/x-tex"} TP_i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i=1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi TP
                      %mi i
                  %annotation{:encoding => "application/x-tex"} TP_i
              is defined by a lifting property. The same argument gives lifting properties related to cdt,
              = succeed "," do
                %a{:href => "modeltheory.fandom.com/wiki/INP_pattern"} inp
          %p
          .num_remark
            %h6 Remark
            %p
              This raises the question whether
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NTP
                    %mo =
                    %msub
                      %mi NTP
                      %mn 1
                    %mi &amp;
                    %msub
                      %mi NTP
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} NTP=NTP_1\&amp;NTP_2
              holds in the category of situses. It seems the standard proof would go through if one defines the corresponding lifting properties carefully enough. In particular, to reflect the use of Ramsey theorem, it may be necessary to replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi M
                    %msub
                      %mo{:stretchy => "false"} |
                      %mo •
                  %annotation{:encoding => "application/x-tex"} |M|_\bullet
              by the simplicial set of types
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mo •
                      %mi M
                  %annotation{:encoding => "application/x-tex"} S^M_\bullet
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi M
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^M(n)
              is the set of
              = succeed "-types," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ≤
                  %annotation{:encoding => "application/x-tex"} T^\leq_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mo •
                      %mi TP
                  %annotation{:encoding => "application/x-tex"} |T|^{TP}_\bullet
              for quantifier-free types in an appropriate language.
            %p
              In fact, it would seem that the standard proof of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NTP
                    %mo =
                    %msub
                      %mi NTP
                      %mn 1
                    %mi &amp;
                    %msub
                      %mi NTP
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} NTP=NTP_1\&amp;NTP_2
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ≤
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mo •
                      %mi TP
                  %annotation{:encoding => "application/x-tex"} T^\leq_\bullet\to |T|_\bullet^{TP}
              is the pushout of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mo •
                      %mo ≤
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi T
                    %msubsup
                      %mo{:stretchy => "false"} |
                      %mo •
                      %mrow
                        %msub
                          %mi TP
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} T^\leq_\bullet\to |T|_\bullet^{TP_1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi T
                        %mo •
                        %mo ≤
                      %mo →
                      %mo{:stretchy => "false"} |
                      %mi T
                      %msubsup
                        %mo{:stretchy => "false"} |
                        %mo •
                        %mrow
                          %msub
                            %mi TP
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} T^\leq_\bullet\to |T|_\bullet^{TP_2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi &amp;
                      %mi i
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi y
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \&amp;_i\phi(x,y_i)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(x,y)
              at the same time.
          %p
          .num_remark
            %h6 Remark
            %p
              The notion of a
              = succeed "-characteristic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed ")," do
                %a{:href => "#Mallaris2010jsl"} M.Malliaris. The characteristic sequence of a first-order formula. 2010
              = succeed ")." do
                %a{:href => "#Mallaris2010apal"} M.Malliaris. “Edge distribution and density in the characteristic sequence
          %p
          %h3{:id => "section_Shelah’s_dividing_lines_NOP,_NSOP,_NSOPi,_NTP,_NTPi,_NATP,_and_tautological_filters"} Shelah’s dividing lines NOP, NSOP, NSOPi, NTP, NTPi, NATP, and tautological filters
          %p
            We show that in the category of situses a number of the Shelah’s divining lines, namely
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NOP
                    %mo ,
                    %mi NSOP
                    %mo ,
                    %msub
                      %mi NSOP
                      %mi i
                    %mo ,
                    %mi NTP
                    %mo ,
                    %msub
                      %mi NTP
                      %mi i
                  %annotation{:encoding => "application/x-tex"} NOP, NSOP, NSOP_i, NTP, NTP_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi NATP
                %annotation{:encoding => "application/x-tex"} NATP
            are expressed as Quillen lifting properties of form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi B
                    %mo •
                  %mo ⋌
                  %msub
                    %mi M
                    %mo •
                  %mo →
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} A_\bullet \to B_\bullet \rightthreetimes M_\bullet\to\top
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            is the terminal object, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a situs associated with a model and a formula, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are objects of combinatorial nature.
          %p
          %h3#section_Informal_explanation Informal explanation
          %p
            Recall the common pattern of definitions of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NOP
                    %mo ,
                    %mi NSOP
                    %mo ,
                    %msub
                      %mi NSOP
                      %mi i
                    %mo ,
                    %mi NTP
                    %mo ,
                    %msub
                      %mi NTP
                      %mi i
                    %mo ,
                    %mi NATP
                  %annotation{:encoding => "application/x-tex"} NOP, NSOP, NSOP_i, NTP, NTP_i, NATP
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            and a model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            require that there is no combinatorial structure (“counterexample” or “witness”) formed by elements of the model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            satisfying certain “positive” requirement that certain collections of formulas are consistent, and “negative” requirement that certain collections of formulas are inconsistent. The combinatorics is coded by the maps of underlying simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi A
                    %mo •
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi M
                    %mo •
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |A_\bullet|\to |M_\bullet|
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi B
                      %mo •
                    %mo{:stretchy => "false"} |
                    %mo →
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi M
                      %mo •
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |B_\bullet|\to |M_\bullet|
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo →
                    %msub
                      %mi M
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet\to M_\bullet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo •
                    %mo →
                    %msub
                      %mi M
                      %mo •
                  %annotation{:encoding => "application/x-tex"} B_\bullet \to M_\bullet
          %p
            The underlying simplicial sets of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo ,
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet, B_\bullet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} M_\bullet
            are representable, and are so chosen that both morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet\to M_\bullet
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo •
                  %mo →
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} B_\bullet \to M_\bullet
            both correspond to maps of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mo •
                  %mo :
                  %mo{:stretchy => "false"} |
                  %mi I
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi M
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} a_\bullet :|I|\to |M|
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mo ′
                      %mo •
                    %mo :
                    %mo{:stretchy => "false"} |
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi M
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} a'_\bullet:|I'|\to |M|
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
            = succeed "\u2019s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi n
                %annotation{:encoding => "application/x-tex"} A_n
            are taken indiscrete; thus continuity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} f:A_\bullet\to M_\bullet
            means that for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n\in \mathbb {N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                  %mo ∈
                  %mi a
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mo{:stretchy => "false"} |
                  %mi M
                  %msup
                    %mo{:stretchy => "false"} |
                    %mi n
                %annotation{:encoding => "application/x-tex"} (a_i)_{0\leq i\le n} \in a(A_n)\subset |M|^n
            satisfies a certain formula. Namely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} M_\bullet
            is the situs of
            = succeed "-indiscernible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            = succeed "-indiscernile;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the situs of consisent finite
            = succeed "-types," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(x,a_i)
            is consistent.
          %p
            To code by continuity the failure of negative requirements, we need to define non-trivial filters on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n
            is large (a neighbourhood) iff it contains a tuple representing one of the negative requirements; unfortunately, this is not a filter. But if it were, then continuity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                  %mo →
                  %msub
                    %mi M
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B_n\to M_\bullet(n)
            would mean exactly that one of negative requirements fails, and hence the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo →
                  %msub
                    %mi M
                    %mo •
                %annotation{:encoding => "application/x-tex"} A_\bullet\to M_\bullet
            does not represent a counterexample/witness. To fix this definition, define a subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi n
                %annotation{:encoding => "application/x-tex"} B_n
            to be large (a neighbourhood) iff it contains a tuple representing a negative requirement with respect to each
            %em substructure
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of the same shape as required by the property.
            %br>/
            We call the filters on
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
            %em tautological
            because of the tautological argument showing equivalence of the continuity and the failure of the negative requirements.
          %p
            Below we do the reformulations for non-order properties
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NOP
                  %annotation{:encoding => "application/x-tex"} NOP
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NSOP
                  %annotation{:encoding => "application/x-tex"} NSOP
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi NSOP
                      %mi i
                  %annotation{:encoding => "application/x-tex"} NSOP_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} i\geq 3
            which involve the situs of
            = succeed "-indiscernible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            = succeed "-indiscernible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
          %p
            The no-tree-properties were formulated above and they involve the situs of consistent
            = succeed "-types." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
          %p
          .num_remark
            %h6 Remark
            %p
              Note our considerations allow to formulate a precise conjecture corresponding to the equality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NATP
                    %mo =
                    %msub
                      %mi NSOP
                      %mn 1
                    %mo +
                    %msub
                      %mi NTP
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} NATP = NSOP_1+ NTP_2
              of
              = succeed "." do
                %a{:href => "https://arxiv.org/pdf/2106.03779.pdf"} On the Antichain Tree Property
          %h4#rewriting_nop_no_order_property Rewriting NOP (no order property)
          %p
            Recall a formula
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(-,-)
            has NOP (no order property) iff there no sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ω
                %annotation{:encoding => "application/x-tex"} (a_i)_{i\in\omega}
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi i
                    %mo ≤
                    %mi j
                  %annotation{:encoding => "application/x-tex"} \phi(a_i,a_j) \Leftrightarrow i\leq j
          %p
            Because NOP cares about {\em consistency of instances of a formula on tuples of ordered variables}, equip
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi n
                    %mo ⩽
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi M
                    %mi n
                %annotation{:encoding => "application/x-tex"} M_\bullet(n^\leqslant):=M^n
            with the filter of subsets containing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi M
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo :
                    %mspace{:width => "thinmathspace"}
                    %mi i
                    %mo ≤
                    %mi j
                    %mspace{:width => "thinmathspace"}
                    %mi &amp;
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi a
                      %mi i
                    %mo ≠
                    %msub
                      %mi a
                      %mi j
                    %mo ⇒
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  (a_1,..,a_n)\in M^n\,:\, i\le j \,\&amp;\, a_i\neq a_j\implies \varphi(a_i,a_j) \right\}
          %p Then rewrite the standard definition of NOP in a form with two items representing positve and negative requirements.
          %p
          .num_defn
            %h6 Definition
            %p
              A formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(x, y)
              has {\em NOP} iff there is no sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ω
                  %annotation{:encoding => "application/x-tex"} (a_i)_{i\in\omega}
              such that \begin{itemize} \item[a)] for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi j
                    %annotation{:encoding => "application/x-tex"} i\le j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi j
                    %mo ,
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(a_j,a_i)
              is false. %each subsequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mi j
                    %mo ,
                    %msub
                      %mi a
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a_i,a_j,a_i)
              is not
              = succeed "-indiscernible" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                    %annotation{:encoding => "application/x-tex"} \varphi
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≤
                      %mi j
                    %annotation{:encoding => "application/x-tex"} i\le j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ,
                    %msub
                      %mi a
                      %mi j
