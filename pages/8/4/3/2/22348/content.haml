                  %mo ⊤
                %annotation{:encoding => "application/x-tex"}
                  M_\bullet \xrightarrow{((\mathbb{N}^{\leq cofinite})^{\operatorname{cart}}_\bullet\to
                  (\mathbb{N}^{\leq cofinite}\cup\{\infty\})^{\operatorname{cart}}_\bullet)^{rl}} \hat M_\bullet \xrightarrow{((\mathbb{N}^{\leq cofinite})^{\operatorname{cart}}_\bullet\to
                  (\mathbb{N}^{\leq cofinite}\cup\{\infty\})^{\operatorname{cart}}_\bullet)^r} \top
          %p
            A topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em compact
            iff for each ultrafilter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔘
                %annotation{:encoding => "application/x-tex"} \mathfrak{U}
            either of the following equivalent conditions holds:
          %p
            i.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊥
                    %mo →
                    %msubsup
