                  %mi o
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{\{o,1\}\}
            are viewed as filters on the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi o
