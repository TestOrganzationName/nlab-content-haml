                  %mo ,
                  %msub
                    %mi a
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(x,a),\phi(x,a_1),...,\phi(x,a_n)
            is consistent whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_1,...,a_n
            lie on the same branch of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            The case of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi T
                  %msubsup
                    %mo{:stretchy => "false"} |
                    %mo •
                    %mtext NTP
                  %mo ⟶
                  %msubsup
                    %mi M
                    %mo •
                    %mrow
                      %mi ϕ
                      %mtext -NTP
                %annotation{:encoding => "application/x-tex"} |T|^\text{NTP}_\bullet \longrightarrow  M_\bullet^{\phi\text{-NTP}}
            is similar. \def\sing{\operatorname{sing}} Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            denote topological spaces.
          .num_remark
            %h6 Remark
            %p
              A homotopy contracting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to a point (i.e.~a map
            %div{:style => "text-align: center"} $h:F\times [0,1]/F\times \{1\} \longrightarrow X$
            %p
              from the cone of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "ar" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} sing
                      %msub
                        %mi F
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ⩽
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                        %mtext Top
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \sing F_\bullet((n+1)^\leqslant):=\Hom_\text{Top}( \Delta^n, F)
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} sing
                      %msub
                        %mi F
                        %mo •
                      %mo ⟶
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} sing
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \sing F_\bullet \longrightarrow \sing X_\bullet
            %div{:style => "text-align: center"}
              $\sing F_\bullet((n+1)^\leqslant):=\Hom_\text{Top}( \Delta^n, F)$,\\
              $\sing X_\bullet((n+1)^\leqslant):=\Hom_\text{Top}( \Delta^n, X)$, \\
              $\sing X_\bullet\circ[+1]((n+1)^\leqslant)=\Hom_\text{Top}( \Delta^n\times [0,1]/{\Delta^n\times\{1\}}, X)$\\
            %p
              Take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \delta: \Delta^n \to F
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi Δ
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} h_*(\delta):\Delta^n\times [0,1]/\Delta^n\times\{1\}\to X
              defined by
            %div{:style => "text-align: center"} $h_*(\delta)( x,t ):= h(\delta(x),t)$.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ⩾
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n\geqslant 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Delta^n\times [0,1]/{\Delta^n\times\{1\}}
              is the cone of
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta^n
          .num_remark
            %h6 Remark
            %p
              A map
              %br/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi F
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi F
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} h:F\times [0,1]/F\times \{1\} \longrightarrow X
              continuous in a neighbourhood of “e top of the cone’‘ point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} F\times \{1\}
              is the same as a map in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} sPhi
                  %annotation{:encoding => "application/x-tex"} \sPhi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F_\bullet\times ([0,1]_1)_\bullet  \longrightarrow X_\bullet[+1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1,..,x_n,t_1,..,t_n) \mapsto (h(x_1,1),h(x_1,t_1),h(x_2,t_2),...,h(x_n,t_n))
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} [0,1]_1
              denotes the interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              equipped with the filter of neighbourhoods of point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mo ,
                    %msub
