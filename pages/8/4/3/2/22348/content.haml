                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_\bullet(n)\to M_\bullet(l)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
