                    %mo ⋌
                    %msub
                      %mi X
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \bot\to \mathfrak{U}^{\operatorname{diag}}_\bullet \rightthreetimes X_\bullet\circ [+1]\to X_\bullet
          %p
            ii.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔘
                      %mo •
