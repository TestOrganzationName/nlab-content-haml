                  %annotation{:encoding => "application/x-tex"} \{o,1\}
          %p
          %h3#section_Local_triviality Local triviality
          %p#locallytrivial
            A map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            of topological or metric spaces is locally trivial with fibre
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            iff in sዋ becomes a direct product with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F_\bullet
            (“globally trivial”) after base-change
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Y_\bullet\circ [+1]\to Y_\bullet
            %br/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo •
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Y
                    %mo •
                  %mo ∘
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi Y
                        %mo •
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %msub
                    %mi Y
                    %mo •
                  %mo ∘
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f_\bullet:(Y_\bullet\circ [+1])\times_{Y_\bullet} X_\bullet \to  Y_\bullet\circ [+1]
            is of form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi F
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                    %mo ∘
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (Y_\bullet\circ [+1])\times F_\bullet \to  Y_\bullet\circ [+1]
          %p
          %h3#section_Geometric_realisation Geometric realisation
          %p
            The notion of
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            involves topological spaces and simplicial sets, which both are situses. This allows one to interpret the Besser-Drinfeld-Grayson construction of geometric realisation in sዋ, as follows.
          %p
            View the standard geometric simplex consisting of sequences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≤
                  %msub
                    %mi x
                    %mn 1
                  %mo ≤
                  %mo .
                  %mo .
                  %mo .
                  %mo ≤
                  %msub
                    %mi x
                    %mi n
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0\leq x_1\leq ... \leq x_n\leq 1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            as the space of monotone maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo ≤
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ≤
                %annotation{:encoding => "application/x-tex"} [0,1]^\leq \to (n+1)^\leq
            with Skorokhod-type metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dist
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi sup
                      %mi x
                    %msub
                      %mi inf
                      %mi y
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} dist(f,g):= sup_{x} inf_{y} \{ |x-y| : f(x)=g(y) \}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [0,1]_\bullet
            “remembers” the metric, and the situs structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi n
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ≤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta_n=Hom(-,(n+1)^\leq)
            “remembers” the equality
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)=g(x)
            = succeed "Then" do
              %br/
            %a{:href => "https://ncatlab.org/nlab/show/internal+hom#in_simplicial_sets"} inner hom
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HHom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi s
                  %mi ዋ
                  %mo →
                  %mi s
                  %mi ዋ
                %annotation{:encoding => "application/x-tex"} HHom([0,1]_\bullet, -) :s&amp;#x12CB;\to s&amp;#x12CB;
          %p of the underlying simplicial sets motivated by the definition of Skorokhod metric.
          %p
            This gives the construction of geometric realisation due to
            %br>/
            Besser, Drinfeld, and Grayson. See details at section 3.2 of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
          %p
          %h3#section_The_interval_object_and_homotopy_theory The interval object and homotopy theory
          No homotopy theory for situses has been developed. The naive definition of an
          %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
          used to define in sዋ geometric realisation eqipped with some situs structure “remembering” the topology, does not appear very useful, particularly for dealing with situses arising in model theory and the
          %a{:href => "en.wikipedia.org/wiki/Lifting_property"} lifting properties
          defining stability and simplicity (defined below). However, note that the naive interval object
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mo{:stretchy => "false"} [
                %mn 0
                %mo ,
                %mn 1
                %msubsup
                  %mo{:stretchy => "false"} ]
                  %mo •
                  %mo ≤
              %annotation{:encoding => "application/x-tex"} [0,1]^\leq_\bullet
          reminds one of
          = succeed ":" do
            %a.existingWikiWord{:href => "/nlab/show/directed+topological+space"} directed topological spaces
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi A
              %annotation{:encoding => "application/x-tex"} A
          to
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi B
              %annotation{:encoding => "application/x-tex"} B
          cannot in general be reversed to get a homotopy from
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi B
              %annotation{:encoding => "application/x-tex"} B
          to
          = succeed "." do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          %p
          %h3#section_Stability_and_simplicity_in_model_theory Stability and simplicity in model theory
          %p Let us now describe how situses can be used to reformulate two notions of model theory: stability and simplicity of a first-order theory. An alternative and more general approach is given in the next section on the Shelah’s dividing lines which completely covers simplicity(NTP).
          %p
          %h4{:id => "section_Stability."} Stability.
          %p
            Consider a model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in a language
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal {L}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "-formula" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal {L}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi x
                      %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(x_1,...,x_r)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (a_i)_{i\in I}
            of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is
            = succeed "-indiscernible" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi a
                    %mrow
                      %msub
