                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %mover
                    %mover
                      %mo →
                      %mo →
                    %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %msub
                    %mo ×
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %mover
                    %mo →
                    %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\mathbf{U} \times_{Y(V)} \mathbf{U}
                  \\times_{Y(V)} \mathbf{U}
                  \\times_{Y(V)} \mathbf{U}
                  \\stackrel{\to}{\stackrel{\to}{\stackrel{\to}{\to}}}
                  \\mathbf{U} \times_{Y(V)} \mathbf{U}
                  \\times_{Y(V)} \mathbf{U}
                  \\stackrel{\to}{\stackrel{\to}{\to}}
                  \\mathbf{U} \times_{Y(V)} \mathbf{U} \stackrel{\to}{\to} \mathbf{U}
                  \\,.
          %p
            When one passes from just presheaves to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
            = succeed "ing" do
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
            diagrams (namely the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy colimit
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
          %h4#the_sheaf_condition_from_morphisms_out_of_a_sieve The sheaf condition from morphisms out of a sieve
          %p
            We now show that the subfunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi S
                %annotation{:encoding => "application/x-tex"} F_S
            associated with a sieve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            coming from a cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            is the
            %em right
            kind of morphism to require a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            to be a
            %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
            for, by demonstrating that using it the usual
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
            on a presheaf with respect to the cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} \coprod_i U_i
            is reproduced:
          %p
            From the above detailed discussion, recall that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %mi sieve
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_{sieve(\{U_i\})}
            is precisely the
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of the obvious pair of morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\coprod_{i, j} \hom(-, U_i \cap U_j)
                  \\stackrel{\to}{\to}
                  \\coprod_i hom(-, U_i)
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom(-, U_i) := Y(U_i)
            denoting the presheaf
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
            under the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
          %p
            Here the domain of this parallel pair is the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of the evident map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \coprod_i hom(-, U_i) \to hom(-,X)
            = succeed "along" do
              %br/
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                          %mi hom
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %msub
                            %mi U
                            %mi i
                          %mo ∩
                          %msub
                            %mi U
                            %mi j
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi j
                          %mi hom
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %msub
                            %mi U
                            %mi j
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mi i
                          %mi hom
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi hom
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\coprod_{i,j} hom(-,U_i \cap U_j)
                  \&amp;\to&amp;
                  \\coprod_j hom(-, U_j)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\coprod_i hom(-, U_i)
                  \&amp;\to&amp;
                  hom(-,X)
                  }
          %p
            Thus for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \to G
            are precisely the same as maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \coprod_i \hom(-, U_i) \to G
            which coequalize the parallel pair. Applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi C
                            %mi op
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_{Set^{C^{op}}}(-,G)
            to the colimit diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  \\coprod_{i, j} \hom(-, U_i \cap U_j)
                  \\stackrel{\to}{\to}
                  \\coprod_i hom(-, U_i)
                  \\to
                  F
          %p yields the limit diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom(F, G)
                  \\to
                  Hom(\coprod_i hom(-, U_i), G)
                  \\stackrel{\to}{\to}
                  Hom(\coprod_{i, j} \hom(-, U_i \cap U_j), G)
          %p
            which using
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda
            is the equalizer diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi i
                  %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mi G
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom(F,G)
                  \\to
                  \\prod_i G(U_i) \stackrel{\to}{\to} \prod_{i, j} G(U_i \cap U_j)
          %p
            and hence identifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ,
