            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-toposes
            considered in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            are far from being
            %a.existingWikiWord{:href => "/nlab/show/cohesive+toposes"} cohesive
            over
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            and even farther from being
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-cohesive
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Grpd
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} Grpd_\infty
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to their
            %a.existingWikiWord{:href => "/nlab/show/terminal+geometric+morphism"} terminal geometric morphism
            would mean that
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/varieties"} varieties
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            were
            %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected
            or even
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+infinity-connected+%28infinity%2C1%29-topos"}
                locally
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            (This is in contrast to the situation in
            = succeed "," do
