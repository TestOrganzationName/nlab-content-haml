                            %mo ≤
                            %mi κ
                      %annotation{:encoding => "application/x-tex"} Sch^{\leq \kappa}_{/Spec(k)}
                  for the category of
                  = succeed "-small" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spec(k)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Sch
                          %mrow
                            %msub
                              %mo{:stretchy => "false"} /
                              %mi pet
                            %mi Spec
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mo ≤
                            %mi κ
                      %annotation{:encoding => "application/x-tex"} Sch^{\leq \kappa}_{/_{pet} Spec(k)}
                  for its
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of those that are
                  %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+morphism+of+schemes"} pro-étale
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spec(k)
                %p
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalently
                  this is the category of
                  = succeed "-small" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/profinite+sets"} profinite sets
            %p
              both regarded as
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              via the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+site"} pro-étale topology
            #eq:TheGeometricMorphism.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Sch
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ≤
                        %mi κ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟶
                        %mi Γ
                      %mover
                        %mo ⟵
                        %mi LConst
                    %mi Sh
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Sch
                      %mrow
                        %msub
                          %mo{:stretchy => "false"} /
                          %mi pet
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mo ≤
                        %mi κ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sh\big( Sch^{\leq \kappa}_{/Spec(k)}\big)
                    \\underoverset
                    {\underset{\Gamma}{\longrightarrow}}
                    {\overset{LConst}{\longleftarrow}}
                    {\;\; \bot \;\;}
                    Sh\big( Sch^{\leq \kappa}_{/_{pet}Spec(k)}\big)
            %p
              for the canonical
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              between their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
          %p
          #TerminologyOfCondensedSets.num_remark
            %h6 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
              in
              %a.maruku-eqref{:href => "#eq:TheGeometricMorphism"} (1)
              is also called the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/condensed+sets"} condensed sets
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/pyknotic+sets"} pyknotic sets
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              often omitted in the latter case).
          %p
            The following seems to be claimed:
          .num_prop
            %h6 Proposition
            %p
              The geometric morphism
              %a.maruku-eqref{:href => "#eq:TheGeometricMorphism"} (1)
              has the following properties:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LConst
                      %annotation{:encoding => "application/x-tex"} LConst
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %p and
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LConst
                    %annotation{:encoding => "application/x-tex"} LConst
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %p
          %p
            The first two claims are fairly standard, the last one would make the topos of pro-étale schemes be
            %a.existingWikiWord{:href => "/nlab/show/locally+connected+topos"} locally connected
            and hence
            %em almost
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive
            %a.existingWikiWord{:href => "/nlab/show/base+topos"} over
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/condensed+sets"} condensed sets
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/pyknotic+sets"} pyknotic sets
            (by Rem.
            = succeed ")." do
              %a.maruku-ref{:href => "#TerminologyOfCondensedSets"}
          %h2#StructuredInCondensedCohesion Structures in condensed local contractibility
          %p
            The point of axiomatic
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            is that it formally implies the presence of structures of the form of key phenomena known in traditional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+topology"} differential topology
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            into any given
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-topos
            %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+topos"} pro-étale
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            is cohesive over the
            %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+topos"} pro-étale
            %a.existingWikiWord{:href => "/nlab/show/base+topos"} base topos
            it inherits these structures.
          %p There would be much to be discussed here. The following lists some first observations with links to further commentary.
          %h3#differential_cohomology_diagram Differential cohomology diagram
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            in a
            %a.existingWikiWord{:href => "/nlab/show/locally+infinity-connected+%28infinity%2C1%29-topos"}
              locally
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            sits in the center of a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+diagram"} differential cohomology diagram
            %a.existingWikiWord{:href => "/nlab/show/modality"} modal
            aspects, such that, at least for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"}
                smooth
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theory"} Whitehead-generalized
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+theory"} differential cohomology theory
          %p
            Since the construction of the differential cohomology hexagon does not require the extra left adjoint to
            %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserve
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+topos"} pro-étale
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            = succeed "." do
              %a{:href => "#Scholzeb"} Scholze b
          %h2#references References
          %p The idea of the possibility of pro-étale local contractibility is voiced in discussion here:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"}> Marc Hoyois
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em étale ∞-site
              (around
              = succeed ")," do
                %a{:href => "https://nforum.ncatlab.org/discussion/5473/etale-site/?Focus=43431#Comment_43431"} nForum comment 43431
          %p
            The claim of cohesion-except-for-product-preservation of gros
            %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+toposes"} pro-étale toposes
            over the corresponding pro-étale base topos appears in:
          %ul
            %li#Scholze2020
              %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"}> Peter Scholze
              ,
              = succeed "," do
                %em
                  %a{:href => "https://golem.ph.utexas.edu/category/2020/03/pyknoticity_versus_cohesivenes.html#c057631"} Re: Pyknoticity versus Cohesiveness
          %p Related remarks and discussion:
          %ul
            %li#Scholzea
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"}> Peter Scholze
                ,
                = succeed "," do
                  %em Answer to ‘What is the precise relationship between pyknoticity and cohesiveness?’
                = succeed ")." do
                  %a{:href => "https://mathoverflow.net/a/356836/447"} MO:https://mathoverflow.net/a/356836
            %li#Scholzeb
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"}> Peter Scholze
                ,
                = succeed "," do
                  %em Answer to ‘Cohesion relative to a pyknotic/condensed base’
                = succeed ")." do
                  %a{:href => "https://mathoverflow.net/a/384900/381"} MO:a/384900
            %li#Scholzec
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"}> Peter Scholze
                ,
                = succeed "," do
