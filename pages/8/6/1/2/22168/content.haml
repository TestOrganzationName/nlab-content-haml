            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+manifolds"} formal smooth manifolds
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"}
              cohesive
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            over
            %a.existingWikiWord{:href => "/nlab/show/Infinity-Grpd"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} Grpd_\infty
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"}
                smooth
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/formal+smooth+infinity-groupoids"}
              formal smooth
              = succeed "-groupoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+infinity-groupoid"}
                super formal smooth
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            But
            %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            may usefully be considered over non-trivial
            %a.existingWikiWord{:href => "/nlab/show/base+toposes"} base toposes
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/base+%28infinity%2C1%29-topos"}
                base
                = succeed "-toposes" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"}
              slice
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            of
            %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
            over the archetypical
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/orbi-singularity"} orbi-singularity
            is cohesive over proper
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            (see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesion+of+global-+over+G-equivariant+homotopy+theory"} cohesion of global- over G-equivariant homotopy theory
          %p#AlmostCohesionInIntroduction
            Analogously, the
            %a.existingWikiWord{:href => "/nlab/show/gros+topos"} gros topos
            of
            %a.existingWikiWord{:href => "/nlab/show/pro-%C3%A9tale+topos"} pro-étale
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            over the base topos of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/condensed+sets"} condensed sets
            %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28infinity%2C1%29-topos"}
              hypercomplete
              = succeed "-toposes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            is claimed in
            = succeed "," do
              %a{:href => "#Scholze2020"} Scholze 2020
            = succeed "." do
              %a{:href => "#Scholzea"} Scholze a
          %p
            In view of the terminology of “
            %a.existingWikiWord{:href => "/nlab/show/condensed+mathematics"}> condensed mathematics
            ” one might call this local contractibility of pro-étale arithmetic geometry relative to condensed sets:
            = succeed "." do
              %em condensed local contractibility
          %h2#Statement Statement
          %blockquote
            %p under construction
          %p
          .num_defn
            %h6 Definition
            %p Given
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  a separably closed field,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  an uncountable
                  %a.existingWikiWord{:href => "/nlab/show/strong+limit+cardinal"} strong limit cardinal
            %p write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
