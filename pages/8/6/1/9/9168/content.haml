          %h5#on_minkowski_spacetime On Minkowski spacetime
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            of the
            %a.existingWikiWord{:href => "/nlab/show/free+field"} free
            scalar field on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+A+first+idea+of+quantum+field+theory"} geometry of physics – A first idea of quantum field theory
          #LagrangianForFreeScalarFieldOnMinkowskiSpacetime.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi d
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma \coloneqq \mathbb{R}^{p,1} = (\mathbb{R}^d, \eta)
              be
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p + 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              denotes the Minkowski
              %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
              of
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+quadratic+form"} signature
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-,+,\cdots, +)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{dvol}_\Sigma \in \Omega^{p+1}(\Sigma)
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mo →
                    %mi ℝ
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi μ
                        %mo =
                        %mn 0
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \{x^\mu \colon \Sigma \to \mathbb{R}\}_{\mu = 0}^p
              for the canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
            %p
              Let the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \to \Sigma
              be the
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
              %a.existingWikiWord{:href => "/nlab/show/real+line+bundle"} real line bundle
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              Then its
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mn ∞
                    %mi E
                  %annotation{:encoding => "application/x-tex"} J^\infty E
              has canonical coordinates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi x
                      %mi μ
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi ϕ
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{ \{x^\mu\}, \phi, \{\phi_{,\mu}\}, \{\phi_{,\mu \nu}\}, \cdots \}
                    \\,.
            %p
              In these coordinates, the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L \in \Omega^{p+1,0}(\Sigma)
            %p
              defining the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              of
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m \in [0,\infty)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo +
                      %msup
                        %mi m
                        %mn 2
                      %msup
                        %mi ϕ
                        %mn 2
                      %mo )
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\coloneqq
                    \\tfrac{1}{2}
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} \phi_{,\nu}
                    +
                    m^2 \phi^2
                    \\right)
                    \\mathrm{dvol}_\Sigma
                    \\,.
          #FreeScalarFieldEOM.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
                of
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %p
              In the situation of def.
              %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi Σ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \Phi : \Sigma \to \mathbb{R}
              the
              = succeed "-component" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
              is the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mo ∂
                        %mi μ
                      %msub
                        %mo ∂
                        %mi ν
                      %mo +
                      %msup
                        %mi m
                        %mn 2
                      %mo )
                    %mi Φ
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\eta^{\mu \nu} \partial_\mu \partial_\nu + m^2 \right) \Phi = 0
                    \\,.
            %p
              Moreover, the induced
              %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+current"} pre-symplectic current
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{p-1,2}(E)
              is, in local coordinates,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi d
                        %mi V
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %mo ∧
                      %msub
                        %mi d
                        %mi V
                      %mi ϕ
                      %mo )
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \=
                    \\left(\eta^{\mu \nu} d_V \phi_{,\mu} \wedge d_V \phi \right) \wedge \iota_{\partial_\nu} dvol_{\Sigma}
            %p
              and hence the induced
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              of the free scalar field takes two
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %mo ,
                      %msub
                        %mi w
                        %mn 2
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w_1,w_2 \in C^\infty(\Sigma)
              %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
              at zero to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi w
                      %mn 1
                    %mo ,
                    %msub
                      %mi w
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mi n
                      %msub
                        %mi w
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi w
                        %mn 2
                      %mo −
                      %msub
                        %mi w
                        %mn 1
                      %msub
                        %mo ∂
                        %mi n
                      %msub
                        %mi w
                        %mn 2
                      %mo )
                    %msub
                      %mi dvol
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}_{\Sigma_{p}}(w_1, w_2)
                    \\;=\;
                    \\int_{\Sigma_{p}}
                    \\left(
                    (\partial_n w_1) w_2
                    \-
                    w_1 \partial_n w_2
                    \\right)
                    dvol_{\Sigma_{p}}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_{p} \hookrightarrow \Sigma
              is any
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi N
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} n \in N \Sigma_{p}
              denotes its time-like normal vector field.
          .proof
            %h6#proof Proof
            %p
              We need to show that
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi S
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta_{EL} \colon \Omega^{p+1,0}(\Sigma) \to \Omega^{p+1,1}_S(\Sigma)
              takes the
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+density"} local Lagrangian density
              for the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %mo +
                      %msup
                        %mi m
                        %mn 2
                      %mi ϕ
                      %mo )
                    %msub
                      %mi d
                      %mi V
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_EL L
                    \\;=\;
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu \nu}  + m^2 \phi
                    \\right)
                    d_V \phi \wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p
              First of all, the result of applying the
              %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} vertical differential
              to the local Lagrangian density is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi V
                    %mi L
                    %mo =
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi d
                        %mi V
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo +
                      %msup
                        %mi m
                        %mn 2
                      %mi ϕ
                      %msub
                        %mi d
                        %mi V
                      %mi ϕ
                      %mo )
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_V L
                    \=
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu} d_V \phi_{,\nu}
                    +
                    m^2 \phi d_V \phi
                    \\right)
                    \\wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p
              By definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} EL
                  %annotation{:encoding => "application/x-tex"} \mathrm{EL}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mi d
                        %mi V
                      %mi ϕ
                      %mo −
                      %msub
                        %mi d
                        %mi H
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} (-) \wedge d_V \phi  - d_H \theta
            %p
              The key to find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is to realize
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi V
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi ν
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} d_V \phi_{,\nu}\wedge \mathrm{dvol}_\Sigma
              as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi H
                    %mi ϕ
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mi d
                    %msup
                      %mi x
                      %mi μ
                  %annotation{:encoding => "application/x-tex"} d_H \phi = \phi_{,\mu} d x^\mu
              this is accomplished by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi V
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi ν
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mo =
                    %msub
                      %mi d
                      %mi V
                    %msub
                      %mi d
                      %mi H
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    d_V \phi_{,\nu} \wedge \mathrm{dvol}_\Sigma
                    \=
                    d_V d_H \phi \wedge \iota_{\partial_\nu} \mathrm{dvol}_\Sigma
            %p Hence we may set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mi d
                      %mi V
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\theta
                    \\coloneqq
                    \\eta^{\mu \nu} \phi_{,\mu} d_V \phi \wedge \iota_{\partial_\nu}
                    \\mathrm{dvol}_\Sigma
                    \\,,
            %p because with this we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi H
                    %mi θ
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %mrow
                      %mo (
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                          %mi ν
                      %msub
                        %mi d
                        %mi V
                      %mi ϕ
                      %mo −
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi d
                        %mi V
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo )
                    %mo ∧
                    %msub
                      %mi{:mathvariant => "normal"} dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_H \theta
                    \=
                    \\eta^{\mu \nu}
                    \\left(
                    \\phi_{,\mu \nu} d_V \phi
                    \-
                    \\eta^{\mu \nu} \phi_{,\mu} d_V \phi_{,\nu}
                    \\right) \wedge \mathrm{dvol}_\Sigma
                    \\,.
            %p In conclusion this yields the decomposition of the vertical differential of the Lagrangian density
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi V
                    %mi L
                    %mo =
                    %munder
                      %munder
                        %mrow
                          %mrow
                            %mo (
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msub
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi μ
                                %mi ν
                            %mo +
                            %msup
                              %mi m
                              %mn 2
                            %mi ϕ
                            %mo )
                          %msub
                            %mi d
                            %mi V
                          %mi ϕ
                          %mo ∧
                          %msub
                            %mi{:mathvariant => "normal"} dvol
                            %mi Σ
                        %mo ⏟
                      %mrow
                        %mo =
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                    %mo −
                    %msub
                      %mi d
                      %mi H
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    d_V L
                    \=
                    \\underset{
                    \= \delta_{EL} L
                    }{
                    \\underbrace{
                    \\left(
                    \\eta^{\mu \nu} \phi_{,\mu \nu}  + m^2 \phi
                    \\right)
                    d_V \phi \wedge \mathrm{dvol}_\Sigma
                    }
                    }
                    \-
                    d_H \theta
                    \\,,
            %p
              which shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL} L
              is as claimed, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is a presymplectic potential current. Hence the presymplectic current itself is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                          %mtd
                            %mo ≔
                            %msub
                              %mi d
                              %mi V
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi d
                              %mi V
                            %mrow
                              %mo (
                              %msup
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %msub
                                %mi d
                                %mi V
                              %mi ϕ
                              %mo ∧
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi ν
                              %msub
                                %mi{:mathvariant => "normal"} dvol
                                %mi Σ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %msup
                                %mi η
                                %mrow
                                  %mi μ
                                  %mi ν
                              %msub
                                %mi d
                                %mi V
                              %msub
                                %mi ϕ
                                %mrow
                                  %mo ,
                                  %mi μ
                              %mo ∧
                              %msub
                                %mi d
                                %mi V
                              %mi ϕ
                              %mo )
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega &amp;\coloneqq d_V \theta
                    \\\
                    \&amp; =
                    d_V \left( \eta^{\mu \nu} \phi_{,\mu} d_V \phi \wedge \iota_{\partial_\nu} \mathrm{dvol}_\Sigma \right)
                    \\\
                    \&amp; =
                    \\left(\eta^{\mu \nu} d_V \phi_{,\mu} \wedge d_V \phi \right) \wedge \iota_{\partial_\nu} dvol_{\Sigma}
                    \\end{aligned}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_p \hookrightarrow \Sigma
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              of this presymplectic current to the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ω
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi w
                              %mn 1
                            %mo ,
                            %msub
                              %mi w
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %msub
                                %mo ∫
                                %mrow
                                  %msub
                                    %mi Σ
                                    %mi p
                              %mrow
                                %mo (
                                %msup
                                  %mi η
                                  %mrow
                                    %mi μ
                                    %mi ν
                                %mstyle{:mathvariant => "bold"}
                                  %mi d
                                %msub
                                  %mo ∂
                                  %mi μ
                                %mi ϕ
                                %mo ∧
                                %mstyle{:mathvariant => "bold"}
                                  %mi d
                                %mi ϕ
                                %mo )
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mo ∂
                                    %mi ν
                              %msub
                                %mi dvol
                                %mi Σ
                              %mo )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi w
                              %mn 1
                            %mo ,
                            %msub
                              %mi w
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi n
                              %msub
                                %mi w
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %msub
                                %mi w
                                %mn 2
                              %mo −
                              %msub
                                %mi w
                                %mn 1
                              %msub
                                %mo ∂
                                %mi n
                              %msub
                                %mi w
                                %mn 2
                              %mo )
                            %msub
                              %mi dvol
                              %mrow
                                %msub
                                  %mi Σ
                                  %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega_{\Sigma_{p}}(w_1, w_2)
                    \&amp; =
                    \\left(
                    \\int_{\Sigma_p}
                    \\left(
                    \\eta^{\mu \nu} \mathbf{d} \partial_\mu \phi \wedge \mathbf{d} \phi
                    \\right)
                    \\iota_{\partial_\nu} dvol_\Sigma
                    \\right)
                    (w_1, w_2)
                    \\\
                    \&amp; =
                    \\int_{\Sigma_{p}}
                    \\left(
                    (\partial_n w_1) w_2
                    \-
                    w_1 \partial_n w_2
                    \\right)
                    dvol_{\Sigma_{p}}
                    \\end{aligned}
          #PoissonBracketsOverMinkowskiSpacetime.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poisson+brackets"} Poisson brackets
                over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Consider the covariant phase space over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+current"} pre-symplectic current
              according to prop.
              %a.maruku-ref{:href => "#FreeScalarFieldEOM"}
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi d
                      %mi V
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mo ∧
                    %msub
                      %mi d
                      %mi V
                    %mi ϕ
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \=
                    \\eta^{\mu \nu} d_V \phi_{,\mu} \wedge d_V \phi \wedge \iota_{\partial_\mu} dvol_\Sigma
                    \\,
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie (p+1)-algebra
              has in degree 0
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+forms"} Hamiltonian forms
              such as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ≔
                    %mi ϕ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q \coloneqq \phi \iota_{\partial_0} dvol_\Sigma \in \Omega^{p,0}(E)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \coloneqq \eta^{\mu \nu} \phi_{,\mu} \iota_{\partial_\nu} dvol_{\Sigma} \in \Omega^{p,0}(E)
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi P
                    %mo =
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    v_P = \partial_{\phi_{,0}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi Q
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ∂
                      %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_Q = - \partial_{\phi}
                    \\,.
            %p Hence the corresponding bracket is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Q
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi Q
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi P
                    %mi ω
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{Q,P\} = \iota_{v_Q} \iota_{v_P} \omega = \iota_{\partial_0} dvol_\Sigma
                    \\,.
            %p
              More generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b_1, b_2 \in C^\infty_c(\Sigma)
              two
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi b
                      %mn 1
                    %mi Q
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mi P
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mo ±
                    %msub
                      %mi b
                      %mn 1
                    %msub
                      %mi b
                      %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{ b_1 Q, b_2 P \} = \pm b_1 b_2 \iota_{\partial_0} dvol_\Sigma
                    \\,.
            %p
              Upon
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
              to the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mi p
                      %mi t
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi Σ
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi x
                      %mn 0
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Sigma^t_{p} \coloneqq \{x \in  \Sigma \vert x^0 = t \}
              this yields the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mo ∫
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %msub
                        %mi b
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mn 0
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi d
                        %mi p
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mo ∫
                        %mrow
                          %msub
                            %mi Σ
                            %mi p
                      %msub
                        %mi b
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ∂
                        %mn 0
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ,
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mn 0
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Σ
                          %mi p
                    %msub
                      %mi b
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi b
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi d
                      %mi p
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
