                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                    %mo ∫
                    %mi Amp
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                        %msub
