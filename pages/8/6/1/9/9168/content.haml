                                    %mi x
                                    %mo{:stretchy => "false"} →
                                  %mn 1
                                %mo −
                                %msub
                                  %mover
                                    %mi k
                                    %mo{:stretchy => "false"} →
                                  %mn 2
                                %mo ⋅
                                %msub
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} →
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mi d
                            %msub
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} →
                              %mn 1
                            %mi d
                            %msub
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} →
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi p
                            %mo ∫
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mover
                                    %mi k
                                    %mo{:stretchy => "false"} →
                                  %mn 1
                                %mo −
                                %msub
                                  %mover
                                    %mi k
                                    %mo{:stretchy => "false"} →
                                  %mn 2
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mover
                                  %mi x
                                  %mo{:stretchy => "false"} →
                            %mi d
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                          %mtd
                            %mo =
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} →
                              %mn 1
                            %mo −
                            %msub
                              %mover
                                %mi k
                                %mo{:stretchy => "false"} →
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    
                    \\{ a(\vec k_1), a(\vec k_2)^\ast  \}
                    \&amp; =
                    \-i
                    (2\pi)^{-p}
                    \\int \delta(\vec x_1 - \vec x_2) e^{i  ( \vec k_1 \cdot \vec x_1 - \vec k_2 \cdot \vec x_2) } d \vec x_1 d\vec x_2
                    \\\
                    \&amp; =
                    \-i
                    (2\pi)^{-p}
                    \\int e^{i (\vec k_1 - \vec k_2) \cdot \vec x } d \vec x
                    \&amp; =
                    \\\
                    \&amp; =  -i \delta(\vec k_1 - \vec k_2)
                    \\,,
                    \\end{aligned}
            %p
              where in the last step we used the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              representation of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              (
              %a{:href => "Dirac+distribution#FourierTransform"}> this prop.
              ).
            %p
              In order to finally compute
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\phi(x), \phi(y)\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ∫
                    %mfrac
                      %mn 1
                      %msqrt
                        %mrow
                          %mn 2
                          %mi E
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi k
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} )
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi i
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} )
                        %msup
                          %mi x
                          %mn 0
                        %mo +
                        %mi i
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} →
                        %mo ⋅
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                    %msup
                      %mi d
                      %mi p
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                    %mphantom
                      %mi AAAA
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ∫
                    %mfrac
                      %mn 1
                      %msqrt
                        %mrow
                          %mn 2
                          %mi E
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi k
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} )
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} )
                        %msup
                          %mi x
                          %mn 0
                        %mo −
                        %mi i
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} →
                        %mo ⋅
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                    %msup
                      %mi d
                      %mi p
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^{(+)}(x)
                    \\;\coloneqq\;
                    (2\pi)^{-p/2}
                    \\int \frac{1}{\sqrt{2 E(\vec k)}}
                    a(\vec k)^\ast e^{+ i E(\vec k) x^0 + i \vec k \cdot \vec x}
                    d^p \vec k
                    \\phantom{AAAA}
                    \\phi^{(-)}(x)
                    \\;\coloneqq\;
                    (2\pi)^{-p/2}
                    \\int \frac{1}{\sqrt{2 E(\vec k)}}
                    a(\vec k) e^{- i E(\vec k) x^0 - i \vec k \cdot \vec x}
                    d^p \vec k
            %p
              for the positive and negative energy contributions from the Fourier expansion in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:FourierModeExpansionOfScalarFieldOnminkowskiSpacetime"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(x) = \phi^{(-)}(x)  + \phi^{(+)}(x)
                    \\,.
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relation"} canonical commutation relation
              of the mode functions
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CanonicalPoissonCommutationOfModesOfFreeScalarFieldOnMinkowskiSpacetime"} (3)
            #eq:2PointFunctionFreeScalarFieldOnMinkowski.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mi i
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi ϕ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mi ϕ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi p
                            %mo ∫
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi E
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mi k
                                    %mo{:stretchy => "false"} →
                                  %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi E
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi k
                                  %mo{:stretchy => "false"} →
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 0
                                %mo −
                                %mover
                                  %mi k
                                  %mo{:stretchy => "false"} →
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi x
                                  %mo{:stretchy => "false"} →
                                %mo −
                                %mover
                                  %mi y
                                  %mo{:stretchy => "false"} →
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi d
                              %mi p
                            %mover
                              %mi k
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi p
                            %mo ∫
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mi μ
                            %msup
                              %mi k
                              %mi μ
                            %mo +
                            %msup
                              %mi m
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mi Θ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msub
                                  %mi k
                                  %mi μ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi μ
                            %msup
                              %mi d
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %mi k
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-i \omega(x,y)
                    \&amp; \coloneqq
                    \\{ \phi^{(-)}(x), \phi^{(+)}(y) \}
                    \\\
                    \&amp;=
                    \-i (2\pi)^{-p} \int \tfrac{1}{2 E(\vec k)} e^{- i E(\vec k) (x-y)^0 - \vec k \cdot (\vec x - \vec y)} d^{p} \vec k
                    \\\
                    \&amp; =
                    \-i (2\pi)^{-p} \int \delta( k_\mu k^\mu + m^2 ) \Theta( k_0 ) e^{ - i k_\mu (x-y)^\mu } d^{p+1} k
                    \\,,
                    \\end{aligned}
            %p
              where in the last line we again applied
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is known as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/2-point+function"} 2-point function
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hadamard+propagator"} Hadamard propagator
              on Minkowski spacetime (see def.
              %a.maruku-ref{:href => "#2PointFunctionOfScalarFieldOnMinkowskiSpacetime"}
              below).
            %p Similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi ϕ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mi ϕ
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi p
                            %mo ∫
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi E
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mi k
                                    %mo{:stretchy => "false"} →
                                  %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mi E
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi k
                                  %mo{:stretchy => "false"} →
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 0
                                %mo +
                                %mover
                                  %mi k
                                  %mo{:stretchy => "false"} →
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi x
                                  %mo{:stretchy => "false"} →
                                %mo −
                                %mover
                                  %mi y
                                  %mo{:stretchy => "false"} →
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi d
                              %mi p
                            %mover
                              %mi k
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi p
                            %mo ∫
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mi μ
                            %msup
                              %mi k
                              %mi μ
                            %mo +
                            %msup
                              %mi m
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mi Θ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi k
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msub
                                  %mi k
                                  %mi μ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo −
                                %mi y
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi μ
                            %msup
                              %mi d
                              %mrow
                                %mi p
                                %mo +
                                %mn 1
                            %mi k
                        %mtr
                          %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\{ \phi^{(+)}(x), \phi^{(-)}(y) \}
                    \&amp; =
                    + i (2\pi)^{-p} \int \tfrac{1}{2 E(\vec k)} e^{i E(\vec k) (x-y)^0 + \vec k \cdot (\vec x - \vec y)} d^{p} \vec k
                    \\\
                    \&amp; =
                    + i (2\pi)^{-p} \int \delta( k_\mu k^\mu + m^2 ) \Theta( -k_0 ) e^{ - i k_\mu (x-y)^\mu } d^{p+1} k
                    \\\
                    \\end{aligned}
                    \\,.
            %p In particular this says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
