          %h2#definitions Definitions
          %p
            Ideals show up both in
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            theory and in
            %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
            theory. We recall both of these below and look at some slight generalizations.
          %h3#in_rings_and_other_rigs In rings (and other rigs)
          %p
            A
            %strong left ideal
            in a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            (or even
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            of (the underlying set of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            such that:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 0 \in I
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x + y \in I
              whenever
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x, y \in I
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x y \in I
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} y \in I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x \in I
          %p
            A
            %strong right ideal
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            such that:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 0 \in I
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x + y \in I
              whenever
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x, y \in I
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x y \in I
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x \in I
          %p
            A
            %strong two-sided ideal
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            that is both a left and right ideal; that is:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 0 \in I
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo +
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x + y \in I
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \in I
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} y \in I
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x y \in I
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \in I
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} y \in I
          %p This generalises to:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi x
                      %mi n
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x_1 + \cdots + x_n \in I
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi k
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x_k \in I
              for every
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi x
                      %mi n
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x_1 \cdots x_n \in I
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi k
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x_k \in I
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p Notice that all three kinds of ideal are equivalent for a commutative ring.
          .num_remark
            %h6#remarks Remarks
            %ul
              %li
                A left ideal in a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                may be equivalently defined as an
                = succeed "-submodule" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
              %li
                A right ideal in a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                may be equivalently defined as an
                = succeed "-submodule" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
              %li
                A two-sided ideal in a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                may be equivalently defined as a sub-bimodule of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              %li
                The collection of all two-sided ideals in a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                form a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
                %a.existingWikiWord{:href => "/nlab/show/category+of+two-sided+ideals+in+a+ring"} category of two-sided ideals in a ring
              %li The preceding remarks apply to rigs as well.
              %li
                Considering the category of rings as a Barr-exact category, there is a natural bijection between
                %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence relations
                on a ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                (internal to the category of rings) and two-sided ideals of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                the relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∼
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \sim_I
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi I
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_I y
                means
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo −
                        %mi y
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} x - y \in I
          %p
            This definition also makes sense for
            %a.existingWikiWord{:href => "/nlab/show/nonassociative+rings"} nonassociative rings
            (or rigs), with the left/right/two-sided coincidence in the commutative case.
          %p
            In the case of a
            %a.existingWikiWord{:href => "/nlab/show/nonunital+ring"} nonunital ring
            (or rig), if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is being thought of as a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over some other ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a
            %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} a x \in I
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} a \in K
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \in I
          %p
            in the case of left-modules, and similarly in the case of right modules or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            an
            %strong
              ideal of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            or the like.) In particular, a (real or complex)
            %a.existingWikiWord{:href => "/nlab/show/Lie+ideal"} Lie ideal
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is an ideal of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            over the real or complex field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %h3#in_lattices_and_other_prosets In lattices (and other prosets)
          %p
            An
            %strong ideal
            in a
            %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
            (or even
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} proset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            of (the underlying set of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            such that:
          %ul
            %li
              There is an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              (so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is
              = succeed ");" do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            %li
              if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x, y \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ≤
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x, y \leq z
              for some
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} z \in I
            %li
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \in I
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ≤
                      %mi x
                    %annotation{:encoding => "application/x-tex"} y \leq x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} y \in I
              too.
          %p
            We can make this look more algebraic if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a (bounded) join-
            %a.existingWikiWord{:href => "/nlab/show/semilattice"}> semilattice
            \:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \bot \in I
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∨
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \vee y \in I
              if
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x, y \in I
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} y \in I
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∨
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x \vee y \in I
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is indeed a lattice, then we can make this look just like the ring version:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊥
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \bot \in I
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∨
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \vee y \in I
              whenever
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x, y \in I
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∧
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \wedge y \in I
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x \in I
          %p
            The concept of ideal is dual to that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            that satisfies the first two of the three axioms for an ideal in a proset is precisely a
            %a.existingWikiWord{:href => "/nlab/show/direction"} directed subset
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a lattice.
          %h3#in_both_at_once In both at once
          %p There are some common situations where these two kinds of ideal might seem to clash but fortunately do not:
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
                is both a lattice and a commutative rig; the two concepts of ideal are the same, as can be seen by comparing the definition for rigs to the last definition for lattices.
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                is a both a distributive lattice and a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Boolean+ring"} Boolean ring
          %p
            On the other hand, every poset is a poset in an
            %a.existingWikiWord{:href => "/nlab/show/opposite+poset"} opposite
            way, and this does
            %em not
            give the same concept of ideal; an ideal in one is a
            %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            in the opposite one. We are lucky that the convention for interpreting a Boolean ring as a lattice goes in the correct direction, or the two notions of ideal in a Boolean algebra would not match; or perhaps it is not a matter of luck, but the convention for which way to define ideals in a lattice was chosen precisely to match the conventions for Boolean algebras!
          %h3#in_monoids In monoids
          %p
            There is a notion of ideal in a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            (or even
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in any
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab+Mon"} Ab Mon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
            is a commutative idempotent monoid in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ideal+in+a+monoid"} ideal in a monoid
          %p
            This generalizes all of the above notions of ideal
            %em except
            for ideals in prosets that are not (possibly unbounded) join-semilattices.
          %h3#in_categories In categories
          %p
            More generally still, passing from monoids to their many-object version and from prosets to their many-morphism version, a right ideal or
            %em
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            is a subcategory closed under precomposition with morphisms from the entire category, and a left ideal or
            %em
              %a.existingWikiWord{:href => "/nlab/show/cosieve"} cosieve
            is the dual notion closed under postcompositions with morphisms in the entire category. See
            %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cosieve"} cosieve
          %h3#in_additive_categories In additive categories
          %p In ringoids (small additive categories) and additive categories in general, a left/right/2-sided ideal is just the ideal (sieve/cosieve) in the sense of categories which is also closed under group operations in hom groups.
          %h2#kinds_of_ideals Kinds of ideals
          %p
            Ideals form
            %a.existingWikiWord{:href => "/nlab/show/complete+lattices"} complete lattices
            where arbitrary meets are given by set-theoretic intersection. In other words, ideals form a
            %a.existingWikiWord{:href => "/nlab/show/Moore+collection"} Moore collection
            of subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a rig, or of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a lattice. This implies we have an ideal
            %strong generated
            by any
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that generates a given ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            may be called a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/base"} base
            if every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a multiple (in a rig) or a predecessor (in an order) of some element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/singleton+subset"} singleton subset
            is a base of its generated ideal.) See also
            %a.existingWikiWord{:href => "/nlab/show/filter+base"} filter base
            and dualize for more about bases and subbases of ideals in lattices and other posets.
          %p
            Certain kinds of ideals are often characterized by the roles they play in ideal lattices, or in terms of the Moore
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closure+operator"} closure operator
          %p
            The top element of an ideal lattice is called the
            = succeed "." do
              %em improper ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the improper ideal if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} x \in I
            for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (which follows if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} 1 \in I
            for the case of rigs, or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} \top \in I
            for the case of bounded lattices). An ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is
            %em proper
            if it is not the improper ideal: if there exists an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∉
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x \notin I
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is proper iff
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∉
                    %mi I
                  %annotation{:encoding => "application/x-tex"} 1 \notin I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is proper iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo ∉
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \top \notin I
          %p
            An ideal is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            if it is maximal among
            %em proper
            ideals. A maximal ideal in a rig (including in a distributive lattice, but not in every lattice) is necessarily
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime
            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
            is necessarily maximal.
          %p
            An ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/principal+ideal"} principal ideal
            if it is generated by a singleton. This means there exists an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} x \in I
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is a multiple of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (in a rig) or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ≤
                  %mi x
                %annotation{:encoding => "application/x-tex"} y \leq x
            (in an ordered set) whenever
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} y \in I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is
            %strong generated
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            generates a unique principal ideal, the set of all left/right/two-sided multiples of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi a
                  %mi x
                %annotation{:encoding => "application/x-tex"} a x
            ,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi b
                  %annotation{:encoding => "application/x-tex"} x b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi x
                  %mi b
                %annotation{:encoding => "application/x-tex"} a x b
            if we are talking about left/right/two-sided ideals in a rig) or the
            %a.existingWikiWord{:href => "/nlab/show/downset"} downset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (in an an order). Clearly, every ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a join over all the principal ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi x
                %annotation{:encoding => "application/x-tex"} P_x
            generated by the elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %p
            As discussed at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ideals+in+a+monoid"} ideals in a monoid
            %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
            (cf.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ,
                  %mi J
                %annotation{:encoding => "application/x-tex"} I, J
            are ideals, then their product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mi J
                %annotation{:encoding => "application/x-tex"} I J
            is the ideal generated by all products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi y
                %annotation{:encoding => "application/x-tex"} x y
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi I
                  %mo ,
                  %mi y
                  %mo ∈
                  %mi J
                %annotation{:encoding => "application/x-tex"} x \in I, y \in J
            in the case of rigs. Similarly, in the case of lattices, we could define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mi J
                %annotation{:encoding => "application/x-tex"} I J
            to be the ideal generated by all meets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∧
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \wedge y
            – but in this case the result is the same as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∩
                    %mi J
                  %annotation{:encoding => "application/x-tex"} I \cap J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime
            if for any ideals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi J
                  %annotation{:encoding => "application/x-tex"} I, J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mi J
                  %mo ⊆
                  %mi P
                %annotation{:encoding => "application/x-tex"} I J \subseteq P
            implies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊆
                  %mi P
                %annotation{:encoding => "application/x-tex"} I \subseteq P
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} J \subseteq P
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/order+theory"} order theory
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/strongly+irreducible+ideal"} strongly irreducible ideal
          %p
            An (left, right, or two-sided) ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/irreducible+ideal"} irreducible
            if it is proper and, whenever it is written as the
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            of two ideals (of the same kind)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mi J
                    %mo ∩
                    %mi K
                  %annotation{:encoding => "application/x-tex"} I = J \cap K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            equals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/strongly+irreducible+ideal"} strongly irreducible ideal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prosets"} prosets
            %strong
              %a.existingWikiWord{:href => "/nlab/show/completely+irreducible+ideal"} completely irreducible
            if whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is an intersection of any (possibly infinite) collection of ideals,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is equal to at least one of them. (This is
            %em not
            analogous to
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/completely+prime+ideals"} completely prime ideals
          %p
            An ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a
            %strong nil ideal
            if for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x\in I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n\in \mathbb{N}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x^n=0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n\in \mathbb{N}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} x\in I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x^n=0
            = succeed "." do
              %strong nilpotent
          .num_prop
            %h6#proposition Proposition
            %p
              A maximal ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is prime.
          .proof
            %h6#proof Proof
            %p
              Because the ideal lattice is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mi J
                    %mo ⊆
                    %mi M
                  %annotation{:encoding => "application/x-tex"} I J \subseteq M
              for two ideals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ,
                      %mi J
                    %annotation{:encoding => "application/x-tex"} I, J
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∨
                    %mi M
                    %mo =
                    %mo ⊤
                    %mo =
                    %mi J
                    %mo ∨
                    %mi M
                  %annotation{:encoding => "application/x-tex"} I \vee M = \top = J \vee M
              (the improper ideal) since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is maximal. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊤
                    %mo =
                    %mo ⊤
                    %mo ⋅
                    %mo ⊤
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ∨
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ∨
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi I
                    %mi J
                    %mo ∨
                    %mi M
                    %mi J
                    %mo ∨
                    %mi I
                    %mi M
                    %mo ∨
                    %mi M
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \top = \top \cdot \top = (I \vee M) \cdot (J \vee M) = I J \vee M J \vee I M \vee M M
            %p
              where all four summands are contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mi J
                    %mo ⊆
                    %mi M
                  %annotation{:encoding => "application/x-tex"} I J \subseteq M
              by supposition, and the other containments hold since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is an ideal). Thus their join is contained in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                      %mo ⊆
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \top \subseteq M
          %p
            That every ideal is contained in a prime ideal is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/prime+ideal+theorem"} prime ideal theorem
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideal+theorem"} maximal ideal theorem
