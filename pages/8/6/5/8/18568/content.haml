                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \rho(g)\colon \mathcal{C} \to \mathcal{C}
            %li
              natural isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
