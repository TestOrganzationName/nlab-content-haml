                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Vec
                    %mi G
                %annotation{:encoding => "application/x-tex"} \operatorname{Vec}_G
            for finite groups.
          %h2#detailed_definitions Detailed definitions
          %p
