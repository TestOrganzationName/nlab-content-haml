                    %mi X
                  %annotation{:encoding => "application/x-tex"} \rho^0_X\colon X \to \rho(1)X
            %li satisfying certain obvious coherence axioms
          %h3#equivariantisation Equivariantisation
          %p
            %strong Definition
            A
            %em
