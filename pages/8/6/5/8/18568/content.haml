              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a finite group. Denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi G
                    %mo ̲
                %annotation{:encoding => "application/x-tex"} \underline{G}
            the corresponding discrete monoidal category, and by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Rep
                    %mi G
                %annotation{:encoding => "application/x-tex"} \operatorname{Rep}_G
            its finite dimensional
            = succeed "-representations." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo −
                  %mi ℳ𝒪𝒟
