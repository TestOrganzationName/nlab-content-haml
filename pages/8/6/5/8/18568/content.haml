                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{G}
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
