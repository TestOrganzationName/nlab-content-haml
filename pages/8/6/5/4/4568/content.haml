                    \\array{
                    \\mathcal{D}\left(
                    \\prod_{s \in S} D_s^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)},
                    \\prod_{s \in S} D_s^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)}\right)
                    \&amp;\overset{\epsilon }{\to}&amp;
                    \\mathcal{D}\left( \prod_{s \in S} D_s^{X_s},
                    \\prod_{s \in S} D_s^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)}\right)
                    \&amp; \cong &amp;
                    \\prod_{s \in S} \mathcal{D}\left( \prod_{s'' \in S} D_{s''}^{X_{s''}},
                    D_s\right)^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)} \\
                    \\downarrow &amp; &amp; \downarrow &amp; &amp; \downarrow \\
                    \\mathcal{D}\left(
                    \\prod_{s \in S} D_s^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)}, \prod_{s \in S} D_s^{X_s}\right)
                    \&amp;\overset{\epsilon }{\to}&amp;
                    \\mathcal{D}\left( \prod_{s \in S} D_s^{X_s},  \prod_{s \in S} D_s^{X_s}\right)
                    \&amp; \cong &amp;
                    \\prod_{s \in S}\mathcal{D}\left( \prod_{s'' \in S} D_{s''}^{X_{s''}}, D_s\right)^{X_s}
                    }
            %p
              In this diagram, we have left off the subscript on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              for conciseness. The vertical morphism is that induced by the projection from
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:prod"} (2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              in the top-right. That element can be written
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                    %annotation{:encoding => "application/x-tex"} (f)_f
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi s
                          %mo ,
                          %mi x
                    %annotation{:encoding => "application/x-tex"} p_{s,x}
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s,x)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi s
                          %mo ,
                          %mi x
                    %annotation{:encoding => "application/x-tex"} p_{s,x}
            %p Now let us turn to the other half. We need to consider the composition:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mover
                      %mo →
                      %mrow
                        %mi η
                        %mi U
                    %mi U
                    %mi F
                    %mi U
                    %mover
                      %mo →
                      %mrow
                        %mi U
                        %mi ϵ
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    U \overset{\eta U}{\to} U F U \overset{U \epsilon}{\to} U
            %p
              So we need to start with a covariant product-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V \colon \mathcal{D} \to Set
              and apply
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi s
                    %mo ↦
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(s \mapsto V(D_s)\big)
            %p
              to itself. So we pick
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 0
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s_0 \in S
              and look at the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi D
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                      %mo )
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(D_{s_0}) \to \mathcal{D}\left(\prod_{s \in S} D_s^{V(D_s)}, D_{s_0}\right) \to V(D_{s_0}).
            %p
              We start with the function defined by the unit
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi D
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    V(D_{s_0}) \to \mathcal{D}\left(\prod_{s \in S} D_s^{V(D_s)}, D_{s_0}\right)
            %p
              which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in V(D_{s_0})
              to the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msubsup
                      %mi D
                      %mi s
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mi s
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} \prod_{s \in S} D_s^{V(D_s)} \to D_{s_0}
              which corresponds to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} s_0
            %p
              Now we apply
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                    %mo →
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}\left(\prod_{s \in S} D_s^{V(D_s)}, - \right) \to V(-)
            %p
              which we evaluate at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} D_{s_0}
              (technically, which we evaluate at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ↦
                    %msub
                      %mi D
                      %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s \mapsto D_s)
              which we then evaluate at
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} s_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"} V\left(\prod_{s \in S} D_s^{V(D_s)}\right)
              and the element that we want is the image of that element under the function induced by the projection:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mover
                      %mo →
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mrow
                            %msub
                              %mi s
                              %mn 0
                            %mo ,
                            %mi v
                        %mo{:stretchy => "false"} )
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V\left(\prod_{s \in S} D_s^{V(D_s)}\right) \overset{V(p_{s_0,v})}{\to} V(D_{s_0})
            %p
              As
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is product-preserving, we can rearrange this to:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mi s
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mrow
                            %msub
                              %mi s
                              %mn 0
                            %mo ,
                            %mi v
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{s \in S} V(D_s)^{V(D_s)} \overset{p_{s_0,v}}{\to} V(D_{s_0}).
            %p
              The projection selects the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 0
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s_0,v)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(D_{s_0})
              is the identity and the adjunction is shown.
