                          %mo )
                      %annotation{:encoding => "application/x-tex"} V_1\left( \prod_{s \in S} D_s^{X_s}\right)
                %foreignobject#svg_37480_2{"font-size" => "16", :height => "30", :width => "110", :x => "370", :y => "48"}
                  %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 2
                        %mrow
                          %mo (
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi s
                              %mo ∈
