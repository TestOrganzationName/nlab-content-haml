                            %mi s
                    %annotation{:encoding => "application/x-tex"} \prod_{s \in S} \alpha_{D_s}^{X_s}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ∈
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} D \in \mathcal{D}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is completely determined by the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
