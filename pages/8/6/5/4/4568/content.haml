                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi X
                          %mi s
                  %annotation{:encoding => "application/x-tex"} \prod_{s \in S} V_1(D_s)^{X_s} \to   \prod_{s \in S} V_2(D_s)^{X_s}
              making the diagram commute. This morphism is normally written
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
