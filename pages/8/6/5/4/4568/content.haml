                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [V_1,V_2]
              is a subset of a set and thus a set.
          %p
            Now that we have a locally small category, the next step is to show that the forgetful functor has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %em define
            this forgetful functor. As we are in the most general case, the forgetful functor does not go to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            but to
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/graded+set"} graded set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a choice of set of sorts for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %em sorting
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} S \to \mathcal{D}
            is injective on isomorphism classes so that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ≠
                  %mi s
                  %mo ′
                %annotation{:encoding => "application/x-tex"} s \ne s'
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi s
                  %mo ≇
                  %msub
                    %mi D
                    %mrow
                      %mi s
                      %mo ′
                %annotation{:encoding => "application/x-tex"} D_s \ncong D_{s'}
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} [
                  %mi 𝒟
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msup
                    %mi Set
                    %mi S
                %annotation{:encoding => "application/x-tex"} Prod[\mathcal{D},Set] \to Set^S
            is the evaluation functor:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ↦
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi s
                  %mo ↦
                  %mi V
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi D
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi α
                  %mo ↦
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi s
                  %mo ↦
                  %msub
                    %mi α
                    %mrow
                      %msub
                        %mi D
                        %mi s
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V \mapsto \big(s \mapsto V(D_s)\big), \qquad \alpha \mapsto \big(s \mapsto \alpha_{D_s}\big).
          #ProdFree.num_lemma
            %h6#lemma_2 Lemma
            %p
              The forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prod
                    %mo{:stretchy => "false"} [
                    %mi 𝒟
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi Set
                      %mi S
                  %annotation{:encoding => "application/x-tex"} Prod[\mathcal{D},Set] \to Set^S
              has a left adjoint. The left adjoint is given on objects by:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi s
                    %mo ↦
                    %msub
                      %mi X
                      %mi s
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ↦
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(s \mapsto X_s\big) \mapsto \mathcal{D}\left(\prod_{s \in S} D_s^{X_s}, -\right)
          .proof{:style => "margin-left:2em;"}
            %h6#proof_2 Proof
            %p
              To ease the notation, let us write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              for the forgetful (“underlying set(s)”) functor and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              for the free functor.
            %p To show the adjunction, we define the unit and counit natural transformations:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi U
                    %mi F
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mi U
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \colon I \to U F, \qquad \epsilon \colon F U \to I
            %p
              Let us consider
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \eta_X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 0
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} s_0 \in S
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi X
                        %mo ,
                        %msub
                          %mi s
                          %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo →
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %msub
                        %mi D
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                      %mo )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{X,s_0} \colon  X_{s_0} \to \mathcal{D}\left(\prod_{s \in S} D_s^{X_s}, D_{s_0}\right).
            %p
              This is simple to describe: it is assignment to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                  %annotation{:encoding => "application/x-tex"} x \in X_{s_0}
              of the projection onto the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "-factor:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} D_{s_0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msubsup
                      %mi D
                      %mi s
                      %mrow
                        %msub
                          %mi X
                          %mi s
                    %mo →
                    %msubsup
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %msub
                              %mi s
                              %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi x
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{s \in S} D_s^{X_s} \to D_{s_0}^{X_{s_0}} \overset{p_x}{\to} D_{s_0}.
            %p
              The counit,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V \colon \mathcal{D} \to Set
              be a covariant product-preserving functor. Evaluated at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \epsilon_V
              is a natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}\left(\prod_{s \in S} D_s^{V(D_s)}, -\right) \to V
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mrow
                        %mo (
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %msubsup
                          %mi D
                          %mi s
                          %mrow
                            %mi V
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi D
                              %mi s
                            %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} V\left(\prod_{s \in S} D_s^{V(D_s)}\right)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is product-preserving, there is a natural isomorphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mi s
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo ≅
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mi s
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V\left(\prod_{s \in S} D_s^{V(D_s)}\right) \cong \prod_{s \in S} V(D_s)^{V(D_s)}
            %p
              Now for any set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Z
                        %mi Z
                    %annotation{:encoding => "application/x-tex"} Z^Z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              in the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo →
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z \to Z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi s
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi D
                          %mi s
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{s \in S} V(D_s)^{V(D_s)}
              which we use to define
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \epsilon_V
            %p Let us now prove that these provide the desired adjunction. For one half, we need to consider the composition:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo →
                      %mrow
                        %mi F
                        %mi η
                    %mi F
                    %mi U
                    %mi F
                    %mover
                      %mo →
                      %mrow
                        %mi ϵ
                        %mi F
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    F \overset{F \eta}{\to} F U F \overset{\epsilon F}{\to} F
            %p
              Let us apply this to a graded set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ↦
                      %msub
                        %mi X
                        %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = (s \mapsto X_s)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}\left(\prod_{s \in S} D_s^{X_s}, -\right)
            %p to itself. By the standard Yoneda argument, it is sufficient to look at the induced function on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}\left(\prod_{s \in S} D_s^{X_s}, \prod_{s \in S} D_s^{X_s}\right)
            %p and in particular at the image of the identity therein.
            %p
              The first part comes from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi η
                  %annotation{:encoding => "application/x-tex"} F\eta
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(X)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 0
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} s_0 \in S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi X
                        %mo ,
                        %msub
                          %mi s
                          %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                    %mo →
                    %mi 𝒟
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %msub
                        %mi D
                        %mrow
                          %msub
                            %mi s
                            %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \eta_{X,s_0} \colon X_{s_0} \to \mathcal{D}\left(\prod_{s \in S} D_s^{X_s}, D_{s_0}\right)
              and thus a morphism
            #eq:prod.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msubsup
                      %mi D
                      %mi s
                      %mrow
                        %mi 𝒟
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi s
                              %mo ′
                              %mo ∈
                              %mi S
                          %msubsup
                            %mi D
                            %mrow
                              %mi s
                              %mo ′
                            %mrow
                              %msub
                                %mi X
                                %mrow
                                  %mi s
                                  %mo ′
                          %mo ,
                          %msub
                            %mi D
                            %mi s
                          %mo )
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %msubsup
                      %mi D
                      %mi s
                      %mrow
                        %msub
                          %mi X
                          %mi s
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{s \in S} D_s^{\mathcal{D}\left(\prod_{s' \in S} D_{s'}^{X_{s'}},D_s\right)}  \to \prod_{s \in S} D_s^{X_s}
            %p
              What this does is the following: it sends component corresponding to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (s,x)
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo ,
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %msub
                            %mi X
                            %mi s
                      %mo )
                    %mo →
                    %mi 𝒟
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msubsup
                        %mi D
                        %mi s
                        %mrow
                          %mi 𝒟
                          %mrow
                            %mo (
                            %munder
