            %p This shows that the Jacobi identity holds up to an “exact” term, hence up to homotopy.
          #LInfinityTruncation.num_prop
            %h6#proposition_4 Proposition
            %p
              On connective
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (“
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"}> 0-truncation
              ”) to plain
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mn 0
                    %mo ≔
                    %msup
                      %mi H
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi L
                      %mn ∞
                    %msub
                      %mi Alg
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ⟶
                    %mi LieAlg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_0 \coloneqq H^0 \colon L_\infty Alg_{\geq 0} \longrightarrow LieAlg
                    \\,.
          %h4#higher_poisson_brackets_and_higher_heisenberg_algebra Higher Poisson brackets and higher Heisenberg algebra
          %p
            In the discussion
            %a{:href => "PoissonBracketHeisenbergAlgebraInfinitesimalQuantomorphisms"} above
            we amplified that the definition of the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            of a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            has an immediate generalization to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+forms"} presymplectic forms
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential (p+2)-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mi p
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{p+2}(X)
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p \gt 0
          %p
            Indeed, the natural algebraic form of definition
            %a.maruku-ref{:href => "#HamiltonianVectorField"}
            of Hamiltonian vector fields makes immediate sense for higher
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            now being
            = succeed "-forms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.maruku-ref{:href => "#PoissonBracket"}
            makes immediate sense as a bilinear pairing for any
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 2
                  %mo ,
                  %msub
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %msub
                    %mi v
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi ι
                    %mrow
                      %msub
                        %mi v
                        %mn 2
                  %msub
                    %mi ι
                    %mrow
                      %msub
                        %mi v
                        %mn 1
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [(v_1, H_1), (v_2, H_2)]
                  \\coloneqq
                  ([v_1,v_2], \iota_{v_2} \iota_{v_1} \omega)
                  \\,.
          %p
            However, one finds that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} p \gt 0
            then this bracket does not satisfy the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            or
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            this suggests that the bracket might still give a Lie algebra upto higher
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            homotopy, called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/strong+homotopy+Lie+algebra"} strong homotopy Lie algebra
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            = succeed ")." do
              %a{:href => "#Rogers10"} Rogers 10
          #PrenplecticManifold.num_defn
            %h6#definition_6 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %em
                %a.existingWikiWord{:href => "/nlab/show/pre-n-plectic+manifold"} pre-(p+1)-plectic manifold
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a closed degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{p+2}(X)
            %p
              This is called an
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+manifold"} (p+1)-plectic manifold
              if the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the contraction map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{(-)} \colon Vect(X) \longrightarrow \Omega^{p+1}(X)
            %p is trivial.
          #HamiltonianFormsAndVectorFields.num_defn
            %h6#definition_7 Definition
            %p
              Given a pre-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              \-plectic manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              = succeed "," do
                %a.maruku-ref{:href => "#PrenplecticManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ham
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi Ω
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ham^{p}(X) \subset Vect(X) \oplus \Omega^{p}(X)
            %p
              for the subspace of the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential p-forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo +
                    %mi d
                    %mi J
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v  \omega + d J = 0
                    \\,.
            %p
              We call these the
              = succeed "." do
                %em
                  pairs of
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+forms"} Hamiltonian forms
                  with their
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
          #PoissonBracketLienAlgebra.num_defn
            %h6#definition_8 Definition
            %p
              Given a pre-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              \-plectic manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              = succeed "," do
                %a.maruku-ref{:href => "#PrenplecticManifold"}
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔭𝔬𝔦𝔰𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega)
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+%28p%2B1%29-algebra"} Poisson bracket Lie (p+1)-algebra
              as follows.
            %p
              The underlying
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              is the truncated
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
              ending in Hamiltonian forms as in def.
              = succeed ":" do
                %a.maruku-ref{:href => "#HamiltonianFormsAndVectorFields"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi d
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
