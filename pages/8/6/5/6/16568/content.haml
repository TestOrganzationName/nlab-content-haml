          .proof
            %h6#proof_4 Proof
            %p
              Repeatedly apply
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
