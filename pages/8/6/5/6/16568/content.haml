                        %mo +
                        %mover
                          %mi α
                          %mo ¯
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi ℒ
                          %mi v
                        %mover
                          %mi η
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} [v+ \overline{\alpha}, \overline{\eta}] = - [\overline{\eta}, v + \overline{\alpha}] = \mathcal{L}_v \overline{\eta}
                  \.
          %p
            (
            %a{:href => "#FRS13b"}> FRS 13b, def./prop. 4.2.1
            )
          %p
            One then finds a direct higher analog of corollary
            %a.maruku-ref{:href => "#EquivalenceBetweenPoissonBracketAndInfinQuantomorphism"}
            (its proof however is requires a bit more work):
          #ComparisonTheorem.num_prop
            %h6#proposition_6 Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-%E2%88%9E+algebras"} homotopy theory of L-∞ algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi 𝔮𝔲𝔞𝔫𝔱𝔪𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi θ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f
                    \\colon
                    \\mathfrak{poiss}(X,\omega)
                    \\stackrel{\simeq}{\longrightarrow}
                    \\mathfrak{quantmorph}(X,\overline{\theta})
            %p
              between the
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.maruku-ref{:href => "#PoissonBracketLienAlgebra"}
              and def.
              %a.maruku-ref{:href => "#PoissondgAlgebra"}
              (in particular def.
              %a.maruku-ref{:href => "#PoissondgAlgebra"}
              does not depend on the choice of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{A}
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              satisfies
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo +
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 0
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
