                          %mi i
                      %mo −
                      %mi J
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi 𝒰
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(v + J) = (v,\; \sum_{i = 0}^n (-1)^i \iota_v \theta^{n-i} - J|_{\mathcal{U}})
                \.
          %p
            (
            %a{:href => "#FRS13b"}> FRS 13b, theorem 4.2.2
            )
          #ComparisonTheorem.num_prop
            %h6#proposition_7 Proposition
            %p
              Proposition
              %a.maruku-ref{:href => "#ComparisonTheorem"}
              says that all the higher Poisson
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligen cocycles
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantizing
              the give pre-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              \-plectic form, higher “
              %a.existingWikiWord{:href => "/nlab/show/quantomorphisms"}> quantomorphisms
              ”.
            %p
              In fact the
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
