                          %mi j
                        %mo =
                        %msub
                          %mi θ
                          %mi i
                        %mo +
                        %mi d
                        %mi log
                        %msub
                          %mi g
                          %mi ij
                      %annotation{:encoding => "application/x-tex"} \theta_j = \theta_i + d log g_{ij}
                  on all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                        %annotation{:encoding => "application/x-tex"} U_{i j}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
                  on all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                        %annotation{:encoding => "application/x-tex"} U_{i j k}
            %p
              The
              %em quantomorphism Lie algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi θ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\theta}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔮𝔲𝔞𝔫𝔱𝔪𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi θ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi α
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℒ
                        %mi v
                      %mi log
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo =
                      %msub
                        %mi α
                        %mi j
                      %mo −
                      %msub
                        %mi α
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %msub
                        %mi ℒ
                        %mi v
                      %msub
                        %mi θ
                        %mi i
                      %mo =
                      %mi d
                      %msub
                        %mi α
                        %mi i
                      %mo }
                    %mo ⊂
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mi i
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{quantmorph}(X,\overline{\theta})
                    \=
                    \\left\{
                    (v, \{\alpha_i\})
                    |
                    \\mathcal{L}_v log g_{i j} = \alpha_j - \alpha_i
                    \\,,
                    \\mathcal{L}_v \theta_i = d \alpha_i
                    \\right\}
                    \\subset
                    Vect(X) \oplus \left(\underset{i}{\bigoplus} C^\infty(U_i)\right)
            %p with bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo −
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(v_1, \{(\alpha_1)_i\}), (v_2, \{(\alpha_2)_i\})]
                    \\coloneqq
                    ([v_1,v_2], \{\mathcal{L}_{v_1}(\alpha_2)_i - \mathcal{L}_{v_2} (\alpha_1)_i\})
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi θ
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\{U_i\},\{g_{i j}, \theta_i\})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              = succeed "," do
                %a.maruku-ref{:href => "#CechDelignePrequantizationAnditsInfinitesimalAutomorpisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi θ
                      %mi i
                    %mo −
                    %mi H
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (v,H) \mapsto (v,  \{\iota_v \theta_i - H|_{U_i}\})
            %p
              constitutes an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi 𝔮𝔲𝔞𝔫𝔱𝔪𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi θ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{poiss}(X,\omega)
                    \\stackrel{\simeq}{\longrightarrow}
                    \\mathfrak{quantmorph}(X,\overline{\theta})
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              algebra of def.
              %a.maruku-ref{:href => "#PoissonBracket"}
              and that of infinitesimal quantomorphisms, def.
              = succeed "." do
                %a.maruku-ref{:href => "#CechDelignePrequantizationAnditsInfinitesimalAutomorpisms"}
          .proof
            %h6#proof_2 Proof
            %p
              The condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mi log
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mi α
                      %mi j
                    %mo −
                    %msub
                      %mi α
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_v log g_{i j} = \alpha_j - \alpha_i
              on the infinitesimal quantomorphisms, together with the Cech-Deligne cocycle condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi log
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mi θ
                      %mi j
                    %mo −
                    %msub
                      %mi θ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d log g_{i j} = \theta_j - \theta_i
              says that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} U_{i j}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi θ
                      %mi j
                    %mo −
                    %msub
                      %mi α
                      %mi j
                    %mo =
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi θ
                      %mi i
                    %mo −
                    %msub
                      %mi α
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v \theta_j - \alpha_j = \iota_v \theta_i - \alpha_i
            %p
              and hence that there is a globally defined function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in C^\infty(X)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi v
                      %msub
                        %mi θ
                        %mi i
                      %mo −
                      %msub
                        %mi α
                        %mi i
                      %mo =
                      %mi H
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mi i
                    %annotation{:encoding => "application/x-tex"} \iota_v \theta_i - \alpha_i = H|_{U_i}
            %p
              Now over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              the the situation for the brackets is just that of corollary
              %a.maruku-ref{:href => "#EquivalenceBetweenPoissonBracketAndInfinQuantomorphism"}
              implied by
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:EquationForLieHomomorphism"} (1)
          %h4#the_kostantsouriau_extension The Kostant-Souriau extension
          %p The following fact is immediate, but important.
          #KostantSouriauExtension.num_prop
            %h6#proposition_3 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔭𝔬𝔦𝔰𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega)
              = succeed "," do
                %a.maruku-ref{:href => "#PoissonBracket"}
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
              of the algebra of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              = succeed "," do
                %a.maruku-ref{:href => "#HamiltonianVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
              group of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi HamVect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to
                    H^0(X)
                    \\stackrel{}{\longrightarrow}
                    \\mathfrak{poiss}(X,\omega)
                    \\stackrel{}{\longrightarrow}
                    HamVect(X,\omega)
                    \\to
                    0
                    \\,.
            %p
              Hence when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega)
              is an
              = succeed "-extension" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℝ
                    %mover
                      %mo ⟶
                      %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %mi HamVect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to
                    \\mathbb{R}
                    \\stackrel{}{\longrightarrow}
                    \\mathfrak{poiss}(X,\omega)
                    \\stackrel{}{\longrightarrow}
                    HamVect(X,\omega)
                    \\to
                    0
                    \\,.
            %p
              Moreover, given any choice of
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splitting
              of the underlying short exact sequence of
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔭𝔬𝔦𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ≃
                        %mi vs
                      %mi HamVect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %msup
                        %mi H
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{pois}(X,\omega) \simeq_{vs} HamVect(X,\omega)\oplus H^0(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi v
                  %annotation{:encoding => "application/x-tex"} H_v
              for each Hamiltonian vector field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              2-
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              which classifies this extension is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ω
                    %mo −
                    %msub
                      %mi H
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (v_1, v_2) = \iota_{v_2}\iota_{v_1}\omega - H_{[v_1,v_2]}
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi HamVect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega) \to HamVect(X,\omega)
              is on elements given just by projection onto the direct summand of vector fields, taking a Hamiltonian pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v,H)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi HamVect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HamVect(X,\omega)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HamVect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HamVect(X,\omega)
              is the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of this map regarded as a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔭𝔬𝔦𝔰𝔰
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Vect
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{poiss}(X,\omega) \longrightarrow Vect(X)
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of this projection is manifestly the space of Hamiltonian pairs of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo =
                      %mn 0
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (v = 0,H)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo =
                    %mi d
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \iota_v \omega = d H
              these are precisely the pairs for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi H
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d H = 0
            %p
              Generally, given a Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              and an
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mu_2
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
              that it classifies is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo =
                      %mi vs
                    %mi 𝔤
                    %mo ⊕
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \hat \mathfrak{g} =_{vs} \mathfrak{g}\oplus \mathbb{R}
              with bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi μ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(x_1,a_1), (x_2,x_2)] = ([x_1,x_2], \mu_2(a_1,a_2))
                    \\,.
            %p
              Applied to the case at hand, given a choice of splitting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %msub
                      %mi H
                      %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v\mapsto (v,H_v)
              this yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mo +
                    %msub
                      %mi a
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi H
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi H
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                    %mo +
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ω
                    %mo −
                    %msub
                      %mi H
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(v_1,H_{v_1} + a_1), (v_2, H_{v_2} + a_2) ]
                    \=
                    ([v_1,v_2], H_{[v_1,v_2]} + \iota_{v_2}\iota_{v_1}\omega - H_{[v_1,v_2]})
                    \=
                    ([v_1,v_2], \iota_{v_2}\iota_{v_1}\omega )
                    \\,.
          .num_example
            %h6#example_3 Example
            %p
              Consider again example
              %a.maruku-ref{:href => "#HeisenbergAlgebraOfSymplecticVectorSpace"}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %mi d
                    %msub
                      %mi p
                      %mi i
                    %mo ∧
                    %mi d
                    %msup
                      %mi q
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega) = (\mathbb{R}^{2n}, d p_i \wedge d q^i)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              and where we restrict along the inclusion of the translation vector fields to get the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+algebra"} Heisenberg algebra
              %a.maruku-ref{:href => "#KostantSouriauExtension"}
              also pulls back:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msubsup
                              %mi H
                              %mi dR
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi 𝔥𝔢𝔦𝔰
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi 𝔭𝔬𝔦𝔰𝔰
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %mn 2
                                %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi HamVect
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H_{dR}^0(X) &amp;\longrightarrow&amp; H_{dR}^0(X)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathfrak{heis}(X,\omega) &amp;\longrightarrow&amp; \mathfrak{poiss}(X,\omega)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbb{R}^{2 n}
                    \&amp;\longrightarrow&amp;
                    HamVect(X,\omega)
                    }
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
              2-
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              which classifiesthe Kostant-Souriau extension,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \iota_{(-)}\iota_{(-)}\omega
              manifestly restricts to the Heisenberg cocycle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi q
                        %mi i
                      %mo ,
                      %msub
                        %mi p
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mi δ
                        %mi j
                        %mi i
                    %annotation{:encoding => "application/x-tex"} (q^i, p_j) = \delta^i_j
          %h4#interlude_algebras
            Interlude:
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            Recall the definition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                  %mo ∈
                  %msub
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} v_i \in V_{\vert v_i\vert}
            homogenously graded elements, and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            a
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %msub
                    %mi v
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \chi(\sigma, v_1, \cdots, v_n)\in \{-1,+1\}
            for the product of the
            %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
            with a factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi v
                        %mi j
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} (-1)^{\vert v_i \vert \vert v_j \vert}
            for each interchange of neighbours
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ⋯
                  %msub
                    %mi v
                    %mi i
                  %mo ,
                  %msub
                    %mi v
                    %mi j
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\cdots v_i,v_j, \cdots )
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ⋯
                  %msub
                    %mi v
                    %mi j
                  %mo ,
                  %msub
                    %mi v
                    %mi i
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\cdots v_j,v_i, \cdots )
            involved in the permutation.
          #LInfinityDefinitionViaGeneralizedJacobiIdentity.num_defn
            %h6#definition_5 Definition
            %p
              An
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear map
                  called the
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-ary bracket
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi V
                          %mrow
                            %mo ∧
                            %mi n
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} l_n(\cdots) \coloneqq [-,-, \cdots, -] \colon V^{\wedge n} \to V
                %p
                  of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n-2
            %p such that
            %ol
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                      %annotation{:encoding => "application/x-tex"} l_n
                  is graded antisymmetric, in that for every
                  %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  and homogeneously graded elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                        %mo ∈
                        %msub
                          %mi V
                          %mrow
                            %mo{:stretchy => "false"} |
                            %msub
                              %mi v
                              %mi i
                            %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} v_i \in V_{\vert v_i \vert}
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %msub
                          %mi l
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %mi ⋯
                        %msub
                          %mi v
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        l_n(v_{\sigma(1)}, v_{\sigma(2)},\cdots ,v_{\sigma(n)})
                        \=
                        \\chi(\sigma,v_1,\cdots, v_n) \cdot l_n(v_1, v_2, \cdots v_n)
              %li
                %p
                  the
                  %em
                    generalized
                    %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  holds:
                #eq:LInfinityJacobiIdentity.maruku-equation
                  %span.maruku-eq-number (2)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo +
                            %mi j
                            %mo =
                            %mi n
                            %mo +
                            %mn 1
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi σ
                            %mo ∈
                            %mi UnShuff
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo ,
                            %mi n
                            %mo −
                            %mi i
                            %mo{:stretchy => "false"} )
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi m
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi l
                          %mi j
                        %mrow
                          %mo (
                          %msub
                            %mi l
                            %mi i
                          %mrow
                            %mo (
                            %msub
                              %mi v
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi v
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mo{:stretchy => "false"} )
                            %mo )
                          %mo ,
                          %msub
                            %mi v
                            %mrow
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi v
                            %mrow
                              %mi σ
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                          %mo )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\sum_{i+j = n+1}
                        \\sum_{\sigma \in UnShuff(i,n-i)}
                        \\chi(\sigma,v_1, \cdots, v_m)
                        (-1)^{i(j-1)}
                        l_{j} \left(
                        l_i \left( v_{\sigma(1)}, \cdots, v_{\sigma(i)} \right),
                        v_{\sigma(i+1)} , \cdots , v_{\sigma(n)}
                        \\right)
                        \= 0
                        \\,,
                %p
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi i
                        %mo ∈
                        %msub
                          %mi V
                          %mi i
                      %annotation{:encoding => "application/x-tex"} v_i \in V_i
                  (here the inner sum runs over all
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (i,j)
                  %a.existingWikiWord{:href => "/nlab/show/unshuffles"} unshuffles
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                        %annotation{:encoding => "application/x-tex"} \sigma
          %p There are various different conventions on the gradings possible, which lead to similar formulas with different signs.
          .num_example
            %h6#example_4 Example
            %p In lowest degrees the generalized Jacobi identity says that
            %ol
              %li
                %p
                  for
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo ≔
                        %msub
                          %mi l
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \partial \coloneqq l_1
                  squares to 0:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\partial (\partial(v_1)) = 0
            %p
              1: for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n = 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              is a graded
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              of the binary map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mo ∂
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} [
                    %mo ∂
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo ∂
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \- [\partial v_1, v_2]
                    \- (-1)^{\vert v_1 \vert \vert v_2 \vert}
                    [\partial v_2, v_1]
                    +
                    \\partial [v_1, v_2]
                    \=
                    0
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo ∂
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo ∂
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial [v_1, v_2] =  [\partial v_1, v_2] + (-1)^{\vert v_1 \vert}[v_1, \partial v_2]
                    \\,.
          .num_example
            %h6#example_5 Example
            %p
              When all higher brackets vanish,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mrow
                        %mi k
                        %mo &gt;
                        %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} l_{k \gt 2}= 0
              then for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n = 3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    [[v_1,v_2],v_3]
                    +
                    (-1)^{\vert v_1 \vert (\vert v_2 \vert + \vert v_3 \vert)}
                    [[v_2,v_3],v_1]
                    +
                    (-1)^{\vert v_2 \vert (\vert v_1 \vert + \vert v_3 \vert)}
                    [[v_1,v_3],v_2]
                    \=
                    0
            %p
              this is the graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
          .num_example
            %h6#example_6 Example
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} l_3
              is possibly non-vanishing, then on elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo =
                    %msub
                      %mi l
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \partial = l_1
              vanishes then the generalized Jacobi identity for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
