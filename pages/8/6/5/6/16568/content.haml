                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
