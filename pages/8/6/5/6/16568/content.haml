                        %mi d
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Ham
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^0(X)
                    \\stackrel{d}{\to}
                    \\Omega^1(X)
                    \\stackrel{d}{\to}
                    \\cdots
                    \\stackrel{d}{\to}
                    \\Omega^{p-1}(X)
                    \\stackrel{(0,d)}{\longrightarrow}
                    Ham^{p}(X)
            %p
              with the Hamiltonian pairs, def.
              = succeed "," do
                %a.maruku-ref{:href => "#HamiltonianFormsAndVectorFields"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              The non-vanishing
              = succeed "-brackets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi d
                        %mi J
                      %annotation{:encoding => "application/x-tex"} l_1(J) = d J
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi l
                          %mrow
                            %mi k
                            %mo ≥
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 1
                        %mo +
                        %msub
                          %mi J
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi v
                          %mi k
                        %mo +
                        %msub
                          %mi J
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                              %mrow
                                %mn 2
                            %mo )
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi v
                              %mi k
                        %mi ⋯
                        %msub
                          %mi ι
                          %mrow
                            %msub
                              %mi v
                              %mn 1
                        %mi ω
                      %annotation{:encoding => "application/x-tex"}
                        l_{k \geq 2}(v_1 + J_1, \cdots, v_k + J_k)
                        \\coloneqq
                        \- (-1)^{\left(k+1 \atop 2\right)} \iota_{v_k}\cdots \iota_{v_1}\omega
                  \.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Definition
              %a.maruku-ref{:href => "#PoissonBracketLienAlgebra"}
              indeed gives an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              in that the higher
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              is satisfied.
            #eq:LInfinityJacobiIdentity.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
