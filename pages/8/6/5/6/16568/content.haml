                      %mi v
                    %mi θ
                    %mo −
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (v,H) \mapsto (v, \iota_v \theta - H)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔭𝔬𝔦𝔰𝔰
                    %mo{:stretchy => "false"} (
