                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{Heis}_G(X,\nabla) \coloneqq \rho^\ast \mathbf{QuantMorph}(X,\nabla)
                        \\,.
          .num_example
            %h6#example_10 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SmoothMfd
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in SmoothMfd \hookrightarrow \mathbf{H}
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{QuantMorph}(X,\nabla)
              is Souriau’s
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              covering the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+diffeomorphism"} Hamiltonian diffeomorphism
              group. In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, F_\nabla)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi V
                  %annotation{:encoding => "application/x-tex"} X = V
              regarded as a linear symplectic manifold with Hamiltonian action on itself by translation, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Heis
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Heis}_{V}(X,\nabla)
              is the traditional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
          .num_remark
            %h6#remark_5 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi HamSymp
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{HamSymp}(X,\nabla)\hookrightarrow \mathbf{Aut}(X)
              is by construction a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \longrightarrow \mathbf{Aut}(X)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ρ
