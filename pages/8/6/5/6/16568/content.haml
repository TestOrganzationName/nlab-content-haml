                      %mi ι
                      %mi v
                    %mo ∘
                    %mi d
                    %mo +
                    %mi d
                    %mo ∘
                    %msub
                      %mi ι
                      %mi v
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_v = \iota_v \circ d + d \circ \iota_v
              as well as the consequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
