                            %mi ⋯
                            %mover
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mi v
                                      %mi j
                              %mo ^
                            %mi ⋯
                            %mover
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %msub
                                      %mi v
                                      %mi i
                              %mo ^
                            %mi ⋯
                            %msub
                              %mi ι
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi v
                                  %mi i
                                %mo ,
