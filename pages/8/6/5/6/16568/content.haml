                        %msub
                          %mi v
                          %mn 2
                    %mo −
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %mo ∘
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_{v_1} \circ \iota_{v_2} - \iota_{v_2} \circ \mathcal{L}_{v_1} = \iota_{[v_1,v_2]}
              to find that for all vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i
              and differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              (of any degree, not necessarily closed) one has
            .maruku-equation
