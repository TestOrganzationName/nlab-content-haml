                        %mo +
                        %msub
                          %mover
                            %mi α
                            %mo ¯
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi v
                              %mn 1
                        %msub
                          %mover
                            %mi α
                            %mo ¯
                          %mn 2
                        %mo −
                        %msub
                          %mi ℒ
                          %mrow
                            %msub
                              %mi v
                              %mn 2
                        %msub
                          %mover
                            %mi α
                            %mo ¯
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} [v_1 + \overline{\alpha}_1, v_2 + \overline{\alpha}_2] \coloneqq [v_1, v_2] + \mathcal{L}_{v_1}\overline{\alpha}_2 - \mathcal{L}_{v_2}\overline{\alpha}_1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi v
                        %mo +
                        %mover
                          %mi α
                          %mo ¯
                        %mo ,
                        %mover
                          %mi η
                          %mo ¯
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
