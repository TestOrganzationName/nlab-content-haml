                        %mo ,
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{quantmorph}(X,\overline{\theta})^{i \gt 0} \coloneqq C^{n-1-i}(\mathcal{U},\Omega^\bullet)
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              given by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
