                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi 𝔮𝔲𝔞𝔫𝔱𝔪𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{poiss}(X,\omega)
                    \\stackrel{\simeq}{\longrightarrow}
                    \\mathfrak{quantmorph}(X,\theta)
            %p
              from the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+algebra"} Poisson bracket Lie algebra
              = succeed "." do
                %a.maruku-ref{:href => "#PoissonBracket"}
          %p
            This shows that for exact pre-symplectic forms the Poisson bracket Lie algebra is secretly the Lie algebra of infinitesimal symmetries of any of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prequantizations"} prequantizations
          #CechDelignePrequantizationAnditsInfinitesimalAutomorpisms.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi θ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi θ
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X,\overline{\theta}) \coloneqq (X,\{U_i\},\{g_{i j}, \theta_i\})
            %p
              for a
              %em
                %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo →
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \{U_i \to X\}_i
              %li
                %p
                  1-forms
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi θ
                            %mi i
                          %mo ∈
                          %msup
                            %mi Ω
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \{\theta_i \in \Omega^1(U_i)\}
              %li
                %p
                  smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{g_{i j} \in C^\infty(U_{i j}, U(1))\}
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %msub
                          %mi θ
                          %mi i
                        %mo =
                        %mi ω
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                      %annotation{:encoding => "application/x-tex"} d \theta_i = \omega|_{U_i}
                  on all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
