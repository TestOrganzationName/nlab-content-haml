              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔮𝔲𝔞𝔫𝔱𝔪𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mover
                      %mi θ
                      %mo ¯
                    %mo{:stretchy => "false"} )
