                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi v
                          %mn 1
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} |
