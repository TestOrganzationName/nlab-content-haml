                          %mi t
                          %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mo =
                    %mrow
                      %mo ⟨
                      %msub
                        %mi{:mathvariant => "normal"} d
                        %mrow
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                      %mi α
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi F
                        %mrow
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mo =
                    %mrow
                      %mo ⟨
                      %mi α
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi δ
                        %mrow
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi F
                        %mrow
