          %h2#idea Idea
          %p
            For a
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/scalar"} scalar
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            %a.existingWikiWord{:href => "/nlab/show/curve"} curve
            whose
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            is the negative of its
            %a.existingWikiWord{:href => "/nlab/show/gradient"} gradient
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/gradient+flow"} gradient flow
            %a.existingWikiWord{:href => "/nlab/show/steepest+descent"} steepest descent
            and hence is
            %a.existingWikiWord{:href => "/nlab/show/monotone+function"} monotonically descreasing
            with respect to the scalar function. It is then possible to study its
            %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/critical+points"} critical points
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+minima"} local minima
          %p
            If the scalar function is the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills-Higgs+equations"} Yang-Mills-Higgs
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/gradient+flow"} gradient flow
            is called
            = succeed "." do
              %em Yang-Mills-Higgs flow
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills-Higgs+equations"} Yang-Mills-Higgs equations
            and can be used to find
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills-Higgs+pairs"} Yang-Mills-Higgs pairs
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/critical+points"} critical points
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+Yang-Mills-Higgs+pairs"} stable Yang-Mills-Higgs pairs
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+minima"} local minima
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+flow"} Yang-Mills flow
            is named after
            %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"} Chen Ning Yang
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Robert+Mills"} Robert Mills
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            in 1954, and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Higgs"} Peter Higgs
            %a.existingWikiWord{:href => "/nlab/show/Higgs+field"} Higgs field
            in 1964.
          %h2#basics Basics
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            with
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ↠
                  %mi B
                %annotation{:encoding => "application/x-tex"} E\twoheadrightarrow B
            be a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            %a.existingWikiWord{:href => "/nlab/show/orientable"} orientable
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            having a metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and a
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi vol
                      %mi g
                  %annotation{:encoding => "application/x-tex"} vol_g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi E
                  %msub
                    %mo ×
                    %mi G
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} Ad(E)\coloneqq E\times_G\mathfrak{g}
            be its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+bundle"} adjoint bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Ad
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi Ω
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi Ad
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega_{Ad}^k(E,\mathfrak{g})\cong\Omega^k(B,Ad(E))
            %a.existingWikiWord{:href => "/nlab/show/adjoint+representation"} adjoint representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ad
                %annotation{:encoding => "application/x-tex"} Ad
            invariant Lie-algebra valued or vector bundle valued differential forms. Since the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            = succeed "is" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            as it requires the metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            and the volume form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi vol
                      %mi g
                  %annotation{:encoding => "application/x-tex"} vol_g
          %p
            All spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^k(B,Ad(E))
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            together with the choice of an
            = succeed "-invariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ad
                  %annotation{:encoding => "application/x-tex"} Ad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
