                      %mo →
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} (\alpha,\varphi)\colon\mathbb{R}\supseteq I\rightarrow\mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi YMH
                    %mo ∘
