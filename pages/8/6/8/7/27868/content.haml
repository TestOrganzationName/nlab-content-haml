            %p
          .proof
            %h6 Proof
            %p Using the flow equations yields:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %mfrac
                      %mi{:mathvariant => "normal"} d
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi t
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi F
                      %mrow
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} ‖
