                    %annotation{:encoding => "application/x-tex"} (A,\Phi)\in\mathcal{A}
          .num_lemma
            %h6 Lemma
            %p
              For a Yang-Mills-Higgs flow
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
