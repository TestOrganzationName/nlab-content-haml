                                %mi i
                                %mi k
                            %mo ⋅
                            %msub
                              %mi α
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                          %annotation{:encoding => "application/x-tex"}
                            g_{i j} \dot g_{j k} = g_{i k} \cdot \alpha_{i j k}
                    %p
                      holds, where on the right we are injecting
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi α
                              %mrow
                                %mi i
                                %mi j
                                %mi k
                          %annotation{:encoding => "application/x-tex"} \alpha_{i j k}
                      via
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                          %annotation{:encoding => "application/x-tex"} U(1) \to \hat G
                      into
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                          %annotation{:encoding => "application/x-tex"} \hat G
                      = succeed "and" do
                        %br/
                  %li
                    %p
                      subject to the
                      %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                      that identifies two such collections of cocycle data
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{g_{i j}\}
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
