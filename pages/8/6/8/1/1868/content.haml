                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo ∩
                        %msub
                          %mi U
                          %mi k
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"}
                        \\{ \alpha_{i j k} : U_i \cap U_j \cap U_k \to U(1) \}
                %p satisfying on every quadruple intersection the equation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi α
                          %mrow
                            %mi i
                            %mi j
                            %mi k
                        %msub
                          %mi α
                          %mrow
                            %mi i
                            %mi k
                            %mi l
                        %mo =
                        %msub
                          %mi α
