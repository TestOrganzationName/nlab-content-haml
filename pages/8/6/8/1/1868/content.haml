                        %mi X
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [\alpha] \in H^2_{ETop}(X, U(1))
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
                  representative given by a collection of functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi α
                          %mrow
                            %mi i
                            %mi j
                            %mi k
                        %mo :
                        %msub
                          %mi U
