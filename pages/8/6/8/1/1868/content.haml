                              %mi β
                              %mrow
                                %mi i
                                %mi j
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            g'_{i j} = h_i^{-1} \cdot g_{i j} \cdot h_j \cdot \beta_{i j}
                            \\,.
          .proof
            %h6#proof Proof
            %p
              We pass to the standard
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
              of
              %a.existingWikiWord{:href => "/nlab/show/ETop%E2%88%9EGrpd"} ETop∞Grpd
              by the projective local
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              over the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              by a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              there.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mi c
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\hat G_{c}, \mathbf{B}^2 U(1)_c \in [CartSp^{op}, sSet]
              etc. for the standard models of the abstract objects of these names by simplicial presheaves. Write accordingly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}(U(1) \to \hat G)_c
              for the delooping of the
              %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
              associated to the central extension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi G
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \hat G \to G
            %p
              In terms of this the
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              is represented by the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                          %mtd
                            %mover
                              %mo →
                              %mstyle{:mathvariant => "bold"}
                                %mi c
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                            %mo =
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi G
                              %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}(U(1) \to \hat G)_c &amp;\stackrel{\mathbf{c}}{\to}&amp;
                    \\mathbf{B}(U(1) \to 1)_c
                    \=
                    \\mathbf{B}^2 U(1)_c
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\mathbf{B}G_c
                    }
                    \\,,
            %p
              where the top horizontal morphism is the evident projection onto the
              = succeed "-labels." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              of the good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              forms a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \hookrightarrow C(\{U_i\}) \stackrel{\simeq}{\to} X
            %p
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is presented by an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-anafunctor"} ∞-anafunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi α
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(\{U_i\}) &amp;\stackrel{\alpha}{\to}&amp; \mathbf{B}^2 U(1)_c
                    \\\
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    X
                    }
                    \\,.
            %p
              Using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              this means in conclusion that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              in question is given by the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi H
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi α
                                %mo{:stretchy => "false"} ]
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi α
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi CartSp
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo *
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi CartSp
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi c
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{H}^1_{[\alpha]}(X,\hat G) &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\alpha}}
                    \\\
                    [CartSp^{op}, sSet](C(\{U_i\}), \mathbf{B}(U(1) \to \hat G)_c)
                    \&amp;\stackrel{\mathbf{c}_*}{\to}&amp;
                    [CartSp^{op}, sSet](C(\{U_i\}), \mathbf{B}^2 U(1)_c)
                    }
                    \\,.
            %p
              An object of the resulting simplicial set is then seen to be a simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi c
                  %annotation{:encoding => "application/x-tex"} g : C(\{U_i\}) \to \mathbf{B}(U(1) \to \hat G)_c
              that assigns
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
