                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H^1_{[\alpha]}(X, \hat G)
                  is given by
                  = succeed "es" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                %ol
                  %li
                    %p collections of functions
                    .maruku-equation
