                          %annotation{:encoding => "application/x-tex"}
                            \\beta_{i j} \beta_{j k} = \beta_{i k}
                    %p and
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %msub
                              %mo ′
                              %mrow
                                %mi i
                                %mi j
                            %mo =
                            %msubsup
                              %mi h
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo ⋅
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %mo ⋅
                            %msub
                              %mi h
                              %mi j
                            %mo ⋅
