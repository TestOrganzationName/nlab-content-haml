                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\alpha_{i j k} \alpha_{i k l} = \alpha_{j k l} \alpha_{i j l}
                        \\,.
              %li
                %p
                  I terms of this cocycle data the twisted cohomology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
