                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{g'_{i j}\}
                      if there exists functions
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi h
                              %mi i
                            %mo :
                            %msub
                              %mi U
                              %mi i
                            %mo →
                            %mover
                              %mi G
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"}
                            \\{h_i : U_i \to \hat G\}
                    %p and
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi β
                              %mrow
                                %mi i
                                %mi j
                            %mo :
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                            %mo →
                            %mover
                              %mi U
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"}
                            \\{\beta_{i j} : U_i \cap U_j \to \hat U(1)\}
                    %p such that
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
