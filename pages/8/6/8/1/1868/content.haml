                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1) \to U(n) \to P U(n)
            of the
            %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
            to the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of matrices gives a sum operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
