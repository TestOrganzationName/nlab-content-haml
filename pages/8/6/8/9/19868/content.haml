          %title Initiality Project - Semantics
          %h1#initiality_project__semantics Initiality Project - Semantics
          %p
            This page is part of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Initiality+Project"} Initiality Project
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#basic_definitions"} Basic definitions
              %li
                %a{:href => "#type_structure"} Type structure
              %ul
                %li
                  %a{:href => "#types"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi Π
                        %annotation{:encoding => "application/x-tex"} \Pi
                    \-types
          %h2#idea Idea
          %p
            See
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+model+of+dependent+types"} categorical model of dependent types
          %h2#basic_definitions Basic definitions
          .un_defn
            %h6#definition Definition
            %p
              A (natural-model-style)
              %strong category with families
              (abbreviated
              = succeed ")" do
                %strong CwF
            %ul
              %li
                a (small)
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} 1\in C
              %li
                two
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Tm
                      %mo ,
                      %mi Ty
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Tm,Ty \in [C^{op},Set]
              %li
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi of
                      %mo :
                      %mi Tm
                      %mo →
                      %mi Ty
                    %annotation{:encoding => "application/x-tex"} of:Tm \to Ty
              %li
                An
                %em algebraic representation
                for the map
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi of
                      %annotation{:encoding => "application/x-tex"} of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo :
                        %mi y
                        %mi Γ
                        %mo →
                        %mi Ty
                      %annotation{:encoding => "application/x-tex"} A:y \Gamma \to Ty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \Gamma\in C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                denotes the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo .
                      %mi A
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \Gamma.A\in C
                and a
                %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi y
                                %mo{:stretchy => "false"} (
                                %mi Γ
                                %mo .
                                %mi A
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo →
                              %mtd
                                %mi Tm
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi y
                                %mi Γ
                              %mtd
                                %mover
                                  %mo →
                                  %mi A
                              %mtd
                                %mi Ty
                                %mo .
                      %annotation{:encoding => "application/x-tex"} \array{ y(\Gamma.A) &amp; \to &amp; Tm \\ \downarrow &amp;&amp;\downarrow \\ y\Gamma &amp; \xrightarrow{A} &amp; Ty. }
          %p
            Note that an algebraic representation for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi of
                %annotation{:encoding => "application/x-tex"} of
            can be equivalently expressed as choice of a right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi ext
                %annotation{:encoding => "application/x-tex"} \mathsf{ext}
            for the corresponding functor of
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} categories of elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo{:stretchy => "false"} (
                    %mi Tm
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi el
                    %mo{:stretchy => "false"} (
                    %mi Ty
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} el(Tm) \to el(Ty)
          %p
            We consider categories with families as set-level structures (in particular, as
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/strict+categories"} strict categories
          .un_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              be CwFs. A
              %strong CwF morphism
              is a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} F:C\to D
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op},Set]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Tm
                              %mi C
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi F
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Tm
                              %mi D
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Ty
                              %mi C
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi F
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Ty
                              %mi D
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \array{ Tm_C &amp; \to &amp; F^*(Tm_D) \\ \downarrow &amp; &amp; \downarrow \\ Ty_C &amp; \to &amp; F^*(Ty_D) }
            %p
              such that, for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \Gamma \in C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
