                      %mo +
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbf{R}^+,+)
            %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} complete space
            if and only if every adjunction of bimodules is induced by an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
