                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B O(n)\to \tilde B O(n+1)
          .proof
            %h6#proof_5 Proof
            %p
              Take
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ˜
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde B O(n) \coloneqq (E O(n+1))/O(n)
            %p
              To see that the canonical map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B O(n)\longrightarrow (E O(n+1))/O(n)
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi id
                          %mtd
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    O(n) &amp;\overset{id}{\longrightarrow}&amp; O(n)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    E O(n) &amp;\longrightarrow&amp; E O(n+1)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    B O(n) &amp;\longrightarrow&amp; (E O(n+1))/O(n)
                    }
                    \\,.
            %p
              By
              %a{:href => "coset#ProjectionOfCosetsIsFiberBundleForClosedSubgroupsOfCompactLieGroup"} this prop.
              both bottom vertical maps are
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              and so both vertical sequences are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequences"} fiber sequences
              %a.maruku-ref{:href => "#HomotopyGroupsOfBOnThoseOfOnShifted"}
              part of the induced morphisms of
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+of+homotopy+groups"} long exact sequences of homotopy groups
              looks like this
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo =
                          %mtd
                            %msub
                              %mi π
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\pi_\bullet(B O(n))
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\pi_\bullet( (E O(n+1))/O(n) )
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\pi_{\bullet-1}(O(n))
                    \&amp;\overset{=}{\longrightarrow}&amp;
                    \\pi_{\bullet-1}(O(n))
                    }
                    \\,,
            %p where the vertical and the bottom morphism are isomorphisms. Hence also the to morphisms is an isomorphism.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B O(n)\to \tilde B O(n+1)
              is indeed a
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              follows again with
              = succeed "," do
                %a{:href => "coset#ProjectionOfCosetsIsFiberBundleForClosedSubgroupsOfCompactLieGroup"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    O(n+1)/O(n)
                    \\longrightarrow
                    (E O(n+1))/O(n)
