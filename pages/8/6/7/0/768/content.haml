          %h4#properties Properties
          #CWComplexStructure.num_prop
            %h6#proposition_2 Proposition
            %p
              The real
              %a.existingWikiWord{:href => "/nlab/show/Grassmannians"} Grassmannians
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi n
