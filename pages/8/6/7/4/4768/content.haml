          %h2#idea Idea
          %p
            We give two constructions of the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
          %h2#preparations Preparations
          %p We first need the following preparations:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mathbf{T}
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zigzag+category"} zigzag category
            %em categorical realization
            of a zigzag
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %msub
                    %mi t
                    %mo +
                  %mo ,
                  %msub
                    %mi t
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t=(n,t_+,t_-)
            to be the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [t]
            generated freely by the following
            %a.existingWikiWord{:href => "/nlab/show/quiver"} quiver
            data:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [t]
              has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              vertices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi t
                      %mi n
                  %annotation{:encoding => "application/x-tex"} t_0,...,t_n
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi t
                        %mo +
                    %annotation{:encoding => "application/x-tex"} i\in t_+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi i
                    %mo :
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} g_i:t_{i-1}\to t_i
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi t
                        %mo −
                    %annotation{:encoding => "application/x-tex"} i\in t_-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi i
                    %mo :
                    %msub
                      %mi t
                      %mi i
                    %mo →
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} g_i:t_i\to t_{i-1}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            with class of weak equivalences
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Cat
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Cat}([t],C)
            %em restricted
            = succeed "-zigzags" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi t
                %annotation{:encoding => "application/x-tex"} C^{t}
            to be the subcategory whose objects are zigzags
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that all maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} F(t_i)\to F(t_{i-1})\in W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi t
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^t(X,Y)
            to be the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi t
                %annotation{:encoding => "application/x-tex"} C^t
            spanned by those objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} F(t_0)=X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi n
                    %mo =
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(t_n=Y)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi t
                  %mo →
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f:t\to t'
            be a morphism of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %msup
                    %mi C
                    %mi t
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mrow
                      %mi t
                      %mo ′
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_*:C^t(X,Y)\to C^{t'}(X,Y)
            to be the functor sending a zigzag
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F:[t]\to C
            with connecting maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi i
                %annotation{:encoding => "application/x-tex"} g_i
            lying between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} t_{i-1}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi i
                %annotation{:encoding => "application/x-tex"} t_i
            (not necessarily
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo →
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_{i-1}\to t_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi F
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi t
                  %mo ′
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f_*F:[t']\to C
            with connecting maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi j
                %annotation{:encoding => "application/x-tex"} h_j
            defined to be the ordered composite of the maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mi i
                %annotation{:encoding => "application/x-tex"} g_i
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i\in f^{-1}(j)
            (Note: There should be a better combinatorial way to precisely specify this, but I’m having trouble doing so). Notice that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{-1}(j)
            is empty, this procedure yields the identity map. On morphisms, everything remains well-defined by the naturality condition (implying that the diagrams do in fact commute). This proves that the assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi T
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} C^{(t)}(X,Y):\mathbf{T} \to Cat
            is functorial in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Notice that this is not actually functorial in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Z\to X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mrow
                        %mn 1
                        %mo ∨
                        %mi t
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^t(X,Y)\to C^{1\vee t}(Z,Y)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Y\to Z
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mrow
                        %mi t
                        %mo ∨
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^{t}(X,Y)\to C^{t \vee 1}(X,Z)
          %p
            We may concatenate two combinatorial zigzags
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %msub
                    %mi t
                    %mo +
                  %mo ,
                  %msub
                    %mi t
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t=(n,t_+,t_-)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ′
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi t
                  %msub
                    %mo ′
                    %mo +
                  %mo ,
                  %mi t
                  %msub
                    %mo ′
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t'=(m,t'_+,t'_-)
            in the obvious way by taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∨
                  %mi t
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t\vee t'
            to be the combinatorial zigzag
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mi m
                  %mo ,
                  %msub
                    %mi t
                    %mo +
                  %mo ∪
                  %mi n
                  %mo{:stretchy => "false"} (
                  %mi t
                  %msub
                    %mo ′
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi t
                    %mo −
                  %mo ∪
                  %mi n
                  %mo{:stretchy => "false"} (
                  %mi t
                  %msub
                    %mo ′
                    %mo −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n+m, t_+ \cup n(t'_+), t_- \cup n(t'_-))
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo +
                  %mi i
                  %mo :
                  %mi i
                  %mo ∈
                  %mi S
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} n(S):=\{n+i: i\in S\}
            is the map adding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            to each index. This is clearly functorial in both coordinates and defines a monoidal product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∨
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \vee:\mathbf{T}\times \mathbf{T}\to \mathbf{T}
          %p
            We will lift this to a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∨
                      %mi XYZ
                      %mrow
                        %mi t
                        %mo ,
                        %mi t
                        %mo ′
                    %mo :
                    %msup
                      %mi C
                      %mi t
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi C
                      %mrow
                        %mi t
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mrow
                        %mi t
                        %mo ∨
                        %mi t
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \vee^{t,t'}_{XYZ}:C^t(X,Y)\times C^{t'}(Y,Z)\to C^{t\vee t'}(X,Z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∨
                    %mi XYZ
                    %mrow
                      %mi t
                      %mo ,
                      %mi t
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \vee^{t,t'}_{XYZ}
            is a functor in both coordinates.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
