          %p now re-expressed as an expectation value of ordinary products of observables after shifting their temporal domains into operator order.
          %p
          #SDCCRDerivationInLightFrontForm.num_remark
            %h6 Remark
            %p
              The analogous conclusion holds also for
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/light+front+quantization"} light front quantization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x^0
              now played by the light front parameter
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo +
                    %annotation{:encoding => "application/x-tex"} x^+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo ±
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo ±
                    %msup
                      %mi x
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msqrt
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x^\pm \coloneqq (x^0 \pm x^d)/\sqrt{2}
                    \\,.
            %p
              Here the light-front
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
              to a field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is (cf.
              %a{:href => "light+front+quantization#Burkardt96"} Burkardt 1996 table 2.1
              for the following equations):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi L
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mo +
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi
                    \\,=\,
                    \\frac
                    { \partial L }
                    { \partial (\partial_+ \phi) }
                    \\mathrlap{\,,}
            %p
              which for
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
              with standard
              %a.existingWikiWord{:href => "/nlab/show/kinetic+energy"} kinetic energy
              term
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∂
                      %mo +
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∂
                      %mo −
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mo ∇
                        %mo{:stretchy => "false"} →
                      %mo ⊥
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\,=\,
                    \\partial_+ \phi \, \partial_- \phi
                    \\,-\,
                    \\tfrac{1}{2} (\vec \nabla_\perp \phi)^2 - V(\phi)
            %p comes out as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∂
                      %mo −
                    %mi ϕ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi
                    \\,=\,
                    \\partial_- \phi
                    \\mathrlap{\,.}
            %p
              While the nature of this light front momentum in canonical quantization (where it is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/second+class+constraint"} second class constraint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                    %mover
                      %mi π
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi x
                      %mo +
                    %mo ,
                    %msup
                      %mi x
                      %mo −
                    %mo ,
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo ⊥
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi ϕ
                      %mo ^
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi x
                      %mo +
                    %mo ,
                    %msup
                      %mi y
                      %mo −
                    %mo ,
                    %msub
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo ⊥
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mi δ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi x
                      %mo −
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi y
                      %mo −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msup
                      %mi δ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo ⊥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo ⊥
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Big[
                    \\widehat{\pi}\big(x^+, x^-, \vec x_\perp\big)
                    ,\,
                    \\widehat{\phi}\big(x^+, y^-, \vec y_\perp\big)
                    \\Big]
                    \\,=\,
                    \-\mathrm{i}\hbar
                    \\tfrac{1}{2}
                    \\delta\big(x^- - y^-\big)
                    \\delta^{d-1}\big(\vec x_\perp - \vec y_\perp\big)
                    \\mathrlap{\,.}
            %p
              And so the above Schwinger-Dyson argument, just with the time coordinate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x^0
              replaced by the light front parameter
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo +
                    %annotation{:encoding => "application/x-tex"} x^+
            #eq:LightFrontUnIntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
