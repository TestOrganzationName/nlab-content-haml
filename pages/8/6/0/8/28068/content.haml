                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\Big\langle
                    \\pi\big(y^+ + \epsilon, x^-, \vec x_\perp\big)
                    \\,
                    \\phi\big(y^+, y^-, \vec y_\perp\big)
                    \\;-\;
                    \\pi\big(y^+ - \epsilon, x^-, \vec x_\perp\big)
                    \\,
                    \\phi\big(y^+, y^-, \vec y_\perp\big)
                    \\Big\rangle
                    \\\
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\,
                    \\tfrac{1}{2}
                    \\delta(x^- - y^-)
                    \\delta^{d-1}(\vec x_\perp - \vec y_{\perp})
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              (Just beware the somewhat subtle factor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1/2
              on the right of
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:LightFrontUnIntegratedSchwingerDysonForComputingCCRsViaMomenta"} (9)
              = succeed "." do
                %a{:href => "light+front+quantization#Burkardt96"} Burkardt 1996 §A p. 76
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              on the left, originating in:
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mo +
                      %mi ϕ
                      %msub
                        %mo ∂
                        %mo −
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi δ
                      %mi ϕ
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo ∂
                        %mo +
                      %msub
                        %mo ∂
                        %mo −
                      %mi ϕ
                      %mo −
                      %msub
                        %mo ∂
                        %mo −
                      %msub
                        %mo ∂
                        %mo +
                      %mi ϕ
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %msub
                        %mo ∂
                        %mo +
                      %msub
                        %mo ∂
                        %mo −
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"}
                      \\delta(\partial_+ \phi \partial_- \phi)/\delta\phi
                      \=
                      \-\partial_+ \partial_- \phi - \partial_- \partial_+ \phi
                      \=
                      \-2 \partial_+ \partial_- \phi
            %p
          %p
