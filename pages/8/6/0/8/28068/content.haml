                    %mi x
                    %mo{:stretchy => "false"} →
                  %mspace{:width => "thinmathspace"}
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
