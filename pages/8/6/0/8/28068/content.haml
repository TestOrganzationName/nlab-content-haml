                  %mo ,
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi y
                    %mn 0
                  %mo ,
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
