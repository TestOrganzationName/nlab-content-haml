                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi B
                  %mo ⟶
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_{A,B} \,\colon\, (T A) \times B \longrightarrow T(A \times B)
          %p
            can be derived by exploiting the symmetry (
            %a.existingWikiWord{:href => "/nlab/show/braiding"}> braiding
            ) of the cartesian product.
          %p
            In this notation, we have the following definition.
          #CommutativeMonad.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/commutative+monads"} commutative monads
                on
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
              %br/
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative
              if there is
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha = \beta
              between the two maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
