            \-Presheaves
          .num_defn
            %h6#definition_11 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              two
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi s
                    %mo ,
                    %msub
                      %mi 𝒟
                      %mi s
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{s}, \mathcal{D}_s \in sSet
              two models as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \to \mathcal{D}
              is simply a homomorphism of simplicial set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi s
                      %mo →
                      %msub
                        %mi 𝒟
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_s \to \mathcal{D}_s
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi s
                  %annotation{:encoding => "application/x-tex"} Func(\mathcal{C}, \mathcal{D})_s
              as a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              is simply the
              %a.existingWikiWord{:href => "/nlab/show/hom+object"} hom object
              of simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi s
                    %mo =
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi s
                    %mo ,
                    %msub
                      %mi 𝒟
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi QuasiCat
                    %mo ↪
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Func(\mathcal{C}, \mathcal{D})_s = sSet(\mathcal{C}_s, \mathcal{D}_s)
                    \\in
                    QuasiCat \hookrightarrow sSet
                    \\,.
          #InfinityPresheaves.num_defn
