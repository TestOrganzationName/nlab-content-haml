          %h3#left_bousfield_localization Left Bousfield localization
          #BousfieldLocalizationOfModelStructureOnSimplicialPresheaves.num_defn
            %h6#definition_9 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, Set]_{proj}
              and set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S} \subset Mor([C^{op}, Set])
              of morphisms, the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              is the model structure with the same cofibrations and weak equivalences the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi 𝒮
                    %mover
                      %munder
                        %mo →
                        %mi id
                      %mover
                        %mo ←
                        %mi id
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, Set]_{proj,\mathcal{S}}
                    \\stackrel{\overset{id}{\leftarrow}}{\underset{id}{\to}}
                    [C^{op}, Set]_{proj}
                    \\,.
          %h3#combinatorial_model_categories Combinatorial model categories
          %p
            The simple idea of the following definition is to say that the model category analog of
            %em
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
            is simply a model structure on a locally presentable category.
          #CombinatorialModelCategory.num_defn
            %h6#definition_10 Definition
            %p
              A model category is a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              if
            %ol
              %li
                %p
                  the underlying category is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              %li
                %p
                  the model structure is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
          %h3#duggers_theorem Dugger’s theorem
          #DuggerTheorem.num_theorem
            %h6#theorem_2 Theorem
            %p
              Every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              = succeed "," do
                %a.maruku-ref{:href => "#CombinatorialModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
              to a
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              of a global
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelStructureOnSimplicialPresheaves"}
          %p
            See at
            = succeed "." do
              %a{:href => "combinatorial%20model%20category#DuggerTheorem"} combinatorial model category - Dugger’s theorem
          %h2#BasicIdeaInInfinityCategoryTheory
