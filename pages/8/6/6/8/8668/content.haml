                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              under
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
          %p And the equivalent characterization is now as before
          #SimpsonTheorem.num_theorem
            %h6#theorem_3 Theorem
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              = succeed "," do
                %a.maruku-ref{:href => "#LocallyPresentableInfinityCategory"}
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
              to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
              = succeed "," do
                %a.maruku-ref{:href => "#ReflectiveLocalization"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %munder
                        %mo ↪
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\hookrightarrow}}
                    PSh_\infty(\mathcal{C}^0)
            %p
              of an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              = succeed "," do
                %a.maruku-ref{:href => "#InfinityPresheaves"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∘
                    %mi L
                  %annotation{:encoding => "application/x-tex"} R \circ L
              preserves
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/filtered+%28%E2%88%9E%2C1%29-colimits"} filtered (∞,1)-colimits
              for some
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
          %p
            This appears as
            = succeed "," do
              %a{:href => "#Lurie"} Lurie, theorem 5.5.1.1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Carlos+Simpson"} Carlos Simpson
          %h3#toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-Toposes
          %p
            As before, if a locally presentable
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒞
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} L \colon PSh_\infty(\mathcal{C}^0) \to \mathcal{C}
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+exact+%28%E2%88%9E%2C1%29-functor"} left exact (∞,1)-functor
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %h3#presentation_by_combinatorial_model_categories Presentation by combinatorial model categories
          %p
            There is a close match between the theory of
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-categories"} locally presentable (∞,1)-categories
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              arises, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
          %p
            This is part of
            = succeed "." do
              %a{:href => "#Lurie"} Lurie, theorem 5.5.1.1
          %p
            Accordingly, every
            %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            between
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
            gives rise to a pair of
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            between the corresponding locally presentable
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            Hence a
            %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
            of a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            presents a corresponding localization of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi 𝒞
                        %mtd
                          %mover
                            %mo ↪
                            %mover
                              %mo ←
                              %mrow
                        %mtd
                          %msub
                            %mi PSh
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mrow
                              %mo [
                              %msup
                                %mi C
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo ]
                            %mrow
                              %mi proj
                              %mo ,
                              %mi 𝒮
                        %mtd
                          %mover
                            %munder
                              %mo →
                              %mi id
                            %mover
                              %mo ←
                              %mi id
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi C
                            %mi op
                          %mo ,
                          %mi sSet
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi proj
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathcal{C} &amp;\stackrel{\overset{}{\leftarrow}}{\hookrightarrow}&amp; PSh_\infty(C)
                  \\\
                  \\left[C^{op}, sSet\right]_{proj,\mathcal{S}}
                  \&amp;\stackrel{\overset{id}{\leftarrow}}{\underset{id}{\to}}&amp;
                  [C^{op}, sSet]_{proj}
                  }
          %h2#references References
          %p
            The standard textbook for
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
            is
          %ul#AdamekRosicky
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Rosick%C3%BD"} Jiří Rosický
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Locally+presentable+and+accessible+categories"} Locally presentable and accessible categories
          %p
            Decent accounts of
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
            include secton A.2.6 of
          %ul#Lurie
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p and
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
              ,
              %em On (Enriched) Left Bousfield Localization of Model Categories
              (
              %a{:href => "http://arxiv.org/abs/0708.2067"}> arXiv:0708.2067
              )
          %p
            The standard text for
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-categories"} locally presentable (∞,1)-categories
            is section 5 of
            = succeed "." do
              %a{:href => "#Lurie"} Lurie
