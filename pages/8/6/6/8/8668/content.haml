          %h2#BasicIdeaInModelCategoryTheory Basic idea in model category theory
          %h3#model_structure_on_simplicial_presheaves Model structure on simplicial presheaves
          %p
            The analog of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            in
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            theory is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          %p
            Write
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            for the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
          .num_defn
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]\simeq [C^{op}, Set]^{\Delta^{op}}
              for the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              %strong
                global projective
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              has as
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  the objectwise
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                  of simplicial sets
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  the objectwise
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
          .num_remark
            %h6#remark_9 Remark
            %p
              Accordingly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              with generating (acyclic) cofibrations the
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              of objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with the generating (acyclic) cofibrations of
              = succeed "." do
