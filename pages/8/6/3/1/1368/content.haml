                    %mi Grpd
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ladj
                  %annotation{:encoding => "application/x-tex"} Func(-, \infty Grpd)^{ladj}
              denote the
              %a{:href => "adjoint+infinity1-functor#LadjAndRadj"} local left adjoint
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
