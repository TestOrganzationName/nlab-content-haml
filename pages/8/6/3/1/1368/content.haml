                        \&amp;{}^\eta\swArrow
                        \&amp; \swarrow_{\mathrlap{L}}
                        \\\
                        \&amp;&amp; B
                        }
                        \\,.
            %p
              Let the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of such factorizations have morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi η
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo →
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ′
                    %mo ⊣
                    %mi R
                    %mo ′
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ,
                    %mi η
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \big((L \dashv R), \eta \big) \to \big((L' \dashv R'\big), \eta' )
              given by
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo →
                    %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L \to L'
              such that for all all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
