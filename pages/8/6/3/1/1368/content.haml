                    %annotation{:encoding => "application/x-tex"} Func(-, \infty Grpd)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %msup
                      %mi Pr
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} C \in Pr^L(\infty,1)Cat
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} S \in (\infty,1)Cat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi Func
                              %mi L
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Func
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mi op
                            %mo ,
                            %mn ∞
                            %mi Grpd
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi ladj
                            %mo ,
