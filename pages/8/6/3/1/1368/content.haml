          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            a
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            with all small
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
