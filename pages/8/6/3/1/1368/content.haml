                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              %strong model-category theoretic factorization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ⊣
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi A
                        %mover
                          %munder
                            %mo ←
                            %mi R
                          %mover
                            %mo →
                            %mi L
                        %mi B
                      %annotation{:encoding => "application/x-tex"} (L \dashv R) : A \stackrel{\overset{L}{\to}}{\underset{R}{\leftarrow}} B
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
                  weak equivalence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo :
                        %mi L
                        %mo ∘
                        %mi r
                        %mo →
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \eta  : L \circ r \to \gamma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi D
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mi r
                              %mtd
                              %mtd
                                %mi A
                            %mtr
                              %mtd
                              %mtd
                                %mpadded{:lspace => "-100%width", :width => "0"}
