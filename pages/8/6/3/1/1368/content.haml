                          %mtd
                          %mtd
                            %mi γ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L\circ r(d) &amp;&amp;\longrightarrow&amp;&amp; L'\circ r(d)
                    \\\
                    \&amp; {}_{\eta_{d}}\searrow &amp;&amp; \swarrow_{\eta'_{d}}
                    \\\
                    \&amp;&amp;
                    \\gamma()
                    }
            %p commutes.
          %p
            Notice that the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            presented by a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            – at least by a
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            – has all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-categorical colimits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            presents, via its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            that preserves
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
