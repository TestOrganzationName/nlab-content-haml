                %path{:d => "M -2.487592 2.868032 C -2.030527 1.146296 -1.021891 0.334693 -0.00144546 -0.000179437 C -1.021878 -0.335093 -2.030481 -1.146736 -2.487477 -2.86849 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.0000198295,0.991454,0.991454,0.0000198295,186.828303,68.083464)"}
                %path{:d => "M -81.346995 -35.147064 L -20.287352 -35.147064 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.991474,0,0,-0.991474,131.727668,47.67603)"}
                %path{:d => "M -2.488521 2.87097 C -2.031499 1.14926 -1.018961 0.333713 0.00145811 -0.00117372 C -1.018961 -0.33606 -2.031499 -1.147667 -2.488521 -2.869377 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.991474,0,0,-0.991474,111.850117,82.522274)"}
            %p
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 5.2.6.3
              asserts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(\phi)
              is left adjoint to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Func
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ,
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Func(\phi, \infty Grpd)
            %p
              We’ve already seen the top arrow is homotopic to the identity, and so we infer
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi S
                      %mi ϕ
                      %mo ≃
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \alpha_S \phi \simeq \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              generate
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi S
                  %annotation{:encoding => "application/x-tex"} \alpha_S
              is thus homotopic to the identity.
          %p
            Note that a natural automorphism of either functor extending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                %annotation{:encoding => "application/x-tex"} PSh
            would induce a natural automorphism of the identity functor on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 5.2.9.1
          %h3#WithOvercategories Relation to slicing
          %p
            The following analog of the corresponding result for 1-
            %a.existingWikiWord{:href => "/nlab/show/categories+of+presheaves"} categories of presheaves
            holds for
            = succeed "-presheaves." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functors+and+comma+categories"} functors and comma categories
          #SlicingCommutesWithFormingPresheaves.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (slicing commutes with passing to presheaves)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+%28%E2%88%9E%2C1%29-category"} small (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒦
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} p \colon \mathcal{K} \to \mathcal{C}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/p}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mrow
                        %mi y
                        %mi p
                  %annotation{:encoding => "application/x-tex"} PSh_\infty(\mathcal{C})/_{y p}
              for the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/over+quasi-category"} over categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y \colon \mathcal{C} \to PSh_\infty(\mathcal{C})
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
            %p
              Then we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi y
                        %mi p
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh_\infty(\mathcal{C}_{/p})
                    \\stackrel{\simeq}{\to}
                    PSh_\infty(\mathcal{C})_{/y p}
                    \\,.
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 5.1.6.12
          %h2#subcategories_of_presheaf_categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
