                      %mi R
                  %annotation{:encoding => "application/x-tex"} Func^R
              is characterized by being accessible and preserving small limits, which can be determined pointwise.
            %p
              The first and third equivalences are general properties of
              %a{:href => "adjoint+infinity1-functor#LadjAndRadj"} local left adjoints
              and opposite functor categories.
            %p
              The last equivalence is because
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mi Grpd
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func^L(\infty Grpd, C) \simeq Func(1, C)
            %p
              Since both constructions corepresent the same functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func(S, -)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
