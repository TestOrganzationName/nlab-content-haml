                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .un_theorem
            %h6#theorem Theorem
            %p
              %strong
                (model category presentation of free
                = succeed "-cocompletion)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is universal with respect to such factorizations of functors out of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              every functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} C \to B
              to any
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              has a factorization through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              as above, and the category of such factorizations is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          %p
            This is
            = succeed "," do
              %a{:href => "#Dugger2001"} Dugger (2001), theorem 1.1
          .proof
            %h6#proof_2 Proof
            %p
              To produce the factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} [C^{op},sSet] \to B
              given the functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} [C^{op},Set] \to B
              would be given by the left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              given by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↦
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F \mapsto \int^{c \in C} \gamma(c) \cdot F(c)
                    \\,,
            %p
              where the dot in the integrand is the
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
              of cocomplete category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} left Quillen functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} L : [C^{op},sSet] \to B
              %em choose
              a
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\colon\; C \to [\Delta,B]
            %p
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ↦
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msup
                      %mi Γ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi F
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L \;\colon\;
                    F \mapsto
                    \\int^{c \in C}
                    \\int^{[n] \in \Delta}
                    \\Gamma^n(c) \cdot F_n(c)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R \colon B \to [C^{op},sSet]
              of this functor is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R(X) \colon c \mapsto Hom_B(\Gamma^\bullet(c), X)
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %mo ←
                      %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (L \dashv R) \colon [C^{op}, sSet]_{proj} \stackrel{\to}{\leftarrow} B
              to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves
              %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo →
                    %msub
                      %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} b_1 \to b_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              we have for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              that that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi b
                      %mn 1
                    %mo →
                    %msub
                      %mi b
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C\big(\Gamma^\bullet(c), b_1 \to b_2\big)
            %p
              is an (acyclic) fibration of simplicial sets. But this is one of the standard properties of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial [[resolutions
            %p
              Finally, to find the natural weak equivalence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi L
                      %mo ∘
                      %mi j
                      %mo ≃
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \eta \colon L \circ j \simeq \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} j : C \to [C^{op},sSet]
              for the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              and notice that by
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+reduction"} Yoneda reduction
              it follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x \in C
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %msup
                      %mi Γ
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Γ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    L(j(x))
                    \\;=\;
                    \\int^{c \in C} \int^{[n] \in \Delta}
                    \\Gamma^n(c) \cdot C(c,x)
                    \\;=\;
                    \\Gamma^0(x)
            %p
              (where equality signs denote
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            %p
              By the very definition of cosimplicial resolutions, there is a natural weak equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                    %annotation{:encoding => "application/x-tex"} \Gamma(x) \stackrel{\simeq}{\to}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
          .un_cor
            %h6#corollary_2 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \colon C \to PSh(C)
              generates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              under small colimits:
            %p
              a full
              %a.existingWikiWord{:href => "/nlab/show/sub-quasi-category"} (∞,1)-subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              that contains all representables and is closed under forming
              = succeed "-colimits" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(C)
          .proof
            %h6#proof_3 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary 5.1.5.8
          %h3#Functoriality Functorality
          %p
            The two descriptions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(S)
            as the functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi op
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func(S^{op}, \infty Grpd)
            and as the free cocompletion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S \to PSh(S)
            (
            %a{:href => "#FreeColimCompletion"}> above
            ) both extend to contravariant and covariant
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functors"} functors
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29Cat"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} (\infty, 1)Cat
          %p These two constructions are related.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi Cat
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mi Cat
                    %mo ^
                %annotation{:encoding => "application/x-tex"} Func(-, \infty Grpd) \colon (\infty, 1)Cat^{op} \to (\infty, 1)\widehat{Cat}
            takes values in the subcategory of
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
            and functors
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserving
            %a.existingWikiWord{:href => "/nlab/show/small+limit"} small
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-limit"} limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-colimit"} colimits
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
            and
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28infinity%2C1%29-functor"} adjoints
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr^L(\infty,1)Cat
            be the (∞,1)category of
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
            and functors that are left adjoints, and similarly for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Pr
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Pr^R(\infty,1)Cat
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28infinity%2C1%29-functor#category_of_adjunctions"} local left adjoint
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi Cat
                      %mi op
                    %mo →
                    %msup
                      %mi Pr
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Func(-, \infty Grpd) \colon (\infty, 1)Cat^{op} \to Pr^R(\infty,1)Cat
              is naturally equivalent to the free cocompletion functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo →
                    %msup
                      %mi Pr
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} P \colon (\infty, 1)Cat \to Pr^L(\infty,1)Cat
              by a natural equivalence whose components at a small (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are homotopic to the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(S)
          .proof
            %h6#proof_4 Proof
            %p
              Consider the (∞,1)-category of possibly large (∞,1)-categories that have small colimits, and functors preserving small colimits. By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 5.3.6.10
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
                      %mi L
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Func^L\big(P(S), -\big) \simeq Func(S, -)
            %p
              given by pre-composition with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Yoneda+embedding"} Yoneda embedding
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
