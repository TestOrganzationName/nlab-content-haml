                      %msup
                        %mo{:stretchy => "false"} )
                        %mi ladj
                    %annotation{:encoding => "application/x-tex"} P(S) \simeq Func(S^{op}, \infty Grpd)^{ladj}
            %p Now consider the chain of equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ←
