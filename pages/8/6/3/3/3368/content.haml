          %p However, we do have the following:
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} HA
                Lemma 7.3.5.14 in older versions,
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
                Proposition 4.4.5.20 in newer versions)
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              in an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
