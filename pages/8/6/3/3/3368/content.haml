                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} e:\Delta^1 \to C
              extends to
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Idem
                    %annotation{:encoding => "application/x-tex"} Idem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi e
                    %mo ∼
                    %msup
                      %mi e
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h : e \sim e^2
