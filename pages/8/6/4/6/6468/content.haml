                    \&amp; =\;
                    \\underset{= 0}{\underbrace{c_1 \cup c_1}}[K3]
                    \- 2
                    \\underset{24}{\underbrace{c_2[K3]}}
                    \\\
                    \&amp; = - 48
                    \\end{aligned}
                    \\,.
