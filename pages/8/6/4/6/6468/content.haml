                    \\\
                    \&amp;&amp; h^{2,2}
                    }
                    \\;\;\;=\;\;\;
                    \\array{
                    \&amp;&amp; 1
                    \\\
                    \&amp; 0 &amp;&amp; 0
                    \\\
                    1 &amp; &amp; 20 &amp; &amp; 1
                    \\\
                    \&amp; 0 &amp; &amp; 0
                    \\\
                    \&amp;&amp;
                    1
                    }
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#BarthPetersVandenVen84"} Barth-Peters-Van den Ven 84, VIII Prop. 3.3
          %p
            %br/
          %h3#SUBordism SU-Bordism
          #K3SurfaceSpansSUBordismRingInDegree4.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
                spans
                %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
                in degree 4)
            %p
              The canonical degree-4 generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 4
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                  %annotation{:encoding => "application/x-tex"} y_4 \in \Omega^{SU}_4
              in the
              %a.existingWikiWord{:href => "/nlab/show/SU-bordism+ring"} SU-bordism ring
              (
              %a{:href => "MSU#SUBordismRingAwayFromTwo"}> this Prop.
              ) is represented by minus the class of any (non-
              %a.existingWikiWord{:href => "/nlab/show/torus"}> torus
              )
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/K3-surface"} K3-surface
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mn 4
                      %mi SU
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{SU}_4
                    \\;\simeq\;
                    \\mathbb{Z}\big[ \tfrac{1}{2}\big]\big\langle -[K3] \big\rangle
                    \\,.
          %p
            (
            %a{:href => "MSU#LLP17"}> LLP 17, Lemma 1.5, Example 3.1
            ,
            = succeed "," do
              %a{:href => "MSU#CLP19"} CLP 19, Theorem 13.5a
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds+in+SU-bordism+theory"} Calabi-Yau manifolds in SU-bordism theory
          %p
            %br/
          %h3#CharacteristicClasses Characteristic classes
          %p
            We discuss some
            %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
            of (the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mn 3
                %annotation{:encoding => "application/x-tex"} K3
            (i.e. their
            %a.existingWikiWord{:href => "/nlab/show/integration"} integration
            over
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} K3
          %h4#of_
            Of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mn 3
                %annotation{:encoding => "application/x-tex"} K3
          #EulerCharacteristicOfK3.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
              of
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
              is 24:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 24
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_4[K3] \;=\; 24
                    \\,.
          #FirstChernClassOfK3.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              of
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
              vanishes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c_1(K3) \;=\; 0
                    \\,.
          #SecondChernClassOfK3.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
              of
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
              evaluates to 24:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 24
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c_2[K3] \;=\; 24
                    \\,.
          .proof
            %h6#proof Proof
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              the evaluation of the top degree
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
              equals the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
              = succeed "." do
                %a.maruku-ref{:href => "#EulerCharacteristicOfK3"}
          #FirstPontryaginClassOfK3.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/first+Pontryagin+class"} first Pontryagin class
              of
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
              evaluates to 48:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mn 48
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_1[K3] \;=\; -48
                    \\,.
          %p
            (see also e.g.
            = succeed ")" do
              %a{:href => "I8#DuffLiuMinasian95"} Duff-Liu-Minasian 95 (5.10)
          .proof
            %h6#proof_2 Proof
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              the
              %a.existingWikiWord{:href => "/nlab/show/first+Pontryagin+class"} first Pontryagin class
              is the following
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              in the
