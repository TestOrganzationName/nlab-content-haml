          #EulerCharacteristicOfK3TimesK3.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
                of
                %a.existingWikiWord{:href => "/nlab/show/K3"} K3
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
