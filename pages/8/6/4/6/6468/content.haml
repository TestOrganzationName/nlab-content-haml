            ), see also (
            %a{:href => "#ArtinMazur77"}> Artin-Mazur 77, p. 5 (of 46)
            )
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/moduli+spaces"} moduli spaces
                of
