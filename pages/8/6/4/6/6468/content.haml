          %h3#relation_to_third_stably_framed_bordism_group Relation to third stably framed bordism group
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/third+stable+homotopy+group+of+spheres"} third stable homotopy group of spheres
            (the third
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+stem"} stable stem
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            24:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi π
                            %mn 3
                            %mi s
                        %mtd
                          %mo ≃
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 24
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi h
                            %mi ℍ
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_3^s &amp;\simeq&amp; \mathbb{Z}/24
                  \\\
                  [h_{\mathbb{H}}] &amp;\leftrightarrow&amp; [1]
                  }
          %p
            where the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 24
                %annotation{:encoding => "application/x-tex"} [1] \in \mathbb{Z}/24
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi ℍ
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^7 \overset{h_{\mathbb{H}}}{\longrightarrow} S^4
          %p
            Under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+isomorphism"} Pontrjagin-Thom isomorphism
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            with the
            %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ω
                    %mo •
                    %mi fr
                %annotation{:encoding => "application/x-tex"} \Omega^{fr}_\bullet
            of
            %a.existingWikiWord{:href => "/nlab/show/stable+framing"} stably framed
            manifolds (see at
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/MFr"} MFr
            %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            (with its left-invariant framing induced from the identification with the
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            %a.existingWikiWord{:href => "/nlab/show/Sp%281%29"} Sp(1)
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi π
                            %mn 3
                            %mi s
                        %mtd
                          %mo ≃
                        %mtd
                          %msubsup
                            %mi Ω
                            %mn 3
                            %mi fr
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi h
                            %mi ℍ
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↔
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_3^s &amp; \simeq &amp; \Omega_3^{fr}
                  \\\
                  [h_{\mathbb{H}}] &amp; \leftrightarrow &amp; [S^3]
                  \\,.
                  }
          %p
            Moreover, the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mn 4
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mn 3
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 2 4 [S^3] \,\simeq\, 0
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/bordism"} bordism
            which is the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of 24
            %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
            inside
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            = succeed "-manifold" do
              %a.existingWikiWord{:href => "/nlab/show/K3"} K3
            = succeed ")." do
              %a{:href => "third+stable+homotopy+group+of+spheres#WangXu10"} Wang-Xu 10, Sec. 2.6
