          %h2#definition Definition
          %p
            A
            %strong cyclic set
            is a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on the
            %em
              %a.existingWikiWord{:href => "/nlab/show/cyclic+category"} cyclic category
            (which is often called
            %a.existingWikiWord{:href => "/nlab/show/Connes%27+cyclic+category"} Connes' cyclic category
            though it is cocyclic, with the usual contravariant confusion), which is intermediate between a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+set"} symmetric set
            and a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            replaced by a general
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            one speaks of a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cyclic+object"} cyclic object
          %p
            The concept of cyclic sets/objects is used in the description of the cyclic structure on
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
            and hence for the discussion on
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"} cyclic homology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+cohomology"} cyclic cohomology
          %p
            Cyclic sets and more generally
            %a.existingWikiWord{:href => "/nlab/show/cyclic+objects"} cyclic objects
            can be described in terms of standard generators:
          %p
            A
            = succeed "-cyclic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}
            = succeed ")in" do
              %a.existingWikiWord{:href => "/nlab/show/paracyclic+object"} paracyclic object
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F_\bullet
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            together with a sequence of
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi n
                    %mo :
                    %msub
                      %mi F
                      %mi n
                    %mo →
                    %msub
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} t_n : F_n \rightarrow F_n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n\geq 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mo ∂
                            %mi i
                          %msub
                            %mi t
                            %mi n
                          %mo =
                          %msub
                            %mi t
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %msub
                            %mo ∂
                            %mrow
                              %mi i
                              %mo −
                              %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mi i
                          %mo &gt;
                          %mn 0
                          %mo ,
                        %mtd
                          %msub
                            %mi σ
                            %mi i
                          %msub
                            %mi t
                            %mi n
                          %mo =
                          %msub
                            %mi t
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %msub
                            %mi σ
                            %mrow
                              %mi i
                              %mo −
                              %mn 1
                          %mo ,
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mi i
                          %mo &gt;
                          %mn 0
                          %mo ,
                      %mtr
                        %mtd
                          %msub
                            %mo ∂
                            %mn 0
                          %msub
                            %mi t
                            %mi n
                          %mo =
                          %msub
                            %mo ∂
                            %mi n
                          %mo ,
                        %mtd
                          %msub
                            %mi σ
                            %mn 0
                          %msub
                            %mi t
                            %mi n
                          %mo =
                          %msubsup
                            %mi t
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                            %mn 2
                          %msub
                            %mi σ
                            %mi n
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\partial_i t_n = t_{n-1} \partial_{i-1},\,\, i \gt 0, &amp;
                  \\sigma_i t_n = t_{n+1} \sigma_{i-1},\,\, i \gt0, \\
                  \\partial_0 t_n = \partial_n, &amp; \sigma_0 t_n = t_{n+1}^2 \sigma_n,
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi i
                %annotation{:encoding => "application/x-tex"} \partial_i
            are boundaries,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sigma_i
            are degeneracies. A
            = succeed "-cocyclic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf Z
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/paracocyclic+object"} paracocyclic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "-cyclic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} C^{\mathrm{op}}
            = succeed "-(co)cyclic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \mathbf Z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi t
