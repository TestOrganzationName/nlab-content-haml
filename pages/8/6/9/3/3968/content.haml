          %h2#definition Definition
          %p
            A
            %strong number field
            is a
            %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %a.existingWikiWord{:href => "/nlab/show/field+extension"} field extension
            of the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %p
            In other words, a number field is a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            such that under the field
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi ℚ
                    %mo ↪
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i: \mathbb{Q} \hookrightarrow k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            with respect to the scalar multiplication
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo ⊗
                  %mi k
                  %mover
                    %mo →
                    %mrow
                      %mi i
                      %mo ⊗
                      %mn 1
                  %mi k
                  %mo ⊗
                  %mi k
                  %mover
                    %mo →
                    %mi mult
                  %mi k
                %annotation{:encoding => "application/x-tex"} \mathbb{Q} \otimes k \stackrel{i \otimes 1}{\to} k \otimes k \stackrel{mult}{\to} k
          %p
            on the underlying additive
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h2#examples Examples
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Gaussian+numbers"} Gaussian numbers
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℚ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}(i)
            %li
              %p
                for certain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                the
                %span.newWikiWord
                  quadratic field
                  %a{:href => "/nlab/new/quadratic+field"} ?
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℚ
                        %mo{:stretchy => "false"} (
                        %msqrt
                          %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}(\sqrt{d})
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/cyclotomic+fields"} cyclotomic fields
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ζ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}(\zeta_n)
          %p Counterexamples:
          %ul
            %li
              the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              and
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              are
              %strong not
              number fields, since, while being
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              as
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %h2#applications Applications
          %p
            Number fields are the basic objects of study in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+number+theory"} algebraic number theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+integer"} algebraic integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_k
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            in terms of prime ideals in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_k
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ideal+class+group"} ideal class group
            %a.existingWikiWord{:href => "/nlab/show/zeta+function"} zeta function
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h2#properties Properties
          %h3#as_global_fields As global fields
          %p
            Number fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            are examples of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/global+field"} global field
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %a.existingWikiWord{:href => "/nlab/show/adele+ring"} adeles
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔸
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}_k
            %a.existingWikiWord{:href => "/nlab/show/local+field"} local completions
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h3#class_number_formula Class number formula
          %p
            Given a number field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+zeta+function"} Dedekind zeta function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi K
                %annotation{:encoding => "application/x-tex"} \zeta_K
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            has a
            %a.existingWikiWord{:href => "/nlab/show/simple+pole"} simple pole
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
            %em class number formula
            says that its
            %a.existingWikiWord{:href => "/nlab/show/residue"} residue
            there is proportional the product of the
            %a.existingWikiWord{:href => "/nlab/show/regulator+of+a+number+field"} regulator
            with the
            %a.existingWikiWord{:href => "/nlab/show/class+number"} class number
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi s
                      %mo →
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi ζ
                    %mi K
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo ∝
                  %msub
                    %mi ClassNumber
                    %mi K
                  %mo ⋅
                  %msub
                    %mi Regulator
                    %mi K
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\underset{s\to 1}{\lim} (s-1) \zeta_K(s)
                  \\propto
                  ClassNumber_K \cdot Regulator_K
                  \\,.
          %h3#function_field_analogy Function field analogy
