          %h2#PositiveCharacteristics Positive characteristic
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              \: it would be nice to have a little more explanation about how not every
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                    %annotation{:encoding => "application/x-tex"} O
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "?" do
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
              category, which might explain my puzzlement.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/variety"} variety
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/positive+characteristic"} positive characteristic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-coherent" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "-module\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi X
                %annotation{:encoding => "application/x-tex"} D_X
            no longer is the
            %a.existingWikiWord{:href => "/nlab/show/enveloping+algebra"} enveloping algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                %annotation{:encoding => "application/x-tex"} O_X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mtext Der
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi X
                    %mo ,
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \text{Der}_X(O_X,O_X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is smooth over a base field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi X
                %annotation{:encoding => "application/x-tex"} D_X
            will not be Noetherian, instead being generated by operators like
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo !
                    %mo{:stretchy => "false"} (
                    %mfrac
                      %mi d
                      %mi dt
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi p
                          %mi k
                  %annotation{:encoding => "application/x-tex"} \frac{1}{(p^k)!} (\frac{d}{dt})^{p^k}
            = succeed "-coherent" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
          %p
            A theorem by Katz states that for smooth
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the category of
            = succeed "-coherent" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mn 0
                  %mo ,
                  %msub
                    %mi E
                    %mn 1
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_0, E_1,\ldots)
            of locally free
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "-isomorphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi i
                    %mo :
                    %msub
                      %mi E
                      %mi i
                    %mo →
                    %msup
                      %mi F
                      %mo *
                    %msub
                      %mi E
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_i: E_i\rightarrow F^* E_{i+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is the Frobenius endomorphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a{:href => "#Gieseker75"} Gieseker ‘75, Theorem 1.3
          %p
