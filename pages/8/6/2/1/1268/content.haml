          %h2#definition Definition
          %h3#in_terms_of_differential_operators In terms of differential operators
          %p
            A
            %em D-module
            (introduced by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Mikio+Sato"} Mikio Sato
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} sheaf
            of
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi X
                %annotation{:encoding => "application/x-tex"} D_X
            of
            %a.existingWikiWord{:href => "/nlab/show/regular+differential+operators"} regular differential operators
            on a ‘variety’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the latter notion depends on whether we work over a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                %annotation{:encoding => "application/x-tex"} O_X
            is a subsheaf of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi X
                %annotation{:encoding => "application/x-tex"} D_X
            consisting of the zeroth-order differential operators (multiplications by the sections of structure sheaf), every
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                  %annotation{:encoding => "application/x-tex"} O_X
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi X
                  %annotation{:encoding => "application/x-tex"} D_X
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
