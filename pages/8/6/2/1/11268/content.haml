                  %mi B
                %annotation{:encoding => "application/x-tex"} f \colon B \to B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
          %h2#precise_statement Precise statement
          %p
            Let us say that a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \phi: X \to Y
            is
            %em point-surjective
            if for every point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mn 1
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} q: 1 \to Y
            there exists a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} p: 1 \to X
            that lifts
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mi p
                    %mo =
                    %mi q
                  %annotation{:encoding => "application/x-tex"} \phi p = q
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Lawvere’s fixed-point theorem)
              In a cartesian closed category, if there is a point-surjective map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi A
                      %mo →
                      %msup
                        %mi B
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \phi: A \to B^A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: B \to B
              has a fixed point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mn 1
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} s: 1 \to B
              (so that
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi s
                      %mo =
                      %mi s
                    %annotation{:encoding => "application/x-tex"} f s = s
          .proof
            %h6#proof Proof
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi B
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f: B \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mn 1
                    %mo →
                    %msup
                      %mi B
                      %mi A
                  %annotation{:encoding => "application/x-tex"} q: 1 \to B^A
              name the composite map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mi δ
                    %mi A
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %mi ϕ
                        %mo ×
                        %msub
                          %mn 1
                          %mi A
                    %msup
                      %mi B
                      %mi A
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mi eval
                    %mi B
                    %mover
                      %mo →
                      %mi f
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \stackrel{\delta}{\to} A \times A \stackrel{\phi \times 1_A}{\to} B^A \times A \stackrel{eval}{\to} B \stackrel{f}{\to} B
            %p
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/lambda+calculus"} lambda calculus
              notation,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %mi λ
                      %mi a
                      %mo :
                      %mi A
                      %mo .
                      %mi f
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} q = \lambda a: A. f \phi(a)(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p: 1 \to A
              lift
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi a
                    %mo :
                    %mi A
                    %mo .
                    %mi f
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(p)(p) = q(p) = (\lambda a: A. f \phi(a)(a))(p) = f \phi(p)(p)
            %p
              where the last equation is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/beta-reduction"} beta-reduction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ≔
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s \coloneqq \phi(p)(p)
              is a fixed point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          .num_remark
            %h6#remark Remark
            %p
              As pointed out by Lawvere, a hypothesis even weaker than point-surjectivity will do. Namely,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mi Y
                      %mi A
                  %annotation{:encoding => "application/x-tex"} g: X \to Y^A
              is called
              %em weakly point-surjective
              iff for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: A \to Y
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x: 1 \to X
              such that for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mn 1
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a: 1 \to A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(x)(a) = f(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g(x) = f
              cannot be inferred from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(x)(a) = f(a)
              for all
              %em
                %a.existingWikiWord{:href => "/nlab/show/global+elements"} global elements
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
          .num_remark
            %h6#remark_2 Remark
            %p
              The statement need not hold if “(weakly) point-surjective” is replaced by “epimorphism”. For example, in the cartesian closed category of compactly generated Hausdorff spaces and continuous maps, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S = S^1
              the circle, the
              %a.existingWikiWord{:href => "/nlab/show/Polish+space"} Polish space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} S^\mathbb{N}
              is compactly generated under the product topology; this is the exponential where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              is given the discrete topology. There is a countable dense subspace
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi ℕ
                      %mo →
                      %msup
                        %mi S
                        %mi ℕ
                    %annotation{:encoding => "application/x-tex"} i: \mathbb{N} \to S^\mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is an epimorphism iff it has a dense
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              that have no fixed points.
          %p
            Thus epimorphisms need not be (weakly) point-surjective. Nor are point-surjective maps necessarily epimorphisms; for example, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↪
                  %mi V
                %annotation{:encoding => "application/x-tex"} U \hookrightarrow V
            is a proper inclusion between proper subobjects of the terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (as may happen in a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
          %p Point-surjectivity may seem like an inadequate notion of “epimorphism”, but it suffices for many purposes. For example,
          .num_prop
            %h6#proposition Proposition
            %p
              %strong (Cantor’s theorem in a topos)
              For any object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mi Ω
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f: X \to \Omega^X
              only if the topos is degenerate.
          .proof
            %h6#proof_2 Proof
            %p
              Suppose there existed such an epi. In a topos, a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is epi iff the
              %a.existingWikiWord{:href => "/nlab/show/image"} direct image
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi f
                    %mo :
                    %msup
                      %mi Ω
                      %mi X
                    %mo →
                    %msup
                      %mi Ω
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \exists_f: \Omega^X \to \Omega^Y
              retracts the
              %a.existingWikiWord{:href => "/nlab/show/preimage"} inverse image
              map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi f
                      %mo :
                      %msup
                        %mi Ω
                        %mi Y
                      %mo →
                      %msup
                        %mi Ω
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \Omega^f: \Omega^Y \to \Omega^X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mi f
                      %mo ∘
                      %msup
                        %mi Ω
                        %mi f
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %msup
                            %mi Ω
                            %mi Y
                    %annotation{:encoding => "application/x-tex"} \exists_f \circ \Omega^f = 1_{\Omega^Y}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %msup
                        %mi Ω
                        %mi X
                    %annotation{:encoding => "application/x-tex"} Y = \Omega^X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %msup
                      %mi Ω
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \exists_f: Y \to \Omega^Y
              is a retraction. But retractions are automatically point-surjective.
            %p
              We then conclude from Lawvere’s fixed point theorem that every endomorphism on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo :
                      %mi Ω
                      %mo →
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \neg: \Omega \to \Omega
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mn 1
                      %mo →
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} p: 1 \to \Omega
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo =
                      %mi p
                      %mo ∧
                      %mo ¬
                      %mi p
                      %mo =
                      %mi p
                      %mo ∧
                      %mi p
                      %mo =
                      %mi p
                    %annotation{:encoding => "application/x-tex"} 0 = p \wedge \neg p = p \wedge p = p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mn 0
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \neg 0 = 0
          %p
            Once we have a proposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mo ¬
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p = \neg p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo →
                    %msup
                      %mn 0
                      %mi p
                  %annotation{:encoding => "application/x-tex"} p \to 0^p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is regarded as a
            %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is the initial object, so that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 0
                      %mi p
                    %mo =
                    %mo ¬
                    %mi p
                  %annotation{:encoding => "application/x-tex"} 0^p = \neg p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 1\to 0
            of the identity map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0\to 0
            %a.existingWikiWord{:href => "/nlab/show/beta-reduction"} beta-reduction
            of this.) For a formalization of this argument and a generalization thereof to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universe+types"} universe types
            = succeed "." do
              %a{:href => "#Escardo18"} Escardo18
          .num_remark
            %h6#remark_3 Remark
            %p
              Another version of Lawvere’s fixed-point theorem requires only finite products for its statement. Namely, in a category with finite products, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \Phi: A \times A \to B
              is a morphism with the property that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g: A \to B
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a: 1 \to A
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi λ
                      %mo =
                      %mi Φ
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ×
                      %msub
                        %mn 1
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \lambda = \Phi \circ (a \times 1_A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo :
                    %mn 1
                    %mo ×
                    %mi A
                    %mover
                      %mo →
                      %mo ∼
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \lambda: 1 \times A \stackrel{\sim}{\to} A
              is the projection. Then every map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f: B \to B
              has a fixed point. This version of the theorem is emphasized by
              = succeed "." do
                %a{:href => "#Yanofsky03"} Yanofsky
          .num_remark
            %h6#remark_4 Remark
            %p
              Many applications of Lawvere’s fixed point theorem are in the form of negated propositions, e.g., there is no epimorphism from a set to its power set, or
              %a.existingWikiWord{:href => "/nlab/show/Peano+arithmetic"} Peano arithmetic
              cannot prove its own
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/consistency"} consistency
              %a.existingWikiWord{:href => "/nlab/show/fixed-point+combinators"} fixed-point combinators
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/untyped+lambda+calculus"} untyped lambda calculus
          %h2#History History
          %p
            In an interview (
            %a{:href => "William+Lawvere#Interview07"}> Lawvere 07
            ) not long after Gödel’s 100th birthday,
            %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
            answered the question
          %blockquote
            %p We have recently celebrated Kurt Gödel’s 100th birthday. What do you think about the extra-mathematical publicity around his incompleteness theorem?
          %p
            by saying (reproduced in
            = succeed "):" do
              %a{:href => "#Lawvere69"} Lawvere 69 reprint, p. 2
          %blockquote
            %p
              In ‘Diagonal arguments and Cartesian closed categories’ (
              %a{:href => "#Lawvere69"}> Lawvere 69
              ) we demystified the incompleteness theorem of Gödel and the truth-definition theory of Tarski by showing that both are consequences of some very simple algebra in the Cartesian-closed setting. It was always hard for many to comprehend how Cantor’s mathematical theorem could be re-christened as a “paradox” by Russell and how Gödel’s theorem could be so often declared to be the most significant result of the 20th century. There was always the suspicion among scientists that such extra-mathematical publicity movements concealed an agenda for re-establishing belief as a substitute for science. Now, one hundred years after Gödel’s birth, the organized attempts to harness his great mathematical work to such an agenda have become explicit.
