                  A \longrightarrow B^A
          %p
            then every
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
