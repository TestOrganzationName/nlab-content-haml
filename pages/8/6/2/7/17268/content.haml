                %mrow
                  %msub
                    %mi Top
                    %mi cg
                %annotation{:encoding => "application/x-tex"} Top_{cg}
            a “
            %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"}> convenient category of topological spaces
            ”.
          #Timesk.num_prop
            %h6#proposition_10 Proposition
            %p
              Regarded, via corollary
              %a.maruku-ref{:href => "#TopologicalRealizationOfSSetLandsInkTop"}
              as a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                      %mo{:lspace => "verythinmathspace"} :
                      %mi sSet
                      %mo →
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} {\vert - \vert} \colon sSet \to Top_{cg}
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "geometric+realization#GeometricRealizationIsLeftExact"} Geometric realization is left exact
          .proof
            %h6#proof_idea_3 Proof idea
            %p
              The key step in the proof is to use the
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closure
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                  %annotation{:encoding => "application/x-tex"} Top_{cg}
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#kTopIsCoreflectiveInTop"}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and hence preserves colimits in each variable, so that the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              in the definition of the geometric realization may be taken out of Cartesian products.
          .num_lemma
            %h6#lemma_6 Lemma
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
