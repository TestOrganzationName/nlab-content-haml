                          %mi cg
                        %mover
                          %munder
                            %mo ⟵
                            %mi k
                          %mo ↪
                        %mi Top
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Top_{cg} \stackrel{\hookrightarrow}{\underset{k}{\longleftarrow}} Top
                        \\,.
                %p
                  The coreflection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} k(X)
