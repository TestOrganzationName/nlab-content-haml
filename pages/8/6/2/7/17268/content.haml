                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p : X \to Y
                is a trivial Kan fibration, then its right lifting property implies there is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : Y \to X
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∘
                        %mi s
                        %mo =
                        %msub
                          %mi id
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} p \circ s = id_Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : Y \to X
                is a trivial cofibration. Thus every trivial Kan fibration is also in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Every weak homotopy equivalence factors as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∘
                      %mi i
                    %annotation{:encoding => "application/x-tex"} p \circ i
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is a trivial Kan fibration and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is a trivial cofibration, so every weak homotopy equivalence is indeed in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
              %li
                Finally, noting that the class of weak homotopy equivalences satisfies the conditions in the theorem, we deduce that it is the
                %em smallest
                such class.
          %p
            As a corollary, we deduce that the classical model structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            is the smallest (in terms of weak equivalences) model structure for which the cofibrations are the monomorphisms and the weak equivalences include the (combinatorial) homotopy equivalences.
          .num_prop
            %h6#proposition_16 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo :
                    %mi sSet
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 : sSet \to Set
              be the connected components functor, i.e. the left adjoint of the constant functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cst
                      %mo :
                      %mi Set
                      %mo →
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} cst : Set \to sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Z
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} f : Z \to W
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              is a weak homotopy equivalence if and only if the induced map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi f
                    %mo :
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi W
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^f : \pi_0 K^W \to \pi_0 K^Z
            %p
              is a bijection for all
              %em Kan complexes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          .proof
            %h6#proof_8 Proof
            %p
              One direction is easy: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a Kan complex, then axiom SM7 for
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              implies the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi sSet
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} K^{(-)} : sSet^{op} \to sSet
              is a right
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi sSet
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^{(-)} : sSet^{op} \to Set
              sends weak homotopy equivalences to bijections.
            %p
              Conversely, when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a Kan complex, there is a natural bijection between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^X
              and the hom-set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho (sSet) (X, K)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Z
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} f : Z \to W
              such that the induced morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi W
                    %mo →
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi K
                      %mi Z
                  %annotation{:encoding => "application/x-tex"} \pi_0 K^W \to \pi_0 K^Z
              is a bijection for all Kan complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is precisely a morphism that becomes an isomorphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho (sSet)
          %h3#Properness Properness
          %p
            The Quillen model structure is both left and right
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            which (1) preserves fibrations, (2) preserves pullbacks of fibrations, (3) preserves and reflects weak equivalences, and (4) lands in a category in which the pullback of a weak equivalence along a fibration is a weak equivalence. For if so, we can apply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to the pullback of a fibration along a weak equivalence to get another such pullback in the codomain of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            are
          %ul
            %li
              geometric realization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                      %mo →
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} sSet \to Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              denotes a sufficiently
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
              (e.g. the category of
              %a.existingWikiWord{:href => "/nlab/show/k-spaces"} k-spaces
              suffices) and
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi Ex
                      %mn ∞
                    %mo :
                    %mi sSet
                    %mo →
                    %mi Kan
                  %annotation{:encoding => "application/x-tex"} Ex^\infty : sSet \to Kan
              , where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Kan
                  %annotation{:encoding => "application/x-tex"} Kan
              is the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
          %p
            This may be found, for instance, in II.8.6–7 of
            = succeed "." do
              %a{:href => "model+structure+on+simplicial+sets#GoerssJardine"} Goerss-Jardine
            = succeed "," do
              %a{:href => "model+structure+on+simplicial+sets#Moss"} Moss
            = succeed "." do
              %a{:href => "model+structure+on+simplicial+sets#Cisinski06"} Cisinski, Prop. 2.1.5
          %h3#quillen_equivalence_with_
            Quillen equivalence with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Top
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} Top_{Quillen}
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} adjunction
              of example
              %a.maruku-ref{:href => "#TopologicalRealizationOfSimplicialSets"}
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              of the classical model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              of def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsOnsSetQuillen"}
              with the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi Sing
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Top
                      %mi Quillen
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} underoversey
                    %munder
                      %mo ⟶
                      %mi Sing
                    %mover
                      %mo ⟵
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mo ⊥
                        %mpadded{:width => "0"}
                          %mrow
                            %msub
                              %mrow
                              %mi Qu
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    ({\vert -\vert}\dashv Sing)
                    \\;\;\colon\;\;
                    Top_{Quillen}
                    \\underoversey
                    {\underset{Sing}{\longrightarrow}}
                    {\overset{{\vert -\vert}}{\longleftarrow}}
                    { \bot_{\mathrlap{{}_{Qu}}} }
                    sSet_{Quillen}
          .proof
            %h6#proof_9 Proof
            %p
              First of all, the adjunction is indeed a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %a.maruku-ref{:href => "#SingDetextsAndReflectsFibrations"}
              says in particular that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing(-)
              takes
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              to
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              and prop.
              %a.maruku-ref{:href => "#TopologicalRealizationOfsSetLandsInCWComplexes"}
              gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert-\vert}
              sends monomorphisms of simplicial sets to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
            %p
              Now prop.
              %a.maruku-ref{:href => "#UnitOfSingularNerveAndRealizationIsWEOnKanComplexes"}
              says that the derived adjunction unit and counit are weak equivalences, and hence the Quillen adjunction is a Quillen equivalence.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/constructive+model+structure+on+simplicial+sets"} constructive model structure on simplicial sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction+between+simplicial+sets+and+connective+dgc-algebras"} Quillen adjunction between simplicial sets and connective dgc-algebras
          %h2#references References
          %div
            %h3#classical_model_structure_on_simplicial_sets Classical model structure on simplicial sets
            %p
              On the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            %p The original proof is due to
            %ul
              %li#Quillen67
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                , Section II.3 of:
                %em Axiomatic homotopy theory
                in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Homotopical+Algebra"} Homotopical Algebra
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BFb0097438"} doi:10.1007/BFb0097438
            %p
              This proof is purely
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorial
              (i.e. does not pass through
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              as
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibrations"} minimal Kan fibrations
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
              %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              of a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %p Other proofs are were given in:
            %ul
              %li#GelfandManin96
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gelfand"}> Sergei Gelfand
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Methods+of+homological+algebra"} Methods of homological algebra
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1007/978-3-662-12492-5"} doi:10.1007/978-3-662-12492-5
              %li#GoerssJardine99
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/J.+F.+Jardine"} J. F. Jardine
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
                  = succeed "," do
                    %a{:href => "https://link.springer.com/book/10.1007/978-3-0346-0189-4"} doi:10.1007/978-3-0346-0189-4
                  = succeed ")" do
                    %a{:href => "http://web.archive.org/web/19990208220238/http://www.math.uwo.ca/~jardine/papers/simp-sets/"} webpage
              %li#JoyalTierney08
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
                  = succeed "," do
                    %em Notes on simplicial homotopy theory
                  = succeed "," do
                    %em
                      %a{:href => "https://lists.lehigh.edu/pipermail/algtop-l/2007q4/000017.html"} Advanced Course on Simplicial Methods in Higher Categories
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/JoyalTierneyNotesOnSimplicialHomotopyTheory.pdf", :title => "pdf"} pdf
              %li#JoyalTierney09
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
                  = succeed "," do
                    %em An introduction to simplicial homotopy theory
                  = succeed "," do
                    %a{:href => "http://hopf.math.purdue.edu/cgi-bin/generate?/Joyal-Tierney/JT-chap-01"} web
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/files/JoyalTierneySimplicialHomotopyTheory.pdf", :title => "pdf"} pdf
            %p
              A proof (in fact two variants of it) using the
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrant+replacement"} Kan fibrant replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ex
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} Ex^\infty
              functor is given (in the context of_
              %a.existingWikiWord{:href => "/nlab/show/Cisinski+model+structure"} Cisinski model structure
              %em ) in:
            %ul
              %li#Cisinski06
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                , Section 2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/joyalscatlab/published/Les+pr%C3%A9faisceaux+comme+type+d%27homotopie"} Les préfaisceaux comme type d'homotopie
                = succeed ")" do
                  %a{:href => "http://www.math.univ-toulouse.fr/~dcisinsk/ast.pdf"} pdf
            %p
              The crucial step is the proof that the fibrations are precisely the
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
              (and also to prove all the good properties of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ex
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} Ex^\infty
              without using topological spaces); for two different proofs of this fact using
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ex
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} Ex^\infty
            %p
              Another approach using
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ex
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} Ex^\infty
              is:
            %ul
              %li#Moss
                Sean Moss,
                = succeed "," do
                  %em Another approach to the Kan-Quillen model structure
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1506.04887"} arXiv:1506.04887
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s40062-019-00247-y"} doi:10.1007/s40062-019-00247-y
            %p
              A proof of the model structure not relying on the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              nor on explicit models for
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrant+replacement"} Kan fibrant replacement
              is in
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Christian+Sattler"}> Christian Sattler
                ,
                %em The Equivalence Extension Property and Model Structures
                (
                %a{:href => "https://arxiv.org/abs/1704.06911"}> arXiv:1704.06911
                )
            %p
              Proofs valid in
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
              are given in:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                  ,
                  = succeed "," do
                    %em A constructive account of the Kan-Quillen model structure and of Kan’s Ex∞ functor
                  = succeed "." do
                    %a{:href => "https://arxiv.org/abs/1905.06160"} arXiv:1905.06160
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Nicola+Gambino"}> Nicola Gambino
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"} Simon Henry
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Christian+Sattler"} Christian Sattler
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Karol+Szumi%C5%82o"} Karol Szumiło
                  = succeed "," do
                    %em The effective model structure and ∞-groupoid objects
                  = succeed "." do
                    %a{:href => "https://arxiv.org/abs/2102.06146"} arXiv:2102.06146
            %p
              As a
              = succeed "," do
                %a{:href => "relation+between+type+theory+and+category+theory#HomotopyTypeTheory"} categorical semantics for homotopy type theory
            %ul
              %li#KapulkinLumnsdaineVoevodsky12
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/1203.2553"} arXiv:1203.2553
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Kapulkin"}> Chris Kapulkin
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
                  = succeed "," do
                    %em The Simplicial Model of Univalent Foundations (after Voevodsky)
                  = succeed "," do
                    %a{:href => "https://arxiv.org/abs/1211.2851"} arXiv:1211.2851
                  = succeed ")" do
                    %a{:href => "http://doi.org/10.4171/jems/1050"} doi:10.4171/jems/1050
        .revisedby
