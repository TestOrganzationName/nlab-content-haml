                        \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sing(X)
              = succeed "," do
                %a.maruku-ref{:href => "#SingularSimplicialComplex"}
              = succeed "." do
                %a.maruku-ref{:href => "#KanComplexes"}
          .proof
            %h6#proof_2 Proof
            %p
              The inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %msub
                          %mrow
                            %msup
                              %mi Λ
                              %mi n
                          %mi Top
                      %mi k
                    %mo ↪
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                  %annotation{:encoding => "application/x-tex"} {{\Lambda^n}_{Top}}_k \hookrightarrow \Delta^n_{Top}
              of topological horns into topological simplices are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                    %mo →
                    %msub
                      %mrow
                        %msub
                          %mrow
                            %msup
                              %mi Λ
                              %mi n
                          %mi Top
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \Delta^n_{Top} \to {{\Lambda^n}_{Top}}_k
              given by “squashing” a topological
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mrow
                        %msub
                          %mrow
                            %msup
                              %mi Λ
                              %mi n
                          %mi Top
                      %mi k
                    %mo →
                    %msubsup
                      %mi Δ
                      %mi Top
                      %mi n
                    %mo →
                    %msub
                      %mrow
                        %msub
                          %mrow
                            %msup
                              %mi Λ
                              %mi n
                          %mi Top
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ({{\Lambda^n}_{Top}}_k \to \Delta^n_{Top} \to
                    {{\Lambda^n}_{Top}}_k)
                    \=
                    Id
                    \\,.
            %p
              Therefore the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi n
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Λ
                      %mi k
                      %mi n
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta^n, \Pi(X)] \to [\Lambda^n_k,\Pi(X)]
              is an epimorphism, since it is equal to to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Λ
                      %mi k
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top(\Delta^n, X) \to Top(\Lambda^n_k, X)
              which has a right inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Λ
                        %mi k
                        %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Top
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Top(\Lambda^n_k, X) \to Top(\Delta^n, X)
          %p More generally:
          #KanFibration.num_defn
            %h6#definition_16 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ⟶
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \phi \colon S \longrightarrow T
              in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              if it has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              again all
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              inclusions, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Horn"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Λ
                              %mi i
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi T
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda^i[n] &amp;\longrightarrow&amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    \\Delta[n] &amp;\longrightarrow&amp; T
                    }
            %p there exists a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Λ
                              %mi i
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi T
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda^i[n] &amp;\longrightarrow&amp; S
                    \\\
                    \\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    \\Delta[n] &amp;\longrightarrow&amp; T
                    }
                    \\,.
          %p
            This is the simplicial incarnation of the concept of
            %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
            of topological spaces:
          #SerreFibration.num_defn
            %h6#definition_17 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is a
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              if for all
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and for every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi C
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    C \times I &amp;\longrightarrow&amp; Y
                    }
            %p there exists a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi C
                            %mo ×
                            %mi I
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    C \times I &amp;\longrightarrow&amp; Y
                    }
                    \\,.
          #SingDetextsAndReflectsFibrations.num_prop
            %h6#proposition_4 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              = succeed "," do
                %a.maruku-ref{:href => "#SerreFibration"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing(f) \colon Sing(X) \longrightarrow Sing(Y)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SingularSimplicialComplex"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              = succeed "." do
                %a.maruku-ref{:href => "#KanFibration"}
          %p
            The proof uses the basic tool of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            to which we get to below in prop.
            = succeed "." do
              %a.maruku-ref{:href => "#NerveAndRealizationAdjunction"}
          .proof
            %h6#proof_3 Proof
            %p
              First observe that the left
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              against all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ↪
                    %mi C
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} C \hookrightarrow C \times I
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              is equivalent to left lifting against
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msup
                        %mi Λ
                        %mi i
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} |
                    %mo ↪
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \Lambda^i[n]\vert} \hookrightarrow {\vert \Delta[n]\vert}
              of
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              inclusions. Then apply the
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi sSet
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Top({\vert-\vert},-) \simeq sSet(-,Sing(-))
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              of prop.
              %a.maruku-ref{:href => "#NerveAndRealizationAdjunction"}
              and example
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalRealizationOfSimplicialSets"}
          #PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence.num_lemma
            %h6#lemma_3 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p \colon X \longrightarrow Y
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              = succeed "," do
                %a.maruku-ref{:href => "#KanFibration"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f_1,f_2 \colon A \longrightarrow X
              be two morphisms. If there is a
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftHomotopyOfSimplicialSets"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_1 \Rightarrow f_2
              between these maps, then there is a fiberwise
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              fibrations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi f
                        %mn 1
                        %mo *
                      %mi X
                      %mo ≃
                      %msubsup
                        %mi f
                        %mn 2
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f_1^\ast X \simeq f_2^\ast X
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GoerssJardine99"} Goerss-Jardine 99, chapter I, lemma 10.6
          %p
            While
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            have the advantage of being purely combinatorial structures, the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            of any given
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %a.maruku-ref{:href => "#SingularSimplicialComplex"}
            is in general a huge simplicial set which does not lend itself to detailed inspection. The following is about small models.
          #MinimalKanFibration.num_defn
            %h6#definition_18 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi S
                      %mo ⟶
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \phi \colon S \longrightarrow T
              = succeed "," do
                %a.maruku-ref{:href => "#KanFibration"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
              if for any two cells in the same fiber with the same
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              if they are homotopic relative their boundary, then they are already equal.
            %p
              More formally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is minimal precisely if for every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mo ∂
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi T
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (\partial \Delta[n]) \times \Delta[1]
                    \&amp;\stackrel{p_1}{\longrightarrow}&amp;
                    \\partial \Delta[n]
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[n] \times \Delta[1]
                    \&amp;\stackrel{h}{\longrightarrow}&amp;
                    S
                    \\\
                    \\downarrow^{\mathrlap{p_1}} &amp;&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    \\Delta[n] &amp;\longrightarrow&amp; T
                    }
            %p then the two composites
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi d
                            %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi d
                            %mn 0
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mi h
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[n]
                    \\stackrel{\overset{d_0}{\longrightarrow}}{\underset{d_1}{\longrightarrow}}
                    \\Delta[n] \times \Delta[1]
                    \\stackrel{h}{\longrightarrow}
                    S
            %p are equal.
          #PullbackPreservesMinimalFibration.num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
              = succeed "," do
                %a.maruku-ref{:href => "#MinimalKanFibration"}
          %p
            …
            = succeed "\u2026" do
              %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
          %p
            (
            %a{:href => "#GoerssJardine99"}> Goerss-Jardine 99, chapter I, section 4
            ,
            = succeed ")" do
              %a{:href => "#JoyalTierney09"} Joyal-Tierney 09, section 1.7
          #KanFibrationHasMinimalStrongDeformationRetract.num_prop
            %h6#proposition_6 Proposition
            %p
              For every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              = succeed "," do
                %a.maruku-ref{:href => "#KanFibration"}
              %a.existingWikiWord{:href => "/nlab/show/strong+deformation+retract"} strong deformation retract
              to a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
              = succeed "." do
                %a.maruku-ref{:href => "#MinimalKanFibration"}
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#GoerssJardine99"} Goerss-Jardine 99, chapter I, prop. 10.3
            = succeed ")." do
              %a{:href => "#JoyalTierney08"} Joyal-Tierney 08, theorem 3.3.1, theorem 3.3.3
          .proof
            %h6#proof_idea Proof idea
            %p
              Choose representatives by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
              against a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          #FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso.num_lemma
            %h6#lemma_4 Lemma
            %p
              A morphism between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibrations"} minimal Kan fibrations
              = succeed "," do
                %a.maruku-ref{:href => "#MinimalKanFibration"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GoerssJardine99"} Goerss-Jardine 99, chapter I, lemma 10.4
          .proof
            %h6#proof_idea_2 Proof idea
            %p
              Show the statement degreewise. In the
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              one needs to lift
              %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
              agains a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          #MinimalKanFibrationAreFiberBundles.num_lemma
            %h6#lemma_5 Lemma
            %p
              Every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
              = succeed "," do
                %a.maruku-ref{:href => "#MinimalKanFibration"}
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              base is a simplicial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GoerssJardine99"} Goerss-Jardine 99, chapter I, corollary 10.8
          .proof
            %h6#proof_4 Proof
            %p
              By assumption of the base being connected, the classifying maps for the fibers over any two vertices are connected by a
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              %a.maruku-ref{:href => "#PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence"}
              the fibers are connected by
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              and then by prop.
              %a.maruku-ref{:href => "#PullbackPreservesMinimalFibration"}
              and lemma
              %a.maruku-ref{:href => "#FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso"}
              they are already isomorphic. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              for this
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
            %p
              Moreover, for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n] \to \Delta[0] \to \Delta[n]
              are
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopic
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi id
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n] \stackrel{id}{\to} \Delta[n]
              and so applying lemma
              %a.maruku-ref{:href => "#PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence"}
              and prop.
              %a.maruku-ref{:href => "#FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso"}
              once more yields that the fiber over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n]
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \Delta[n]\times F
          %h3#geometric_realization Geometric realization
          %p
            So far we we have considered passing from
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            to
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            by applying the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            functor of def.
            = succeed "." do
              %a.maruku-ref{:href => "#SingularSimplicialComplex"}
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            of this functor, called
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            %a.existingWikiWord{:href => "/nlab/show/n-simplices"} n-simplices
            with the standard topological
            = succeed "-simplex." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p This is an example of a general abstract phenomenon:
          #NerveAndRealizationAdjunction.num_prop
            %h6#proposition_7 Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi D
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \;\colon\; D \longrightarrow \mathcal{C}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              from a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              to a
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    N \;\colon\; \mathcal{C} \longrightarrow [D^{op}, Set]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N(X) \coloneqq \mathcal{C}(\delta(-),X)
            %p
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert-\vert}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo ⊣
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mover
                      %munder
                        %mo ⟶
                        %mi N
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    ({\vert-\vert} \dashv N)
                    \\;\colon\;
                    \\mathcal{C}
                    \\stackrel{\overset{{\vert-\vert}}{\longleftarrow}}{\underset{N}{\longrightarrow}}
                    [D^{op}, Set]
            %p
              given by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mi d
                        %mo ∈
                        %mi D
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
