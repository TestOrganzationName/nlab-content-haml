              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
          #GeometricRealizationOfKanFibrationIsSerreFibration.num_prop
            %h6#proposition_11 Proposition
