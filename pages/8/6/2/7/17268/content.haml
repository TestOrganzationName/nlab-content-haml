          #kTopIsCoreflectiveInTop.num_prop
            %h6#proposition_9 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi cg
                    %mo ↪
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top_{cg} \hookrightarrow Top
              of def.
              %a.maruku-ref{:href => "#kTop"}
              has the following properties
            %ol
              %li
                %p
                  It is a
                  %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
