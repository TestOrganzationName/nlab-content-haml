                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Λ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi θ
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda^{n+1}[n] &amp; \longrightarrow &amp; X
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\theta}}
                    \\\
                    \\Delta[n+1]
                    }
            %p
              From the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
              one finds that the boundary of the
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi n
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} d_n \theta
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is constant on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %msub
                      %mi d
                      %mi n
                    %mi θ
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %msub
                      %mi d
                      %mi i
                    %mi θ
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    d_i d_{n} \theta = d_{n-1} d_i \theta = x
            %p
              So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi n
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} d_n \theta
              represents an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
              and we define a product operation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi n
                    %mi θ
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [f]\cdot [g] \coloneqq [d_n \theta]
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#GoerssJardine99"} Goerss-Jardine 99, p. 26
          .num_remark
            %h6#remark_3 Remark
            %p
              All the degenerate
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi i
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} v_{0 \leq i \leq n-2}
              in def.
              %a.maruku-ref{:href => "#ProductOnSimplicialHomotopyGroups"}
              are just there so that the gluing of the two
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              to each other can be regarded as forming the boundary of an
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi n
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} d_n \theta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          .num_lemma
            %h6#lemma Lemma
            %p
              The product on homotopy group elements in def.
              %a.maruku-ref{:href => "#ProductOnSimplicialHomotopyGroups"}
              is well defined, in that it is independent of the choice of representatives
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and of the extension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
          %p
            e.g. (
            %a{:href => "#GoerssJardine99"}> Goerss-Jardine 99, lemma 7.1
            )
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              The product operation in def.
              %a.maruku-ref{:href => "#ProductOnSimplicialHomotopyGroups"}
              yields a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \geq 2
          %p
            e.g. (
            %a{:href => "#GoerssJardine99"}> Goerss-Jardine 99, theorem 7.2
            )
          .num_remark
            %h6#remark_4 Remark
            %p
              The first homotopy group,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #WeakHomotopyEquivalence.num_defn
            %h6#definition_13 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi KanCplx
                    %mo ↪
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} X,Y \in KanCplx \hookrightarrow sSet
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \colon X \longrightarrow Y
            %p
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              if it induces
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              on all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+groups"} simplicial homotopy groups
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_0(f) \colon \pi_0(X) \longrightarrow \pi_0(Y)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  of sets;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_n(f,x) \colon \pi_n(X,x) \longrightarrow \pi_n(Y,f(x))
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  of
                  %a.existingWikiWord{:href => "/nlab/show/groups"} groups
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi X
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} x\in X_0
                  and all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ≥
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n \geq 1
          %h3#kan_fibrations Kan fibrations
          #Horn.num_defn
            %h6#definition_14 Definition
            %p
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \leq i \leq n
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,i)
                \-horn
              is the subsimplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi i
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda^i[n]
                    \\hookrightarrow
                    \\Delta[n]
            %p
              of the simplicial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all faces
              %em except
              the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mi th
                  %annotation{:encoding => "application/x-tex"} i^{th}
              one.
            %p
              This is called an
              %strong outer horn
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k = n
              = succeed "." do
                %strong inner horn
          %p
            %img{:src => "http://ncatlab.org/nlab/files/2horns.jpg", :width => "500"}/
          %p
            (graphics taken from
            = succeed ")" do
              %a{:href => "https://ncatlab.org/nlab/show/simplicial+set#Friedman08"} Friedman 08
          .num_remark
            %h6#remark_5 Remark
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              %a.existingWikiWord{:href => "/nlab/show/unions"} unions
              of
              %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
              make sense and they are calculated objectwise, thus in this case dimensionwise. This way it becomes clear what the structure of a horn as a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Λ
                      %mi k
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Lambda^k[n]: \Delta^{op} \to Set
              must therefore be: it takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [m]
              to the collection of ordinal maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f: [m] \to [n]
              which do not have the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in the image.
          #KanComplexes.num_defn
            %h6#definition_15 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              that satisfies the
              = succeed "," do
                %em Kan condition
            %ul
              %li
                %p
                  which says that all
                  %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                  of the simplicial set have
                  = succeed "/extend" do
                    %em fillers
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              %li
                %p
                  which means equivalently that the unique homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo →
                        %mi pt
                      %annotation{:encoding => "application/x-tex"} S \to pt
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %li
                %p
                  which means equivalently that for all
                  %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
