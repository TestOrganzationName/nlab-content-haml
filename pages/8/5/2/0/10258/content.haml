                %annotation{:encoding => "application/x-tex"} V
            is an
            %a.existingWikiWord{:href => "/nlab/show/antilinear+map"} antilinear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \sigma \colon V \to V
            which is an
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            in that t squares to the identity:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi σ
                    %mn 2
                  %mo =
                  %mi id
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sigma^2 = id
                  \\mathrlap{\,.}
          %p
            (Compare this to a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quaternionic+structure"} quaternionic structure
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/anti-linear+map"} anti-linear map
            that instead squares to
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi id
                  %annotation{:encoding => "application/x-tex"} -id
          %p
            Equivalently, a real structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            and an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ≃
                  %mi W
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} V \simeq W \otimes_{\mathbb{R}} \mathbb{C}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            with its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo =
                  %mi Eig
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi V
                %annotation{:encoding => "application/x-tex"} W = Eig(\sigma,1) \hookrightarrow V
            is the
            %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            for
            %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
            1 and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ⊗
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mi Eig
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi V
                %annotation{:encoding => "application/x-tex"} W \otimes \{i\} = Eig(\sigma,-1) \hookrightarrow V
            is the
            %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
            for
            %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
            \-1.
          %h2#Examples Examples
          %p
          #RealStructuresOnComplexLine.num_remark
            %h6 Example
            %p
              %strong (real structures on the complex line)
              %br/
              The standard real structure on the
              %a.existingWikiWord{:href => "/nlab/show/complex+line"} complex line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi x
                          %mo +
                          %mi{:mathvariant => "normal"} i
                          %mi y
                        %mo ¯
                      %mspace{:width => "thinmathspace"}
                      %mo ≡
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mo −
                      %mi{:mathvariant => "normal"} i
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \overline{x + \mathrm{i} y} \,\equiv\, x - \mathrm{i}y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℂ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mi z
                          %mtd
                            %mo ↦
                          %mtd
                            %mover
                              %mi z
                              %mo ¯
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{C}
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    z
                    \&amp;\mapsto&amp;
                    \\overline{z}
                    \\mathrlap{\,.}
                    }
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              of this real structure are the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              under their defining embedding into the complex numbers:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mtext -
                          %mo{:stretchy => "false"} )
                        %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mo ↪
                    %mi ℝ
                    %mo ⊕
                    %mi{:mathvariant => "normal"} i
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}^{\overline{(\text{-})}}
                    \\;\simeq\;
                    \\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{R} \oplus \mathrm{i} \mathbb{R}
                    \\,\equiv\,
                    \\mathbb{C}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mrow
                                  %mi ℝ
                            %mi ℂ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo ∼
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo ,
                            %mi x
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi x
                            %mo ′
                            %mi x
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mi x
                            %mo ′
                            %mi y
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} \otimes_{{}_{\mathbb{R}}} \mathbb{C}
                    \&amp;\xrightarrow{ \;\sim\; }&amp;
                    \\mathbb{C}
                    \\\
                    (x', x + \mathrm{i} y)
                    \&amp;\mapsto&amp;
                    x' x + \mathrm{i} x' y
                    \\mathrlap{\,.}
                    }
            %p
              Restricting the canonical complex-
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            #eq:CanonicalComplexBilinearFormOnComplexLine.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℂ
                            %msub
                              %mo ⊗
                              %mi ℂ
                            %mi ℂ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo ,
                            %msub
                              %mi z
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi z
                              %mn 1
                            %msub
                              %mi z
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{C} \otimes_{\mathbb{C}} \mathbb{C}
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    (z_1, z_2)
                    \&amp;\mapsto&amp;
                    z_1 z_2
                    }
            %p
              along this inclusion yields the canonical
              = succeed "-bilinear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                            %msub
                              %mo ⊗
                              %mi ℝ
                            %mi ℝ
                          %mtd
                            %mo ↪
                          %mtd
                            %mi ℂ
                            %msub
                              %mo ⊗
                              %mi ℂ
                            %mi ℂ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi x
                              %mn 1
                            %msub
                              %mi x
                              %mn 2
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} \otimes_{\mathbb{R}} \mathbb{R}
                    \&amp;\hookrightarrow&amp;
                    \\mathbb{C} \otimes_{\mathbb{C}} \mathbb{C}
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    (x_1, x_2)
                    \&amp;\mapsto&amp;
                    (x_1, x_2)
                    \&amp;\mapsto&amp;
                    x_1 x_2
                    \\mathrlap{\,.}
                    }
            %p
              Another real structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℂ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mi z
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mover
                              %mi z
                              %mo ¯
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{C}
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    z
                    \&amp;\mapsto&amp;
                    \-\overline{z}
                    \\mathrlap{\,.}
                    }
            %p
              Now the fixed locus is the
              %a.existingWikiWord{:href => "/nlab/show/imaginary+numbers"} imaginary numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathrm{i} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mtext -
                            %mo{:stretchy => "false"} )
                          %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} i
                    %mi ℝ
                    %mo ↪
                    %mi ℝ
                    %mo ⊕
                    %mi{:mathvariant => "normal"} i
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}^{-\overline{(\text{-})}}
                    \\;\simeq\;
                    \\mathrm{i}\mathbb{R}
                    \\hookrightarrow
                    \\mathbb{R} \oplus \mathrm{i} \mathbb{R}
                    \\,\equiv\,
                    \\mathbb{C}
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} i
                            %mi ℝ
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mrow
                                  %mi ℝ
                            %mi ℂ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mo ∼
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi{:mathvariant => "normal"} i
                            %mi x
                            %mo ′
                            %mo ,
                            %mi x
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi x
                            %mo ′
                            %mi y
                            %mo +
                            %mi{:mathvariant => "normal"} i
                            %mi x
                            %mo ′
                            %mi x
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathrm{i}\mathbb{R} \otimes_{{}_{\mathbb{R}}} \mathbb{C}
                    \&amp;\xrightarrow{ \;\sim\; }&amp;
                    \\mathbb{C}
                    \\\
                    (\mathrm{i} x', x + \mathrm{i} y)
                    \&amp;\mapsto&amp;
                    \- x' y + \mathrm{i} x' x
                    \\mathrlap{\,.}
                    }
            %p
              Restricting the canonical complex bilinear form
              %a.maruku-eqref{:href => "#eq:CanonicalComplexBilinearFormOnComplexLine"} (1)
              along this inclusion now yields minus the canonical real bilinear form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                            %msub
                              %mo ⊗
                              %mi ℝ
                            %mi ℝ
                          %mtd
                            %mo ↪
                          %mtd
                            %mi ℂ
                            %msub
                              %mo ⊗
                              %mi ℂ
                            %mi ℂ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi{:mathvariant => "normal"} i
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi{:mathvariant => "normal"} i
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi x
                              %mn 1
                            %msub
                              %mi x
                              %mn 2
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} \otimes_{\mathbb{R}} \mathbb{R}
                    \&amp;\hookrightarrow&amp;
                    \\mathbb{C} \otimes_{\mathbb{C}} \mathbb{C}
                    \&amp;\longrightarrow&amp;
                    \\mathbb{C}
                    \\\
                    (x_1 ,\, x_2)
                    \&amp;\mapsto&amp;
                    (\mathrm{i} x_1 ,\, \mathrm{i}x_2)
                    \&amp;\mapsto&amp;
                    \- x_1 x_2
                    \\mathrlap{\,.}
                    }
            %p
          %p
          .num_remark
            %h6 Example
            %p
              %strong (real structures on the complex plane)
              %br/
              On the
              %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %mo ⊕
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^2 \,\equiv\, \mathbb{C} \oplus \mathbb{C}
              we have first of all the real structures inherited from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              (Ex.
              = succeed ")." do
                %a.maruku-ref{:href => "#RealStructuresOnComplexLine"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℂ
                              %mn 2
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi ℂ
                              %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo ,
                            %msub
                              %mi z
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mover
                              %mrow
                                %msub
                                  %mi z
                                  %mn 1
                              %mo ¯
                            %mo ,
                            %mover
                              %mrow
                                %msub
                                  %mi z
                                  %mn 2
                              %mo ¯
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
