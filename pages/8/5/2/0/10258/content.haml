          #RealStrucAsDaggerSelfDualHermitian.num_remark
            %h6 Example
            %p
              %strong (real structure as dagger-self-dual Hermitian structure)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathscr{V}
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              equipped with
              %em both
            %ol
              %li
                %p
                  a non-degenerate
                  %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"}> Hermitian
                  )
                  %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} |
                            %mo −
                            %mo{:stretchy => "false"} ⟩
                        %annotation{:encoding => "application/x-tex"} {\langle - \vert - \rangle}
              %li
                %p
                  a non-degenerate symmetric
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear
                  %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} {(-\vert-)}
            %p such that
            %ul
              %li
                the Hermitian-
                %a.existingWikiWord{:href => "/nlab/show/adjoint+operator"} adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} )
                        %mo †
                    %annotation{:encoding => "application/x-tex"} {(-\vert-)}^\dagger
                of the bilinear pairing is the
                %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
                that exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathscr{V}
                as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/self-dual+object"} self-dual object
            %p
              then this induces a
              %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathscr{V}
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathscr{W}
              another
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              equipped with a compatible pair of such structures, then the linear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒱
                    %mo ⟶
                    %mi.mathscript 𝒲
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}
                    \\longrightarrow
                    \\mathscr{W}
            %p
              which preserve both structures also preserve that real structure, hence come from
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              of underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
          .proof
            %h6 Proof
            %p To start with, we note some generalities:
            %ol
              %li
                %p
                  the non-degenerate sesquilinear form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} {\langle -\vert -\rangle}
                  is equivalently given by an
                  %a.existingWikiWord{:href => "/nlab/show/antilinear+map"} antilinear map
                  %br/
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo{:lspace => "verythinmathspace"} :
                        %mi.mathscript 𝒱
                        %mo →
                        %msup
                          %mi.mathscript 𝒱
                          %mo *
                      %annotation{:encoding => "application/x-tex"} a \colon \mathscr{V} \to \mathscr{V}^\ast
                  to the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dual+linear+space"} dual linear space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mi a
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        {\langle - \vert -\rangle}
                        \\,=\,
                        a(-)(-)
              %li
                %p
                  the non-degenerate bilinear form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} {(- \vert -)}
                  is equivalently given by a complex
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi l
                          %mspace{:width => "thinmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thinmathspace"}
                          %mi.mathscript 𝒱
                          %mo →
                          %msup
                            %mi.mathscript 𝒱
                            %mo *
                        %annotation{:encoding => "application/x-tex"} l \,\colon\, \mathscr{V} \to \mathscr{V}^\ast
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mi l
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        {(- \vert -)}
                        \\,=\,
                        l(-)(-)
            %p
              (where the second argument means
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/bra-ket+notation"} bra-ket notation
              this is suggestively written as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi l
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi v
                      %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {( v \vert} \;\;\coloneqq\;\; l {\vert v )}
                    \\,\;\;\;\;\;
                    {\langle w \vert} \;\;\coloneqq\;\; a {\vert w \rangle}
                    \\,.
            %p
              For example, the
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+adjoint"} Hermitian adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi W
                    %mo →
                    %mi.mathscript 𝒱
                  %annotation{:encoding => "application/x-tex"} f^\dagger \,\colon\, W \to \mathscr{V}
              of any linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi.mathscript 𝒱
                    %mo →
                    %mi.mathscript 𝒲
                  %annotation{:encoding => "application/x-tex"} f \,\colon\, \mathscr{V} \to \mathscr{W}
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo †
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msup
                      %mi f
                      %mo *
                    %mo ∘
                    %mi a
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^\dagger {\vert w \rangle}
                    \\;\coloneqq\;
                    a^{-1}\big( {\langle w \vert} f\big)
                    \\;=\;
                    a^{-1} \circ f^\ast \circ a {\vert w \rangle}
                    \\,.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mi w
                        %mo ∈
                        %mi W
                  %annotation{:encoding => "application/x-tex"} \big\{ {\vert w \rangle} \big\}_{w \in W}
              is any
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+basis"} orthonormal basis
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathscr{V}
              with respect to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle - \vert - \rangle
              %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi.mathscript 𝒱
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Map
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi.mathscript 𝒱
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathscr{V}^\ast \,\coloneqq\, Map_{\mathbb{C}}(\mathscr{V}, \mathbb{C})
              as the
              %a.existingWikiWord{:href => "/nlab/show/linear+dual+space"} linear dual space
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
