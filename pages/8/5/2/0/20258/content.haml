          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#Construction"} Milnor’s construction
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#AsNearHorizonGeometriesOfBlackM2Branes"} As near-horizon geometries of black M2-branes
              %li
