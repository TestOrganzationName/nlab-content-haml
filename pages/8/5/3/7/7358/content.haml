            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-groups"} abelian ∞-groups
          %p
            The notion of
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %a.existingWikiWord{:href => "/nlab/show/Segal+category"} Segal category
            for the case that the underlying
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            happens to be an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28%E2%88%9E%2C1%29-category"} connected
            and is equipped with extra structure.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            \-spaces differ from
            %a.existingWikiWord{:href => "/nlab/show/operad"} operadic
            models for
            = succeed "-spaces," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebras
            over an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+operad"} E-∞ operad
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+definition+of+higher+categories"} geometrically
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+definition+of+higher+categories"} algebraically
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Γ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Gamma^{op}
            (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Segal%27s+category"} Segal's category
            %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
            of the category of
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi n
                    %mo ̲
                %annotation{:encoding => "application/x-tex"} \underline{n}
            for the finite pointed set with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            non-basepoint elements. Then a
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              \-space
            is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Γ
                    %mi op
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} X\colon \Gamma^{op}\to Top
            (or to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
            We think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mn 1
                    %mo ̲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\underline{1})
            as the “underlying space” of a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi n
                    %mo ̲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\underline{n})
            being a “model for the cartesian power
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to present an infinite loop space, a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Segal+map"} Segal map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi n
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mn 1
                    %mo ̲
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi …
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mn 1
                    %mo ̲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\underline{n}) \to X(\underline{1}) \times \dots \times X(\underline{1})
          %p
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %munder
                      %mn 0
