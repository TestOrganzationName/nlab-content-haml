            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %munder
                    %mn 0
                    %mo ̲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(\underline{0})
            is contractible. Sometimes the very definition of
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              \-space
            includes this homotopical condition as well.
          %h2#delooping Delooping
          %p
            One of the main advantages of
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "-objects)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            construction is very easy to express in this language.
          %p The delooping construction is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Γ
                    %mi op
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Γ
                    %mi op
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} B\colon Fun(\Gamma^{op},M) \to Fun(\Gamma^{op},M),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the
            %a.existingWikiWord{:href => "/nlab/show/relative+category"} relative category
            for which we are considering
            = succeed "-objects." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} M=sSet
            = succeed "," do
              %span.newWikiWord
                model category of simplicial sets
                %a{:href => "/nlab/new/model+category+of+simplicial+sets"} ?
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
