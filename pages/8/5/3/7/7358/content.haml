                  %mi B
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi hocolim
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ↦
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ×
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (B A)(S) := hocolim (T\mapsto A(S\times T)),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ∈
                  %msup
                    %mi Δ
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                %annotation{:encoding => "application/x-tex"} T\in\Delta^\op
            and the argument of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            functor is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
