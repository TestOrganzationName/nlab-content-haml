          %p So we are trying to guess the content of the not-yet-existsting
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Spectral+Schemes"} Spectral Schemes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            = succeed "." do
