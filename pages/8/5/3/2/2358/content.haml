                  %mi Spec
                  %mi A
                %annotation{:encoding => "application/x-tex"} Spec A
            as the
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} |
                  %mi Spec
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi Spec
                      %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (|Spec A|, \mathcal{O}_{Spec A})
            whose underlying
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is the ordinary spectrum of the degree-0 ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
