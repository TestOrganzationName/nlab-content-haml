                  %msubsup
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"} C^\otimes_{\langle 1\rangle}
            is the fiber over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
