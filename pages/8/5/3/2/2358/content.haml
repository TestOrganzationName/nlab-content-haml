          %p
            Define its
            %span.newWikiWord
              spectrum of an E-infinity ring
              %a{:href => "/nlab/new/spectrum+of+an+E-infinity+ring"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
