                  %mo{:stretchy => "false"} |
                  %mo ≔
                  %mi Spec
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  |Spec A|
                  \\coloneqq
                  Spec \pi_0 A
          %p
            and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi Spec
                      %mi A
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{Spec A}
            is given on Zariski-opens
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(f)
            for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msub
                    %mi π
                    %mn 0
                  %mi A
                %annotation{:encoding => "application/x-tex"} f \in \pi_0 A
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi Spec
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi A
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}_{Spec A}(D(f))
                  \\coloneqq
                  A[f^{-1}]
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A \to A[f^{-1}]
            is characterized by the following equivalent ways:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mi A
                      %mo →
                      %msub
                        %mi π
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet A \to \pi_*(A[f^{-1}])
                identify
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{\bullet}(A[f^{-1}])
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                    %annotation{:encoding => "application/x-tex"} \forall
                = succeed "-rings" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E_\infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(A[f^{-1}],B) \to Hom(A,B)
                is a
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                of the left hand side with the subspace of the right hand side which takes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msub
                        %mi π
                        %mn 0
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f \in \pi_0 A
                to an invertible element of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 0
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \pi_0 B
          %p
            This geometry over
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spectral+algebraic+geometry"} spectral algebraic geometry
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/brave+new+algebra"} brave new algebraic geometry
          %p
            The analog for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+commutative+ring"} simplicial commutative ring
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derived+scheme"} derived scheme
          %p
            %strong theorem
            (
            %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Lurie
            )
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            s a space and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                %annotation{:encoding => "application/x-tex"} \mathcal{O}
            a sheaf of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi π
                    %mn 0
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\pi_0 \mathcal{O}_X)
            is a classical
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %msub
                    %mi 𝒪
                    %mi X
                %annotation{:encoding => "application/x-tex"} \pi_n \mathcal{O}_X
            is a quasicoherent
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \pi_0 \mathcal{O}_X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
          %p
            %strong theorem
            there exists a
            %a.existingWikiWord{:href => "/nlab/show/derived+Deligne-Mumford+stack"} derived Deligne-Mumford stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo ,
                  %msubsup
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                    %mi der
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M_{1,1}, \mathcal{O}^{der}_{M_{1,1}})
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo ,
                  %msub
                    %mi π
                    %mn 0
                  %msubsup
                    %mi 𝒪
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                    %mi der
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M_{1,1}, \pi_0 \mathcal{O}^{der}_{M_{1,1}})
            is the ordinary
            %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+stack"} DM-
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
