                  %annotation{:encoding => "application/x-tex"} C^\otimes
              with an
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"} (infinity,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo ⊗
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\otimes \to N(\Gamma)
              that is a
              %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            is
            %a.existingWikiWord{:href => "/nlab/show/Segal%27s+category"} Segal's category
            with objects finite
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/function"} function
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
