                          %mo →
                        %mtd
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\otimes_{\langle 1\rangle} &amp;\to&amp; C^\otimes
                  \\\
                  \\downarrow &amp;pullback&amp; \downarrow
                  \\\
                  \\{\langle 1\rangle\} &amp;\to&amp; N(\Gamma)
                  }
          %blockquote
            %p
              here should go some pictures that illustarte this. But see the first few pages of
              %a.existingWikiWord{:href => "/nlab/show/Noncommutative+Algebra"} Noncommutative Algebra
              for the intuition and motivation.
          %p
            so let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            now be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric monoidal (infinity,1)-category
          %p
            %strong definition
            A
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+an+%28infinity%2C1%29-category"} commutative monoid in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            of the structure map mentioned above
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
