                %annotation{:encoding => "application/x-tex"} n = (n,1)
            and the stabilization hypothesis
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-category"} (n,1)-category
            is a
            = succeed "-" do
