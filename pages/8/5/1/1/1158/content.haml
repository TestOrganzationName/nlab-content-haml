                      %mi im
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^n(X)/im(\mathbf{d})
          %h3#TheDeligneComplex The Deligne complex
          #TheSmoothDeligneComplex.num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %strong smooth Deligne complex
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n U(1)_{conn})_\bullet
                    \\in
                    Ch_+(Smooth0Type)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mover
