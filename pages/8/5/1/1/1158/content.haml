          .num_remark
            %h6#remark_11 Remark
            %p
              In words the statement of prop.
              %a.maruku-ref{:href => "#CurvatureExactSequence"}
              and prop.
              %a.maruku-ref{:href => "#CharacteristicClassExactSequence"}
              is that Deligne
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi conn
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n+1}_{conn}(X,\mathbb{Z})
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            %ol
              %li
                %p
                  of integral
                  %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                  by differential
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  of closed
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
