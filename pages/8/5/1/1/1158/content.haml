                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : [0,1] \to X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn 1
                    %msup
                      %mi γ
                      %mo *
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp (2 \pi i\int_0^1 \gamma^* A)
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi f
                  %mo :
                  %msub
                    %mi tra
                    %mi A
                  %mo →
                  %msub
                    %mi tra
                    %mrow
                      %mi A
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \eta_f : tra_A \to tra_{A'}
            between two such functors is in components precisely a smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : X \to U(1)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                    %mo =
                    %mi A
                    %mo +
                    %mi d
                    %mi log
                    %mi f
                  %annotation{:encoding => "application/x-tex"} A' = A + d log f
          %p
            Since the analogous statements are true for every open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            this defines a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Funct
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi LieGrpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Funct^\infty(P_1(-), \mathbf{B}U(1)) : Op(X)^{op} \to LieGrpd
                  \\,.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            this sheaf of groupoids corresponds to a sheaf of complexes of groups. This complex of sheaves is nothing but the degree 2 Deligne complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Funct
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℤ
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi D
                    %mn ∞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Funct^\infty(\Pi_1(-), \mathbf{B}U(1)) \simeq \mathbb{Z}(2)^\infty_D
                  \\,.
          %p
            This way Deligne cohomology is realized as computing the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-sheafification"} stackification
            of the pre-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Funct
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Funct^\infty(P_1(-), \mathbf{B}(1))
            of smooth
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
          %p
            The identification generalizes: for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            there is a
            %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_n(X)
            whose
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi tra
                    %mi C
                  %msub
                    %mo :
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} tra_C : _n(X) \to \mathbf{B}^n U(1)
            are canonically identified with smooth
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \in \Omega^n(X)
            and under the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            the Deligne-complex in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            is identified with the sheaf of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-functors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %msup
                    %mi Funct
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℤ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi D
                    %mn ∞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  n Funct^\infty(P_n(-), \mathbf{B}^n)
                  \\simeq
                  \\mathbb{Z}(n+1)^\infty_D
                  \\,.
          %p See
          %ul
            %li
              John Baez, Urs Schreiber,
              %em Higher Gauge Theory
              (
              %a{:href => "http://arxiv.org/abs/math/0511710"}> arXiv
              )
          %p
            The full proof for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            this is in
          %ul
            %li
              Urs Schreiber, Konrad Waldorf,
              %em Parallel transport and functors
              (
              %a{:href => "http://arxiv.org/abs/0705.0452"}> arXiv
              );
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n=2
            in
          %ul
            %li
              Urs Schreiber, Konrad Waldorf,
              %em Smooth functors versus differential forms
              (
              %a{:href => "http://arxiv.org/abs/0802.0663"}> arXiv
              )
          %p
            For more on this see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory+introduction"} infinity-Chern-Weil theory introduction
          %p
            For higher
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            there is as yet no detailed proof in the literature, but the low dimensional proofs have obvious generalizations.
          %h2#examples Examples
          %p
            As described in some detail at
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            in abelian higher
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theories
            the background field naturally arises as a
            = succeed "\u2013Deligne" do
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cocycle
            representative with values in the Deligne complex.
          %ul
            %li
              %p
                Degree 2 Deligne cohomology classifies
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo{:stretchy => "false"} ¯
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \bar \mathbf{B}U(1)
                in this case coincides with the
                %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
                for the Lie algebra of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
              %ul
                %li
                  In physics the
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                  is modeled by a degree 2 Deligne cocycle. See there for a derivation of
                  = succeed "\u2013Deligne" do
                    %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech
            %li
              %p
                Degree 3 Deligne cohomology classifies
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
              %ul
                %li
                  In
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
                  %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
                  is modeled by a Deligne 3-cocycle.
            %li
              %p
                Degree 4 Deligne cohomology classifies
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(n)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %ul
                %li
                  In formal high energy physics degree 4 Deligne classes model the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hodge-filtered+differential+cohomology"} Hodge-filtered differential cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobian"} intermediate Jacobian
                (
                %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"}> self-dual higher gauge theory
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Abel-Jacobi+map"} Abel-Jacobi map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulator"} Beilinson regulator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            %li
              %p
                %a{:href => "differential+cohomology+diagram#DeligneCoefficients"} differential cohomology diagram – Examples – Deligne coefficients
          %h2#References References
          %p
            Deligne cohomology was introduced in
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            (by a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+differential+forms"} holomorphic differential forms
          %ul
            %li#Deligne71
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              , Section 2.2 of:
              = succeed "," do
                %em Théorie de Hodge II
              = succeed ")" do
                %a{:href => "http://www.numdam.org/item/?id=PMIHES_1971__40__5_0"} numdam:PMIHES_1971__40__5_0
          %p
            with applications to
            %a.existingWikiWord{:href => "/nlab/show/Hodge+theory"} Hodge theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intermediate+Jacobians"} intermediate Jacobians
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"}> Barry Mazur
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/William+Messing"} William Messing
                = succeed "," do
                  %em Universal extensions and one-dimensional crystalline cohomology
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/BFb0061628"} doi:10.1007/BFb0061628
            %li#ArtinMazur77
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Artin"}> Michael Artin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"} Barry Mazur
                = succeed "," do
                  %em Formal Groups Arising from Algebraic Varieties
                = succeed "," do
                  %a{:href => "http://www.numdam.org/item?id=ASENS_1977_4_10_1_87_0"} numdam:ASENS_1977_4_10_1_87_0
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=56:15663"} MR56:15663
          %p
            under the name “multiplicative de Rham complex” (and in the context of studying its
            %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
            by
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Artin-Mazur+formal+groups"} Artin-Mazur formal groups
          %ul
            %li#Beilinson85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Beilinson"}> Alexander Beilinson
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+regulators+and+values+of+L-functions"} Higher regulators and values of L-functions
                = succeed "," do
                  %a{:href => "http://www.mathnet.ru/php/archive.phtml?wshow=paper&jrnid=intd&paperid=73&option_lang=eng"} mathnet (Russian)
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1007%2FBF02105861"} DOI
              %p
                English translation: J Math Sci 30, 2036–2070 (1985) (
                %a{:href => "https://doi.org/10.1007/BF02105861"}> doi:10.1007/BF02105861
                )
              %blockquote
                %p
                  (reviewed in
                  = succeed ")" do
                    %a{:href => "#EsnaultViehweg88"} Esnault-Viehweg 88
          %p
            with the application to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Beilinson+regulators"} Beilinson regulators
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            over
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            gained more attention and is still referred to as “Deligne cohomology”.
          %p
            Identifying the
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            in
            %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            (
            %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle+gerbe"} with connection
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Krzysztof+Gaw%C4%99dzki"}> Krzysztof Gawędzki
              ,
              = succeed "," do
                %em Topological Actions in two-dimensional Quantum Field Theories
              = succeed "," do
                %em Nonperturbative quantum field theory
              = succeed "," do
                %strong 185
              = succeed "," do
                %a{:href => "http://inspirehep.net/record/257658"} spire:257658
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-1-4613-0729-7_5"} doi:10.1007/978-1-4613-0729-7_5
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Gawedzki-TopologicalActions.pdf", :title => "pdf"} pdf
          %p
            Surveys and introductions in the context of
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            include
          %ul
            %li#Brylinski93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
                , section I.5 of:
                = succeed "," do
                  %em Loop Spaces, Characteristic Classes and geometric Quantization
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-0-8176-4731-5"} doi:10.1007/978-0-8176-4731-5
            %li#Bunke12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                , section 3 of
                %em Differential cohomology
                (
                %a{:href => "http://arxiv.org/abs/1208.3961"}> arXiv:1208.3961
