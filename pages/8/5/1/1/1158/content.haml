          #CharacteristicClassExactSequence.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong (characteristic class exact sequence)
            %p
              The Deligne cohomology group fits into a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
