                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \cdots
                    \&amp;&amp; \downarrow
                    \\\
                    \\mathbb{R}
                    \&amp;\stackrel{\mathbf{d}}{\to}&amp;
                    \\mathbf{\Omega}^1
                    \&amp;\stackrel{\mathbf{d}}{\to}&amp;
                    \\mathbf{\Omega}^2
                    \&amp;\stackrel{\mathbf{d}}{\to}&amp;
                    \\cdots
                    \&amp;\stackrel{\mathbf{d}}{\to}&amp;
                    \\mathbf{\Omega}^{n+1}_{cl}
                    }
            %p
              is a weak equivalence in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#FibrantOnjectStructureOnChSmooth"}
          .proof
            %h6#proof Proof
            %p
              By the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+lemma"} Poincaré lemma
              %em is
              the Poincaré Lemma.
          %p
            Every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mo •
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo +
                  %mo{:stretchy => "false"} (
                  %mi Smooth
                  %mn 0
                  %mi Type
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A_\bullet \in Ch_+(Smooth0Type)
            serves as the
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            for an
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            theory on smooth manifolds. Abelian sheaf cohomology has a general abstract characterization (see at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-spaces"} derived hom-spaces
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            \.
          #CechComplex.num_defn
            %h6#definition_5 Definition
            %p
              %strong (Čech complex)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_\bullet \in Ch_+(Smooth0Type)
              be a sheaf of chain complexes. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              be a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
