                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
          #DeRhamTheorem.num_example
            %h6#example_6 Example
            %p
              Passing to
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              (e.g. via def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CechComplex"}
              %a.maruku-ref{:href => "#TheDeRhamResolutionOfConstantFunctions"}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
          %p We will have need to give names to truncations of the de Rham complex. One is this:
          #TruncatedDeRham.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{\bullet \leq n} \in Ch_+(Smooth0Type)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                    %mo ≔
                    %mrow
                      %mo [
                      %mi ℝ
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mn 1
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %mi ⋯
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{\bullet \leq n}
                    \\coloneqq
                    \\left[
                    \\mathbb{R}
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^1
                    \\stackrel{\mathbf{d}}{\to}
                    \\cdots
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^{n-1}
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^{n}
                    \\right]
            %p
              with all
              = succeed "-forms," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          #CohomologyWithCoefficientsInTruncatedDeRham.num_example
            %h6#example_7 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              of the truncated de Rham complex in def.
              %a.maruku-ref{:href => "#TruncatedDeRham"}
