                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^0_{Cech}(X, (\flat\mathbf{B}^{n}U(1))_\bullet)
                    \\simeq
                    H^{n}(X,U(1))
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
