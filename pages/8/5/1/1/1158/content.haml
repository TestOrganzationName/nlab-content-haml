              is the characteristic class map of def.
              = succeed "." do
                %a.maruku-ref{:href => "#UnderlyingBundleMap"}
          .proof
            %h6#proof_8 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              that represents the
              %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
              by def.
              %a.maruku-ref{:href => "#UnderlyingBundleMap"}
              is manifestly a fibration in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#FibrantOnjectStructureOnChSmooth"}
