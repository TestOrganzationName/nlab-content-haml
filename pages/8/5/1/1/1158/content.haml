                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat \mathbb{R}
                    \&amp;\stackrel{}{\to}&amp;
                    0
                    \&amp;\stackrel{}{\to}&amp;
                    0
                    \&amp;\stackrel{}{\to}&amp;
                    \\cdots
                    \&amp;\stackrel{}{\to}&amp;
                    0
