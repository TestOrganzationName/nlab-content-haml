          #GoodCoverCechCohomologyIsHomotopicallyGood.num_remark
            %h6#remark_7 Remark
            %p
              For analyzing the properties of Deligne cohomology
              = succeed "," do
                %a{:href => "#Properties"} below
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinity-cohesive+site"} infinity-cohesive site
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              (in particular
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  admits a
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                  (by
                  %a.existingWikiWord{:href => "/nlab/show/charts"} charts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  all whose finite non-empty intersections are
                  %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
                  to an
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %li
                %p
                  for any such good open cover the
                  %a{:href => "&#268;ech+cohomology#CechComplex"} Cech complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi A
                          %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\bullet((X,\{U_i\}),A_\bullet)
                  already computes Cech cohomology (i.e. there is no further need to form the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  of Cech complexes over refinements of covers);
              %li
                %p
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Ch
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi Smooth
                        %mn 0
                        %mi Type
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Ch
                          %mo +
                      %annotation{:encoding => "application/x-tex"} C^\bullet((X,\{U_i\}),-) \colon Ch_+(Smooth0Type) \to Ch_+
                  preserves weak equivalences and fibrations.
            %p
              This means in particular that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet \to Y_\bullet \to Z_\bullet
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ch
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi Smooth
                      %mn 0
                      %mi Type
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch_+(Smooth0Type)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi Z
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\bullet((X,\{U_i\}), X_\bullet)
                    \\to
                    C^\bullet((X,\{U_i\}), Y_\bullet)
                    \\to
                    C^\bullet((X,\{U_i\}), Z_\bullet)
            %p
              is a homotopy fiber sequence of chain complexes, and therefore the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              sit in the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
              of this sequence of chain complexes.
          #OrdinaryCohomologyFromCechCohomology.num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet = (\mathbf{B}^{n+1}\mathbb{Z})_\bullet
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopingsOfAbelianSheaf"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Cech
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^0_{Cech}(X, (\mathbf{B}^{n+1}\mathbb{Z})_\bullet)
                    \\simeq
                    H^{n+1}(X,\mathbb{Z})
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Similarly for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet = (\flat \mathbf{B}^n U(1))_{\bullet}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Cech
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
