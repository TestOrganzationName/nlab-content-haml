              is already its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              = succeed "," do
                %a.maruku-ref{:href => "#InclusionOfGloballyDefinedConnectionForms"}
            %p
              Therefore the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
