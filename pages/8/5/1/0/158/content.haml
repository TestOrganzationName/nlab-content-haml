            The notion of an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
          %p
            An
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C0%29-category"} (∞,0)-category
            – is an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
            in which, for all natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"} k-morphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
          %p
            The collection of all
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %p
            Special cases of
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
