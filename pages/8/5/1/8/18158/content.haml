          .proof
            %h6#proof_10 Proof
            %p
              The first statement is immediate from the adjunction law (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#GaloisConnectionAsAdjunction"}
            %p
              Regarding the second statement: This holds because applied to sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I_E(T)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi I
                        %mi E
                      %mo ∘
                      %msub
                        %mi V
                        %mi E
                      %mo ∘
                      %msub
                        %mi I
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I_E(T) \subset I_E \circ V_E \circ I_E(T)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi E
                  %annotation{:encoding => "application/x-tex"} I_E
              to the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ⊂
                      %msub
                        %mi V
                        %mi E
                      %mo ∘
                      %msub
                        %mi I
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T \subset V_E \circ I_E(T)
              = succeed "." do
