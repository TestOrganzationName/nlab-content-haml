                            %mi q
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi p
                            %mo ⊂
                            %mi q
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi q
                            %mo ∈
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; q \in Cl(\{q\})
                    \\\
                    \\Leftrightarrow\; &amp;
                    q \in
                    \\underset{ {I \in Idl(R)} \atop { p \in V(I) }   }{\cap} V(I)
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    \\underset{ { I \in Idl(R) } \atop { I \subset p } }{\forall} (q \in V(I))
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    \\underset{ { I \in Idl(R) } \atop { I \subset p } }{\forall} (I \subset q)
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    p \subset q
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    q \in V(p)
                    \\end{aligned}
          %p Recall:
          #PrimeIdealTheorem.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/prime+ideal+theorem"}> prime ideal theorem
                )
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              or at least the
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
              then:
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} I \subset R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/proper+ideal"} proper ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is contained in some
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            even implies that every proper ideal is contained in a
            %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            (by
            = succeed ")." do
              %a{:href => "maximal+ideal#EveryProperIdealisContainedInAMaximalOne"} this prop.
          #MaximalIdealsAreClosedPoints.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/maximal+ideals"} maximal ideals
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+points"} closed points
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi PrimeIdl
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi τ
                        %mrow
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi R
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(R) = (PrimeIdl(R),\tau_{Spec(R)})
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum
              equipped with the Zariski topology from def.
              = succeed "." do
                %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideals"} maximal ideals
              inside the prime ideals constitute
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+points"} closed points
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              or at least the
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
              then also the converse is true:
            %p
              Then the inclusion of
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideals"} maximal ideals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ∈
                    %mi MaxIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in MaxIdl(R) \subset PrimeIdl(R)
              into all
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
              is precisely the inclusion of the subset of
              %a.existingWikiWord{:href => "/nlab/show/closed+points"} closed points
              into all points of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(R)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ClosedPoints
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi MaxIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ClosedPoints(Spec(R)) \simeq MaxIdl(R) \subset PrimeIdl(R)
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#ZariskiClorsuredOfPont"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\{p\}) = V(p)
            %p and hence we need to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi 𝔪
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\{\mathfrak{m}\} = V(\mathfrak{m})
            %p
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is maximal.
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is maximal. By definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi 𝔪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathfrak{m})
              contains all the prime ideals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo ⊂
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is maximal means that it is not contained in a larger proper ideal, in particular not in any larger prime ideal, and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi 𝔪
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi 𝔪
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} V(\mathfrak{m}) = \{\mathfrak{m}\}
            %p
              In the other direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              is a prime ideal such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi 𝔪
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi 𝔪
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} V(\mathfrak{m}) = \{\mathfrak{m}\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊂
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset p
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              itself. We need to show that more generally
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset I
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              any
              %a.existingWikiWord{:href => "/nlab/show/proper+ideal"} proper ideal
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo =
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} = I
            %p
              But the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
              imply the
              %a.existingWikiWord{:href => "/nlab/show/prime+ideal+theorem"} prime ideal theorem
              (lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#PrimeIdealTheorem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mi p
                    %annotation{:encoding => "application/x-tex"} I \subset p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo ⊂
                      %mi I
                      %mo ⊂
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset I \subset p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo ⊂
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} \subset p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo =
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} = p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi 𝔪
                    %annotation{:encoding => "application/x-tex"} I = \mathfrak{m}
          %h4#irreducible_closed_subsets_as_prime_ideals_2 Irreducible closed subsets as prime ideals
          #ZariskiIrreducibleClosedSubsetsArePreciselyPrimeIdeals.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subsets"} irreducible closed subsets
                correspond to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            %p
              With
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              then:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset R
              be an ideal in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) \subset Spec(R)
              is a Zariski closed subset in the
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℱ
                      %annotation{:encoding => "application/x-tex"} \mathcal{F}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/radical+ideal"} radical ideal
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi ℱ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subset"} irreducible closed subset
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℱ
                      %annotation{:encoding => "application/x-tex"} \mathcal{F}
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
          .proof
            %h6#proof_7 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              is irreducible, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f,g \in R
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %mi g
                      %mo ∈
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} f \cdot g \in \mathcal{F}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{F}
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} g \in \mathcal{F}
            %p To this end, first observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F}) \subset V((f)) \cup V((g))
                    \\,.
            %p This is because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mi p
                            %mo ∈
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi ℱ
                            %mo ⊂
                            %mi p
                        %mtr
                          %mtd
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi f
                            %mo ⋅
                            %mi g
                            %mo ∈
                            %mi p
                        %mtr
                          %mtd
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %mo ∈
                              %mi p
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi g
                              %mo ∈
                              %mi p
                              %mo )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mrow
                              %mo (
                              %mi p
                              %mo ∈
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi p
                              %mo ∈
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi p
                            %mo ∈
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; p \in V(\mathcal{F})
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    \\mathcal{F} \subset p
                    \\\
                    \\Rightarrow \;
                    \&amp;
                    f \cdot g \in p
                    \\\
                    \\Rightarrow\;
                    \&amp;
                    \\left(
                    f \in p
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    g \in p
                    \\right)
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    \\left(
                    p \in V(g)
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    p \in V(f)
                    \\right)
                    \\\
                    \\Leftrightarrow\;
                    \&amp;
                    p \in V(f) \cup V(g)
                    \\,,
                    \\end{aligned}
            %p
              where the implication in the middle uses that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a prime ideal.
            %p It follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ∪
                    %mrow
                      %mo (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F})
                    \\;=\;
                    \\left(
                    V(f) \cap V(\mathcal{F})
                    \\right)
                    \\cup
                    \\left(
                    V(g) \cap V(\mathcal{F})
                    \\right)
                    \\,.
            %p
              This is a decomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              as a union of closed subsets, hence the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              is irreducible implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %mrow
                              %mo (
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo ∩
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo ∩
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %mrow
                              %mo (
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo ⊂
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo ⊂
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thinmathspace"}
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %mo ∈
                              %mi nil
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi g
                              %mo ∈
                              %mi nil
                              %mo{:stretchy => "false"} (
                              %mi ℱ
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thinmathspace"}
                          %mtd
                            %mrow
                              %mo (
                              %mi f
                              %mo ∈
                              %mi ℱ
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mtext or
                            %mspace{:width => "thinmathspace"}
                            %mrow
                              %mo (
                              %mi g
                              %mo ∈
                              %mi ℱ
                              %mo )
                            %mo ,
                        %mtr
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp;
                    \\left(
                    V(\mathcal{F}) = V(f) \cap V(\mathcal{F})
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    V(\mathcal{F}) = V(g) \cap V(\mathcal{F})
                    \\right)
                    \\\
                    \\Leftrightarrow
                    \&amp;
                    \\left(
                    V(\mathcal{F})
                    \\subset
                    V(f)
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    V(\mathcal{F}) \subset V(g)
                    \\right)\\
                    \\Leftrightarrow\,&amp;
                    \\left(
                    f \in nil(\mathcal{F})
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    g \in nil(\mathcal{F})
                    \\right)\\
                    \\Leftrightarrow\,&amp;
                    \\left(
                    f \in \mathcal{F}
                    \\right)
                    \\,\text{or}\,
                    \\left(
                    g \in \mathcal{F}
                    \\right),\\
                    \\end{aligned}
            %p
              where the last equivalence uses the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/radical+ideal"} radical ideal
            %p
              Now for the converse. Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              is a prime ideal and that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℱ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℱ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) = V(\mathcal{F}_1) \cup V(\mathcal{F}_2)
              %a{:href => "#WellDefinedZariskiTopologyOnSpecRProof"} proof
              of prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#WellDefinedZariskiTopologyOnSpecR"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                      %mo =
                      %msub
                        %mi ℱ
                        %mn 1
                      %mo ⋅
                      %msub
                        %mi ℱ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{F} = \mathcal{F}_1 \cdot \mathcal{F}_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℱ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) = V(\mathcal{F}_1)
              or that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo =
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℱ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(\mathcal{F} = V(\mathcal{F}_2))
            %p
              Suppose on the contrary that neither
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}_1
              nor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}_2
              coincided with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msub
                      %mi ℱ
                      %mn 1
                    %mo \
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} f \in \mathcal{F}_1 \backslash \mathcal{F}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %msub
                      %mi ℱ
                      %mn 2
                    %mo \
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} g \in \mathcal{F}_2 \backslash \mathcal{F}
              such that still
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %mi g
                      %mo ∈
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} f \cdot g \in \mathcal{F}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          %p As a corollary:
          #ZariskiTopologyIsSober.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"}> Zariski topology on prime spectra is sober
                )
            %p
              With
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              and
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              (or at least the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter+principle"} ultrafilter principle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(R)
              (its
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectr
              equipped with the Zariski topology of def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober topological space
          .proof
            %h6#proof_8 Proof
            %p We need to show that the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi IrrClSub
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\{-\})
                    \\;\colon\;
                    PrimeIdl(R)
                    \\longrightarrow
                    IrrClSub(Spec(R))
            %p
              which sends a point to its topological closure, is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %p
              By lemma
              %a.maruku-ref{:href => "#ZariskiClorsuredOfPont"}
              this function is given by sending a
              %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \in PrimeIdl(R)
              to the Zariski closed subset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(p)
              = succeed "." do
                %a.maruku-ref{:href => "#ZariskiIrreducibleClosedSubsetsArePreciselyPrimeIdeals"}
          %h3#examples_2 Examples
          #AffinSpaceAsPrimeSpectrum.num_example
            %h6#example_2 Example
            %p
              %strong (affine space as prime spectrum)
            %p
              Reconsider the case where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R = k[X_1,\cdots, X_n]
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              = succeed "." do
                %a{:href => "#OnAffineSpace"} above
            %p
              Observe that, by
              = succeed "," do
                %a.maruku-ref{:href => "#MaximalIdealsAreClosedPoints"}
              %a.existingWikiWord{:href => "/nlab/show/closed+points"} closed points
              in the
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(k[X_1, \cdots, X_n])
              correspond to the
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideals"} maximal ideals
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mo −
                      %msub
                        %mi a
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 2
                      %mo −
                      %msub
                        %mi a
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mi n
                      %mo −
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (a_1, \cdots, a_n)
                    \\coloneqq
                    \\left(
                    (X_1 - a_1) \cdot (X_2 - a_2) \cdots (X_n - a_n)
                    \\right)
            %p and hence are in bijection with the points of the naive affine space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                    %mo ≃
                    %mi MaxIdl
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    k^n \simeq MaxIdl(k[X_1, \cdots, X_n])
                    \\,.
            %p
              There is however also
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
