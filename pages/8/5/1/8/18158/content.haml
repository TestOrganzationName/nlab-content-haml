          %h3#PropertiesOnAffineVarieties Properties
          %p
            We discuss some properties of the Zariski topology on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prime+spectra+of+commutative+rings"} prime spectra of commutative rings
          %h4#topological_closures_2 Topological closures
          #ZariskiClorsuredOfPont.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                of points)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              and consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(R) = (PrimeIdl(R), \tau_{Spec(R)})
              its
              %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum
              equipped with the Zariski topology (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              of a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \in PrimeIdl(R)
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
