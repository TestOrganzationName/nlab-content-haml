              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
          .proof
            %h6#proof_5 Proof
            %p
              By definition the topological closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
