                  (this special case is what motivates the terminology “prime ideal”);
              %li
                %p
                  the ideal
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
