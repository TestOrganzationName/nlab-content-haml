                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} f_i(a_1, \cdots, a_n) \in k
              is non-zero.
          %h3#properties Properties
          %h4#topological_closures Topological closures
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    S \subset k^n
            %p
              of the underlying set of the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              with itself. Then the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(S)
              of this subset with respect to the Zariski topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %msubsup
                          %mi 𝔸
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \tau_{\mathbb{A}^n_k}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mrow
                      %mo (
                      %mrow
                        %mo {
                        %mi f
                        %mo ∈
                        %mi k
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi X
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thinmathspace"}
                        %munder
                          %mo ∀
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi a
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi a
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %mi S
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi a
                          %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi a
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mo }
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cl(S)
                    \\;=\;
                    V \left(
                    \\left\{
                    f \in k[X_1, \cdots, X_n]
                    \\,\vert\,
                    \\underset{(a_1, \cdots, a_n) \in S}{\forall} f(a_1, \cdots, a_n) = 0
                    \\right\}
                    \\right)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Cl
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi C
                                    %mo ⊂
                                    %msup
                                      %mi k
                                      %mi n
                                    %mspace{:width => "thinmathspace"}
                                    %mtext closed
                                %mrow
                                  %mrow
                                    %mi C
                                    %mo ⊃
                                    %mi S
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi ℱ
                                    %mo ⊂
                                    %mi k
                                    %mo{:stretchy => "false"} [
                                    %msub
                                      %mi X
                                      %mn 1
                                    %mo ,
                                    %mi ⋯
                                    %mo ,
                                    %msub
                                      %mi X
                                      %mi n
                                    %mo{:stretchy => "false"} ]
                                %mrow
                                  %mrow
                                    %mi S
                                    %mo ⊂
                                    %mi V
                                    %mo{:stretchy => "false"} (
                                    %mi ℱ
                                    %mo{:stretchy => "false"} )
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi V
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi ℱ
                                      %mo ⊂
                                      %mi k
                                      %mo{:stretchy => "false"} [
                                      %msub
                                        %mi X
                                        %mn 1
                                      %mo ,
                                      %mi ⋯
                                      %mo ,
                                      %msub
                                        %mi X
                                        %mi n
                                      %mo{:stretchy => "false"} ]
                                  %mrow
                                    %mrow
                                      %mi S
                                      %mo ⊂
                                      %mi V
                                      %mo{:stretchy => "false"} (
                                      %mi ℱ
                                      %mo{:stretchy => "false"} )
                              %mi ℱ
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi V
                            %mrow
                              %mo (
                              %mrow
                                %mo {
                                %mi f
                                %mo ∈
                                %mi k
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi X
                                  %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi X
                                  %mi n
                                %mo{:stretchy => "false"} ]
                                %mspace{:width => "thinmathspace"}
                                %mo{:stretchy => "false"} |
                                %mspace{:width => "thinmathspace"}
                                %munder
                                  %mo ∀
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi a
                                      %mn 1
                                    %mo ,
                                    %mi ⋯
                                    %mo ,
                                    %msub
                                      %mi a
                                      %mi n
                                    %mo{:stretchy => "false"} )
                                    %mo ∈
                                    %mi S
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi a
                                  %mn 1
                                %mo ,
                                %mi ⋯
                                %mo ,
                                %msub
                                  %mi a
                                  %mi n
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mn 0
                                %mo }
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Cl(S)
                    \&amp; \coloneqq
                    \\underset{ {C \subset k^n \, \text{closed}} \atop {C \supset S} }{\cap}
                    C
                    \\\
                    \&amp; =
                    \\underset{
                    { \mathcal{F} \subset k[X_1, \cdots, X_n] }
                    \\atop
                    { S \subset V(\mathcal{F}) }
                    }{\cap} V(\mathcal{F})
                    \\\
                    \&amp; =
                    V\left(
                    \\underset{
                    { \mathcal{F} \subset k[X_1, \cdots, X_n] }
                    \\atop
                    { S \subset V(\mathcal{F}) }
                    }{\cup} \mathcal{F}
                    \\right)
                    \\\
                    \&amp; =
                    V \left(
                    \\left\{
                    f \in k[X_1, \cdots, X_n]
                    \\,\vert\,
                    \\underset{(a_1, \cdots, a_n) \in S}{\forall} f(a_1, \cdots, a_n) = 0
                    \\right\}
                    \\right)
                    \\,.
                    \\end{aligned}
            %p
              Here the first equality is the definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              = succeed ")," do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
              = succeed "," do
                %a.maruku-ref{:href => "#VerifyingZariskiTopologyOnAffineSpace"}
          %h4#irreducible_closed_subsets_as_prime_ideals Irreducible closed subsets as prime ideals
          %p
            In every
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            the
            %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subsets"} irreducible closed subsets
            play a special role, as being precisely the points in the space as seen in its incarnation as a
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            (
            %a{:href => "irreducible%20closed%20subspace#FrameHomomorphismsToPointAreIrrClSub"}> this prop.
            ). The following shows that in the Zariski topology the irreducible closed subsets all come from
            %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            in the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"} schemes are sober
          #VanishingIdeal.num_defn
            %h6#definition_3 Definition
            %p
              %strong>
                (
                %a.existingWikiWord{:href => "/nlab/show/vanishing+ideal"} vanishing ideal
                of Zariski closed subset)
              \#
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) \subset k^n
              a Zariski closed subset, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset k[X_1, \cdots, X_n]
              a set of polynomials, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    I(V(\mathcal{F}))
                    \\subset
                    k[X_1, \cdots, X_n]
            %p for the maximal subset of polynomials that still has the same joint vanishing set:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi f
                      %mo ∈
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %munder
                        %mo ∀
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi a
                            %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi a
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi V
                          %mo{:stretchy => "false"} (
                          %mi ℱ
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I(V(\mathcal{F}))
                    \\;\coloneqq\;
                    \\left\{
                    f \in k[X_1, \cdots, X_n]
                    \\,\vert\,
                    \\underset{(a_1, \cdots, a_n) \in V(\mathcal{F})}{\forall} f(a_1, \cdots, a_n) = 0
                    \\right\}
                    \\,.
            %p
              This set is clearly an
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              in the
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              %em
                %a.existingWikiWord{:href => "/nlab/show/vanishing+ideal"} vanishing ideal
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
          #PrimeVanishingIdealOfIrreducibleZariskiClosed.num_prop
            %h6#proposition_3 Proposition
            %p
              With
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              then:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) \subset k^n
              be a Zariski closed subset (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi ℱ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/irreducible+closed+subset"} irreducible closed subset
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/vanishing+ideal"} vanishing ideal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi ℱ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} I(V(\mathcal{F}))
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#VanishingIdeal"}
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime ideal
          .proof
            %h6#proof_3 Proof
            %p
              In one direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              is irreducible and consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f,g \in k[X_1, \cdots, X_n]
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %mi g
                      %mo ∈
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \cdot g \in I(V(\mathcal{F}))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in I(V(\mathcal{F}))
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ℱ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g \in I(V(\mathcal{F}))
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a field, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi g
                      %mo{:stretchy => "false"} (
