                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi I
                                    %mo ∈
                                    %mi Idl
                                    %mo{:stretchy => "false"} (
                                    %mi R
                                    %mo{:stretchy => "false"} )
                                %mrow
                                  %mrow
                                    %mi p
                                    %mo ∈
                                    %mi V
                                    %mo{:stretchy => "false"} (
                                    %mi I
                                    %mo{:stretchy => "false"} )
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %munder
                              %mo ∀
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi I
                                    %mo ∈
                                    %mi Idl
                                    %mo{:stretchy => "false"} (
                                    %mi R
                                    %mo{:stretchy => "false"} )
                                %mrow
                                  %mrow
                                    %mi I
                                    %mo ⊂
                                    %mi p
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo ∈
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %munder
                              %mo ∀
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi I
                                    %mo ∈
                                    %mi Idl
                                    %mo{:stretchy => "false"} (
                                    %mi R
                                    %mo{:stretchy => "false"} )
                                %mrow
                                  %mrow
                                    %mi I
                                    %mo ⊂
                                    %mi p
                            %mo{:stretchy => "false"} (
                            %mi I
