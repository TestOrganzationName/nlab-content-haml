                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    f(a_1, \cdots a_n) \cdot g(a_1, \cdots, a_n) = 0
                    \\right)
                    \\Rightarrow
                    \\left(
                    \\left(
                    f(a_1, \cdots, a_n) = 0
                    \\,\text{or}\,
                    g(a_1, \cdots, a_n) = 0
                    \\right)
                    \\right)
                    \\,.
            %p This implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F}) \subset V(\{f\}) \cup V(\{g\})
            %p and hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
