                    %mi I
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\{p\})=\underset{ {I \in Idl(R) } \atop { p \in V(I) }  }{\cap} V(I)
                    \\,.
            %p Hence unwinding the definitions, we have the following sequence of logical equivalences:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
