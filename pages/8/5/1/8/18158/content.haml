                    %annotation{:encoding => "application/x-tex"} V(\mathcal{F}) = V(\mathcal{F}_2)
            %p Assume on the contrary, that there existed elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} (
