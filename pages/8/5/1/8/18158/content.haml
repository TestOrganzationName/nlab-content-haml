                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi T
                        %annotation{:encoding => "application/x-tex"} V_E \circ I_E(T) = T
              %li
                %p
                  the
                  %em closure
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ∈
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T \in P(Y)
                  is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cl
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ≔
                          %msub
                            %mi V
                            %mi E
                          %mo ∘
                          %msub
                            %mi I
                            %mi E
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cl(T) \coloneqq V_E \circ I_E(T)
          %p
            It follows from the properties of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closure+operators"} closure operators
            = succeed ":" do
              %a.maruku-ref{:href => "#GaloisClosureOperator"}
          #GaloisFixedPoints.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#GaloisConnection"}
            %ol
              %li
                %p
                  the closed elements of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} P(X)
                  are precisely those in the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} im(I_E)
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi I
                            %mi E
                        %annotation{:encoding => "application/x-tex"} I_E
              %li
                %p
                  the closed elements of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} P(Y)
                  are precisely those in the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} im(V_E)
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi V
                            %mi E
                        %annotation{:encoding => "application/x-tex"} V_E
            %p
              We says these are the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed points
              of the Galois connection. Therefore the restriction of the Galois connection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi V
                            %mi E
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi I
                            %mi E
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    P(X)
                    \\underoverset{\underset{V_E}{\longrightarrow}}{\overset{I_E}{\longleftarrow}}{\bot}
                    P(Y)^{op}
            %p
              to these fixed points yields an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mi E
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ≃
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi V
                            %mi E
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi I
                            %mi E
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    im(I_E)
                    \\underoverset{\underset{V_E}{\longrightarrow}}{\overset{I_E}{\longleftarrow}}{\simeq}
                    im(V_E)^{op}
            %p
              now called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Galois+correspondence"} Galois correspondence
          .num_prop
            %h6#proposition_13 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#GaloisConnection"}
              %a.maruku-ref{:href => "#GaloisClosedElements"}
              are closed under forming
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
          .proof
            %h6#proof_11 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi T
                      %mi i
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{T_i \in P(Y)\}_{i: I}
              is a collection of elements closed under the operator
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo =
                      %msub
                        %mi V
                        %mi E
                      %mo ∘
                      %msub
                        %mi I
                        %mi E
                    %annotation{:encoding => "application/x-tex"} K = V_E \circ I_E
              %a.maruku-ref{:href => "#GaloisClosureOperator"}
              it is automatic that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi i
                          %mo :
                          %mi I
                      %msub
                        %mi T
                        %mi i
                      %mo ⊂
                      %mi K
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi i
                          %mo :
                          %mi I
                      %msub
                        %mi T
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \bigcap_{i: I} T_i \subset K(\bigcap_{i: I} T_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi T
                      %mi i
                    %mo ⊂
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcap_{i: I} T_i \subset T_i
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is covariant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} T_i
              is closed, we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi T
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} K(\bigcap_{i: I} T_i) \subset K(T_i) \subset T_i
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi T
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo :
                        %mi I
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} K(\bigcap_{i: I} T_i) \subset \bigcap_{i: I} T_i
              follows.
          %h3#GaloisConnectionAppliedToAffineSpace Applied to affine space
          %p
            We now redo the discussion of the Zariski topology on the affine space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mi n
                %annotation{:encoding => "application/x-tex"} k^n
            from
            %a{:href => "#OnAffineSpace"} above
            as a special case of the general considerations of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Galois+connections"} Galois connections
          #ZariskiClosedSubsetsInaffineViaGalois.num_example
            %h6#example_3 Example
            %p
              %strong (Zariski closed subsets in affine space via Galois connection)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              for the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ↪
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    E \hookrightarrow k[x_1, \ldots, x_n] \times k^n
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E(f, x)\coloneqq \left( f(x) = 0\right)
                    \\,.
            %p
              By def.
              %a.maruku-ref{:href => "#GaloisConnection"}
              and prop.
              %a.maruku-ref{:href => "#GaloisConnectionAsAdjunction"}
              we obtain the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi V
                            %mi E
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi I
                            %mi E
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    P(k[X_1, \cdots, X_n])
                    \\underoverset{\underset{V_E}{\longrightarrow}}{\overset{I_E}{\longleftarrow}}{\bot}
                    P(k^n)^{op}
            %p
              (where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              denote their underlying sets).
            %p
              Here by def.
              %a.maruku-ref{:href => "#GaloisConnection"}
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V_E \;\colon\; P(k[x_1, \ldots, x_n]) \longrightarrow P(k^n)
            %p
              sends a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              of
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              to its corresponding
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/variety"} variety
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo ∈
                    %msup
                      %mi k
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi f
                        %mo ∈
                        %mi k
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∈
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_E(\mathcal{F}) = \{\vec x \in k^n \,\vert\, \forall_{f \in k[x_1, \ldots, x_n]} \; (f \in \mathcal{F}) \Rightarrow (f(x) = 0)\}
                    \\,.
            %p
              These are just the Zariski closed subsets from def.
              = succeed "." do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
            %p In the other direction,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    I_E \;\colon\; P(k^n) \longrightarrow P(k[x_1, \ldots, x_n])
            %p
              sends a set of points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T \subseteq k^n
              to its corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/vanishing+ideal"} vanishing ideal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi x
                        %mo :
                        %msup
                          %mi k
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi T
                    %mo ⇒
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    I_E(T) = \{f \in k[x_1, \ldots, x_n] \,\vert\, \forall_{x: k^n} \; x \in T \Rightarrow f(x) = 0\}
            %p
              which we considered earlier in def.
              = succeed "." do
                %a.maruku-ref{:href => "#VanishingIdeal"}
          %p
            We may now use the abstract theory of Galois connections to verify that Zariski closed subsets form a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
          #ZariskiTopologyOnAffineSpaceViaGaloisConnectionWellDefined.num_prop
            %h6#proposition_14 Proposition
            %p
              %strong (Zariski topology is well defined)
            %p
              Using
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %p
              The set of Zariski closed subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              from example
              %a.maruku-ref{:href => "#ZariskiClosedSubsetsInaffineViaGalois"}
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              in that it is closed under
            %ol
              %li
                %p arbitrary intersections;
              %li
                %p finite untions.
          .proof
            %h6#proof_12 Proof
            %p
              Regarding the first point: From prop.
              %a.maruku-ref{:href => "#GaloisConnectionAsAdjunction"}
              we know that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                  %annotation{:encoding => "application/x-tex"} V_E
              takes unions to intersections, hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∩
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℱ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi V
                      %mi E
                    %mrow
                      %mo (
                      %munder
                        %mo ∪
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi ℱ
                        %mi i
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\cap} V_E(\mathcal{F}_i)
                    \\;=\;
                    V_E\left(
                    \\underset{i \in I}{\cup} \mathcal{F}_i
                    \\right)
                    \\,.
            %p
              Regarding the second point, we exploit the
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              structure of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[x_1, \ldots, x_n]
            %p
              The empty union is the entire space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(1)
              (the variety associated with the constant polynomial
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            %p Hence it only remains to see closure under binary unions.
            %p
              To this end, recall from prop.
              %a.maruku-ref{:href => "#GaloisClosureOperator"}
              that we may replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}
              with the corresponding ideal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≔
                    %msub
                      %mi I
                      %mi E
                    %mo ∘
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    I \coloneqq I_E \circ V_E(\mathcal{F})
            %p without changing the variety:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_E(I) = V_E(\mathcal{F})
                    \\,.
            %p With this it is sufficient to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V_E(I) \cup V_E(I') = V(I \cdot I')
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} I \cdot I'
              is the ideal consisting of finite sums of elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f g
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} f \in I
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g \in I'
            %p We conclude by proving this statement:
            %p
              Applying the contravariant operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                  %annotation{:encoding => "application/x-tex"} V_E
              to the inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo ⊆
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I \cdot I' \subseteq I
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mi subseteq
                    %mi I
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} I \cdot I' subseteq I'
              (which are clear since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi I
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} I, I'
              are ideals), we derive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_E(I) \subseteq V_E(I \cdot I')
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⋅
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V_E(I') \subseteq V(I \cdot I')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_E(I) \cup V_E(I') \subseteq V(I \cdot I')
              is automatic.
            %p
              In the other direction, to prove
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⋅
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(I \cdot I') \subseteq V_E(I) \cup V(I')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in V(I \cdot I')
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              %em doesn’t
              belong to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V(I)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(x) \neq 0
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} f \in I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g \in I'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(x)g(x) = (f \cdot g)(x) = 0
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo ∈
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \cdot g \in I \cdot I'
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⋅
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in V_E(I \cdot I')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              to get
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(x) = 0
              for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g \in I'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in V_E(I')
          #ZariskiTopologyOnMaximalIdealsOfPolynomialRingViaGaloisConnection.num_example
            %h6#example_4 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              for the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MaxIdl
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} MaxIdl(k[X_1, \cdots, X_n])
              for the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideals"} maximal ideals
              in this ring.
            %p
              Define then a
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ↪
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi MaxIdeal
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E \hookrightarrow k[x_1, \ldots, x_n] \times MaxIdeal(k[x_1, \ldots, x_n])
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∈
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E(f, M) \Leftrightarrow (f \in M)
                    \\,.
            %p
              For a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %mi MaxIdl
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \subseteq MaxIdl(k[x_1, \ldots, x_n])
              we calculate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi f
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msub
                      %mo ∀
                      %mrow
                        %mi 𝔪
                        %mo ∈
                        %mi MaxIdl
                    %mi M
                    %mo ∈
                    %mi S
                    %mo ⇒
                    %mi f
                    %mo ∈
                    %mi 𝔪
                    %mo{:stretchy => "false"} }
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi 𝔪
                        %mo ∈
                        %mi S
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"}
                    I_E(T) = \{f \in k[x_1, \ldots, x_n]: \forall_{\mathfrak{m} \in MaxIdl} M \in S \Rightarrow f \in \mathfrak{m}\} = \bigcap_{\mathfrak{m} \in S} \mathfrak{m}
            %p which is an ideal, since the intersection of any collection of ideals is again an ideal. (However, not all ideals are given as intersections of maximal ideals, a point to which we will return in a moment.)
          .num_remark
            %h6#remark_2 Remark
            %p
              This is a slight generalization of example
              %a.maruku-ref{:href => "#ZariskiClosedSubsetsInaffineViaGalois"}
              since each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a = (a_1, \ldots, a_n)
              induces a maximal ideal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔪
                      %mi a
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi x
                      %mn 1
                    %mo −
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo −
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{m}_a \coloneqq \langle x_1 - a_1, \ldots, x_n - a_n \rangle
                    \\,,
            %p
              i.e. the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi k
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi …
                            %mo ,
                            %msub
                              %mi x
                              %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi k
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                            %mo ↦
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    k[x_1, \ldots, x_n] &amp;\longrightarrow&amp; k
                    \\\
                    f &amp;\mapsto&amp; f(a)
                    }
            %p
              which evaluates polynomials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at the point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(a) = 0
              iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msub
                        %mi 𝔪
                        %mi a
                    %annotation{:encoding => "application/x-tex"} f \in \mathfrak{m}_a
            %p
              Of course it need not be the case that all maximal ideals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              are given by points in this way; for example, the ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x^2 + 1)
              is maximal in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}[x]
              but is not given by evaluation at a point because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} x^2 + 1
              does not vanish at any real point. However, if the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x_1, \ldots, x_n]
              is given by evaluation at a point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a = (a_1, \ldots, a_n)
              = succeed "." do
                %em
                  weak
                  %a.existingWikiWord{:href => "/nlab/show/Nullstellensatz"} Nullstellensatz
          .num_prop
            %h6#proposition_15 Proposition
            %p
              The set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊆
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subseteq k^n
              that are closed under the operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo ∘
                    %msub
                      %mi I
                      %mi E
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_E \circ I_E: P(k^n) \to P(k^n)
              in example
              %a.maruku-ref{:href => "#ZariskiTopologyOnMaximalIdealsOfPolynomialRingViaGaloisConnection"}
              form a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
          .proof
            %h6#proof_13 Proof
            %p
              The proof is virtually the same as in the proof of prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#ZariskiTopologyOnAffineSpaceViaGaloisConnectionWellDefined"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_E(S) = V_E(I)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %msub
                      %mi I
                      %mi E
                    %mo ∘
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I = I_E \circ V_E(S)
              is an ideal, so there is no loss of generality in considering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_E(I)
              for ideals
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo ∪
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ⋅
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V_E(I) \cup V_E(I') = V_E(I \cdot I')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                    %mo ∈
                    %msub
                      %mi V
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ⋅
                    %mi I
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in V_E(I \cdot I')
              (meaning
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⋅
                      %mi I
                      %mo ′
                      %mo ⊆
                      %mi M
                    %annotation{:encoding => "application/x-tex"} I \cdot I' \subseteq M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \mathfrak{m}
              %em doesn’t
              belong to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V_E(I)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∉
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} f \notin \mathfrak{m}
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} f \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi I
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g \in I'
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⋅
                      %mi g
                      %mo ∈
                      %mi 𝔪
                    %annotation{:encoding => "application/x-tex"} f \cdot g \in \mathfrak{m}
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi R
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi 𝔪
                  %annotation{:encoding => "application/x-tex"} \pi: R \to R/\mathfrak{m}
              to the field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} /
                      %mi 𝔪
                    %annotation{:encoding => "application/x-tex"} R/\mathfrak{m}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ⋅
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi(f \cdot g) = \pi(f)\cdot \pi(g) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi(f) \neq 0
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi(g) = 0
              for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi I
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g \in I'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔪
                      %mo ∈
                      %msub
                        %mi V
                        %mi E
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{m} \in V_E(I')
          %p
            Thus the fixed elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi E
                  %mo ∘
                  %msub
                    %mi I
                    %mi E
                %annotation{:encoding => "application/x-tex"} V_E \circ I_E
            on one side of the Galois correspondence are the closed sets of a topology. The fixed elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi E
                  %mo ∘
                  %msub
                    %mi V
                    %mi E
                %annotation{:encoding => "application/x-tex"} I_E \circ V_E
            on the other side are a matter of interest; in the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed
            %em
              %a.existingWikiWord{:href => "/nlab/show/radical+ideals"} radical ideals
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} k[X_1, \ldots, X_n]
            according to the “strong”
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nullstellensatz"} Nullstellensatz
          %h3#GaloisAppliedToAffineSchemes Applied to affine schemes
          %p
            We now redo the discussion of the Zariski topology on the
            %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum of a commutative ring
            from
            %a{:href => "#OnAffineVarieties"} above
            as a special case of the general considerations of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Galois+connections"} Galois connections
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zariski+site"} Zariski site
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/schemes+are+sober"} schemes are sober
          %h2#references References
          %p Lecture notes include
          %ul
            %li
              Jim Carrell,
              %em Zariski topology
              %a{:href => "https://personal.math.ubc.ca/~carrell/423.pdf"} pdf
          %p See also
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Zariski_topology"} Zariski topology
