            %p hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %munder
                        %mo ∀
                        %mrow
                          %mo{:stretchy => "false"} (
