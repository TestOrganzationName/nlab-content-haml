                  %annotation{:encoding => "application/x-tex"}
                    f \cdot g \in I(V(\mathcal{F}_1)) \cap I(V(\mathcal{F}_2)) = I(V(\mathcal{F}))
                    \\,,
            %p
              which were in contradiction to the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I(V(\mathcal{F}))
              is a prime ideal. Hence we have a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proof+by+contradiction"} proof by contradiction
          %p
            Proposition
            %a.maruku-ref{:href => "#PrimeVanishingIdealOfIrreducibleZariskiClosed"}
            gives an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext irreducible Zariski closed
                        %mtr
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                            %mo ⊂
                            %msup
                              %mi k
                              %mi n
                    %mo }
                  %mover
                    %mo ↪
                    %mphantom
                      %mi AAA
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext prime ideals
                        %mtr
                          %mtd
                            %mi I
                            %mo ∈
                            %mi k
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi X
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} ]
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\array{
                  \\text{irreducible Zariski closed}
                  \\\
                  V(\mathcal{F}) \subset k^n
                  }
                  \\right\}
                  \\overset{\phantom{AAA}}{\hookrightarrow}
                  \\left\{
                  \\array{
                  \\text{prime ideals}
                  \\\
                  I \in k[X_1, \cdots, X_n]
                  }
                  \\right\}
                  \\,.
          %p
            The following says that for
            %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+fields"} algebraically closed fields
            then this is in fact a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          #PrimeIdealClosedsubspaceBijection.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mover
                      %mi k
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} k = \overline{k}
              be an
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed field
              and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi IrrClSub
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi 𝔸
                              %mi k
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi PrimeIdl
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi X
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi X
                              %mi n
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %mi I
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    IrrClSub(\mathbb{A}^n_k)
                    \&amp;\overset{}{\longrightarrow}&amp;
                    PrimeIdl(k[X_1, \cdots, X_n])
                    \\\
                    V(\mathcal{F})
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    I(V(\mathcal{F}))
                    }
            %p
              from prop.
              %a.maruku-ref{:href => "#PrimeVanishingIdealOfIrreducibleZariskiClosed"}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            The
            %strong proof
            uses
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert%27s+Nullstellensatz"} Hilbert's Nullstellensatz
          .num_remark
            %h6#remark Remark
            %p
              %strong (generalization to affine varieties)
            %p
              Prop
              %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
              suggests to consider the set of
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
              of a
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[X_1, \cdots, X_n]
              for general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              as more fundamental, in some sense, than the set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} k^n
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mi k
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi X
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R = k[X_1, \cdots, X_n]
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/affine+varieties"} affine varieties
              %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
              below.
          %h3#examples Examples
          #AffineSpaceOverInfiniteFieldNotHausdorff.num_example
            %h6#example Example
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is
              %em not
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+field"} finite field
              %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiOpenSubsetsOnAffineSpace"}
              %em not
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff
            %p
              This is because the solution set to a system of
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              over an infinite polynomial is always a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of
              %em every
              pair of
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              Zariski open subsets is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited"} non-empty
            %p
              But the Zariski topology is always
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober
              %a.maruku-ref{:href => "#ZariskiTopologyIsSober"}
              below.
          %h2#OnAffineVarieties On affine varieties
          %h3#definition_4 Definition
          #ZariskiClosedSubsetsInSpecR.num_defn
            %h6#definition_5 Definition
            %p
              %strong (Zariski topology on set of prime ideals)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PrimeIdl(R)
              for its set of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset R
              any subset of elements of the ring, consider the subsets of those prime ideals that contain
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi p
                      %mo ∈
                      %mi PrimeIdl
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %mi ℱ
                      %mo ⊂
                      %mi p
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V(\mathcal{F})
                    \\;\coloneqq\;
                    \\left\{
                    p \in PrimeIdl(R) \,\vert\, \mathcal{F} \subset p
                    \\right\}
                    \\,.
            %p
              These are called the
              %em
                Zariski
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"} closed subsets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PrimeIdl
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PrimeIdl(R)
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              are called the
              = succeed "." do
                %em Zariski open subsets
          #WellDefinedZariskiTopologyOnSpecR.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong (Zariski topology well defined)
            %p
              Assuming
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed ")" do
                %a.maruku-ref{:href => "#ZariskiClosedSubsetsInSpecR"}
              %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{Spec(R)} \subset P(PrimeIdl(R))
            %p
              satisfies the axioms of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              = succeed "." do
                %em Zariski topology
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mrow
                        %mi Spec
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spec(R) \coloneqq (PrimeIdl(R), \tau_{Spec(R)})
            %p
              is called (the space underlying) the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+commutative+ring"} prime spectrum of the commutative ring
          #WellDefinedZariskiTopologyOnSpecRProof.proof
            %h6#proof_4 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset R
              write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset I(\mathcal{F})
              for the
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              which is generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    V(I(\mathcal{F})) = V(\mathcal{F})
            %p
              and therefore it is sufficient to consider the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(\mathcal{F})
              for the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \subset R
              is not just a subset, but an ideal.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi F
                      %mi i
                    %mo ∈
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{F_i \in Idl(R)\}_{i \in I}
              be a set of ideals in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℱ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi PrimeIdl
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{V(\mathcal{F}_i) \subset PrimeIdl(R)\}_{i \in I}
              be the corresponding set of Zariski closed subsets. We need to show that there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mo ∪
                    %mo ,
                    %msub
                      %mi ℱ
                      %mo ∩
                    %mo ⊂
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}_\cup, \mathcal{F}_\cap \subset R
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mo ∩
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℱ
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi V
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℱ
                          %mo ∪
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} V(\mathcal{F}_i) = V(\mathcal{F}_\cup)
                  ;
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
                  is
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                  then
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∪
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℱ
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi V
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℱ
                            %mo ∩
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cup} V(\mathcal{F}_i) = V(\mathcal{F}_\cap)
            %p We claim that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℱ
                          %mo ∪
                        %mo =
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi ℱ
                          %mi i
                        %mo ≔
                        %mrow
                          %mo {
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                          %msub
                            %mi f
                            %mi i
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                          %mo ∈
                          %mi R
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi f
                            %mi i
                          %mo ∈
                          %msub
                            %mi ℱ
                            %mi i
                          %mo }
                      %annotation{:encoding => "application/x-tex"} \mathcal{F}_{\cup} = \underset{i \in I}{\sum} \mathcal{F}_i \coloneqq \left\{ \underset{i \in I}{\sum} f_i  \,, \in R\;\vert\; f_i \in \mathcal{F}_i \right\}
              %li
                %p
