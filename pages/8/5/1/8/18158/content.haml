              %li
                %p Define
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi E
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        I_E
                        \\;\colon\;
                        P(Y)
                        \\longrightarrow
                        P(X)
                %p by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo {
                          %mi x
                          %mo ∈
                          %mi X
                          %mo{:stretchy => "false"} |
                          %munder
                            %mo ∀
                            %mrow
                              %mi y
                              %mo ∈
                              %mi Y
                          %mrow
                            %mo (
                            %mrow
                              %mo (
                              %mi y
                              %mo ∈
                              %mi T
                              %mo )
                            %mo ⇒
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo }
                      %annotation{:encoding => "application/x-tex"}
                        I_E(T) \coloneqq \left\{x \in X \vert \underset{y \in Y}{\forall} \left( \left(y \in T \right) \Rightarrow E(x, y)  \right)\right\}
          #GaloisConnectionAsAdjunction.num_prop
            %h6#proposition_10 Proposition
            %p
              The construction in def.
              %a.maruku-ref{:href => "#GaloisConnection"}
              has the following properties:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi E
                      %annotation{:encoding => "application/x-tex"} V_E
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi E
                      %annotation{:encoding => "application/x-tex"} I_E
                  are
                  %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant
                  order-preserving in that
                %ol
                  %li
                    %p
                      if
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi S
                              %mo ⊂
                              %mi S
                              %mo ′
                            %annotation{:encoding => "application/x-tex"} S \subset S'
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi V
                                %mi E
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo ⊂
                              %msub
                                %mi V
                                %mi E
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} V_E(S') \subset V_E(S)
                  %li
                    %p
                      if
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi T
                              %mo ⊂
                              %mi T
                              %mo ′
                            %annotation{:encoding => "application/x-tex"} T \subset T'
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi I
                              %mi E
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo ⊂
                            %msub
                              %mi I
                              %mi E
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} I_E(T') \subset I_E(T)
              %li
                %p
                  The
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                    law
                  holds:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mi T
                          %mo ⊂
                          %msub
                            %mi V
                            %mi E
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} LeftRightarrow
                        %mspace{:width => "thinmathspace"}
                        %mrow
                          %mo (
                          %mi S
                          %mo ⊂
                          %msub
                            %mi I
                            %mi E
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        T \subset V_E(S)
                        \\right)
                        \\,\LeftRightarrow\,
                        \\left(
                        S \subset I_E(T)
                        \\right)
                %p which we denote by writing
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
