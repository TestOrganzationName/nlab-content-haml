                        \\;\colon\;
                        P(X)
                        \\longrightarrow
                        P(Y)
                %p by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo {
                          %mi y
                          %mo ∈
                          %mi Y
                          %mo{:stretchy => "false"} |
                          %munder
                            %mo ∀
                            %mrow
                              %mi x
                              %mo ∈
                              %mi X
                          %mrow
                            %mo (
                            %mrow
                              %mo (
                              %mi x
                              %mo ∈
                              %mi S
                              %mo )
                            %mo ⇒
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo }
                      %annotation{:encoding => "application/x-tex"}
                        V_E(S)
                        \\coloneqq
                        \\left\{
                        y \in Y \vert  \underset{x \in  X}{\forall} \left( \left(x \in S\right) \Rightarrow E(x, y)
