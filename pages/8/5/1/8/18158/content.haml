                between
                %a.existingWikiWord{:href => "/nlab/show/posets"} posets
          %h3#BackgroundOnGaloisConnections Background on Galois connections
          #GaloisConnection.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
                induced from a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %p
              Consider two
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X,Y \in Set
              and a
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \hookrightarrow X \times Y
                    \\,.
            %p
              Define two
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              between their
              %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(X), P(Y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E(x, y)
              to abbreviate the formula
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} (x, y) \in E
            %ol
              %li
                %p Define
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi E
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
