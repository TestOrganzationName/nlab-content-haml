                    f\in I(V(\mathcal{F}_1)) \backslash I(V(\mathcal{F}_2))
                    \\,\,\,\text{and}\,\,\,
                    g \in I(V(\mathcal{F}_2)) \backslash I(V(\mathcal{F}_1))
                    \\,.
            %p But since a product of polynomials vanishes at some point once one of the factors vanishes at that point, it would follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋅
                    %mi g
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} (
