                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℱ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℱ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mtext and
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ¬
                    %mrow
                      %mo (
