                      %annotation{:encoding => "application/x-tex"}
                        P(X)
                        \\underoverset{\underset{V_E}{\longrightarrow}}{\overset{I_E}{\longleftarrow}}{\bot}
                        P(Y)^{op}
              %li
                %p
                  both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi E
                      %annotation{:encoding => "application/x-tex"} V_E
                  as well as
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi E
                      %annotation{:encoding => "application/x-tex"} I_E
                  take
                  %a.existingWikiWord{:href => "/nlab/show/unions"} unions
                  to
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
          .proof
            %h6#proof_9 Proof
            %p
              Regarding the first point: the larger
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is, the more conditions that are placed on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
