                          %mi α
                          %mi β
                    %annotation{:encoding => "application/x-tex"} (\psi \wedge \overline{\psi})^{\alpha \beta}
                span the symmetrized
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi N
                      %mo ⊗
                      %mi N
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi sym
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} ⟨
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo ∧
                      %mover
                        %mi ψ
                        %mo ¯
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi α
                      %msub
                        %mrow
                        %mi β
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mo{:stretchy => "false"} ⟩
                        %mrow
                          %mi α
                          %mo ,
                          %mi β
                          %mo =
                          %mn 1
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\{N \otimes N\}_{sym}
                      \\;\simeq\;
                      \\langle
                      \\,  (\psi \wedge \overline{\psi})^\alpha{}_\beta \,
                      \\rangle_{\alpha,\beta = 1}^{dim_{\mathbb{R}}(N)}
            %li
              %p
                for given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ψ
                        %mo ¯
                      %mo ∧
                      %msub
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \overline{\psi} \wedge \Gamma_{a_1 \cdots a_p} \psi
                form a
                %a.existingWikiWord{:href => "/nlab/show/subrepresentation"} subrepresentation
                thereof, equivalent to the vector representation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mi p
                      %msup
                        %mi ℝ
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \wedge^p\mathbb{R}^{d}
            %li
              %p
                hence there is a
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                decomposition
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %mi N
                          %mo ⊗
                          %mi N
                          %mo }
                        %mi sym
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mrow
                          %mi p
                          %mo ∈
                          %mi ℕ
                      %msub
                        %mi c
                        %mi p
                      %mrow
                        %mo (
                        %msup
                          %mo ∧
                          %mi p
                        %msup
                          %mi ℝ
                          %mi d
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{N \otimes N\right\}_{sym}
                      \\;\simeq\;
                      \\underset{p \in \mathbb{N}}{\bigoplus}
                      c_p \left(\wedge^p \mathbb{R}^d\right)
              %p
                in the
                %a.existingWikiWord{:href => "/nlab/show/category+of+representations"} category of representations
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
                of the
                %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                representation as a
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of skew-symmetrized tensor products of the vector representation.
          %p Indeed this direct sum decomposition is exhaustive:
          #BilinearFierzDecomposition.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              a
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              representation of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi α
                    %msub
                      %mrow
                      %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mover
                          %mi ψ
                          %mo ¯
                        %mi ψ
                        %mo )
                      %mo +
                      %mrow
                        %mo (
                        %mover
                          %mi ψ
                          %mo ¯
                        %msub
                          %mi Γ
                          %mi a
                        %mi ψ
                        %mo )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Γ
                        %mi a
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi α
                      %msub
                        %mrow
                        %mi β
                      %mo +
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mn 2
                            %mo !
                      %mrow
                        %mo (
                        %mover
                          %mi ψ
                          %mo ¯
                        %msub
                          %mi Γ
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                            %msub
                              %mi a
                              %mn 2
                        %mi ψ
                        %mo )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %msub
                            %mi a
                            %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi α
                      %msub
                        %mrow
                        %mi β
                      %mo +
                      %mi ⋯
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\psi \wedge \overline{\psi})^\alpha{}_\beta
                    \\;=\;
                    \\tfrac{1}{dim_{\mathbb{R}}(N)}
                    \\left(
                    \\left(
                    \\overline{\psi}\psi
                    \\right)
                    +
                    \\left(
                    \\overline{\psi} \Gamma_a \psi
                    \\right)
                    (\Gamma^a)^\alpha{}_\beta
                    +
                    \\tfrac{1}{2!}
                    \\left(
                    \\overline{\psi} \Gamma_{a_1 a_2} \psi
                    \\right)
                    (\Gamma^{a_1 a_2})^\alpha{}_\beta
                    +
                    \\cdots
                    \\right)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              By the discussion there, the
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              representation is a real sub-representation of a complex
              %em Dirac representation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mn 2
                            %mi ν
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}^{(2^\nu)}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                  contains the full
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} p \geq 1
                  the Clifford elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                            %mi ⋯
                            %msub
                              %mi a
                              %mi p
                      %annotation{:encoding => "application/x-tex"} \Gamma_{a_1 \cdots a_p}
                  have vanishing
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            %p
              The first point implies that there exists coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} X^{a_1 \cdots a_p} \in \mathbb{C}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo ¯
                    %mo =
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %msub
                            %mi dim
                            %mi ℝ
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mi X
                      %mo +
                      %msup
                        %mi X
                        %mi a
                      %msub
                        %mi Γ
                        %mi a
                      %mo +
                      %msup
                        %mi X
                        %mrow
                          %mi a
                          %mi b
                      %msub
                        %mi Γ
                        %mrow
                          %mi a
                          %mi b
                      %mo +
                      %mi ⋯
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi \wedge \overline{\psi}
                    \=
                    \\tfrac{1}{dim_{\mathbb{R}}(N)}
                    \\left(
                    X
                    +
                    X^a \Gamma_a
                    +
                    X^{a b} \Gamma_{a b}
                    +
                    \\cdots
                    \\right)
                    \\,.
            %p
              The second condition then implies that multiplying this expression with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \Gamma^{a_1 \cdots a_p}
              and taking the trace projects out the coefficient
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                    %annotation{:encoding => "application/x-tex"} X^{a_1 \cdots a_p}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi a
                                  %mi p
                          %mtd
                            %mo =
                            %mfrac
                              %mn 1
                              %mrow
                                %mi p
                                %mo !
                                %msub
                                  %mi dim
                                  %mi ℝ
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi tr
                              %mi N
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %mi X
                                %mo +
                                %msup
                                  %mi X
                                  %mi a
                                %msub
                                  %mi Γ
                                  %mi a
                                %mo +
                                %msup
                                  %mi X
                                  %mrow
                                    %mi a
                                    %mi b
                                %msub
                                  %mi Γ
                                  %mrow
                                    %mi a
                                    %mi b
                                %mo +
                                %mi ⋯
                                %mo )
                              %msup
                                %mi Γ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi a
                                    %mi p
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi p
                                  %mo !
                            %msub
                              %mi tr
                              %mi N
                            %mrow
                              %mo (
                              %mi ψ
                              %mo ∧
                              %mover
                                %mi ψ
                                %mo ¯
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi Γ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi a
                                    %mi p
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi p
                                  %mo !
                            %mrow
                              %mo (
                              %mover
                                %mi ψ
                                %mo ¯
                              %mo ∧
                              %msup
                                %mi Γ
                                %mrow
                                  %msub
                                    %mi a
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi a
                                    %mi p
                              %mi ψ
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    X^{a_1 \cdots a_p}
                    \&amp; =
                    \\frac{1}{p! dim_{\mathbb{R}}(N)}
                    tr_N
                    \\left(
                    \\left(
                    X
                    +
                    X^a \Gamma_a
                    +
                    X^{a b} \Gamma_{a b}
                    +
                    \\cdots
                    \\right)
                    \\Gamma^{a_1 \cdots a_p}
                    \\right)
                    \\\
                    \&amp; =
                    \\tfrac{1}{p!}
                    tr_N
                    \\left(
                    \\psi \wedge \overline{\psi} \, \Gamma^{a_1 \cdots a_p}
                    \\right)
                    \\\
                    \&amp; =
                    \\tfrac{1}{p!}
                    \\left(
                    \\overline \psi \wedge \Gamma^{a_1 \cdots a_p} \psi
                    \\right)
                    \\end{aligned}
                    \\,.
            %p
              Notice that it is the last step, identifying the trace over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ∧
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \psi \wedge \overline{\psi} \Gamma^{a_1 \cdots a_p}
              with the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              component of the matrix
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Γ
                        %mrow
                          %msub
                            %mi a
                            %mn 1
                          %mi ⋯
                          %msub
                            %mi a
                            %mi p
                    %annotation{:encoding => "application/x-tex"} \Gamma^{a_1 \cdots a_p}
              %em symmetrization
              of the spinor tensor product, namely the identity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ψ
                        %mi α
                      %mo ∧
                      %msub
                        %mover
                          %mi ψ
                          %mo ¯
                        %mi β
                      %mo =
                      %msub
                        %mover
                          %mi ψ
                          %mo ¯
                        %mi β
                      %mo ∧
                      %msup
                        %mi ψ
                        %mi α
                    %annotation{:encoding => "application/x-tex"} \psi^\alpha \wedge \overline{\psi}_\beta = \overline{\psi}_\beta \wedge \psi^\alpha
          %p
            Some of the coefficients in prop.
            %a.maruku-ref{:href => "#BilinearFierzDecomposition"}
            may vanish identically. These are the
            = succeed "," do
              %em bilinear Fierz identities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo ¯
                  %msub
                    %mi Γ
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                      %mi ⋯
                      %msub
                        %mi a
                        %mi p
                  %mi ψ
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\overline{\psi} \Gamma_{a_1 \cdots a_p} \psi = 0
                  \\,.
          .num_example
            %h6#example Example
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mn 11
                    %annotation{:encoding => "application/x-tex"} d = 11
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                  %annotation{:encoding => "application/x-tex"} \mathbf{32}
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} (\tfrac{1}{2})^5
              for the
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              representation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 5
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 5
                        %mo }
                      %mi sym
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 4
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %msup
                          %mi ℝ
                          %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 3
                        %mo ⏟
                      %mrow
                        %mo ≃
                        %msup
                          %mo ∧
                          %mn 2
                        %msup
                          %mi ℝ
                          %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo ⊕
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 5
                        %mo ⏟
                      %mrow
                        %msup
                          %mo ∧
                          %mn 5
                        %msup
                          %mi ℝ
                          %mi d
                    %mspace{:width => "thinmathspace"}
