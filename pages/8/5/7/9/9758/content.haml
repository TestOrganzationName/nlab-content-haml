          %p
            (
            %a{:href => "#DAuriaFre82b"}> D’Auria-Fré 82b (3.3)
            )
          .proof
            %h6#proof_3 Proof
            %p As before, this is supposed to follow already by matching total dimensions on both sides
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
