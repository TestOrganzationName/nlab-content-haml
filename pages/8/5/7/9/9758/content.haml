                              %mn 0
                              %msup
                                %mo{:stretchy => "false"} )
                                %mn 4
                          %mtr
                            %mtd
                              %mo ⊕
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mn 1
