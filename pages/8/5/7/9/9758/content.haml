                  %mn 9
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(9,1)
            (relevant in
            %a.existingWikiWord{:href => "/nlab/show/heterotic+supergravity"} heterotic supergravity
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/type+II+supergravity"} type II supergravity
          %ul
            %li#DAuriaFre82a
              %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"}> Riccardo D'Auria
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
              = succeed "," do
