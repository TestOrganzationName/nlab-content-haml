            = succeed "." do
              %a{:href => "#CDF"} Castellani-D’Auria-Fré 82, section II.8
          %h3#BilinearFierzIdentities Bilinear Fierz identities
          %p
            Given a fixed
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
