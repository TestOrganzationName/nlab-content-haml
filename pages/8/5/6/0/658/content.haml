          %h2#idea Idea
          %p
            The concept of a
            %em profunctor
            is a generalization of the concept of a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            in much the same way that the concept of a
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            generalizes that of an
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            (in fact, this may be understood as a special case of enriched profunctors).
          %h2#definition Definition
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %strong profunctor
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi D
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_F \colon D^{op}\times C \to Set
                  \\,.
          %p
            Such a profunctor is usually written as
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F\colon  C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} d \in D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_F(d,c)
            is also called the set of
            %a.existingWikiWord{:href => "/nlab/show/heteromorphisms"} heteromorphisms
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f\colon C\to D
            induces two profunctors
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D(1,f)\colon C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D(f,1)\colon D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(1,f)(d,c) = D(d,f(c))
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(f,1)(c,d) = D(f(c),d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(-,-)
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            denotes the identity functor on the respective category.) Since this construction may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of the composition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            with the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mover
                      %mo ⟶
                      %mi f
                    %mi D
                    %mover
                      %mo ⟶
                      %mi Yoneda
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C \stackrel{f}{\longrightarrow} D \stackrel{Yoneda}{\longrightarrow} [D^{op},Set]
            %em representable
            (or sometimes one of them is called
            = succeed ")" do
              %em corepresentable
          %p
            In particular the identity profunctor
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Id \colon  C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is represented by the identity functor and hence is given by the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C(-,-) : C^{op} \times C \to Set
            itself.
          %p
            The notion generalizes to many other kinds of categories. For instance, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over some symmetric
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo ⊗
                    %mi C
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} D^{op} \otimes C\to V
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+categories"} internal categories
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is an
            %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D^{op}\times C
          %p
            A profunctor is also sometimes called a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} (bi)module
            or a
            %strong distributor
            or a
            %strong relator
            or a
            = succeed "," do
              %strong correspondence
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            between such monoids in the usual sense. “Profunctor” is perhaps more common in the Set-based and internal cases (but is also used in the enriched case); here the intuition is that a profunctor is a generalization of a functor, via the construction of “representable” profunctors. Jean Bénabou, who invented the term and originally used “profunctor,” later preferred “distributor”. One reason for this is that lax functors from a given category to the bicategory of distributors give a notion of “distribution on a category”, formally resembling
            %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
            qua generalized
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            \- see
            = succeed "." do
              %a{:href => "#Benabou95"} Bénabou 95
          %p
            Note that the convention that a profunctor is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} D^{op}\times C \to Set
            is not universal; some authors reverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and/or put the “op” on the other one. See the discussion below.
          %h3#profunctors_and_product_categories Profunctors and product categories
          %p
            Consider a profunctor
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F \colon C \times D
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi E
                      %mi op
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ×
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} H_F \colon E^{op} \times (C \times D) \to Set
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ×
                    %msup
                      %mi D
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} (E \times D^{op})^{op} \times C \to Set
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            construction to replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi op
                  %mo ×
                  %mi D
                %annotation{:encoding => "application/x-tex"} E^{op} \times D
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ×
                    %msup
                      %mi D
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (E \times D^{op})^{op}
          %p
            In other words, there is a natural correspondence between profunctors
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \times D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and profunctors
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo ×
                  %mi E
                %annotation{:encoding => "application/x-tex"} D^{op} \times E
            \- compare the analogous result for finite-dimensional vector spaces, where there is a natural correspondence between linear maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊗
                  %mi W
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} V \otimes W \to Z
            and linear maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %msup
                      %mi W
                      %mo *
                    %mo ⊗
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} V \to W^* \otimes Z
          %p
            In particular, using the isomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≅
                    %mi X
                    %mo ×
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X \cong X \times 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the terminal category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is any category, any profunctor
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            naturally induces 3 others:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo !
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo ×
                      %msup
                        %mi D
                        %mi op
                    %annotation{:encoding => "application/x-tex"} F_! \colon C \times D^{op}
                ⇸
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                \.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo !
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} F^! \colon 1
                ⇸
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                      %mo ×
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C^{op} \times D
                \.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mi op
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi D
                        %mi op
                    %annotation{:encoding => "application/x-tex"} F^{op} \colon D^{op}
                ⇸
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
                \.
          %h2#the_bicategory_of_profunctors The bicategory of profunctors
          %p
            Profunctors are composed by using a
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            to “trace out” the middle variable. Specifically, for profunctors
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G : D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∘
                    %mi F
                    %mo :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} G \circ F: C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is defined to be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ∘
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (G \circ F)(e,c) := \int^{d \in D} F(d,c)\otimes G(e,d)
                  \\,.
          %p
            This yields a
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            in which
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                s are profunctors with the above composition, and
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                are
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          %p
            This bicategory is variously denoted
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Mod
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dist
                  %annotation{:encoding => "application/x-tex"} Dist
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} V Mod
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi Dist
                  %annotation{:encoding => "application/x-tex"} V Dist
          %p
            The construction of the “representable” profunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(1,f)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(f,1)
            from a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f\colon C\to D
            yield two identity-on-objects functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Cat \to Prof
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cat
                      %mi op
                    %mo →
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Cat^{op}\to Prof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(1,f) \vdash D(f,1)
            in the bicategory
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo →
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} Cat\to Prof
            is a
            %a.existingWikiWord{:href => "/nlab/show/proarrow+equipment"} proarrow equipment
            in the sense of Wood (in fact, the prototypical one). This same fact can also be expressed by defining a (pseudo)
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            in which functors and profunctors are the two kinds of arrows; the construction of representable profunctors is then given by
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/companion"} companion
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/conjoint"} conjoint
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/framed+bicategory"} framed bicategory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/full+sub-2-category"} full sub-2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Prof
                    %mi rep
                %annotation{:encoding => "application/x-tex"} Prof_{rep}
            on representable profunctors is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi ana
                  %annotation{:encoding => "application/x-tex"} Cat_{ana}
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
          %h2#alternative_definitions Alternative definitions
          %h3#FuncsOnPresheaves In terms of colimit-preserving functors on presheaf categories
          %p
            A basic fact (e.g. Kashiwara, Schapira,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Categories+and+Sheaves"} Categories and Sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} colimit-preserving functors
            from
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            on some small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are canonically equivalent to functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cocont
                  %mo{:stretchy => "false"} (
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Cocont(PSh(C),A)
                  \\simeq
                  Func(C,A)
                  \\,.
          %p
            This may be thought of as a consequence of the
            %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
            (and hence, of course, of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi C
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y : C \to PSh(C)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(C)
            is already determined by its restriction along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Now, profunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo ⊗
                  %mi C
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} D^{op} \otimes C \to V
            are
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            to functors
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \to [D^{op}, V] \simeq PSh(D)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  PSh(C) \to PSh(D)
                  \\,.
          %p
            Indeed, there is an equivalence of bicategories between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            and the 2-category of categories and colimit-preserving functors and natural transformations between their presheaf categories. Note that the latter is a
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            which can thus serve as a “natural” strictification of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mi Prof
                %annotation{:encoding => "application/x-tex"} V Prof
            (e.g.
            = succeed ")." do
              %a{:href => "#Cattani99"} Cattani 1999, Prop. 4.2.4
          %p
            From this perspective, the representable profunctor induced by an ordinary
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} f : C \to D
            is the
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            of the postcomposition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mover
                    %mo →
                    %mi f
                  %mi D
                  %mover
                    %mo →
                    %mi Y
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi D
                    %mi op
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  C \stackrel{f}{\to} D \stackrel{Y}{\to} [D^{op},V]
          %p
            with the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            under the Hom-adjunction.
          %p
            The formulation of profunctors as colimit-preserving functors on presheaf categories plays a big role also in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
            is one equivalent to a
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            of some
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            (i.e. some
            %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
            of the latter). The collection of all
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
            and colimit-preserving
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
            betweem them forms the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category+of+presentable+%28%E2%88%9E%2C1%29-categories"} symmetric monoidal (∞,1)-category of presentable (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            is the “bilinear” tensor product coming from interpreting colimit-preserving functors as “linear” (reading: colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            sum).
          %p
            This
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^L
            therefore is an
            = succeed "-analog" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mtext -
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Set\text{-}Mod
            %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-function+theory"} geometric ∞-function theory
            one finds (see section 4 there) that morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^L
            encode the “correspondence operations” such as Fourier-Mukai and its generalizations. See in that context also the examples below.
          %h3#in_terms_of_twosided_discrete_fibrations In terms of two-sided discrete fibrations
          %p
            Recall that a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} D^{op}\to Set
            can equivalently be described as a
            %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28Grothendieck%29+fibration"} (Grothendieck) fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C\to Set
            can be described as a discrete opfibration. Thus, a profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} D^{op}\times C\to Set
            could be described by a discrete opfibration over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D^{op}\times C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ×
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} D\times C^{op}
            %em
              %a.existingWikiWord{:href => "/nlab/show/two-sided+fibration"} two-sided fibration
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi C
                  %mo ×
                  %mi D
                %annotation{:encoding => "application/x-tex"} E\to C\times D
            which is a fibration over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and an opfibration over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in a compatible way. Such a fibration represents a pseudofunctor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} D^{op}\times C\to Cat
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} D^{op}\times C\to Set
          %p
            This definition/characterization of profunctors works for internal categories as well, but
            %em not
            for enriched ones. It is sometimes called the
            %a.existingWikiWord{:href => "/nlab/show/graph+of+a+profunctor"} graph of a profunctor
            (although this is sometimes also used for the other fibrational representations mentioned above).
          %h3#in_terms_of_twosided_codiscrete_cofibrations In terms of two-sided codiscrete cofibrations
          %p
            Yet another way of representing profunctors is via their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/collages"} collages
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cograph+of+a+profunctor"} cographs
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} H\colon C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is, in particular, a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{H}
            equipped with functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} C\to \bar{H}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo →
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} D\to\bar{H}
            which are
            %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            and jointly bijective on objects.
          %p
            In fact, the objects of the
            %a.existingWikiWord{:href => "/nlab/show/undercategory"} undercategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊔
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (C\sqcup D)/Cat
            which are collages of profunctors
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            can be characterized, up to equivalence, as the two-sided
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+cofibrations"} codiscrete cofibrations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cat
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Cat^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            which contain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as disjoint full subcategories which are jointly-
            %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide
            (i.e. together contain all the objects), and such that there are no morphisms from an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to an object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is the fiber over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the fiber over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (such functors into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            are sometimes called
            = succeed "," do
              %strong correspondences
            %strong barrels
            in
            = succeed ")." do
              %a.existingWikiWord{:href => "/joyalscatlab/published/Distributors+and+barrels"} Distributors and barrels
          %p
            When viewing a profunctor
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                  %annotation{:encoding => "application/x-tex"} H\colon C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            in this way, one may sometimes speak of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(d,c)
            as
            %em heteromorphisms
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{H}
            and can be “composed” with morphisms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            (this corresponds to the “action” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            in the other formulations), but they go between objects of two different categories (namely
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            This characterization works just as well in both the internal and enriched case. Perhaps surprisingly, it also tends to give the “right” notion of profunctor starting with many other, even more exotic, 2-categories. However, it is trickier to figure out how to define the composite of profunctors viewed as codiscrete cofibrations; see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+cofibration"} codiscrete cofibration
          %h3#comparing_fibrations_and_cofibrations Comparing fibrations and cofibrations
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mover
                    %mo →
                    %mi g
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ¯
                  %mover
                    %mo ←
                    %mi f
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \overset{g}{\to} \bar{H} \overset{f}{\leftarrow} D
            is a codiscrete cofibration representing a profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} ↓
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f\downarrow g)
            with its two projections to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            Dually, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mover
                    %mo ←
                    %mi p
                  %mi E
                  %mover
                    %mo →
                    %mi q
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \overset{p}{\leftarrow} E \overset{q}{\to} D
            is a two-sided discrete fibration representing a profunctor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %span.newWikiWord
              cocomma object
              %a{:href => "/nlab/new/cocomma+object"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} ↑
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (q\uparrow p)
            with the two inclusions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            In fact, in any 2-category with comma and cocomma objects, we have an
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cocomma
                  %mo :
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇄
                  %mspace{:width => "thickmathspace"}
                  %mi Cospan
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi comma
                  %mo .
                %annotation{:encoding => "application/x-tex"} cocomma: Span(C,D) \;\rightleftarrows\; Cospan(C,D) : comma.
          %p
            One can show that comma objects are always discrete fibrations, and dually cocomma objects are always codiscrete cofibrations. In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            and other similar 2-categories, this adjunction is
            %a.existingWikiWord{:href => "/nlab/show/idempotent+adjunction"} idempotent
            and restricts to an equivalence between the categories of discrete fibrations and codiscrete cofibrations (both of which are of course equivalent to the category of profunctors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
          %h3#in_terms_of_spans In terms of spans
          %p
            A profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            can also be viewed as a span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo ←
                  %msub
                    %mi F
                    %mn 1
                  %mo →
                  %msub
                    %mi D
                    %mn 0
                %annotation{:encoding => "application/x-tex"} C_0 \leftarrow F_1 \rightarrow D_0
            that is compatible with composition in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            in an appropriate way. This formulation falls out from the definition of a category as a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            in the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            (more generally
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            %a.existingWikiWord{:href => "/nlab/show/Span"} Span
            and defining a profunctor to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/module+over+a+monad"} bimodule
          %h2#examples Examples
          %ul
            %li
              %p
                Recall that a one-object
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                is just an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/algebroid"} algebroid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                    %annotation{:encoding => "application/x-tex"} Vect\Mod
                on one-object
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Vect
                      %annotation{:encoding => "application/x-tex"} Vect
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
                %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
                and bimodule homomorphisms. In this case, the “representable” profunctors correspond to the way in which every morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
                of
                %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
                induces the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                bimodule which as a vector space is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                with obvious right
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                action and left
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                via
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and then using multiplication in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p
                The full sub-bicategory of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Set Prof
                on
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete categories
                is the bicategory of sets,
                %a.existingWikiWord{:href => "/nlab/show/spans"} spans
                of sets and morphisms of spans:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                        %mi disc
                      %mo ≃
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Set\Mod_{disc} \simeq Span(Set)
                      \\,.
              %p
                In particular a
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                between sets is a special case of this. From this point of view the 2-category
                %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
                of profunctors is a
                %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
                of the category
                %a.existingWikiWord{:href => "/nlab/show/Rel"} Rel
                of sets and relations.
              %p
                Moreover, the representable profunctor between discrete category induced by a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} f : C \to D
                of sets is the span
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mi Id
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mi f
                          %mtr
                            %mtd
                              %mi C
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi D
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; C
                      \\\
                      \&amp; {}^{Id}\swarrow &amp;&amp; \searrow^{f}
                      \\\
                      C &amp;&amp;&amp;&amp; D
                      }
                      \\,.
            %li
              %p
                Similarly, the full sub-bicategory of internal profunctors in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Set
                        %mi op
                      %mo ,
                      %mo ×
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S = (Set^{op}, \times)
                on “discrete categories” is the bicategory of
                %a.existingWikiWord{:href => "/nlab/show/cospans"} cospans
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi op
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Mod
                        %mi disc
                      %mo ≃
                      %mi Span
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Set
                        %mi op
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Cospan
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Set^{op}\Mod_{disc} \simeq Span(Set^{op}) = Cospan(Set)
                      \\,.
            %li
              %p
                for
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
                over a
                %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
                an
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                is a
                %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
                and a profunctor is now a dg-
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
                of dg-categories. This appears notably in the definition of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
          %h2#Properties Properties
          %ul
            %li
              %p
                If a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                represents a given profunctor, then the action of the functor on morphisms is determined by the action of the profunctor and the representation isomorphism. For details see at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/representability+determines+functoriality"} representability determines functoriality
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ↦
                        %msub
                          %mi F
                          %mo *
                      %annotation{:encoding => "application/x-tex"} F\mapsto F_*
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi F
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_*(d,c)=\mathcal{D}(d,F c)
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category#InOrdinaryCatTheoryByProfunctors"} Cauchy completion
                of their codomain.
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/module"} module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-vector+space"} 2-vector space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/double+profunctor"} double profunctor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nucleus+of+a+profunctor"} nucleus of a profunctor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mealy+morphism"} Mealy morphism
          %h2#references References
          %p
            Original articles (in which, for instance, the perspective of profunctors over the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            is discussed):
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maren+Justesen"}> Maren Justesen
                ,
                = succeed "," do
                  %em Bikategorien af Profunktorer
                = succeed ")" do
                  %a{:href => "https://ncatlab.org/nlab/files/Justesen_Profunktoren.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
                , Chapter 3 of:
                = succeed "," do
                  %em Categories of Set-Valued Functors
              %blockquote
                %p
                  based on suggestions by
                  %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michel+Andr%C3%A9"}> Michel André
                ,
                = succeed "," do
                  %em Categories of Functors and Adjoint Functors
                = succeed ",American" do
                  %em Categories of Functors and Adjoint Functors
            %li#Benabou73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                = succeed "," do
                  %em Les distributeurs
                %strong 33
                (1973) &amp;lbrack;
                %a{:href => "http://www.entretemps.asso.fr/maths/DistributeursLouvain.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Benabou-LesDistributeurs.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (including discussion of
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
                  and
                  %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal
                  profunctors)
          %p
            Some of these ideas were exposed at Oberwolfach in 1966. There are extant notes taken by
            %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"} Anders Kock
            of a talk by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Bill+Lawvere"} Bill Lawvere
          %p Textbook account:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Sec. 7.7
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                    I
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fosco+Loregian"}> Fosco Loregian
                \. Profunctors. In: (Co)End Calculus. London Mathematical Society Lecture Note Series. Cambridge University Press; 2021:126-160. (
                %a{:href => "https://doi.org/10.1017/9781108778657.006"}> doi
                ).
          %p Lecture notes:
          %ul
            %li{:id => "Bénabou00"}
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"} Jean Bénabou
              (notes by
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
              = succeed "," do
                %em Distributors at Work
              = succeed "," do
                %a{:href => "http://www.mathematik.tu-darmstadt.de/~streicher/FIBR/DiWo.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Benabou-DistributorsAtWork.pdf", :title => "pdf"} pdf
          %p Exposition:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              %em Re: Klein 2-Geometry VII
              (
              %a{:href => "http://golem.ph.utexas.edu/category/2006/11/klein_2geometry_vii.html#c005985"}> blog
              )
          %p
            A nice example of profunctors between Lawvere
            %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
            can be found in
            = succeed "." do
              %a{:href => "http://golem.ph.utexas.edu/category/2009/11/equipments.html#c029633"} this comment
          %p The following classic paper is a good appetizer
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              ,
              %em Metric Spaces, Generalized Logic, and Closed Categories
              , Rendiconti di Seminario matématico e fisico di Milano XLIII (1973) pp.135-166. Reprinted in TAC Reprints no.1 (2002) pp.1-37. (
              %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/1/tr1abs.html"}> tac
              )
          %p
            See the
            %a.existingWikiWord{:href => "/joyalscatlab/published/HomePage"} Joyal's CatLab
            for the theory of
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              ,
              %em
                %a.existingWikiWord{:href => "/joyalscatlab/published/Distributors+and+barrels"} Distributors and barrels
              \.
          %p Internal profunctors are considered in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em Topos Theory
                , Academic Press New York 1977. (Dover reprint Minneola 2014; sect. 2.4)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                = succeed "," do
                  %em
                    Sketches of an
                    %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
                    I
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
            is almost explicit in:
          %ul
            %li#Cattani99
              %a.existingWikiWord{:href => "/nlab/show/Gian+Luca+Cattani"}> Gian Luca Cattani
              ,
              = succeed "," do
                %em Presheaf Models for Concurrency
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/BRICS"} BRICS
              = succeed "," do
                %a{:href => "http://www.brics.dk/DS/99/1/BRICS-DS-99-1.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Cattani_PresheafModels.pdf", :title => "pdf"} pdf
          %p
            Profunctors play an important in categorical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/shape+theory"} shape theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dominique+Bourn"}> Dominique Bourn
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jean-Marc+Cordier"} Jean-Marc Cordier
              = succeed "," do
                %em Distributeurs et théorie de la forme
              %strong 21
              no.2 (1980) pp.161-189. (
              %a{:href => "http://www.numdam.org/item/CTGDC_1980__21_2_161_0"}> numdam:CTGDC_1980__21_2_161_0
              ,
              = succeed ")" do
                %a{:href => "http://archive.numdam.org/ARCHIVE/CTGDC/CTGDC_1980__21_2/CTGDC_1980__21_2_161_0/CTGDC_1980__21_2_161_0.pdf"} pdf
          %p The material together with a general discussion of profunctors is also available in English in the reprinted monograph
          %ul
            %li
              J.-M. Cordier ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter
              %em Shape Theory: Categorical Methods of Approximation
              , (1989), Mathematics and its Applications, Ellis Horwood. Reprinted Dover (2008).
          %p Discussion of simplicial enriched profunctors in the context of strong shape theory in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Batanin"}> Michael Batanin
              ,
              = succeed "," do
                %em Categorical Strong Shape Theory
              %strong 38
              no.1 (1997) pp.3-66. (
              %a{:href => "http://archive.numdam.org/ARCHIVE/CTGDC/CTGDC_1997__38_1/CTGDC_1997__38_1_3_0/CTGDC_1997__38_1_3_0.pdf"}> pdf
              )
          %p
            Overview and application in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gian+Luca+Cattani"}> Gian Luca Cattani
              , G. Winskel,
              %em Profunctors, Open Maps, and Bisimulation
              ,
              %a.existingWikiWord{:href => "/nlab/show/BRICS"} BRICS
              Report
              %strong 04-22
              (2004) &amp;lbrack;
              %a{:href => "http://www.brics.dk/RS/04/22/BRICS-RS-04-22.pdf"}> pdf
              \&amp;rbrack;
          %p
            The common generalization of
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            and
            %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            in terms of profunctors has been discussed on the blog at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              %em Bimodules versus spans
              (
              %a{:href => "http://golem.ph.utexas.edu/category/2008/08/bimodules_versus_spans.html"}> blog
              )
          %p Distributions on a category as lax functors into the category of distributors are sketched in the abstract:
          %ul
            %li#Benabou95
              %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
              ,
              = succeed "," do
                %em Distributions and 2-descent
              %a{:href => "https://oda.mfo.de/themes/MFO/vendor/pdfjs-dist-viewer-min/build/minified/web/viewer.html?file=https://oda.mfo.de/bitstream/handle/mfo/102/full-text.pdf#page=275"} pdf
          %p
            On its restriction to
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoids
            and its relation to the
            %a.existingWikiWord{:href => "/nlab/show/Burnside+category"} Burnside category
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Haynes+Miller"}> Haynes Miller
              \.
              = succeed "." do
                %em The Burnside bicategory of groupoids
              = succeed ")." do
                %a{:href => "https://arxiv.org/abs/1208.2360"} arXiv:1208.2360
              = succeed ")." do
                %a{:href => "https://doi.org/10.1007/s40590-016-0143-5"} doi
          %h2#notation Notation
          %p
            Profunctors are often notated with a slashed or barred arrow, as in
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %ul
            %li
              %p On the nLab (or anywhere that accepts SGML character entities, including raw HTML on the web), it can be found using a Unicode entity:
              %pre
                %code &amp;#8696;
            %li
              %p
                In LaTeX, one can use
                %code \nrightarrow
                (producing ‘
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ↛
                    %annotation{:encoding => "application/x-tex"} \nrightarrow
                ’) in a pinch, but a nice-looking extensible barred arrow command
                %code \xslashedrightarrow
                can also be produced with the following preamble code (modified from amsmath’s
                = succeed ")." do
                  %code \xrightarrow
                %code amsmath
                and
                %code mathtools
                to be loaded.
              %pre
                %code
                  :preserve
                    \makeatletter
                    \def\slashedarrowfill@#1#2#3#4#5{%
                      $\m@th\thickmuskip0mu\medmuskip\thickmuskip\thinmuskip\thickmuskip
                      \relax#5#1\mkern-7mu%
                      \cleaders\hbox{$#5\mkern-2mu#2\mkern-2mu$}\hfill
                      \mathclap{#3}\mathclap{#2}%
                      \cleaders\hbox{$#5\mkern-2mu#2\mkern-2mu$}\hfill
                      \mkern-7mu#4$%
                    }
                    \def\rightslashedarrowfill@{%
                      \slashedarrowfill@\relbar\relbar\mapstochar\rightarrow}
                    \newcommand\xslashedrightarrow[2][]{%
                      \ext@arrow 0055{\rightslashedarrowfill@}{#1}{#2}}
                    \makeatother              %p
                The command
                %code \xslashedrightarrow
                can then be used with one required argument and one optional argument, just like
                = succeed "." do
                  %code \xrightarrow
              %pre
                %code \def\slashedrightarrow{\xslashedrightarrow{}}
              %p A simpler barred arrow taking no arguments can be created with
              %pre
                %code \def\slashedrightarrow{\relbar\joinrel\mapstochar\joinrel\rightarrow}
            %li
              %p In Xypic, a barred arrow (to the right, in this example) can be produced with
              %pre
                %code \ar[r]|-@{|}
        .revisedby
          %p
