          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            and
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            of some
            %a.existingWikiWord{:href => "/nlab/show/small+category"} shape
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are
            = succeed "," do
              %strong
                stable by
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            = succeed "," do
              %strong stable under pullback
            = succeed "," do
              %strong universal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G : D \to C
            and for all
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            diagrams of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi colim
                            %mi D
                          %mi G
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mi Z
                          %mi Y
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi colim
                            %mi D
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %munder
                            %mo →
                            %mi f
                        %mtd
                          %mi Z
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (colim_D G) \times_Z Y &amp;\to&amp; colim_D G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  Y &amp;\underset{f}{\to} &amp; Z
                  }
          %p the canonical morphism
          #eq:IsoForPullbackStabilityOfColimis.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi colim
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mi Z
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mo{:stretchy => "false"} (
                  %munder
                    %mi colim
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mi Z
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\underset{d \in D}{colim} (G(d) \times_Z Y)
                  \\stackrel{\simeq}{\to}
                  (\underset{d \in D}{colim} G(d)) \times_Z Y
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Z
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f^*: C/Z \to C/Y
            %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
            = succeed "-colimits." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+categories"} higher categories
          %p
            To see that this definition is equivalent to the universality condition given at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/van+Kampen+colimit#universality_and_descent"} van Kampen colimit
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                    %mo :
                    %mi F
                    %mo ′
                    %mo ⇒
                    %mi G
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha' : F' \Rightarrow G'
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi α
                              %msub
                                %mo ′
                                %mo *
                        %mtd
                          %msub
                            %mi colim
                            %mi D
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} id
                      %mtr
                        %mtd
                          %mi F
                          %mo ′
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi α
                              %msub
                                %mo ′
                                %mo *
                        %mtd
                          %msub
                            %mi colim
                            %mi D
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F'(*) &amp;\overset{\alpha'_*}{\to}&amp; colim_D G
                  \\\
                  ^\id\downarrow &amp;&amp; \downarrow^\id
                  \\\
                  F'(*) &amp;\underset{\alpha'_*}{\to} &amp; colim_D G
                  }
          %p
            is a degenerate
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            square, hence there is a canonical isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi colim
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %msub
