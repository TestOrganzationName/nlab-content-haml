                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi F
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  colim_{d \in D}(G(d) \times_{colim_D G} F'(*)) \simeq F'(*).
          %p
            But if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \alpha'
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equifibered+natural+transformation"} equifibered
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi colim
                          %mi D
                        %mi G
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(d) \times_{colim_D G} F'(*) \simeq F(d)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
