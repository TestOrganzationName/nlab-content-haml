                    %mover
                      %mi Λ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} A \to \mathbf{B} \mathbb{R}^n / \Lambda \times \mathbf{B} \mathbb{R}^n / \hat \Lambda
              be the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the pairing class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} /
