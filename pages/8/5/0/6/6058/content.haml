                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi Λ
                  %mo ⊗
                  %mover
                    %mi Λ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
