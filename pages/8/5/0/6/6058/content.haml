                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} /
                      %mover
                        %mi Λ
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 3
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} \mathbb{R}^n / \Lambda \times \mathbf{B} \mathbb{R}^n / \hat \Lambda \to \mathbf{B}^3 U(1)
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              (as discussed there)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
