                  %mn 2
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} (\mathbf{Z}[2]^\infty_D)^{\otimes n}\cong \Lambda[2]^\infty_D
            induced by the choice of a
            = succeed "-basis" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
