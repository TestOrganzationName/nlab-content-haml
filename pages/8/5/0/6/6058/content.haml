                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} (\mathbf{B}\mathbb{R}^n/\Lambda)_{conn}
            for the smooth groupoid associated by the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            to the Deligne complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi D
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Lambda[2]^\infty_D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mi Λ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} /
                  %mover
                    %mi Λ
                    %mo{:stretchy => "false"} ^
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  (\mathbf{B}\mathbb{R}^n/\Lambda)_{conn}\times (\mathbf{B}(\mathbb{R}^n)^*/\hat\Lambda)_{conn}\to \mathbf{B}^3\mathbf{U}(1)_{conn}
          %p induced by the composition of morphisms of complexes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
                  %mo ⊗
                  %mover
                    %mi Λ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
                  %mover
                    %mo →
                    %mo ∪
                  %mo{:stretchy => "false"} (
                  %mi Λ
                  %mo ⊗
                  %mover
                    %mi Λ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mn 4
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
                  %mover
                    %mo →
                    %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 4
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda[2]^\infty_D\otimes \hat{\Lambda}[2]^\infty_D
                  \\stackrel{\cup}{\to}
                  (\Lambda\otimes\hat\Lambda)[4]^\infty_D \stackrel{}{\to}\mathbb{Z}[4]^\infty_D,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∪
                %annotation{:encoding => "application/x-tex"} \cup
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Beilinson-Deligne+cup-product"} Beilinson-Deligne cup-product
          %p
            Notice that this is the one which defines
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} abelian Chern-Simons theories
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of the
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle with connection
            appearing here is the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of torus-
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"}> Chern-Simons theory
            \.
          %p
            Differential T-duality pairs form the homotopy fiber of the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mi Λ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} /
                  %mover
                    %mi Λ
                    %mo{:stretchy => "false"} ^
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mstyle{:mathvariant => "bold"}
                    %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} (\mathbf{B}\mathbb{R}^n/\Lambda)_{conn}\times (\mathbf{B}(\mathbb{R}^n)^*/\hat\Lambda)_{conn}\to \mathbf{B}^3\mathbf{U}(1)_{conn}
            It relates differential cohomological structures on
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n / \Lambda
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} /
                    %mover
                      %mi Λ
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^n)^* /\hat \Lambda
          #DifferentialTDualityPair.num_defn
            %h6#definition Definition
            %p
              A
              %strong differential T-duality pair
              is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mi Λ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n/\Lambda
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \to X
                  with connection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} \theta
                  and a
                  = succeed "-principal" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} /
                          %mover
                            %mi Λ
                            %mo{:stretchy => "false"} ^
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^n / \hat \Lambda
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi P
                          %mo{:stretchy => "false"} ^
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \hat P \to X
                  with connection
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi θ
                            %mo{:stretchy => "false"} ^
                        %annotation{:encoding => "application/x-tex"} \hat \theta
                %p
                  such that the underlying topological class of the
                  %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi θ
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi P
                          %mo{:stretchy => "false"} ^
                        %mo ,
                        %mover
                          %mi θ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (P, \theta) \cup (\hat P, \hat \theta )
                  is trivial;
              %li
                %p a choice of trivialization
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo :
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mo ≃
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi θ
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi P
                          %mo{:stretchy => "false"} ^
                        %mo ,
                        %mover
                          %mi θ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\sigma
                        \:
                        (0,C) \stackrel{\simeq}{\to} (P, \theta) \cup (\hat P , \hat \theta)
                        \\,.
          %p
            This is (
            %a{:href => "#KahleValentino"}> KahleValentino, def. 2.1
            ). It is the evident differential generalization of the description in
            %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
            that appears for instance around (7.11) of (
            %a{:href => "#BunkeSchick"}> BunkeSchick
            ).
          .num_remark
            %h6#remark Remark
            %p
              We may refine this naturally to a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
                of twisted T-duality pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TDualityPairs
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} TDualityPairs(X)_{conn}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi TDualityPairs
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                          %mtd
                            %mover
                              %mo →
                              %mi tw
                          %mtd
                            %msubsup
                              %mi H
                              %mi diff
                              %mn 4
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mi σ
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mi Λ
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mover
                              %mi Λ
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    TDualityPairs(X)_{conn} &amp;\stackrel{tw}{\to}&amp; H^4_{diff}(X)
                    \\\
                    \\downarrow &amp;\swArrow_{\sigma}&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}\mathbb{R}^n/\Lambda \times \mathbf{B} \mathbb{R}^n/\hat \Lambda)
                    \&amp;\stackrel{}{\to}&amp;
                    \\mathbf{H}(X, \mathbf{B}^3 U(1))_{conn}
                    }
                    \\,.
            %p
              This is itself an example of
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
              (as discussed there). (We use here the notation at
              %em
                %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
              \.)
            %p
              The differential T-duality pairs of def.
              %a.maruku-ref{:href => "#DifferentialTDualityPair"}
              are those elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi TDualityPairs
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} (P,\hat P, \sigma) \in TDualityPairs(X)_{conn}
              for which the
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tw
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi H
                      %mi diff
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} tw(P,\hat P, \sigma) \in H^4_{diff}(X)
              in
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              has an underlying trivial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle 3-bundle
            %p
              Notice that the above analogous to the notion of
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"}> differential string structure
                s in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi StringBund
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi tw
                          %mo ,
                          %mi conn
                    %annotation{:encoding => "application/x-tex"} StringBund(X)_{tw,conn}
                over
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi StringBund
                            %mo{:stretchy => "false"} (
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi tw
                                %mo ,
                                %mi conn
                          %mtd
                            %mo →
                          %mtd
                            %msubsup
                              %mi H
                              %mi diff
                              %mn 4
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mi σ
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi Spin
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SU
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mfrac
                                  %mn 1
                                  %mn 2
                                %msub
                                  %mover
                                    %mstyle{:mathvariant => "bold"}
                                      %mi p
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %mo −
                                %mfrac
                                  %mn 1
                                  %mn 46
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo{:stretchy => "false"} ^
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    StringBund(X)_{tw,conn} &amp;\to&amp; H^4_{diff}(X)
                    \\\
                    \\downarrow &amp;\swArrow_{\sigma}&amp; \downarrow
                    \\\
                    \\mathbf{H}(X, \mathbf{B}Spin \times \mathbf{B} SU)
                    \&amp;\stackrel{\frac{1}{2}\hat \mathbf{p}_1 - \frac{1}{46}\hat \mathbf{c}}{\to}&amp;
                    \\mathbf{H}(X, \mathbf{B}^3 U(1))_{conn}
                    }
                    \\,.
            %p
              In particular the
              %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TString
                  %annotation{:encoding => "application/x-tex"} TString
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi TString
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mi Λ
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} /
                            %mover
                              %mi Λ
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ∪
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}TString &amp;\stackrel{}{\to}&amp; \ast
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    \\mathbf{B}\mathbb{R}^n/\Lambda \times \mathbf{B} \mathbb{R}^n/\hat \Lambda
                    \&amp;\stackrel{\langle - \cup -\rangle}{\to}&amp;
                    \\mathbf{B}^3 U(1))_{conn}
                    }
            %p
              has the right to be called the
              %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} T-duality 2-group
              or similar. The
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundles"} principal 2-bundles
              for this are
              %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
              (see there).
          .num_defn
            %h6#definition_roughly Definition (roughly)
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi diff
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff,2}(X, \mathbf{B}^3 U(1))
              for a
              %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
              whose objects are cocycles in
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              in degree 4, but whose morphisms need not preserve connections and are instead such that the
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              of the 0-object is that of circle 2-bundles with connection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mi diff
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mn 2
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}(X, \mathbf{B}^2 U(1))
          %p
            A 1-groupoid truncation of this idea is the object denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℋ
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^p(X)
            in
            = succeed "." do
              %a{:href => "#KahleValentino"} KahleValentino, A.2
          .num_remark
            %h6#remark_2 Remark
            %p
              In terms of the notion of
              %a.existingWikiWord{:href => "/nlab/show/differential+function+complex"} differential function complex
              we should simply set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mi diff
                        %mo ,
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi filt
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi H
                    %msub
                      %mi ℤ
                      %mn 4
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}_{diff,2}(X, \mathbf{B}^3 U(1))
                    \:=
                    filt_1 ( H \mathbb{Z}_4)^X
                    \\,.
            %p
              (Notice the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi filt
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} filt_1
              instead of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi filt
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} filt_0
              %a{:href => "http://ncatlab.org/nlab/show/differential%20function%20complex#homotopy_groups_24"} this proposition
              this has the right properties.
          .num_lemma
            %h6#lemma Lemma
            %p
              The choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of the trivialization of the cup product of the two torus bundles induces canonically elments in degree 3 ordinary differential cohomology (two
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundles with connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat P
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mo ×
                      %mi X
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} P \times_X \hat P
              are equivalent there.
          %p
            This is (
            %a{:href => "#KahleValentino"}> KahleValentino, 2.2, 2.3
            ), where an explicit construction of the classes and their equivalence is given.
          .num_remark
            %h6#remark_3 Remark
            %p
              This is a special case of the general statement about extensions of higher bundles discussed
              = succeed ":" do
                %a{:href => "http://www.ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos+--+structures#ExtendedBundlesByBundlesOfExtensions"} here
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mi Λ
