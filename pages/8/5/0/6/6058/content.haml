                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
