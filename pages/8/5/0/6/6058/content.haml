          %p
            by considering the
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne complex
            of sheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mi D
                    %mn ∞
