                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Fix(p) \subseteq g^{-1}(0)
                  \.
              %li
                %p
                  The map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo :
                        %mi U
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} p: U \to U
                  restricts to a map
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
