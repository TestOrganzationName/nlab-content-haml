            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a local sheaf of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi CartSp
                %annotation{:encoding => "application/x-tex"} U \in CartSp
            is canonically incarnated as the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
            %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
