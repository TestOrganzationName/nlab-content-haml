                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi U
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi 𝒪
                    %mi U
                  %mo :
                  %mi CartSp
                  %mover
                    %mo →
                    %mi j
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
