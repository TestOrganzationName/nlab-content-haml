                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\mathcal{X}, \mathcal{O}_{\mathcal{X}})
                  \:=
                  (Sh_{(\infty,1)}(CartSp)/U ,
                  \\;\;\; \mathcal{O}_U : CartSp \stackrel{j}{\to} Sh_{(\infty,1)}(CartSp) \stackrel{U^*}{\to} Sh_{(\infty,1)}(CartSp)/U)
          %p
            given by the
            %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
            of the
            %a.existingWikiWord{:href => "/nlab/show/big+topos"} big
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CartSp
                %annotation{:encoding => "application/x-tex"} CartSp
            and the
            %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
            given by the composite of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
            and the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            of the
            %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
            induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %h4#smoothManifoldsAsLocallyRepresentableObjects
            Smooth manifolds as locally representable objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi CartSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(CartSp)
          .num_defn
            %h6#definition_2 Definition
            %p
              Say a
              %a.existingWikiWord{:href => "/nlab/show/concrete+sheaf"} concrete object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              – a
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              – is
              %em locally representable
              if there exists a family of open embeddings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi X
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow X\}_{i \in X}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ∈
                    %mi CartSp
                    %mover
                      %mo ↪
                      %mi j
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_i \in CartSp \stackrel{j}{\hookrightarrow} Sh(CartSp)
              such that the canonical morphism out of the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\coprod_i U_i \to X
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(CartSp)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocRep
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} LocRep(CartSp) \hookrightarrow Sh(CartSp)
              be the full
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              on locally representable sheaves.
          .num_prop
            %h6#proposition Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Diff
                    %mo ≃
                    %mi LocRep
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Diff \simeq LocRep(CartSp)
            %p
              of the category
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              of smooth manifolds with that of locally representable sheaves for the
              %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28infinity%2C1%29-toposes%29"} pre-geometry
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
          .proof
            %h6#proof_2 Proof
            %p
              Define a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Diff
                    %mo →
                    %mi LocRep
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Diff \to LocRep(CartSp)
              by sending each smooth manifold to the sheaf over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} CartSp
              that it naturally represents. By definition of
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              there is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ↪
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow X\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \coprod_i U_i \to X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LocRep
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} LocRep(CartSp)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p For that we need to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi j
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\coprod_{i, j} U_i \times_X U_j \stackrel{\longrightarrow}{\longrightarrow} \coprod_i U_i \to X
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              (that the
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              of the cover is equivalent to
              = succeed ".)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              here is just the intersection in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo ×
                        %mi X
                      %msub
                        %mi U
                        %mi j
                      %mo ≃
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \times_X U_j \simeq U_i \cap U_j
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              is by definition a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(CartSp)
              we have that
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              are computed as the
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              of the corresponding colimit in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(CartSp)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(CartSp)
              in turn is computed objectwise. Using this, we see that that we have a coequalizer diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi j
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\coprod_{i, j} U_i \times_X U_j \stackrel{\longrightarrow}{\longrightarrow} \coprod_i U_i \to S(\{U_i\})
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi CartSp
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(CartSp)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\{U_i\})
              is the
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              corresponding to the cover: the
              %a.existingWikiWord{:href => "/nlab/show/subfunctor"} subfunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S(\{U_i\}) \hookrightarrow X
              of the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X : CartSp^{op} \to Set
              which assigns to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} V \in CartSp
              the set of
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              that have the property that they factor through any one of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
            %p
              Essentially by the definition of the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              takes this subfunctor inclusion to an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is indeed the tip of the coequalizer in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(CartSp)
              as above, and hence that it is a locally representable sheaf.
            %p
              Conversely, suppose that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Conc
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Conc(Sh(CartSp)) \hookrightarrow Sh(CartSp)
              there is a family of open embeddings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ↪
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \hookrightarrow X\}
              such that we have a coequalizer diagram
            .maruku-equation
