                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d p(0), Id-d p(0): T_0(U) \to T_0(U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
