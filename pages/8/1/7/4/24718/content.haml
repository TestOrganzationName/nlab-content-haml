            %li
              A
              %a.existingWikiWord{:href => "/nlab/show/colax+morphism"} colax morphism
              of monads
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
