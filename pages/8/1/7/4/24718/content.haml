          %h2#idea Idea
          %p
            A
            %strong wreath
            is a generalisation of a
            %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive law
            between two
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            can be seen as an object of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mnd
                    %mo{:stretchy => "false"} (
                    %mi Mnd
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mnd(Mnd(K))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi EM
                    %mo{:stretchy => "false"} (
                    %mi EM
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} EM(EM(K))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EM
                %annotation{:encoding => "application/x-tex"} EM
            denotes the completion of a 2-category under
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg%E2%80%93Moore+objects"} Eilenberg–Moore objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi EM
                %annotation{:encoding => "application/x-tex"} EM
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-monad"} 2-monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
