                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}
              plus a comparison 2-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
