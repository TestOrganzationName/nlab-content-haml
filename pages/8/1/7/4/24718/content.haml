                    %mi KL
                    %mo{:stretchy => "false"} (
                    %mi 𝒦
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} KL(KL(\mathcal{K}))
