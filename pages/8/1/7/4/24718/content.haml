          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/distributive+law"} distributive law
          %h2#literature Literature
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steve+Lack"}> Steve Lack
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em The formal theory of monads II
              %p J. Pure Appl. Algebra 175 (2002), no. 1-3, 243–265.
            %li
              %p
                Dimitri Chikhladze,
                = succeed "," do
                  %em A note on warpings of monoidal structures
                %a{:href => "https://arxiv.org/abs/1510.00483"} arXiv:1510.00483
                (2015).
