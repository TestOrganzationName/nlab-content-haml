          %h2#duality Duality
          %p
            A
            %em cowreath
            (for lack of better terminology) in a 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"} \mathcal{K}
            is an object of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KL
                    %mo{:stretchy => "false"} (
                    %mi KL
                    %mo{:stretchy => "false"} (
                    %mi 𝒦
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} KL(KL(\mathcal{K}))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KL
                  %mo{:stretchy => "false"} (
                  %mi 𝒦
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi EM
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒦
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} KL(\mathcal{K}) = EM(\mathcal{K}^{op})^{op}
            is the free Kleisli completion of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}
          %p It consists of
          %ol
            %li
              A
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi t
                    %mo ,
                    %mi η
                    %mo ,
                    %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,t, \eta, \mu)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                    %annotation{:encoding => "application/x-tex"} \mathcal{K}
            %li
              A 1-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s,\lambda):(A,t) \to (A,t)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KL
                      %mo{:stretchy => "false"} (
                      %mi 𝒦
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} KL(\mathcal{K})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} s:A \to A
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}
              and a 2-cell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo :
                    %mi st
                    %mo →
                    %mi ts
                  %annotation{:encoding => "application/x-tex"} \lambda : st \to ts
              satisfying axioms as above.
            %li
              Two 2-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mn 1
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma : 1 \to (s,\lambda)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu : (s, \lambda)(s,\lambda) \to (s, \lambda)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KL
                      %mo{:stretchy => "false"} (
                      %mi 𝒦
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} KL(\mathcal{K})
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                    %annotation{:encoding => "application/x-tex"} \mathcal{K}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mn 1
                    %mo →
                    %mi ts
                  %annotation{:encoding => "application/x-tex"} \sigma : 1 \to ts
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi nu
                      %mo :
                      %mi ss
                      %mo →
                      %mi ts
                    %annotation{:encoding => "application/x-tex"} nu : ss \to ts
