          %h2#extranatural_calculus Extranatural calculus
          %p We set down a few basic lemmas which describe how extranatural transformations compose. These lemmas become very intuitive once one draws string diagrams to accompany them. (Cf. “yanking moves” in the string diagram calculus of adjunctions.)
          .un_lemma
            %h6#lemma_1_stalactites Lemma 1 (“stalactites”)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F \colon C^{op} \times C \to D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %munder
                        %mrow
                          %msup
                            %mi C
                            %mi op
                          %mo ×
                          %mi C
                          %mo ×
                          %mi ⋯
                          %mo ×
                          %msup
                            %mi C
                            %mi op
                          %mo ×
                          %mi C
                        %mo ⏟
                      %mrow
                        %mn 2
                        %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G \colon \underbrace{C^{op} \times C \times \cdots \times C^{op} \times C}_{2n} \to D
              be functors. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mrow
                        %mi x
                        %mo ,
                        %msub
                          %mi y
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi y
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ,
                        %mi z
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_{x, y_1, \ldots, y_{n-1}, z} \colon F(x, z) \to G(x, y_1, y_1, \ldots, y_{n-1}, y_{n-1}, z)
              is natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x,z
              and extranatural in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi y
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} y_1, \ldots, y_{n-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi y
                          %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \beta_{y_1, \ldots, y_n} \colon G(y_1, y_1, \ldots, y_n, y_n) \to H
              (for some object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} y_1, \ldots, y_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mrow
                        %msub
                          %munder
                            %mrow
                              %mi x
                              %mo ,
                              %mi …
                              %mo ,
                              %mi x
                            %mo ⏟
                          %mi n
                    %msub
                      %mi α
                      %mrow
                        %msub
                          %munder
                            %mrow
                              %mi x
                              %mo ,
                              %mi …
                              %mo ,
                              %mi x
                            %mo ⏟
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \beta_{\underbrace{x, \ldots, x}_{n}} \alpha_{\underbrace{x, \ldots, x}_{n+1}}: F(x, x) \to H
            %p
              is extranatural in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %center
            %img{:src => "http://younesse.net/assets/nLab/extranatural+transformation/svg/extranatural+transformation_stalactites.svg", :width => "450"}/
          .un_lemma
            %h6#lemma_2_stalagmites Lemma 2 (“stalagmites”)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %munder
                        %mrow
                          %msup
                            %mi C
                            %mi op
                          %mo ×
                          %mi C
                          %mo ×
                          %mi ⋯
                          %mo ×
                          %msup
                            %mi C
                            %mi op
                          %mo ×
                          %mi C
                        %mo ⏟
                      %mrow
                        %mn 2
                        %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G \colon \underbrace{C^{op} \times C \times \cdots \times C^{op} \times C}_{2n} \to D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mi op
                    %mo ×
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} H \colon C^{op} \times C \to D
              be functors. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi y
                          %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_{y_1, \ldots, y_n} \colon F \to G(y_1, y_1, \ldots, y_n, y_n)
              (for some object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
