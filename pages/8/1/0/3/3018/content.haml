                      %mi B
                    %annotation{:encoding => "application/x-tex"} b\in B
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi b
                              %mo ,
                              %mi b
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi α
                                    %mrow
                                      %mi a
                                      %mo ,
                                      %mi b
                                      %mo ,
                                      %mi c
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi c
                              %mo ,
                              %mi c
                              %mo{:stretchy => "false"} )
                            %mtd
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi α
                                    %mrow
                                      %mi a
                                      %mo ,
                                      %mi b
                                      %mo ,
                                      %mi c
                                      %mo ′
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo ,
                                  %mi h
                                  %mo ,
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi c
                              %mo ′
                              %mo ,
                              %mi c
                              %mo ′
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo ,
                                  %mn 1
                                  %mo ,
                                  %mi h
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo ,
                              %mi c
                              %mo ′
                              %mo ,
                              %mi c
                              %mo{:stretchy => "false"} )
                            %mtd
                    %annotation{:encoding => "application/x-tex"}
                      \\array{&amp;F(a,b,b) &amp; \overset{\alpha_{a,b,c}}{\to} &amp; G(a,c,c) &amp;\\
                      ^{\alpha_{a,b,c'}} &amp;\downarrow &amp;&amp; \downarrow &amp; ^{G(1,h,1)}\\
                      \&amp; G(a,c',c') &amp; \underset{G(1,1,h)}{\to} &amp; G(a,c',c) &amp;}
