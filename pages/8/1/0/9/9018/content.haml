              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2408.16609"}> arXiv:2408.16609
              \&amp;rbrack;
          %h3#ReferencesPhenomenology Phenomenology
          %p
            Popular exposition of the
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-MSSM"} G₂-MSSM
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenology
          %ul
            %li#Kane17
              %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"}> Gordon Kane
              ,
              = succeed "," do
                %em String theory and the real world
              = succeed ")" do
                %a{:href => "http://iopscience.iop.org/book/978-1-6817-4489-6"} doi:0.1088/978-1-6817-4489-6
          %p
            Further discussion of
            %a.existingWikiWord{:href => "/nlab/show/string+phenomenology"} string phenomenology
            in terms of
            = succeed "-theory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-manifolds," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
            = succeed "," do
              %a{:href => "#Acharya98"} Acharya 98
            = succeed "," do
              %a{:href => "#AtiyahWitten01"} Atiyah-Witten 01
            = succeed "):" do
              %a{:href => "#AcharyaWitten01"} Acharya-Witten 01
          %ul
            %li#AcharyaKaneKumar12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
                = succeed "," do
                  %em Compactified String Theories – Generic Predictions for Particle Physics
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1204.2795"} arXiv:1204.2795
            %li#Acharya12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} G_2
                    \-manifolds at the CERN Large Hadron collider and in the Galaxy
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                  \-days
                (2012) (
                %a{:href => "http://www.mth.kcl.ac.uk/~tbmadsen/acharya.pdf"}> pdf
                )
            %li#Kane16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"}> Gordon Kane
                ,
                %em String/M-theories About Our World Are Testable in the traditional Physics Way
                (
                %a{:href => "http://arxiv.org/abs/1601.07511"}> arXiv:1601.07511
                ,
                = succeed ")" do
                  %a{:href => "https://videoonline.edu.lmu.de/en/node/7485"} video recording
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            for stabilization via “
            %a.existingWikiWord{:href => "/nlab/show/flux"}> flux
            ” (non-vanishing bosonic
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
          %ul
            %li#Acharya02
              %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
              ,
              %em A Moduli Fixing Mechanism in M theory
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0212294"}> arXiv:hep-th/0212294
              )
          %p
            and
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            for fluxless compactifications via
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nonperturbative+effects"} nonperturbative effects
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hierarchy+problem"} hierarchy problem
          %ul
            %li#AcharyaBobkovKaneKumarVaman06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                , Konstantin Bobkov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
                = succeed "," do
                  %em An M theory Solution to the Hierarchy Problem
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0606262"} arXiv:hep-th/0606262
            %li#AcharyaBobkovKaneKumarShao07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                , Konstantin Bobkov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
                = succeed "," do
                  %em Explaining the Electroweak Scale and Stabilizing Moduli in M Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0701034"} arXiv:hep-th/0701034
            %li#AcharyaKumarBobbkovKaneShaoWatson08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
                = succeed ",JHEP" do
                  %em Non-thermal Dark Matter and the Moduli Problem in String Frameworks
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0804.0863"} arXiv:0804.0863
          %p
            and specifically for the
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-MSSM"} G₂-MSSM
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
              , Konstantin Bobkov,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
              %em
                The
                = succeed "-MSSM" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                Theory motivated model of Particle Physics
              (
              %a{:href => "http://arxiv.org/abs/0801.0478"}> arXiv:0801.0478
              )
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/strong+CP+problem"} strong CP problem
            is discussed in
          %ul
            %li#SvrcekWitten06
              %p
                Peter Svrcek,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em Axions In String Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0605206"} arXiv:hep-th/0605206
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                , Konstantin Bobkov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Piyush+Kumar"} Piyush Kumar
                = succeed "," do
                  %em An M Theory Solution to the Strong CP Problem and Constraints on the Axiverse
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1004.5138"} arXiv:1004.5138
          %p
            and realization of
            %a.existingWikiWord{:href => "/nlab/show/GUTs"} GUTs
            in
          %ul
            %li#Witten02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em
                    Deconstruction,
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} G_2
                    Holonomy, and Doublet-Triplet Splitting
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-ph/0201018"} arXiv:hep-ph/0201018
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bobby+Acharya"}> Bobby Acharya
                , Krzysztof Bozek, Miguel Crispim Romao, Stephen F. King, Chakrit Pongkitivanichkul,
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 10
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(10)
                  Grand Unification in M theory on a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                  manifold
                (
                %a{:href => "http://arxiv.org/abs/1502.01727"}> arXiv:1502.01727
                )
          %p
            The phenomenology of compactifications on
            %a.existingWikiWord{:href => "/nlab/show/compact+twisted+connected+sum+G%E2%82%82-manifolds"} compact twisted connected sum G₂-manifolds
            (
            %a{:href => "G2+manifold#Kovalev00"}> Kovalev 00
            ) is in
          %ul
            %li#GHKY17
              Thaisa C. da C. Guio,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hans+Jockers"} Hans Jockers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Albrecht+Klemm"} Albrecht Klemm
              %em
                Effective action from M-theory on twisted connected sum
                = succeed "-manifolds" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
              (
              %a{:href => "https://arxiv.org/abs/1702.05435"}> arXiv:1702.05435
              ,
              = succeed ")" do
                %a{:href => "https://lecture2go.uni-hamburg.de/l2go/-/get/v/21906"} talk video
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            in these models includes
          %ul
            %li
              Beatriz de Carlos, Andre Lukas, Stephen Morris,
              = succeed "," do
                %em
                  Non-perturbative vacua for M-theory on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
                  manifolds
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0409255"} arxiv:hep-th/0409255
          %p
            which concludes that with taking
            %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effects"} non-perturbative effects
            from
            %a.existingWikiWord{:href => "/nlab/show/membrane+instantons"} membrane instantons
            into account one gets 4d vacua with vanishing and negative
            %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            (
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/anti-de+Sitter+spacetime"} anti-de Sitter spacetime
            %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            (
            %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"}> de Sitter spacetime
            ). They close by speculating that
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            instantons might yield
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
          %p
            Suggestion that
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+corrections"} higher curvature corrections
            allow
            %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
            vacua:
          %ul
            %li
              Johan Blåbäck,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"} Ulf Danielsson
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"} Giuseppe Dibitetto
              %em Constructing stable de Sitter in M-theory from higher curvature corrections
              (
              %a{:href => "https://arxiv.org/abs/1902.04053"}> arXiv:1902.04053
              )
          %p See also
          %ul
            %li#BCHS18
              %a.existingWikiWord{:href => "/nlab/show/Andreas+Braun"}> Andreas Braun
              , Sebastjan Cizel, Max Hubner, Sakura Schafer-Nameki,
              %em
                Higgs Bundles for M-theory on
                = succeed "-Manifolds" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
              (
              %a{:href => "https://arxiv.org/abs/1812.06072"}> arXiv:1812.06072
              )
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/Yukawa+couplings"} Yukawa couplings
            among 3
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/generations+of+fundamental+fermions"} generations of fundamental fermions
          %ul
            %li
              Eric Gonzalez,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Malcolm+Perry"} Malcolm Perry
              %em
                Quark and lepton mass matrices from localization in M-theory on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
                orbifold
              (
              %a{:href => "https://arxiv.org/abs/2002.11820"}> arXiv:2002.11820
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/neutrino"} neutrino
            masses:
          %ul
            %li
              Eric Gonzalez,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gordon+Kane"} Gordon Kane
              %em
                Neutrino mass matrices from localization in M-theory on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
                orbifold
              (
              %a{:href => "https://arxiv.org/abs/2107.12893"}> arXiv:2107.12893
              )
        .revisedby
