                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Huybrechts-StabilityStructures.pdf", :title => "pdf"} pdf
            %li
              %p
                Veronique Fischer, Michael Ruzhansky, Section 1.6 in:
                = succeed "," do
                  %em Quantization on Nilpotent Lie Groups
                = succeed "&rbrack;" do
