            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+L-infinity+algebra"} nilpotent L-infinity algebra
          %h2#references References
          %ul
            %li#Serre64
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
                \:
                = succeed "," do
                  %em Nilpotent and Solvable Lie Algebras
                = succeed "," do
                  %em Lie Algebras and Lie Groups – 1964 Lectures given at Harvard University
                = succeed "," do
                  %strong 1500
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-70634-2"} doi:10.1007/978-3-540-70634-2
            %li
              %p
                Arthur A. Sagle, Ralph E. Walde:
                = succeed "," do
                  %em Nilpotent Lie Groups and Algebras
                = succeed "," do
                  %em Introduction to Lie Groups and Lie Algebras
                = succeed "," do
                  %strong 51
                = succeed "]" do
                  %a{:href => "https://doi.org/10.1016/S0079-8169(08)61671-2"} doi:10.1016/S0079-8169(08)61671-2
            %li#Milne17
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Milne"}> James Milne
                , pp. 260 in:
                = succeed "," do
                  %em Algebraic Groups – The theory of group schemes of finite type over a field
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781316711736"} doi:10.1017/9781316711736
                = succeed "," do
                  %a{:href => "http://www.jmilne.org/math/Books/iag.html"} webpage
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jmilne.org/math/CourseNotes/iAG200.pdf"} pdf
            %li
              %p
                Laurence Corwin, Frederick P. Greenleaf: Section 1.2 of:
                = succeed "," do
                  %em Representations of Nilpotent Lie Groups and their Applications – Volume 1 Part 1. Basic Theory and Examples
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cambridge.org/us/universitypress/subjects/mathematics/abstract-analysis/representations-nilpotent-lie-groups-and-their-applications-volume-1-part-1"} ISBN:9780521604956
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Victor+Kac"} Victor Kac
                (notes by Marc Doss),
                %em Nilpotent and Solvable Lie algebras
                (2010) &amp;lbrack;
                %a{:href => "https://math.mit.edu/classes/18.745/Notes/Lecture_4_Notes.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/KacDoss-NilpotentLieAlebras.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Huybrechts"}> Daniel Huybrechts
                \:
                = succeed "," do
                  %em Nilpotent Lie Algebras
