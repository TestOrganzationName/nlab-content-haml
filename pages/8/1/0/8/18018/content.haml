          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#engels_theorem"} Engel’s theorem
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#relation_to_sullivan_models"} Relation to Sullivan models
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            is
            %strong nilpotent
            if there exists a uniform
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} acting
            via the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            on any one of its elements with other elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times yields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi n
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                %annotation{:encoding => "application/x-tex"} \exists n\in\mathbf{N}
            such that for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i = 1,\ldots, n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ad
                    %msub
                      %mi x
                      %mn 1
                    %mi ad
                    %msub
                      %mi x
                      %mn 2
                    %mi …
                    %mi ad
                    %msub
                      %mi x
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} ad x_1 ad x_2 \ldots ad x_n = 0
          %h2#definition Definition
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/lower+central+series"} lower central series
            or (descending
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/central+series"} central series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is a sequence of nested
            %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo ⊴
                  %msup
                    %mi 𝔤
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^{k+1} \trianglelefteq \mathfrak{g}^{k}
            defined inductively by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mn 1
                    %mo ≔
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^1 \coloneqq \mathfrak{g}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi 𝔤
                    %mo ,
                    %msup
                      %mi 𝔤
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}^{k+1} \coloneqq [\mathfrak{g}, \mathfrak{g}^k]
            %strong nilpotent
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^{k} = 0
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
          %p
            In other words, a Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is nilpotent if and only the improper ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is a
            %a.existingWikiWord{:href => "/nlab/show/nilpotent+element"} nilpotent element
            in the ideal lattice with respect to the ideal product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,-]
          %p
            A Lie algebra is
            %strong locally nilpotent
            if any finite-dimensional subalgebra is nilpotent.
          %p
            A Lie algebra is
            %strong ad-nilpotent
            if for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ad
                  %mi x
                %annotation{:encoding => "application/x-tex"} ad x
            is nilpotent. In general, this is a weaker property.
          %h2#engels_theorem Engel’s theorem
          %p
            Every finite-dimensional matrix Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ⊂
                  %mi gl
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L\subset gl(m)
            over a field is nilpotent iff it is ad-nilpotent.
          %h2#examples Examples
          %ul
            %li
              %p Trivially: Every abelian Lie algebra is nilpotent.
            %li
              %p
                The Lie algebra of even-degree elements of the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                of a
                %a.existingWikiWord{:href => "/nlab/show/super+translation+Lie+algebra"} super translation Lie algebra
                (
                %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 0
                          %mo{:stretchy => "false"} |
                          %mi q
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{0\vert q}
                is nilpotent.
          %h2#properties Properties
          %ul
            %li
              Every nilpotent Lie algebra is
              = succeed "." do
                %span.newWikiWord
                  solvable
                  %a{:href => "/nlab/new/solvable+Lie+algebra"} ?
          %h3#relation_to_sullivan_models Relation to Sullivan models
          %p
            A finite-dimensional Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is nilpotent precisely if its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            is a
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+algebra"} Sullivan algebra
            (necessarily minimal). See also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            for more on this.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+element"} nilpotent element
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+group"} nilpotent group
            %li
              %p
