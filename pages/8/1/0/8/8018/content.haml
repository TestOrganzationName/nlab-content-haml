          %h1#positive_cones Positive cones
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#the_extended_positive_cone"} The extended positive cone
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Geometrically, the positive elements of a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            with a
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
            form a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/operator+algebras"} operator algebras
          %h2#definition Definition
          %p
            Let
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
            and let
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            be an
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            of
            = succeed "." do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %strong positive cone
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo +
                %annotation{:encoding => "application/x-tex"} V^+
            of the pointed poset
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V,0)
            is the
            %a.existingWikiWord{:href => "/nlab/show/up+set"} up set
            of
            = succeed ":" do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .maruku-equation
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_7.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo +
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mo ≤
                  %mi x
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} V^+ \coloneqq \{x\colon V \;|\; 0 \leq x\} .
          %p
            If
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/operator+algebra"} operator algebra
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordered+group"} ordered group
            %a.existingWikiWord{:href => "/nlab/show/identity+element"} identity element
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            here.
          %h2#properties Properties
          %p
            Let
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be an
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/ordered+group"} ordered group
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a poset (as above) and also a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            (written additively but not necessarily
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} commutative
          %ul
            %li
              If
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \leq b
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi c
                    %mo ≤
                    %mi b
                    %mo +
                    %mi c
                  %annotation{:encoding => "application/x-tex"} a + c \leq b + c
              and
              = succeed "." do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo +
                      %mi a
                      %mo ≤
                      %mi c
                      %mo +
                      %mi b
                    %annotation{:encoding => "application/x-tex"} c + a \leq c + b
          %p
            Then the positive cone
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo +
                %annotation{:encoding => "application/x-tex"} V^+
            satisfies these properties:
          %ul
            %li
              If
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                    %mo ∈
                    %msup
                      %mi V
                      %mo +
                  %annotation{:encoding => "application/x-tex"} a, -a \in V^+
              (where
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi a
                  %annotation{:encoding => "application/x-tex"} -a
              is the
              %a.existingWikiWord{:href => "/nlab/show/inverse+element"} inverse
              of
              = succeed ")," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed ";" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} a = 0
            %li
              Conversely,
              = succeed ";" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} 0 \in V^+
            %li
              If
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} a, b \in V^+
              = succeed ";" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} a + b \in V^+
            %li
              If
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} a \in V^+
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo +
                    %mi a
                    %mo −
                    %mi b
                    %mo ∈
                    %msup
                      %mi V
                      %mo +
                  %annotation{:encoding => "application/x-tex"} b + a - b \in V^+
              (which is trivial if
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is commutative).
          %p
            Conversely, if
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo +
                %annotation{:encoding => "application/x-tex"} V^+
            is any subset of the group
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            with these properties, then
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            becomes an ordered group with either of these equivalent definitions:
          %ul
            %li
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
              iff
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo −
                      %mi a
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} b - a \in V^+
            %li
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
              iff
              = succeed "." do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                      %mo +
                      %mi b
                      %mo ∈
                      %msup
                        %mi V
                        %mo +
                    %annotation{:encoding => "application/x-tex"} -a + b \in V^+
          %p
            In this way, we have a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            between ordered group structures and positive cones in a group.
          %h2#the_extended_positive_cone The extended positive cone
          .un_remark
            %h6#motivation Motivation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/finite+measures"} finite measures
              on a given
              %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
              form an ordered vector space
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo +
                  %annotation{:encoding => "application/x-tex"} V^+
              consists precisely of the finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/positive+measures"} positive measures
              %em extended
              positive cone of
              = succeed "." do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p I only know the general definition in some rather limited cases:
          .num_defn
            %h6#definition_positive_cone_of_a_von_neumann_algebra Definition (positive cone of a von Neumann algebra)
            %p
              Let
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              = succeed "-" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mo *
                    %annotation{:encoding => "application/x-tex"} W^*
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/W-star-algebra"} algebra
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V_*
              be its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/predual"} predual
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the space of
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              from
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V_*
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/base+field"} base field
              %strong extended positive cone
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi V
                        %mo{:stretchy => "false"} ¯
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \bar{V}^+
              of
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the space of lower
              %a.existingWikiWord{:href => "/nlab/show/semicontinuous+map"} semicontinuous
              linear maps from the positive cone
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi V
                      %mo *
                      %mo +
                  %annotation{:encoding => "application/x-tex"} V_*^+
              of
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V_*
              to the space
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi ℝ
                        %mo{:stretchy => "false"} ¯
                      %mo +
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \bar{\mathbb{R}}^+ = [0,\infty]
              of
              %a.existingWikiWord{:href => "/nlab/show/extended+real+number"} extended
              positive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %p
            The extended positive real numbers are really showing up in their guise as the nonnegative
            %a.existingWikiWord{:href => "/nlab/show/lower+real+numbers"} lower real numbers
            (the appropriate targets for a lower semicontinuous map), and the extended positive cone is really a generalisation of the nonnegative upper reals. In particular, the extended positive cone of
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            itself is
            = succeed "." do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,\infty]
          %p This doesn't include the motivating example, but the following generalisation does:
          .num_defn
            %h6#definition_positive_cone_of_an_ordered_module_over_a_von_neumann_algebra Definition (positive cone of an ordered module over a von Neumann algebra)
            %p
              Let
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the
              = succeed "-algebra" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi W
                        %mo *
                    %annotation{:encoding => "application/x-tex"} W^*
              = succeed "," do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              have the structure of an ordered group such that the action of
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              preserves order (in that a positive element acting on a positive element gives a positive element). Then the
              %strong extended positive cone
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi V
                        %mo{:stretchy => "false"} ¯
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \bar{V}^+
              of
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              consists of formal infinitary
              = succeed "-" do
                %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi A
                          %mo{:stretchy => "false"} ¯
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \bar{A}^+
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/linear+combination"} linear combination
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              modulo the (hopefully) obvious
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p
            When applied to the space of finite measures on a
            %a.existingWikiWord{:href => "/nlab/show/localisable+measurable+space"} localisable measurable space
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (acted on by the
            = succeed "-algebra" do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
            = succeed ")," do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^\infty(X)
            %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (but I need to check the details).
          %h2#references References
          %p
            The extended positive cone of a
            = succeed "-algebra" do
              %math#mathml_a9b4ae7a30a6246f51bfc2e3569f87725b65252c_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^*
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Masamichi+Takesaki"}> Masamichi Takesaki
              , Theory of Operator Algebras II, Springer;
              = succeed "." do
                %a{:href => "http://books.google.com/books?id=-4GyR1VlQz4C&pg=PA215&dq=\"extended+positive+part\""} Google books
        .revisedby
