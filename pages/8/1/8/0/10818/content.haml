                              %mi MA
                          %annotation{:encoding => "application/x-tex"} e_A = 1_A : \mu_A . \eta_{MA} \to 1_{MA}
                      ,
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi h
                              %mi A
                            %mo :
                            %msub
                              %mn 1
                              %mrow
                                %msup
                                  %mi M
                                  %mn 2
                                %mi A
                            %mo →
                            %msub
                              %mi η
                              %mi MA
                            %mo .
                            %msub
                              %mi μ
                              %mi A
                          %annotation{:encoding => "application/x-tex"} h_A : 1_{M^2 A} \to \eta_{MA} . \mu_A
                      \.
                %p Define
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi h
                          %mo ′
                          %mo =
                          %mi M
                          %mi α
                          %mo .
                          %msub
                            %mi h
                            %mi A
                          %mo .
                          %mi M
                          %msub
                            %mi η
                            %mi A
                          %mo :
                          %msub
                            %mn 1
                            %mi MA
                          %mo =
                          %mi M
                          %mi α
                          %mo .
                          %mi M
                          %msub
                            %mi η
                            %mi A
                          %mo →
                          %mi M
                          %mi α
                          %mo .
                          %msub
                            %mi η
                            %mi MA
                          %mo .
                          %msub
                            %mi μ
                            %mi A
                          %mo .
                          %mi M
                          %msub
                            %mi η
                            %mi A
                          %mo =
                          %mi M
                          %mi α
                          %mo .
                          %msub
                            %mi η
                            %mi MA
                          %mo =
                          %msub
                            %mi η
                            %mi A
                          %mo .
                          %mi α
                        %annotation{:encoding => "application/x-tex"} h' = M \alpha . h_A . M\eta_A : 1_{MA} = M \alpha . M\eta_A \to M \alpha . \eta_{MA} . \mu_A . M\eta_A = M \alpha . \eta_{MA} = \eta_A . \alpha
                    \.
                %p This satisfies the adjunction laws:
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi α
                            %mo .
                            %mi h
                            %mo ′
                            %mo =
                            %mi α
                            %mo .
                            %mi M
                            %mi α
                            %mo .
                            %msub
                              %mi h
                              %mi A
                            %mo .
                            %mi M
                            %msub
                              %mi η
                              %mi A
                            %mo =
                            %mi α
                            %mo .
                            %msub
                              %mi μ
                              %mi A
                            %mo .
                            %msub
                              %mi h
                              %mi A
                            %mo .
                            %mi M
                            %msub
                              %mi η
                              %mi A
                            %mo =
                            %mi α
                            %mo .
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi A
                            %mo .
                            %msub
                              %mi μ
                              %mi A
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo .
                            %mi M
                            %msub
                              %mi η
                              %mi A
                            %mo =
                            %mi α
                            %mo .
                            %mn 1
                            %mo .
                            %mi M
                            %msub
                              %mi η
                              %mi A
                            %mo =
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} \alpha . h' = \alpha . M \alpha . h_A . M\eta_A = \alpha . \mu_A . h_A . M\eta_A = \alpha . (e_A . \mu_A)^{-1} . M\eta_A = \alpha . 1 . M\eta_A = 1
                      \.
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi h
                            %mo ′
                            %mo .
                            %msub
                              %mi η
                              %mi A
                            %mo =
                            %mi M
                            %mi α
                            %mo .
                            %msub
                              %mi h
                              %mi A
                            %mo .
                            %mi M
                            %msub
                              %mi η
                              %mi A
                            %mo .
                            %msub
                              %mi η
                              %mi A
                            %mo =
