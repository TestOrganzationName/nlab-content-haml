            = succeed "-simplices." do
              %math#mathml_f0fb655cf193ca709f3ce8e7497e67ab44ac03f4_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math#mathml_f0fb655cf193ca709f3ce8e7497e67ab44ac03f4_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi V
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
