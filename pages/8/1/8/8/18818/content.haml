                    %mrow
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              is the group of even graded elements of the Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{d-1,1})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary
              with respect to the conjugation operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{(-)}
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#CliffordAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mi A
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi even
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mi A
                        %mo ¯
                      %mi A
                      %mo =
                      %mn 1
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spin(d-1,1)
                    \\;\coloneqq\;
                    \\left\{
                    A \in Cl(\mathbb{R}^{d-1,1})_{even}
                    \\;\vert\;
                    \\overline{A} A = 1
                    \\right\}
                    \\,.
          #SpinDoubleCover.num_prop
            %h6#proposition_9 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spin(d-1,1)
                    \\longrightarrow
                    GL(\mathbb{R}^{d-1,1})
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SpinGroup"}
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              in
              = succeed "-dimensions" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Spin(d-1,1) \hookrightarrow Cl(\mathbb{R}^{d-1,1})
              to the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{A}(-) A
            %p
              (via the identification of Minkowski spacetime as the subspace of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              containing the
              %a.existingWikiWord{:href => "/nlab/show/linear+combinations"} linear combinations
              of the generators, according to remark
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
            %p is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  onto the
                  %a.existingWikiWord{:href => "/nlab/show/proper+orthochronous+Lorentz+group"} proper orthochronous Lorentz group
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#LorentzGroup"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi SO
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Spin(d-1,1) \longrightarrow SO^+(d-1,1)
              %li
                %p
                  exhibiting a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
          .proof
            %h6#proof_6 Proof
            %p
              That the function is a group homomorphism into the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %a.existingWikiWord{:href => "/nlab/show/linear+transformations"} linear transformations
              on the generators follows by using that it clearly lands in
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
              of the Clifford algebra.
            %p
              That the function lands in the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d-1,1) \hookrightarrow GL(d)
              follows from remark
              = succeed ":" do
                %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi A
                              %mo ¯
                            %msub
                              %mi v
                              %mn 1
                            %mi A
                            %mo ,
                            %mover
                              %mi A
                              %mo ¯
                            %msub
                              %mi v
                              %mn 2
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %mrow
                                %mo (
                                %mover
                                  %mi A
                                  %mo ¯
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %mi A
                                %mo )
                              %mrow
                                %mo (
                                %mover
                                  %mi A
                                  %mo ¯
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                                %mi A
                                %mo )
                              %mo +
                              %mrow
                                %mo (
                                %mover
                                  %mi A
                                  %mo ¯
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 2
                                %mi A
                                %mo )
                              %mrow
                                %mo (
                                %mover
                                  %mi A
                                  %mo ¯
                                %msub
                                  %mover
                                    %mi v
                                    %mo{:stretchy => "false"} ^
                                  %mn 1
                                %mi A
                                %mo )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %mover
                                %mi A
                                %mo ¯
                              %mo{:stretchy => "false"} (
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %mo +
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mi A
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi A
                              %mo ¯
                            %mi A
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %mo +
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                              %msub
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi η
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ,
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta(\overline{A}v_1A , \overline{A} v_2 A)
                    \&amp;=
                    \\tfrac{1}{2}
                    \\left(
                    \\left(\overline{A} \hat v_1 A\right) \left(\overline{A}\hat v_2 A\right)
                    +
                    \\left(\overline{A} \hat v_2 A\right) \left(\overline{A} \hat v_1 A\right)
                    \\right)
                    \\\
                    \&amp; =
                    \\tfrac{1}{2}
                    \\left(
                    \\overline{A}(\hat v_1 \hat v_2 + \hat v_2 \hat v_1) A
                    \\right)
                    \\\
                    \&amp; =
                    \\overline{A} A \tfrac{1}{2}\left( \hat v_1 \hat v_2 + \hat v_2 \hat v_1\right)
                    \\\
                    \&amp; =
                    \\eta(v_1, v_2)
                    \\end{aligned}
                    \\,.
            %p
              That it moreover lands in the
              %a.existingWikiWord{:href => "/nlab/show/proper+Lorentz+group"} proper Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(d-1,1)
              follows from observing (example
              = succeed ")" do
                %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              by a linear combination of generators, which are excluded from the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              (as that is defined to be in the even subalgebra).
            %p
              To see that the homomorphism is surjective, use that all elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(d-1,1)
              are products of
              %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
              in hyperplanes. If a hyperplane is spanned by the
              %a.existingWikiWord{:href => "/nlab/show/bivector"} bivector
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ω
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\omega^{a b})
              %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              by the conjugation action by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 2
                    %msup
                      %mi ω
                      %mrow
                        %mi a
                        %mi b
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\tfrac{\alpha}{2} \omega^{a b}\Gamma_{a b})
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p
              That the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              is clear from the fact that the only even Clifford elements which commute with all vectors are the multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi ℝ
                    %mo ↪
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in \mathbb{R} \hookrightarrow Cl(\mathbb{R}^{d-1,1})
              of the identity. For these
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo ¯
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \overline{a} = a
              and hence the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo ¯
                    %mi a
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \overline{a} a = 1
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi a
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} a^2 = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{+1,-1\}
              are in the
              %a.existingWikiWord{:href => "/nlab/show/center"} center
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spin
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              = succeed "." do
                %a.maruku-ref{:href => "#AmbiguityInCliffordConjugation"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#InTermsOfNormedDivisionAlgebraInDimension3To10
            %strong Spinors in dimensions 3, 4, 6 and 10
          %p
            We now discuss how
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpinGroup"}
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            over the four real
            %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative
            %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            (prop.
            = succeed ")." do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
          #CliffordAlgebraInTermsOfNormedDivisionAlgebra.num_defn
            %h6#definition_12 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebra"} normed division algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⟶
                    %msub
                      %mi End
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝕂
                      %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\colon\; \mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1} \longrightarrow End_{\mathbb{R}}(\mathbb{K}^4)
            %p
              from (the real vector space underlying)
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              to real
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}^4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ψ
                          %mtr
                            %mtd
                              %mi ϕ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi A
                              %mi ψ
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(A)
                    \\left(
                    \\array{
                    \\psi
                    \\\
                    \\phi
                    }
                    \\right)
                    \\;\coloneqq\;
                    \\left(
                    \\array{
                    \- \tilde A \phi
                    \\\
                    A \psi
                    }
                    \\right)
                    \\,.
            %p
              Here on the right we are using the isomorphism from prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              for identifying a spacetime vector with a
              = succeed "-matrix," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ×
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 \times 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo{:stretchy => "false"} (
                      %mo ˜
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widetilde(-)
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TraceReversal"}
          .num_remark
            %h6#remark_6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford multiplication
                via
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/octonion"} octonion
            %p
              Each operation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(A)
              in def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              is clearly a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              being the non-associative
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              the octonions, then the composition of two such linear maps is not in general given by the usual matrix product.
          #SpinorRepsByNormedDivisionAlgebra.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              in def.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              gives a
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}  )
              (
              %a{:href => "geometry+of+physics+--+supersymmetry#CliffordAlgebra"}> this def.
              ), i.e of
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{2,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 3
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{3,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 5
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{5,1})
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 9
                            %mo ,
                            %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(\mathbb{R}^{9,1})
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi 𝕆
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
            %p
              Hence this Clifford representation induces
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(dim_{\mathbb{R}}(\mathbb{K})+1,1)
              on the real vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo ±
                    %mo ≔
                    %msup
                      %mi 𝕂
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{\pm } \coloneqq \mathbb{K}^2
                    \\,.
            %p and hence on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≔
                    %msub
                      %mi S
                      %mo +
                    %mo ⊕
                    %msub
                      %mi S
                      %mo −
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \coloneqq S_+ \oplus S_-
                    \\,.
          %p
            (
            %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, p. 6
            )
          .proof
            %h6#proof_7 Proof
            %p We need to check that the Clifford relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\Gamma(A))^2
                    \&amp; = -\eta(A,A)1
                    \\\
                    \&amp; = + det(A)
                    \\end{aligned}
            %p
              is satisfied (where we used
              %a.maruku-eqref{:href => "#eq:RelationCliffordAlgebra"} (4)
              and
              = succeed ")." do
                %a.maruku-eqref{:href => "#eq:MinkowskiSpacetimeFromHermitianMatricesWithDeterminant"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi 𝕂
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} (\phi,\psi) \in \mathbb{K}^4
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                          %mtr
                            %mtd
                              %mi ψ
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mi ϕ
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi A
                                %mo{:stretchy => "false"} ˜
                              %mi ψ
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma(A))^2
                    \\left(
                    \\array{
                    \\phi
                    \\\
                    \\psi
                    }
                    \\right)
                    \\;=\;
                    \-
                    \\left(
                    \\array{
                    \\tilde A(A \phi)
                    \\\
                    A(\tilde A \psi)
                    }
                    \\right)
                    \\,,
            %p where on the right we have in each component ordinary matrix product expressions.
            %p Now observe that both expressions on the right are sums of triple products that involve either one real factor or two factors that are conjugate to each other:
