                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi Γ
                          %mi a
                      %mo ¯
                    %mo ≔
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\Gamma_a}
