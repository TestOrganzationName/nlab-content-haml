            %p
              for the algebra
              %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} anti-
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
