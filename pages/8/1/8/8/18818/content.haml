          #CliffordConjugtionReflectionAndRotation.num_example
            %h6#example Example
            %p
              %strong (Clifford conjugation)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
              the
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} v \in \mathbb{R}^{d-1,1}
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector"} vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat v \in Cl(\mathbb{R}^{d-1,1})
              via remark
              = succeed "." do
                %a.maruku-ref{:href => "#VectorsInsideCliffordAlgebra"}
            %p Then
            %ol
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mo ↦
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msubsup
                        %mi Γ
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \hat v \mapsto -\Gamma_a^{-1} \hat v \Gamma_a
                of a single Clifford generator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Γ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \Gamma_a
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat v
                sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                to its
            %p
              %a.existingWikiWord{:href => "/nlab/show/reflection"} reflection
              at the hyperplane
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x_a = 0
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} ^
                        %mo ↦
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mstyle{:displaystyle => "false"}
