                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
