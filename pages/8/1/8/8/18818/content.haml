                  forming the
                  %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+double+algebra"} Cayley-Dickson double algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
