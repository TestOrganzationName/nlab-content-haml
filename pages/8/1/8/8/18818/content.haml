                              %mo{:stretchy => "false"} (
                              %mi 𝕂
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi det
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbb{R}^{dim_{\mathbb{R}}(\mathbb{K})+1,1}
                    \&amp;
                    \\coloneqq
                    \\left(
                    \\mathbb{R}^{dim_{\mathbb{R}(\mathbb{K})}+2}
                    ,
                    {\vert -\vert^2_\eta}
                    \\right)
                    \&amp; \coloneqq
                    \\left(Mat_{2 \times 2}^{her}(\mathbb{K}), -det \right)
                    \\end{aligned}
                    \\,.
            %p hence
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{R}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 3
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{3,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{C}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 5
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{5,1}
                  for
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{H}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mrow
                            %mn 9
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕂
                          %mo =
                          %mi 𝕆
                        %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
            %p
              Here we think of the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              on the left as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≔
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    p \coloneqq dim_{\mathbb{R}}(\mathbb{K})+1
            %p
              equipped with the canonical coordinates labeled
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi μ
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi μ
                          %mo =
                          %mn 0
                        %mi p
                    %annotation{:encoding => "application/x-tex"} (x^\mu)_{\mu = 0}^p
            %p
              As a
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              the identification is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo ,
                    %msup
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msup
                      %mi x
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi x
                                %mn 0
                              %mo +
                              %msup
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %msup
                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ≔
                    %msup
                      %mi x
                      %mn 2
                    %mn 1
                    %mo +
                    %msup
                      %mi x
                      %mn 3
                    %msub
                      %mi e
                      %mn 1
                    %mo +
                    %msup
                      %mi x
                      %mn 4
                    %msub
                      %mi e
                      %mn 2
                    %mo +
                    %mi ⋯
                    %mo +
                    %msup
                      %mi x
                      %mrow
                        %mn 2
                        %mo +
                        %msub
                          %mi dim
                          %mrow
                            %mi ℝ
                            %mo{:stretchy => "false"} (
                            %mi 𝕂
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi e
                      %mrow
                        %msub
                          %mi dim
                          %mi ℝ
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x^0, x^1, \cdots, x^{d-1})
                    \\;\mapsto\;
                    \\left(
                    \\array{
                    x^0 + x^1 &amp; y
                    \\\
                    y^\ast &amp; x^0 - x^1
                    }
                    \\right)
                    \\;\;\;
                    \\text{with}\;
                    y \coloneqq x^2 1 + x^3 e_1 + x^4 e_2 +   \cdots + x^{2 + dim_{\mathbb{R}(\mathbb{K})}} \,e_{dim_{\mathbb{R}}(\mathbb{K})-1}
                    \\,.
            %p
              This means that the
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %msubsup
                        %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} {\vert - \vert^2_\eta}
              is given on an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi v
                      %mi μ
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi μ
                        %mo =
                        %mn 0
                      %mi p
                  %annotation{:encoding => "application/x-tex"} v = (v^\mu)_{\mu = 0}^p
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mi η
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi v
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi j
                        %mo =
                        %mn 1
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi j
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert v \vert}^2_{\eta}
                    \\;=\;
                    \- (v^0)^2 + \underoverset{j = 1}{p}{\sum} (x^j)^2
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/polarization+identity"} polarization identity
              the
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %msubsup
                        %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} {\vert - \vert^2_\eta}
              induces a
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo ⊗
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \mathbb{R}^{p,1}\otimes \mathbb{R}^{p,1} \longrightarrow \mathbb{R}
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ,
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %msubsup
                              %mi v
                              %mn 1
                              %mi μ
                            %msubsup
                              %mi v
                              %mn 1
                              %mi ν
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mi v
                              %mn 1
                              %mn 0
                            %msubsup
                              %mi v
                              %mn 2
                              %mn 0
                            %mo +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi j
                                %mo =
                                %mn 1
                              %mi p
                            %msubsup
                              %mi v
                              %mn 1
                              %mi j
                            %msubsup
                              %mi v
                              %mn 2
                              %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta(v_1, v_2)
                    \&amp; =
                    \\eta_{\mu \nu} v_1^\mu v_1^\nu
                    \\\
                    \&amp; \coloneqq
                    \- v_1^0 v_2^0 + \underoverset{j  = 1}{p}{\sum} v_1^j v_2^j
                    \\end{aligned}
                    \\,.
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
            %p
              Finally, under the above identification the operation of trace reversal from def.
              %a.maruku-ref{:href => "#TraceReversal"}
              corresponds to
              %em time reversal
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msup
                                  %mi x
                                  %mn 0
                                %mo +
                                %msup
                                  %mi x
                                  %mn 1
                              %mtd
                                %mi y
                            %mtr
                              %mtd
                                %msup
                                  %mi y
                                  %mo *
                              %mtd
                                %msup
                                  %mi x
                                  %mn 0
                                %mo −
                                %msup
                                  %mi x
                                  %mn 1
                        %mo )
                      %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi x
                                %mn 0
                              %mo +
                              %msup
                                %mi x
                                %mn 1
                            %mtd
                              %mi y
                          %mtr
                            %mtd
                              %msup
                                %mi y
                                %mo *
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi x
                                %mn 0
                              %mo −
                              %msup
                                %mi x
                                %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widetilde{
                    \\left(
                    \\array{
                    x^0 + x^1 &amp; y
                    \\\
                    y^\ast &amp; x^0 - x^1
                    }
                    \\right)
                    }
                    \\;=\;
                    \\left(
                    \\array{
                    \-x^0 + x^1 &amp; y
                    \\\
                    y^\ast &amp; -x^0 - x^1
                    }
                    \\right)
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              We need to check that under the given identification, the Minkowski norm-square is indeed given by minus the determinant on the corresponding hermitian matrices. This follows from the nature of the conjugation operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mi det
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi x
                                        %mn 0
                                      %mo +
                                      %msup
                                        %mi x
                                        %mn 1
                                    %mtd
                                      %mi y
                                  %mtr
                                    %mtd
                                      %msup
                                        %mi y
                                        %mo *
                                    %mtd
                                      %msup
                                        %mi x
                                        %mn 0
                                      %mo −
                                      %msup
                                        %mi x
                                        %mn 1
                              %mo )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mn 0
                            %mo +
                            %msup
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mn 0
                            %mo −
                            %msup
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi y
                            %msup
                              %mi y
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mn 0
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                            %mo +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 1
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mi i
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-
                    det
                    \\left(
                    \\array{
                    x^0 + x^1 &amp; y
                    \\\
                    y^\ast &amp; x^0 - x^1
                    }
                    \\right)
                    \&amp; =
                    \-(x^0 + x^1)(x^0 - x^1)
                    +
                    y y^\ast
                    \\\
                    \&amp; =
                    \-(x^0)^2 + \underoverset{i = 1}{p}{\sum} (x^i)^2
                    \\end{aligned}
                    \\,.
          #MinkowskiMetricAndPhysicalUnitOfLength.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/length"} length
            %p
              As the term “
              %a.existingWikiWord{:href => "/nlab/show/metric"}> metric
              ” suggests, in application to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              in prop./def.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              is regarded as a
              = succeed ":" do
                %em
                  measure of
                  %a.existingWikiWord{:href => "/nlab/show/length"} length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma_x(T \mathbb{R}^{p,1})
              a
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
              at a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in Minkowski spacetime, interpreted as a displacement from
              %a.existingWikiWord{:href => "/nlab/show/event"} event
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to event
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo +
                      %mi v
                    %annotation{:encoding => "application/x-tex"} x + v
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \eta(v,v) \gt 0
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msqrt
                          %mrow
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"}
                        \\sqrt{\eta(v,v)} \in \mathbb{R}
                %p
                  is interpreted as a measure for the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spacelike"} spatial
                    %a.existingWikiWord{:href => "/nlab/show/distance"} distance
                  between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo +
                          %mi v
                        %annotation{:encoding => "application/x-tex"} x + v
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \eta(v,v) \lt 0
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msqrt
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"}
                        \\sqrt{-\eta(v,v)} \in \mathbb{R}
                %p
                  is interpreted as a measure for the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/timelike"} time
                    %a.existingWikiWord{:href => "/nlab/show/distance"} distance
                  between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo +
                          %mi v
                        %annotation{:encoding => "application/x-tex"} x + v
            %p
              But for this to make physical sense, an operational prescription needs to be specified that tells the experimentor how the
              %em
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)}
              is to be translated into an physical distance between actual
              %a.existingWikiWord{:href => "/nlab/show/events"} events
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/observable+universe"} observable universe
            %p
              Such an operational prescription is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
                  of
                  %a.existingWikiWord{:href => "/nlab/show/length"} length
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/centimeter"} centimeter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cm
                  %annotation{:encoding => "application/x-tex"} cm
              is a physical unit of length, another one is “
              %a.existingWikiWord{:href => "/nlab/show/femtometer"}> femtometer
              ”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fm
                    %annotation{:encoding => "application/x-tex"} fm
            %p
              The combined information of a
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)} \in \mathbb{R}
              and a
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              of
              %a.existingWikiWord{:href => "/nlab/show/length"} length
              such as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/meter"} meter
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi cm
                  %annotation{:encoding => "application/x-tex"}
                    \\sqrt{\eta(v,v)} \, cm
            %p
              is a prescription for finding actual distance in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/observable+universe"} observable universe
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi fm
                  %annotation{:encoding => "application/x-tex"}
                    \\sqrt{\eta(v,v)} \, fm
            %p
              is another prescription, that translates the same
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sqrt{\eta(v,v)}
              into another physical distance.
            %p
              But of course they are related, since
              %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
              form a
              %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
              over the
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\gt 0}
              of
              %a.existingWikiWord{:href => "/nlab/show/non-negative+number"} non-negative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fm
                    %mo =
                    %msup
                      %mn 10
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 13
                    %mi cm
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    fm = 10^{-13} cm
                    \\,,
            %p
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 10
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 13
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mrow
                          %mo &gt;
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} 10^{-13} \in \mathbb{R}_{\gt 0}
            %p This means that once any one prescription of turning real numbers into spacetime distances is specified, then any other such prescription is obtained from this by rescaling these real numbers. For example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msqrt
                              %mrow
                                %mi η
                                %mo{:stretchy => "false"} (
                                %mi v
                                %mo ,
                                %mi v
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi fm
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %msup
                                %mn 10
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 13
                              %msqrt
                                %mrow
                                  %mi η
                                  %mo{:stretchy => "false"} (
                                  %mi v
                                  %mo ,
                                  %mi v
                                  %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mi cm
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msqrt
                              %mrow
                                %msup
                                  %mn 10
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 26
                                %mi η
                                %mo{:stretchy => "false"} (
                                %mi v
                                %mo ,
                                %mi v
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mi cm
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\sqrt{\eta(v,v)} \, fm
                    \&amp; = \left( 10^{-13} \sqrt{\eta(v,v)}\right) \,cm
                    \\\
                    \&amp; =
                    \\sqrt{ 10^{-26} \eta(v,v) } \, cm
                    \\end{aligned}
                    \\,.
            %p
              The point to notice here is that, via the last line, we may think of this as
              %em
                rescaling the
                %a.existingWikiWord{:href => "/nlab/show/metric"} metric
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mn 10
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 30
                      %mi η
                    %annotation{:encoding => "application/x-tex"} 10^{-30} \eta
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              %a.existingWikiWord{:href => "/nlab/show/physical+units"} physical units
              of
              %a.existingWikiWord{:href => "/nlab/show/length"} length
              are typically expressed in terms of a
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              of “
              %a.existingWikiWord{:href => "/nlab/show/action"}> action
              ”, called “
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
              ”
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %em
                %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
            #eq:ComptonWavelength.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi m
                    %mo =
                    %mfrac
                      %mrow
                        %mn 2
                        %mi π
                        %mi ℏ
                      %mrow
                        %mi m
                        %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell_m = \frac{2\pi \hbar}{m c}
                    \\,.
            %p
              parameterized, in turn, by a
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              of
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/electron"} electron
              %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi e
                    %mo =
                    %mfrac
                      %mrow
                        %mn 2
                        %mi π
                        %mi ℏ
                      %mrow
                        %msub
                          %mi m
                          %mi e
                        %mi c
                    %mo ∼
                    %mn 386
                    %mspace{:width => "thinmathspace"}
                    %mi fm
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell_e =  \frac{2\pi \hbar}{m_e c} \sim 386 \, fm
                    \\,.
            %p
              Another
              %a.existingWikiWord{:href => "/nlab/show/physical+unit"} physical unit
              of
              %a.existingWikiWord{:href => "/nlab/show/length"} length
              parameterized by a
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schwarzschild+radius"} Schwarzschild radius
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi m
                      %mo ≔
                      %mn 2
                      %mi m
                      %mi G
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi c
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} r_m \coloneqq 2 m G/c^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/gravitational+constant"} gravitational constant
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi ℓ
                              %mi m
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi r
                              %mi m
                        %mtr
                          %mtd
                            %mo ⇔
                          %mtd
                            %mn 2
                            %mi π
                            %mi ℏ
                            %mo{:stretchy => "false"} /
                            %mi m
                            %mi c
                          %mtd
                            %mo =
                          %mtd
                            %mn 2
                            %mi m
                            %mi G
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi c
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; \ell_m &amp;=&amp; r_m
                    \\\
                    \\Leftrightarrow &amp; 2\pi\hbar / m c &amp;=&amp; 2 m G / c^2
                    }
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              yields the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Planck+mass"} Planck mass
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi P
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %msqrt
                          %mi π
                    %msub
                      %mi m
                      %mrow
                        %mi ℓ
                        %mo =
                        %mi r
                    %mo =
                    %msqrt
                      %mfrac
                        %mrow
                          %mi ℏ
                          %mi c
                        %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    m_{P} \coloneqq \tfrac{1}{\sqrt{\pi}} m_{\ell = r} = \sqrt{\frac{\hbar c}{G}}
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Compton+wavelength"} Compton wavelength
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mrow
                        %msub
                          %mi m
                          %mi P
                  %annotation{:encoding => "application/x-tex"} \ell_{m_{P}}
              is given by the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Planck+length"} Planck length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \ell_P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi P
                    %mo ≔
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mi π
                    %msub
                      %mi ℓ
                      %mrow
                        %msub
                          %mi m
                          %mi P
                    %mo =
                    %msqrt
                      %mfrac
                        %mrow
                          %mi ℏ
                          %mi G
                        %mrow
                          %msup
                            %mi c
                            %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ell_{P} \coloneqq \tfrac{1}{2\pi} \ell_{m_P} = \sqrt{ \frac{\hbar G}{c^3} }
                    \\,.
          #MinkowskiSpacetime.num_defn
            %h6#definition_8 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as a
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %p
              Prop./def.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              introduces
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 6
                    %mo ,
                    %mn 10
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} p+1 \in \{3,4,6,10\}
              as a a
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi η
                    %annotation{:encoding => "application/x-tex"} {\vert - \vert_\eta}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              corresponding to this is this vector space regaded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              (instead of just
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              = succeed ")." do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              over each point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^{p,1}
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TangentVectorFields"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    T_x \mathbb{R}^{p,1} \simeq \mathbb{R}^{p,1}
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              equipped with the Lorentzian inner product from prop./def.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              on each
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi x
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} T_x \mathbb{R}^{p,1}
              (a “
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian
              = succeed "\u201D)" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %em
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              as such.
            %p We write
            #eq:MinkowskiVolume.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %msup
                      %mi x
                      %mn 0
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mi p
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    dvol_\Sigma
                    \\;\coloneqq\;
                    d x^0 \wedge d x^1 \wedge \cdots \wedge d x^p
                    \\in \Omega^{p+1}(\mathbb{R}^{p,1})
            %p
              for the canonical
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              on Minkowski spacetime.
            %p
              We use the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              %a.existingWikiWord{:href => "/nlab/show/sum"} summation
              over the range of indices.
            %p
              For example a
              %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in \Omega^1(\mathbb{R}^{p,1})
              on Minkowski spacetime may be expanded as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %msub
                      %mi α
                      %mi μ
                    %mi d
                    %msup
                      %mi x
                      %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha = \alpha_\mu d x^\mu
                    \\,.
            %p
              Moreover we use square brackets around indices to indicate skew-symmetrization. For example a
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta \in \Omega^2(\mathbb{R}^{p,1})
              on Minkowski spacetime may be expanded as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi β
                          %mtd
                            %mo =
                            %msub
                              %mi β
                              %mrow
                                %mi μ
                                %mi ν
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mi ν
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi β
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi μ
                                %mi ν
                                %mo{:stretchy => "false"} ]
                            %mi d
                            %msup
                              %mi x
                              %mi μ
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\beta
                    \&amp; = \beta_{\mu \nu} d x^\mu \wedge d x^\nu
                    \\\
                    \&amp; = \beta_{[\mu \nu]} d x^\mu \wedge d x^\nu
                    \\end{aligned}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The identification of
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
            (prop./def.
            = succeed ")" do
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
          #DeterminantViaProductWithTraceReversal.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski metric
                in terms of
                %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                reversal)
            %p
              In terms of the trace reversal operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ˜
                  %annotation{:encoding => "application/x-tex"} \widetilde{(-)}
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#TraceReversal"}
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              operation on
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MatrixNotation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi A
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-det(A) &amp; = A \tilde A
                    \\\
                    \&amp; = \tilde A A
                    \\end{aligned}
                    \\,.
            %p
              and the Minkowski inner product from prop.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              has the alternative expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi η
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi tr
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mover
                              %mi B
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi tr
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                            %mi B
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\eta(A,B) &amp; = \tfrac{1}{2}Re(tr(A \tilde B))
                    \\\
                    \&amp; = \tfrac{1}{2} Re(tr(\tilde A B))
                    \\end{aligned}
                    \\,.
          %p
            (
            %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, prop. 5
            )
          #SLGrupOnPaulimatrices.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
                acts by linear
                %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
                on
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi ℍ
                    %mo ,
                    %mi 𝕆
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}, \mathbb{O}\}
              one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SL(2,\mathbb{K})
              %a.existingWikiWord{:href => "/nlab/show/action"} acts
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
