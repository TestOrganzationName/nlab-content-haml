          #HurwitzTheorem.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"}> Hurwitz theorem
                \:
                = succeed "," do
