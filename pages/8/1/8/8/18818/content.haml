          %p
            What actually matters for the following relation of the real normed division algebras to
            %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
            is that they are also
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
          #AlternativeAlgebra.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"}> alternative algebras
                )
            %p
              Given any
              %a.existingWikiWord{:href => "/nlab/show/non-associative+algebra"} non-associative algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo ⟶
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    [-,-,-] \;-\; A \otimes A \otimes A \longrightarrow A
            %p
              given on any elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b,c \in A
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi c
                    %mo −
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [a,b,c] \coloneqq (a b) c - a (b c)
            %p
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              (in analogy with the
              %em
                %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mi a
                    %mi b
                    %mo −
                    %mi b
                    %mi a
                  %annotation{:encoding => "application/x-tex"} [a,b] \coloneqq a b - b a
              ).
            %p
              If the associator is completely antisymmetric (in that for any
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              of three elements then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 2
                    %mo ,
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi σ
                          %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi σ
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi a
                      %mn 2
                    %mo ,
                    %msub
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a_{\sigma_1}, a_{\sigma_2}, a_{\sigma_3}] = (-1)^{\vert \sigma\vert} [a_1, a_2, a_3]
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi σ
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \vert \sigma \vert
              the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature of the permutation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is called an
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              of the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              is different from 2, then alternativity is readily seen to be equivalent to the conditions that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b \in A
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo =
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo =
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (a a)b = a (a b)
                    \\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;
                    (a b) b = a (b b)
                    \\,.
          %p We record some basic properties of associators in alternative star-algebras that we need below:
          #PropertiesOfAssociatorInAlternativeAlgebra.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (properties of
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              = succeed "):" do
                %a.maruku-ref{:href => "#Conjugation"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  vanishes when at least one argument is
                  %a.existingWikiWord{:href => "/nlab/show/real+part"} real
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [Re(a),b,c]
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  changes sign when one of its arguments is conjugated
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi a
                          %mo *
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        [a,b,c] = -[a^\ast,b,c]
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  vanishes when one of its arguments is the conjugate of another
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %msup
                          %mi a
                          %mo *
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        [a,a^\ast, b] = 0
                        \\,;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  is purely
                  %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Re([a,b,c]) = 0
                        \\,.
          .proof
            %h6#proof Proof
            %p That the associator vanishes as soon as one argument is real is just the linearity of an algebra product over the ground ring.
            %p Hence in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [a,b,c] = [Im(a), Im(b), Im(c)]
                    \\,.
            %p This implies the second statement by linearity. And so follows the third statement by skew-symmetry:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %msup
                      %mi a
                      %mo *
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [a,a^\ast,b] = -[a,a,b] = 0
                    \\,.
            %p The fourth statement finally follows by this computation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mi c
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo *
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi c
                              %mo *
                            %mo ,
                            %msup
                              %mi b
                              %mo *
                            %mo ,
                            %msup
                              %mi a
                              %mo *
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %mi c
                            %mo ,
                            %mi b
                            %mo ,
                            %mi a
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} [
                            %mi a
                            %mo ,
                            %mi b
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\,[ a, b, c]^\ast
                    \&amp; =
                    \-[c^\ast, b^\ast, a^\ast]
                    \\\
                    \&amp; =
                    \-[c,b,a]
                    \\\
                    \&amp; =
                    \-[a,b,c]
                    \\end{aligned}
                    \\,.
            %p
              Here the first equation follows by inspection and using that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mi b
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %msup
                        %mi b
                        %mo *
                      %msup
                        %mi a
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (a b)^\ast = b^\ast a^\ast
          %p It is immediate to check that:
          #RCHOAreAlternative.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                are real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
            %p
              The real algebras of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %a.maruku-ref{:href => "#TheComplexNumbers"}
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              def.
              %a.maruku-ref{:href => "#TheQuaternions"}
              and
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              def.
              %a.maruku-ref{:href => "#TheOctonions"}
              are
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
          .proof
            %h6#proof_2 Proof
            %p
              Since the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              and
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebras"} associative algebras
              %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              vanishes identically. It only remains to see that the associator of the
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              is skew-symmetric. By linearity it is sufficient to check this on generators. So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi i
                    %mo →
                    %msub
                      %mi e
                      %mi j
                    %mo →
                    %msub
                      %mi e
                      %mi k
                  %annotation{:encoding => "application/x-tex"} e_i \to e_j \to e_k
              be a circle or a cyclic permutation of an edge in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fano+plane"} Fano plane
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi e
                              %mi j
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi k
                            %msub
                              %mi e
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi j
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (e_i e_j) e_j
                    \&amp;=
                    e_k e_j
                    \\\
                    \&amp;=
                    \- e_j e_k
                    \\\
                    \&amp; =
                    \-e_i
                    \\\
                    \&amp; =
                    e_i (e_j e_j)
                    \\end{aligned}
            %p and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi e
                              %mi j
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mi e
                              %mi k
                            %msub
                              %mi e
                              %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi e
                              %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi i
                            %msub
                              %mi e
                              %mi j
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (e_i e_i ) e_j
                    \&amp;=
                    \- e_j
                    \\\
                    \&amp;=
                    \- e_k e_i
                    \\\
                    \&amp;=
                    e_i e_k
                    \\\
                    \&amp;=
                    e_i (e_i e_j)
                    \\end{aligned}
                    \\,.
          %p
            The analog of the
            %a.existingWikiWord{:href => "/nlab/show/Hurwitz+theorem"} Hurwitz theorem
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
          #ZornTheorem.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                are precisely the
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            %p
              The only
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              which are also
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebras"} alternative algebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              themselves, the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              and the
              %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#RCHOAreAlternative"}
          %p
            This is due to (
            %a{:href => "normed+division#algebra#Zorn30"}> Zorn 30
            ).
          %p For the following, the key point of alternative algebras is this equivalent characterization:
          #ArtinTheorem.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative algebra
                detected on subalgebras spanned by any two elements)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/nonassociative+algebra"} nonassociative algebra
              is alternative, def.
              = succeed "," do
                %a.maruku-ref{:href => "#AlternativeAlgebra"}
              %span.newWikiWord
                subalgebra
                %a{:href => "/nlab/new/subalgebra"} ?
              generated by any two elements is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          %p
            This is due to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Emil+Artin"} Emil Artin
            = succeed ")." do
              %a{:href => "alternative+algebra#Schafer95"} Schafer 95, p. 18
          %p
            Proposition
            %a.maruku-ref{:href => "#ArtinTheorem"}
            is what allows to carry over a minimum of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            also to the
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            such as to yield a representation of the
            %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{9,1}
            %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
            below.
          %p
            So we will be looking at a
            %a.existingWikiWord{:href => "/nlab/show/fragment"} fragment
            of
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            over these four
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
          #MatrixNotation.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                with values in real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Say that an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A\in Mat_{n\times n}(\mathbb{K})
            %p
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              if the
              %a.existingWikiWord{:href => "/nlab/show/transpose+matrix"} transpose matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi t
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mi j
                    %mo ≔
                    %msub
                      %mi A
                      %mrow
                        %mi j
                        %mi i
                  %annotation{:encoding => "application/x-tex"} (A^t)_{i j} \coloneqq A_{j i}
              equals the componentwise
              %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} conjugated
              matrix (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Conjugation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi t
                    %mo =
                    %msup
                      %mi A
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^t = A^\ast
                    \\,.
            %p Hence with the notation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    (-)^\dagger \coloneqq ((-)^t)^\ast
            %p
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrix"} hermitian matrix
              precisely if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msup
                      %mi A
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A = A^\dagger
                    \\,.
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mat_{2 \times 2}^{her}(\mathbb{K})
              for the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of hermitian matrices.
          #TraceReversal.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                reversal)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi her
                    %mo{:stretchy => "false"} (
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Mat_{2 \times 2}^{her}(\mathbb{K})
              be a hermitian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              matrix as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %em trace reversal
              is the result of subtracting its
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              times the identity matrix:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo −
                    %mo{:stretchy => "false"} (
                    %mi tr
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mn 1
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde A \;\coloneqq\; A - (tr A) 1_{n\times n}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#MinkowskiSpacetimeInCriticalDimensions
            %strong Minkowski spacetime in dimensions 3,4,6 and 10
          %p
            We now discover
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            of dimension 3,4,6 and 10, in terms of the real
            %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            from prop.
            = succeed "," do
              %a.maruku-ref{:href => "#HurwitzTheorem"}
            %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
            %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            from prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#ZornTheorem"}
            %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
            and def.
            %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            below.
          #SpacetimeAsMatrices.num_prop
            %h6#propositiondefinition Proposition/Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
                as
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                of
                %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
                in
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              be one of the four real
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#HurwitzTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
              from prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ZornTheorem"}
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ×
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2 \times 2
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MatrixNotation"}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              whose
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %msubsup
                        %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} {\vert -\vert^2_\eta}
              is the negative of the
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              operation on matrices is
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            #eq:MinkowskiSpacetimeFromHermitianMatricesWithDeterminant.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi dim
                                  %mi ℝ
                                %mo{:stretchy => "false"} (
                                %mi 𝕂
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mn 1
                                %mo ,
                                %mn 1
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %msup
                                %mi ℝ
                                %mrow
                                  %msub
                                    %mi dim
                                    %mrow
                                      %mi ℝ
                                      %mo{:stretchy => "false"} (
                                      %mi 𝕂
                                      %mo{:stretchy => "false"} )
                                  %mo +
                                  %mn 2
                              %mo ,
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mo −
                                %msubsup
                                  %mo{:stretchy => "false"} |
