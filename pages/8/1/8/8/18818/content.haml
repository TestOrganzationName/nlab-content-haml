                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi permutations
                        %mrow
                          %mi σ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi σ
                        %mo{:stretchy => "false"} |
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mrow
                            %mi σ
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{a_1 \cdots a_p}
                    \\;\coloneqq\;
                    \\frac{1}{p!}
                    \\underset{{permutations \atop \sigma}}{\sum} (-1)^{\vert \sigma\vert } \Gamma_{a_{\sigma(1)}} \cdots \Gamma_{a_{\sigma(p)}}
            %p
              for the antisymmetrized product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              Clifford generators. In particular, if all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i
              are pairwise distinct, then this is simply the plain product of generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi a
                          %mi n
                    %mo =
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mn 1
                    %mi ⋯
                    %msub
                      %mi Γ
                      %mrow
                        %msub
                          %mi a
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext if
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi i
                    %mo ≠
                    %msub
                      %mi a
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{a_1 \cdots a_n}
                    \=
                    \\Gamma_{a_1} \cdots \Gamma_{a_n}
                    \\;\;\;
                    \\text{if}
                    \\;
                    \\underset{i,j}{\forall} (a_i \neq a_j)
                    \\,.
            %p Finally, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
