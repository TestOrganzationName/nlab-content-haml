                        %msub
                          %mi Γ
                          %mrow
                            %mi a
                            %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \exp(\tfrac{\alpha}{4} \Gamma_{a b})
                  coincides precisely with the conjugation action by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
