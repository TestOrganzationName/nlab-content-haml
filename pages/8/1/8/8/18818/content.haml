                            %mi α
                            %mn 2
                        %msub
                          %mi Γ
                          %mrow
                            %mi a
                            %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\hat v \mapsto \exp(- \tfrac{\alpha}{2} \Gamma_{a b}) \hat v \exp(\tfrac{\alpha}{2} \Gamma_{a b})
                %p
                  sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  to the result of
                  %a.existingWikiWord{:href => "/nlab/show/rotation"} rotating
                  it in the
                  = succeed "-plane" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (a,b)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                        %annotation{:encoding => "application/x-tex"} \alpha
          .proof
            %h6#proof_5 Proof
            %p This is immediate by inspection:
            %p
              For the first statement, observe that conjugating the Clifford generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \Gamma_b
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Gamma_a
              yields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \Gamma_b
              up to a sign, depending on whether
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a = b
              or not:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi Γ
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mi Γ
                      %mi b
                    %msub
                      %mi Γ
                      %mi a
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msub
                                %mi Γ
                                %mi b
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mtext if
                              %mspace{:width => "thinmathspace"}
                              %mi a
                              %mo =
                              %mi b
                          %mtr
                            %mtd
                              %msub
                                %mi Γ
                                %mi b
                            %mtd
                              %mo{:stretchy => "false"} |
                              %mtext otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \- \Gamma_a^{-1} \Gamma_b \Gamma_a
                    \=
                    \\left\{
                    \\array{
                    \-\Gamma_b &amp; \vert \text{if}\, a = b
                    \\\
                    \\Gamma_b &amp; \vert \text{otherwise}
                    }
                    \\right.
                    \\,.
            %p
              Therefore for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %msup
                      %mi v
                      %mi b
                    %msub
                      %mi Γ
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \hat v = v^b \Gamma_b
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Γ
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mover
