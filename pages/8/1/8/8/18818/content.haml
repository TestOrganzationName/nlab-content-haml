          .proof
            %h6#proof_4 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{\mathbb{R}, \mathbb{C}, \mathbb{H}\}
              this is immediate from
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/matrix+calculus"} matrix calculus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                    %mo =
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"} \mathbb{K} = \mathbb{O}
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %p
              First we need to see that the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              is well defined. This follows from the
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              of
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
              and the fact that forming
              %a.existingWikiWord{:href => "/nlab/show/conjugate+transpose+matrices"} conjugate transpose matrices
              is an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/antihomomorphism"} antihomomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi G
                        %mn 1
                      %msub
                        %mi G
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo †
                      %mo =
                      %msubsup
                        %mi G
                        %mn 2
                        %mo †
                      %msubsup
                        %mi G
                        %mn 1
                        %mo †
                    %annotation{:encoding => "application/x-tex"} (G_1 G_2)^\dagger = G_2^\dagger G_1^\dagger
              %a.existingWikiWord{:href => "/nlab/show/hermitian+matrices"} hermitian matrices
              to hermitian matrices:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                                %mo (
                                %mi G
                                %mspace{:width => "thinmathspace"}
                                %mi A
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi G
                                  %mo †
                                %mo )
                              %mo †
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mo (
                                  %msup
                                    %mi G
                                    %mo †
                                  %mo )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mi G
                            %mspace{:width => "thinmathspace"}
                            %munder
                              %munder
                                %mrow
                                  %msup
                                    %mi A
                                    %mo †
                                %mo ⏟
                              %mrow
                                %mo =
                                %mi A
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi G
                              %mo †
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi G
                            %mspace{:width => "thinmathspace"}
                            %mi A
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi G
                              %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left(
                    G \, A \, G^\dagger
                    \\right)^\dagger
                    \&amp; =
                    \\underset{= G}{\underbrace{\left( G^\dagger \right)}} \, \underset{= A}{\underbrace{A^\dagger}} \, G^\dagger
                    \\\
                    \&amp; =
                    G \, A \, G^\dagger
                    \\end{aligned}
                    \\,.
            %p
              By prop./def.
              %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              such an action is an
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
              precisely if it preserves the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mi det
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} det(A B) = det(A) det(B)
              and their compativility with conjugate transposition:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo †
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi det
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} det(A^\dagger) = det(A^\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi SL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mi 𝕂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in SL(2,\mathbb{K})
              is an element of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{K}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi det
                            %mrow
                              %mo (
                              %mi G
                              %mspace{:width => "thinmathspace"}
                              %mi A
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi G
                                %mo †
                              %mo )
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %mi det
                                  %mo{:stretchy => "false"} (
                                  %mi G
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %munder
                              %munder
                                %mrow
                                  %mi det
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi G
                                    %mo †
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo =
                                %msup
                                  %mn 1
                                  %mo *
                                %mo =
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi det
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    det\left(
                    G \, A \, G^\dagger
                    \\right)
                    \&amp; =
                    \\underset{ = 1}{\underbrace{det(G)}} \, det(A) \, \underset{= 1^\ast = 1}{\underbrace{det(G^\dagger)}}
                    \\\
                    \&amp; = det(A)
                    \\end{aligned}
                    \\,.
          %p
            In fact the
            %a.existingWikiWord{:href => "/nlab/show/special+linear+groups"} special linear groups
            of
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
