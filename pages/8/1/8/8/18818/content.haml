                  %annotation{:encoding => "application/x-tex"}
                    \\exp(-\tfrac{\alpha}{2} \Gamma_{ab}) \hat v \exp(\tfrac{\alpha}{2} \Gamma_{ab})
                    \=
                    \\exp(\tfrac{1}{2}[\Gamma_{a b}, -])(\hat v)
            %p is the rotation action as claimed.
          #AmbiguityInCliffordConjugation.num_remark
            %h6#remark_5 Remark
            %p
              Since the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflections"} reflections
              %a.existingWikiWord{:href => "/nlab/show/rotations"} rotations
              and
              %a.existingWikiWord{:href => "/nlab/show/boosts"} boosts
              in example
              %a.maruku-ref{:href => "#CliffordConjugtionReflectionAndRotation"}
              are given by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/conjugation+actions"} conjugation actions
            %ol
              %li
                %p
                  the conjugation action by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Γ
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \Gamma_a
                  coincides precisely with the conjugation action by
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mi Γ
                            %mi a
                        %annotation{:encoding => "application/x-tex"} -\Gamma_a
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi α
