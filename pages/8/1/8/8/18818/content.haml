                  %annotation{:encoding => "application/x-tex"} p+1 \in \{2+1, \,3+1, \, 5+1. \, 9+1\}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
              given under the identification with the
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
