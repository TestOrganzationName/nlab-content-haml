              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} -1
            %p For the second statement, observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Γ
                      %mrow
                        %mi a
                        %mi b
                    %mo ,
                    %msub
                      %mi Γ
                      %mi c
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi Γ
                      %mi a
                    %msub
                      %mi η
                      %mrow
                        %mi b
                        %mi c
                    %mo −
                    %msub
                      %mi Γ
                      %mi b
                    %msub
                      %mi η
                      %mrow
                        %mi a
                        %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \-\tfrac{1}{2}[\Gamma_{a b}, \Gamma_c]
                    \=
                    \\Gamma_a \eta_{b c} - \Gamma_b \eta_{a c}
                    \\,.
            %p
              This is the canonical action of the Lorentzian
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 2
                    %msub
                      %mi Γ
                      %mi ab
                    %mo{:stretchy => "false"} )
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi α
                        %mn 2
                    %msub
                      %mi Γ
                      %mi ab
                    %mo{:stretchy => "false"} )
                    %mo =
