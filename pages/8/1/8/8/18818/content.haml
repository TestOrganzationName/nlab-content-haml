                          %mo −
                      %annotation{:encoding => "application/x-tex"}
                        \\overline{\psi_1} \,\Gamma\, \psi_2 = + \overline{\phi_2}\, \Gamma\, \psi_1
                        \\phantom{AAAA}
                        \\text{for} \phantom{AA} \psi_1, \psi_2 \in S_+ \oplus S_-
          %p
            (
            %a{:href => "geometry+of+physics+--+supersymmetry#BaezHuerta09"}> Baez-Huerta 09, prop. 8, prop. 9
            ).
          #TwoComponentSpinorNotation.num_remark
            %h6#remark_7 Remark
            %p
              %strong
                (two-component
                %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
                notation)
            %p
              In the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
              literature the expressions for
              %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
              given by prop.
              %a.maruku-ref{:href => "#SpinorRepsByNormedDivisionAlgebra"}
              are traditionally written in
              %em two-component spinor notation
              as follows:
            %ul
              %li
                %p
                  An element of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S_+
                  is denoted
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mi a
                        %mo ∈
                        %mi 𝕂
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi a
                            %mo =
                            %mn 1
                            %mo ,
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} (\chi_a \in \mathbb{K})_{a = 1,2}
                  and called a
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Weyl+spinor"} left handed spinor
              %li
                %p
                  an element of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo −
                      %annotation{:encoding => "application/x-tex"} S_-
                  is denoted
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ξ
                          %mrow
                            %mo †
                            %mover
                              %mi a
                              %mo ˙
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mover
                              %mi a
                              %mo ˙
                            %mo =
                            %mn 1
                            %mo ,
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} (\xi^{\dagger \dot a})_{\dot a = 1,2}
                  and called a
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Weyl+spinor"} right handed spinor
              %li
                %p
                  an element of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo =
                        %msub
                          %mi S
                          %mo +
                        %mo ⊕
                        %msub
                          %mi S
                          %mo −
                      %annotation{:encoding => "application/x-tex"} S = S_+ \oplus S_-
                  is denoted
                #eq:TwoComponentNotationForDiracSpinor.maruku-equation
                  %span.maruku-eq-number (6)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ψ
                          %mi α
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi χ
                            %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ξ
                            %mrow
                              %mo †
                              %mover
                                %mi a
                                %mo ˙
                          %mo{:stretchy => "false"} )
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        (\psi^\alpha) = \left( (\chi_a), (\xi^{\dagger \dot a}) \right)
                %p
                  and called a
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Dirac+spinor"} Dirac spinor
            %p
              and the Clifford action of prop.
              %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
              corresponds to the generalized “
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"}> Pauli matrices
              ”:
            %ul
              %li
                %p
                  a hermitian matrix
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %msubsup
                          %mi Mat
                          %mrow
                            %mn 2
                            %mo ×
                            %mn 2
                          %mi her
                        %mo{:stretchy => "false"} (
                        %mi 𝕂
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \in Mat^{her}_{2\times 2}(\mathbb{K})
                  as in prop
                  %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
                  regarded as a linear map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mo −
                        %mo →
                        %msub
                          %mi S
                          %mo +
                      %annotation{:encoding => "application/x-tex"} S_- \to S_+
                  via def.
                  %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                  is denoted
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %msub
                            %mi x
                            %mi μ
                          %msubsup
                            %mi σ
                            %mrow
                              %mi a
                              %mover
                                %mi a
                                %mo ˙
                            %mi μ
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi x
                                    %mn 0
                                  %mo +
                                  %msub
                                    %mi x
                                    %mn 1
                                %mtd
                                  %mi y
                              %mtr
                                %mtd
                                  %msup
                                    %mi y
                                    %mo *
                                %mtd
                                  %msub
                                    %mi x
                                    %mn 0
                                  %mo −
                                  %msub
                                    %mi x
                                    %mn 1
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\left(x_\mu \sigma^\mu_{a \dot a}\right)
                        \\;\coloneqq\;
                        \\left( \array{  x_0 + x_1 &amp; y  \\ y^\ast &amp; x_0 - x_1 } \right)    \,;
              %li
                %p
                  the negative of the trace-reversal (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TraceReversal"}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mo +
                          %mo →
                          %msub
                            %mi S
                            %mo −
                        %annotation{:encoding => "application/x-tex"} S_+ \to S_-
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %msub
                            %mi x
                            %mi μ
                          %msup
                            %mover
                              %mi σ
                              %mo ˜
                            %mrow
                              %mi μ
                              %mover
                                %mi a
                                %mo ˙
                              %mi a
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msub
                                    %mi x
                                    %mn 0
                                  %mo +
                                  %msub
                                    %mi x
                                    %mn 1
                                %mtd
                                  %mi y
                              %mtr
                                %mtd
                                  %msup
                                    %mi y
                                    %mo *
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msub
                                    %mi x
                                    %mn 0
                                  %mo −
                                  %msub
                                    %mi x
                                    %mn 1
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        x_\mu \widetilde \sigma^{\mu \dot a a}
                        \\right)
                        \\;\coloneqq\;
                        \-
                        \\left( \array{  -x_0 + x_1 &amp; y  \\ y^\ast &amp; -x_0 - x_1 } \right)
                        \\,.
              %li
                %p
                  the corresponding Clifford generator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi S
                          %mo +
                        %mo ⊕
                        %msub
                          %mi S
                          %mo −
                        %mo →
                        %msub
                          %mi S
                          %mo +
                        %mo ⊕
                        %msub
                          %mi S
                          %mo −
                      %annotation{:encoding => "application/x-tex"} \Gamma(A) \;\colon\; S_+ \oplus S_- \to S_+ \oplus S_-
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CliffordAlgebraInTermsOfNormedDivisionAlgebra"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi μ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi γ
                          %mi μ
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi α
                            %mi β
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mn 0
                                %mtd
                                  %msub
                                    %mi x
                                    %mi μ
                                  %msubsup
                                    %mi σ
                                    %mrow
                                      %mi a
                                      %mover
                                        %mi b
                                        %mo ˙
                                    %mi μ
                              %mtr
                                %mtd
                                  %msub
                                    %mi x
                                    %mi μ
                                  %msup
                                    %mover
                                      %mi σ
                                      %mo ˜
                                    %mrow
                                      %mi μ
                                      %mover
                                        %mi a
                                        %mo ˙
                                      %mi b
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        x_\mu (\gamma^\mu)_{\alpha \beta}
                        \\;\coloneqq\;
                        \\left(
                        \\array{
                        0 &amp; x_\mu \sigma^\mu_{a \dot b}
                        \\\
                        x_\mu \widetilde \sigma^{\mu \dot a b}
                        }
                        \\right)
              %li
                %p
                  the bilinear spinor-to-vector pairing from prop.
                  %a.maruku-ref{:href => "#RealSpinorPairingsViaDivisionAlg"}
                  is written as the
                  %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mover
                            %mi ψ
                            %mo ¯
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi γ
                            %mi μ
                          %mspace{:width => "thinmathspace"}
                          %mi ϕ
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mover
                          %mi ψ
                          %mo ¯
                        %mspace{:width => "thinmathspace"}
                        %mi Γ
                        %mspace{:width => "thinmathspace"}
                        %mi ϕ
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\left( \overline{\psi} \, \gamma^\mu \, \phi\right)
                        \\;\coloneqq\;
                        \\overline{\psi}\,\Gamma \,\phi
                        \\,,
                %p
                  where the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Dirac+conjugate"} Dirac conjugate
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ψ
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} \overline{\psi}
                  on the left is given on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ψ
                          %mi α
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mi a
                        %mo ,
                        %msup
                          %mi ξ
                          %mrow
                            %mo †
                            %mover
                              %mi c
                              %mo ˙
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\psi_\alpha) = (\chi_a, \xi^{\dagger \dot c})
                  by
                #eq:DiracConjugate.maruku-equation
                  %span.maruku-eq-number (7)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mover
                                  %mi ψ
                                  %mo ¯
                              %mtd
                                %mo ≔
                                %msup
                                  %mi ψ
                                  %mo †
                                %msup
                                  %mi γ
                                  %mn 0
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ξ
                                  %mi a
                                %mo ,
                                %msubsup
                                  %mi χ
                                  %mover
                                    %mi a
                                    %mo ˙
                                  %mo †
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \\overline{\psi}
                        \&amp; \coloneqq
                        \\psi^\dagger \gamma^0
                        \\\
                        \&amp; =
                        ( \xi^a, \chi^\dagger_{\dot a} )
                        \\end{aligned}
                %p
                  hence, with
                  = succeed ":" do
                    %a.maruku-eqref{:href => "#eq:TwoComponentNotationForDiracSpinor"} (6)
                #eq:TwoComponentNotationForSpinorToVectorPairing.maruku-equation
                  %span.maruku-eq-number (8)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mover
                                  %mrow
                                    %msub
                                      %mi ψ
                                      %mn 1
                                  %mo ¯
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi γ
                                  %mi μ
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi ψ
                                  %mn 2
                              %mtd
                                %mo =
                                %msubsup
                                  %mi ψ
                                  %mn 1
                                  %mo †
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mi γ
                                  %mn 0
                                %msup
                                  %mi γ
                                  %mi μ
                                %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi ψ
                                  %mn 2
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ξ
                                  %mn 1
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mi a
                                %mspace{:width => "thinmathspace"}
                                %msubsup
                                  %mi σ
                                  %mrow
                                    %mi a
                                    %mover
                                      %mi c
                                      %mo ˙
                                  %mi μ
                                %mspace{:width => "thinmathspace"}
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ξ
                                  %mn 2
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo †
                                    %mover
                                      %mi c
                                      %mo ˙
                                %mo +
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi χ
                                  %mn 1
                                %msubsup
                                  %mo{:stretchy => "false"} )
                                  %mover
                                    %mi a
                                    %mo ˙
                                  %mo †
                                %mspace{:width => "thinmathspace"}
                                %msup
                                  %mover
                                    %mi σ
                                    %mo ˜
                                  %mrow
                                    %mi μ
                                    %mover
                                      %mi a
                                      %mo ˙
                                    %mi c
                                %mspace{:width => "thinmathspace"}
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi χ
                                  %mn 2
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi c
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \\overline{\psi_1} \,\gamma^\mu\, \psi_2
                        \&amp; =
                        \\psi_1^\dagger \, \gamma^0 \gamma^\mu \, \psi_2
                        \\\
                        \&amp; =
                        (\xi_1)^a \, \sigma^\mu_{a \dot c}\, (\xi_2)^{\dagger \dot c}
                        +
                        (\chi_1)^\dagger_{\dot a} \, \widetilde \sigma^{\mu \dot a c} \, (\chi_2)_c
                        \\end{aligned}
            %p
              Finally, it is common to abbreviate contractions with the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi γ
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\gamma^\mu)
              by a slash, as in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi γ
                      %mi μ
                    %msub
                      %mi k
                      %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    k\!\!\!/\, \;\coloneqq\; \gamma^\mu k_\mu
            %p or
            #eq:FeynmanSlashNotationForMasslessDiracOperator.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∂
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %msup
                      %mi γ
                      %mi μ
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i \partial\!\!\!/\,
                    \\;\coloneqq\;
                    i \gamma^\mu \frac{\partial}{\partial x^\mu}
                    \\,.
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+slash+notation"} Feynman slash notation
          %p
            (e.g.
            = succeed "," do
              %a{:href => "Dirac+field#DermisekI8"} Dermisek I-8
            = succeed ")" do
              %a{:href => "Dirac+field#DermisekI9"} Dermisek I-9
          %p
            Below we spell out the example of the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
            in detail (example
            = succeed ")." do
              %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
            %em massive chiral spinor fields
            one also needs the following, here we just mention this for completeness:
          #ChiralSpinorMassPairing.num_defn
            %h6#proposition_12 Proposition
            %p
              %strong (chiral spinor mass pairing)
            %p In dimension 2+1 and 3+1, there exists a non-trivial skew-symmetric pairing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ∧
                    %mi S
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon
                    \\;\colon\;
                    S \wedge S
                    \\longrightarrow
                    \\mathbb{R}
            %p
              which may be normalized such that in the two-component spinor basis of remark
              %a.maruku-ref{:href => "#TwoComponentSpinorNotation"}
              we have
            #eq:ConjugationOfLeftRightCliffordGeneratorToRightLeft.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi σ
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi μ
                        %mover
                          %mi a
                          %mo ˙
                        %mi a
                    %mo =
                    %msup
                      %mi ϵ
                      %mrow
                        %mi a
                        %mi b
                    %msup
                      %mi ϵ
                      %mrow
                        %mover
                          %mi a
                          %mo ˙
                        %mover
                          %mi b
                          %mo ˙
                    %msubsup
                      %mi σ
                      %mrow
                        %mi b
                        %mover
                          %mi b
                          %mo ˙
                      %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \sigma^{\mu \dot a a} = \epsilon^{a b} \epsilon^{\dot a \dot b} \sigma^\mu_{b \dot b}
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Take the non-vanishing components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mrow
                        %mn 1
                        %mn 2
                    %mo =
                    %msup
                      %mi ϵ
                      %mrow
                        %mover
                          %mn 1
                          %mo ˙
                        %mover
                          %mn 2
                          %mo ˙
                    %mo =
                    %msub
                      %mi ϵ
                      %mn 21
                    %mo =
                    %msub
                      %mi ϵ
                      %mrow
                        %mover
                          %mn 2
                          %mo ˙
                        %mover
                          %mn 1
                          %mo ˙
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon^{1 2} = \epsilon^{\dot 1 \dot 2} = \epsilon_{21} = \epsilon_{\dot 2 \dot 1} =  1
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mrow
                        %mn 2
                        %mn 1
                    %mo =
                    %msup
                      %mi ϵ
                      %mrow
                        %mover
                          %mn 2
                          %mo ˙
                        %mover
                          %mn 1
                          %mo ˙
                    %mo =
                    %msub
                      %mi ϵ
                      %mrow
                        %mn 1
                        %mn 2
                    %mo =
                    %msub
                      %mi ϵ
                      %mrow
                        %mover
                          %mn 1
                          %mo ˙
                        %mover
                          %mn 2
                          %mo ˙
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon^{2 1} = \epsilon^{\dot 2 \dot 1} = \epsilon_{1 2} = \epsilon_{\dot 1 \dot 2} = -1
                    \\,.
            %p
              With this equation
              %a.maruku-eqref{:href => "#eq:ConjugationOfLeftRightCliffordGeneratorToRightLeft"} (10)
              is checked explicitly. It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              thus defined is skew symmetric as long as the component algebra is commutative, which is the case for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              being
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#CausalStructure
            %strong Causal structure
          %p
            We need to consider the following concepts and constructions related to the
            %a.existingWikiWord{:href => "/nlab/show/causal+structure"} causal structure
            of
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#MinkowskiSpacetime"}
          #SpacelikeTimelikeLightlike.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/spacelike"}> spacelike
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/direction+of+a+vector"} directions
                %a.existingWikiWord{:href => "/nlab/show/past"} past
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/future"} future
            %p
              Given two points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} x,y \in \Sigma
              in
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ≔
                    %mi y
                    %mo −
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    v \coloneqq y - x \in \mathbb{R}^{p,1}
            %p
              for their difference, using the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              structure underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %p
              Recall the Minkowski
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,1}
              = succeed "." do
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              %a.maruku-ref{:href => "#MinkowskiMetricAndPhysicalUnitOfLength"}
              we say that the difference vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is
            %ol
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                  if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo &gt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \eta(v,v) \gt 0
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
                  if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo &lt;
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \eta(v,v) \lt 0
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
                  if
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo ,
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \eta(v,v) = 0
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              or
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
              then we say that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                  is in the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/future"} future
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  if
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi y
                            %mn 0
                          %mo −
                          %msup
                            %mi x
                            %mn 0
                          %mo ≥
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} y^0 - x^0 \geq 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                  is in the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/past"} past
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  if
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi y
                            %mn 0
                          %mo −
                          %msup
                            %mi x
                            %mn 0
                          %mo ≤
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} y^0 - x^0 \leq 0
          #CausalPastAndFuture.num_defn
            %h6#definition_14 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/causal+cones"}> causal cones
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} x \in \Sigma
              a point in spacetime (an
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/event"} event
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi V
                      %mo −
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    V^+(x), V^-(x) \subset \Sigma
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              %a.existingWikiWord{:href => "/nlab/show/events"} events
              that are in the
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              %a.existingWikiWord{:href => "/nlab/show/future"} future
              or in the
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              %a.existingWikiWord{:href => "/nlab/show/past"} past
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed ")" do
                %a.maruku-ref{:href => "#SpacelikeTimelikeLightlike"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/open+future+cone"} open future cone
              and
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+past+cone"} open past cone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo −
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{V}^+(x), \overline{V}^-(x) \subset \Sigma
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              %a.existingWikiWord{:href => "/nlab/show/events"} events
              that are in the
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              or
              %a.existingWikiWord{:href => "/nlab/show/lightlike"} lightlike
              %a.existingWikiWord{:href => "/nlab/show/future"} future
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/past"} past
              %em
                %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              and
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/union"} union
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo −
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J(x) \coloneqq \overline{V}^+(x) \cup \overline{V}^-(x)
            %p
              of the closed
              %a.existingWikiWord{:href => "/nlab/show/future+cone"} future cone
              and
              %a.existingWikiWord{:href => "/nlab/show/past+cone"} past cone
              is called the full
              %em
                %a.existingWikiWord{:href => "/nlab/show/causal+cone"} causal cone
              of the
              %a.existingWikiWord{:href => "/nlab/show/event"} event
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              is the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
            %p
              More generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S \subset \Sigma
              a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of
              %a.existingWikiWord{:href => "/nlab/show/events"} events
              we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∪
                      %mrow
                        %mi x
                        %mo ∈
                        %mi S
                    %msup
                      %mover
                        %mi V
                        %mo ¯
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{V}^\pm(S)
                    \\;\coloneqq\;
                    \\underset{x \in S}{\cup} \overline{V}^{\pm}(x)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of the future/past closed cones of all events in the subset.
          #CompactlySourceCausalSupport.num_defn
            %h6#definition_15 Definition
            %p
              %strong (compactly sourced causal support)
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{}{\to} \Sigma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_{\Sigma}(E)
              for the
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} spaces of smooth sections
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Sections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi cp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mtext compact support
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mo ±
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mtext compactly sourced future/past support
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi scp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mtext spacelike compact support
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} /
                                %mi p
                                %mo{:stretchy => "false"} )
                                %mi cp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mtext future/past compact support
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %mi Σ
                                %mo ,
                                %mi tcp
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thinmathspace"}
                            %mtext timelike compact support
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Gamma_{cp}(E) &amp; \,\text{compact support}
                    \\\
                    \\Gamma_{\Sigma,\pm cp}(E) &amp; \,\text{compactly sourced future/past support}
                    \\\
                    \\Gamma_{\Sigma,scp}(E) &amp; \,\text{spacelike compact support}
                    \\\
                    \\Gamma_{\Sigma,(f/p)cp}(E) &amp; \,\text{future/past compact support}
                    \\\
                    \\Gamma_{\Sigma,tcp}(E) &amp; \,\text{timelike compact support}
                    \\end{aligned}
            %p
              for the subsets on those smooth sections whose
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              is
            %ol
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi cp
                      %annotation{:encoding => "application/x-tex"} cp
                  ) inside a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ±
                        %mi cp
                      %annotation{:encoding => "application/x-tex"} \pm cp
                  ) inside the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi scp
                      %annotation{:encoding => "application/x-tex"} scp
                  ) inside the
                  %a.existingWikiWord{:href => "/nlab/show/closed+causal+cone"} closed causal cone
                  of a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
                  %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                  with every (
                  %a.existingWikiWord{:href => "/nlab/show/spacelike"}> spacelike
                  )
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                  is compact (
                  %a{:href => "#Sanders12"}> Sanders 13, theorem 2.2
                  ),
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi fcp
                      %annotation{:encoding => "application/x-tex"} fcp
                  ) inside the past of a Cauchy surface (
                  %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                  ),
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi pcp
                      %annotation{:encoding => "application/x-tex"} pcp
                  ) inside the future of a Cauchy surface (
                  %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                  ),
              %li
                %p
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi tcp
                      %annotation{:encoding => "application/x-tex"} tcp
                  ) inside the future of one Cauchy surface and the past of another (
                  %a{:href => "#Sanders12"}> Sanders 13, def. 3.2
                  ).
          %p
            (
            %a{:href => "space+of+sections#Baer14"}> Bär 14, section 1
            ,
            = succeed ")" do
              %a{:href => "Green+hyperbolic+differential+operator#Khavkine14"} Khavkine 14, def. 2.1
          #CausalOrdering.num_defn
            %h6#definition_16 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/causal+order"}> causal order
                )
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              on the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(\Sigma)
              of
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              which says a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S_1 \subset \Sigma
              is
              %em not prior
              to a subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                      %mo ⊂
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} S_2 \subset \Sigma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_1 {\vee\!\!\!\wedge} S_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S_1
              does not
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersect
              the
              %a.existingWikiWord{:href => "/nlab/show/causal+past"} causal past
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_2
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CausalPastAndFuture"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_2
              does not intersect the
              %a.existingWikiWord{:href => "/nlab/show/causal+future"} causal future
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mn 1
                            %mrow
                              %mo ∨
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mo ∧
                            %msub
                              %mi S
                              %mn 2
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi S
                              %mn 1
                            %mo ∩
                            %msup
                              %mover
                                %mi V
                                %mo ¯
                              %mo −
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi S
                              %mn 2
                            %mo ∩
                            %msup
                              %mover
                                %mi V
                                %mo ¯
                              %mo +
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    S_1 {\vee\!\!\!\wedge} S_2
                    \&amp; \;\;\coloneqq\;\;
                    S_1 \cap \overline{V}^-(S_2) = \emptyset
                    \\\
                    \&amp; \;\;\Leftrightarrow\;\; S_2 \cap \overline{V}^+(S_1) = \emptyset
                    \\end{aligned}
                    \\,.
            %p
              (Beware that this is just a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordering"} ordering
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} relation
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S_1 {\vee\!\!\!\wedge} S_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 2
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S_2 {\vee\!\!\!\wedge} S_1
              we say that the two subsets are
              %em
                %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                separated
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo &gt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo &lt;
                    %msub
                      %mi S
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mn 2
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_1 {\gt\!\!\!\!\lt} S_2
                    \\;\;\;\coloneqq\;\;\;
                    S_1 {\vee\!\!\!\wedge} S_2 \;\text{and}\; S_2 {\vee\!\!\!\wedge} S_1
                    \\,.
          #CausalComplementOfSubsetOfLorentzianManifold.num_example
            %h6#definition_17 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
                and
                %a.existingWikiWord{:href => "/nlab/show/causal+closure"} causal closure
                of subset of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %em
                %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} S^\perp
              is the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/causal+cone"} causal cone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo ⊥
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo ∖
                    %msub
                      %mi J
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^\perp \;\coloneqq\; S \setminus J_X(S)
                    \\,.
            %p
              The causal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mo ⊥
                        %mo ⊥
                  %annotation{:encoding => "application/x-tex"} S^{\perp \perp}
              of the causal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} S^\perp
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causal+closure"} causal closure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msup
                      %mi S
                      %mrow
                        %mo ⊥
                        %mo ⊥
                  %annotation{:encoding => "application/x-tex"}
                    S = S^{\perp \perp}
            %p
              then the subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CausClsdSubsets
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    CausClsdSubsets(\Sigma) \;\in\; Cat
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
              of causally closed subsets, partially ordered by inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mn 1
                      %mo ⊂
                      %msub
                        %mi 𝒪
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_1 \subset \mathcal{O}_2
          #CutoffFunctions.num_defn
            %h6#definition_18 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"}> adiabatic switching
                )
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} \subset \Sigma
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
                function
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/infrared+cutoff"} infrared cutoff
                function
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi sw
                  %annotation{:encoding => "application/x-tex"} g_{sw}
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              is the
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              with value
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cutoffs
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %msub
                        %mi g
                        %mi sw
                      %mo ∈
                      %msubsup
                        %mi C
                        %mi c
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ∃
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi U
                              %mo ⊃
                              %mi 𝒪
                          %mrow
                            %mtext neighbourhood
                      %mrow
                        %mo (
                        %msub
                          %mi g
                          %mi sw
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi U
                        %mo =
                        %mn 1
                        %mo )
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cutoffs(\mathcal{O})
                    \\;\coloneqq\;
                    \\left\{
                    g_{sw} \in C^\infty_c(\Sigma)
                    \\;\vert\;
                    \\underset{ {U \supset \mathcal{O}} \atop { \text{neighbourhood} } }{\exists}
                    \\left(
                    g_{sw}\vert_U = 1
                    \\right)
                    \\right\}
                    \\,.
            %p
              Often we consider the vector space space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma)\langle g \rangle
              spanned by a formal variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi C
                              %mi c
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msubsup
                              %mi C
                              %mi c
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ⟨
                            %mi g
                            %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_c^\infty(\Sigma) &amp;\overset{\simeq}{\longrightarrow}&amp; C_c^\infty(X)\langle g\rangle
                    }
            %p
              which are thus bump functions constant over a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              not on 1 but on the formal parameter
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi sw
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi U
                    %mo =
                    %mi g
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    g_{sw}\vert_U = g
                    \\,
            %p
              In this sense we may think of the adiabatic switching as
              %em being
              the spacetime-depependent coupling “constant”.
          %p
            The following lemma
            %a.maruku-ref{:href => "#CausalPartition"}
            will be key in the derivation (proof of prop.
            %a.maruku-ref{:href => "#CausalLocalityOfThePerturbativeSMatrix"}
            below) of the
            %a.existingWikiWord{:href => "/nlab/show/causal+locality"} causal locality
            of
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+quantum+observables"} algebra of quantum observables
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
          #CausalPartition.num_lemma
            %h6#lemma Lemma
            %p
              %strong (causal partition)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} \subset \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty_{cp}(\Sigma)
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              which vanishes on a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊃
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} U \supset \mathcal{O}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi U
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f\vert_U = 0
            %p
              Then there exists a
              %em causal partition
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in that there exist compactly supported smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi r
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a,r \in C^\infty_{cp}(\Sigma)
              such that
            %ol
              %li
                %p
                  they sum up to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %mi a
                        %mo +
                        %mi r
                      %annotation{:encoding => "application/x-tex"}
                        f = a + r
              %li
                %p
                  their
                  %a.existingWikiWord{:href => "/nlab/show/support"} support
                  satisfies the following causal ordering (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CausalOrdering"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo ∨
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo ∧
                        %mi 𝒪
                        %mrow
                          %mo ∨
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mo ∧
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        supp(a) {\vee\!\!\!\wedge} \mathcal{O} {\vee\!\!\!\wedge} supp(r)
                        \\,.
          .proof
            %h6#proof_idea Proof idea
            %p
              By assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma_p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/leaf"} leaf
              of a
              %a.existingWikiWord{:href => "/nlab/show/foliation"} foliation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              by Cauchy surfaces, given by a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma \simeq (-1,1) \times \Sigma_p
              with the original
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Sigma_p
              at zero. There exists then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon \in (0,1)
              such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp(f)
              to the interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-\epsilon, \epsilon)
              is in the
              %a.existingWikiWord{:href => "/nlab/show/causal+complement"} causal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒪
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\mathcal{O}}
              of the given region (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#CausalComplementOfSubsetOfLorentzianManifold"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Σ
                      %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi 𝒪
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    supp(f) \cap (-\epsilon, \epsilon) \times \Sigma_p
                    \\;\subset\;
                    \\overline{\mathcal{O}}
                    \\,.
            %p
              Let then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \chi \colon \Sigma \to \mathbb{R}
              be any
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              with
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %msub
                              %mi Σ
                              %mi p
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \chi\vert_{(-1,0] \times \Sigma_p} = 1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi χ
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi Σ
                              %mi p
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \chi\vert_{(\epsilon,1) \times \Sigma_p} = 0
                  \.
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≔
                    %mi χ
                    %mo ⋅
                    %mi f
                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mi a
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi f
                  %annotation{:encoding => "application/x-tex"}
                    r \coloneqq \chi \cdot f
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    a \coloneqq (1-\chi) \cdot f
            %p are smooth functions as required.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of
            %a.existingWikiWord{:href => "/nlab/show/spin"} spin
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a{:href => "#Fields"} next chapter
            we consider the concept of
            %em
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
