          %h2#modular_forms modular forms
          %p
            %strong definition
            An
            %strong
              (integral)
              %a.existingWikiWord{:href => "/nlab/show/modular+form"} modular form
            of weight
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            is a
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
            on the
            %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo ↪
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"}
                  f : (\mathbb{R}^2)_+ \hookrightarrow \mathbb{C}
          %p (complex numbers with strictly positive imaginary part)
          %p such that
          %ol
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mi c
                              %mtd
                                %mi d
                        %mo )
                      %mo ∈
                      %msub
                        %mi SL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A = \left( \array{a &amp; b \\ c&amp; d}\right) \in SL_2(\mathbb{Z})
                acting by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo :
                      %mi τ
                      %mo ↦
                      %mo =
                      %mfrac
                        %mrow
                          %mi a
                          %mi τ
                          %mo +
                          %mi b
                        %mrow
                          %mi c
                          %mi τ
                          %mo +
                          %mi d
                    %annotation{:encoding => "application/x-tex"} A : \tau \mapsto = \frac{a \tau + b }{c \tau + d}
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mi τ
                      %mo +
                      %mi d
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi w
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      f(A(\tau)) = (c \tau + d)^w f(\tau)
              %p
                %strong note
                take
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mn 1
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mn 1
                        %mo )
                    %annotation{:encoding => "application/x-tex"} A = \left( \array{1 &amp; 1 \\ 0&amp; 1}\right)
                then we get that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(\tau + 1) = f(\tau)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                has at worst a pole at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0\}
                (for
                %em weak
                modular forms this condition is relaxed)
              %p
                it follows that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f = f(q)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi π
                          %mi i
                          %mi τ
                    %annotation{:encoding => "application/x-tex"} q = e^{2 \pi i \tau}
                is a meromorphic funtion on the open disk.
            %li
              %p
                %strong integrality
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi k
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi N
                        %mn ∞
                      %msub
                        %mi a
                        %mi k
                      %mo ⋅
                      %msup
                        %mi q
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \tilde f(q) = \sum_{k = -N}^\infty a_k \cdot q^k
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi k
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} a_k \in \mathbb{Z}
          %p
            by this definition, modular forms are not really functions on the upper half plane, but functions on a
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/torus"} tori
          %p
            if the weight vanishes, we say that modular form is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/modular+function"} modular function
            \.
          %p
            %strong
              definition (2|1)-dim
              %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be an EFT
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} |
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi EFT
                    %mn 0
                  %mover
                    %mo →
                    %mi S
                  %mn 2
                  %mi EFT
                  %mo ≠
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  (2|1)EFT^0 \stackrel{S}{\to}
                  2 EFT \ne E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ↦
                  %msub
                    %mi E
                    %mi red
                %annotation{:encoding => "application/x-tex"}
                  E \mapsto E_{red}
          %p
            then the
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            is the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi E
                  %mo :
                  %mi ℂ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} Z_E : \mathbb{C} \to \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi E
                  %mo :
                  %mi τ
                  %mo ↦
                  %msub
                    %mi E
                    %mi red
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Z_E : \tau \mapsto E_{red}(T_\tau)
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi τ
                  %mo :
                  %mo =
                  %mi ℂ
                  %mo{:stretchy => "false"} /
                  %mrow
                    %mi ℤ
                    %mo ×
                    %mi ℤ
                    %mo ⋅
                    %mi τ
                %annotation{:encoding => "application/x-tex"}
                  T_\tau := \mathbb{C}/{\mathbb{Z} \times \mathbb{Z} \cdot \tau}
          %p
            is thee standard torus of modulus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
          %p
            then the central
            %strong theorem
            that we are after here is
          %p
            %strong therorem (Stolz-Teichner)
            (after a suggestion by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
          %p
            There is a precise definition of
            = succeed "-EFTs" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} |
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2|1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            such that the
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi E
                %annotation{:encoding => "application/x-tex"} Z_E
            is an integral
            %a.existingWikiWord{:href => "/nlab/show/modular+function"} modular function
          %p (so this is really four theorems: the function is holomorphic, integral, etc.)
          %p
            moreover, every
            %a.existingWikiWord{:href => "/nlab/show/integral+modular+function"} integral modular function
            arises in this way.
          %h2#related_concepts Related concepts
          %p
            A concrete relation between
            %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
            and
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            is the lift of the
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+orientation+of+tmf"} string orientation of tmf
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephan+Stolz"}> Stephan Stolz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                %em
                  %a.existingWikiWord{:href => "/nlab/show/What+is+an+elliptic+object%3F"} What is an elliptic object?
                in
                %em Topology, geometry and quantum field theory
                , London Math. Soc. LNS 308, Cambridge Univ. Press (2004), 247-343. (
                %a{:href => "http://web.me.com/teichner/Math/Reading_files/Elliptic-Objects.pdf"}> pdf
                )
            %li
              %p
                Pokman Cheung,
                %em Supersymmetric field theories and cohomology
                (
                %a{:href => "http://arxiv.org/abs/0811.2267"}> arXiv:0811.2267
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Stolz"}> Stefan Stolz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Teichner"} Peter Teichner
                %em Supersymmetric Euclidean field theories and generalized cohomology
                , in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                (eds.),
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
          %p
            A hint supporting the conjectured relation of
            %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
            to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+orientation+of+tmf"} string orientation of tmf
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Theo+Johnson-Freyd"} Theo Johnson-Freyd
              %em Holomorphic SCFTs with small index
              (
              %a{:href => "https://arxiv.org/abs/1811.00589"}> arXiv:1811.00589
              )
        .revisedby
