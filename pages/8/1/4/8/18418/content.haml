          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            %em
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
            asserts that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply-connected+topological+space"} semi-locally simply-connected topological space
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            given by sending a
            %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to its
            %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation
            %a.existingWikiWord{:href => "/nlab/show/groupoid+representation"} groupoid representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(X)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fib
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Cov
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi Set
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Fib
                  \\;\colon\;
                  Cov(X) \longrightarrow Set^{\Pi_1(X)}
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            between the
            %a.existingWikiWord{:href => "/nlab/show/category+of+covering+spaces"} category of covering spaces
            and that of
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation
            %a.existingWikiWord{:href => "/nlab/show/groupoid+representations"} groupoid representations
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rec
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Set
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Cov
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Rec
                  \\;\colon\;
                  Set^{\Pi_1(X)}
                  \\longrightarrow
                  Cov(X)
          %p
            which is an
            %a.existingWikiWord{:href => "/nlab/show/inverse+functor"} inverse functor
            up to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rec
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rec(\rho)
            from a
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rec
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Rec(\rho)
            is
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
            to the original representation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} Fib(Rec(\rho)) \simeq \rho
          %h2#Details Details
          %p We give several equivalent discussions:
          %ol
            %li
              %p
                An
                %a{:href => "#ElementaryDescription"} Elementary description
                using just basic
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
            %li
              %p
                A
                %a{:href => "#InTermsOfACoend"} Description via Coends
                using
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
                tools.
          %h3#ElementaryDescription Elementary description
          %p
            The following is a description of the reconstruction in terms of elementary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
          #ElementaryReconstructionCoveringSpace.num_defn
            %h6#definition Definition
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
                  %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo ∈
                        %msup
                          %mi Set
                          %mrow
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \rho \in Set^{\Pi_1(X)}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
                  of its
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of all the sets appearing in this representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E(\rho) \;\coloneqq\;  \underset{x \in X}{\sqcup} \rho(x)
            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              which is
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
              and for which every element of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(U,x)
              becomes trivial under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(U,x) \to \pi_1(X,x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat x \in \rho(x)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
              consider the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                    %mo ≔
                    %mrow
                      %mo {
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mo ′
                      %mo ∈
                      %mi U
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mphantom
                        %mi A
                      %mi γ
                      %mspace{:width => "thinmathspace"}
                      %mtext path from
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mtext to
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mo ′
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_{U,\hat x}
                    \\coloneqq
                    \\left\{
                    \\rho(\gamma)(\hat x)
                    \\;\vert\;
                    x' \in U
                    \\,,\phantom{A}
                    \\gamma \,\text{path from}\, x \,\text{to}\, x'
                    \\right\}
                    \\;\subset\;
                    E(\rho)
                    \\,.
            %p
              The collection of these defines a
              %a.existingWikiWord{:href => "/nlab/show/base+for+a+topology"} base for a topology
              (prop.
              %a.maruku-ref{:href => "#ElementaryReconstructedCoveringSpaceWellDefined"}
              below). Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} \tau_{\rho}
              for the corresponding topology. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E(\rho), \tau_{\rho})
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo ∈
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E(\rho) &amp;\overset{p}{\longrightarrow}&amp; X
                    \\\
                    \\hat x \in \rho(x) &amp;\mapsto&amp; x
                    }
                    \\,.
            %p Finally, for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi ρ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; \rho_1 \longrightarrow \rho_2
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of permutation representations, there is the evident induced function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi Rec
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo ∈
                            %msub
                              %mi ρ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mi x
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %msub
                              %mi ρ
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E(\rho_1)
                    \&amp;\overset{Rec(f)}{\longrightarrow}&amp;
                    E(\rho_2)
                    \\\
                    (\hat x \in \rho_1(x)) &amp;\mapsto&amp; (f_x(\hat x) \in \rho_2(x))
                    }
                    \\,.
          #ElementaryReconstructedCoveringSpaceWellDefined.num_prop
            %h6#proposition Proposition
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ↦
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \mapsto E(\rho)
              in def.
              %a.maruku-ref{:href => "#ElementaryReconstructionCoveringSpace"}
              is well defined and yields a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Moreover, the construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \mapsto Rec(f)
              yields a homomorphism of covering spaces.
          .proof
            %h6#proof Proof
            %p
              First to see that we indeed have a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              = succeed ")" do
                %a{:href => "topological+base#Recognition"} this prop.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %span.newWikiWord
                semi-locally simply connected
                %a{:href => "/nlab/new/semi-locally+simplc+connected+space"} ?
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              such that every loop in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is contractible in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ′
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U'_x \subset U_x
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path connected
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ′
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U'_x
              based on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is contractible as a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \hat x \in E
              be any point over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %mi U
                          %msub
                            %mo ′
                            %mi x
                          %mo ,
                          %mi x
                    %annotation{:encoding => "application/x-tex"} V_{U'_x,x}
            %p The argument for the base open neighbourhoods contained in intersections is similar.
            %p
              Then we need to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E(\rho) \to X
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              = succeed ")," do
                %a{:href => "interactions+of+images+and+pre-images+with+unions+and+intersections#PreImagePreservesUnionsAndIntersections"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              that labels a base open, it is sufficient to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^{-1}(U)
              is a base open. But by the very assumption on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              from any point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
              to any other point in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              applied to these paths establishes a bijection of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo ×
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    p^{-1}(U)
                    \\;\simeq\;
                    \\underset{\hat x \in \rho(x)}{\sqcup} V_{U,\hat x}
                    \\;\simeq\;
                    U \times \rho(x)
                    \\,,
            %p
              thus exhibiting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^{-1}(U)
              as a union of base opens.
            %p
              Finally we need to see that this continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a covering projection, hence that every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              has a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi U
                      %mo ×
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^{-1}(U) \simeq U \times \rho(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              all whose loops are contractible in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E(\rho) \to X
              is a covering space. It remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rec(f) \colon E(\rho_1) \to E(\rho_2)
              is a homomorphism of covering spaces. Now by construction it is immediate that this is a function over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi Rec
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E(\rho_1) &amp;&amp; \overset{Rec(f)}{\longrightarrow}&amp;&amp; E(\rho_2)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; X
                    }
                    \\,.
            %p
              So it only remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rec(f)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %msub
                          %mi y
                          %mn 2
                        %mo ∈
                        %msub
                          %mi ρ
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_{U, y_2 \in \rho_2(x)}
              a base open of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ρ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E(\rho_2)
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              its pre-image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rec(f)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %msub
                          %mi y
                          %mn 2
                        %mo ∈
                        %msub
                          %mi ρ
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo ⊔
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                        %mo ∈
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi y
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %msub
                          %mi y
                          %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Rec(f)^{-1}(V_{U, y_2 \in \rho_2(x)})
                    \=
                    \\underset{y_1 \in f^{-1}(y_2)}{\sqcup} V_{U,y_1}
            %p and hence a union of base opens.
          %h3#InTermsOfACoend In terms of a coend
          %p
            The following is a description of the reconstruction functor in terms of tolls from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %p
            Given a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |B|
            be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            retopologized with the discrete topology, and consider the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of the
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi I
                %annotation{:encoding => "application/x-tex"} B^I
            to the
            %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} |
                    %mo ×
                    %mi B
                  %annotation{:encoding => "application/x-tex"} {\vert B \vert} \times B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Path
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi B
                            %mi I
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi pb
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi ev
                            %mn 0
                          %mo ,
                          %msub
                            %mi ev
                            %mn 1
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                          %mi B
                          %mo{:stretchy => "false"} |
                          %mo ×
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi id
                              %mo ×
                              %mi id
                        %mtd
                          %mi B
                          %mo ×
                          %mi B
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Path(B) &amp; \to &amp; B^I &amp; \\
                  \\downarrow &amp; (pb) &amp; \downarrow &amp; \langle ev_0, ev_1 \rangle\\
                  |B| \times B &amp; \underset{id \times id}{\to} &amp; B \times B &amp;
                  }
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B)
            be the
            %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Path
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Path(B)
            by the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            “
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            relative to the
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B)
            as a sum of spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                  %msub
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mi b
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \sum_{b \in B} \tilde{B}_b,
          %p
            fibered in the obvious way over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |B|
            (the set of all basepoints
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mi b
                %annotation{:encoding => "application/x-tex"} \tilde{B}_b
            is the space of paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            which begin at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mi b
                %annotation{:encoding => "application/x-tex"} \tilde{B}_b
            can be thought of the universal covering space over the connected component of a point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
          %p
            We have a
            %a.existingWikiWord{:href => "/nlab/show/span"} span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mover
                            %mi Path
                            %mo ¯
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                          %mi B
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; \overline{Path}(B) &amp; &amp; \\
                  \&amp; \swarrow &amp; &amp; \searrow &amp; \\
                  |B| &amp; &amp; &amp; &amp; B
                  }
          %p
            with an obvious (contravariant) composition action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi comp
                %annotation{:encoding => "application/x-tex"} comp
            of the fundamental groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(B)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} |
                          %mi B
                          %mo{:stretchy => "false"} |
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} |
                          %mi B
                          %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; \Pi_1(B) &amp; &amp; \\
                  \&amp; \swarrow &amp; &amp; \searrow &amp; \\
                  |B| &amp; &amp; &amp; &amp;  |B|
                  }
          %p
            with a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            structure in the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            gives a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi comp
                  %mo :
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} |
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} comp: \Pi_1(B) \times_{|B|} \overline{Path}(B) \to \overline{Path}(B),
          %p
            of spans from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |B|
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Now suppose given an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Set^{\Pi_1(B)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mn 1
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} F: 1 \to |B|
            equipped with an action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            of the monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \Pi_1(B): |B| \to |B|
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Span
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span(Top)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi comp
                %annotation{:encoding => "application/x-tex"} comp
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B)
            and the left-handed action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            gives rise to a two-sided
            %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} B(\overline{Path}(B), \Pi_1(B), F),
          %p
            which here is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            in the category of spans from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi F
                          %msub
                            %mo ×
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi B
                              %mo{:stretchy => "false"} |
                          %msub
                            %mi Π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi B
                              %mo{:stretchy => "false"} |
                          %mover
                            %mi Path
                            %mo ¯
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi F
                                %msub
                                  %mo ×
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %mi B
                                    %mo{:stretchy => "false"} |
                                %mi comp
                          %mo{:stretchy => "false"} ↓
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi α
                                %msub
                                  %mo ×
                                  %mrow
                                    %mo{:stretchy => "false"} |
                                    %mi B
                                    %mo{:stretchy => "false"} |
                                %mover
                                  %mi Path
                                  %mo ¯
                                %mo{:stretchy => "false"} (
                                %mi B
                                %mo{:stretchy => "false"} )
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mi F
                          %msub
                            %mo ×
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi B
                              %mo{:stretchy => "false"} |
                          %mover
                            %mi Path
                            %mo ¯
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; F \times_{|B|} \Pi_1(B) \times_{|B|} \overline{Path}(B) &amp;
                  \\\
                  \&amp;
                  {}^{\mathllap{F \times_{|B|} comp}}\downarrow \downarrow^{\mathrlap{\alpha \times_{|B|} \overline{Path}(B)}}
                  \&amp;
                  \\\
                  \&amp;
                  F \times_{|B|} \overline{Path}(B) &amp;
                  }
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
            of this pair provides a canonical augmentation of the two-sided bar construction, and may be called the tensor product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi F
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B) \otimes_{\Pi_1(B)} F
          %p
            (the seemingly opposite placement of the two tensor factors, as compared against the span constructions above, is simply an artifact of the discrepancy between
            %a.existingWikiWord{:href => "/nlab/show/diagrammatic+order"} diagrammatic order
            of composition, and the traditional order in which right actions are covariant and left actions contravariant).
          %p
            As a span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is
            %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo −
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi Cov
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B) \otimes_{\Pi_1(B)} -: Set^{\Pi_1(B)} \to Cov/B
          %p is under these conditions quasi-inverse to the fiber functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fiber
                  %mo :
                  %mi Cov
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fiber: Cov/B \to Set^{\Pi_1(B)}
          %p
            and thus establishes the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            known as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
          .un_remark
            %h6#remark Remark
            %p
              An abstract way of considering the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fiber
                  %annotation{:encoding => "application/x-tex"} Fiber
              is that it is obtained by homming:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fiber
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo :
                    %mi E
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi Cov
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ˜
                      %mi b
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fiber(p: E \to B)(b) = (Cov/B)(\tilde{B}_b, p)
            %p
              and this forces its
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to be given by the tensor product construction described above.
          %h2#examples Examples
          %h3#the_universal_covering_space The universal covering space
          %p
            As a special case, consider the
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \Pi_1(B) \to Set
            given by the discrete fibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cod
                  %mo :
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} cod: \Pi_1(B) \to |B|
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: shouldn’t such a discrete fibration then give rise to a functor
              = succeed "?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} |
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} |B| \to Set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mor(\Pi_1(B))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(B)
              on itself.
            %p
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"}> Todd Trimble
              \: I didn’t make myself clear then. Recall that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an internal category in a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} E = Set
              in this discussion), then one defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi C
                  %annotation{:encoding => "application/x-tex"} E^C
              by taking its objects to be internal discrete fibrations, defined as arrows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F \to C_0
              equipped with the data of an action by the internal category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} C_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F = Mor(\Pi_1(B))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |B|
              here means the underlying set of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: Yes, I see now.
          %p
            (as a span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |B|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(B)
            (as a span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |B|
            to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |B|
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mi cod
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B) \otimes_{\Pi_1(B)} cod,
          %p
            is a way of realizing the
            %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Here is a way of thinking of this construction which links it to the description of universal bundles by Roberts and Schreiber, which is based on considering tangent spaces of the fundamental groupoid. If the fundamental groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = \Pi_1(B)
            is connected, its universal bundle (as a fibration of groupoids) may be realized as the “tangent groupoid at
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi b
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} T_b(G) := (b/G) \to  G
          %p
            for a chosen basepoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} /
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi G
                            %mi I
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mi ev
                            %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} {
                          %mi b
                          %mo{:stretchy => "false"} }
                        %mtd
                          %mo →
                        %mtd
                          %mi G
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (b/G) &amp; \to &amp; G^I &amp; \\
                  \\downarrow &amp; &amp; \downarrow &amp; ev_0\\
                  \\{b\}  &amp; \to &amp; G &amp;
                  }
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            the groupoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mover
                      %mo →
                      %mo ∼
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0 \overset{\sim}{\to} 1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by the restriction of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} ev_1
          %p
            Since the set of arrows of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is obtained as a quotient of the set of paths in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi I
                  %annotation{:encoding => "application/x-tex"} B^I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 0
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"} G_0 = B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a topological groupoid. Then we recover the universal covering space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^{(1)}_b
            (I prefer this notation for the 1-connected cover, rather than the usual
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^{(n)}
            for
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            by pulling back along the functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B \to G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            as a topological groupoid with only identity arrows. The assumptions on the topology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %span.newWikiWord
              locally trivial groupoid
              %a{:href => "/nlab/new/locally+trivial+groupoid"} ?
            with discrete hom-spaces, which implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^{(1)}_b
            is a locally trivial bundle with discrete fibres. Local path-connectedness implies that it is locally trivial, and the local condition on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \pi_1
            holds if and only if the fibres are discrete - this last result is due to Daniel Bliss.
          .un_remark
            %h6#remark_2 Remark
            %p
              Another way to consider the topological conditions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is to realise that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is locally path-connected and semi-locally simply-connected. Otherwise one has to consider the pro-homotopy 1-type of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: Is there a prodiscrete completion of a topological groupoid? Maybe we need to assume it is locally trivial, so it is weakly equivalent (in the said localised 2-category) to a groupoid enriched in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
          %p
            In this analysis, the universal covering space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi b
                %annotation{:encoding => "application/x-tex"} E_b
            of (path-connected)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is retrieved as the quotient of the space of paths which start at the basepoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            takes a class of a path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            to its terminal point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(1)
            %em connected
            covering spaces
          %p
            More generally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊂
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} S \subset |B|
            is a set of basepoints (Thanks, Ronnie Brown! - DR), we can form the pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} /
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi G
                            %mi I
                        %mtd
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mi ev
                            %mn 0
                      %mtr
                        %mtd
                          %mi S
                        %mtd
                          %mo →
                        %mtd
                          %mi G
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (S/G) &amp; \to &amp; G^I &amp; \\
                  \\downarrow &amp; &amp; \downarrow &amp; ev_0\\
                  S  &amp; \to &amp; G &amp;
                  }
          %p
            which is again a groupoid over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            by restriction of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ev
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} ev_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} (S/G) \to G
            along the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} B \to G
            is a covering space which is the sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo ∈
                      %mi S
                  %msubsup
                    %mi B
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  B^{(1)}\langle S\rangle = \sum_{b\in S} B^{(1)}_b
          %p
            of connected, 1-connected covering spaces based at the points in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            such that it intersects each component of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            once we can get a universal covering space of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (universal among covering spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} E \to B
            that induce isomophisms
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_0(E) \to \Pi_0(B)
          %p
            This construction is functorlal (for general
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} S\subset |B|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ′
                  %mo ,
                  %mi S
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,S) \to (B',S')
            of pairs (remember we are giving
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ,
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S,S'
            the discrete topology, not the subspace topology) induces a functor of (topological) groupoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(B) \to \Pi_1(B')
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi B
                  %msup
                    %mo ′
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo ′
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  B^{(1)}\langle S\rangle \to B'^{(1)}\langle S'\rangle
          %p
            covering the given map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} B \to B'
          %p
            The dependence on basepoints is of course spurious; we can make this explicit by considering the colimit obtained by pasting together the universal covering spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^{(1)}_b
            along isomorphisms induced by paths
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} b \to c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B)
            is precisely the sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi c
                      %mo ∈
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} |
                  %msubsup
                    %mi B
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{c \in |B|} B^{(1)}_c
          %p
            which can be viewed as a topological span from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |B|
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Path
                    %mo ¯
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi cod
                  %mo :
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \overline{Path}(B) \otimes_{\Pi_1(B)} (cod: \Pi_1(B) \to |B|)
          %p is the same thing as the coequalizer of the pair of arrows
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ϕ
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi b
                      %mo →
                      %mi c
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi c
                  %msubsup
                    %mi B
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi c
                  %msubsup
                    %mi B
                    %mi c
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{[\phi]: b \to c} \sum_c B^{(1)}_c \overset{\to}{\to} \sum_c B^{(1)}_c
          %p
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} /
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Top/B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟨
                  %mi S
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} B^{(1)}\langle S\rangle
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            has one point in each component of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: I think, though, due to the lifting theorems for covering spaces, that given a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f:B \to B'
              and basepoint sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mo{:stretchy => "false"} |
                      %mi B
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} S \subset |B|
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ′
                    %mo ⊂
                    %mo{:stretchy => "false"} |
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} S' \subset |B'|
              that are not necessarily preserved by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi S
                    %mo{:stretchy => "false"} ⟩
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} B^{(1)}\langle S\rangle \to B'
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msup
                      %mo ′
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi S
                    %mo ′
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} B'^{(1)}\langle S'\rangle
              anyway. This would also make this construction independent, up isomorphism, of the choice of basepoints and probably also functorial.
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: It won’t be functorial - the lift referred to isn’t unique. The up-to-isomorphism is a non-canonical isomorphism.
          %p (David or Urs: please feel free to sprinkle your own sugar over this, by adapting or even copying what David wrote below based on your paper.)
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
            \: unless someone feels the discussion below is essential, it can be deleted.)
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
              \: My personal favourite way of doing this is to topologise the fundamental groupoid, then form the following strict pullback of topological groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi B
                              %mo ˜
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi T
                              %mi b
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde{B} &amp; \to &amp; T_b\Pi_1(B) \\
                    \\downarrow &amp;&amp; \downarrow\\
                    B &amp; \to &amp;\Pi_1(B)
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b\in B
              is a chosen basepoint and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi b
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T_b\Pi(B)
              is the tangent groupoid at the object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
            %p
              The topology on the fundamental groupoid can either be constructed with the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is locally path-connected and semi-locally simply-connected, or be given the quotient topology from the free path space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi I
                    %annotation{:encoding => "application/x-tex"} B^I
              = succeed "s)" do
                %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              satisfies the usual conditions for the universal covering space to exist. Thus even when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(B)
              is topologised, it still represents a 1-type for nice
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              the topologised fundamental groupoid can be considered as a pro-homotopy type, that is, the limit of discrete groupoids, taken in the appropriate (bi)category of topological groupoids.
            %p I would like see several expositions of the construction of the universal covering space, since they illustrate different ideas. They seem tautologously related, but things show a bit more of the differences when one passes to bigroupoids.
            %p The universal covering space is
            %ul
              %li
                %p the source-fibre (at a basepoint) of the topologised fundamental groupoid
              %li
                %p the pullback of the tangent groupoid as described above
              %li
                %p
                  The pullback of the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (s,t):Mor(\Pi_1(B)) \to Obj(B)\times Obj(B)
                  along the inclusion
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi b
                        %mo{:stretchy => "false"} }
                        %mo ×
                        %mi B
                        %mo →
                        %mi B
                        %mo ×
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \{b\}\times B \to B\times B
            %p
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd
              I’ll get back to writing more of what I had planned soon. I haven’t had a chance to digest what you’re writing yet, but I prefer to proceed without having to choose basepoints. I’d like to get you and Urs to have a look though when I get back to this within a few days.
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David
              \: Of course - hence the theorem about functors from the fundamental groupoid and not the fundamental group. This is where the full tangent groupoid comes in: it is the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi TG
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi G
                              %mi I
                          %mtd
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mi dom
                        %mtr
                          %mtd
                            %mi Obj
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    TG &amp; \to &amp; G^I &amp; \\
                    \\downarrow &amp;&amp; \downarrow&amp; dom\\
                    Obj(G) &amp; \to &amp; G &amp;
                    }
            %p
              or equivalently the slice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ↓
                    %msub
                      %mi id
                      %mi G
                  %annotation{:encoding => "application/x-tex"} Obj(G)\downarrow id_G
              for an internal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (internal in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is just the subgroupoid of this gotten by pulling back
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TG
                    %mo →
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} TG \to Obj(G)
              along the inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi g
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \{g\} \to Obj(G)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Obj(G)
        .revisedby
