            %p
              We claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi s
                    %mi p
                    %mo :
                    %mi P
                    %mo →
                    %msub
                      %mi A
                      %mi y
                  %annotation{:encoding => "application/x-tex"} A_s p : P \to A_y
              is an inverse of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi s
                      %mi p
                      %mi ϕ
                      %mo =
                      %msub
                        %mi A
                        %mi s
                      %msub
                        %mi A
                        %mi f
                      %mo =
                      %msub
                        %mi A
                        %mrow
                          %mi f
                          %mi s
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} A_s p \phi = A_s A_f = A_{f s} = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %msub
                      %mi A
                      %mi s
                    %mi p
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi A_s p = 1
              it suffices to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi ϕ
                    %msub
                      %mi A
                      %mi s
                    %mi p
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p \phi A_s p = p
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mi ϕ
                      %msub
                        %mi A
                        %mi s
                      %mi p
                      %mo =
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q \phi A_s p = q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \mu_x
              is monic, it suffices to show
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi x
                      %mi p
                      %mi ϕ
                      %msub
                        %mi A
                        %mi s
                      %mi p
                      %mo =
                      %msub
                        %mi μ
                        %mi x
                      %mi p
