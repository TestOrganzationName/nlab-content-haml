                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi x
                      %mi p
                      %mo =
                      %msub
                        %mi B
                        %mi f
                      %mi q
                    %annotation{:encoding => "application/x-tex"} \mu_x p = B_f q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
