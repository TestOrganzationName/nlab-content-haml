                    %mi q
                    %mo =
                    %mi q
                    %mo .
                  %annotation{:encoding => "application/x-tex"} q \phi A_s p = \mu_y A_s p = B_s \mu_x p = B_s B_f q = B_{f s} q = q.
          #LatchSub.num_lemma
            %h6#lemma_3 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be elegant,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              a category with pullback-stable colimits, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mu:A\to B
              a monomorphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mrow
                          %msup
                            %mi R
                            %mi{:mathvariant => "normal"} op
                    %annotation{:encoding => "application/x-tex"} M^{R^{\mathrm{op}}}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} x\in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x
              denotes the Reedy latching object at
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi x
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mi x
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi L
                                  %mi x
                                %mi μ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi μ
                                  %mi x
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi x
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi B
                              %mi x
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ L_x A &amp; \to &amp; A_x \\
                    {}^{L_x \mu}\downarrow &amp; &amp; \downarrow^{\mu_x} \\
                    L_x B &amp; \to &amp; B_x.  }
          .proof
            %h6#proof_4 Proof
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi B
                    %mo →
                    %msub
                      %mi B
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x B \to B_x
              is by definition the colimit in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi x
                  %annotation{:encoding => "application/x-tex"} M/B_x
              of a diagram whose objects are morphisms of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi f
                      %mo :
                      %msub
                        %mi B
                        %mi y
                      %mo →
                      %msub
                        %mi B
                        %mi x
                    %annotation{:encoding => "application/x-tex"} B_f : B_y \to B_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              a codegeneracy. By the Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#DegSub"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \mu_x
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi f
                      %mo :
                      %msub
                        %mi A
                        %mi y
                      %mo →
                      %msub
                        %mi A
                        %mi x
                    %annotation{:encoding => "application/x-tex"} A_f : A_y \to A_x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi x
                      %mi A
                      %mo →
                      %msub
                        %mi A
                        %mi x
                    %annotation{:encoding => "application/x-tex"} L_x A \to A_x
          %h3#all_presheaves_are_reedy_monomorphic All presheaves are “Reedy monomorphic”
          #ReedyCofibrant.num_lemma
            %h6#lemma_4 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be elegant and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitary-coherent+category"} infinitary-coherent category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x\in R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msup
                        %mi M
                        %mrow
                          %msup
                            %mi R
                            %mi{:mathvariant => "normal"} op
                    %annotation{:encoding => "application/x-tex"} A\in M^{R^{\mathrm{op}}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi A
                    %mo →
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x A \to A_x
              is a monomorphism.
          .proof
            %h6#proof_5 Proof
            %p
              We use the terminology from the page
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-ary+exact+category"} ∞-ary exact category
              %a.existingWikiWord{:href => "/nlab/show/sink"} sink
              with target
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} A_x
              consisting of all morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi f
                    %mo :
                    %msub
                      %mi A
                      %mi y
                    %mo →
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} A_f : A_y \to A_x
              indexed by nonidentity codegeneracies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with domain
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f:x\to y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f':x\to y'
              there is an absolute pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi y
                    %mo →
                    %mi z
                  %annotation{:encoding => "application/x-tex"} g:y\to z
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo :
                      %mi y
                      %mo ′
                      %mo →
                      %mi z
                    %annotation{:encoding => "application/x-tex"} g':y'\to z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi z
                  %annotation{:encoding => "application/x-tex"} A_z
              is the pullback
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi y
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi A
                            %mi x
                      %msub
                        %mi A
                        %mi y
                    %annotation{:encoding => "application/x-tex"} A_y \times_{A_x} A_y
              %em kernel
              of this sink.
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi A
                  %annotation{:encoding => "application/x-tex"} L_x A
              is the colimit of the diagram whose objects are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi y
                  %annotation{:encoding => "application/x-tex"} A_y
              indexed by such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f:x\to y
              and whose morphisms are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi g
                    %mo :
                    %msub
                      %mi A
                      %mrow
                        %mi y
                        %mo ′
                    %mo →
                    %msub
                      %mi A
                      %mi y
                  %annotation{:encoding => "application/x-tex"} A_g: A_{y'} \to A_{y}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi y
                    %mo →
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g:y\to y'
              a codegeneracy with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi f
                      %mo =
                      %mi f
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g f = f'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi y
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} A_{y'}
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi z
                    %annotation{:encoding => "application/x-tex"} A_z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is the absolute pushout of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi A
                  %annotation{:encoding => "application/x-tex"} L_x A
              is the quotient of the above kernel.
            %p
              However, in any infinitary-regular category, the quotient of the kernel of a sink is exactly the extremal-epic / monic factorization of that sink. Therefore, the induced map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi A
                    %mo →
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x A \to A_x
              is monic.
          %h3#reedy__injective Reedy = injective
          #RelativeLatching.num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is elegant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x\in R
              and monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mu:A\to B
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mrow
                          %msup
                            %mi R
                            %mi{:mathvariant => "normal"} op
                    %annotation{:encoding => "application/x-tex"} M^{R^{\mathrm{op}}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi B
                    %msub
                      %mo ⊔
                      %mrow
                        %msub
                          %mi L
                          %mi x
                        %mi A
                    %msub
                      %mi A
                      %mi x
                    %mo →
                    %msub
                      %mi B
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x B \sqcup_{L_x A} A_x \to B_x
              is monic.
          .proof
            %h6#proof_6 Proof
            %p
              Since Grothendieck toposes are infinitary-coherent, by Lemma
              %a.maruku-ref{:href => "#ReedyCofibrant"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi B
                    %mo →
                    %msub
                      %mi B
                      %mi x
                  %annotation{:encoding => "application/x-tex"} L_x B\to B_x
              is monic. By assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                    %mo →
                    %msub
                      %mi B
                      %mi x
                  %annotation{:encoding => "application/x-tex"} A_x \to B_x
              is monic. And since Grothendieck toposes have pullback-stable colimits, by Lemma
              %a.maruku-ref{:href => "#LatchSub"}
              the square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi x
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mi x
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi L
                                  %mi x
                                %mi μ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi μ
                                  %mi x
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi x
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi B
                              %mi x
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ L_x A &amp; \to &amp; A_x \\
                    {}^{L_x \mu}\downarrow &amp; &amp; \downarrow^{\mu_x} \\
                    L_x B &amp; \to &amp; B_x.  }
            %p
              is a pullback. In other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi A
                  %annotation{:encoding => "application/x-tex"} L_x A
              is the
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of the subobjects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi x
                    %mi B
                  %annotation{:encoding => "application/x-tex"} L_x B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                  %annotation{:encoding => "application/x-tex"} A_x
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi x
                    %annotation{:encoding => "application/x-tex"} B_x
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coherent+category"} coherent category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/union"} union
          #ReedyIsInjective.un_cor
            %h6#corollary_2 Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is elegant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cisinski+model+category"} Cisinski model category
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mrow
                        %msup
                          %mi R
                          %mi{:mathvariant => "normal"} op
                  %annotation{:encoding => "application/x-tex"} M^{R^{\mathrm{op}}}
              coincides with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+model+structure"} injective model structure
          .proof
            %h6#proof_7 Proof
            %p
              By definition, they have the same
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              = succeed "." do
                %a.maruku-ref{:href => "#RelativeLatching"}
          %p
            The most common application is when
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mi SSet
                  %annotation{:encoding => "application/x-tex"} M = SSet
          %h2#examples Examples
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                is an elegant Reedy category.
            %li
              %p
                Joyal’s
                %a.existingWikiWord{:href => "/nlab/show/Theta+category"} disk categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Θ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Theta_n
                are elegant Reedy categories.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/direct+category"} direct category
                is a Reedy category with no degeneracies, hence trivially an elegant one.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is any presheaf on an elegant Reedy category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi el
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (el X)^{op}
                is again an elegant Reedy category. This is fairly easy to see from the fact that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %mi el
                          %mi X
                    %annotation{:encoding => "application/x-tex"} Set^{el X}
                is equivalent to the slice category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Set
                          %mrow
                            %msup
                              %mi R
                              %mi op
                        %mo{:stretchy => "false"} /
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Set^{R^{op}}/X
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/EZ-Reedy+category"} EZ-Reedy category
                that is a strict Reedy category is elegant.
          %p
            Note that unlike the notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is elegant then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mi op
                %annotation{:encoding => "application/x-tex"} R^{op}
            will not generally be elegant.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"}> generalized Reedy category
                ,
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+category"} Eilenberg-Zilber category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
          %h2#references References
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Julie+Bergner"} Julie Bergner
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
              = succeed "," do
                %em
                  Reedy categories and the
                  = succeed "-construction" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Θ
                        %annotation{:encoding => "application/x-tex"} \Theta
              %a{:href => "http://arxiv.org/abs/1110.1066"} arXiv:1110.1066
          %p
            Elegant Reedy categories are useful to model
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#Shulman12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
                ,
                %em The univalence axiom for elegant Reedy presheaves
                (
                %a{:href => "http://arxiv.org/abs/1307.6248"}> arXiv:1307.6248
                )
            %li#Shulman12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"}> Michael Shulman
                ,
                = succeed "," do
                  %em Univalence for inverse diagrams and homotopy canonicity
                %em From type theory and homotopy theory to Univalent Foundations of Mathematics
                ) June 2015 (
                %a{:href => "https://arxiv.org/abs/1203.3253"}> arXiv:1203.3253
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/S0960129514000565"} doi:/10.1017/S0960129514000565
            %li
              %p
                Benno van den Berg and Ieke Moerdijk,
                = succeed "," do
                  %em W-types in homotopy type theory
                %a{:href => "http://www.staff.science.uu.nl/~berg0002/papers/WinHoTT.pdf"} PDF
        .revisedby
