                      %mi μ
                      %mi x
                    %mi p
                    %mo =
                    %msub
                      %mi μ
                      %mi x
                    %mi p
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mu_x p \phi A_s p = B_f q \phi A_s p = B_f \mu_y A_s p = B_f B_s \mu_x p = B_{f s} \mu_x p = \mu_x p.
            %p And for the second, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
