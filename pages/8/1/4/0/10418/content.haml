            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
                              %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi V
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi τ
