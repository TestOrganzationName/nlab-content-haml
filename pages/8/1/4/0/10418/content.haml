                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi G
                            %mstyle{:mathvariant => "bold"}
                              %mi Struct
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tau_U
                    \\\
