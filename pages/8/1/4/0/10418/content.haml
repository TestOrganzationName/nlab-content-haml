                    \\\
                    \\tau_V &amp;&amp; \swArrow_{\mathrlap{\simeq}}  &amp;&amp; \tau_X
                    \\\
                    \&amp; {}_{\mathllap{\mathbf{c}_0}}\searrow &amp;&amp; \swarrow_{\mathrlap{\mathbf{c}}}
                    \\\
                    \&amp;&amp; G\mathbf{Struct}
                    }
            %p
              On the other hand,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              is called
