                  %annotation{:encoding => "application/x-tex"} G_2 \to GL(7)
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-structure"} G₂-structure
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
            vanishes if the corresponding definite 3-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is
            %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariantly constant
            with respect to the induced
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-manifold"} G₂-manifold
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
