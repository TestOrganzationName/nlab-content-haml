                    \\flat^{rel} U \longrightarrow U
            %p
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relative+flat+modality"} relative flat modality
              = succeed ":" do
                %a.maruku-ref{:href => "#InducedRelativeShapeAndFlat"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
