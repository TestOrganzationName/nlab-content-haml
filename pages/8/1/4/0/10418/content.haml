                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \longrightarrow&amp;&amp;  \mathbf{B}G
                    \\\
                    \&amp; {}_{\mathllap{\tau_X}}\searrow &amp;&amp; \swarrow_{\mathrlap{G\mathbf{Struc}}}
