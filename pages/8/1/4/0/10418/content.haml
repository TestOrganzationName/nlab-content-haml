                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              As before, if the given
              %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
              encodes order-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              infinitesimals, then the infinitesimal integrability in def.
              %a.maruku-ref{:href => "#IntegrableGStructure"}
              is order-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              integrability. For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              this is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion-freeness
          %h2#properties Properties
          %h3#existence_and_torsion Existence and torsion
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            for a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
          %h3#in_terms_of_adapted_coordinate_systems In terms of adapted coordinate systems
          %p
            A
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is integrable previsely if there exists an
            %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
            %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            with the property that their canonical
            %a.existingWikiWord{:href => "/nlab/show/frame+fields"} frame fields
            are
            = succeed "-frames." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            (
            %a{:href => "#Sternberg64"}> Sternberg 64, section VII, exercise 2.1
            )
          %h2#Examples Examples
          %ul
            %li
              %p
                %a{:href => "#ExampleComplexStructure"} Complex structure
            %li
              %p
                %a{:href => "#ExampleSymplecticStructure"} Symplectic structire
            %li
              %p
                %a{:href => "#ExamplesOrthogonalStructure"} Orthogonal structure
            %li
              %p
                %a{:href => "#ExampleG2Structure"} G₂-structure
          %h3#ExampleComplexStructure Complex structure
          %p
            A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(n,\mathbb{C}) \to GL(2n,\mathbb{R})
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
            is an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
            vanishes precisely if its
            %a.existingWikiWord{:href => "/nlab/show/Nijenhuis+tensor"} Nijenhuis tensor
            vanishes, hence, by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Newlander-Nirenberg+theorem"} Newlander-Nirenberg theorem
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            admits holomorphic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
          %h3#ExampleSymplecticStructure Symplectic structure
          %p
            An
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(n) \hookrightarrow GL(2n)
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
            is an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/almost+symplectic+structure"} almost symplectic structure
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
            is the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \mathbf{d}\omega
            of the corresponding 2-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            (recalled e.g. in
            = succeed ")." do
              %a{:href => "symplectic+manifold#AlbuquerquePicken11"} Albuquerque-Picken 11
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
            %a.existingWikiWord{:href => "/nlab/show/Darboux+theorem"} Darboux theorem
            asserts that this is already a fully integrable structure.
          %h3#ExamplesOrthogonalStructure Orthogonal structure
          %p
            An
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)\to GL(n)
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} structure
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+Riemannian+geometry"} fundamental theorem of Riemannian geometry
            says that in this case the
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
            vanishes, exhibited by the existence of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
            %a.existingWikiWord{:href => "/nlab/show/Riemann+normal+coordinates"} Riemann normal coordinates
            (since these identify the given
            %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
            at any point to first order with the trivial (identity) vielbein). The higher order obstructions to integrability turn out to all be proportional to combinations of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+curvature"} Riemann curvature
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
          %h3#UnitaryStructure Unitary structure
          %p The case of unitary structure is precisely the combination of the above three cases.
          %p
            By the fact (see at
            = succeed ")" do
              %em
                %a{:href => "unitary+group#RelationToOrthogonalSymplecticAndGeneralLinearGroup"} unitary group – relation to orthogonal, symplectic and general linear group
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            is the intersection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %munder
                    %mo ×
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %munder
                    %mo ×
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U(n) \simeq O(2n) \underset{GL(2n,\mathbb{R})}{\times} Sp(2n,\mathbb{R}) \underset{GL(2n,\mathbb{R})}{\times} GL(n,\mathbb{C})
          %p
            a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n) \hookrightarrow GL(2n,\mathbb{R})
            %em
              %a.existingWikiWord{:href => "/nlab/show/almost+Hermitian+structure"} almost Hermitian structure
            – is precisely a joint
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
            %a.existingWikiWord{:href => "/nlab/show/almost+symplectic+structure"} almost symplectic structure
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
            structure – this is precisely a joint
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            structure,
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            structure,
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            structure.
