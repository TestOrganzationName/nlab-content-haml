          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong
                point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                of a
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi Set
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi x
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi x
                            %mo *
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    x : Set \stackrel{\overset{x^*}{\leftarrow}}{\underset{x_*}{\to}} E
            %p
              from the base topos
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} A \in E
              an object, its
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} x^* A \in Set
              under such a point is called the
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is given by an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
              we say that it is an
              %strong essential point
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          .num_remark
            %h6#remark Remark
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in the category
              %a.existingWikiWord{:href => "/nlab/show/Topos"} GrothendieckTopos
              of
              = succeed "es," do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              this is a
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              of the topos.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Set = Sh(*)
              is the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              on the one-point
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
              (under
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/localic+reflection"} localic reflection
          #EnoughPoints.num_defn
            %h6#definition_3 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              is said to have
              %strong enough points
              if isomorphy can be tested
              = succeed "wise," do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              functors from all of its points are jointly
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
            %p
              More explicity:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has enough points if for any morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f : A \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/stalks"} stalks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mo *
                    %mi f
                    %mo :
                    %msup
                      %mi p
                      %mo *
                    %mi A
                    %mo →
                    %msup
                      %mi p
                      %mo *
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p^* f : p^* A \to p^* B
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              itself is an isomorphism.
          %h2#properties Properties
          %h3#in_presheaf_toposes In presheaf toposes
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C^{op}, Set]
              are the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functor
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} C \to Set
            %p
              there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                      %mover
                        %mo ←
                        %mrow
                    %mi FlatFunc
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Topos(Set, [C^{op}, Set])
                    \\stackrel{\overset{}{\leftarrow}}{\underset{}{\to}}
                    FlatFunc(C,Set)
                    \\,.
          %p
            This appears for instance as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, theorem VII.5.2
            ).
          %h3#in_localic_sheaf_toposes In localic sheaf toposes
          %p
            For the special case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E = Sh(X)
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            on a
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            of a
            %a.existingWikiWord{:href => "/nlab/show/sober+topological+space"} sober
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the notion of topos points comes from the ordinary notion of points of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p For notice that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo =
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Set = Sh(*)
                is simply the
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                of
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
                on a one-
                %a.existingWikiWord{:href => "/nlab/show/point"} point
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f : Sh(Y) \to Sh(X)
                between
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} sheaf topoi
                are in a bijection with continuous functions of topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f : Y \to X
                (denoted by the same letter, by convenient abuse of notation); for this to hold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                needs to be sober.
          %p
            It follows that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E = Sh(X)
            points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            in the sense of points of topoi are in bijection with the ordinary points of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The action of the
            %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mo *
                  %mo :
                  %mi Set
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x_* : Set \to Sh(X)
            and the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mo *
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} x^* : Sh(X) \to Set
            of a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi Set
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x : Set \to Sh(X)
            of a sheaf topos have special interpretation and relevance:
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                of a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                under the point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x : {*} \to X
                is, by definition of
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                the sheaf
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ⊂
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi S
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi S
                              %mtd
                                %mtext if
                                %mi x
                                %mo ∈
                                %mi U
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mtext otherwise
                    %annotation{:encoding => "application/x-tex"}
                      x_*(S) : (U \subset X) \mapsto S(x^{-1}(U)) =
                      \\left\{
                      \\array{
                      S &amp; \text{ if } x \in U
                      \\\
                      {*} &amp; \text{otherwise}
                      }
                      \\right.
              %p
                This is the
                %a.existingWikiWord{:href => "/nlab/show/skyscraper+sheaf"} skyscraper sheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi skysc
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} skysc_x(S)
                with value
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                supported at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                with the unique sheaf on the point it defines. Notice that
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi ∅
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi pt
                      %annotation{:encoding => "application/x-tex"} S(\emptyset) = pt
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                of a sheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                under the point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x : {*} \to X
                is by definition of
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                (see the
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                formula discussed there), the set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msup
                                %mi x
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %msub
                                %mi colim
                                %mrow
                                  %mo *
                                  %mo →
                                  %msup
                                    %mi x
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi V
                                  %mo{:stretchy => "false"} )
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msub
                                %mi colim
                                %mrow
                                  %mi V
                                  %mo ⊂
                                  %mi X
                                  %mo{:stretchy => "false"} |
                                  %mi x
                                  %mo ∈
                                  %mi V
                              %mi A
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      x^*(A) &amp; =
                      colim_{{*} \to x^{-1}(V)} A(V)
                      \\\
                      \&amp;=
                      colim_{V\subset X| x \in V} A(V)
                      \\end{aligned}
                      \\,.
              %p
                This is the
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                at the point
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi stalk
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x^*(-) = stalk_x(-)
                      \\,.
          %p
            By definition of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to forming the skyscraper sheaf at
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %mi Set
                %annotation{:encoding => "application/x-tex"} S \in Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in Sh(X)
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi Set
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi stalk
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi skysc
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_{Set}(stalk_x(A), S) \simeq
                  Hom_{Sh(X)}(A, skysc_x(S))
                  \\,.
          %p
            Note that the observation that the points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X)
            are in bijection with the points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            actually factors over an intermediate concept, namely that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+locale"} points of a locale
            %a.existingWikiWord{:href => "/nlab/show/topological+locale"} spatial
            or not), its locale-theoretic points correspond to the points of its induced sheaf topos.
          %h3#in_sheaf_toposes In sheaf toposes
          %p
            The following characterization of points in
            %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
            a special case of the general statements at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Site
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Topos(Set, Sh(C))
                    \\simeq
                    Site(C,Set)
                    \\,.
            %p
              (Morphisms of sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C\to Set
              are precisely the
              %a.existingWikiWord{:href => "/nlab/show/cover-preserving+functor"} continuous
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/flat+functors"} flat functors
          %p
            This appears for instance as (
            %a{:href => "#MacLaneMoerdijk"}> MacLaneMoerdijk, corollary VII.5.4
            ).
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              with enough points (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#EnoughPoints"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              of points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              which are jointly conservative, and therefore a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} Set/X \to E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjective+geometric+morphism"} surjective
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, Lemma C2.2.11, C2.2.12
            ).
          %p (In general, of course, a topos can have a proper class of non-isomorphic points.)
          .num_prop
            %h6#proposition_4 Proposition
            %p
              A Grothendieck topos has enough points (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EnoughPoints"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ionad"} ionad
          %h3#in_classifying_toposes In classifying toposes
          %p
            From the above it follows that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            of a
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the same as a
            %a.existingWikiWord{:href => "/nlab/show/model"} model
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h3#of_toposes_with_enough_points Of toposes with enough points
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has
              %em enough points
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EnoughPoints"}
            %ul
              %li
                %p
                  there exists a
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                  and
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} intrinsic cohomology
                  and
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28infinity%2C1%29-topos"} intrinsic homotopy theory
                  of the topos;
              %li
                %p
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is the category of
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant
                  objects in the
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sh(X)
                  with respect to some groupoid action on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
          %p
            This is due to (
            %a{:href => "#Butz"}> Butz
            ) and (
            %a{:href => "#Moerdijk"}> Moerdijk
            ).
          %h2#examples Examples
          %h3#general General
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} topos of sheaves
                on (the
                %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                of)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                has enough points (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#EnoughPoints"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %li
              %p
                Points of
                %a.existingWikiWord{:href => "/nlab/show/over-toposes"} over-toposes
                are discussed at
                = succeed "." do
                  %a{:href => "http://ncatlab.org/nlab/show/over-topos#Points"} over topos – points
          %h3#Rings Rings and algebraic theories
          %p
            The category of points of the presheaf topos over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ring
                      %mi fp
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Ring_{fp}^{op}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/flat+functors"} flat functors
          %h3#of_a_local_topos Of a local topos
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo ⊣
                  %mi Γ
                  %mo ⊣
                  %mi coDisc
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi E
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} (\Delta \dashv \Gamma \dashv coDisc) : E \to Set
            has a canonical point,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Set
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc) : Set \to E
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            in the category of all points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (see
            %em
              %a{:href => "local+geometric+morphism#EquivalentCharacterizations"} Equivalent characterizations
            at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
          %h3#over_cohesive_sites
            Over
            = succeed "-cohesive" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                Let
                %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                version of the category of smooth manifolds (for instance take it to be the category of manifolds embedded in
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^\infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Diff
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(Diff)
                has precisely one point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} p_n
                per natural number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                , corresponding to the
                = succeed "-ball:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
                of a sheaf on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Diff
                    %annotation{:encoding => "application/x-tex"} Diff
                at that point is the colimit over the result of evaluating the sheaf on all
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %p
                This is discussed for instance in (
                %a{:href => "#Dugger"}> Dugger, p. 36
                ) in the context of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
          %h3#toposes_with_enough_points Toposes with enough points
          %p
            The following classes of topos have enough points (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#EnoughPoints"}
          %ul
            %li
              %p
                every
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/coherent+topos"} coherent topos
                (due to the
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/Deligne+completeness+theorem"} Deligne completeness theorem
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/Galois+topos"} Galois topos
                (see (
                %a{:href => "#Zoghaib"}> Zoghaib
                )).
          %h3#toposes_without_points Toposes without points
          %p
            In contrast with point-set topology where non empty spaces tautologically have points there are non trivial toposes lacking points just like in pointfree topology there are nontrivial
            %a.existingWikiWord{:href => "/nlab/show/locale"} locales
            without points. From a logical perspective these toposes correspond to consistent
            %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theories
            lacking models in Set. Classical examples are provided by toposes of sheaves on complete atomless Boolean algebras (see Barr (
            %a{:href => "#Barr74"}> 1974
            ) or for an example due to
            %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Deligne
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+locale"} topological locale
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+locale"} point of a locale
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/point+of+an+%28infinity%2C1%29-topos"} point of an (infinity,1)-topos
          %h2#references References
          %p Textbook references are section 7.5 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
          %p as well as section C2.2 of
          %ul#Johnstone
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p In
          %ul#Butz
            %li
              Carsten Butz,
              %em Logical and cohomological aspects of the space of points of a topos
              (
              %a{:href => "http://www.academia.edu/9139781/Logical_and_Cohomological_Aspects_of_the_Space_of_Points_of_a_Topos"}> web
              )
          %p
            is a discussion of how for every topos with enough points there is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            whose
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            is related to the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} intrinsic cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+in+an+%28infinity%2C1%29-topos"} intrinsic homotopy theory
            of the topos.
          %p More on this is in
          %ul#Moerdijk
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
              ,
              %em Classifying spaces for toposes with enough points
              , Milan Journal of Mathematics Volume 66, Number 1, 377-389
          %p See also
          %ul#Zoghaib
            %li
              Sam Zoghaib,
              %em A few points in topos theory
              (
              %a{:href => "http://www.normalesup.org/~zoghaib/math/points-tt.pdf"}> pdf
              )
          %p
            Points of the sheaf topos over the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
          %ul#Dugger
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dan+Dugger"}> Dan Dugger
              ,
              %em Sheaves and homotopy theory
              (
              %a{:href => "http://www.uoregon.edu/~ddugger/cech.html"}> web
              ,
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/files/cech.pdf"} pdf
          %p Toposes without points are discused in the homonymous paper
          %ul
            %li#Barr74
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %em Toposes without points
              %strong 5
              (1974) 265-280 &amp;lbrack;
              %a{:href => "https://www.math.mcgill.ca/barr/papers/top.no.pt.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Barr-ToposesWithoutPoints.pdf", :title => "pdf"} pdf
