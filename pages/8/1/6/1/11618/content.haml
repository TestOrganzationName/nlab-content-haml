                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            be the type of pointed fibrant types that are merely equal to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Bool
                  %annotation{:encoding => "application/x-tex"} Bool
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi F
                      %mo{:stretchy => "false"} )
                  %mi A
                  %mo .
                %annotation{:encoding => "application/x-tex"} I = \sum_{(A:U_F)} A.
          %p
            Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi zero
                  %mo ,
                  %mi one
                  %mo :
                  %mi I
                %annotation{:encoding => "application/x-tex"} zero,one:I
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi zero
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Bool
                  %mo ,
                  %mi false
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} zero = (Bool,false)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi one
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Bool
                  %mo ,
                  %mi true
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} one = (Bool,true)
          %p
            Then we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Paths
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo ,
                    %mi one
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Paths(zero,one)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi Paths
                  %mo{:stretchy => "false"} (
                  %mi Bool
                  %mo ,
                  %mi Bool
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p:Paths(Bool,Bool)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi false
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi true
                  %annotation{:encoding => "application/x-tex"} p_*(false) = true
          %p
            However, if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi Id
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo ,
                    %mi one
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e:Id(zero,one)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi apd
                %annotation{:encoding => "application/x-tex"} apd
            for strict equality, we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi false
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi true
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Id(q_*(false),true)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            is the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            under the map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi proj
                      %mn 1
                    %mo :
                    %mi I
                    %mo →
                    %msub
                      %mi U
                      %mi F
                  %annotation{:encoding => "application/x-tex"} proj_1:I \to U_F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi false
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi false
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Id(q_*(false),false)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo{:stretchy => "false"} (
                    %mi false
                    %mo ,
                    %mi true
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Id(false,true)
          %p
            Therefore, the fibrant type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            contains two points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi zero
                  %mo ,
                  %mi one
                %annotation{:encoding => "application/x-tex"} zero,one
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Paths
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo ,
                    %mi one
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Paths(zero,one)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi Id
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo ,
                  %mi one
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg Id(zero,one)
            (both provable inside the theory).
          %h3#the_universe_of_nonfibrant_types The universe of non-fibrant types
          %p
            The universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            of non-fibrant types is itself
            = succeed "." do
              %em fibrant
            %em
              %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible
            (in the usual sense of homotopy type theory, with respect to the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Paths
                %annotation{:encoding => "application/x-tex"} Paths
            identity type).
          %p
            The reason that the universe of non-fibrant types (type families) is contractible is that if you have a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            with two objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi b
                  %mo :
                  %mi I
                %annotation{:encoding => "application/x-tex"} a b : I
            and an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %msub
                    %mi Paths
                    %mi I
                  %mi a
                  %mi b
                %annotation{:encoding => "application/x-tex"} e : Paths_I a b
            such that for any two types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A, B
            there is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} (A \coprod B ) \to I
            whose strict fiber over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and strict fiber over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            then the family of fibers of this function gives a map from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            to the universe of all types which, when applied to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            It is not
            %em provably
            contractible in the theory, since we can take its coproduct with pretty much any other type and still have a universe of non-fibrant types. However, it is “almost” contractible by the following argument. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be arbitrary types, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ,
                  %mi zero
                  %mo ,
                  %mi one
                %annotation{:encoding => "application/x-tex"} I,zero,one
            be as defined above. Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo +
                  %mi B
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} f:A+B \to I
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi inl
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi zero
                %annotation{:encoding => "application/x-tex"} f(inl(a)) = zero
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi inr
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi one
                  %annotation{:encoding => "application/x-tex"} f(inr(b)) = one
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi I
                  %mo →
                  %msub
                    %mi U
                    %mi S
                %annotation{:encoding => "application/x-tex"} P:I\to U_S
            (the universe of non-fibrant types) by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo +
                      %mi B
                  %mi Id
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} P(i) = \sum_{x:A+B} Id(f(x),i).
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(i)
            is the fiber of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi A
                %annotation{:encoding => "application/x-tex"} P(zero) \cong A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi one
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi B
                  %annotation{:encoding => "application/x-tex"} P(one)\cong B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi S
                %annotation{:encoding => "application/x-tex"} U_S
            are both fibrant, we can apply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to the path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Paths
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo ,
                  %mi one
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Paths(zero,one)
            to obtain a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Paths
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi one
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Paths(P(zero),P(one))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Paths
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Paths(A,B)
          %h3#fibrant_replacement Fibrant replacement
          %p It is natural to wonder whether we can have a “fibrant replacement” type former which makes non-fibrant types into fibrant ones. However, surprisingly, this is actually inconsistent, essentially because it cannot be made to respect substitution.
          %p Suppose we had a type forming rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi Type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi R
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi Fib
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \, Type}{\Gamma \vdash R A \, Fib}
          %p with introduction rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi a
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi r
                      %mi a
                      %mo :
                      %mi R
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash a:A}{\Gamma \vdash r a : R A}
          %p and elimination rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi R
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi T
                      %mspace{:width => "thinmathspace"}
                      %mi Fib
                      %mspace{:width => "2em"}
                      %mi Γ
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi t
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo :
                      %mo =
                      %mi r
                      %mi a
                      %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Γ
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi R
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi Relim
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo .
                      %mi t
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi T
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma,(x:R A) \vdash T\, Fib\qquad \Gamma,(a:A) \vdash t:T[x:=r a]}{\Gamma,(x:R A) \vdash Relim(a.t,x) : T}.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} A=0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} B=1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi I
                  %mo →
                  %msub
                    %mi U
                    %mi S
                %annotation{:encoding => "application/x-tex"} P:I\to U_S
            be defined as above, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mn 0
                %annotation{:encoding => "application/x-tex"} P(zero) \cong 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi one
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} P(one)\cong 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo :
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi Fib
                  %mo .
                %annotation{:encoding => "application/x-tex"} (x:I) \vdash R(P(x))\,Fib.
          %p
            Since this is a fibrant type family over a fibrant type, we can transport the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mo ⋆
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi one
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r(\star) : R(P(one))
            along the known
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Paths
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo ,
                  %mi one
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Paths(zero,one)
            to obtain an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(P(zero))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Relim
                  %annotation{:encoding => "application/x-tex"} Relim
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi zero
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} R(P(zero))\to 0
            by defining a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi zero
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} P(zero)\to 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p It does, however, seem to be possible to allow fibrant replacement of types in the empty context. In other words, we could have a rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi Type
                    %mrow
                      %mo ⊢
                      %mi R
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mi Fib
                %annotation{:encoding => "application/x-tex"} \frac{\vdash A \, Type}{\vdash R A \, Fib}
          %p and so on. Of course, this does not fit very well in the usual framework of type theory.
          %h3#fibrancy_of_inductive_types Fibrancy of inductive types
          %p
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
            has argued that rather than assuming the natural numbers type to be fibrant and yet able to eliminate into non-fibrant types, there should be two natural numbers types: a fibrant one which can only eliminate into fibrant types, and a non-fibrant one which can eliminate into all types. The same applies to other positive inductive types such as coproducts (even coproducts of fibrant types) and the empty type.
          %p This is because while these types in simplicial sets happens to be fibrant, that is not the case in other categorical models. It may also pose similar problems for constructing new models of HTS out of old ones.
          %h3#semisimplicial_types Semisimplicial types
          %p
            %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"} Vladimir Voevodsky
            claims that HTS allows a definition of
            %a.existingWikiWord{:href => "/nlab/show/semisimplicial+types"} semisimplicial types
            and other infinite objects, in which diagrams of types commute strictly using the exact equality. See the comments in the file:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/files/hts-semisimplicial.v", :title => "Semisimplicial types in HTS"} Semisimplicial types in HTS
          %h3#voevodskys_conjecture Voevodsky’s conjecture
          %p
            Voevodsky has conjectured that any fibrant type definable in HTS is equivalent to one definable in
            = succeed "," do
              %span.newWikiWord
                MLTT
                %a{:href => "/nlab/new/Martin-L%C3%B6f+Type+Theory"} ?
          %h3#model_invariance Model invariance
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+invariance+problem"} model invariance problem
            seems more likely to fail for HTS than for theories that do not include strict equality. In other words, distinct model categories presenting the same
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p The following argument, however, shows that model invariance (even for fibrant types) definitely fails if we include fibrant replacement (of types in the empty context), and split inductive types into fibrant and non-fibrant versions (or simply don’t include inductive types in the system).
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be the poset with four objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ,
                  %mi d
                %annotation{:encoding => "application/x-tex"} a,b,c,d
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo &lt;
                    %mi a
                  %annotation{:encoding => "application/x-tex"} d\lt a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} d\lt b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo &lt;
                  %mi c
                %annotation{:encoding => "application/x-tex"} d\lt c
            are the only nonidentity relations; thus an
            = succeed "-diagram" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi a
                  %annotation{:encoding => "application/x-tex"} X_a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi c
                  %annotation{:encoding => "application/x-tex"} X_c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi d
                %annotation{:encoding => "application/x-tex"} X_d
            with maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi d
                    %mo →
                    %msub
                      %mi X
                      %mi a
                  %annotation{:encoding => "application/x-tex"} X_d \to X_a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi d
                    %mo →
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_d \to X_b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi d
                    %mo →
                    %msub
                      %mi X
                      %mi c
                  %annotation{:encoding => "application/x-tex"} X_d \to X_c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inverse+category"} inverse category
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mi E
                %annotation{:encoding => "application/x-tex"} sSet^E
            in which the cofibrations are levelwise monomorphisms, the weak equivalences are levelwise weak equivalences, and the fibrant objects are diagrams such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi a
                  %annotation{:encoding => "application/x-tex"} X_a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi c
                %annotation{:encoding => "application/x-tex"} X_c
            are fibrant and the induced map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi d
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi a
                  %mo ×
                  %msub
                    %mi X
                    %mi b
                  %mo ×
                  %msub
                    %mi X
                    %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_d \to (X_a \times X_b \times X_c)
            is a fibration. Moreover, this model has
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalent
            %a.existingWikiWord{:href => "/nlab/show/universes"} universes
            induced from those of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a univalent universe in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a univalent universe in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mi E
                  %annotation{:encoding => "application/x-tex"} sSet^E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi a
                    %mo =
                    %msub
                      %mi V
                      %mi b
                    %mo =
                    %msub
                      %mi V
                      %mi c
                    %mo =
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V_a = V_b = V_c = U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi d
                %annotation{:encoding => "application/x-tex"} V_d
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,C)
            is the type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                    %mo →
                    %mi C
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A \to B \to C \to U
          %p
            Now we can
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization"} localize
            this Reedy model structure at the maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi a
                  %annotation{:encoding => "application/x-tex"} 0\to a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} 0\to b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} 0\to c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            denote the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi a
                  %annotation{:encoding => "application/x-tex"} X_a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi b
                  %annotation{:encoding => "application/x-tex"} X_b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi c
                %annotation{:encoding => "application/x-tex"} X_c
            are contractible, and the local weak equivalences are just the maps that induce a weak equivalence on
            = succeed "-components." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            In conclusion, we have two model structures, one on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            and one on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mi E
                  %annotation{:encoding => "application/x-tex"} sSet^E
          %p
            Now, inside HTS, define a (non-fibrant) type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to be a “strict
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+level"} hprop
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo :
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi Id
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{(x,y:Y)} Id(x,y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sProp
                %annotation{:encoding => "application/x-tex"} sProp
            for the subtype of the universe of non-fibrant types determined by the strict hprops. Consider the following type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi P
                      %mo ,
                      %mi Q
                      %mo ,
                      %mi R
                      %mo :
                      %mi sProp
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo ∨
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{P,Q,R:sProp} (\neg P \to (Q \vee R)) \to ((\neg P \to Q) \vee (\neg P \to R))
          %p
            Call this type KP (for Kreisel-Putnam). Note that “false” and “or” for strict hprops can be defined impredicatively by quantification over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sProp
                  %annotation{:encoding => "application/x-tex"} sProp
          %p
            For semantics of HTS in a model category whose underlying category is a topos, the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sProp
                %annotation{:encoding => "application/x-tex"} sProp
            will be interpreted by the
            %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %em of that topos
            (independently of what the model structure might look like). Thus, KP will be interpreted by the assertion, in the internal language of that topos (again independently of the model structure), that the Kreisel-Putnam axiom holds.
          %p
            Now as pointed out by
            = succeed "," do
              %a{:href => "http://mathoverflow.net/questions/159989/internal-logic-of-the-topos-of-simplicial-sets/"} Francois Dorais
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mi E
                  %annotation{:encoding => "application/x-tex"} sSet^E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ,
                  %mi Q
                  %mo ,
                  %mi R
                %annotation{:encoding => "application/x-tex"} P,Q,R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo ∨
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\neg P \to (Q
                  \\vee R))
            is not contained in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((\neg P \to Q) \vee (\neg P \to R))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} P = a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} Q = b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi c
                  %annotation{:encoding => "application/x-tex"} R = c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo ∨
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (\neg P) = (Q \vee R) = \{b,c\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo ∨
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (\neg P \to (Q \vee R)) = 1 = \{a,b,c,d\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} (\neg P \to Q) = \{a,b\}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} (\neg P \to R) = \{a,c\}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ∨
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi P
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} ((\neg P \to Q) \vee (\neg P \to R)) = \{a,b,c\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mi E
                %annotation{:encoding => "application/x-tex"} sSet^E
            is not globally inhabited.
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi KP
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(KP)
            is a fibrant type which is inhabited in the model in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mi E
                  %annotation{:encoding => "application/x-tex"} sSet^E
