              = succeed "," do
                %a.maruku-ref{:href => "#TheSliceTopos"}
              = succeed "." do
                %a.maruku-ref{:href => "#SymplecticManifoldsAsObjectsInSliceOverModuliOf2Forms"}
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#Symplectomorphism"}
              the commutativity of this diagram says precisely that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %msub
                      %mi ω
                      %mn 1
                    %mo =
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %msub
                      %mi ω
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    p_1^\ast \omega_1 = p_2^\ast \omega_2
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %msub
                      %mi ω
                      %mn 1
                    %mo −
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %msub
                      %mi ω
                      %mn 2
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p_1^\ast \omega_1 - p_2^\ast \omega_2 = 0
                    \\,.
          %p Therefore we have:
          .num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1, \omega_2)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2, \omega_2)
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifolds"} symplectic manifolds
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LagrangianCorrespondences
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %msub
                          %mi X
                          %mn 1
                        %mo ,
                        %msub
                          %mi ω
                          %mn 1
                        %mo )
                      %mo ,
                      %mrow
                        %mo (
                        %msub
                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi ω
                          %mn 2
                        %mo )
                      %mo )
                    %mo ↪
                    %mi Corr
                    %mrow
                      %mo (
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mi cl
                            %mn 2
                      %mo )
                    %mrow
                      %mo (
                      %mrow
                        %mo (
