              we have a
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              (by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
              exhibited by the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
