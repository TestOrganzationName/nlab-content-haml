                      %mi ω
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_i, \omega_i)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
          .proof
            %h6#proof_7 Proof
            %p Under the identification of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
