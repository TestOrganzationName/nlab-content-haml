                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %msub
                      %mi S
                      %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_t =\exp(\tfrac{i}{\hbar} S_t)
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
