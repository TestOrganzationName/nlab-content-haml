                                  %mi evolution
                      %mtr
                        %mtd
                          %mi phase
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi space
                            %mi in
                        %mtd
                        %mtd
                          %msub
                            %mo ⇙
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi action
                              %mrow
                                %mi functional
                        %mtd
                        %mtd
                          %mi phase
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi space
                            %mi out
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mi prequantum
                                %mrow
                                  %msub
                                    %mi bundle
                                    %mi in
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mi prequantum
                                %mrow
                                  %msub
                                    %mi bundle
                                    %mi out
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mn 2
                                %mtext -
                                %mi group
                            %mrow
                              %mrow
                                %mi of
                                %mspace{:width => "thinmathspace"}
                                %mi phases
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; {{space\,of} \atop {trajectories}}
                  \\\
                  \&amp; {}^{\mathllap{{initial}\atop {values}}}\swarrow &amp;&amp; \searrow^{\mathrlap{{Hamiltonian} \atop {evolution}}}
                  \\\
                  phase\,space_{in} &amp;&amp; \swArrow_{{action} \atop {functional}} &amp;&amp; phase \,space_{out}
                  \\\
                  \&amp; {}_{\mathllap{{prequantum}\atop {bundle}_{in}}}\searrow
                  \&amp;&amp;
                  \\swarrow_{\mathrlap{{prequantum} \atop {bundle}_{out}}}
                  \\\
                  \&amp;&amp; {{2\text{-}group} \atop {of\,phases}}
                  }
                  \\,.
          %p
            This describes a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            in what is called the
            %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            over the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+circle+bundles"} prequantum circle bundles
            %a.existingWikiWord{:href => "/nlab/show/moduli+infinity-stack"} higher moduli stacks
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundles"} prequantum n-bundles
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            we show how the notion of prequantized Lagrangian correspondence is – still naturally in the context of
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum field theory
            – further refined from the context of
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifolds"} symplectic manifolds
            to that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifolds"} Poisson manifolds
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+of+correspondences"} 2-category of correspondences
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theories"} boundary field theories
            for a
            %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
            (a non-perturbative
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
          %h3#PhaseSpaceAndSymplecticManifolds Phase spaces and symplectic manifolds
          %p
            Given a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            %em
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            is the space of its possible (“classical”) histories or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            %a.existingWikiWord{:href => "/nlab/show/Newton%27s+laws+of+motion"} Newton's laws of motion
            say that
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            of
            %a.existingWikiWord{:href => "/nlab/show/physical+systems"} physical systems
            are (typically) determined by
            %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
            of
            %em second
            order, and therefore these spaces of trajectories are (typically) equivalent to initial value data of 0th and of 1st derivatives. In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            this data (or rather its linear dual) is referred to as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"} canonical coordinates
            and the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi p
                  %mo ∧
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mi q
                %annotation{:encoding => "application/x-tex"} \mathbf{d}p \wedge \mathbf{d}q
            spanned by a change of coordinates and momenta.
          %p
            So far this says that a physical phase space is mathematically formalized by a sufficiently
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which is equipped with a closed and non-degenerate
            %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega  \in \Omega^2_{\mathrm{cl}}(X)
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
          %p
            The non-degeneracy of a symplectic form encodes the special property (as we will make explicit below) that (time) evolution of coordinates and momenta is uniquely induced by an
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            generating the evolution. This is however famously not the case for systems with
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/gauge+equivalences"} gauge equivalences
          %p
            In the presence of gauge equivalences, the phase space form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is still a closed differential 2-form, it just need not be non-degenerate anymore. While in such a case the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            could just be called a
            = succeed "," do
              %em smooth manifold equipped with a closed differential 2-form
            %em
              %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+manifold"} pre-symplectic manifold
            in order to amplify the intended use as a model for phase spaces. (Some authors demand that a pre-symplectic form be a closed form with constant rank, but here this technical condition will not be relevant and will not be considered.)
          #CanonicalR2PhaseSpace.num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
              describing the propagation of a
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
              on the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              has as
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
              the
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo =
                    %msup
                      %mi T
                      %mo *
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 = T^\ast \mathbb{R}
              and as
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              its canonical
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on this phase space are denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ,
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} q,p \;\colon\; \mathbb{R}^2 \longrightarrow \mathbb{R}
              (called the “
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinate"}> canonical coordinate
              ” and the “
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"}> canonical momentum
              ”, respectively), and in terms of these the symplectic form in this example is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi q
                      %mo ∧
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \omega = \mathbf{d} q \wedge \mathbf{d} p
          %p
            When dealing with spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that are equipped with extra structure, such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^2_{\mathrm{cl}}(X)
            %em
              universal
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            for these structures, and this will be central for our developments here. So we need a “
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"}> smooth set
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi{:mathvariant => "normal"} cl
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^2_{\mathrm{cl}}
            of sorts, characterized by the property that there is a
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            between smooth closed differential 2-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi{:mathvariant => "normal"} cl
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^2_{\mathrm{cl}}(X)
            and
            %a.existingWikiWord{:href => "/nlab/show/smooth+maps"} smooth maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \mathbf{\Omega}^2_{\mathrm{cl}}
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          .num_defn
            %h6#definition Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              or
              %em smooth 0-type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  an assignment to each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  of a set, to be written
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(\mathbb{R}^n)
                  and to be called the
                  = succeed "," do
                    %em
                      set of smooth maps from
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℝ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                      into
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  an assignment to each ordinary smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
                  between Cartesian spaces of a function of sets
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} X(f) : X(\mathbb{R}^{n_2}) \to X(\mathbb{R}^{n_1})
                  = succeed ";" do
                    %em
                      pullback of smooth functions into
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                      along
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                          %annotation{:encoding => "application/x-tex"} f
            %p such that
            %ol
              %li
                %p this assignment respects composition of smooth functions;
              %li
                %p
                  this assignment respects the
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                  by
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/open+disks"} open disks
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msup
                            %mi ℝ
                            %mi n
                          %mo ≃
                          %msub
                            %mi U
                            %mi i
                          %mo ↪
                          %msup
                            %mi ℝ
                            %mi n
                          %msub
                            %mo{:stretchy => "false"} }
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \{\mathbb{R}^n \simeq U_i \hookrightarrow \mathbb{R}^n\}_i
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(\mathbb{R}^n)
                  of smooth functions out of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  into
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is in natural bijection with the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo {
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ϕ
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi i
                          %mo ∈
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mi i
                          %mi X
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∀
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi ϕ
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %msub
                                %mi U
                                %mi i
                              %mo ∩
                              %msub
                                %mi U
                                %mi j
                          %mo =
                          %msub
                            %mi ϕ
                            %mi j
                          %msub
                            %mo{:stretchy => "false"} |
                            %mrow
                              %msub
                                %mi U
                                %mi i
                              %mo ∩
                              %msub
                                %mi U
                                %mi j
                          %mo }
                      %annotation{:encoding => "application/x-tex"} \left\{ (\phi_i)_i \in \prod_i X(U_i) \;|\;  \forall_{i,j}\; \phi_i|_{U_{i} \cap U_j}   = \phi_j|_{U_{i} \cap U_j} \right\}
                  of tuples of smooth functions out of the patches of the cover which agree on all intersections of two patches.
          %p
            For more on this see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometry of physics
            in the section
            = succeed "." do
              %em
                %a{:href => "geometry%20of%20physics#SmoothSpaces"} Smooth sets
          %p While the formulation of this definition is designed to make transparent its geometric meaning, of course equivalently but more abstractly this says the following:
          #SheavesOnCartSp.num_defn
            %h6#definition_2 Definition
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              between them, and consider it as a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              by equipping it with the
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              or
              %em smooth 0-type
              is a
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              on this site. The
              %em
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                of smooth 0-types
              is the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Smooth
                    %mn 0
                    %mi{:mathvariant => "normal"} Type
                    %mo ≔
                    %mi{:mathvariant => "normal"} Sh
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} CartSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Smooth}0\mathrm{Type} \coloneqq \mathrm{Sh}(\mathrm{CartSp})
                    \\,.
          %p In the following we will abbreviate the notation to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ≔
                  %mi{:mathvariant => "normal"} Smooth
                  %mn 0
                  %mi{:mathvariant => "normal"} Type
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \coloneqq \mathrm{Smooth}0\mathrm{Type}
                  \\,.
          %p
            The topos of prop.
            %a.maruku-ref{:href => "#SheavesOnCartSp"}
            also has another site of definition.
          #Smooth0TypeIsSheavesOnSmoothMfd.num_prop
            %h6#proposition Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothMfd
                  %annotation{:encoding => "application/x-tex"} SmoothMfd
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with the standard
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi SmoothMfd
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi{:mathvariant => "normal"} Smooth
                    %mn 0
                    %mi{:mathvariant => "normal"} Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(SmoothMfd) \simeq \mathrm{Smooth}0\mathrm{Type}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              The canonical inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mo ↪
                    %mi SmoothMfd
                  %annotation{:encoding => "application/x-tex"} CartSp\hookrightarrow SmoothMfd
              is readily seen to be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"} comparison lemma
          %p For the discussion of presymplectic manifolds, we need the following two examples.
          .num_example
            %h6#example_2 Example
            %p
              Every smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi{:mathvariant => "normal"} SmoothManifold
                  %annotation{:encoding => "application/x-tex"} X \in \mathrm{SmoothManifold}
              becomes a smooth 0-type by the assignment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi n
                    %mo ↦
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \;\colon\; n \mapsto C^\infty(\mathbb{R}^n, X)
                    \\,.
            %p
              This construction extends to a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full embedding
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              into
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothManifold
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    SmoothManifold
                    \\hookrightarrow
                    \\mathbf{H}
          .proof
            %h6#proof_2 Proof
            %p
              This follows via prop.
              %a.maruku-ref{:href => "#Smooth0TypeIsSheavesOnSmoothMfd"}
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          #SmoothSetOfDifferentialPForms.num_example
            %h6#example_3 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Omega}^p_{\mathrm{cl}}
              for the
              %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              whose
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/differential+p-forms"} differential p-forms
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ↦
                    %msubsup
                      %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^p_{\mathrm{cl}}
                    \\colon
                    \\mathbb{R}^n \mapsto \Omega^p_{\mathrm{cl}}(\mathbb{R}^n)
            %p
              and which sends a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{n_1} \to \mathbb{R}^{n_2}
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along this map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                          %mtd
                            %mo ↦
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                          %mtd
                            %mo ↦
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^{n_1}
                    \&amp;\mapsto&amp;
                    \\Omega^p_cl(\mathbb{R}^{n_1})
                    \\\
                    \\downarrow^{\mathrlap{f}} &amp;&amp; \uparrow^{\mathrlap{f^\ast}}
                    \\\
                    \\mathbb{R}^{n_2}
                    \&amp;\mapsto&amp;
                    \\Omega^p_cl(\mathbb{R}^{n_2})
                    }
                    \\,.
          %p
            For more on this example see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometry of physics
            in the section
            = succeed "." do
              %em
                %a{:href => "geometry%20of%20physics#DifferentialForms"} Differential forms
          %p
            This solves the
            %a.existingWikiWord{:href => "/nlab/show/moduli+problem"} moduli problem
            for closed smooth differential forms:
          #PresymplecticFormsAsMapsIntoASmoothSpace.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SmoothManifold
                      %mo ↪
                      %mi Smooth
                      %mn 0
                      %mi Type
                    %annotation{:encoding => "application/x-tex"} X \in SmoothManifold \hookrightarrow Smooth0Type
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi Ω
                      %mi{:mathvariant => "normal"} cl
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H}(X,\mathbf{\Omega}^p_{\mathrm{cl}})
                    \\simeq
                    \\Omega^p_{\mathrm{cl}}(X)
            %p between morphisms (of smooth sets)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow \Omega^2_{cl}
            %p and smooth closed 2-forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega \in \Omega^2_{cl}(X)
            %p
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_3 Proof
            %p
              This follows via prop.
              %a.maruku-ref{:href => "#Smooth0TypeIsSheavesOnSmoothMfd"}
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %p
            So a
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            is equivalently a map of smooth sets of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo ⟶
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi Ω
                    %mi{:mathvariant => "normal"} cl
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\omega \;\colon\;
                  X \longrightarrow \mathbf{\Omega}^2_{\mathrm{cl}}
                  \\,.
          %h3#CanonicalTransformations Canonical transformations and symplectomorphisms
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            between two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"} canonical coordinates
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
            %em
              %a.existingWikiWord{:href => "/nlab/show/canonical+transformation"} canonical transformation
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
          .num_defn
            %h6#definition_3 Definition
            %p
              Given two
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifolds"} symplectic manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1, \omega_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2, \omega_2)
              (which might be two copies of one single symplectic manifold), a
              %em
                %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
              between them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; (X_1, \omega_1) \longrightarrow (X_2, \omega_2)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi X
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X_1 \longrightarrow X_2
            %p
              of the underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of the second
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              equals the first,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi ω
                      %mn 2
                    %mo =
                    %msub
                      %mi ω
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast \omega_2 = \omega_1
                    \\,.
          %p
            The above formulation of pre-symplectic manifolds as maps into a
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of closed
            %a.existingWikiWord{:href => "/nlab/show/differential+2-forms"} differential 2-forms
            yields the following formulation of symplectomorphisms, which is very simple in itself, but contains in it the seed of an important phenomenon:
          #Symplectomorphism.num_prop
            %h6#proposition_3 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (X_1, \omega_1) \longrightarrow (X_2, \omega_2)
              as above is, under the identification of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PresymplecticFormsAsMapsIntoASmoothSpace"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ω
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ω
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_1 &amp;&amp; \stackrel{f}{\longrightarrow}&amp;&amp; X_2
                    \\\
                    \&amp; {}_{\mathllap{\omega_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{\omega_2}}
                    \\\
                    \&amp;&amp; \Omega^2_{cl}
                    }
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %p
              By prop.
              %a.maruku-ref{:href => "#PresymplecticFormsAsMapsIntoASmoothSpace"}
              the identification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi i
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_i \in \Omega^2_{cl}(X_i)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \omega_i \colon X \to \Omega^2_{cl}
              is via the
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Smooth
                        %mn 0
                        %mi Type
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Smooth0Type}(X,\mathbf{\Omega}^2_{cl})
                    \\stackrel{\simeq}{\longrightarrow}
                    \\Omega^2_{cl}(X)
                    \\,.
            %p
              This being natural means that for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mover
                      %mo ⟶
                      %mi f
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1 \stackrel{f}{\longrightarrow} X_2
              there is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 2
                            %mo ,
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo ∘
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 1
                            %mo ,
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi cl
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msubsup
                              %mi Ω
                              %mi cl
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom(X_2,\mathbf{\Omega}^2_{cl})
                    \&amp;\stackrel{\simeq}{\longrightarrow}&amp;
                    \\Omega^2_{cl}(X_2)
                    \\\
                    \\downarrow^{\mathrlap{(-) \circ f}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f^\ast}}
                    \\\
                    Hom(X_1,\mathbf{\Omega}^2_{cl})
                    \&amp;\stackrel{\simeq}{\longrightarrow}&amp;
                    \\Omega^2_{cl}(X_1)
                    }
            %p
              where on the left we have the pre-
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              operation on morphisms and on the right we have, by example
              = succeed "," do
                %a.maruku-ref{:href => "#SmoothSetOfDifferentialPForms"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            %p Consider then the element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ω
                          %mn 2
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X_2 \stackrel{\omega_2}{\to} \mathbf{\Omega}^2_{cl})
                    \\in
                    Hom(X_2,\mathbf{\Omega}^2_{cl})
            %p
              in the top left set in this diagram. Sending it along the top and right maps yields the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi ω
                        %mn 2
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mi cl
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\ast \omega_2 \in \Omega^2_{cl}(X_1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 1
                      %mover
                        %mo →
                        %mi f
                      %msub
                        %mi X
                        %mn 2
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ω
                            %mn 1
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi cl
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X_1 \stackrel{f}{\to} X_2 \stackrel{\omega_1}{\to}\mathbf{\Omega}^2_{cl})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^2_{cl}(X_1)
              coincide. This is the claim to be proven.
          %p
            Situations like this are naturally interpreted in a
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
          #TheSliceTopos.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} A \in \mathbf{H}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/A}
              is the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              equipped with
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X \to A
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\longrightarrow&amp;&amp; Y
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; A
                    }
          .num_defn
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} SymplManifold
                  %annotation{:encoding => "application/x-tex"} \mathrm{SymplManifold}
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              with
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} presymplectic
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              as
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symplectomorphisms"} symplectomorphisms
              = succeed "," do
                %a.maruku-ref{:href => "#Symplectomorphism"}
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
          #SymplecticManifoldsAsObjectsInSliceOverModuliOf2Forms.num_prop
            %h6#proposition_4 Proposition
            %p
              The construction of prop.
              %a.maruku-ref{:href => "#PresymplecticFormsAsMapsIntoASmoothSpace"}
              which sends a smooth symplectic manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              to the classifying morphism of smooth sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ⟶
                      %mi ω
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi cl
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X \stackrel{\omega}{\longrightarrow}\mathbf{\Omega}^2_{cl})
              regarded as an object in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              %a.maruku-ref{:href => "#TheSliceTopos"}
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SymplManifold
                    %mo ↪
                    %mi Smooth
                    %mn 0
                    %msub
                      %mi Type
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msubsup
                          %mstyle{:mathvariant => "bold"}
                            %mi Ω
                          %mi{:mathvariant => "normal"} cl
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    SymplManifold
                    \\hookrightarrow
                    Smooth0Type_{/\mathbf{\Omega}^2_{\mathrm{cl}}}
            %p of pre-symplectic manifolds with symplectomorphisms between them into the slice topos of smooth sets over the smooth moduli space of closed differential 2-forms.
          .proof
            %h6#proof_5 Proof
            %p
              By prop.
              = succeed "." do
                %a.maruku-ref{:href => "#Symplectomorphism"}
          %h3#TrajectoriesAndLagrangianCorrespondences Trajectories and Lagrangian correspondences
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
            clearly puts two
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifolds"} symplectic manifolds
            “in
            = succeed "\u201D" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %a.existingWikiWord{:href => "/nlab/show/relations"} relations
            in mathematics. Recall:
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X,Y \in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              between
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R \hookrightarrow X \times Y
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathbf{H}
              two
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              (such as the topos of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              of their
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R \hookrightarrow X \times Y
                    \\,.
          %p
            In particular any
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            induces the
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is the image of
            = succeed "\u201D:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          #FunctionsAsCorrespondences.num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              %em induced relation
              is the
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              which is exhibited by the
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi X
                      %mo ×
                      %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    graph(f)
                    \\coloneqq
                    \\left\{
                    (x,y) \in X \times Y \;|\; f(x) = y
                    \\right\}
            %p canonically regarded as a subobject
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    graph(f) \hookrightarrow X \times Y
                    \\,.
          %p
            Hence in the context of classical mechanics, in particular any
            %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %msub
                    %mi ω
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \;\colon\; (X_1, \omega_1) \longrightarrow (X_2, \omega_2)
            induces the relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi graph
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  graph(f) \hookrightarrow X_1 \times X_2
                  \\,.
          %p
            Since we are going to think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as a kind of “physical process”, it is useful to think of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi graph
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} graph(f)
            here as the
            %em
              space of
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            of that process. To make this clearer, notice that we may equivalently rewrite every
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ↪
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} R \hookrightarrow X \times Y
            as a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the following form:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi i
                                  %mi X
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi i
                                  %mi Y
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mo ×
                          %mi Y
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi X
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi Y
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; R
                  \\\
                  \&amp; {}^{\mathllap{i_X}}\swarrow &amp;&amp; \searrow^{\mathrlap{i_Y}}
                  \\\
                  X &amp;&amp; &amp;&amp; Y
                  }
                  \\;\;
                  \=
                  \\;\;
                  \\array{
                  \&amp;&amp; R
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; X \times Y
                  \\\
                  \&amp; {}^{\mathllap{p_X}}\swarrow &amp;&amp; \searrow^{\mathrlap{p_Y}}
                  \\\
                  X &amp;&amp; &amp;&amp; Y
                  }
          %p
            reflecting the fact that every
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∼
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} (x \sim y) \in R
            defines an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %msub
                    %mi i
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∼
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x = i_X(x \sim y) \in X
            and an element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %msub
                      %mi i
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∼
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y = i_Y(x \sim y) \in Y
          %p
            Then if we think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi graph
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R = graph(f)
            we may read the relation as “there is a trajectory from an incoming configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                %annotation{:encoding => "application/x-tex"} x_1
            to an outgoing configuration
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi incoming
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi outgoing
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi X
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; graph(f)
                  \\\
                  \&amp; {}^{\mathllap{incoming}}\swarrow &amp;&amp; \searrow^{\mathrlap{outgoing}}
                  \\\
                  X_1 &amp;&amp; &amp;&amp; X_2
                  }
                  \\,.
          %p
            Notice here that the defining property of a relation as a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            translates into the property of
            %a.existingWikiWord{:href => "/nlab/show/classical+physics"} classical physics
            that there is
            %em at most one trajectory
            from some incoming configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                %annotation{:encoding => "application/x-tex"} x_1
            to some outgoing trajectory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_2
            (for a fixed parameter time interval at least, we will formulate this precisely in the next section when we genuinely consider Hamiltonian correspondences).
          %p
            In a more general context one could consider there to be several such trajectories, and even a whole smooth set of such trajectories between given incoming and outgoing configurations. Each such trajectory would “relate”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                %annotation{:encoding => "application/x-tex"} x_1
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                %annotation{:encoding => "application/x-tex"} x_1
            %em correspond
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x_2
            in a different way, and that is the mathematical term usually used:
          #CorrespondencesAndEquivalences.num_defn
            %h6#defininition Defininition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathbf{H}
              two spaces, a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Z
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X &amp;&amp; &amp;&amp; Y
                    }
            %p
              with no further restrictions. Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is also called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/correspondence+space"} correspondence space
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              between two such correspondences is an equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mn 1
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Z
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Z_1 \stackrel{\simeq}{\to}Z_2
              that gives a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Z
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mrow
                            %mo ↖
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Z
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Z_1
                    \\\
                    \&amp; {}^{}\swarrow &amp;&amp; \searrow^{}
                    \\\
                    X &amp;&amp;\downarrow^{\mathrlap{\simeq}} &amp;&amp; Y
                    \\\
                    \&amp; {}_{}\nwarrow &amp;&amp; \nearrow_{}
                    \\\
                    \&amp;&amp; Z_2
                    }
            %p
              Correspondences between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              with such equivalences between them form a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics"} geometry of physics
              the section
              %em
                %a{:href => "geometry%20of%20physics#GroupoidsAndBasicHomotopy1TypeTheory"} Essence of gauge theory: Groupoids and basic homotopy 1-type theory
              for more on this.) Hence we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Corr
                    %mrow
                      %mo (
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Corr\left(\mathbf{H}\right)(X,Y) \in Grpd
                    \\,.
          #EquivalenceOfCorrespndencesInducedByFunction.num_example
            %h6#example_5 Example
            %p
              The correspondence induced by the
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              as in example
              %a.maruku-ref{:href => "#FunctionsAsCorrespondences"}
              is equivalent, in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#CorrespondencesAndEquivalences"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{id}}\swarrow &amp;&amp; \searrow^{\mathrlap{f}}
                    \\\
                    X &amp;&amp; &amp;&amp; Y
                    }
                    \\,.
            %p The equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi X
                            %mo ↖
                          %mtd
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi graph
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X
                    \\\
                    \&amp; {}^{\mathllap{id}}\swarrow &amp;&amp; \searrow^{\mathrlap{f}}
                    \\\
                    X &amp;&amp;\downarrow^{\mathrlap{\simeq}} &amp;&amp; Y
                    \\\
                    \&amp; {}_{\mathllap{i_X}}\nwarrow &amp;&amp; \nearrow_{\mathrlap{i_Y}}
                    \\\
                    \&amp;&amp; graph(f)
                    }
            %p is induced by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{\simeq}{\longrightarrow} graph(f)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    x \mapsto (x,f(x))
          %p
            Moreover, if we think of correspondences as modelling spaces of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
          .num_defn
            %h6#definition_7 Definition
            %p
              Given two consecutive correspondences, then their
              %em composite
              is the correspondence obtained by forming the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of the two coincident morphisms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Y
                                %mn 1
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Y
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi X
                                %mn 2
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi X
                                %mn 3
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Y
                                %mn 1
                              %msub
                                %mo ∘
                                %mrow
                                  %msub
                                    %mi X
                                    %mn 2
                              %msub
                                %mi Y
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi X
                                %mn 3
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \&amp;&amp; Y_1 &amp;&amp;&amp;&amp; Y_2
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X_1 &amp;&amp; &amp;&amp; X_2 &amp;&amp; &amp;&amp; X_3
                    }
                    \\right)
                    \\;\;\;\;
                    \\mapsto
                    \\;\;\;\;
                    \\left(
                    \\array{
                    \&amp;&amp; Y_1 \circ_{X_2} Y_2
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X_1 &amp;&amp; &amp;&amp; X_3
                    }
                    \\right)
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              Heuristically, the composite space of trajectories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %msub
                      %mo ∘
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %msub
                      %mi Y
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y_1 \circ_{X_2} Y_2
              should consist precisely of those pairs of trajectories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Y
                      %mn 1
                    %mo ×
                    %msub
                      %mi Y
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} ( f, g ) \in Y_1  \times Y_2
              such that the endpoint of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is the starting point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Y_1
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y_2
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %munder
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mn 2
                    %msub
                      %mi Y
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y_1 \underset{X_2}{\times} Y_2
              (also called the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 2
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y_2 \longrightarrow X_2
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Y_1 \longrightarrow X_2
              and then abbreviated
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi pb
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (pb)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Y
                                %mn 1
                              %msub
                                %mo ∘
                                %mrow
                                  %msub
                                    %mi X
                                    %mn 2
                              %msub
                                %mi Y
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi X
                                %mn 3
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Z
                                %mn 1
                              %munder
                                %mo ×
                                %mi Y
                              %msub
                                %mi Z
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi Z
                                %mn 1
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %msub
                                %mi Z
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi Y
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \&amp;&amp; Y_1 \circ_{X_2} Y_2
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X_1 &amp;&amp; &amp;&amp; X_3
                    }
                    \\right)
                    \\;\;\;
                    \=
                    \\;\;\;
                    \\left(
                    \\array{
                    \&amp;&amp; &amp;&amp; Z_1 \underset{Y}{\times} Z_2
                    \\\
                    \&amp;&amp; &amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \&amp;&amp; Z_1 &amp;&amp; (pb) &amp;&amp; Z_2
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    X &amp;&amp; &amp;&amp; Y &amp;&amp; &amp;&amp; Z
                    }
                    \\right)
                    \\,.
            %p
              Hence given a
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
              between its objects form a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              which
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              operation, where however the collection of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              between any two objects is not just a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              (the groupoid of correspondences between two given objects and
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
              between them).
          %p
            One says that correspondences form a
            %em
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Corr
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Corr(\mathbf{H}) \in (2,1)Cat
                  \\,.
          %p
            But for most purposes here, the reader unwilling to enter
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            can, to good approximation, pretend that correspondences form an ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p
            One reason for formalizing this notion of correspondences so much in the present context that it is useful now to apply it not just to the ambient
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi cl
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{\Omega}_{cl}^2}
            over the universal
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+2-forms"} differential 2-forms
          %p To see how this is useful in the present context, notice the following basic observation:
          .num_defn
            %h6#definition_8 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    L \hookrightarrow X
            %p is called
            %ul
              %li
                %p
                  an
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/isotropic+submanifold"} isotropic submanifold
                  if
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi L
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \omega|_{L}= 0
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
                  if in addition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  has
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} dim(L) = dim(X)/2
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon X_1 \to X_2
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              between
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi graph
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                            %mo ×
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; graph(f)
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; X_1 \times X_2
                    \\\
                    \&amp; {}^{\mathllap{p_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{p_2}}
                    \\\
                    X_1 &amp;&amp; &amp;&amp; X_2
                    }
            %p
              be the induced
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \omega_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \omega_2
              are
              %a.existingWikiWord{:href => "/nlab/show/symplectic+forms"} symplectic forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mn 1
                      %mo *
                    %msub
                      %mi ω
                      %mn 1
                    %mo −
                    %msubsup
                      %mi p
                      %mn 2
                      %mo *
                    %msub
                      %mi ω
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_1^\ast \omega_1 - p_2^\ast \omega_2
              is a pre-symplectic form on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_1 \times X_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi graph
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} graph(f) \hookrightarrow X_1 \times X_2
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
          %p To capture this phenomenon, one traditionally sets:
          #LagrangianCorrespondence.num_defn
            %h6#definition_9 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 1
