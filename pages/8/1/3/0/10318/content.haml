                          %mi X
                          %mn 2
                        %mo ,
                        %msub
                          %mi ω
                          %mn 2
                        %mo )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    LagrangianCorrespondences\left(\left(X_1,\omega_1\right), \left(X_2, \omega_2\right)\right)
                    \\hookrightarrow
                    Corr\left(\mathbf{H}_{/\mathbf{\Omega}^2_{cl}}\right)\left(\left(X_1,\omega_1\right), \left(X_2, \omega_2\right)\right)
            %p
              of the Lagrangian correspondences into the space of correspondences between the two manifolds as objects in the
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              over the universal moduli space of closed differential 2-forms.
          .num_example
            %h6#example_6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon X_1\to X_2
              between
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
