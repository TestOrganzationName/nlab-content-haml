                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v \theta = -\mathbf{d}L
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ∈
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} v \in \Gamma(T X)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/flow"} flow
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo ↦
                          %msub
                            %mi f
                            %mi t
                        %annotation{:encoding => "application/x-tex"} t\mapsto f_t
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℒ
                          %mi v
                      %annotation{:encoding => "application/x-tex"} \mathcal{L}_v
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
                  along
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                        %annotation{:encoding => "application/x-tex"} v
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi L
                        %mo ≔
                        %mfrac
                          %mrow
                            %mo ∂
                            %mi S
                          %mrow
                            %mo ∂
                            %mi t
                      %annotation{:encoding => "application/x-tex"} L \coloneqq \frac{\partial S}{\partial t}
                  \.
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              this equation is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi L
                    %mo −
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v \omega = -\mathbf{d}L - \mathbf{d} \iota_v \theta
                    \\,.
            %p
              This is the symplectic form of
              %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations"} Hamilton's equations
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              and says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi L
                    %mo −
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                  %annotation{:encoding => "application/x-tex"}
                    H
                    \\coloneqq
                    \- L - \iota_v \theta
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              that makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mi v
                            %mi θ
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mi v
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %mi q
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi p
                            %msub
                              %mo ∂
                              %mi v
                            %mi q
                        %mtr
                          %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_v  \theta
                    \&amp;=
                    \\iota_v ( p \, \mathbf{d}q )
                    \\\
                    \&amp; = p \partial_v q
                    \\\
                    \\end{aligned}
                    \\,.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is Hamiltonian, this is given by one component of
              %a.existingWikiWord{:href => "/nlab/show/Hamilton%27s+equations"} Hamilton's equations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi p
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \iota_v (\mathbf{d}p \wedge \mathbf{d}q) = \mathbf{d}H
              saying that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi v
                      %mi q
                      %mo =
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi H
                        %mrow
                          %mo ∂
                          %mi p
                    %annotation{:encoding => "application/x-tex"} \partial_v q = \frac{\partial H}{\partial p}
            %p
              Hence in summary the flow is Hamiltonian and the pre-quntum filler is the choice of Hamiltonian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              specified by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi S
                      %mrow
                        %mo ∂
                        %mi t
                    %mo =
                    %mi L
                    %mo =
                    %mi p
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi H
                      %mrow
                        %mo ∂
                        %mi p
                    %mo −
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial S}{\partial t}
                    \=
                    L
                    \=
                    p \frac{\partial H}{\partial p}  - H
                    \\,.
          .num_remark
            %h6#remark_6 Remark
            %p
              In particular, this induces a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Bord
                      %mn 1
                      %mi Riem
                    %mo ⟶
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\tfrac{i}{\hbar} S)
                    \\;\colon\;
                    Bord_1^{Riem}
                    \\longrightarrow
                    Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
                    \\,.
            %p
              In summary, prop.
              %a.maruku-ref{:href => "#HamiltonianTransformationIsPrequantizedByTheExponentiatedAction"}
              and remark
              %a.maruku-ref{:href => "#HamiltonianCorrespondencesAreSpacesOfTrajectories"}
              say that a prequantized Lagrangian correspondence is conceptually of the following form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mi space
                                  %mspace{:width => "thinmathspace"}
                                  %mi of
                              %mrow
                                %mi trajectories
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mi initial
                                  %mrow
                                    %mi values
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mi Hamiltonian
                                  %mrow
                                    %mi evolution
                        %mtr
                          %mtd
                            %mi phase
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi space
                              %mi in
                          %mtd
                          %mtd
                            %msub
                              %mo ⇙
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mi action
                                %mrow
                                  %mi functional
                          %mtd
                          %mtd
                            %mi phase
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi space
                              %mi out
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mi prequantum
                                  %mrow
                                    %msub
                                      %mi bundle
                                      %mi in
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mi prequantum
                                  %mrow
                                    %msub
                                      %mi bundle
                                      %mi out
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mn 2
                                  %mo −
                                  %mi group
                              %mrow
                                %mrow
                                  %mi of
                                  %mspace{:width => "thinmathspace"}
                                  %mi phases
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; {{space\,of} \atop {trajectories}}
                    \\\
                    \&amp; {}^{\mathllap{{initial}\atop {values}}}\swarrow &amp;&amp; \searrow^{\mathrlap{{Hamiltonian} \atop {evolution}}}
                    \\\
                    phase\,space_{in} &amp;&amp; \swArrow_{{action} \atop {functional}} &amp;&amp; phase \,space_{out}
                    \\\
                    \&amp; {}_{\mathllap{{prequantum}\atop {bundle}_{in}}}\searrow
                    \&amp;&amp;
                    \\swarrow_{\mathrlap{{prequantum} \atop {bundle}_{out}}}
                    \\\
                    \&amp;&amp; {{2-group} \atop {of\,phases}}
                    }
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p
              The proof of prop.
              %a.maruku-ref{:href => "#HamiltonianTransformationIsPrequantizedByTheExponentiatedAction"}
              recovers, from general abstract input, precisely all the ingredients known in physics as
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/canonical+transformations"} canonical transformations
            %p
              The proposition says that the slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}U(1)_{conn}}
              unifies
              %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
              in its two incarnations as
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+mechanics"} Hamiltonian mechanics
              and as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+mechanics"} Lagrangian mechanics
              %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
              is exhibited by the
              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              that fill diagrams in the slice topos over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
            %div
              %table
                %thead
                  %tr
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
                    %th
                      %math#mathml_c2f256a74f9297292524bff7ac0438b8fdc5dbb2_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ←
                          %annotation{:encoding => "application/x-tex"} \leftarrow
                      %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
                      %math#mathml_c2f256a74f9297292524bff7ac0438b8fdc5dbb2_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo →
                          %annotation{:encoding => "application/x-tex"} \rightarrow
                    %th
                      %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
                %tbody
                  %tr
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
                    %td{:style => "text-align: left;"}
                      %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondence"} prequantized Lagrangian correspondence
          %h3#heisenberg_group_and_poisson_bracket Heisenberg group and Poisson bracket
          %p
            Above we have interpreted
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            as
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            by taking the
            %a.existingWikiWord{:href => "/nlab/show/correspondence+space"} correspondence space
            to be the
            %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as the correspondence space, take the left map out of it to be the identity and the right map to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            itself:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi id
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  X \stackrel{f}{\longrightarrow} Y
                  \\right)
                  \\;\;
                  \\mapsto
                  \\;\;
                  \\left(
                  \\array{
                  \&amp;&amp; X
                  \\\
                  \&amp; {}^{\mathllap{id}}\swarrow &amp;&amp; \searrow^{\mathrlap{f}}
                  \\\
                  X &amp;&amp; &amp;&amp; Y
                  }
                  \\right)
                  \\,.
          %p
            Consider now those correspondences which are
            %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            (
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"}> isomorphisms
            ) in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+correspondences"} category of correspondences
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_1(\mathbf{H})
            %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
            on everything and consider just correspondences of the underlying
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_1(Set)
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            map correspondences are given by
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            with
            %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
            entries and
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of correspondence by
            %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            induces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
          %p
            Therefore for a correspondence to be an equivalence-transformation it has to be of the form above, induced by a direct
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/map"} map
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \stackrel{\simeq}{\longrightarrow} Y
          .num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              be a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              and choose any
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,\nabla)
              = succeed "," do
                %a.maruku-ref{:href => "#PrequantizationIsLiftThroughCurvatureBaseChange"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"} slice (2,1)-topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                      %mo ∈
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                    %annotation{:encoding => "application/x-tex"} \nabla \in \mathbf{H}_{/\mathbf{B}U(1)_{conn}}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                      %annotation{:encoding => "application/x-tex"} \nabla
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/category+of+correspondences"} category of correspondences
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Corr
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}})
                  is what is called the
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              %li
                %p
                  its
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
                  Lie algebra of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi ω
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,\omega)
          %p
            See (
            %a{:href => "#FiorenzaRogersSchreiber13a"}> hgp 13
            )
          %p
            For some reason, the
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
            which is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            is less famous than the
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            that sits inside it:
          .num_remark
            %h6#remark_8 Remark
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              itself has the structure of a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              (for instance if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi p
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi q
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{R}^{2n}, \sum_i p_i \mathbf{d}q^i)
              ), then the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphisms"} diffeomorphisms
              are given by the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %h3#hamiltonian_actions_and_moment_maps Hamiltonian actions and moment maps
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\omega)
            is equivalently an action by prequantized Lagrangian correspondences, hence a group
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⟶
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Corr
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G \longrightarrow \mathbf{Aut}_\nabla(Corr_1(\mathbf{H}_{/\mathbf{B}U(1)_{conn}}))
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
            of this is the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/moment+map"} moment map
          %p
            See (
            %a{:href => "#FiorenzaRogersSchreiber13a"}> hgp 13
            )
          %h2#SemanticsLayer Semantic Layer
          %p
            We now discuss the above constructions more abstractly in
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
          %blockquote
            %p under construction
          %p
            given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            then the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B} \mathbf{Aut}(V)
            of its
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(V)
            is the
            %a.existingWikiWord{:href => "/nlab/show/1-image"} 1-image
            factorization of the name
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo ⟶
                    %mrow
                      %mo ⊢
                      %mi V
                  %mi Type
                %annotation{:encoding => "application/x-tex"} \ast \stackrel{\vdash V}{\longrightarrow} Type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mover
                    %mo ⟶
                    %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Type
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\ast \stackrel{}{\longrightarrow} \mathbf{B}\mathbf{Aut}(V)
                  \\hookrightarrow Type
                  \\,.
          %p
            for the slice over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
            this needs to be subjected to
            %a.existingWikiWord{:href => "/nlab/show/differential+concretification"} differential concretification
          %p (…)
          %h2#SyntacticLayer Syntactic Layer
          %p
            We now discuss the above constructions yet more abstractly in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %p (…)
          %p
            prequantization is lift through
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            along the universal
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            map of prop.
            %a.maruku-ref{:href => "#UniverselCurvatureMap"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                  %mo ⟶
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi cl
                        %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\underset{F_{(-)}}{\sum}
                  \\;\colon\;
                  \\mathbf{H}_{/\mathbf{B}U(1)_{conn}}
                  \\longrightarrow
                  \\mathbf{H}_{/\mathbf{\Omega}^2_{cl}}
          %p (…)
          %h2#references References
          %p As far as it is not covered by traditional material, the above discussion is taken from
          %ul
            %li#FiorenzaRogersSchreiber13a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"} Chris Rogers
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Higher+geometric+prequantum+theory"} Higher geometric prequantum theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
                ,
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Classical+field+theory+via+Cohesive+homotopy+types"} Classical field theory via Cohesive homotopy types
          %p
            For more and related references see there and see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
        .revisedby
          %p
