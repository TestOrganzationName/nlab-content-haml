                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi p
