                    %mi F
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mi σ
                %annotation{:encoding => "application/x-tex"} d_i :F_\sigma \to F_{d_i\sigma} \quad and\quad s_i : F_\sigma \to F_{s_i\sigma}
          %p satisfying the simplicial identities.
          %h3#remarks Remarks
          %ul
            %li
              %p Here we will often just refer to ‘local system’ rather than the fuller ‘simplicial local system’, if no confusion will be likely to result.
            %li
              %p There is an obvious way of assigning a small category to a simplicial set in which the simplices are the objects and the face and degeneracy maps generate the morphisms:
          %p
            regarding the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            as a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %msup
                    %mi Δ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  K : \Delta^{op} \to Set
          %p
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi const
                    %mi K
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Δ
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Δ
                              %mrow
                                %mi n
                                %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mi c
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %mi c
                                %mo ′
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi K
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  (Y, const_K) =
                  \\left\{
                  \\array{
                  Y(\Delta^n) &amp;&amp;\stackrel{}{\to}&amp;&amp; Y(\Delta^{n'})
                  \\\
                  \&amp; {}_c\searrow &amp;&amp; \swarrow_{c'}
                  \\\
                  \&amp;&amp; K
                  }
                  \\right\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
