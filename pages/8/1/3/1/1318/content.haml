          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
              \: How does the
              = succeed "-grading" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
