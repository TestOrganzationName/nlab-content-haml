                  %msub
                    %mi d
                    %mi i
                  %mo =
                  %msub
                    %mi d
                    %mi i
                  %mo ;
                  %mspace{:width => "1em"}
                  %msub
                    %mi s
                    %mi i
                  %mo =
                  %msub
                    %mi s
                    %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} (\varphi^*F)_\sigma = F_{\varphi\sigma} ; \quad d_i = d_i ; \quad s_i = s_i.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
