                  %msubsup
                    %mi F
                    %mi σ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \Phi_\sigma \in F^p_\sigma
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi d
                        %mi i
                      %mi σ
                  %mo =
                  %msub
                    %mi d
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Φ
                    %mi σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi and
                  %mspace{:width => "1em"}
                  %msub
                    %mi Φ
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mi σ
                  %mo =
                  %msub
                    %mi s
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Φ
                    %mi σ
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Phi_{d_i\sigma} = d_i(\Phi_\sigma) \quad  and  \quad \Phi_{s_i\sigma}  = s_i(\Phi_\sigma).
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
              \: Do I understand correctly that when the simplicial local system is expressed as a functor, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(K)
              is the space of natural transformations from the simplicial local system constant on the
              %a.existingWikiWord{:href => "/nlab/show/generator"} generator
              (if any) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (for instance the tensor unit if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is graded vector spaces).
            %p
              For ordinary
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
              \: I’m not sure.
          %p
            The linear structure is the obvious one, defined ‘componentwise’ and if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is one of the algebra (resp. differential) variants of the generic receiving category then the multiplication (resp. the differential) is defined componentwise as well. In this way
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(K)
            becomes an object of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %strong object of global sections
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
              \: This construction also has (I think) a neat categorical description, that will be worth investigating. It would seem to be the analogue of the Grothendieck construction / homotopy colimit (at least partially) in this context. (enlightenment sought!!!)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo :
                  %mi L
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} \varphi : L \to K
            is a simplicial map, it determines a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi φ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi φ
                    %mo *
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(\varphi) : (\varphi^*F)(L)\to F(K)
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi φ
                  %mo{:stretchy => "false"} )
                  %mi Φ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi σ
                  %mo =
                  %msub
                    %mi Φ
                    %mrow
                      %mi φ
                      %mi σ
                  %mo .
                %annotation{:encoding => "application/x-tex"} (F(\varphi)\Phi)_\sigma = \Phi_{\varphi\sigma}.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                %annotation{:encoding => "application/x-tex"} \varphi
            is an inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi φ
                    %mo *
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\varphi^*F)(L)
            simply by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(L)
            and call the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(K)\to F(L)
            = succeed "." do
              %em restriction
          %p
            Now suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a local system over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi n
                  %mo ⊂
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} M_n \subset K_n
            are subsets (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n \geq 0
            ) such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo :
                  %msub
                    %mi M
                    %mi n
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} d_i : M_n \to M_{n-1}
            This family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi M
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{M_n\}
            generates a subsimplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ⊂
                  %mi K
                %annotation{:encoding => "application/x-tex"} L\subset K
            and if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %mi σ
                  %mo ∈
                  %msub
                    %mi M
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} s_i\sigma \in M_{n+1}
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %msub
                      %mi d
                      %mi i
                    %msub
                      %mi s
                      %mi i
                    %mi σ
                    %mo ∈
                    %msub
                      %mi M
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma = d_i s_i\sigma \in M_n
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
              \: So what are simplicial local systems used for? Is there a good motivating example? Relating it to the other definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
              \: Aha! All will be revealed in the next entry ‘Differential forms on a simplicial set’ … when I get to putting it in! There is some more to go here as well, describing special properties, but it was getting late last night.
          .un_lemma
            %h6#lemma Lemma
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi σ
                    %mo ∈
                    %msubsup
                      %mi F
                      %mi σ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \Phi_\sigma \in F^p_\sigma
              (
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %msub
                        %mi M
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \sigma \in M_n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n \geq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %msub
                          %mi d
                          %mi i
                        %mi σ
                    %mo =
                    %msub
                      %mi d
                      %mi i
                    %msub
                      %mi Φ
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} \Phi_{d_i\sigma} = d_i\Phi_\sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mrow
                        %msub
                          %mi s
                          %mi i
                        %mi σ
                    %mo =
                    %msub
                      %mi s
                      %mi i
                    %msub
                      %mi Φ
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} \Phi_{s_i\sigma} = s_i\Phi_\sigma
              (this is with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mi σ
                      %mo ∈
                      %msub
                        %mi M
                        %mi n
                    %annotation{:encoding => "application/x-tex"} s_i\sigma\in M_n
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n\geq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %msup
                      %mi F
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi\in F^p(L)
              extending
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Φ
                        %mi σ
                    %annotation{:encoding => "application/x-tex"} \Phi_\sigma
          %p The proof is by induction and can be found in Halperin’s notes if required.
          %p
            For any simplicial set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ∈
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sigma \in K_n
            determines a unique simplicial map, which we will also write as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            that sends the unique non-degenerate
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            to the element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a local system over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi σ
                    %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} \sigma^*F
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            %em extendable
            if for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            the restriction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi σ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi σ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma^*(F)(\Delta[n]) \to \sigma^*(F)(\partial\Delta[n])
          %p
            is surjective, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \partial\Delta[n]
            is the boundary of the
            = succeed "-simplex." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .un_prop
            %h6#proposition Proposition
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mi L
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \varphi :L \to K
              is a simplicial map and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an extendable system over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi φ
                      %mo *
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \varphi^*F
              is an extendable local system over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
          %p The proof is easy.
          .un_prop
            %h6#proposition_2 Proposition
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} L\subset K
              is a subsimplicial set and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an extendable local system over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(K)\to F(L)
              is surjective.
          %p
            The proof is again by induction up the skeleta of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is an extendable local system over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} L\subset K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(K)\to F(L)
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(K,L)
            and call it the
            = succeed "." do
              %em space of relative global sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(K,L)
            is given in detail in Halperin, p.XII-12.)
          %p
            It may be useful to have some more of the terminology of local systems available. A local system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is
            %strong constant
            if for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} F_0 \in \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi σ
                  %mo =
                  %msub
                    %mi F
                    %mn 0
                %annotation{:encoding => "application/x-tex"} F_\sigma = F_0
            and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                %annotation{:encoding => "application/x-tex"} d_i
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            is the identity map on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            %strong constant by dimension
            if for some sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi n
                  %mo ∈
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} F_n\in \mathcal{C}
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n \geq 0
            ),
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi σ
                    %mo =
                    %msub
                      %mi F
                      %mi n
                  %annotation{:encoding => "application/x-tex"} F_\sigma = F_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ∈
                  %msub
                    %mi K
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sigma \in K_n
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_j
            depend only on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \dim \sigma
          %p
            A local system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a
            %strong local system of coefficients
            if for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo :
                  %msub
                    %mi F
                    %mi σ
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi d
                        %mi i
                      %mi σ
                  %mspace{:width => "1em"}
                  %mi and
                  %msub
                    %mi s
                    %mi i
                  %mo :
                  %msub
                    %mi F
                    %mi σ
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mi σ
                %annotation{:encoding => "application/x-tex"} d_i : F_\sigma \to F_{d_i\sigma} \quad  and s_i : F_\sigma \to F_{s_i \sigma}
          %p
            are isomorphisms. Finally
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            %strong local system of differential coefficients
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is one of the categories with differentials above, and for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi d
                    %mi i
                    %mo *
                  %mo :
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi d
                        %mi i
                      %mi σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi and
                  %msubsup
                    %mi s
                    %mi i
                    %mo *
                  %mo :
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d_i^* : H(F_\sigma) \to H(F_{d_i\sigma}) \quad  and  s_i^* : H(F_\sigma) \to H(F_{s_i\sigma})
          %p are isomorphisms, in other words if the corresponding cohomology is a local system of coefficients.
          .un_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be extendable local systems of differential coefficients over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi σ
                    %mo :
                    %msub
                      %mi F
                      %mi σ
                    %mo →
                    %msub
                      %mi G
                      %mi σ
                    %mo ,
                    %mspace{:width => "1em"}
                    %mi σ
                    %mo ∈
                    %mi K
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \varphi_\sigma : F_\sigma \to G_\sigma, \quad \sigma \in K,
            %p
              compatible with the face and degeneracy operators. Then a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi : F(K)\to G(K)
              is given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi φ
                      %mi Φ
                      %mo{:stretchy => "false"} )
                      %mi σ
                      %mo =
                      %msub
                        %mi φ
                        %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Φ
                        %mi σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\varphi\Phi)\sigma = \varphi_\sigma (\Phi_\sigma)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi φ
                      %mo *
                    %mo :
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi^* : H(F(K))\to H(G(K))
            %p is an isomorphism.
          %h2#see_also See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
