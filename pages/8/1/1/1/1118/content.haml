                %path{:d => "M 20.765564 20.820049 L 101.217428 -20.601953 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.997734,0,0,-0.997734,152.336186,106.515051)"}
                %path{:d => "M -2.485848 2.869626 C -2.031149 1.148398 -1.021588 0.333836 -0.000228545 0.000977298 C -1.020658 -0.335087 -2.033687 -1.147373 -2.486074 -2.868854 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.886985,0.456723,0.456723,-0.886985,253.534913,127.180659)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "183.535317", "xlink:href" => "#ibXJMASfORoMxJ2XOZ7Vr-ibn8Y=-glyph2-4", :y => "116.926401"}
                  %use{:x => "186.468625", "xlink:href" => "#ibXJMASfORoMxJ2XOZ7Vr-ibn8Y=-glyph2-5", :y => "116.926401"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
