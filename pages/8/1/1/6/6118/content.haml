                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \eta: F \to G
            assigns to each 0-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            a
            %em vertical
            arrow
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mi b
                    %mo :
                    %mi F
                    %mi b
                    %mo →
                    %mi G
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \eta b: F b \to G b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo :
                  %mi b
                  %mo →
                  %mi b
                  %mo ′
                %annotation{:encoding => "application/x-tex"} r: b \to b'
            a 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mi r
                %annotation{:encoding => "application/x-tex"} \eta r
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi F
                              %mi r
                        %mtd
                          %mi F
                          %mi b
                          %mo ′
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mrow
                              %mi η
                              %mi b
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                          %mpadded{:width => "0"}
                            %mrow
                              %mi η
                              %mi r
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %mi η
                              %mi b
                              %mo ′
                      %mtr
                        %mtd
                          %mi G
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi G
                              %mi r
                        %mtd
                          %mi G
                          %mi b
                          %mo ′
                          %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F b &amp; \stackrel{F r}{\to} &amp; F b' \\
                  \\mathllap{\eta b} \downarrow &amp; \Downarrow \mathrlap{\eta r} &amp; \downarrow \mathrlap{\eta b'} \\
                  G b &amp; \stackrel{G r}{\to} &amp; G b';
                  }
          %p suitably compatible with the double category structures.
          %p
            We thus find that the op-lax structures of the transformations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi prin
                    %mo :
                    %mn 1
                    %mo →
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} prin: 1 \to \bar{\beta}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} m: \bar{\beta} \bar{\beta} \to \bar{\beta}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
            qua
            %em bicategory
            are exactly what we need to produce honest transformations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mn 1
                    %mo →
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} u: 1 \to \bar{\beta}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} m: \bar{\beta} \bar{\beta} \to \bar{\beta}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Rel
                %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
            qua
            = succeed "," do
              %em equipment
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Rel
                  %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
          %p
            Given a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on an equipment
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            %em horizontal Kleisli equipment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HKl
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HKl(\mathbf{B}, T)
            with the same 0-cells and vertical arrows as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi b
                    %mo →
                    %mi T
                    %mi b
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} r: b \to T b'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HKl
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HKl(\mathbf{B}, T)
            (with vertical source
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and vertical target
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi r
                        %mtd
                          %mi T
                          %mi b
                          %mo ′
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                          %mpadded{:width => "0"}
                            %mi α
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %mi T
                              %mi g
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %mover
                            %mo →
                            %mi s
                        %mtd
                          %mi T
                          %mi c
                          %mo ′
                          %mo ;
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  b &amp; \stackrel{r}{\to} &amp; T b' \\
                  \\mathllap{f} \downarrow &amp; \Downarrow \mathrlap{\alpha} &amp; \downarrow \mathrlap{T g} \\
                  c &amp; \stackrel{s}{\to} &amp; T c';
                  }
          %p
            with horizontal compositions being performed in familiar Kleisli fashion. (When we say “familiar Kleisli fashion”, we are using the fact that an equipment allows one to “translate” vertical arrows, in particular the map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi b
                    %mo :
                    %mi T
                    %mi T
                    %mi b
                    %mo →
                    %mi T
                    %mi b
                  %annotation{:encoding => "application/x-tex"} m_b: T T b \to T b
          %p
            In an equipment, there is a notion of monoid and monoid homomorphism. A
            %em monoid
            consists of a horizontal arrow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo :
                  %mi b
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} \xi: b \to b
            together with unit and multiplication 2-cells
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mn 1
                                %mi b
                        %mtd
                          %mi b
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi ξ
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi b
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mo →
                            %mi ξ
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mn 1
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                          %mpadded{:width => "0"}
                            %mi η
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mn 1
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                          %mpadded{:width => "0"}
                            %mi μ
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mn 1
                      %mtr
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi ξ
                        %mtd
                          %mi b
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi ξ
                        %mtd
                          %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  b &amp; \stackrel{1_b}{\to} &amp; b &amp; &amp; &amp; &amp; &amp; &amp; b &amp; \stackrel{\xi}{\to}\;\;\; b \;\;\; \stackrel{\xi}{\to} &amp; b\\
                  \\mathllap{1} \downarrow &amp; \Downarrow \mathrlap{\eta} &amp; \downarrow \mathrlap{1} &amp; &amp; &amp; &amp; &amp; &amp; \mathllap{1} \downarrow &amp; \Downarrow \mathrlap{\mu} &amp; \downarrow \mathrlap{1}\\
                  b &amp; \stackrel{\xi}{\to} &amp; b &amp; &amp; &amp; &amp; &amp; &amp; b &amp; \stackrel{\xi}{\to} &amp; b
                  }
          %p
            satisfying evident identities. A
            %em monoid homomorphism
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b, \xi)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi θ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c, \theta)
            consists of a vertical arrow and 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f, \phi)
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi b
                        %mtd
                          %mover
                            %mo →
                            %mi ξ
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇓
                          %mpadded{:width => "0"}
                            %mi ϕ
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mi f
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %munder
                            %mo →
                            %mi θ
                        %mtd
                          %mi c
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  b &amp; \stackrel{\xi}{\to} &amp; b \\
                  \\mathllap{f} \downarrow &amp; \Downarrow \mathrlap{\phi} &amp; \downarrow \mathrlap{f} \\
                  c &amp; \underset{\theta}{\to} &amp; c
                  }
          %p that is suitably compatible with the unit and multiplication cells.
          %p
            The following notion gives an
            %em interim
            notion of generalized multicategory that applies in particular to relational
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
          .num_defn
            %h6#definition_3 Definition
            %p
              Given a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              on an equipment
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %em monoid
              is a monoid in the horizontal Kleisli equipment
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi HKl
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo ,
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HKl(\mathbf{B}, T)
              %em map
              of
              = succeed "-monoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi HKl
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo ,
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HKl(\mathbf{B}, T)
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For the ultrafilter monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              on the equipment
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Rel
                    %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
              = succeed "-monoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "-monoids" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
          .proof
            %h6#proof_5 Proof
            %p
              This is really just a matter of unwinding definitions. The data of a
              = succeed "-monoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Rel
                  %annotation{:encoding => "application/x-tex"} \mathbf{Rel}
              amounts to a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              together with a horizontal arrow in the Kleisli construction, that is to say a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi X
                    %mo →
                    %mi β
                    %mi X
                  %annotation{:encoding => "application/x-tex"} c: X \to \beta X
              (opposite to our conventional direction, i.e.,
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %msup
                        %mi ξ
                        %mi o
                    %annotation{:encoding => "application/x-tex"} c = \xi^o
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              are inequalities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} 1_X \leq c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %msub
                      %mo ∘
                      %mi Kl
                    %mi c
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c \circ_{Kl} c \leq c
              (the vertical source and target being identity maps), where the identity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} 1_X
              in the Kleisli construction uses the unit for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              and the Kleisli composition uses the multiplication. Back in the bicategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              these translate to relational inequalities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi prin
                      %mi X
                    %mo ≤
                    %mi c
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi m
                      %mi X
                    %mo ∘
                    %mi β
                    %mi c
                    %mo ∘
                    %mi c
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} prin_X \leq c, \qquad m_X \circ \beta c \circ c \leq c
            %p
              or, with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %msup
                        %mi ξ
                        %mi o
                    %annotation{:encoding => "application/x-tex"} c = \xi^o
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi prin
                      %mi X
                    %mo ≤
                    %msup
                      %mi ξ
                      %mi o
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi m
                      %mi X
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi o
                    %mo ∘
                    %msup
                      %mi ξ
                      %mi o
                    %mo ≤
                    %msup
                      %mi ξ
                      %mi o
                    %mo .
                  %annotation{:encoding => "application/x-tex"} prin_X \leq \xi^o, \qquad m_X \circ (\beta (\xi))^o \circ \xi^o \leq \xi^o.
            %p These boil down to relational inequalities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                    %mo ≤
                    %msubsup
                      %mi prin
                      %mi X
                      %mi o
                    %mo ∘
                    %msup
                      %mi ξ
                      %mi o
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi o
                    %mo ∘
                    %msup
                      %mi ξ
                      %mi o
                    %mo ≤
                    %msubsup
                      %mi m
                      %mi X
                      %mi o
                    %mo ∘
                    %msup
                      %mi ξ
                      %mi o
                  %annotation{:encoding => "application/x-tex"} 1_X \leq prin_X^o \circ \xi^o, \qquad (\beta (\xi))^o \circ \xi^o \leq m_X^o \circ \xi^o
            %p or to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi X
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi prin
                      %mi X
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi ξ
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi m
                      %mi X
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} 1_X \leq \xi \circ prin_X, \qquad \xi \circ \beta (\xi) \leq \xi \circ m_X,
            %p
              as in the axioms on relational beta-modules. Similarly, a
              = succeed "-monoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, c) \to (Y, d)
              is a vertical arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi HKl
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Rel
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HKl(\mathbf{Rel}, \beta)
              together with a suitable 2-cell, which after some unraveling comes down to a relational inequality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi c
                    %mo ≤
                    %mi d
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \beta (f) \circ c \leq d \circ f
            %p
              or to an inequality
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msubsup
                        %mi ξ
                        %mi X
                        %mi o
                      %mo ≤
                      %msubsup
                        %mi ξ
                        %mi Y
                        %mi o
                      %mo ∘
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \beta (f) \circ \xi_X^o \leq \xi_Y^o \circ f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ξ
                        %mi X
                        %mi o
                      %mo ∘
                      %msup
                        %mi f
                        %mi o
                      %mo ≤
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi o
                      %mo ∘
                      %msubsup
                        %mi ξ
                        %mi Y
                        %mi o
                    %annotation{:encoding => "application/x-tex"} \xi_X^o \circ f^o \leq (\beta (f))^o \circ \xi_Y^o
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi ξ
                      %mi X
                    %mo ≤
                    %msub
                      %mi ξ
                      %mi Y
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ \xi_X \leq \xi_Y \circ \beta (f)
            %p
              as advertised in the notion of lax morphism of relational
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %a.maruku-ref{:href => "#contmap"}
              below).
          .num_remark
            %h6#remark_2 Remark
            %p
              In some sense, relational
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              acting on
              %em virtual
              equipments and study
              %em normalized
              = succeed "-monoids." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (T, V)
              = succeed "," do
                %a{:href => "#CHT2"} Clementino, Hofmann, Tholen
              %a{:href => "#Seal"} Seal
              and others as a way of bringing
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/approach+space"} approach spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Moore+closure"} closure spaces
              %a.existingWikiWord{:href => "/nlab/show/taut+monads"} taut monads
              to lax monads on
              = succeed "-matrices)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              The example of the ultrafilter monad acting on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              has just enough niceness to it (e.g., the Beck-Chevalley condition) that we are able to elide over most of the complications, while still giving a taste of the generality that goes beyond the “classical” examples of generalized multicategories involving cartesian monads and Kleisli constructions on bicategories of spans. Thus, relational beta-modules can serve as a useful key of entry into this subject.
          %h2#proof_of_main_theorem Proof of Main Theorem
          %p
            We now return to the task of proving theorem
            = succeed "." do
              %a.maruku-ref{:href => "#conc"}
          #open.num_remark
            %h6#remark_3 Remark
            %p
              For a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S, \mathcal{O})
              and a point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} x \in S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo =
                      %mi conv
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{O})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_x
              be the collection of
              %em open
              neighborhoods of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_\xi x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi x
                      %mo ⊆
                      %mi F
                    %annotation{:encoding => "application/x-tex"} N_x \subseteq F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi x
                      %mo ⊆
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_x \subseteq F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi x
                  %annotation{:encoding => "application/x-tex"} N_x
              is the filter generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_x
          .num_remark
            %h6#remark_4 Remark
            %p The following conditions are equivalent:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ξ
                        %mo =
                        %mi conv
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{C})
                  for some
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo ⊆
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{C} \subseteq P(S)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ξ
                        %mo =
                        %mi conv
                        %mo{:stretchy => "false"} (
                        %mi 𝒪
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{O})
                  for some topology
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒪
                          %mo ⊆
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{O} \subseteq P(S)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ξ
                        %mo =
                        %mi conv
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} (
                        %mi ξ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \xi = conv(\tau(\xi))
                  \.
            %p
              Indeed,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conv
                    %mo ∘
                    %mi τ
                    %mo ∘
                    %mi conv
                    %mo =
                    %mi conv
                  %annotation{:encoding => "application/x-tex"} conv \circ \tau \circ conv = conv
              by general properties of Galois connections. Applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conv
                    %mo ∘
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} conv \circ \tau
              to both sides of the first equation, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi conv
                    %mo ∘
                    %mi τ
                    %mo ∘
                    %mi conv
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} conv(\tau(\xi)) = (conv \circ \tau \circ conv)(\mathcal{C}) =  conv(\mathcal{C}) = \xi
            %p
              so the first equation implies the third. Which in turn implies the second, since we know by proposition
              %a.maruku-ref{:href => "#topo"}
              that collections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(\xi)
              are topologies. The second equation trivially implies the first.
          %p
            We now break up our Main Theorem
            %a.maruku-ref{:href => "#conc"}
            into the following two theorems.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo =
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{O})
              for a topology
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %a.maruku-eqref{:href => "#eq:rel1"} (1)
              are satisfied.
          .proof
            %h6#proof_6 Proof
            %p
              The first inequality (lax unit condition) was already verified in proposition
              = succeed "." do
                %a.maruku-ref{:href => "#pseudo"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              by a span
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mi S
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                      %mi R
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \beta S \stackrel{\pi_1}{\leftarrow} R \stackrel{\pi_2}{\to} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi o
                    %annotation{:encoding => "application/x-tex"} \beta(\xi) = \beta(\pi_2) \beta(\pi_1)^o
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 2
                    %msubsup
                      %mi π
                      %mn 1
                      %mi o
                    %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 2
