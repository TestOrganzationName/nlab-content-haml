                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in Rel(\beta S, S)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau(\xi) \subseteq P(S)
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi ξ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo ⊆
                  %mi S
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∀
                    %mrow
                      %mi F
                      %mo :
                      %mi β
                      %mi S
                      %mo ,
                      %mi x
                      %mo :
                      %mi S
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∈
                  %mi U
                  %mspace{:width => "thickmathspace"}
                  %mo ∧
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %msub
                    %mo ⇝
                    %mi ξ
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mi U
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \tau(\xi) \coloneqq \{U \subseteq S: \; (\forall_{F: \beta S, x: S})\; (x \in U \; \wedge\; F \rightsquigarrow_\xi x) \Rightarrow U \in F\}.
          #topo.num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(\xi)
              is a topology on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo :
                      %mi Rel
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mi S
                      %mo ,
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi: Rel(\beta S, S)
          .proof
            %h6#proof Proof
            %p
              It is trivial that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S \in \tau(\xi)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ,
                      %mi V
                      %mo ∈
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U, V \in \tau(\xi)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                    %mo ∩
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in U \cap V
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⇝
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in V
              and we conclude
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ,
                      %mi V
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U, V \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi V
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} U \cap V \in F
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an ultrafilter, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi V
                  %annotation{:encoding => "application/x-tex"} U \cap V
              satisfies the condition of belonging to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tau(\xi)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∈
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_i \in \tau(\xi)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mo ∪
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x \in \cup_i U_i
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⇝
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x \in U_i
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and we conclude
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U_i \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∪
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \cup_i U_i \in F
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is upward closed. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∪
                      %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \cup_i U_i
              satisfies the condition of belonging to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(\xi)
              (vacuously so if the collection is empty).
          #galois.num_prop
            %h6#proposition_2 Proposition
            %p
              There is a Galois connection between notions of convergence on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and subsets of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(S)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⊆
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mi ξ
                    %mo ⊆
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \subseteq \tau(\xi) \; \Leftrightarrow \; \xi \subseteq conv(\mathcal{C}).
          .proof
            %h6#proof_2 Proof
            %p
              To establish the bi-implication, it suffices to observe that both containments
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⊆
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \subseteq \tau(\xi)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ⊆
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \subseteq conv(\mathcal{C})
              are equivalent to the condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mrow
                        %mi F
                        %mo :
                        %mi β
                        %mi S
                    %msub
                      %mo ∀
                      %mrow
                        %mi U
                        %mo :
                        %mi P
                        %mi S
                    %msub
                      %mo ∀
                      %mrow
                        %mi x
                        %mo :
                        %mi S
                    %mo{:stretchy => "false"} (
                    %mi F
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \forall_{F: \beta S} \forall_{U: P S} \forall_{x: S} (F \rightsquigarrow_\xi x) \; \wedge \; (U \in \mathcal{C}) \; \wedge \; (x \in U) \; \; \Rightarrow \; \; (U \in F).
          #fix.num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              is a topology on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo =
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} = \tau(conv(\mathcal{O}))
              (i.e., topologies are fixed points of the
              %a.existingWikiWord{:href => "/nlab/show/closure+operator"} closure operator
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo ∘
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} conv
                    %annotation{:encoding => "application/x-tex"} \tau \circ \conv
          .proof
            %h6#proof_3 Proof
            %p
              We already have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo ⊆
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} \subseteq \tau(conv(\mathcal{O}))
              from Proposition
              = succeed "." do
                %a.maruku-ref{:href => "#galois"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              belonging to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(conv(\mathcal{O}))
              is an
              = succeed "-neighborhood" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in V
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is not an
              = succeed "-neighborhood" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              fixed, for every
              = succeed "-neighborhood" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi N
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \in N_x
              we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∩
                      %mo ¬
                      %mi V
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U \cap \neg V \neq \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mo ¬
                    %mi V
                  %annotation{:encoding => "application/x-tex"} U \cap \neg V
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              ranging over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi x
                  %annotation{:encoding => "application/x-tex"} N_x
              generate a filter. By the ultrafilter principle, we may extend this filter to an ultrafilter
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⇝
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi V
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \neg V \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⇝
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in \tau(conv(\mathcal{O}))
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} x \in V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} V \in F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi V
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \neg V \in F
          %p
            Propositions
            = succeed "," do
              %a.maruku-ref{:href => "#topo"}
            = succeed "," do
              %a.maruku-ref{:href => "#galois"}
            %a.maruku-ref{:href => "#fix"}
            more or less show that a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mi 𝒪
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S, \mathcal{O})
            is a particular type of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pseudotopological+space"} pseudotopological space
          .num_defn
            %h6#definition Definition
            %p
              A pseudotopological space is set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              equipped with a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi β
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \xi: \beta S \to S
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi S
                      %mo ≤
                      %mi ξ
                      %mo ∘
                      %msub
                        %mi u
                        %mi S
                    %annotation{:encoding => "application/x-tex"} 1_S \leq \xi \circ u_S
          %p All that remains is to check is:
          #pseudo.num_prop
            %h6#proposition_4 Proposition
            %p
              The lax unit condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi S
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi u
                      %mi S
                  %annotation{:encoding => "application/x-tex"} 1_S \leq \xi \circ u_S
              holds if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo =
                      %mi conv
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{O})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}
          %p
            The unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi S
                  %mo :
                  %mi S
                  %mo →
                  %mi β
                  %mi S
                %annotation{:encoding => "application/x-tex"} u_S: S \to \beta S
            may also be denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi prin
                      %mi S
                  %annotation{:encoding => "application/x-tex"} prin_S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} x \in S
            to the principal ultrafilter
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi prin
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo ⊆
                  %mi S
                  %mo :
                  %mi x
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} prin_S(x) = \{U \subseteq S: x \in U\}
          %p
            and now the unit condition says
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi prin
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⇝
                    %mi ξ
                  %mi x
                %annotation{:encoding => "application/x-tex"} prin_S(x) \rightsquigarrow_\xi x
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo =
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi = conv(\mathcal{O})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi x
                    %mo ⊆
                    %msub
                      %mi prin
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_x \subseteq prin_S(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} x \in V
            for all neighborhoods
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %msub
                      %mi N
                      %mi x
                  %annotation{:encoding => "application/x-tex"} V \in N_x
          %p One of our goals is to prove the following theorem:
          #conc.num_theorem
            %h6#theorem Theorem
            %p
              %strong (Main Theorem)
              An arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \xi: \beta(S) \to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} conv(\tau(\xi))
              if and only if the following inequalities are satisfied:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi S
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi prin
                      %mi S
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi ξ
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi m
                      %mi S
                  %annotation{:encoding => "application/x-tex"} 1_S \leq \xi \circ prin_S, \qquad \xi \circ \beta(\xi) \leq \xi \circ m_S
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi S
                    %mo :
                    %mi β
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m_S: \beta \beta(S) \to \beta(S)
              is the multiplication on the ultrafilter monad.
          %h2#functor
            Ultrafilter monad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
          %p
            Before rolling up our sleeves and proving the main theorem, we pause to consider some more abstract contexts in which to place the concept of lax
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
          %h3#extending_the_ultrafilter_functor_to_
            Extending the ultrafilter functor to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Rel
                %annotation{:encoding => "application/x-tex"} Rel
          %p
            First we examine more closely the extension of the ultrafilter functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo :
                  %mi Set
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \beta: Set \to Set
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
          .num_defn
            %h6#definition_2 Definition
            %p
              For a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} r: X \to Y
              between sets, given by a subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ↪
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} R \hookrightarrow X \times Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              with projections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f: R \to X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo :
                      %mi R
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} g: R \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar{\beta}(r)
              to be the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi f
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi o
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(X) \stackrel{\beta(f)^{o}}{\to} \beta(R) \stackrel{\beta(g)}{\to} \beta(Y)
            %p in the bicategory of relations.
          %p
            Any span of functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo :
                  %mi S
                  %mo →
                  %mi X
                  %mo ,
                  %mi k
                  %mo :
                  %mi S
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (h: S \to X, k: S \to Y)
            that represents
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            (in the sense that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo =
                  %mi k
                  %msup
                    %mi h
                    %mi o
                %annotation{:encoding => "application/x-tex"} r = k h^{o}
            in the bicategory of relations) would serve in place of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f, g)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi S
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} s: S \to R
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi f
                    %mi s
                  %annotation{:encoding => "application/x-tex"} h = f s
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi g
                    %mi s
                  %annotation{:encoding => "application/x-tex"} k = g s
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta(s)
            is epi (because the epi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            splits in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi f
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                        %mtd
                          %mo =
                        %mtd
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi s
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi f
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mi s
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi h
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi o
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\beta(g)\beta(f)^{o} &amp; = &amp; \beta(g)\beta(s)\beta(s)^{o}\beta(f)^{o} \\
                  \&amp; = &amp; \beta(g)\beta(s)(\beta(f)\beta(s))^{o} \\
                  \&amp; = &amp; \beta(g s)\beta(f s)^{o} \\
                  \&amp; = &amp; \beta(k)\beta(h)^{o}.
                  }
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\beta}
            is well-defined. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi β
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{\beta}
            extends
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \beta: Set \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta(r)
            in place of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar{\beta}(r)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≤
                    %mi r
                    %mo ′
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} r \leq r': X \to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta(r) \leq \beta(r')
            (as can be seen from the calculation displayed above, but replacing the epi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            by a general map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                  %annotation{:encoding => "application/x-tex"} \geq
          #oplax.num_remark
            %h6#remark Remark
            %p
              The same recipe works to extend any functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} T: Set \to Set
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rel
                    %annotation{:encoding => "application/x-tex"} Rel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi Rel
                    %mo →
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} \bar{T}: Rel \to Rel
              is always an
              %em op-lax
              functor in the sense that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar{T}(r s) \leq \bar{T}(r) \bar{T}(s)
            %p
              as is easily seen by contemplating a pullback diagram (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mi g
                    %msup
                      %mi f
                      %mi o
                  %annotation{:encoding => "application/x-tex"} r = g f^{o}
              and
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo =
                      %mi k
                      %msup
                        %mi h
                        %mi o
                    %annotation{:encoding => "application/x-tex"} s = k h^{o}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Q
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi p
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi q
                          %mtd
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi R
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi S
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi g
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi h
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi k
                          %mtd
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; &amp; &amp; Q &amp; &amp; &amp; &amp; \\
                    \&amp; &amp; &amp; \mathllap{p} \swarrow &amp; &amp; \searrow \mathrlap{q} &amp; &amp; &amp; \\
                    \&amp; &amp; R &amp; &amp; &amp; &amp; S &amp; &amp; \\
                    \&amp; \mathllap{f} \swarrow &amp; &amp; \searrow \mathrlap{g} &amp; &amp; \mathllap{h} \swarrow &amp; &amp; \searrow \mathrlap{k} &amp; \\
                    X &amp; &amp; &amp; &amp; Y &amp; &amp; &amp; &amp; Z
                    }
            %p whereupon one calculates
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} ¯
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mi q
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi o
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi p
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi o
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi o
                        %mtr
                          %mtd
                          %mtd
                            %mo ≤
                          %mtd
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi h
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi o
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mi f
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi o
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} ¯
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} )
                            %mover
                              %mi T
                              %mo{:stretchy => "false"} ¯
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bar{T}(r s) &amp; = &amp; T(k q) T(f p)^{o} \\
                    \&amp; = &amp; T(k) T(q) T(p)^{o} T(f)^{o} \\
                    \&amp; \leq &amp; T(k) T(h)^{o} T(g) T(f)^{o} \\
                    \&amp; = &amp; \bar{T}(r) \bar{T}(s)
                    }
            %p
              where the inequality comes from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi p
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi o
                      %mo ≤
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi h
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi o
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(q) T(p)^{o} \leq T(h)^{o} T(g)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(h) T(q) \leq T(g) T(p)
              (where even equality holds). This calculation shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{T}
              is an actual (not just an op-lax) functor on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              satisfies the
              %strong Beck-Chevalley
              condition: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p, q)
              is a pullback of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g, h)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi o
                    %mo =
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi h
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi o
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} T(q) T(p)^{o} = T(h)^{o} T(g).
            %p
              This in turn amounts to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              preserving weak pullbacks. (It actually says
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              takes pullbacks to weak pullbacks, but this implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              takes weak pullbacks to weak pullbacks because any endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              preserves epis, using the axiom of choice.)
          #BC.num_prop
            %h6#proposition_5 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \beta: Set \to Set
              satisfies the Beck-Chevalley condition (and therefore the extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi Rel
                    %mo →
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} \beta: Rel \to Rel
              is a strict functor).
          .proof
            %h6#proof_4 Proof
            %p
              Referring to the pullback diagram in Remark
              = succeed "," do
                %a.maruku-ref{:href => "#oplax"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo =
                    %mi R
                    %msub
                      %mo ×
                      %mi Y
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Q = R \times_Y S
              be the pullback. We must show that the canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi R
                    %msub
                      %mo ×
                      %mi Y
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(R \times_Y S) \to \beta(R) \times_{\beta(Y)} \beta(S)
            %p is epic. Viewing this as a continuous map between compact Hausdorff spacesaudorff space#ultrafilters_form_a_compactum_23), it suffices to show that the canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mo ×
                      %mi Y
                    %mi S
                    %mo →
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R \times_Y S \to \beta(R) \times_{\beta(Y)} \beta(S)
            %p
              has a dense image. Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mrow
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G, H) \in \beta(R) \times_{\beta(Y)} \beta(S)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(g)(G) = \beta(h)(H)
              are the same ultrafilter
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ∈
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J \in \beta(Y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{B}
              be basic open neighborhoodsausdorff space#the_space_of_ultrafilters_19) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(R)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(S)
              respectively; we must show that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi R
                    %msub
                      %mo ×
                      %mi Y
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (r, s) \in R \times_Y S
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo ×
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} (prin(r), prin(s)) \in \hat{A} \times \hat{B}
            %p
              or in other words such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} r \in A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} s \in B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi G
