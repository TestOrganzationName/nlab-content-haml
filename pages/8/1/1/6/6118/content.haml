          %p The next theorem establishes the converse of the preceding theorem; the two theorems together establish the Main Theorem. First we need a remark and a lemma.
          #closed0.num_remark
            %h6#remark_5 Remark
            %p
              Given any relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi Rel
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mi S
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi: Rel(\beta S, S)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi S
                    %annotation{:encoding => "application/x-tex"} A \subseteq S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is closed wrt the topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(\xi)
              if and only if for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} x \in S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mrow
                        %mi F
                        %mo :
                        %mi β
                        %mi S
                    %mi A
                    %mo ∈
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (\exists_{F: \beta S} A \in F \; \wedge \; F \rightsquigarrow_\xi x) \implies x \in A
            %p
              This follows by inverting the definition of the open sets in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
