          #closed.num_lemma
            %h6#lemma Lemma
            %p
              If a relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi Rel
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mi S
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi: Rel(\beta S, S)
              satisfies the inequalities of
              %a.maruku-eqref{:href => "#eq:rel1"} (1)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi S
                    %annotation{:encoding => "application/x-tex"} x: S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi S
                    %annotation{:encoding => "application/x-tex"} A \subseteq S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              belongs to the closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{A}
              wrt the topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(\xi)
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mrow
                          %mi F
                          %mo :
                          %mi β
                          %mi S
                      %mi A
                      %mo ∈
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \exists_{F: \beta S} A \in F \; \wedge \; F \rightsquigarrow_\xi x
          .proof
            %h6#proof_7 Proof
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi S
                    %annotation{:encoding => "application/x-tex"} A \subseteq S
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo +
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %msub
                        %mo ∃
                        %mrow
                          %mi F
                          %mo :
                          %mi β
                          %mi S
                      %mi A
                      %mo ∈
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo ∧
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A^+ = \{x \mid \exists_{F: \beta S} A \in F \; \wedge \; F \rightsquigarrow_\xi x\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo +
                      %mo =
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} A^+ = \bar{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %msup
                      %mi A
                      %mo +
                    %mo ⊆
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} A \subseteq A^+ \subseteq \bar{A}
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A^+
              is closed.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %mo ⊆
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} A^+ \subseteq \bar{A}
              is clear from the characterization of closed sets given in Remark
              = succeed ";" do
                %a.maruku-ref{:href => "#closed0"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A^+
              is in some sense the “one-step closure” of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %msup
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A \subseteq A^+
              follows from the lax unit condition for relational
              = succeed "-modules:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} prin(x) \rightsquigarrow_\xi x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi prin
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in prin(x)
            %p
              It’s clear from the characterization of closed sets given in Remark
              %a.maruku-ref{:href => "#closed0"}
              that a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is closed if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} A = A^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A^+
              is closed by showing that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo +
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo +
                      %mo =
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} (A^+)^+ = A^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %mo ⊆
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A^+ \subseteq (A^+)^+
              so we just need the reverse containment. So suppose that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi A
                        %mo +
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo +
                    %annotation{:encoding => "application/x-tex"} x \in (A^+)^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi β
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F \in \beta S
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} A^+ \in F
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_\xi x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} x \in A^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo ∈
                    %mi β
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F' \in \beta S
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi F
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A \in F'
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ′
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F' \rightsquigarrow_\xi x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ∈
                      %mi β
                      %mi R
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \beta R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              extending the following
              %a{:href => "http://ncatlab.org/nlab/show/filter#filterbases"} filterbase
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi U
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 = \{\pi_1^{-1}(\hat{A}) \cap \pi_2^{-1}(U) \mid U \in F\}
            %p
              will fit the bill. First let us verify that such an ultrafilter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              exists. By the ultrafilter principle, it suffices to verify that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              generates a proper filter. It’s clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              is closed under finite intersection. So the filter it generates is proper iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              is proper, i.e. doesn’t contain the empty set. Now, a typical element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∈
                    %mi β
                    %mi S
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi A
                    %mo ∈
                    %mi G
                    %mo ,
                    %mi G
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \pi_1^{-1}(\hat{A}) \cap \pi_2^{-1}(U) = \{(G \in \beta S, \; y \in U) \mid A \in G, G \rightsquigarrow_\xi y\}
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} U \in F
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mo +
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} A^+ \in F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi U
                      %mo ∩
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} y \in U \cap A^+
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} y \in A^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi β
                    %mi S
                  %annotation{:encoding => "application/x-tex"} G \in \beta S
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} A \in G
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi y
                  %annotation{:encoding => "application/x-tex"} G \rightsquigarrow_\xi y
              as desired.
            %p
              So we can pick a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %mi β
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \beta R
              extending
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_0
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \beta \pi_2(\mathcal{G}) \rightsquigarrow_\xi x
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi F
                      %mo ′
                      %mo :
                      %mo =
                      %msub
                        %mi m
                        %mi S
                      %mo{:stretchy => "false"} (
                      %mi β
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in F':= m_S(\beta \pi_1(\mathcal{G}))
            %p
              This will complete the proof: From (1) it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F' \rightsquigarrow_\xi x
              by lax associativity. Then (2), along with the fact that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ′
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F' \rightsquigarrow_\xi x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi A
                        %mo +
                    %annotation{:encoding => "application/x-tex"} x \in A^+
            %p
              To show (1) we show that
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \beta \pi_2(\mathcal{G}) = F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_\xi x
              by hypothesis. Since both sides of the equations are ultrafilters, It further suffices to show that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊆
                      %mi β
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F \subseteq \beta \pi_2(\mathcal{G})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi β
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \in \beta \pi_2(\mathcal{G})
              i.e. that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 2
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \pi_2^{-1}(U) \in \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \pi_1^{-1}(\hat{A}) \cap \pi_2^{-1}(U) \in \mathcal{G}
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is upward closed.
            %p
              For (2) we want to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi m
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi β
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in m_S(\beta \pi_1(\mathcal{G}))
              i.e. that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %mi β
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat{A} \in \beta \pi_1(\mathcal{G})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \pi_1^{-1}(\hat{A}) \in \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \pi_1^{-1}(\hat{A}) \cap \pi_2^{-1}(U) \in \mathcal{G}
              and the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is upward closed.
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi β
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \xi: \beta S \to S
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
              satisfies the inequalities of
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:rel1"} (1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo =
                      %mi conv
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi = conv(\tau(\xi))
          .proof
            %h6#proof_8 Proof
            %p
              We have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ≤
                    %mi conv
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \leq conv(\tau(\xi))
              from the Galois connection (proposition
              = succeed ")," do
                %a.maruku-ref{:href => "#galois"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi conv
                      %mo{:stretchy => "false"} (
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi ξ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} conv(\tau(\xi)) \leq \xi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⇝
                      %mrow
                        %mi conv
                        %mo{:stretchy => "false"} (
                        %mi τ
                        %mo{:stretchy => "false"} (
                        %mi ξ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_{conv(\tau(\xi))} x
              (henceforth abbreviated as
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ⇝
                        %mrow
                          %mi τ
                          %mo{:stretchy => "false"} (
                          %mi ξ
                          %mo{:stretchy => "false"} )
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_{\tau(\xi)} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_\xi x
              under the conditions
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:rel1"} (1)
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ⇝
                        %mrow
                          %mi τ
                          %mo{:stretchy => "false"} (
                          %mi ξ
                          %mo{:stretchy => "false"} )
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_{\tau(\xi)} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              belongs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              intersects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              in a nonempty set. But this just means
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} x \in \bar{U}
              for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} U \in F
              = succeed ")" do
                %a.maruku-ref{:href => "#closed"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∃
                      %mrow
                        %mi G
                        %mo :
                        %mi β
                        %mi S
                    %mi U
                    %mo ∈
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                    %mo .
                  %annotation{:encoding => "application/x-tex"} U \in F \; \; \vdash \; \; \exists_{G: \beta S} U \in G \; \wedge \; G \rightsquigarrow_\xi x.
            %p
              Representing the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              as usual by a subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi π
                        %mn 1
                      %mo ,
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi R
                      %mo ↪
                      %mi β
                      %mi S
                      %mo ×
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \langle \pi_1, \pi_2 \rangle: R \hookrightarrow \beta S \times S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi β
                        %mi S
                        %mo ×
                        %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ∈
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \exists_{(G, x): \beta S \times S} \; (G, x) \in R \; \wedge \; G \in \hat{U}
            %p or
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mrow
                        %mi γ
                        %mo :
                        %mi R
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ^
                    %mo ∧
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \exists_{\gamma: R} \pi_1(\gamma) \in \hat{U} \wedge \pi_2(\gamma) = x
            %p or even just
            #eq:ult.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \pi_1^{-1}(\hat{U}) \wedge \pi_2^{-1}(\{x\}) \neq \emptyset
            %p
              as subsets of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              ranges over all elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.maruku-eqref{:href => "#eq:ult"} (4)
              generate a proper filter of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ∈
                      %mi β
                      %mi R
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \beta R
            %p By construction, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %mi B
                    %mo ⊆
                    %mi X
                    %mo :
                    %msubsup
                      %mi π
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒢
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "2em"}
                    %msub
                      %mi prin
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %mi A
                    %mo ⊆
                    %mi X
                    %mo :
                    %msubsup
                      %mi π
                      %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi 𝒢
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} F \subseteq \{B \subseteq X: \pi_1^{-1}(\hat{B})) \in \mathcal{G}\} \qquad prin_S(x) \subseteq \{A \subseteq X: \pi_2^{-1}(A) \in \mathcal{G}\}
            %p but in fact these inclusions are equalities since the left sides and right sides are ultrafilters. Put differently, we have established
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mi S
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "2em"}
                    %msub
                      %mi prin
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} F = (m_S \circ \beta(\pi_1))(\mathcal{G}), \qquad prin_S(x) = \beta(\pi_2)(\mathcal{G}).
            %p
              Notice that the lax unit condition of
              %a.maruku-eqref{:href => "#eq:rel1"} (1)
              implies that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi prin
                        %mi S
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} prin_S(x) = \beta(\pi_2)(\mathcal{G}) \rightsquigarrow_\xi x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{G}, x)
              belongs to the relation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo ∘
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi \circ \beta(\pi_2)
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:assoc"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi ξ
                    %mo ∘
                    %msub
                      %mi m
                      %mi S
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ;
                  %annotation{:encoding => "application/x-tex"} \xi \circ \beta(\pi_2) \leq \xi \circ m_S \circ \beta(\pi_1);
            %p
              in other words
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{G}, x)
              belongs to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo ∘
                      %msub
                        %mi m
                        %mi S
                      %mo ∘
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi \circ m_S \circ \beta(\pi_1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi m
                        %mi S
                      %mo ∘
                      %mi β
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F = (m_S \circ \beta(\pi_1))(\mathcal{G}) \rightsquigarrow_\xi x
          %p
            This completes the proof of the Main Theorem (theorem
            = succeed ")." do
              %a.maruku-ref{:href => "#conc"}
          %h2#continuous_maps Continuous maps
          #contmap.num_theorem
            %h6#theorem_4 Theorem
            %p
              A function between two topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is continuous if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi ξ
                    %mo ≤
                    %mi θ
                    %mo ∘
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ \xi \leq \theta \circ \beta(f)
              for their respective topological notions of convergence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo ,
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \xi, \theta
          .proof
            %h6#proof_9 Proof
            %p
              Suppose first that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
