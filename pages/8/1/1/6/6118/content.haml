            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo :
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \epsilon: X \to 1
            is proper (and these facts remain true even for pseudotopological spaces). See
            = succeed "," do
              %a{:href => "#CHJ"} Clementino, Hofmann, and Janelidze
            %em infra
            corollary 2.5.
          %p
            The following
            %em ultrafilter interpolation
            result is due to
            = succeed ":" do
              %a{:href => "#Pis"} Pisani
          .un_theorem
            %h6#theorem_5 Theorem
            %p
              A topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \xi)
              is exponentiable if, whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi 𝒰
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⇝
                      %mi ξ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} m_X(\mathcal{U}) \rightsquigarrow_\xi x
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo ∈
                    %mi β
                    %mi β
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} \in \beta\beta X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi β
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F \in \beta X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %msub
                      %mo ⇝
                      %mrow
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi ξ
                        %mo{:stretchy => "false"} )
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} \rightsquigarrow_{\beta(\xi)} F
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ⇝
                        %mi ξ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F \rightsquigarrow_\xi x
          %p
            For an convergence-approach extension of this result to exponentiable
            %em maps
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            = succeed "." do
              %a{:href => "#CHT"} Clementino, Hofmann, and Tholen
          .num_defn
            %h6#definition_4 Definition
            %p
              A continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is a
              %em discrete fibration
              if, whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⇝
                    %mi y
                  %annotation{:encoding => "application/x-tex"} G \rightsquigarrow y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f(x) = y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in \beta(X)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \beta(f)(F) = G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⇝
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F \rightsquigarrow x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_prop
            %h6#proposition_7 Proposition
            %p
              A continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is étale (a local homeomorphism) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \delta_f: X \to X \times_Y X
              are both discrete fibrations.
          %p
            For more on this, see
            = succeed "." do
              %a{:href => "#CHJ"} Clementino, Hofmann, and Janelidze
          %h2#relation_to_nonstandard_analysis Relation to nonstandard analysis
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/nonstandard+analysis"} nonstandard analysis
            (which implicitly relies throughout on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi UF
                  %annotation{:encoding => "application/x-tex"} UF
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^*
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            is a hyperpoint and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a standard point, then we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ≈
                  %mi x
                %annotation{:encoding => "application/x-tex"} u \approx x
            and say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a
            %strong
              %span.newWikiWord
                standard part
                %a{:href => "/nlab/new/standard+part"} ?
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            or that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            belongs to the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/halo"} halo
            (or
            = succeed "," do
              %em monad
            %em not
            the category-theoretic kind) of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %em the
            standard part of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            only for Hausdorff spaces.)
          %p
            So ultrafilters behave very much like hyperpoints. This is not to say that ultrafilters
            %em are
            (or even can be) hyperpoints, as they don't obey the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transfer+principle"} transfer principle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/model"} model
          %h2#relation_to_other_topological_concepts Relation to other topological concepts
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is treated as a monad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            instead of on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rel
                  %annotation{:encoding => "application/x-tex"} Rel
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi UP
                  %annotation{:encoding => "application/x-tex"} UP
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter+monad"} ultrafilter monad
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
          %p
            One might hope that there would be an analogous treatment of
            %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
            based on an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            between ultrafilters. (In nonstandard analysis, this becomes a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≈
                %annotation{:encoding => "application/x-tex"} \approx
            of infinite closeness between arbitrary hyperpoints, instead of only a relation between hyperpoints and standard points.) The description in terms of generalized multicategories is known to generalize to a description of uniform spaces, but rather than using relations between ultrafilters, this description uses pro-relations between points.
          %p
            For more on relations between Barr’s approach to topological spaces, Lawvere’s approach to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform structures
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prometric+spaces"} prometric spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/approach+space"} approach structures
            = succeed "." do
              %a{:href => "#CHT2"} Clementino, Hofmann, and Tholen
          %h2#references References
          %ul#Barr
            %li
              Michael Barr,
              = succeed "," do
                %em Relational algebras
              = succeed ")" do
                %a{:href => "https://www.math.mcgill.ca/barr/papers/relalgs.pdf"} pdf
          %ul#CHJ
            %li
              Maria Manuel Clementino, Dirk Hofmann, and George Janelidze,
              = succeed "," do
                %em On exponentiability of étale algebraic homomorphisms
              = succeed ")" do
                %a{:href => "http://www.mat.uc.pt/preprints/ps/p1135.pdf"} pdf
          %ul#CHT
            %li
              Maria Manuel Clementino, Dirk Hofmann, and Walter Tholen,
              = succeed "," do
                %em The convergence approach to exponentiable maps
              = succeed ")" do
                %a{:href => "https://eudml.org/doc/51942"} web
              = succeed ")" do
                %a{:href => "https://cmuc.mat.uc.pt/rdonweb/publications/publication22.pdf"} pdf
          %ul#CHT2
            %li
              Maria Manuel Clementino, Dirk Hofmann, and Walter Tholen,
              %em One Setting for All: Metric, Topology, Uniformity, Approach Structure.
              (
              %a{:href => "https://link.springer.com/article/10.1023/B:APCS.0000018144.87456.10"}> Springer Link
              , doi: 10.1023/B:APCS.0000018144.87456.10)
          %ul#Seal
            %li
              Gavin J. Seal,
              = succeed "," do
                %em Canonical and op-canonical lax algebras
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/14/10/14-10abs.html"} web
          %ul#Pis
            %li
              Claudio Pisani, Convergence in exponentiable spaces, Theory Appl. Categories 5 (1999), 148-162. (
              %a{:href => "http://www.tac.mta.ca/tac/volumes/1999/n6/5-06abs.html"}> web
              )
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"} Geoff Cruttwell
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
              = succeed "," do
                %em A unified framework for generalized multicategories
              %a{:href => "http://arxiv.org/abs/0907.2460"} arxiv/0907.2460
