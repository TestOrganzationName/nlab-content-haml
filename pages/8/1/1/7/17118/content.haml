          %h2#definition Definition
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 4
                  %mi n
                %annotation{:encoding => "application/x-tex"} 4n
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            is called a
            %em quaternion-Kähler manifold
            if its
            %a.existingWikiWord{:href => "/nlab/show/holonomy+group"} holonomy group
            is a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of
            %a.existingWikiWord{:href => "/nlab/show/Sp%28n%29.Sp%281%29"} Sp(n).Sp(1)
            (where
            %a.existingWikiWord{:href => "/nlab/show/Sp%28n%29"} Sp(n)
            is the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} Sp(1) \simeq SU(2) \simeq
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
            %a.existingWikiWord{:href => "/nlab/show/central+product"} central product
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            of the
            %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
            by the
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            %a.existingWikiWord{:href => "/nlab/show/center"} center
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            group is in fact a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of just the
            = succeed "-factor," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(n)
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/hyperk%C3%A4hler+manifold"} hyperkähler manifold
          %p
            Quaternion-Kähler manifolds are necessarily
            %a.existingWikiWord{:href => "/nlab/show/Einstein+manifolds"} Einstein manifolds
            (see
            = succeed ")." do
              %a{:href => "#AsEinsteinManifolds"} below
            %a.existingWikiWord{:href => "/nlab/show/scalar+curvature"} scalar curvature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} R \in \mathbb{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            = succeed "." do
              %em positive quaternion-Kähler manifold
          %p
