          %p
            %br/
          %p
            Moreover, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebra"} metric Lie algebra
          %p 1) write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
