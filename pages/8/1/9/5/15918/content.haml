                  %annotation{:encoding => "application/x-tex"} F(X) = 1 + X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mn 1
                  %mo +
                  %mi N
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} (0, s): 1 + N \to N
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            axiom says that the only
            = succeed "-subalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            itself. (In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mi N
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} (0, s): F N \to N
            is tautologically an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/algebra+of+an+endofunctor"} algebra
            map where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi N
                %annotation{:encoding => "application/x-tex"} F N
            is given the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                    %mi F
                    %mi N
                    %mo →
                    %mi F
                    %mi N
                  %annotation{:encoding => "application/x-tex"} F(0, s): F F N \to F N
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mi N
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} (0, s): F N \to N
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            It may be shown that these properties determine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            up to isomorphism (one says second-order Peano arithmetic is ‘categorical’, but this is not at all related to the notion of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          .num_prop
            %h6#proposition Proposition
            %p
              In a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
              (and natural numbers objects satisfy the Peano axioms).
          %p
            This is a special case of a much more general result which is part of the general theory of
            %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/well-founded+coalgebras"} well-founded coalgebras
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}
              is a topos and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi E
