              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose structure map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo :
                    %mi F
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \xi: F X \to X
              is
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monic
              and for which the only
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
