                      %mo +
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \forall_{x, y} x \cdot s(y) = x \cdot y + x
                ;
            %li
              %p
                (Induction scheme) For all formulas
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %msub
                        %mi y
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi y
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ;
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x, y_1, \ldots, y_k) = \phi(x; \vec{y})
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k+1
                free variables,
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∀
                        %mrow
                          %msub
                            %mi y
                            %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi y
                            %mi k
                      %mo{:stretchy => "false"} [
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mo ∀
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ;
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ;
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo ⇒
                      %msub
                        %mo ∀
                        %mi z
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \forall_{y_1, \ldots, y_k} [\phi(0, \vec{y}) \wedge \forall_x (\phi(x; \vec{y}) \Rightarrow \phi(s(x); \vec{y}))] \Rightarrow \forall_z \phi(z, \vec{y}).
          %p
            The third axiom is actually redundant, being an instance of the induction scheme (take
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo =
                    %mn 0
                    %mo ∨
                    %msub
                      %mo ∃
                      %mi y
                    %mi x
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \phi(x) = [x = 0 \vee \exists_y x = s(y)]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Robinson+arithmetic"} Robinson arithmetic
          %p
            In addition, the additional parameters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi y
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{y}
            are not needed in the induction scheme; adding the induction scheme for first-order formulae
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi(x)
            where the only parameter is
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %ul
            %li
              (Induction scheme) For all formulas
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mo ∀
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo ⇒
                      %msub
                        %mo ∀
                        %mi z
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} [\phi(0) \wedge \forall_x (\phi(x) \Rightarrow \phi(s(x)))] \Rightarrow \forall_z \phi(z).
          %p
            results in an equivalent theory to Peano arithmetic. See
            = succeed "." do
              %a{:href => "https://mathoverflow.net/questions/79174/parameters-in-arithmetic-induction-axiom-schemas"} Parameters in arithmetic induction axiom schemas
          %p
            By the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lowenheim-Skolem+theorem"} Lowenheim-Skolem theorem
            %a.existingWikiWord{:href => "/nlab/show/nonstandard+model+of+arithmetic"} "nonstandard" models
            of any infinite cardinality of Peano arithmetic.
          %h3#formalization Formalization
          %p
            We present here a formalization of first-order Peano arithmetic in a
            %a.existingWikiWord{:href => "/nlab/show/deduction+system"} deduction system
            using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            %a.existingWikiWord{:href => "/nlab/show/universe+hierarchy"} universe hierarchy
            of
            %a.existingWikiWord{:href => "/nlab/show/Russell+universes"} Russell universes
            or
            %a.existingWikiWord{:href => "/nlab/show/Coquand+universes"} Coquand universes
            in many
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theories"} dependent type theories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
          %p
            First-order Peano arithmetic, as a
            %a.existingWikiWord{:href => "/nlab/show/first-order+theory"} first-order theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sorts"} sorts
            %a.existingWikiWord{:href => "/nlab/show/judgments"} judgments
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %annotation{:encoding => "application/x-tex"} \Gamma \; \mathrm{ctx}
                , that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                is a
                %a.existingWikiWord{:href => "/nlab/show/context"} context
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %annotation{:encoding => "application/x-tex"} \phi \; \mathrm{prop}
                , that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/proposition"} proposition
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %annotation{:encoding => "application/x-tex"} \phi \; \mathrm{true}
                , that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is a
                %a.existingWikiWord{:href => "/nlab/show/true"} true
                proposition,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} sort
                    %annotation{:encoding => "application/x-tex"} A \; \mathrm{sort}
                , that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sort"} sort
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
                , that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                is in sort
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          %p In addition, we have rules stating that one could form the empty context, and one could add true proposition judgments and element judgments to the list of contexts:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} sort
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo ∈
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                %annotation{:encoding => "application/x-tex"} \frac{}{() \; \mathrm{ctx}} \qquad \frac{\Gamma \; \mathrm{ctx} \quad \Gamma \vdash P \; \mathrm{prop}}{(\Gamma, P \; \mathrm{true}) \; \mathrm{ctx}} \qquad \frac{\Gamma \; \mathrm{ctx} \quad \Gamma \vdash A \; \mathrm{sort}}{(\Gamma, a \in A) \; \mathrm{ctx}}
          %p We also have rules saying that given a context with a true proposition or element judgment, said judgment holds:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo ∈
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi x
                      %mo ∈
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{(\Gamma, P \; \mathrm{true}, \Delta) \; \mathrm{ctx}}{(\Gamma, P \; \mathrm{true}, \Delta) \vdash P \; \mathrm{true}} \qquad \frac{(\Gamma, x \in A, \Delta) \; \mathrm{ctx}}{(\Gamma, x \in A, \Delta) \vdash x \in A}
          %p
            In addition, we have the
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
            for
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/propositional+logic"} propositional logic
          %ul
            %li
              Inference rules for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/true"} true
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo ⊤
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo ⊤
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \top \; \mathrm{prop}} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \top \; \mathrm{true}}
          %ul
            %li
              Inference rules for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/false"} false
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ,
                      %mo ⊥
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \bot \; \mathrm{prop}} \qquad \frac{\Gamma \vdash P \; \mathrm{prop}}{\Gamma, \bot \; \mathrm{true} \vdash P \; \mathrm{true}}
          %ul
            %li
              Inference rules for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} logical conjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo ∧
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo ∧
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo ∧
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo ∧
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash P \; \mathrm{prop} \quad \Gamma \vdash Q \; \mathrm{prop}}{\Gamma \vdash P \wedge Q \; \mathrm{prop}} \qquad \frac{\Gamma \vdash P \; \mathrm{true} \quad \Gamma \vdash Q \; \mathrm{true}}{\Gamma \vdash P \wedge Q \; \mathrm{true}} \qquad \frac{\Gamma \vdash P \wedge Q \; \mathrm{true}}{\Gamma \vdash P \; \mathrm{true}} \qquad \frac{\Gamma \vdash P \wedge Q \; \mathrm{true}}{\Gamma \vdash Q \; \mathrm{true}}
          %ul
            %li
              Inference rules for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mo ∨
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                      %mo ⊢
                      %mi P
                      %mo ∨
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
