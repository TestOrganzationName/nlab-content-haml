          .proof
            %h6 Proof
            %p
              By
              %a{:href => "#SYH10"} SYH 10
              we have the following morphism:
            #eq:AComparisonMoprphismForShapeOfDiffeologicalMappingSpace.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cdfflg
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
