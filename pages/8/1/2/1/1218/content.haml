                        %msub
                          %mi{:mathvariant => "normal"} W
                          %mi wh
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi Cdfflg
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mi Cdfflg
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi smap
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Maps
                      %mi dfflg
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Cdfflg
                    \\big(
                    Maps_{Top}(X,\,A)
                    \\big)
                    \\underoverset
                    { \in Cdfflg(\mathrm{W}_{wh}) }
