          %h2#idea Idea
          %p
            %strong Tambara functors
            are algebraic structures similar to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Mackey+functors"} Mackey functors
            = succeed ")." do
              %a{:href => "#Tam93"} Tam93
          %blockquote
            %p
              In the
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Green+functors"} Green functors
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Green+functor"} Green functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi K
                  %annotation{:encoding => "application/x-tex"} H \subset K
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")" do
                %a{:href => "#Hill17"} Hill 17
            %p
              A Mackey functor is represented by a “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-equivariant Eilenberg–MacLane spectrum”, … a Tambara functor is represented by a commutative “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              \-equivariant Eilenberg-MacLane ring spectrum” (
              %a{:href => "#AB15"}> AB15
              )
          %h2#definition Definition
          %h3#in_parts In parts
          %p
            Given a sequence of maps of finite
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi g
                    %mi Y
                    %mover
                      %mo →
                      %mi h
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{g} Y \xrightarrow{h} Z
            %strong distributor
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mi X
                    %mover
                      %mo ←
                      %mi p
                    %mi A
                    %mover
                      %mo →
                      %mi q
                    %mi B
                    %mover
                      %mo →
                      %mi r
                    %mi Z
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta(g,h) = \left( X \xleftarrow{p} A \xrightarrow{q} B \xrightarrow{r} Z \right)
          %p by setting
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ≔
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi z
                    %mo ∈
                    %mi Z
                    %mo ,
                    %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi h
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ,
                    %mtext s.t.
                    %mi gs
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %msup
                          %mi h
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  B \coloneqq \left\{ (z,s) \mid z \in Z, s\colon h^{-1}(z) \rightarrow X, \text{ s.t. } gs = \mathrm{id}_{h^{-1}(z)} \right\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≔
                  %mi Y
                  %msub
                    %mo ×
                    %mi Z
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A \coloneqq Y \times_Z B
          %p
            and setting
            = succeed "," do
