                %path{:d => "M -2.486345 2.870537 C -2.03146 1.149033 -1.019733 0.333377 -0.000162859 0.0000563191 C -1.019733 -0.333265 -2.03146 -1.14892 -2.486345 -2.870425 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,9.020996%,92.156982%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.996131,0,0,-0.996131,386.914225,121.523494)"}
                %g{:style => "fill:rgb(0%,9.020996%,92.156982%);fill-opacity:1;"}
                  %use{:x => "363.039486", "xlink:href" => "#Th6XilXXMdNtsVTv2aicYENYZxw=-glyph2-12", :y => "117.177872"}
                %path{:d => "M 95.950946 -26.162152 L 9.946315 -57.098252 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.996131,0,0,-0.996131,228.267949,99.056258)"}
                %path{:d => "M -2.487396 2.870875 C -2.031739 1.148335 -1.020074 0.334368 0.00163845 0.000219902 C -1.019736 -0.336723 -2.032415 -1.147722 -2.484732 -2.86875 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(-0.937309,0.337131,0.337131,0.937309,237.95068,156.014867)"}
                %path{:d => "M 178.943925 -30.118867 L 206.699751 -51.839624 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.996131,0,0,-0.996131,228.267949,99.056258)"}
                %path{:d => "M -2.486581 2.867665 C -2.031449 1.147274 -1.021555 0.334181 0.00200918 -0.000101803 C -1.019507 -0.336503 -2.032003 -1.148894 -2.487631 -2.870002 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.784403,0.613945,0.613945,-0.784403,434.353955,150.842437)"}
          %p whose blue inner diagram is defined by the distributor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mi X
                    %msub
                      %mo ×
                      %mi J
                    %mi Y
                    %mover
                      %mo ←
                      %mi p
                    %mi Y
                    %msub
                      %mo ×
                      %mi Z
                    %mi B
                    %mover
                      %mo →
                      %mi q
                    %mi B
                    %mover
                      %mo →
                      %mi r
                    %mi Z
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Delta(g,f) = \left( X \times_J Y \xleftarrow{p} Y \times_Z B \xrightarrow{q} B \xrightarrow{r} Z \right).
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              by an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
              admitting finite products. Then, a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-semi-Tambara functor
              valued in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a product preserving functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} Bispan
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mi G
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathrm{Bispan}(\mathbb{F}_G) \rightarrow \mathcal{C}
              = succeed "-semi-Tambara" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %strong Tambara functor
              if its underlying additive semi-Mackey functor is a Mackey functor.
          %p
            In this formalism, given a semi-Tambara functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi R
                    %mi K
                    %mi H
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_K^H\colon X(H) \rightarrow X(K)
            is implemented by functoriality under the bispan
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ←
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  G/H \leftarrow G/K = G/K = G/K,
          %p norms by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  G/K = G/K \rightarrow G/H = G/H,
          %p and transfers by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G/K = G/K = G/K \rightarrow G/H.
          %h2#examples Examples
          %p (under construction…)
          %p
            Burnside rings, representation rings, zeroth stable homotopy group of a genuine equivariant
            = succeed "-ring." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_{\infty}
          %blockquote
            %p
              the homotopy category of Eilenberg MacLane commutative ring spectra is equivalent to the category of Tambara functors. (
              %a{:href => "#Ull13"}> Ull13
              )
          %p
            Some other examples are related to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Witt-Burnside+functors"} Witt-Burnside functors
          %h3#additive_completion_of_semitambara_functors Additive completion of semi-Tambara functors
          %p
            The following is Proposition 13.23 of
            = succeed "." do
              %a{:href => "Strickland12"} Strickland 12
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a{:href => "https://ncatlab.org/nlab/show/Mackey+functor#AdditiveCompletion"} additive completion of semi-Mackey functors
              underlies a left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} sTamb
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi{:mathvariant => "normal"} Tamb
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{sTamb}(\mathcal{C}) \rightarrow \mathrm{Tamb}(\mathcal{C})
              to the forgetful functor.
          %h3#the_borel_construction The Borel construction
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            a
            %a.existingWikiWord{:href => "/nlab/show/semiring"} semiring
            with
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo •
                %annotation{:encoding => "application/x-tex"} S^{\bullet}
            whose
            = succeed "-value" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G/H]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi H
                  %annotation{:encoding => "application/x-tex"} S^H
            %em semi-mackey functor
            by first using the semiring isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi H
                  %mo ≃
                  %msup
                    %mi{:mathvariant => "normal"} Hom
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  S^H \simeq \mathrm{Hom}^G(G/H,S)
          %p
            under the pointwise semiring structure, then given a map of transitive
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} r\colon G/K \rightarrow G/H
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi K
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T_K^H(f)(x) = \sum_{r(y) = x}  f(y).
          %p
            We then give this the structure of a
            %em Tambara functor
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} q\colon G/K \rightarrow G/H
            by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi N
                    %mi K
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  N_K^H(f)(x) = \prod_{q(y) = x}  f(y)
          %p
            In particular, we may view
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi K
                    %mi H
                %annotation{:encoding => "application/x-tex"} T_K^H
            as being defined by a “left Kan extension” formula and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi N
                    %mi K
                    %mi H
                %annotation{:encoding => "application/x-tex"} N_K^H
            via “right Kan extension.”
          %p
            Note that restricting to the value on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi e
                %annotation{:encoding => "application/x-tex"} G/e
            yields a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi{:mathvariant => "normal"} sTamb
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi{:mathvariant => "normal"} sRing
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U\colon \mathrm{sTamb}_{G}(\mathcal{C}) \rightarrow \mathrm{sRing}_{G}(\mathcal{C})
          %p
          .num_prop
            %h6 Proposition
            %p
              The Borel construction is right adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi{:mathvariant => "normal"} sTamb
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi{:mathvariant => "normal"} sRing
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U\colon \mathrm{sTamb}_{G}(\mathcal{C}) \rightarrow \mathrm{sRing}_{G}(\mathcal{C})
          %h3#representation_tambara_functors Representation Tambara functors
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ⊂
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \subset G
            a subgroup, note that (isomorphism classes of)
            = succeed "-representations" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [G/H]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi{:mathvariant => "normal"} Vect
                    %mi k
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi{:mathvariant => "normal"} Rep
                    %mi H
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Vect}_k^{G}([G/H]) \simeq \mathrm{Rep}^H.
          %p
            Restriction gives these the structure of a coefficient system; we may give these a semiring structure under
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⊕
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\oplus,\otimes)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi K
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                  %mo ≃
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                  %msub
                    %mi V
                    %mi y
                %annotation{:encoding => "application/x-tex"}
                  T_K^H(V)_x \simeq \bigoplus_{r(y) = x} V_y
          %p and norms given by tensor-induction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi N
                    %mi K
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                  %mo ≃
                  %msub
                    %mo ⨂
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                  %msub
                    %mi V
                    %mi y
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N_K^H(V)_x \simeq \bigotimes_{q(y) = x} V_y.
          %p
            The
            %strong Representation Tambara functor
            is the additive completion of this.
          %h3#burnside_tambara_functors Burnside Tambara functors
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{A}(S)
            be the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi K
                    %mn 0
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi S
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{A}(S) \coloneqq K_0 \left((\mathbb{F}_G)_{/S} \right).
          %p
            This becomes a
            %a.existingWikiWord{:href => "/nlab/show/coefficient+system"} coefficient system
            under precomposition. Moreover, colimits in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_G
            are universal, so precomposition along a map of finite
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \rightarrow T
            possesses a both a left and right adjoint; the left adjoint to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [G/K] \rightarrow [G/H]
            is called
            %em induction
            and the right adjoint is called
            = succeed "." do
              %em coinduction
            %strong Burnside Tambara functor
            has coefficient system
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}(-)
          %h3#an_explicit_example An explicit example
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi C
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi e
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} G = C_2 = \{ e, \sigma \}
            = succeed "-Mackey" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
          %ul
            %li
              an Abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              = succeed "-action," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_2
            %li
              an Abelian group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %li
              a
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} R\colon Y \rightarrow X
              (under trivial action on
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %li
              a
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} T\colon X \rightarrow Y
          %p
            subject to the
            %em double coset formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi RT
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mo +
                  %mi σ
                  %mi a
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  RT(a) = a + \sigma a.
          %p
            Thus, a
            = succeed "-Tambara" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            = succeed "-action," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} R\colon Y \rightarrow X
            (under trivial action on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} T\colon X \rightarrow Y
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} N\colon X \rightarrow Y
          %p subject to the double coset formulas
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi RT
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                      %mo +
                      %mi σ
                      %mi a
                    %annotation{:encoding => "application/x-tex"} RT(a) = a + \sigma a
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi RN
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                      %mo ⋅
                      %mi σ
                      %mi a
                    %annotation{:encoding => "application/x-tex"} RN(a) = a \cdot \sigma a
          %p and the distributivity formula
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi b
                    %mo .
                  %annotation{:encoding => "application/x-tex"} T(a R(b)) = T(a) b.
          %p
            We may explicitly define a
            = succeed "-Tambara" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi α
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{Z}[\alpha] / \alpha^2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi β
                    %mo ,
                    %mi γ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi β
                      %mn 2
                    %mo ,
                    %mi β
                    %mi γ
                    %mo ,
                    %msup
                      %mi γ
                      %mn 2
                    %mo ,
                    %mn 2
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y = \mathbb{Z}[\beta, \gamma] / (\beta^2, \beta \gamma, \gamma^2, 2\gamma)
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mi j
                  %mi β
                  %mo +
                  %mi k
                  %mi γ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi i
                  %mo +
                  %mn 2
                  %mi j
                  %mi α
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  R(i  + j\beta + k\gamma) = i + 2j\alpha.
          %p We may give this a Tambara structure by transfer
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mi j
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mi i
                  %mo +
                  %mi j
                  %mi β
                %annotation{:encoding => "application/x-tex"}
                  T(i + j\alpha) = 2i + j\beta
          %p and norm
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mi j
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi i
                    %mn 2
                  %mo +
                  %mi ij
                  %mi β
                  %mo +
                  %msup
                    %mi j
                    %mn 2
                  %mi γ
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N(i + j\alpha) = i^2 + ij\beta + j^2 \gamma.
