              %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"}> Robert Paré
              ,
              = succeed "," do
                %em Simply connected limits
              %a{:href => "https://doi.org/10.4153/CJM-1990-038-6"} doi:10.4153/CJM-1990-038-6
        .revisedby
