          %h2#properties Properties
          %h3#construction_from_pullbacks_and_equalizers Construction from pullbacks and equalizers
          #PbEqToFinConnLim.num_theorem
            %h6#theorem Theorem
            %p
              If a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
              connected limits.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              be a finite connected category and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi I
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F\colon I\to C
              a functor. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is connected, it is inhabited; choose some object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x_0\in I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x\in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ell(x)
              be the length of the shortest
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                  %annotation{:encoding => "application/x-tex"} x_0, x_1, \dots, x_n
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mrow
                          %mi i
                          %mo +
                          %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ell(x_i) \le \ell(x_{i+i})
            %p
              Now we inductively define objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi i
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} P_i\in C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0\le i\le n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi P
                      %mi i
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_{i j}\colon P_i \to F(x_j)
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ≤
                      %mi i
                    %annotation{:encoding => "application/x-tex"} j\le i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn 0
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} P_0 = x_0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mn 0
                          %mn 0
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi x
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} p_{0 0}= 1_{x_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi i
                  %annotation{:encoding => "application/x-tex"} P_i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} p_{i j}
              defined, choose a zigzag from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x_{i+1}
              of minimal length, say
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ↔
                    %msub
                      %mi y
                      %mn 1
                    %mo ↔
                    %mi …
                    %mo ↔
                    %msub
                      %mi y
                      %mi k
                    %mo ↔
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"} x_0 \leftrightarrow y_1 \leftrightarrow \dots \leftrightarrow y_k \leftrightarrow x_{i+1}.
            %p
              By our choice of the ordering of the objects of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mi k
                    %mo =
                    %msub
                      %mi x
                      %mi j
                  %annotation{:encoding => "application/x-tex"} y_k = x_j
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ≤
                      %mi i
                    %annotation{:encoding => "application/x-tex"} j\le i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo =
                      %msub
                        %mi p
                        %mrow
                          %mi i
                          %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi P
                        %mi i
                      %mo →
                      %msub
                        %mi y
                        %mi k
                    %annotation{:encoding => "application/x-tex"} q = p_{i j}\colon P_i \to y_k
            %p
              If the final arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mi k
                    %mo ↔
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} y_k \leftrightarrow x_{i+1}
              in the zigzag is directed as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mi k
                      %mo →
                      %msub
                        %mi x
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} y_k \to x_{i+1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                      %mo =
                      %msub
                        %mi P
                        %mi i
                    %annotation{:encoding => "application/x-tex"} P_{i+1} = P_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                        %mo ,
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} p_{i+1, i+1}
              be the composite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mi i
                      %mover
                        %mo →
                        %mi q
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi y
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P_i \xrightarrow{q} F(y_k) \to F(x_{i+1})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mi j
                  %annotation{:encoding => "application/x-tex"} p_{i j}
              unchanged. On the other hand, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mi k
                    %mo ↔
                    %msub
                      %mi x
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} y_k \leftrightarrow x_{i+1}
              is directed as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mi k
                      %mo ←
                      %msub
                        %mi x
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} y_k \leftarrow x_{i+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} P_{i+1}
              be the pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi P
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi P
                              %mi i
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi p
                                  %mrow
                                    %mi i
                                    %mo +
                                    %mn 1
                                    %mo ,
                                    %mi i
                                    %mo +
                                    %mn 1
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi q
                        %mtr
                          %mtd
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi y
                              %mi k
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; P_{i+1} &amp; \to &amp; P_i \\
                    ^{p_{i+1,i+1}} &amp; \downarrow &amp; &amp; \downarrow^q \\
                    \&amp; F(x_{i+1}) &amp; \to &amp; F(y_k)
                    }
            %p
              and define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} p_{i+1,j}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≤
                    %mi i
                  %annotation{:encoding => "application/x-tex"} j\le i
              by composition with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                      %mo →
                      %msub
                        %mi P
                        %mi i
                    %annotation{:encoding => "application/x-tex"} P_{i+1}\to P_i
            %p
              At the end of this procedure, we have an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} P_n
              with projections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi n
                        %mo ,
                        %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi P
                      %mi n
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_{n,j}\colon P_n \to F(x_j)
              for all objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi j
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} x_j\in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi g
                      %mi m
                  %annotation{:encoding => "application/x-tex"} g_0,\dots,g_m
              and define, inductively, an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} Q_i
              with a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Q
                        %mi i
                      %mo →
                      %msub
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} q_i\colon Q_i \to P_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mn 0
                    %mo =
                    %msub
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Q_0 = P_n
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mn 0
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi P
                            %mi n
                    %annotation{:encoding => "application/x-tex"} q_0 = 1_{P_n}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} Q_i
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mi i
                    %annotation{:encoding => "application/x-tex"} q_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Q
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi Q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} e\colon Q_{i+1} \to Q_{i}
              be the equalizer of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi p
                      %mrow
                        %mi n
                        %mo ,
                        %mo ?
                    %mo ∘
                    %msub
                      %mi q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F(g_{i+1}) \circ p_{n,?} \circ q_i
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi n
                          %mo ,
                          %mo ?
                      %mo ∘
                      %msub
                        %mi q
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_{n,?} \circ q_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} g_{i+1}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                      %mo =
                      %msub
                        %mi q
                        %mi i
                      %mo ∘
                      %mi e
                    %annotation{:encoding => "application/x-tex"} q_{i+1} = q_i \circ e
            %p
              At the end of this procedure, we have an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} Q_{m+1}
              together with a cone over the diagram
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p
            Similarly, arbitrary connected limits may be built from
            %a.existingWikiWord{:href => "/nlab/show/wide+pullbacks"} wide pullbacks
            and equalizers.
          #internalsum.num_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be (finitely) complete, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \sum_X: C/X \to C
            %p preserves and reflects (finite) connected limits.
          .proof
            %h6#proof_2 Proof
            %p
              The wide pullback of the diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo :
                    %msub
                      %mi X
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f_i: X_i \to X
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo =
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f_i = 1_X
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is clearly
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C \times C \to C
              preserves arbitrary limits, we see that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi lim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi g
                          %mi i
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %msub
                      %mi X
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mi i
                        %mo =
                        %msub
                          %mn 1
                          %mi X
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %msub
                      %mi c
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi g
                          %mi i
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi lim
                    %mi X
                    %mo ×
                    %msub
                      %mi c
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %mn 1
                        %mo ×
                        %msub
                          %mi g
                          %mi i
                    %mi X
                    %mo ×
                    %mi c
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} X \times lim (c_i \stackrel{g_i}{\to} c) = (lim X_i \stackrel{f_i = 1_X}{\to} X) \times (lim c_i \stackrel{g_i}{\to} c) = lim X \times c_i \stackrel{1 \times g_i}{\to} X \times c,
            %p
              i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X \times -
              preserves wide pullbacks. The same line of argument shows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X \times -
              preserves equalizers, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X \times -
              preserves connected limits.
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} X \times -
              carries a canonical
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              structure, whose category of coalgebras is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} C/X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C/X \to C
              is comonadic, and thus preserves and reflects any class of limits preserved by the comonad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} X \times -
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi X
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \sum_X: C/X \to C
              preserves and reflects all connected limits.
          %h3#preservation_from_wide_pullbacks Preservation from wide pullbacks
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/wide+pullback"} wide pullback
            is a limit over a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            whose underlying shape is the
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            obtained by
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} freely
            adjoining a
            %a.existingWikiWord{:href => "/nlab/show/top+element"} terminal element
            to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} discrete poset
          %p
            It is not true that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has wide pullbacks then it has connected limits. The
            %a.existingWikiWord{:href => "/nlab/show/saturated+class+of+limits"} saturation
            of the class of wide pullbacks is the class of connected and “simply connected” limits (limits over categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            whose groupoid reflection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_1(C)
            is trivial).
          %p However, the following is true.
          #PreservesWidePbToConnected.num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a complete category, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G\colon C \to D
              preserves connected limits if and only if it preserves wide pullbacks.
          .proof
            %h6#proof_3 Proof
            %p
              The forward direction is clear since wide pullbacks are examples of connected limits. Now suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G\colon C \to D
              preserves wide pullbacks. Then
            #eq:Gwithhom.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mover
                      %mo →
                      %mi G
                    %mi D
                    %mover
                      %mo →
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C \stackrel{G}{\to} D \stackrel{hom(d, -)}{\to} Set
            %p
              preserves wide pullbacks for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi G
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I = hom(d, G 1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \sum\colon Set/I \to Set
            %p reflects and preserves connected limits and in particular wide pullbacks, so that the evident lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi G
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \hom(d, G-)\colon C \to Set/I
            %p
              preserves wide pullbacks. It also preserves the terminal object, hence by
              %a{:href => "/nlab/show/wide+pullback#WidePbToComplete"} this proposition
              it preserves arbitrary limits. Therefore the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mover
                      %mo →
                      %mrow
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi G
                        %mo −
                        %mo{:stretchy => "false"} )
                    %mi Set
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mover
                      %mo →
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} C \stackrel{\hom(d, G-)}{\to} Set/I \stackrel{\sum}{\to} Set
            %p
              preserves connected limits, for every object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:Gwithhom"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(d, -)
              jointly reflect arbitrary limits, we conclude that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              preserves connected limits.
          %p
            The analogous argument works for finite limits. In particular, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            finitely complete, a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} G\colon C \to D
            that preserves pullbacks also preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
          %h2#related_pages Related pages
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/parametric+right+adjoint"} parametric right adjoint
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connected+category"} connected category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/wide+pullback"} wide pullback
            %li
