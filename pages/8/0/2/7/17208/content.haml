            %p induce canonical inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ↪
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}P^n \hookrightarrow \mathbb{C}P^{n+1}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sequential+colimit"} sequential colimit
              over this sequence of inclusions is the
              %em infinite complex projective space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}P^\infty
                    \\coloneqq
                    \\underset{\longleftarrow}{\lim}_n \mathbb{C}P^n
                    \\,.
          %p The following equivalent characterizations are immediate but useful:
          #ComplexProjectiveSpaceAsGrassmannian.num_prop
            %h6#proposition Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ≃
                    %msub
                      %mi Gr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}P^n \simeq Gr_1(\mathbb{C}^{n+1})
                    \\,.
          #ComplexProjectiveSpaceAsS1Quotient.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              then complex projective space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ComplexProjectiveSpace"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/coset"} coset
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                        %msup
                          %mi P
                          %mi n
                        %mo ≃
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{C}P^n \simeq U(n+1)/(U(n) \times U(1))
                        \\,,
              %li
                %p
                  the quotient of the
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2n+1)-sphere
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ≃
                        %mo{:stretchy => "false"} {
                        %mi κ
                        %mo ∈
                        %mi ℂ
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi κ
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} S^1 \simeq \{ \kappa  \in \mathbb{C}| {\vert \kappa \vert} = 1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ≃
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}P^n \simeq S^{2n+1}/S^1
                    \\,.
          .proof
            %h6#proof Proof
            %p
              To see the second characterization from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ComplexProjectiveSpace"}
            %p
              With
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℂ
                      %mi n
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} {\vert -\vert} \colon \mathbb{C}^{n} \longrightarrow \mathbb{R}
              the standard
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi z
                      %mo{:stretchy => "false"} →
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \vec z \in \mathbb{C}^{n+1}
              is identified under the defining equivalence relation with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi z
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} |
                    %mover
                      %mi z
                      %mo{:stretchy => "false"} →
                    %mo ∈
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ↪
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{\vert \vec z\vert}\vec z \in S^{2n+1} \hookrightarrow \mathbb{C}^{n+1}
            %p
              lying on the unit
              = succeed "-sphere." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}-0
              up to a remaining action of complex numbers of unit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of functions of underlying sets of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mo ↪
                          %mtd
                            %msup
                              %mi ℂ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi q
                                    %mrow
                                      %msup
                                        %mi S
                                        %mrow
                                          %mn 2
                                          %mi n
                                          %mo +
                                          %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi q
                                    %mrow
                                      %msup
                                        %mi ℂ
                                        %mrow
                                          %mi n
                                          %mo +
                                          %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{2n+1} &amp;\hookrightarrow&amp; \mathbb{C}^{n+1} \setminus \{0\}
                    \\\
                    {}^{\mathllap{q_{S^{2n+1}}}}\downarrow &amp;\searrow^{\mathrlap{f}}&amp; \downarrow^{\mathrlap{q_{\mathbb{C}^{n+1}}}}
                    \\\
                    S^{2n+1}/S^1 &amp;\longrightarrow&amp; \mathbb{C}P^n
                    }
            %p
              where the top horizontal and the two vertical functions are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              is also continuous, the nature of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space+topology"} quotient space topology
              implies that the bottom function is also continuous. To see that it is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              it hence remains to see that it is an
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (by
              = succeed ")." do
                %a{:href => "homeomorphism#HomeoContinuousOpenBijection"} this prop.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} U \subset S^{2n+1}/S^1
              be an open set, which means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q_{S^{2n+1}}^{-1}(U) \subset S^{2n+1}
              is an open set. We need to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f(q_{S^{2n+1}}^{-1}(U)) \subset \mathbb{C}P^{n}
              is open, hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+1}}^{-1}(f(q_{S^{2n+1}}^{-1}(U))) \subset \mathbb{C}^{n+1}
              is open. Now by the nature of the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{S^{2n+1}}^{-1}(U)
              is a union of open balls
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{n+1}
              intersected with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{2n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi B
                      %mi x
                      %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+1}}^{-1}(f(B^\circ_x(\epsilon)\vert_{S^{2n+1}}))
              is their
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              under the multiplicative action by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{C} \setminus \{0\}
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi B
                        %mi x
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msup
                            %mi S
                            %mrow
                              %mn 2
                              %mi n
                              %mo +
                              %mn 1
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B^\circ_x(\epsilon)\vert_{S^{2n+1}} \times (\mathbb{C} \setminus \{0\})
            %p
              The first characterization follows via prop.
              %a.maruku-ref{:href => "#ComplexProjectiveSpaceAsGrassmannian"}
              from the general discusion at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              identification of the
              = succeed "-sphere:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^{2n+1} \simeq U(n+1)/U(n)
              (
              %a{:href => "unitary+group#nSphereAsUnitaryCosetSpace"}> exmpl.
              ).
          %h2#examples Examples
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
                is also known as the
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+curve"} complex projective curve
                or
                %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^2
                is also known as the
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+plane"} complex projective plane
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^3
                is also known as
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+3-space"} complex projective 3-space
          %h2#properties Properties
          %h3#general General
          %p
          .num_prop
            %h6 Proposition
            %p
              Every continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n\rightarrow\mathbb{C}P^n
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              even has a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              odd as in this case the continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 0
                    %mo :
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %mi …
                    %mo :
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo :
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo :
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi x
                      %mn 0
                    %mo :
                    %mi …
                    %mo :
                    %msub
                      %mi x
                      %mi n
                    %mo :
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n\rightarrow\mathbb{C}P^n, [x_0:x_1:\ldots:x_{n-1}:x_n]\mapsto[x_1:-x_0:\ldots:x_n:-x_{n-1}]
              does not have a fixed point.
          %p
            (
            %a{:href => "#Hatcher02"}> Hatcher 02, page 180
            )
          %p
          .num_prop
            %h6 Proposition
            %p One has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} TC
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\operatorname{TC}(\mathbb{C}P^n)
                    \=2n+1
            %p
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} topological complexity
          %p
            (
            %a{:href => "#FarberTabachnikovYuzvinsky02"}> Farber &amp; Tabachnikov &amp; Yuzvinsky 02, Corollary 2
            )
          %h3#cell_structure Cell structure
          #CellComplexStructureOnComplexProjectiveSpace.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cell+structure+of+projective+spaces"}> cell structure of projective spaces
                )
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              structure on complex projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComplexProjectiveSpace"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              arises from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              by
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
              a single cell of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2(n+1)
              with
              %a.existingWikiWord{:href => "/nlab/show/attaching+map"} attaching map
              the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ⟶
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^{2n+1} \longrightarrow \mathbb{C}P^n
              from prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#ComplexProjectiveSpaceAsS1Quotient"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                            %mo ≃
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mrow
                                      %mn 2
                                      %mi n
                                      %mo +
                                      %mn 2
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi n
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi po
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 2
                          %mtd
                            %munder
                              %mo ⟶
                              %mi q
                          %mtd
                            %mi ℂ
                            %msup
                              %mi P
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{2n+1} &amp;\longrightarrow&amp; S^{2n+1}/S^1 \simeq \mathbb{C}P^n
                    \\\
                    {}^{\mathllap{\iota_{2n+2}}}\downarrow^{\mathrlap{i_n}}
                    \&amp;(po)&amp; \downarrow
                    \\\
                    D^{2n+2} &amp;\underset{q}{\longrightarrow}&amp; \mathbb{C}P^{n+1}
                    }
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Given
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+coordinates"} homogeneous coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi z
                      %mi n
                    %mo ,
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} (z_1 ,  \cdots ,  z_n ,  z_{n+1} ,  z_{n+2}) \in \mathbb{C}^{n+2}
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi arg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \coloneqq -arg(z_{n+2})
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/phase"} phase
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} z_{n+2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              these coordinates represent the same element as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mover
                          %mi z
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mrow
                        %mi i
                        %mi ϕ
                    %msub
                      %mi z
                      %mn 1
                    %mo ,
                    %msup
                      %mi e
                      %mrow
                        %mi i
                        %mi ϕ
                    %msub
                      %mi z
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msup
                      %mi e
                      %mrow
                        %mi i
                        %mi ϕ
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{\vert \vec z\vert}(e^{i \phi} z_1, e^{i \phi}z_2,\cdots, e^{i \phi}z_{n+1}, r)
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                      %mo{:stretchy => "false"} |
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    r = {\vert z_{n+2}\vert}\in [0,1] \subset \mathbb{C}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} z_{n+2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi z
                      %mo{:stretchy => "false"} →
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \vec z'
              of this form (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi z
                        %mo{:stretchy => "false"} →
                      %mo ′
                      %mo{:stretchy => "false"} |
                      %mo =
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} {\vert \vec z' \vert = 1}
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %msub
                        %mo ′
                        %mrow
                          %mi n
                          %mo +
                          %mn 2
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} z'_{n+2} \in [0,1]
              %a.existingWikiWord{:href => "/nlab/show/n-disk"} 2n+2-disk
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{2n+2}
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              being the
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2n+1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} r = 0
            %p
              The resulting function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q \colon D^{2n+2} \to \mathbb{C}P^{n+1}
              is continuous: It may be factored as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi q
                              %mrow
                                %msup
                                  %mi D
                                  %mrow
                                    %mn 2
                                    %mi n
                                    %mo +
                                    %mn 2
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msup
                              %mi D
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 2
                          %mtd
                            %mover
                              %mo ↪
                              %mphantom
                                %mi AAA
                          %mtd
                            %msup
                              %mi ℂ
                              %mrow
                                %mi n
                                %mo +
                                %mn 2
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi q
                                  %mrow
                                    %msup
                                      %mi ℂ
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mn 2
                          %mtd
                            %mi ℂ
                            %msup
                              %mi P
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi r
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi z
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo ,
                            %mi r
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi z
                              %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi z
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo :
                            %mi r
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    q_{D^{2n+2}} \colon &amp; D^{2n+2} &amp;\overset{\phantom{AAA}}{\hookrightarrow}&amp; \mathbb{C}^{n+2} \setminus \{0\} &amp;\overset{q_{\mathbb{C}^{n+2}}}{\longrightarrow}&amp;  \mathbb{C}P^{n+1}
                    \\\
                    \&amp; (Re(z_1), Im(z_1),  \cdots, Re(z_{n+1}), Im(z_{n+1}), r) &amp;\mapsto&amp; (z_1, \cdots, z_{n+1}, r)  &amp;\mapsto&amp; [ z_1 : \cdots : z_{n+1} : r ]
                    }
                    \\,.
            %p
              Here the first map is the
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedding
              of the disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{2n+2}
              as a
              %a.existingWikiWord{:href => "/nlab/show/hemisphere"} hemisphere
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 2
                      %mo ≃
                      %msup
                        %mi ℂ
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n+1} \hookrightarrow \mathbb{R}^{2n+2} \simeq \mathbb{C}^{2n+2}
            %p
              The only remaining part of the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}-\{0\}
              which fixes the conditions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo ′
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\vert z'\vert} = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %msub
                      %mo ′
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} z'_{n+2}
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ⊂
                    %mi ℂ
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^1 \subset \mathbb{C} \setminus \{0\}
              acting on the elements with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %msub
                      %mo ′
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = \{z'_{n+2}\} = 0
              by phase shifts on the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi z
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} z_0, \cdots, z_{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^{2(n+1)}
              identifies its boundary
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^{2n+1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n}
              = succeed "." do
                %a.maruku-ref{:href => "#ComplexProjectiveSpaceAsS1Quotient"}
            %p
              This shows that the above square is a
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram of underlying sets.
            %p
              By the nature of
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (
              %a{:href => "Top#DescriptionOfLimitsAndColimitsInTop"}> this prop.
              ) it remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              induced by the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} D^{2n+2} \to \mathbb{C}P^{n+1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo →
                      %mi ℂ
                      %msup
                        %mi P
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n \to \mathbb{C}P^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is open precisely if its pre-images under these two functions are open.
            %p
              We saw above that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}
              is continuous. Moreover, also the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo →
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} i_n \colon \mathbb{C}P^n \to \mathbb{C}P^{n+1}
              is continuous (by
              = succeed ")." do
                %a{:href => "projective+space#CanonicalInclusionOfProjectiveSpaces"} this lemma
            %p
              This shows that if a subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              is open, then its pre-images under these functions are open. It remains to see that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^{n+1}
              is a subset with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{S^{2n+2}}^{-1}(S) \subset D^{2n+2}
              open and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i_n^{-1}(S) \subset \mathbb{C}P^n
              open, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^{n+1}
              is open.
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+2}}^{-1}(S)
              contains with every point also its
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              under the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{C} \setminus \{0\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} D^{2n+2}
              is a unions of open balls. By the above factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}
              this means that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{D^{2n+2}}^{-1}(S)
              is open, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi q
                      %mrow
                        %msup
                          %mi ℂ
                          %mrow
                            %mi n
                            %mo +
                            %mn 2
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q_{\mathbb{C}^{n+2}}^{-1}(S)
              is a union of open cyclinders, hence is open. By the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbb{C}P^n
              is open.
          %h3#HomotopyGroups Homotopy groups
          %p
          .num_prop
            %h6 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              are the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              in degree 2, the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of
              the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2n+1-sphere
              in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \geq 2n+1
              and
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
              otherwise:
            #eq:ListOfHomotopyGroupsOfComplexProjectiveSpace.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo =
                              %mn 1
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo =
                              %mn 2
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo =
                              %mn 2
                              %mi n
                              %mo +
                              %mn 1
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mi k
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %msup
                                %mi S
                                %mrow
                                  %mn 2
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo ≥
                              %mn 2
                              %mi n
                              %mo +
                              %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_k
                    \\big(
                    \\mathbb{C}P^n
                    \\big)
                    \\;=\;
                    \\left\{
                    \\array{
                    \\ast &amp;\vert&amp; k = 0
                    \\\
                    1 &amp;\vert&amp; k = 1
                    \\\
                    \\mathbb{Z} &amp;\vert&amp; k = 2
                    \\\
                    \\mathbb{Z} &amp;\vert&amp; k = 2n + 1
                    \\\
                    \\pi_k
                    \\big(
                    S^{2n+1}
                    \\big)
                    \&amp;\vert&amp;
                    k \geq 2n+1
                    \\\
                    0 &amp;\vert&amp; otherwise
                    }
                    \\right.
            %p
          %p
          .proof
            %h6 Proof
            %p
              Essentially by definition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi S
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℂ
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} S^{2n+1} \simeq S\big(\mathbb{C}^{2n+2}\big)
              (e.g.
              = succeed ")." do
                %a{:href => "#BottTu82"} Bott &amp; Tu 1982, Exp. 14.22
            %p
              First of all, this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2n+1}
              is, hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \pi_0\big( \mathbb{C}P^n\big) = \ast
            %p
              Moreover, since this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free action
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
              and hence a
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              of the form
            %svg{:height => "50.21", :viewbox => "0 0 73.194 50.21", :width => "73.194", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
