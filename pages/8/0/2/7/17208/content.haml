                    E^\bullet( \underset{\longleftarrow}{\lim}_n \mathbb{C}P^n )
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n E^\bullet(\mathbb{C}P^n)
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n ( E^\bullet(\ast) [c_1^E] / ((c_1^E)^{n+1})  )
                    \\\
                    \&amp; \simeq E^\bullet(\ast)[ [ c_1^E ] ]
                    \\,,
                    \\end{aligned}
            %p
              where the last step is
              = succeed "." do
                %a{:href => "formal+scheme#FormalPowerSeries"} this prop.
          %h3#SullivanModel Rational homotopy type / Sullivan model
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+complex+projective+space"} Sullivan model of complex projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi f
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mrow
                      %mn 2
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                  %mrow
                    %mo (
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi f
                              %mn 2
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mi d
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}
                  [
                  f_2, h_{2n+1}
                  ]
                  \\big/
                  \\left(
                  \\begin{aligned}
                  d\,f_2 &amp; = 0
                  \\\
                  d\,h_{2n+1} &amp; = (f_2)^{n+1}
                  \\end{aligned}
                  \\right)
          %p
            (e.g.
            = succeed "," do
              %a{:href => "Sullivan+model+of+complex+projective+space#FelixHalperinThomas00"} Félix-Halperin-Thomas 00, p. 203
            = succeed ")" do
              %a{:href => "Sullivan+model+of+complex+projective+space#Menichi13"} Menichi 13, 5.3
          %h3#relation_to_oka_theory Relation to Oka theory
          %p
          #ComplexProjectiveSpaceIsOkaManifold.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka manifold
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Oka+manifold"} Oka manifold
              %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              is an Oka manifold.
          (review in
          = succeed "," do
            %a{:href => "Oka+manifold#ForstnericLarusson11"} Forstnerič &amp; Lárusson 11, p. 9
          = succeed ")" do
            %a{:href => "Oka+manifold#Forstneric13"} Forstnerič 2013, Ex. 2.7
          %h3#RelationToTopologicalKtheory Relation to topological K-theory
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo ∈
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty (\mathbb{C}P^\infty)_+ \in Ho(Spectra)
            for the
            %a.existingWikiWord{:href => "/nlab/show/H-group+ring+spectrum"} H-group ring spectrum
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo ≃
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty \simeq B U(1)
            (see there for details).
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \in Ho(Top)
            the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Σ
                    %mn ∞
                  %msub
                    %mi X
                    %mo +
                  %mo ,
                  %msup
                    %mi Σ
                    %mn ∞
                  %mo ,
                  %mi ℂ
                  %msubsup
                    %mi P
                    %mo +
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %msup
                    %mi Ω
                    %mn ∞
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi ℂ
                  %msubsup
                    %mi P
                    %mo +
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo ∈
                  %mi Ab
                %annotation{:encoding => "application/x-tex"}
                  [\Sigma^\infty X_+ , \Sigma^\infty, \mathbb{C}P^\infty_+]
                  \\simeq
                  [X, \Omega^\infty \Sigma^\infty \mathbb{C}P^\infty_+]
                  \\in Ab
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/hom-group"} hom-group
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            as shown on the right.
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo ≃
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mo ↪
                  %mi B
                  %mi U
                  %mo ×
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  i \;\colon\; \mathbb{C}P^\infty \simeq B U(1) \simeq B U(1) \times \{1\}
                  \\hookrightarrow B U \times \mathbb{Z}
          %p
            for the inclusion into the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for complex
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            which classifies the inlusion of
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            as
            %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundles"} virtual vector bundles
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo −
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [E] - 0
          #HGroupRingSpectrumSurjectsOntoTopologicalKTheory.num_prop
            %h6#proposition_6 Proposition
            %p
              For any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ho(Top)
              the
              %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %msub
                      %mi X
                      %mo +
                    %mo ,
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi ℂ
                    %msub
                      %mi P
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msub
                      %mi K
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_\ast \;\colon\;
                    [\Sigma^\infty X_+, \Sigma^\infty \mathbb{C}P_+]
                    \\longrightarrow
                    K_{\mathbb{C}}(X)
            %p
              to
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
          %p
            This is due to (
            %a{:href => "#Segal73"}> Segal 73, prop. 1
            ).
          %p
            Prop.
            %a.maruku-ref{:href => "#HGroupRingSpectrumSurjectsOntoTopologicalKTheory"}
            is sharpened by
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Snaith%27s+theorem"} Snaith's theorem
            %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            is called the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kahn-Priddy+theorem"} Kahn-Priddy theorem
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/CP%5EN+sigma-model"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℂ
                        %msup
                          %mi P
                          %mi N
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}P^N
                  \-sigma model
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fubini-Study+metric"} Fubini-Study metric
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/projective+G-space"} projective G-space
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinite+complex+projective+G-space"} infinite complex projective G-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symplectic+formulation+of+quantum+mechanics"} symplectic formulation of quantum mechanics
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#BottTu82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"} Loring Tu
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Differential+Forms+in+Algebraic+Topology"} Differential Forms in Algebraic Topology
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-3951-0"} doi:10.1007/978-1-4757-3951-0
            %li#Hatcher02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                ,
                = succeed "," do
                  %em Algebraic Topology
                = succeed "," do
                  %a{:href => "https://www.cambridge.org/gb/academic/subjects/mathematics/geometry-and-topology/algebraic-topology-1?format=PB&isbn=9780521795401"} ISBN:9780521795401
                = succeed "&rbrack;" do
                  %a{:href => "https://pi.math.cornell.edu/~hatcher/AT/ATpage.html"} webpage
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anatoly+Fomenko"}> Anatoly Fomenko
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitry+Fuchs"} Dmitry Fuchs
                = succeed "," do
                  %em Homotopical Topology
                = succeed "," do
                  %strong 273
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-319-23488-5"} doi:10.1007/978-3-319-23488-5
                = succeed "]" do
                  %a{:href => "https://www.cimat.mx/~gil/docencia/2020/topologia_diferencial/[Fomenko,Fuchs]Homotopical_Topology(2016).pdf"} pdf
          %p
            In the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+state+spaces"} quantum state spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ingemar+Bengtsson"}> Ingemar Bengtsson
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Karol+%C5%BByczkowski"} Karol Życzkowski
              = succeed "," do
                %em Geometry of Quantum States — An Introduction to Quantum Entanglement
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/CBO9780511535048"} doi:10.1017/CBO9780511535048
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Topospaces"}> Topospaces
                ,
                %em
                  %a{:href => "http://topospaces.subwiki.org/wiki/Complex_projective_space"} Complex projective space
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "https://en.wikipedia.org\n/wiki/Complex_projective_space"} Complex projective space
          %p
            %a.existingWikiWord{:href => "/nlab/show/topological+complexity"} Topological complexity
            of complex projective space:
          %ul
            %li#FarberTabachnikovYuzvinsky02
              %a.existingWikiWord{:href => "/nlab/show/Michael+Farber"}> Michael Farber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serge+Tabachnikov"} Serge Tabachnikov
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sergey+Yuzvinsky"} Sergey Yuzvinsky
              %em Topological robotics: motion planning in projective spaces
              (2002),
              = succeed ";" do
                %a{:href => "https://arxiv.org/abs/math/0210018"} arXiv:math/0210018
          %p
            Computation of
            = succeed "-sets" do
              %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
          %ul
            %li#West71
              Robert West,
              = succeed "," do
                %em Some Cohomotopy of Projective Space
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/24890146"} jstor:24890146
          %p
            Computation of the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+E.+Mosher"}> Robert E. Mosher
                ,
                = succeed "," do
                  %em Some stable homotopy of complex projective space
                %strong 7
                (1968) 179-193 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0040-9383(68)90026-8"}> doi:10.1016/0040-9383(68)90026-8
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://core.ac.uk/download/pdf/82547916.pdf"} pdf
            %li#Segal73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em The stable homotopy of complex of projective space
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/Segal72.pdf", :title => "pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1093/qmath/24.1.1"} doi:10.1093/qmath/24.1.1
          %p
            (See also at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Snaith%27s+theorem"} Snaith's theorem
          %p
            Detailed review of the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            for
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
            is in
          %ul
            %li#Pedrotti16
              %a.existingWikiWord{:href => "/nlab/show/Riccardo+Pedrotti"}> Riccardo Pedrotti
              ,
              = succeed "," do
                %em Complex oriented cohomology, generalized orientation and Thom isomorphism
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/PedrotticECohomology2018.pdf", :title => "pdf"} pdf
          %p
            Computation of the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            of
            %a.existingWikiWord{:href => "/nlab/show/cyclic+loop+spaces"} cyclic loop spaces
            of complex projective spaces (their
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/string+cohomology"} string cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marcel+B%C3%B6kstedt"}> Marcel Bökstedt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Iver+Ottosen"} Iver Ottosen
              = succeed "," do
                %em String cohomology groups of complex projective spaces
