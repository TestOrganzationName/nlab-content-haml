              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "233.668", "xlink:href" => "#DDF_nzGBMbja-OtH6ue6hutw0LE=-glyph-8-1", :y => "53.4"}
            %p
              In all cases the identification in the bottom line follows from
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
            %p
              This gives the list
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ListOfHomotopyGroupsOfComplexProjectiveSpace"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \pi_{2n+1}(S^{2n+1}) = \mathbb{Z}
              (the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hopf+degree+theorem"} Hopf degree theorem
          %h3#Cohomology Homology and Cohomology
          %h4#OrdinaryHomologyAndCohomology Ordinary
          #OrdinaryCohomologyOfComplexProjectiveSpace.num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} groups
              of complex projective space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mspace{:width => "thickmathspace"}
                              %mi even
                              %mspace{:width => "thickmathspace"}
                              %mi and
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo ≤
                              %mn 2
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_k(\mathbb{C}P^n,A)\simeq
                    \\left\{
                    \\array{
                    A &amp; for \; k \;even\; and \; k \leq 2n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Similarly the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mspace{:width => "thickmathspace"}
                              %mi even
                              %mspace{:width => "thickmathspace"}
                              %mi and
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo ≤
                              %mn 2
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^k(\mathbb{C}P^n,A)
                    \\simeq
                    \\left\{
                    \\array{
                    A &amp; for \; k \;even\; and \; k \leq 2n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              carries the structure of a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R = (A, \cdot)
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is the the
              %a.existingWikiWord{:href => "/nlab/show/graded+ring"} graded ring
            #eq:CohomologyRing.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, R)
                    \\simeq
                    R[c_1] / (c_1^{n+1})
                    \\mathrlap{\,,}
            %p
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on a single generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              in degree 2, by the relation that identifies
              %a.existingWikiWord{:href => "/nlab/show/cup+products"} cup products
              of more than
              = succeed "-copies" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              with zero (see also the disfferential relation at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+complex+projective+space"} Sullivan model of complex projective space
            %p
              Finally, the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the infinite-dimensional complex projective space is the
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
              in one generator:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^\infty, R)
                    \\simeq
                    R[ [ c_1 ] ]
                    \\,.
            %p
              (Or else the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[c_1]
              = succeed ".)" do
                %a.maruku-ref{:href => "#ChoiceOfRingStructureOnGradedCohomologyGroupOfMultiplicativeCohomologyTheory"}
          .proof
            %h6#proof_3 Proof
            %p
              First consider the case that the coefficients are the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} A = \mathbb{Z}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              admits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              equivalently as its
              %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+I#CelluarEquivalentToSingularFromSpectralSequence"}> thm.
              ). By definition (
              %a{:href => "cellular+homology#CellularChainComplex"}> defn.
              ) this is the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of the chain complex of
              %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
              groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi cell
                    %msub
                      %mi H
                      %mrow
                        %mi q
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo +
                        %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi cell
                    %msub
                      %mi H
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi cell
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∂
                          %mi cell
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\overset{\partial_{cell}}{\longrightarrow}
                    H_{q+2}((\mathbb{C}P^n)_{q+2}, (\mathbb{C}P^n)_{q+1})
                    \\overset{\partial_{cell}}{\longrightarrow}
                    H_{q+1}((\mathbb{C}P^n)_{q+1}, (\mathbb{C}P^n)_{q})
                    \\overset{\partial_{cell}}{\longrightarrow}
                    H_{q}((\mathbb{C}P^n)_{q}, (\mathbb{C}P^n)_{q-1})
                    \\overset{\partial_{cell}}{\longrightarrow}
                    \\cdots
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                  %annotation{:encoding => "application/x-tex"} (-)_q
              denotes the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              = succeed "-structure." do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "," do
                %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
