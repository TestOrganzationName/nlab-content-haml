                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mi P
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{C}P^n)_{2k+1} = (\mathbb{C}P)_{2k}
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} (\mathbb{C}P^n)_{2k+2}
              arises from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} (\mathbb{C}P^n)_{2k+1} = (\mathbb{C}P^n)_{2k}
              by attaching a single
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2k+2
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/reduced+homology"} reduced homology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{2k}(\mathbb{C}P^n, \mathbb{Z})
                    \\simeq
                    \\tilde H_{2k}(S^{2k})((\mathbb{C}P^n)_{2k}/(\mathbb{C}P^n)_{2k-1})
                    \\simeq
                    \\tilde H_{2k}(S^{2k})
                    \\simeq
                    \\mathbb{Z}
                    \\,.
            %p This establishes the claim for ordinary homology with integer coefficients.
            %p
              In particular this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_q(\mathbb{C}P^n, \mathbb{Z})
              is a
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %a.existingWikiWord{:href => "/nlab/show/projective+objects"} projective objects
              in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              (
              %a{:href => "projective+object#ProjectiveObjectsInAbAreFreeGroups"}> prop.
              ) it follows (with the discussion at
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+functors+in+homological+algebra"} derived functors in homological algebra
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1(H_q(\mathbb{C}P^n, \mathbb{Z}),A) = 0
            %p
              and the
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1(H_q(\mathbb{C}P^n), A) = 0
                    \\,.
            %p
              With this, the statement about homology and cohomology groups with general coefficients follows with the
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              for ordinary homology (
              %a{:href => "universal+coefficient+theorem#TheoremInOrdinaryHomology"}> thm.
              ) and for ordinary cohomology (
              %a{:href => "universal+coefficient+theorem#OrdinaryStatementInCohomology"}> thm.
              ).
            %p
              Finally to see the action of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∪
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ×
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi Δ
                          %mo *
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\cup
                    \\;\colon\;
                    H^\bullet(\mathbb{C}P^n, R)
                    \\otimes
                    H^\bullet(\mathbb{C}P^n, R)
                    \\longrightarrow
                    H^\bullet(\mathbb{C}P^n \times \mathbb{C}P^n , R)
                    \\overset{\Delta^\ast}{\longrightarrow}
                    H^\bullet(\mathbb{C}P^n,R)
            %p
              of the “cross-product” map that appears in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kunneth+theorem"} Kunneth theorem
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo →
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo ×
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Delta\colon \mathbb{C}P^n \to \mathbb{C}P^n \times \mathbb{C}P^n
            %p
              Since, by the above, the groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} H^{2k}(\mathbb{C}P^n,R) \simeq R[2k]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H^{2k+1}(\mathbb{C}P^n,R) = 0
              are free and finitely generated, the
              %a.existingWikiWord{:href => "/nlab/show/Kunneth+theorem"} Kunneth theorem
              in ordinary cohomology applies (
              %a{:href => "K&#252;nneth+theorem#KunnethInOrdinaryCohomology"}> prop.
              ) and says that the cross-product map above is an isomorphism. This shows that under cup product pairs of generators are sent to a generator, and so the statement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(\mathbb{C}P^n , R)\simeq R[c_1](c_1^{n+1})
              follows.
            %p This also implies that the projection maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 2
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet((\mathbb{C}P^\infty)_{2n+2}, R)
                    \=
                    H^\bullet(\mathbb{C}P^{n+1}, R)
                    \\to
                    H^\bullet(\mathbb{C}P^{n+}, R)
                    \=
                    H^\bullet((\mathbb{C}P^\infty)_{2n}, R)
            %p
              are all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              (
              %a{:href => "lim1#MittagLefflerCondition"}> def.
              ,
              = succeed ")" do
                %a{:href => "lim1#MittagLefflerSatisfiedInParticularForTowerOfSurjections"} exmpl.
              %a.existingWikiWord{:href => "/nlab/show/Milnor+exact+sequence"} Milnor exact sequence
              for cohomology (
              %a{:href => "lim1#MilorSequenceForReducedCohomologyOnCWComplex"}> prop.
              ) implies the last claim to be proven:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %msup
                              %mi P
                              %mn ∞
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi n
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %msup
                              %mi P
                              %mi n
                            %mo ,
                            %mi R
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi c
                              %mn 1
                              %mi E
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^\bullet(\mathbb{C}P^\infty, R)
                    \&amp;
                    \\simeq
                    H^\bullet( \underset{\longleftarrow}{\lim}_n \mathbb{C}P^n , R)
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n H^\bullet(\mathbb{C}P^n, R)
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n ( R [c_1^E] / ((c_1)^{n+1})  )
                    \\\
                    \&amp; \simeq R[ [ c_1 ] ]
                    \\,,
                    \\end{aligned}
            %p
              where the last step is
              = succeed "." do
                %a{:href => "formal+scheme#FormalPowerSeries"} this prop.
          #ChoiceOfRingStructureOnGradedCohomologyGroupOfMultiplicativeCohomologyTheory.num_remark
            %h6#remark Remark
            %p
              There is in general a choice to be made in interpreting the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %p
              a priori
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(X)
              is a sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\{E^n(X)\}_{n \in \mathbb{Z}}
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^{n_1}(X) \otimes E^{n_2}(X)
                    \\longrightarrow
                    E^{n_1 + n_2}(X)
                    \\,,
            %p
              one for each pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo ,
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} (n_1,n_2) \in \mathbb{Z}\times\mathbb{Z}
            %p
              In turning this into a single
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              by forming
              %a.existingWikiWord{:href => "/nlab/show/formal+sums"} formal sums
              of elements in the groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^n(X)
            %p
              In the former case the ring obtained is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X)
            %p
              while in the latter case it is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{n \in \mathbb{N}} E^n (X)
                    \\,.
            %p
              These differ in general. For instance if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is complex projective space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryCohomologyOfComplexProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    E^n(X)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; n \; even
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p and the product operation is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^{2{n_1}}(X)\otimes E^{2 n_2}(X)
                    \\longrightarrow
                    E^{2(n_1 + n_2)}(X)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_1, n_2
              (and zero in odd degrees, necessarily). Now taking the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these, this is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on one generator (in degree 2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X) \;\simeq\; \mathbb{Z}[c_1]
                    \\,.
            %p
              But taking the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{n \in \mathbb{N}} E^n(X) \;\simeq\; \mathbb{Z} [ [ c_1 ] ]
                    \\,.
            %p
              A priori both of these are sensible choices. The former is the usual choice in traditional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              theory as a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              right away, then the second perspective tends to be more natural:
            %p
              The cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              is naturally computed as the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              of the cohomolgies of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[c_1]/((c_1)^{n+1})
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
              right away, instead of first taking it in
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
              (see
              = succeed ")." do
                %a{:href => "formal+scheme#FormalPowerSeries"} here
            %p
              Incidentally, this is the default choice of ring structure for
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theories"} multiplicative cohomology theories
              evaluated on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
              (see there) this choice is of paramount importance.
            %p
              See also for instance remark 1.1. in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"} A Survey of Elliptic Cohomology
          %h4#complexoriented Complex-oriented
          #CohomologyRingOfBU1ForComplexOrientedCohomologyTheory.num_prop
            %h6#proposition_5 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo •
                    %mo ,
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E^\bullet, c^E_1)
              (
              %a{:href => "complex+oriented+cohomology+theory#ComplexOrientedCohomologyTheory"}> defn.
              ), then there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/graded+rings"} graded rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(\mathbb{C}P^\infty) \simeq E^\bullet(\ast)[ [ c_1^E ] ]
            %p
              between the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of infinite-dimensional complex projective space and the
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in one generator of even degree over the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the point.
          .proof
            %h6#proof_4 Proof
            %p
              Using the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              with the result of attaching a single
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo ↪
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} i \;\colon\; S^2 \hookrightarrow \mathbb{C}P^\infty
              is identified with the canonical map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                      %mo →
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^2 \to B U(1)
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              for the
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, E^\bullet(\ast))
                    \\;\Rightarrow\;
                    E^\bullet(\mathbb{C}P^n)
                    \\,.
            %p
              Since, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#OrdinaryCohomologyOfComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              of projective space is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, \mathbb{Z}) \simeq \mathbb{Z}[c_1]/((c_1)^{n+1})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              represents a unit in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^2(S^2, \mathbb{Z})\simeq \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              in abelian groups (
              %a{:href => "projective+object#ProjectiveObjectsInAbAreFreeGroups"}> prop.
              ), the
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Ext^1(H_n(\mathbb{C}P^n), E^\bullet(\ast)) = 0
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              (
              %a{:href => "universal+coefficient+theorem#OrdinaryStatementInCohomology"}> prop.
              ) gives that the second page of the spectral sequence is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
