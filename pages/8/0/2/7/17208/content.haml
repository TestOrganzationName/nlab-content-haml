            %p
              By the following two basic facts about the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi k
                        %mo ≥
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi π
                      %mrow
                        %mi k
                        %mo ≤
                        %mn 2
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{k \geq 2}
                    \\big(
                    S^1
                    \\big)
                    \\;=\;
                    0
                    \\,,
                    \\phantom{AAAA}
                    \\pi_{k \leq 2n}
                    \\big(
                    S^{2n+1}
                    \\big)
                    \\;=\;
                    0
