          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
          %ul
            %li
              Basudeb Datta, Jonathan Spreer:
              %em
                Simplicial cell decompositions of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
