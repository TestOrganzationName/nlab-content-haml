              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E10"} E10
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E11"} E11
          %p Surveys:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/En_%28Lie_algebra%29"} En
          %p
            The fact that every simply laced hyperbolic Kac-Moody algebra appears as a subalgebra of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/E10"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 10
                    %annotation{:encoding => "application/x-tex"} E_{10}
          %ul
            %li
              Sankaran Viswanath:
              %em
                Embeddings of hyperbolic Kac-Moody algebras into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 10
                    %annotation{:encoding => "application/x-tex"} E_{10}
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0801.2586"}> arXiv:0801.2586
              ,
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/s11005-007-0214-7"} doi:10.1007/s11005-007-0214-7
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s11005-007-0214-7"} doi:10.1007/s11005-007-0214-7
          %h3#affine_lie_algebras Affine Lie algebras
          %blockquote
            %p
              For more see also at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/affine+Lie+algebra"} affine Lie algebra
          %ul
