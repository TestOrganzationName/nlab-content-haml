          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kac-Moody+group"} Kac-Moody group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+Kac-Moody+algebra"} higher Kac-Moody algebra
            %li
              %p
