              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Olive"} David Olive
              = succeed "," do
                %em Kac-Moody and Virasoro algebras in relation to quantum physics
              %strong 01
              02 (1986) 303-414 &amp;lbrack;
              %a{:href => "https://doi.org/10.1142/S0217751X86000149"}> doi:10.1142/S0217751X86000149
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://inspirehep.net/literature/18583"} spire:18583
          %p Lecture notes:
          %ul
            %li#Wassermann11
              %a.existingWikiWord{:href => "/nlab/show/Antony+Wassermann"}> Antony Wassermann
              \:
              = succeed "," do
                %em Kac-Moody and Virasoro algebras
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1004.1287"} arXiv:1004.1287
          %p
            With an eye towards
            %a.existingWikiWord{:href => "/nlab/show/U-duality"} U-duality
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/11D+supergravity"} 11D supergravity
          %ul
            %li#NicolaiSchlotterer09
              %a.existingWikiWord{:href => "/nlab/show/Hermann+Nicolai"} Hermann Nicolai
              (notes by
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/Oliver+Schlotterer"} Oliver Schlotterer
              = succeed "," do
                %em Infinite dimensional symmetries
              %em Saalburg summer school
              in Wolfersdorf, Thuringia (2009) &amp;lbrack;
              %a.existingWikiWord{:href => "/nlab/files/NicolaiSchlotterer-InfinDimSymmetries.pdf", :title => "pdf"}> pdf
              \&amp;rbrack;
          %p A standard textbook account:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Victor+G.+Kac"}> Victor G. Kac
              ,
              = succeed "," do
                %em Infinite Dimensional Lie Algebras
              %strong 44
              Springer 1983 &amp;lbrack;
              %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-1382-4"}> doi:10.1007/978-1-4757-1382-4
              \&amp;rbrack;, Cambridge University Press (1990) &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/CBO9780511626234"}> doi:10.1017/CBO9780511626234
              \&amp;rbrack;
          %p Collections of articles:
          %ul
            %li
              N. Sthanumoorty, K. Misra (eds.):
              = succeed "," do
                %em Kac-Moody Lie algebras and related topics
              %strong 343
              AMS (2002) &amp;lbrack;ISBN:978-0-8218-7933-7,
              = succeed "&rbrack;" do
                %a{:href => "https://bookstore.ams.org/conm-343"} ams:conm-343
          %p See also:
          %ul
            %li
              Wikipedia:
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Kac%E2%80%93Moody_algebra"} Kac-Moody algebra
          %h3#the_series
            The
            = succeed "-series" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/E7"}> E7
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/E8"} E8
              = succeed "," do
