                (
                %a{:href => "http://www.ulb.ac.be/sciences/ptm/pmif/Rencontres/KMModaveLectures2007.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Cederwall"}> Martin Cederwall
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Jakob+Palmkvist"} Jakob Palmkvist
                %em Gradient structures from extensions of over-extended Kac-Moody algebras
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2503.17779"}> arXiv:2503.17779
                \&amp;rbrack;
          %h3#ReferencesMaximalCompactSubalgebra Maximal compact subalgebras
          %p
            On non-
            %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            of involutary (“maximal compact”) subalgebras
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
          %ul
            %li#KleinschmidtNicolaiVigano20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Axel+Kleinschmidt"}> Axel Kleinschmidt
                ,
                = succeed "," do
