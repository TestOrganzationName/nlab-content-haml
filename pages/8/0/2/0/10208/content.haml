          %h2#idea Idea
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V = (V,\langle-,-\rangle)
            %em
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is the subgroup of the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL(V)
            which leaves the inner product invariant.
          %h2#definition Definition
          %p
            Given an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(V)
            %em preserves the inner product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mi v
                  %mo ,
                  %mi A
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle A v ,A w \rangle = \langle v,w \rangle
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ,
                    %mi w
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v,w\in V
          #inner_product_preserving_elements_closed.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              preserve the inner product on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi AB
                  %annotation{:encoding => "application/x-tex"} AB
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} A^{-1}
          %p We thus see that we have a group.
          #def_of_O_n.num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong orthogonal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(V,\langle-,-\rangle)
              is the subgroup of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(V)
              consisting of those elements that preserve the inner product.
          %p (… more detail …)
          %h2#as_a_lie_group As a Lie group
          %p
            When the base field is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℍ
                %annotation{:encoding => "application/x-tex"} \mathbb{H}
            (the last being a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/skewfield"} skewfield
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(V,\langle-,-\rangle)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n,\mathbb{K})
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msup
                      %mi 𝕂
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V = \mathbb{K}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mi ℝ
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi ℍ
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{K} \in \{ \mathbb{R},\mathbb{C},\mathbb{H}\}
            and we take the ‘standard’ inner products on these spaces.
          %p
            A relatively easy way to see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n,\mathbb{K})
            is a manifold is that it is a smooth
            %a.existingWikiWord{:href => "/nlab/show/affine+variety"} affine variety
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %a.existingWikiWord{:href => "/nlab/show/charts"} charts
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n,\mathbb{K})
            as a real manifold.
          %h3#charts_on_the_underlying_manifold Charts on the underlying manifold
          %p
            One can use the algebra structure on matrices over the base
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            (or base
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to define
            %a.existingWikiWord{:href => "/nlab/show/charts"} charts
            which are different to the charts one gets via the
            = succeed "." do
              %a{:href => "/nlab/show/exponential+map#exp_of_Lie_groups"} exponential map
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in O(n,\mathbb{K})
            Define the sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo ∈
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi A
                  %mo +
                  %mi X
                  %mo ∈
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\Omega(A) := \{ X\in O(n,\mathbb{K}) | A + X \in GL(V) \}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %msup
                        %mi A
                        %mo †
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi Y
                  %mo ∈
                  %msub
                    %mi M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi AY
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mi AY
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo †
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T_{A^\dagger} := \{ Y\in M_n(\mathbb{K}) | AY + (AY)^\dagger = 0 \}.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mrow
                      %msup
                        %mi A
                        %mo †
                %annotation{:encoding => "application/x-tex"} T_{A^\dagger}
            is a vector space, and will turn out to be the tangent space to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi 𝕂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n,\mathbb{K})
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo †
                  %annotation{:encoding => "application/x-tex"} A^\dagger
          #isomorphism_of_opens_with_tangent_spaces.num_prop
            %h6#proposition_2 Proposition
            %p
              There is an isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Ω
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ∼
                      %msub
                        %mi T
                        %mrow
                          %msup
                            %mi A
                            %mo †
                    %annotation{:encoding => "application/x-tex"} c_A\colon \Omega(A) \stackrel{\sim}{\to} T_{A^\dagger}
          .proof
            %h6#proof Proof
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi A
                  %annotation{:encoding => "application/x-tex"} c_A
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo −
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo −
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo +
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi A
                      %mo †
                  %annotation{:encoding => "application/x-tex"}
                    X \mapsto (I - A^\dagger X)(A + X)^{-1} = (I - A^\dagger X)(I + A^\dagger X)^{-1}A^\dagger
            %p
              the latter equality using that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %msup
                        %mi A
                        %mo †
                    %annotation{:encoding => "application/x-tex"} A^{-1} = A^\dagger
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %msup
                          %mi A
                          %mo †
                  %annotation{:encoding => "application/x-tex"} T_{A^\dagger}
              and that it is an isomorphism.
            %p Since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mi c
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %mi A
                    %msub
                      %mi c
                      %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %msup
                      %mi A
                      %mo †
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (A c_A(X))^\dagger = A c_I(A^\dagger X)^\dagger A^\dagger,
            %p
              if we show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo †
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi c
                      %mi I
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo †
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_I(A^\dagger X)^\dagger = - c_I(A^\dagger X)
              we are done. Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo =
                      %msup
                        %mi X
                        %mo †
                      %mi A
                    %annotation{:encoding => "application/x-tex"} Z = X^\dagger A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi 𝕂
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n,\mathbb{K})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi c
                              %mi I
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo −
                                %mi Z
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo +
                                %mi Z
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo )
                              %mo †
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo −
                                %mi Z
                                %mo{:stretchy => "false"} )
                                %msup
                                  %mi Z
                                  %mo †
                                %msup
                                  %mi Z
                                  %mrow
                                    %mo †
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo +
                                %mi Z
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo )
                              %mo †
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo −
                                %msup
                                  %mi Z
                                  %mo †
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi I
                                %mo +
                                %msup
                                  %mi Z
                                  %mo †
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo )
                              %mo †
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo +
                            %mi Z
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi I
                            %mo −
                            %mi Z
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    c_I(Z)^\dagger &amp; = \left( (I - Z)(I + Z)^{-1} \right)^\dagger\\
                    \&amp; = \left( (I - Z)Z^\dagger Z^{\dagger -1}(I + Z)^{-1} \right)^\dagger\\
                    \&amp; = \left( -(I - Z^\dagger)(I + Z^\dagger)^{-1} \right)^\dagger \\
                    \&amp; = -(I + Z)^{-1}(I - Z)
                    \\end{aligned}
            %p (tbc…)
          %h2#examples Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                with the standard inner product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi y
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi x
                      %mo ⋅
                      %mstyle{:mathvariant => "bold"}
                        %mi y
                    %annotation{:encoding => "application/x-tex"} \langle\mathbf{x},\mathbf{y}\rangle = \mathbf{x}\cdot\mathbf{y}
                has as orthogonal group the standard
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} O(n)
            %li
              %p
                The finite-dimensional
