            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %a.existingWikiWord{:href => "/nlab/show/ultrafilters"} ultrafilters
            to form a certain
            %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
            on the
            %a.existingWikiWord{:href => "/nlab/show/direct+product"} direct product
            and construct a
            = succeed "," do
