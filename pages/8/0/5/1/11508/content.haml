                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
              (the
              = succeed ")" do
