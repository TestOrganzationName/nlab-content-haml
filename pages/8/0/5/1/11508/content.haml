                            %mo ,
                            %msub
                              %mi Γ
                              %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\to&amp; \mathcal{M}_{\overline{ell}}(3,\Gamma_1)
                    \\\
                    \\downarrow^{\mathrlap{\mathbb{Z}/2\mathbb{Z}}}
                    \&amp;&amp;
                    \\downarrow^{\mathbb{Z}/2\mathbb{Z}}
                    \\\
                    \\ast//(\mathbb{Z}/2\mathbb{Z})
                    \&amp;\hookrightarrow&amp;
                    \\mathcal{M}_{\overline{ell}}(3,\Gamma_0)
                    }
            %p
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(\mathbb{Z}[\tfrac{1}{3}])
              yields under theorem
              %a.maruku-ref{:href => "#TheEquivariantConstruction"}
              a diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
