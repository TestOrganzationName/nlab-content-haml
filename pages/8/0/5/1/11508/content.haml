            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/tmf0%282%29"} tmf0(2)
          %h2#Definition Definition and construction
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat {\mathbb{Z}}
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profinite+completion+of+the+integers"} profinite completion of the integers
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≔
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi ℤ
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  G \coloneqq GL_2(\hat {\mathbb{Z}})
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            2 with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "." do
