                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_1(3) \hookrightarrow \Gamma_0(3) \hookrightarrow GL(2,\mathbb{Z}/3\mathbb{Z})
          %p
            where the first inclusion is a
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            of
            %a.existingWikiWord{:href => "/nlab/show/index+of+a+subgroup"} index
            2.
          .num_prop
