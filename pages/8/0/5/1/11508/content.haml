            (this is implified for instance in
            = succeed ")," do
              %a{:href => "#Stojanoska11"} Stojanoska 11, remark 6.2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
