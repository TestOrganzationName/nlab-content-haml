                        %mo{:stretchy => "false"} /
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{M}_{\overline{ell}}(n,K)\to \mathcal{M}_{\overline{ell}}(n,\Gamma)
                        \\simeq
                        \\mathcal{M}_{\overline{ell}}(n,K)//(\Gamma/K)
                        \\,.
          %p
            This is (
            %a{:href => "#HillLawson13"}> Hill-Lawson 13, prop. 3.16, prop. 3.17
            ).
          #TheEquivariantConstruction.num_theorem
            %h6#theorem Theorem
            %p
              It is possible to extend the
              %a.existingWikiWord{:href => "/nlab/show/Goerss-Hopkins-Miller+theorem"} Goerss-Hopkins-Miller theorem
              to the
              %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+compactification"} compactified
              %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
              of
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curves+with+level-n+structure"} elliptic curves with level-n structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℳ
                      %mover
                        %mi ell
                        %mo ¯
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}_{\overline{ell}}[n]
              in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SystemOfModuliStacks"}
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              produces an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              on the levelled
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
              of def.
              %a.maruku-ref{:href => "#LevelledOrbitCategory"}
              with values in
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+rings"} E-∞ rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tmf
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi Orb
                        %mo ˜
                      %mrow
                        %msub
                          %mi SL
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi ℤ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %msub
                      %mi CRing
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    Tmf
                    \\;\colon\;
                    (\widetilde{Orb}_{SL_2(\hat{\mathbb{Z}})})^{op}
                    \\longrightarrow
                    CRing_\infty
            %p which is such that
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n = 1
                  (where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi SL
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z}/\mathbb{Z}) = 1
                  and hence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \Gamma = 1
                  necessarily) one recovers
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Tmf
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} Tmf(1,1)\simeq
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Tmf"} Tmf
              %li
                %p
                  the morphism induced by any morphism of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mi k
                        %mo ,
                        %msub
                          %mi P
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n k ,P_k(\Gamma))\to (n,\Gamma)
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/localization+of+a+spectrum"} localization
              %li
                %p
                  for any
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  and every
                  %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mo ↪
                          %mi Γ
                          %mo ↪
                          %msub
                            %mi GL
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi n
                          %mi ℤ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} K \hookrightarrow \Gamma \hookrightarrow GL_2(\mathbb{Z}/n\mathbb{Z})
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} /
                          %mi K
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\Gamma/K)
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"} homotopy fixed points
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Tmf
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Tmf(n,\Gamma)
                  (induced by action of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %mo{:stretchy => "false"} /
                        %mi K
                      %annotation{:encoding => "application/x-tex"} \Gamma/K
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℳ
                          %mover
                            %mi ell
                            %mo ¯
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}_{\overline{ell}}(\Gamma)
                  given by prop.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#SystemOfModuliStacks"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Tmf
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi Tmf
                        %mo{:stretchy => "false"} (
                        %mi K
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} /
                            %mi K
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Tmf(n,\Gamma) \stackrel{\simeq}{\longrightarrow} Tmf(K)^{(\Gamma/K)}      \,.
          %p
            This is (
            %a{:href => "#HillLawson13"}> Hill-Lawson 13, theorem 9.1
            ).
          .num_remark
            %h6#remark Remark
            %p
              The system of spectra in theorem
              %a.maruku-ref{:href => "#TheEquivariantConstruction"}
              is essentially a
              %a.existingWikiWord{:href => "/nlab/show/spectrum+with+G-action"} spectrum with G-action
              (see there) for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              the “
              %a.existingWikiWord{:href => "/nlab/show/profinite+completion+of+the+integers"} profinite
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/modular+group"} modular group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi ℤ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_2(\hat {\mathbb{Z}})
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
              of this
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              just by
              %a.existingWikiWord{:href => "/nlab/show/congruence+subgroups"} congruence subgroups
              and subject to that divisibility constraint on the
              = succeed "s," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tmf
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tmf(-)
              defines a “levelled” kind of genuine
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi ℤ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_2(\hat {\mathbb{Z}})
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
              version of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Tmf"} Tmf
          %p
            The following proposition gives one way how the modular equivariance of
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            as in theorem
            %a.maruku-ref{:href => "#TheEquivariantConstruction"}
            restricts to the
            = succeed "-equivariance" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/KU"} KU
            (hence
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KR-theory"} KR-theory
            %a.existingWikiWord{:href => "/nlab/show/type+II+string+theory"} type II string theory
            = succeed ")." do
