              %a.existingWikiWord{:href => "/nlab/show/cusp"} cusp
              of the
              %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+compactification"} compactified
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
