            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. 7.2.2.30
          #RecognitionByGlobalSections.num_prop
            %h6#proposition_3 Proposition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              has homotopy dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \leq n
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒳
                    %mover
                      %munder
                        %mo →
                        %mi Γ
                      %mover
                        %mo ←
                        %mi Δ
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Delta \dashv \Gamma) : \mathcal{X}
                    \\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\to}}
                    \\infty Grpd
            %p
              has the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              sends
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo ≥
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k\geq n)
              %a.existingWikiWord{:href => "/nlab/show/n-connective"} connective
              morphisms to
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-n)
              %a.existingWikiWord{:href => "/nlab/show/n-connective"} connective
              morphisms.
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 7.2.1.7
          %h2#examples Examples
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of homotopy dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \leq -1
              is the the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ≃
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} * \simeq Sh_{(\infty,1)}(\emptyset)
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, example. 7.2.1.2
          .proof
            %h6#proof Proof
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{X}
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-1)
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              if the morphism
              = succeed "to" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} X \to *
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object in an (∞,1)-category
              is. This is the case if it is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              is corepresented by the terminal object,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is 0-connective precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Gamma(X) \to \Gamma(*) = *
              is an epimorphism on connected components. By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Gamma(X) \to *
              is an effective epimorphism in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %p
              So
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              has homotopy dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \leq 0
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves effective epimorphisms. This is the case if it preserves
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              always preserves
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              is
              %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is by definition also a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and hence also preserves
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          #LocalToposesHaveHomotopDimension0.num_prop
            %h6#proposition_5 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
              has homotopy dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \leq 0
          .proof
            %h6#proof_2 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Delta \dashv \Gamma \dashv \nabla)
                    \:
                    \\mathbf{H} \to \infty Grpd
            %p
              be
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/global+section+geometric+morphism"} terminal geometric morphism
              of the local
              = succeed "-topos," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              being the extra
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
              functor that characterizes locality.
            %p
              By prop
              %a.maruku-ref{:href => "#RecognitionByGlobalSections"}
              it is sufficient to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              send
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-connected"} (-1)-connected
              morphisms to (-1)-connected morphisms, hence
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphisms
              to effective epimorphisms.
            %p
              By the existence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves not only
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves effective epimorphisms.
          %p
            So in particular for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_{(\infty,1)}(C)
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of homotopy dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \leq 0
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \simeq PSh_{(\infty,1)}(*)
            has homotopy dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \leq 0
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, example. 7.2.1.3
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of local homotopy dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \leq 0
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, example. 7.2.1.9
          .num_theorem
            %h6#theorem Theorem
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has
              %a.existingWikiWord{:href => "/nlab/show/covering+dimension"} covering dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \leq n
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 11
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(X) := Sh_{(\infty,11)}(Op(X))
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of homotopy dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \leq n
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 7.2.3.6
          .num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≃
                  %annotation{:encoding => "application/x-tex"} \simeq
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              an object, the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \infty Grpd/X
              has homotopy dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \leq n
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} X \in Top
              a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Top)
              of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} \leq n
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, example 7.2.1.4
