                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} Level
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathbb{N} \; \mathrm{type}} \qquad \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \mathrm{Level}(A):\mathbb{N}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
