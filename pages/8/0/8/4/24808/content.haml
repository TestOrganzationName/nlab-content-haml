                        %mrow
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} lifting
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash i \; \mathrm{level}}{\Gamma \vdash U_i:U_{s(i)}} \qquad \frac{\Gamma \vdash i \; \mathrm{level} \quad \Gamma \vdash A:U_i}{\Gamma \vdash A:U_{s(i)}}\mathrm{cumul} \qquad \frac{\Gamma \vdash i \; \mathrm{level} \quad \Gamma \vdash A:U_i}{\Gamma \vdash \mathrm{Lift}_{i, j}(A):U_{s(i)}}\mathrm{lifting}
          %p In addition, we have rules for contexts which state that one could add typing judgments to the list of contexts:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} level
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi i
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ,
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash i \; \mathrm{level} \quad \Gamma \vdash A:U_i}{(\Gamma, a:A) \; \mathrm{ctx}}
          %p as well as rules saying that equality is preserved across universe levels:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} level
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi j
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} level
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mo =
                      %mi j
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi U
                        %mi i
                      %mo ≡
                      %msub
                        %mi U
                        %mi j
                      %mo :
                      %msub
