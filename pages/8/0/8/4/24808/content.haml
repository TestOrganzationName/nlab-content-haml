                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi i
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} level
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mi i
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mo :
                      %msub
                        %mi U
                        %mrow
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                  %mi{:mathvariant => "normal"} cumul
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
