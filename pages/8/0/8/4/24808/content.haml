                      %mo ⊢
                      %mi{:mathvariant => "normal"} Level
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi n
                      %mo :
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash n:\mathbb{N} \quad \Gamma \vdash A:U(n)}{\Gamma \vdash A \; \mathrm{type}} \quad \frac{\Gamma \vdash n:\mathbb{N} \quad \Gamma \vdash A:U(n)}{\Gamma \vdash \mathrm{Level}(A) \equiv n:\mathbb{N}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
