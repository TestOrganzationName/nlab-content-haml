                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mi k
