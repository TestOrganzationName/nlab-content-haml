                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\tilde E^k(X,x_0)
                  \\;\coloneqq\;
                  E^k(X,\{x_0\})
                  \\;=\;
                  ker\big(
