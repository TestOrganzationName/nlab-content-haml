          %h2#idea Idea
          %p
            Given any notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            defined on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
            %em reduced cohomology
            is that part of the cohomology which vanishes on the basepoint.
          %p
            Specifically for
            %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology+theories"} Whitehead-generalized cohomology theories
            the reduced cohomology is the cohomology relative to the base point, hence is the
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            of the operation of
            %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
            to the base point See
            %a{:href => "#RelationToUnreducedCohomology"} below
            and see at
            %em
              %a{:href => "generalized+Eilenberg-Steenrod+cohomology#RelationBetweenReducedAndUnreduced"} generalized cohomology – Relation between reduced and unreduced
            for more.
          %h2#definition Definition
          #ReducedGeneralizedCohomology.num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong
                reduced
                %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi Top
                      %mi CW
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi op
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet
                    \\;\colon\;
                    \\big(
                    Top^{\ast/}_{CW}
                    \\big)^{op}
                    \\longrightarrow
                    Ab^{\mathbb{Z}}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              (
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"}> CW-complexes
              ) to
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              (“
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"}> cohomology groups
              ”), in components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E
                    \\;\colon\;
                    \\big(
                    X \stackrel{f}{\longrightarrow} Y
                    \\big)
                    \\;\mapsto\;
                    \\big(
                    \\tilde E^\bullet(Y)
                    \\stackrel{f^\ast}{\longrightarrow}
                    \\tilde E^\bullet(X)
                    \\big)
                    \\,,
            %p
              and equipped with a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of degree +1, to be called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\tilde E^{\bullet +1}(\Sigma -)
                    \\overset{\simeq}{\longrightarrow}
                    \\tilde E^\bullet(-)
            %p such that:
            %ol
              %li
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+invariance"}> homotopy invariance
                    )
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo ,
                        %msub
                          %mi f
                          %mn 2
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f_1,f_2 \colon X \longrightarrow Y
                  are two morphisms of pointed topological spaces such that there is a (base point preserving)
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo ≃
                        %msub
                          %mi f
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} f_1 \simeq f_2
                  between them, then the induced
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  of abelian groups are
                  %a.existingWikiWord{:href => "/nlab/show/equality"} equal
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi f
                          %mn 1
                          %mo *
                        %mo =
                        %msubsup
                          %mi f
                          %mn 2
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f_1^\ast = f_2^\ast
                        \\,.
              %li#ReducedExactnessAxiom
                %p
                  %strong (exactness)
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow X
                  an inclusion of pointed topological spaces, with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} j \colon X \longrightarrow Cone(i)
                  the induced
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
                  of graded abelian groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi j
                              %mo *
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi i
                              %mo *
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde E^\bullet(Cone(i))
                        \\overset{j^\ast}{\longrightarrow}
                        \\tilde E^\bullet(X)
                        \\overset{i^\ast}{\longrightarrow}
                        \\tilde E^\bullet(A)
                        \\,.
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet
              is
              %strong additive
              if in addition
            %ul
              %li
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/wedge+axiom"}> wedge axiom
                    )
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
                  any set of pointed CW-complexes, then the canonical comparison morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∨
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi X
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde E^\bullet(\vee_{i \in I} X_i)
                        \\longrightarrow
                        \\prod_{i \in I} \tilde E^\bullet(X_i)
                %p
                  is an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  = succeed "," do
                    %a.maruku-ref{:href => "#WedgeSumAsCoproduct"}
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  of its values on the wedge summands, .
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet
              is
              %strong ordinary
              if its value on the
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0
              is concentrated in degree 0:
            %ul
              %li
                %strong (Dimension)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mrow
                            %mo •
                            %mo ≠
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝕊
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \tilde E^{\bullet\neq 0}(\mathbb{S}^0) \simeq 0
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of reduced cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo ⟶
                    %msup
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \tilde E^\bullet \longrightarrow \tilde F^\bullet
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between the underlying functors which is compatible with the suspension isomorphisms in that all the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} squares commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mover
                                %mi E
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
