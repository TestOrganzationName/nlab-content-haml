          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %mi Fib
                  %mo ,
                  %mi Cof
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}(W,Fib,Cof))
            on some
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a means to guarantee the
            %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} local smallness
            and to improve the tractability of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},W)
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            admits a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure, then its
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            (in the sense of
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi W
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}]
            at the class of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category of
            %a.existingWikiWord{:href => "/nlab/show/bifibrant+objects"} bifibrant objects
            whose morphisms are the actual
            %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            of morphisms between them (
            %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
            or
            %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+in+a+model+category"} homotopy in a model category
          %h2#definition Definition
          #HomotopyCategoryOfAModelCategory.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/bifibrant+objects"} bifibrant objects
