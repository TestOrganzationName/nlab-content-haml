                          %mi c
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
                        F \;\colon\; \mathcal{C}_c \longrightarrow \mathcal{D}
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopicalFunctor"}
          #LeftAndRightDerivedFunctors.num_cor
            %h6#corollary_2 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D}
              be
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              and consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow \mathcal{D}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves cofibrant objects and acyclic cofibrations between these, then its
                  %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕃
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \mathbb{L}F
                  exists, fitting into a
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝒞
                                  %mi c
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi F
                              %mtd
                                %msub
                                  %mi 𝒟
                                  %mi c
                            %mtr
