                              %mi 𝒞
                              %mi c
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi f
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathcal{C}_{fc}
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\mathcal{C}_c &amp;&amp; &amp;&amp; \mathcal{C}_f
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathcal{C}
                    }
            %p
              for the system of
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusions on the cofibrant objects (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_c
              ), the fibrant objects (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              ) and the objects which are both fibrant and cofibrant (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi fc
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{fc}
              ), all regarded a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .num_remark
            %h6#remark_2 Remark
            %p
              Of course the subcategories in def.
              %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              inherit more structure than just that of
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_c
              each inherit “half” of the factorization axioms. One says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              has the structure of a “
              %a.existingWikiWord{:href => "/nlab/show/fibration+category"}> fibration category
              ” called a “
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"}> category of fibrant objects
              ”, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_c
              has the structure of a “
              %a.existingWikiWord{:href => "/nlab/show/cofibration+category"}> cofibration category
              ”.
          %p
            The proof of theorem
            %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
            immediately implies the following:
          #HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma\;\colon\; \mathcal{C} \longrightarrow Ho(\mathcal{C})
              from def.
              %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              (using remark
              = succeed ")" do
                %a.maruku-ref{:href => "#EssentialUniquenessOfLocalizationFunctorOfModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              of def.
              %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi fc
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi c
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi 𝒞
                              %mi f
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi 𝒞
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi γ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \mathcal{C}_{fc}
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    \\mathcal{C}_c &amp;&amp; &amp;&amp; \mathcal{C}_f
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathcal{C}
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\gamma}}
                    \\\
                    \&amp;&amp; Ho(\mathcal{C})
                    }
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              equivalently as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              also of these subcategories. In particular there are
              %a.existingWikiWord{:href => "/nlab/show/equivalences+of+categories"} equivalences of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
