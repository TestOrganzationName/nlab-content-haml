                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Cof
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Fib
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi Y
                        %mtr
                          %mtd
                            %mi Cyl
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ∘
                                %msub
                                  %mi p
                                  %mi X
                                %mo ∘
                                %msub
                                  %mi σ
                                  %mrow
                                    %mi Q
                                    %mi X
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q X \sqcup Q X &amp;\stackrel{((Q f)_1, (Q f)_2 )}{\longrightarrow}&amp; Q Y
                    \\\
                    {}^{\mathllap{\in W \cap Cof}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{p_{Y}}}_{\mathrlap{\in Fib}}
                    \\\
                    Cyl(Q X)
                    \&amp;\underset{f \circ p_{X} \circ \sigma_{Q X}}{\longrightarrow}&amp;
                    Y
                    }
                    \\,.
            %p
              Hence also the composites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mrow
                        %mi Q
                        %mi Y
                    %mo ∘
