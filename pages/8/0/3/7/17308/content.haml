                  %annotation{:encoding => "application/x-tex"} j_{Q Y}\circ (Q_f)_i
              are
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopic
              to each other, and since their domain is cofibrant, they are also
              %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopic
              (via
              %a{:href => "homotopy+in+a+model+category#LeftHomotopyWithCofibrantDomainImpliesRightHomotopyAndDually"} this
              lemma) by a right homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
