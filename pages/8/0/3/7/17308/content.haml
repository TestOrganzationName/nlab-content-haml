                    %mi Q
                    %mi f
                  %annotation{:encoding => "application/x-tex"} Q f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Q
                    %mi f
                  %annotation{:encoding => "application/x-tex"} R Q f
              imply that also the following diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
