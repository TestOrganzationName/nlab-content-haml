                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi 𝒞
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mo ≃
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
