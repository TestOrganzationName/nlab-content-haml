          %p
            The key fact that makes def.
            %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
            practically useful is the following
          #KenBrownLemma.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"}> Ken Brown's lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              with
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi f
                    %mo ,
                    %msub
                      %mi 𝒞
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_f, \mathcal{C}_c
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} of fibrant objects
              and
              %a.existingWikiWord{:href => "/nlab/show/cofibration+category"} of cofibrant objects
              respectively (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝒞
                          %mi f
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
                        F \;\colon\; \mathcal{C}_f \longrightarrow \mathcal{D}
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopicalFunctor"}
            %ol
              %li
