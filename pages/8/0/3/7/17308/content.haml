            %p
              one sees that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R Q g)\circ (R Q f)
              is a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g \circ f
              and hence the same argument as above gives that it is homotopic to the chosen
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R Q(g \circ f)
          #HomotopyCategoryOfACategoryWithWeakEquivalences.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              (or:
              %em
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              at the weak equivalences) is, if it exists, a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma \colon \mathcal{C} \longrightarrow Ho(C)
            %p
              which sends weak equivalences to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal with this property
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \longrightarrow D
              any
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              into any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              takes weak equivalences to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              up to a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi γ
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mover
                                  %mi F
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp; D
                    \\\
                    \&amp; {}_{\mathllap{\gamma}}\searrow &amp;\Downarrow^{\rho}&amp; \nearrow_{\mathrlap{\tilde F}}
                    \\\
                    \&amp;&amp; Ho(\mathcal{C})
                    }
            %p
              and this factorization is unique up to unique isomorphism, in that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde F_1, \rho_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde F_2, \rho_2)
              two such factorizations, then there is a unique
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo ⇒
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \kappa \colon \tilde F_1 \Rightarrow \tilde F_2
              making the evident diagram of natural isomorphisms commute.
          #UniversalPropertyOfHomotopyCategoryOfAModelCategory.num_theorem
            %h6#theorem Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mi R
                        %mo ,
                        %mi Q
                  %annotation{:encoding => "application/x-tex"} \gamma_{R,Q}
              in def.
              %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              (for any choice of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              as indeed being the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of the underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
          .proof
            %h6#proof_3 Proof
            %p
              First, to see that that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              indeed takes weak equivalences to isomorphisms: By
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              shown in the proof of lemma
              %a.maruku-ref{:href => "#ConstructionOfLocalizationFunctorForModelCategoryIsWellDefined"}
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Q
                    %mi f
                  %annotation{:encoding => "application/x-tex"} R Q f
              is a weak equivalence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %munderover
                              %mo ⟵
                              %mo ≃
                              %mrow
                                %msub
                                  %mi p
                                  %mi X
                          %mtd
                            %mi Q
                            %mi X
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi X
                          %mtd
                            %mi R
                            %mi Q
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Q
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi R
                                  %mi Q
                                  %mi f
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi p
                                  %mi y
                              %mo ≃
                          %mtd
                            %mi Q
                            %mi Y
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi Y
                              %mo ≃
                          %mtd
                            %mi R
                            %mi Q
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\underoverset{\simeq}{p_X}{\longleftarrow}&amp; Q X &amp;\underoverset{\simeq}{j_{Q X}}{\longrightarrow}&amp; R Q X
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{Q f}} &amp;&amp; \downarrow^{\mathrlap{R Q f}}
                    \\\
                    Y &amp;\underoverset{p_y}{\simeq}{\longleftarrow}&amp; Q Y &amp;\underoverset{j_{Q Y}}{\simeq}{\longrightarrow}&amp; R Q Y
                    }
            %p
              With this the “Whitehead theorem for model categories”, lemma
              = succeed "," do
                %a.maruku-ref{:href => "#WhiteheadTheoremInModelCategories"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Q
                    %mi f
                  %annotation{:encoding => "application/x-tex"} R Q f
              represents an isomorphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow D
              be any functor that sends weak equivalences to isomorphisms. We need to show that it factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi γ
                            %mo ↘
                          %mtd
                            %msup
                              %mo ⇓
                              %mi ρ
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mover
                                  %mi F
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp; D
                    \\\
                    \&amp; {}_{\mathllap{\gamma}}\searrow &amp;\Downarrow^{\rho}&amp; \nearrow_{\mathrlap{\tilde F}}
                    \\\
                    \&amp;&amp; Ho(\mathcal{C})
                    }
            %p
              uniquely up to unique
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mrow
                        %mi R
                        %mo ,
                        %mi Q
                  %annotation{:encoding => "application/x-tex"} \gamma_{R,Q}
              is the identity on the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of fibrant-cofibrant objects. It follows that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde F
              exists at all, it must satisfy for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} Y
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              both fibrant and cofibrant that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde F([f]) \simeq F(f)
                    \\,.
            %p
              But by def.
              %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              that already fixes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde F
              on all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde F
              there exists any
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              filling the diagram above.
            %p
              To that end, apply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to the above
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              to obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟵
                              %mi iso
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi p
                                  %mi X
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mi iso
                              %mrow
                                %mi F
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi X
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi Q
                                  %mi f
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi F
