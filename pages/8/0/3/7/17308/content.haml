                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mi Path
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Cof
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Fib
                        %mtr
                          %mtd
                            %mi R
                            %mi Q
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mi Q
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mn 1
                                %mo ,
                                %mi R
                                %mo{:stretchy => "false"} (
                                %mi Q
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi R
                            %mi Q
                            %mi Y
                            %mo ×
                            %mi R
                            %mi Q
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q X &amp;\overset{\kappa}{\longrightarrow}&amp; Path(R Q Y)
                    \\\
                    {}^{\mathllap{\in W \cap Cof}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\in Fib}}
                    \\\
                    R Q X &amp;\underset{(R (Q f)_1, R (Q f)_2)}{\longrightarrow}&amp;
                    R Q Y \times R Q Y
                    }
            %p
              that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} R (Q f)_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} R (Q f)_2
              are right homotopic, hence that indeed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Q
                    %mi f
                  %annotation{:encoding => "application/x-tex"} R Q f
              represents a well-defined
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
            %p
              Finally to see that the assignment is indeed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
