                    \\,.
          %p
            In fact, for computing
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            in the homotopy category, it is sufficient that the
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            is
            %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
            and the
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
          #HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory.num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              fibrant, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P, Q
              fibrant/cofibrant replacement functors as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi j
                          %mi X
                        %mo ,
                        %msub
                          %mi p
                          %mi Y
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Ho(\mathcal{C})}(P X,Q Y)
                    \=
                    Hom_{\mathcal{C}}(P X, Q Y)/_{\sim}
                    \\overset{Hom_{\mathcal{C}}(j_X, p_Y)}{\longrightarrow}
                    Hom_{\mathcal{C}}(X,Y)/_{\sim}
            %p
              (on
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of morphisms, well defined by prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#BetweenCofibFibLeftAndRightHomotopyAreEquivalentEquivalenceRelations"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
          %p
            (
            %a{:href => "#Quillen67"}> Quillen 67, I.1 corollary 1
            )
          .proof
            %h6#proof_4 Proof
            %p We may factor the morphism in question as the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mrow
                            %mi P
                            %mi X
                        %mo ,
                        %msub
                          %mi p
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} /
                          %mo ∼
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi j
                          %mi X
                        %mo ,
                        %msub
                          %mi id
                          %mi Y
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} /
                          %mo ∼
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(P X, Q Y)/_{\sim}
                    \\overset{Hom_{\mathcal{C}}(id_{P X}, p_Y)/_\sim }{\longrightarrow}
                    Hom_{\mathcal{C}}(P X, Y)/_{\sim}
                    \\overset{Hom_{\mathcal{C}}(j_X, id_Y)/_\sim}{\longrightarrow}
                    Hom_{\mathcal{C}}(X,Y)/_{\sim}
                    \\,.
            %p
              This shows that it is sufficient to see that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              fibrant, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %msub
                      %mi p
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo →
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(id_X, p_Y)/_\sim
                    \\;\colon\;
                    Hom_{\mathcal{C}}(X, Q Y)/_\sim \to Hom_{\mathcal{C}}(X,Y)/_\sim
            %p is an isomorphism, and dually that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi j
                      %mi X
                    %mo ,
                    %msub
                      %mi id
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %mo →
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}(j_X, id_Y)/_\sim
                    \\;\colon\;
                    Hom_{\mathcal{C}}(P X, Y)/_\sim \to Hom_{\mathcal{C}}(X,Y)/_\sim
            %p
              is an isomorphism. We discuss this for the former; the second is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              First, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %msub
                      %mi p
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(id_X, p_Y)
              is surjective is the
              %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ∅
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Q
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Cof
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi Y
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\emptyset &amp;\longrightarrow&amp; Q Y
                    \\\
                    {}^{\mathllap{\in Cof}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_Y}}_{\mathrlap{\in W \cap Fib}}
                    \\\
                    X &amp;\overset{f}{\longrightarrow}&amp; Y
                    }
                    \\,,
            %p
              which says that any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              comes from a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Q
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \hat f \colon X \to Q Y
              under postcomposition with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi Y
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mi Y
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Q Y \overset{p_Y}{\to} Y
            %p
              Second, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mi X
                    %mo ,
                    %msub
                      %mi p
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(id_X, p_Y)
              is injective is the lifting property in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ⊔
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Q
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi Cof
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msubsup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi Y
                        %mtr
                          %mtd
                            %mi Cyl
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \sqcup X &amp;\overset{(f,g)}{\longrightarrow}&amp; Q Y
                    \\\
                    {}^{\mathllap{\in Cof}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_Y}}_{\mathrlap{\in W \cap Fib}}
                    \\\
                    Cyl(X) &amp;\underset{\eta}{\longrightarrow}&amp; Y
                    }
                    \\,,
            %p
              which says that if two morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Q
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f, g \colon X \to Q Y
              become homotopic after postcomposition with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi Y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Q
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p_Y \colon Q X \to Y
          %h2#DerivedFunctors Derived functors
          #HomotopicalFunctor.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow \mathcal{D}
              is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              if it sends weak equivalences to weak equivalences.
          #DerivedFunctorOfAHomotopicalFunctor.num_defn
            %h6#definition_7 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \longrightarrow \mathcal{D}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopicalFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              whose
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{D})
              exist (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              is the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(F)
              between these homotopy categories which is induced uniquely, up to unique isomorphism, by their universal property (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                            %mover
                              %mo ⟶
                              %mi F
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi γ
                                    %mi 𝒞
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi γ
                                    %mi 𝒟
                        %mtr
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo ∃
                                %mspace{:width => "thickmathspace"}
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    {}^{\mathllap{\gamma_{\mathcal{C}}}}\downarrow
                    \&amp;\swArrow_{\simeq}&amp;
                    \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                    \\\
                    Ho(\mathcal{C})
                    \&amp;\underset{\exists \; Ho(F)}{\longrightarrow}&amp;
                    Ho(\mathcal{D})
                    }
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              While many functors of interest between
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              are not homotopical in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopicalFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              of fibrant object or of cofibrant objects, def.
              = succeed "." do
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              %a.maruku-ref{:href => "#HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects"}
              this is just as good for the purpose of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            Therefore one considers the following generalization of def.
            = succeed ":" do
              %a.maruku-ref{:href => "#DerivedFunctorOfAHomotopicalFunctor"}
          #LeftAndRightDerivedFunctorsOnModelCategories.num_defn
            %h6#definition_8 Definition
            %p
              Consider a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \longrightarrow \mathcal{D}
              out of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              into a
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %ol
              %li
