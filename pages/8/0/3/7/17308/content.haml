                            %mtr
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒞
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %mi 𝕃
                                    %mi F
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒟
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{C}_{c} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}_{c}
                        \\\
                        {}^{\mathllap{\gamma_{\mathcal{C}}}}\downarrow
                        \&amp;\swArrow_{\simeq}&amp;
                        \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                        \\\
                        Ho(\mathcal{C}) &amp;\overset{\mathbb{L}F}{\longrightarrow}&amp; Ho(\mathcal{D})
                        }
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves fibrant objects and acyclic fibrants between these, then its
                  %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}F
                  exists, fitting into a
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝒞
                                  %mi f
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mi F
                              %mtd
                                %msub
                                  %mi 𝒟
                                  %mi f
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi 𝒞
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mo ≃
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi γ
                                        %mi 𝒟
                            %mtr
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒞
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mi ℝ
                                    %mi F
                              %mtd
                                %mi Ho
                                %mo{:stretchy => "false"} (
                                %mi 𝒟
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{C}_{f} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}_{f}
                        \\\
                        {}^{\mathllap{\gamma_{\mathcal{C}}}}\downarrow
                        \&amp;\swArrow_{\simeq}&amp;
                        \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                        \\\
                        Ho(\mathcal{C}) &amp;\underset{\mathbb{R}F}{\longrightarrow}&amp; Ho(\mathcal{D})
                        }
                        \\,.
          %p
            In practice it turns out to be useful to arrange for the assumptions in corollary
            %a.maruku-ref{:href => "#LeftAndRightDerivedFunctors"}
            to be satisfied in the following neat way:
          #QuillenAdjunction.num_defn
            %h6#definition_9 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D}
              be
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              between them
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mover
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi L
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R)
                    \\;\colon\;
                    \\mathcal{C}
                    \\stackrel{\overset{L}{\longleftarrow}}{\underset{R}{\longrightarrow}}
                    \\mathcal{D}
            %p
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              are called left/right
              = succeed "," do
                %em Quillen functors
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves cofibrations and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves fibrations;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves acyclic cofibrations and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves acyclic fibrations;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves cofibrations and acylic cofibrations;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves fibrations and acyclic fibrations.
          #ConditionsOnQuillenAdjunctionAreIndeedEquivalent.num_prop
            %h6#proposition_2 Proposition
            %p
              The conditions in def.
              %a.maruku-ref{:href => "#QuillenAdjunction"}
              are indeed all equivalent.
          .proof
            %h6#proof_5 Proof
            %p Observe that
            %ul
              %li
                %p
                  (i)
                  %em
                    A
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    between
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                    preserves acyclic cofibrations precisely if its
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    preserves fibrations.
              %li
                %p
                  (ii)
                  %em
                    A
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    between
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                    preserves cofibrations precisely if its
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    preserves acyclic fibrations.
            %p
              We discuss statement (i), statement (ii) is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
              be an acyclic cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} g \colon X \to Y
              a fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              as on the left of the following, its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L\dashv R)
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              is a commuting diagram as on the right here:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
