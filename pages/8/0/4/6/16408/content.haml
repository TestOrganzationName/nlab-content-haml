          %h2#idea Idea
          %p
            A
            %strong combinatorial map
            is a representation of a graph embedded in a surface (i.e., a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+map"} topological map
            %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            if and only if the corresponding graphs are isomorphic by a
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            of the underlying surfaces. The precise formulation depends upon assumptions made about the underlying surface (e.g., whether it is
            %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            and/or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
          %h2#oriented_maps_and_hypermaps Oriented maps and hypermaps
          %h3#classical_combinatorial_maps Classical combinatorial maps
          %p The following definition corresponds to the case which is perhaps most well-studied:
          #def_cmap.num_definition
            %h6#definition Definition
            %p
              A
              %strong combinatorial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (whose elements are called
              = succeed ")" do
                %em darts
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\sigma,\alpha,\phi)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              such that:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle \sigma,\alpha,\phi\rangle
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Aut(D)
                  generated by the permutations acts
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  the composition of the permutations is the identity:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mi α
                          %mi σ
                          %mo =
                          %mi id
                        %annotation{:encoding => "application/x-tex"} \phi\alpha\sigma = id
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                  is a
                  = succeed "-free" do
                    %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/involution"} involution
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of combinatorial maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo →
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M \to M'
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mi α
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi M
                  %mo ′
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ′
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ′
                  %mo ,
                  %mi α
                  %mo ′
                  %mo ,
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M = (D,(\sigma,\alpha,\phi)), M' = (D',(\sigma',\alpha',\phi'))
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi D
                  %mo →
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} h : D \to D'
            which commutes with each of the respective permutations,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mi σ
                  %mo =
                  %mi σ
                  %mo ′
                  %mi h
                  %mspace{:width => "2em"}
                  %mi h
                  %mi α
                  %mo =
                  %mi α
                  %mo ′
                  %mi h
                  %mspace{:width => "2em"}
                  %mi h
                  %mi ϕ
                  %mo =
                  %mi ϕ
                  %mo ′
                  %mi h
                  %mo .
                %annotation{:encoding => "application/x-tex"} h\sigma = \sigma'h \qquad h\alpha = \alpha'h \qquad h\phi = \phi' h.
          %p
            Hence,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ′
                %annotation{:encoding => "application/x-tex"} M'
            are
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            as maps if and only there is a bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi D
                  %mo ≅
                  %mi D
                  %mo ′
                %annotation{:encoding => "application/x-tex"} h : D \cong D'
            between their underlying sets of darts, such that the triple of permutations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mi α
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\sigma,\alpha,\phi)
            is mapped by
            %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            to the triple of permutations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ′
                    %mo ,
                    %mi α
                    %mo ′
                    %mo ,
                    %mi ϕ
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\sigma',\alpha',\phi')
          %p
            In the literature, many authors equivalently define a combinatorial map by a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\sigma,\alpha)
            of permutations, since by condition (2) above, the third permutation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            can always be recovered uniquely as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %msup
                      %mi σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi α
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi = \sigma^{-1}\alpha^{-1}
          %h3#representing_an_embedded_graph_as_a_combinatorial_map Representing an embedded graph as a combinatorial map
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            be an embedding of a
            %a.existingWikiWord{:href => "/nlab/show/graph"} graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            edges into a
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact"} compact
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            (below we will just call these “oriented surfaces” for short). We can associate a combinatorial map to this topological embedding, which is unique up to isomorphism:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is defined as a set containing
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
                elements, with a pair of distinct darts
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mo +
                      %mo ,
                      %msup
                        %mi e
                        %mo −
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} e^+,e^- \in D
                for each edge
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} e \in G
            %li
              %p
                the collection of edges induces a fixed point-free involution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mo +
                    %annotation{:encoding => "application/x-tex"} e^+
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mo −
                    %annotation{:encoding => "application/x-tex"} e^-
                for each edge
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} e \in G
            %li
              %p
                suppose darts are visualized as oriented edges: we will say that a dart
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                is
                %em incident
                to a vertex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is the unique vertex located at the source of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} x\in G
                determines a cyclic ordering of the darts incident to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %a.existingWikiWord{:href => "/nlab/show/loop"} loop
                around
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \theta(x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is oriented), each vertex determines a cycle of the permutation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
            %li
              %p
                similarly, we say that a dart
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                is incident to a face
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                (i.e., a connected component of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∖
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \setminus \theta(G)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is the unique face appearing to the left of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                determines a cyclic ordering of darts incident to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                (corresponding to a counterclockwise traversal along the perimeter of
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
            %li
              %p
                if we start at any dart
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi D
                      %annotation{:encoding => "application/x-tex"} d \in D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                followed by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                followed followed by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
          %h3#hypermaps_and_constellations Hypermaps and constellations
          %p
            There are several directions for generalizing the classical definition. A small but useful generalization is to drop the requirement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            be
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            free, while keeping the requirement that it be an
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            (i.e., that
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mn 2
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} \alpha^2 = id
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
            has length 2 or 1, with orbits of length 2 representing complete edges and orbits of length 1 representing dangling edges.
          %p As a bigger step, it is possible to drop condition (3) altogether:
          #def_hmap.num_definition
            %h6#definition_2 Definition
            %p
              A
              %strong combinatorial hypermap
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              equipped with a triple of
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\sigma,\alpha,\phi)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              such that:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle \sigma,\alpha,\phi\rangle
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Aut(D)
                  generated by the permutations acts
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  the composition of the permutations is the identity:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mi α
                          %mi σ
                          %mo =
                          %mi id
                        %annotation{:encoding => "application/x-tex"} \phi\alpha\sigma = id
          %p
            A combinatorial hypermap gives a representation of a topological embedding of a
            %a.existingWikiWord{:href => "/nlab/show/hypergraph"} hypergraph
            in a oriented surface, but (as noted by Walsh) this is equivalent to an embedding of an ordinary graph equipped with a
            %a.existingWikiWord{:href => "/nlab/show/vertex+coloring"} 2-coloring
            of its vertices. (Such a graph is necessarily a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/bipartite+graph"} bipartite graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            represent the cycles around the black and white vertices, respectively, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            as before represents the faces. Any ordinary map with all black vertices can be seen as a hypermap with a white vertex dividing each edge (thinking of darts as half-edges), and from that perspective, the definition of hypermap simply corresponds to lifting the restriction that white vertices have degree 2.
          %p
            Both of these generalizations of the standard notion of combinatorial map are studied in the literature on so-called
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dessins+d%27enfants"} dessins d'enfants
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                is a fixed point free involution : “clean dessin”
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                is an involution : “pre-clean dessin”
            %li
              %p
                no conditions on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                (besides (1) and (2) above): “dessin”
          %p
            Another line of generalization is to consider an arbitrary number of permutations (rather than only three). This more general notion of hypermap is called a “constellation” in
            = succeed "." do
              %a{:href => "#LandoZvonkin04"} Lando &amp; Zvonkin
          #def_constellation.num_definition
            %h6#definition_3 Definition
            %p
              A
              %strong k-constellation
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              equipped with a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              of
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi α
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \alpha_1,\dots,\alpha_k
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              such that:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %msub
                          %mi α
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi α
                          %mi k
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle \alpha_1,\dots,\alpha_k\rangle
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Aut
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Aut(D)
                  generated by the permutations acts
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                        %annotation{:encoding => "application/x-tex"} D
              %li
                %p
                  the composition of the permutations is the identity:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi α
                            %mi k
                          %mi …
                          %msub
                            %mi α
                            %mn 1
                          %mo =
                          %mi id
                        %annotation{:encoding => "application/x-tex"} \alpha_k\dots\alpha_1 = id
          %h3#fixed_vertexedgeface_degrees Fixed vertex/edge/face degrees
          %p If one adds, say, the condition that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mn 3
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} \sigma^3 = id
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              has no fixed points
          %p
            to the definition of combinatorial map, then the resulting class of permutations represent embeddings of
            %em trivalent
            graphs, i.e., where every vertex has degree 3. Dually, placing the condition that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mn 3
                    %mo =
                    %mi id
                  %annotation{:encoding => "application/x-tex"} \phi^3 = id
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              has no fixed points
          %p
            gives a way of representing arbitrary
            %a.existingWikiWord{:href => "/nlab/show/triangulations"} triangulations
            of oriented surfaces. Analogous to what we saw above in the case of the edge involution
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            be fixed point free also allows for the possibility of degenerate vertices/faces of degree 1.
          %p
            More generally, we can say that a map has type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (m,n)
            if the permutations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            have
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/order#in_the_sense_of_group_theory"} order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            respectively (allowing for the possibility that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo =
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} m = \infty
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} n = \infty
            in the case where the set of darts is infinite). This algebraic condition translates to the geometric condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is the
            %a.existingWikiWord{:href => "/nlab/show/least+common+multiple"} least common multiple
            of the degrees of the vertices of the map, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is the least common multiple of the degrees of the faces.
          %h3#realizing_a_combinatorial_map_as_a_graph_embedded_in_a_riemann_surface Realizing a combinatorial map as a graph embedded in a Riemann surface
          %p
            Conversely, any combinatorial map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mi α
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M = (D,(\sigma,\alpha,\phi))
            can be realized as a graph embedded in a surface, in other words as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+map"} topological map
            = succeed "." do
              %a{:href => "#Edmonds60"} Edmonds 1960
          %p
            The underlying graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(M)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is easy to describe using the “Serre” definition of a graph (as explained
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/graph#definition_in_terms_of_action_on_a_set_of_halfedges"} here
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi V
                    %mo ,
                    %mi i
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(M) = (H,V,i,s)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            and the involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            are just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is the set of
            = succeed "-orbits," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi H
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} s : H \to V
            sends any dart to its orbit under
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            Some more work is required in order to define a surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and an embedding of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(M)
            into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a{:href => "#JonesSingerman78"} Jones and Singerman 1978
            actually proved a stronger result than Edmonds’ algorithm, showing that any combinatorial map (of finite type
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m,n)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
          %h3#genus_of_a_combinatorial_map Genus of a combinatorial map
          %p
            The
            %strong genus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            of a combinatorial map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo ,
                  %mi α
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M = (\sigma,\alpha,\phi)
            can be defined directly using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler-Poincaré formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mo −
                  %mn 2
                  %mi g
                %annotation{:encoding => "application/x-tex"} \chi(M) = c(\sigma) - c(\alpha) + c(\phi) = 2-2g
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c(\pi)
            counts the number of cycles in the
            %a.existingWikiWord{:href => "/nlab/show/permutation#via_cycle_decompositions"} cyclic decomposition
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            (i.e., the number of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %h3#dual_map Dual map
          %p
            Any embedded graph has a dual graph embedded into the same surface, constructed by placing a vertex in the middle of each face, and connecting two vertices whenever the corresponding faces share an edge. This construction is particularly easy to express on combinatorial maps: for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M = (D,(\sigma,\alpha,\phi))
            %strong dual map
            is defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %msup
                      %mi α
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %msup
                      %mi σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M^* = (D,(\phi^{-1},\alpha^{-1},\sigma^{-1}))
          %h2#equivalence_with_other_families_of_objects Equivalence with other families of objects
          %h3#tetravalent_maps_with_bicolored_faces Tetravalent maps with bicolored faces
          %p
            To any graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            embedded in an oriented surface
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi m
                %annotation{:encoding => "application/x-tex"} G^m
            embedded in the same surface
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by the following construction:
          %ul
            %li
              %p
                one vertex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mi e
                      %mo ∈
                      %msup
                        %mi G
                        %mi m
                    %annotation{:encoding => "application/x-tex"} v_e \in G^m
                for every edge
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} e \in G
            %li
              %p
                one edge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi v
                        %mrow
                          %msub
                            %mi e
                            %mn 1
                      %mo ∼
                      %msub
                        %mi v
                        %mrow
                          %msub
                            %mi e
                            %mn 2
                      %mo ∈
                      %msup
                        %mi G
                        %mi m
                    %annotation{:encoding => "application/x-tex"} v_{e_1} \sim v_{e_2} \in G^m
                for every ordered pair of edges
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo ,
                      %msub
                        %mi e
                        %mn 2
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} e_1,e_2 \in G
                which occur consecutively along the same face in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \theta(G)
          %p
            In graph theory, this is known as the
            %strong medial graph
            construction. As with the dual graph construction, though, note that this is only well-defined as an operation on embedded graphs (i.e., topological maps) rather than on abstract graphs: the same graph can have different medial graphs, depending on how it is embedded into a surface. To avoid confusion, we refer to this as the
            %strong medial map
            construction.
          %p
            Two topological maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                %annotation{:encoding => "application/x-tex"} M_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 2
                %annotation{:encoding => "application/x-tex"} M_2
            have isomorphic medial maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi M
                    %mn 1
                    %mi m
                  %mo ≅
                  %msubsup
                    %mi M
                    %mn 2
                    %mi m
                %annotation{:encoding => "application/x-tex"} M_1^m \cong M_2^m
            if and only if they are either isomorphic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mn 1
                  %mo ≅
                  %msub
                    %mi M
                    %mn 2
                %annotation{:encoding => "application/x-tex"} M_1 \cong M_2
            or dual
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                    %mo ≅
                    %msubsup
                      %mi M
                      %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"} M_1 \cong M_2^*
            %em faces
            of the medial map as follows: a face of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi m
                %annotation{:encoding => "application/x-tex"} M^m
            is colored in black just in case it contains a vertex of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %h3#alternating_virtual_links Alternating virtual links
          %p
            Any
            %em alternating
            virtual link (in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/virtual+knot+theory"} virtual knot theory
            %a{:href => "#ZJZ2004"} Zinn-Justin and Zuber 2004
            where they discuss this representation.
          %h2#the_category_of_oriented_maps The category of oriented maps
          %p
            In this section we will adopt the more liberal notion of combinatorial map described above, for which the involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is allowed to have fixed points corresponding to “dangling” edges. We will also sometimes write
            %em map
            as shorthand for combinatorial map in this more liberal sense.
          #def_cm.num_definition
            %h6#definition_4 Definition
            %p
              The
              %strong category of combinatorial maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CM
                  %annotation{:encoding => "application/x-tex"} CM
              is defined as follows:
            %ul
              %li
                %p
                  objects are pairs of a set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  together with a triple of permutations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\sigma,\alpha,\phi)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ρ
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle\sigma,\alpha,\rho\rangle
                  acts transitively on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi α
                            %mn 2
                          %mo =
                          %mi ϕ
                          %mi α
                          %mi σ
                          %mo =
                          %mi id
                        %annotation{:encoding => "application/x-tex"} \alpha^2 = \phi\alpha\sigma = id
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo ′
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ′
                        %mo ,
                        %mi α
                        %mo ′
                        %mo ,
                        %mi ϕ
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (D,(\sigma,\alpha,\phi)) \to (D',(\sigma',\alpha',\phi'))
                  are functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi D
                        %mo →
                        %mi D
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} h : D \to D'
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mi σ
                          %mo =
                          %mi σ
                          %mo ′
                          %mi h
                        %annotation{:encoding => "application/x-tex"} h\sigma = \sigma' h
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mi α
                          %mo =
                          %mi α
                          %mo ′
                          %mi h
                        %annotation{:encoding => "application/x-tex"} h\alpha = \alpha' h
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mi ϕ
                          %mo =
                          %mi ϕ
                          %mo ′
                          %mi h
                        %annotation{:encoding => "application/x-tex"} h\phi = \phi' h
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CM
                %annotation{:encoding => "application/x-tex"} CM
            was defined by
            %a{:href => "#JonesSingerman78"} Jones and Singerman 1978
            essentially as above (they call it
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi AM
                %annotation{:encoding => "application/x-tex"} AM
            for “algebraic maps”). Specifically, Jones and Singerman take this category to include combinatorial maps in which the involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            may contain fix points.
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CM
                  %annotation{:encoding => "application/x-tex"} CM
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi CM
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U : CM \to Set
              which sends any combinatorial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (D,(\sigma,\alpha,\phi))
              to its underlying set of darts
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi M
                    %mo →
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} h : M \to M'
              to a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi D
                    %mo →
                    %mi D
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} h : D \to D'
              between the underlying sets of darts.
          %h3#terminal_object Terminal object
          %p
            We note that the following property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CM
                %annotation{:encoding => "application/x-tex"} CM
            relies on allowing maps with dangling edges.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo *
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} 1 = \{ * \}
              equipped with the triple of identity permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo =
                    %mi α
                    %mo =
                    %mi ϕ
                    %mo =
                    %msub
                      %mi id
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma = \alpha = \phi = id_1
              is a map, and is a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CM
                    %annotation{:encoding => "application/x-tex"} CM
          %h3#the_oriented_cartographic_group The oriented cartographic group
          %p
            (See also article:
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/cartographic+group"} cartographic group
          #def_cartgp.num_definition
            %h6#definition_5 Definition
            %p
              The
              %strong oriented cartographic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+
              is the group generated by three elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 0
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \rho_0,\rho_1,\rho_2
              satisfying the relations
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ρ
                        %mn 1
                        %mn 2
                      %mo =
                      %msub
                        %mi ρ
                        %mn 0
                      %msub
                        %mi ρ
                        %mn 1
                      %msub
                        %mi ρ
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \rho_1^2 = \rho_0\rho_1\rho_2 = 1
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The oriented cartographic group is isomorphic to a
              %a.existingWikiWord{:href => "/nlab/show/free+product+of+groups"} free product
              of the integers with the integers modulo 2,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒞
                        %mn 2
                        %mo +
                      %mo ≅
                      %mi ℤ
                      %mo ⋆
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+ \cong \mathbb{Z} \star \mathbb{Z}_2
          %p
            Every combinatorial map is a
            = succeed "-set," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CM
                %annotation{:encoding => "application/x-tex"} CM
            is just the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒞
                    %mn 2
                    %mo +
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+Set
            consisting of sets equipped with a
            %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive action
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+
          .num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/moebius+transformation#abstract_structure_of_modular_group"} modular group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi ℤ
                      %mn 3
                    %mo ⋆
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} PSL_2(\mathbb{Z}) \cong \mathbb{Z}_3 \star \mathbb{Z}_2
              is a quotient of the oriented cartographic group. Sets equipped with a transitive action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSL_2(\mathbb{Z})
              are the same thing as trivalent combinatorial maps, which represent trivalent graphs (possibly including degeneracies) embedded in oriented surfaces (or dually, triangulations of oriented surfaces).
          %p
            For any given map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with underlying set of darts
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            we will denote the action of the oriented cartographic group by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo *
                    %mi M
                  %mo :
                  %mi D
                  %mo ×
                  %msubsup
                    %mi 𝒞
                    %mn 2
                    %mo +
                  %mo →
                  %mi D
                  %mo ,
                %annotation{:encoding => "application/x-tex"} *_M : D \times \mathcal{C}_2^+ \to D,
          %p
            omitting subscripts when clear from context. The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒞
                    %mn 2
                    %mo +
                %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+
            acts transitively on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            corresponds to the topological condition that the graph represented by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is connected. As we will see, this places strong restrictions on possible morphisms between maps:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi M
                      %mn 1
                    %mo →
                    %msub
                      %mi M
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h : M_1 \to M_2
              of combinatorial maps is entirely determined given the image of a single dart
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi D
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} h(d_1) \in D_2
          .proof
            %h6#proof Proof
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo ′
                      %mo ∈
                      %msub
                        %mi D
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_1' \in D_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} w \in \mathcal{C}_2^+
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo ′
                      %mo =
                      %msub
                        %mi d
                        %mn 1
                      %msub
                        %mo *
                        %mn 1
                      %mi w
                    %annotation{:encoding => "application/x-tex"} d_1' = d_1 *_1 w
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %msub
                        %mo *
                        %mn 1
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo *
                        %mn 2
                      %mi w
                    %annotation{:encoding => "application/x-tex"} h(d_1') = h(d_1 *_1 w) = h(d_1) *_2 w
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi M
                      %mn 1
                    %mo →
                    %msub
                      %mi M
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h : M_1 \to M_2
              is a morphism of combinatorial maps and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D_1
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi D
                      %mn 1
                    %mo →
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} h : D_1 \to D_2
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
          .proof
            %h6#proof_2 Proof
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mo ∈
                      %msub
                        %mi D
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d_2 \in D_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} D_1
              is inhabited there exists a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo ∈
                      %msub
                        %mi D
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} d_1 \in D_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} w \in \mathcal{C}_2^+
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo *
                        %mn 2
                      %mi w
                    %annotation{:encoding => "application/x-tex"} d_2 = h(d_1) *_2 w
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo *
                        %mn 2
                      %mi w
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %msub
                        %mo *
                        %mn 1
                      %mi w
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h(d_1) *_2 w = h(d_1 *_1 w)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %msub
                      %mo *
                      %mn 1
                    %mi w
                    %mo ∈
                    %msub
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1 *_1 w \in D_1
              is in the inverse image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                      %mo ∈
                      %msub
                        %mi D
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} d_2 \in D_2
          %h3#rooted_maps Rooted maps
          %p
            Enumeration of maps is an active branch of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorics
            %a.existingWikiWord{:href => "/nlab/show/W.+T.+Tutte"} W. T. Tutte
            in the 1960s. One of the difficulties with trying to count (combinatorial or topological) maps directly, though, is that they can have non-trivial symmetries, which would need to be accounted for to avoid double-counting. This is why combinatorists typically begin with the easier problem of counting
            = succeed "," do
              %em rooted maps
          %blockquote
            %p Having made no progress with the enumeration of these diagrams [(strict triangulations of the plane)] I bethought myself of Cayley’s work on the enumeration of trees. His first successes had been with the rooted trees, in which one vertex is distinguished as the “root”. Perhaps I should root the strict triangulations in some way and try to enumerate the rooted ones. Eventually I decided that the rooting should consist of the choice of a face, edge and vertex, mutually incident….
            %p I am not sure what I would have replied at this stage if I had been asked why I preferred these rooted triangulations to the unrooted ones…. Later I realized that the distinguishing feature and the great advantage of rooted maps is that they have no symmetry. Automorphisms seem to complicate enumerative problems.
            %p
              (From Chapter 10 of W. T. Tutte,
              = succeed "," do
                %em Graph Theory As I Have Known It
          %p
            For a combinatorial map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (D,(\sigma,\alpha,\phi))
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} r \in D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            under the three permutations. Rooted combinatorial maps may be organized into another category:
          #def_rcm.num_definition
            %h6#definition_6 Definition
            %p
              The
              %strong category of rooted combinatorial maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CM
                      %mo •
                  %annotation{:encoding => "application/x-tex"} CM_\bullet
              is defined as follows:
            %ul
              %li
                %p
                  objects are pairs of a map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi σ
                        %mo ,
                        %mi α
                        %mo ,
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} M = (D,(\sigma,\alpha,\phi))
                  together with a distinguished dart
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∈
                        %mi D
                      %annotation{:encoding => "application/x-tex"} r \in D
                  called the
                  = succeed "." do
                    %em root
              %li
                %p
                  morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi r
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ′
                        %mo ,
                        %mi r
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (M,r) \to (M',r')
                  are map morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo :
                        %mi M
                        %mo →
                        %mi M
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} h : M \to M'
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CM
                      %annotation{:encoding => "application/x-tex"} CM
                  which preserve the root
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo{:stretchy => "false"} (
                          %mi r
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi r
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} h(r) = r'
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CM
                    %mo •
                %annotation{:encoding => "application/x-tex"} CM_\bullet
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} ↓
                  %mi U
                %annotation{:encoding => "application/x-tex"} 1 \downarrow U
            of the singleton set 1 with the forgetful functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi CM
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U : CM \to Set
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ,
                    %mi α
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M = (D,(\sigma,\alpha,\phi))
              a combinatorial map, the automorphism group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(M)
              is by definition the subgroup of permutations on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              which commute with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              %a.existingWikiWord{:href => "/nlab/show/centralizer"} centralizer
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi σ
                      %mo ,
                      %mi α
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \langle\sigma,\alpha,\phi\rangle
          .num_prop
            %h6#proposition_7 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,r)
              a rooted combinatorial map, the automorphism group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut(M,r)
              is always trivial. In particular, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h : (M,r) \to (M,r)
              is an endomorphism of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,r)
              in the category of rooted maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CM
                        %mo •
                    %annotation{:encoding => "application/x-tex"} CM_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              must be the identity morphism.
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
              be any dart of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_2^+
              is transitive, there is some word
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %msubsup
                      %mi 𝒞
                      %mn 2
                      %mo +
                  %annotation{:encoding => "application/x-tex"} w \in \mathcal{C}_2^+
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mi r
                      %mo *
                      %mi w
                    %annotation{:encoding => "application/x-tex"} d = r * w
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo *
                      %mi w
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi h
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                      %mo *
                      %mi w
                      %mo =
                      %mi r
                      %mo *
                      %mi w
                      %mo =
                      %mi d
                    %annotation{:encoding => "application/x-tex"} h(d) = h(r * w) = h(r) * w = r * w = d
