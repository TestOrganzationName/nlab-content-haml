                  \\stackrel{\overset{X^*}{\leftarrow}}{\underset{X_*}{\to}}
                  \\mathbf{H}
                  \\,.
          %p So we have
          .num_lemma
            %h6#observation Observation
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/little+topos"} little topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \coloneqq \mathbf{H}/X
              of every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the big topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is canonically equipped with a
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo :
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi j
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi X
                          %mo *
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}_X : \mathcal{G} \stackrel{j}{\to} \mathbf{H}
                    \\stackrel{X^*}{\to}
                    \\mathbf{H}/X
                    \\,.
          %p
            We want to show that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} V \in \mathcal{G}
            the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_X(V)
            may indeed be thought of as the “sheaf of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Notice that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
            we have that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 2
                    %mo :
                    %mi V
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^*(F) = (p_2 : V \times X \to X)
          %p
            Now assume first that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is itself representable. Then by the discussion at
            %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{H}/X
            is a lucalization of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ≃
                    %msub
                      %mi PSh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh_\infty(\mathcal{G})/X \simeq PSh_\infty(\mathcal{G}/X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo{:stretchy => "false"} /
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{G}/X
            is the
            %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/over-topos"} over-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ×
                  %mi X
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V \times X \to X)
            identifies with the presheaf given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi 𝒢
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (U \to X) \mapsto \mathcal{G}(U,V)
                  \\,.
          %p
            This is the “sheaf of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p (…)
          %h3#specific_examples Specific examples
          %h4#StrSheafOfcontFuncts Structure sheaves of continuous functions
          %p
            Consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X)
            the ordinary
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            on its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo =
                  %mi Top
                %annotation{:encoding => "application/x-tex"} \mathcal{G} = Top
            be some
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            version of
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            with its usual
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            with admissible
            %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            families being
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %mi Top
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_X : Top \to Sh(X)
          %p
            that sends a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to the sheaf of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi U
                  %mo ↦
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi Top
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  O_X(V) : U \mapsto C(U,V) = Hom_{Top}(U,V)
                  \\,.
          %p
            By general properties of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mi V
                    %mn 2
                  %mo ⊂
                  %mi V
                %annotation{:encoding => "application/x-tex"} V_1, V_2 \subset V
            an open cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            by two patches, the morphism of sheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_X(V_1) \coprod O_X(V_2) \to O_X(V)
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
            of sheaves. This means that for each point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            the map of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                  %mo →
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                %annotation{:encoding => "application/x-tex"}
                  O_X(V_1)_x \coprod O_X(V_2)_x \to O_X(V)_x
          %p
            is an epimorphism of sets. But this just says that given any function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi U
                    %mi x
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} f : U_x \to V
            on a neighbourhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi x
                %annotation{:encoding => "application/x-tex"} U_x
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi x
                  %mo ⊂
                  %msub
                    %mi U
                    %mi x
                %annotation{:encoding => "application/x-tex"} W_x \subset U_x
            such that the restriction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %msub
                        %mi W
                        %mi x
                %annotation{:encoding => "application/x-tex"} f|_{W_x}
            factors either through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                %annotation{:encoding => "application/x-tex"} V_1
            or through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mi V
                    %mn 2
                %annotation{:encoding => "application/x-tex"} V_1,V_2
            form an open cover. (A neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} f(x) \in V
            exists which is contained in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                %annotation{:encoding => "application/x-tex"} V_1
            or in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
          %h4#locally_ringed_spaces Locally ringed spaces
          %p
            %a{:href => "http://arxiv.org/PS_cache/arxiv/pdf/0905/0905.0459v1.pdf#page=71"} StrSh, remark 2.5.11
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a topological space as before, but consider now the geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo =
                  %msup
                    %mi CRing
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{G} = CRing^{op}
            to be the opposite category of commutative
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                  %mo ∈
                  %msup
                    %mi CRing
                    %mi op
                %annotation{:encoding => "application/x-tex"} Spec R \in CRing^{op}
            is a family of maps of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mfrac
                    %mn 1
                    %mrow
                      %msub
                        %mi r
                        %mi i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R \to R[\frac{1}{r_i}]
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi r
                    %mi i
                  %mo ∈
                  %mi R
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi i
                %annotation{:encoding => "application/x-tex"} \{r_i \in R\}_i
            generating the unit ideal in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mfrac
                    %mn 1
                    %mrow
                      %msub
                        %mi r
                        %mi i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Spec R[\frac{1}{r_i}]
            as an the open subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"} Spec R
            on wich the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            does not vanish, and a covering family we think of as an open cover by such open subsets, in direct analogy to the above example.
          %p Now given a sheaf of rings
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ¯
                    %mi X
                  %mo ∈
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi CRing
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\bar O_X \in Sh(X,CRing)
          %p
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %msup
                    %mi CRing
                    %mi op
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_X : CRing^{op} \to Sh(X)
          %p
            that it
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represents
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi U
                  %mo ↦
                  %msub
                    %mi Hom
                    %mrow
                      %msup
                        %mi CRing
                        %mi op
                  %mo{:stretchy => "false"} (
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ¯
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Spec
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi CRing
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ¯
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_X(Spec R) : U \mapsto
                  Hom_{CRing^{op}}(\bar O_X(U), Spec R)
                  \= Hom_{CRing}(R, \bar O_X(U))
          %p we check what conditions this has to satisfy to qualify as a structure sheaf in the above sense.
          %p The condition that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi Spec
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mfrac
                    %mn 1
                    %mrow
                      %msub
                        %mi r
                        %mi i
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"}
                  \\coprod_i O_X(Spec R[\frac{1}{r_i}])
                  \\to Spec R
          %p
            is an epimorphism of sheaves again means that it is
            = succeed "wise" do
              %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mfrac
                    %mn 1
                    %mrow
                      %msub
                        %mi r
                        %mi i
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ¯
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R[\frac{1}{r_i}] \to \bar O_X(U)
            is given by a ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi R
                  %mo →
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : R \to O_X(U)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(r_i)
            is invertible in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O_X(U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"} Spec R
            to functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            by a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mi Spec
                  %mi R
                %annotation{:encoding => "application/x-tex"} U \to Spec R
            that lands only in the open subset where the functoin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            is non-vanishing).
          %p
            So the condition that the above is an epimorphism on small enough
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            says that for every ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi R
                  %mo →
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ¯
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi : R \to \bar O_X(U)
            the value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            on at least one of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            is invertible element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O_X(U)
          %p Thinking of this dually this is just the same kind of statement as in the first example, really. But now we can say this more algebraically:
          %p
            by assumption there is a linear combination of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"} r_i
            to the identity in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi α
                    %mi i
                  %msub
                    %mi r
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  1 = \sum_i \alpha_i r_i
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            (the partition of unity of functions on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Spec R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi α
                    %mi i
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \sum_i \alpha_i \phi(r_1) = 1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                %annotation{:encoding => "application/x-tex"} (O_X)_x
            That for this invertible finite sum at least one of the summands is invertible is the condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi x
                %annotation{:encoding => "application/x-tex"} (O_X)_x
            is a
            %em local ring
            \.
          %p
            So a
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            has a structure sheaf in the above sense if it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+ringed+space"} locally ringed space
          %h4#ordinary_ringed_spaces Ordinary ringed spaces
          %p It may be worthwhile to retell the motivating example in the “Idea” introduction above for the maybe more familiar case of ordinary (1-categorical) structure sheaves with values in (unital) rings.
          %p
            An ordinary
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with its
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/ringed+site"} ringed site
            if it is equipped with a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Rings
                %annotation{:encoding => "application/x-tex"} O_X : Op(X)^{op} \to Rings
            with values in the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \subset X
            one thinks of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O_X(U)
            as the ring of allowed functions on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            If for the moment we ignore the technicality that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                %annotation{:encoding => "application/x-tex"} O_X
            is supposed to be a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            and just regard it as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
            and think of a ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            as a generalized quantity in form of a copresheaf, canonically the
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} co-representable
            co-presheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                %annotation{:encoding => "application/x-tex"}
                  R : (Ring^fin)^{op} \to \Set
          %p on finitely generated rings, which sends
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi R
                  %mo ′
                  %mo ↦
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi R
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  R : R' \mapsto Hom(R,R')
          %p
            then we find that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                %annotation{:encoding => "application/x-tex"} O_X
            is in fact a presheaf on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            with values in a co-presheaf on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} (Ring^{fin})^{op}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  O_X : Op(X)^{op} \to [(Ring^{fin})^{op}, Set]
          %p
            or equivalently a generalized quantity on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} (Ring^{fin})^{op}
            with values in presheaves on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ring
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  O_X : (Ring^{fin})^{op} \to [Op(X)^{op}, Set]
                  \\,.
          %p
            Since rings can be identified with left-exact functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ring
                      %mi fin
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} (Ring^{fin})^{op}\to Set
            %em local
            rings, as in the previous example above.
          %h4#derived_ringed_spaces Derived ringed spaces
          %p Now formulate the previous example according to the above definition:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CRing
                    %mi fin
                %annotation{:encoding => "application/x-tex"} CRing^{fin}
            be the category of finitely generated commutative rings There is a standard admissibility structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi CRing
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} (CRing^{fin})^{op}
            that makes it a
            %em geometry
            in the above sense.
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a topological space an
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi CRing
                    %mi fin
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (CRing^{fin})^{op} \to Sh(S)
            to
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi infty
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a sheaf of local commutative rings on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %a{:href => "http://arxiv.org/abs/0905.0459"} StrSh, example 1.2.13
          %p
            To generalize this to
            %strong derived structure sheaves
            we replace the category of rings here with the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            %strong Definition
            (
            %a{:href => "http://arxiv.org/abs/0905.0459"}> StrSh def 4.1.1
            )
          %p
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %strong simplicial commutative rings
            over an ordinary commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SCR
                    %mi k
                  %mo ≔
                  %msub
                    %mi PSh
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi FreeAlg
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  SCR_k \coloneqq PSh_\Sigma(FreeAlg_k)
          %p
            the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
            on commutative
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x_1, \cdots, x_n]
          %p Then…
          %h4#derived_smooth_manifolds Derived smooth manifolds
          %p
            (
            %a{:href => "http://arxiv.org/abs/0905.0459"}> StrSh, example 4.5.2
            )
          %p
            Every ordinary
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            becomes canonically a generalized space with structure sheaf as follows:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ≔
                  %mi Diff
                %annotation{:encoding => "application/x-tex"} V \coloneqq Diff
            be some version of the category of smooth manifolds. This becomes a
            %em pregeometry
            in the above sense by taking admissible morphisms to be inclusions of open submanifolds.
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X) \coloneqq Sh(Op(X))
            the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
