            %a.existingWikiWord{:href => "/nlab/show/big+topos"} big topos
            of
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            modeled on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a{:href => "#InTermsOfClassifying"} above discussion
            it is also the classifying topos of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/structure+sheaves"} structure sheaves
            on toposes:
          %p
            a
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi 𝒳
                  %mo :
                  %mi 𝒢
                  %mo →
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathcal{X}} : \mathcal{G} \to \mathcal{X}
            on an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            is equivalently an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mo *
                  %mo ⊣
                  %msub
                    %mi p
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi 𝒳
                  %mover
                    %mo →
                    %mo ←
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mo ←
                    %mi j
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"}
                  (p^* \dashv p_*)
                  \:
                  \\mathcal{X} \stackrel{\leftarrow}{\to} \mathbf{H}
                  \\stackrel{j}{\leftarrow}
                  \\mathcal{G}
          %p
            in that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi 𝒳
                    %mo =
                    %msup
                      %mi p
                      %mo *
                    %mi j
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathcal{X}} = p^* j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
          %p
            Notice that for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℋ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{H}
            its
            = succeed "-incarnation" do
              %a.existingWikiWord{:href => "/nlab/show/little+topos"} little topos
            %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
