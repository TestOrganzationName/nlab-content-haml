          .num_defn
            %h6#definition_3 Definition
            %p
              %strong (local morphism of structure sheaves)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
