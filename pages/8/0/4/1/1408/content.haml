            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(S)
            be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-sheaves
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Notice that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S = Op(X)
            is the nerve of the
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            of some
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X) \coloneqq Sh(S)
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We want to define a
            %em structure sheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (for instance on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Op(X)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to be an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                  %mo :
                  %mi V
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  O_X : V \to Sh(S)
          %p
            to be thought of as the assignment to each
            %em value space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi V
                %annotation{:encoding => "application/x-tex"} v \in V
            of an
            = succeed "-sheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            (on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            if
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S = Op(X)
          %p
            But since we are taking care of the sheaf condition on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is taken to be equipped with extra structure encoding covers in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi O
                    %mi X
                %annotation{:encoding => "application/x-tex"} O_X
            is then required to respect this structure suitably.
          %h3#geometries_and_admissibility_structure Geometries and admissibility structure
          .num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong admissiblility structure
              on an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is
            %ul
              %li
                %p
                  a choice of
                  %a.existingWikiWord{:href => "/nlab/show/sub-quasi-category"} sub (∞,1)-category
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi V
                            %mi ad
                          %mo ↪
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V^{ad} \hookrightarrow V
                  = succeed "," do
                    %strong admissible morphisms
                %ul
                  %li
                    %p
                      for every admissible morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} U \to X
                      and any morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ′
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X' \to X
                      there is a diagram
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi U
                                    %mo ′
                                  %mtd
                                    %mo →
                                  %mtd
                                    %mi U
                                %mtr
                                  %mtd
                                    %mo{:stretchy => "false"} ↓
                                  %mtd
                                  %mtd
                                    %mo{:stretchy => "false"} ↓
                                %mtr
                                  %mtd
                                    %mi X
                                    %mo ′
                                  %mtd
                                    %mo →
                                  %mtd
                                    %mi X
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            U' &amp;\to&amp; U
                            \\\
                            \\downarrow &amp;&amp; \downarrow
                            \\\
                            X' &amp;\to&amp; X
                            }
                    %p
                      with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo ′
                            %mo →
                            %mi X
                            %mo ′
                          %annotation{:encoding => "application/x-tex"} U' \to X'
                      admissible;
                  %li
                    %p for every diagram of the form
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                  %mtd
                                  %mtd
                                    %mi Y
                                %mtr
                                  %mtd
                                  %mtd
                                    %mo ↗
                                  %mtd
                                  %mtd
                                    %mo ↘
                                %mtr
                                  %mtd
                                    %mi X
                                  %mtd
                                  %mtd
                                    %mo →
                                  %mtd
                                  %mtd
                                    %mi Z
                          %annotation{:encoding => "application/x-tex"}
                            \\array{
                            \&amp;&amp; Y
                            \\\
                            \&amp; \nearrow &amp;&amp; \searrow
                            \\\
                            X &amp;&amp;\to&amp;&amp; Z
                            }
                    %p
                      with
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo →
                            %mi Z
                          %annotation{:encoding => "application/x-tex"} X \to Z
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                            %mo →
                            %mi Z
                          %annotation{:encoding => "application/x-tex"} Y \to Z
                      admissible, also
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo →
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} X \to Y
                      is admissible.
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  which has the property that it is generated from a
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                  consisting of admissible morphisms.
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"} StrSh, def 1.2.1
            in view of remark 1.2.4 below that.
          .num_defn
            %h6#definition_strsh_def_125
              Definition (
              %a{:href => "http://arxiv.org/abs/0905.0459"}> StrSh, def 1.2.5
              )
            %p
              An
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              equipped with an admissiblility structure is a
              %strong geometry
              if it is essentially small, admits finite limits and is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+complete+%28infinity%2C1%29-category"} idempotent complete
          %p
            The admissible morphisms in an admissibility structure are roughly to be thought of as those morphisms that behave as
            %em open immersions
            ,
          %h3#structure_sheaves_local_algebras
            Structure sheaves: local
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_strsh_def_128
              Definition (
              %a{:href => "http://arxiv.org/abs/0905.0459"}> StrSh, def 1.2.8
              )
            %p
              %strong (structure sheaf)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              be a geometry and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              an
              = succeed "-topos" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi 𝒳
                    %mo :
                    %mi 𝒢
                    %mo →
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"}
                    O_{\mathcal{X}} : \mathcal{G} \to \mathcal{X}
            %p
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %strong structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              or
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              if
            %ul
              %li
                %p
                  it is a left
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} exact (∞,1)-functor
              %li
                %p
                  it respects gluing in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  in that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi V
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \{U_i \to V\}_i
                  a covering
                  %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
                  consisting of admissible morphism, the induced morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi i
                        %msub
                          %mi O
                          %mi X
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi O
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\coprod_i O_X(U_i) \to O_X(V)
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒳
                        %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Str
                    %mi 𝒢
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi 𝒢
                  %mo ,
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Str_{\mathcal{G}}(\mathcal{X}) \subset Func(\mathcal{G},\mathcal{X})
            for the full subcategory of such morphisms of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
          .num_remark
            %h6#remark Remark
            %p
              Without the condition on preservations of covers, the above defined the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-algebraic+theory"} ∞-algebras
              over the
              %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+%28%E2%88%9E%2C1%29-theory"} essentially algebraic (∞,1)-theory
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %strong local
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p Therefore we shall equivalently write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %msub
                      %mi Alg
                      %mi loc
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Str
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}Alg_{loc}(\mathcal{X}) \simeq Str_{\mathcal{G}}(\mathcal{X})
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %msub
                      %mi Alg
                      %mi loc
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}Alg_{loc}(\mathcal{X})
              is the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
