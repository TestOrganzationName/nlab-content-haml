          %h2#idea Idea
          %p
            The notion of
            %em adjunction of two variables
            is a natural generalization of both that of:
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
                in a
                %a.existingWikiWord{:href => "/nlab/show/biclosed+monoidal+category"} biclosed monoidal category
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                having
                %a.existingWikiWord{:href => "/nlab/show/powers"} powers
                and
                %a.existingWikiWord{:href => "/nlab/show/copowers"} copowers
                (see
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/powered+and+copowered+category"} powered and copowered category
          %h2#definition Definition
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %strong adjunction of two variables
            or
            %strong two-variable adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ⊗
                  %mo ,
                  %msub
                    %mi hom
                    %mi l
                  %mo ,
                  %msub
                    %mi hom
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi C
                  %mo ×
                  %mi D
                  %mo ⟶
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  (\otimes, hom_l, hom_r)
                  \\,\colon\,
                  C \times D \longrightarrow E
          %p
            consists of
            %a.existingWikiWord{:href => "/nlab/show/bifunctors"} bifunctors
            of this form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo ⊗
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                          %mi C
                          %mo ×
                          %mi D
                          %mo ⟶
                          %mi E
                      %mtr
                        %mtd
                          %msub
                            %mi hom
                            %mi l
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                          %msup
                            %mi C
                            %mi op
                          %mo ×
                          %mi E
                          %mo ⟶
                          %mi D
                      %mtr
                        %mtd
                          %msub
                            %mi hom
                            %mi r
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                          %msup
                            %mi D
                            %mi op
                          %mo ×
                          %mi E
                          %mo ⟶
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\otimes &amp; \colon C \times D \longrightarrow E
                  \\\
                  hom_l &amp; \colon C^{op} \times E \longrightarrow D
                  \\\
                  hom_r &amp; \colon D^{op} \times E \longrightarrow C
                  \\end{aligned}
          %p
            together with
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            of this form:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mo ∈
                  %mi D
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi e
                  %mo ∈
                  %mi E
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi E
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi c
                  %mo ⊗
                  %mi d
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi e
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi D
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi d
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi hom
                    %mi l
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi c
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi hom
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  c \in C,\, d \in D,\, e \in E
                  \\;\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;\;
                  E\big(c \otimes d,\, e\big)
                  \\;\simeq\;
                  D\big(d,\, hom_l(c,e)\big)
                  \\;\simeq\;
                  C\big(c,\, hom_r(d,e)\big)
                  \\,.
          %h2#cyclicity Cyclicity
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ⊗
                  %mo ,
                  %msub
                    %mi hom
                    %mi l
                  %mo ,
                  %msub
                    %mi hom
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo ×
                  %mi D
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} (\otimes, hom_l, hom_r) : C \times D \to E
            is a two-variable adjunction, then so are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi hom
                    %mi l
                    %mi op
                  %mo ,
                  %msup
                    %mo ⊗
                    %mi op
                  %mo ,
                  %msub
                    %mi hom
                    %mi r
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi E
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  (hom_l^{op}, \otimes^{op}, hom_r) : E^{op} \times C \to D^{op}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi hom
                    %mi r
                    %mi op
                  %mo ,
                  %msub
                    %mi hom
                    %mi l
                  %mo ,
                  %msup
                    %mo ⊗
                    %mi op
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi D
                  %mo ×
                  %msup
                    %mi E
                    %mi op
                  %mo →
                  %msup
                    %mi C
                    %mi op
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (hom_r^{op}, hom_l, \otimes^{op}) : D\times E^{op} \to C^{op}.
          %p
            giving an action of the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of order 3. This can be made to look more symmetrical by regarding the original two-variable adjunction as a “two-variable left adjunction”
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                    %mo →
                    %msup
                      %mi E
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C\times D \to E^{op}
            = succeed "." do
              %a{:href => "#CGR"} Cheng-Gurski-Riehl
          %h2#adjunctions_of__variables
            Adjunctions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            variables
          %p
            There is a straightforward generalization to an adjunction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            variables, which involves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            categories and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            functors. Adjunctions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            variables assemble into a 2-
            %a.existingWikiWord{:href => "/nlab/show/multicategory"}> multicategory
            \. They also have a corresponding notion of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/mates"} mates
            = succeed "." do
              %a{:href => "#CGR"} Cheng-Gurski-Riehl
          %p
            This 2-multicategory can also be promoted to a 2-
            %a.existingWikiWord{:href => "/nlab/show/polycategory"}> polycategory
            ; see
            = succeed "." do
              %a{:href => "#Shulman"} Shulman
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/parameterized+monad"} parameterized monad
          %h2#references References
          %p
            Under the name “
            %em> adjunction with a parameter
            ” the concept appears in p. 102 of:
          %ul
            %li#MacLane71
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , §IV.7, Thm. 3 (p. 100) of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+Work"} Categories for the working mathematician
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"} doi:10.1007/978-1-4757-4721-8
          %p
            Under the name “
            %em> THC-situation
            ” the concept is discussed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Gray"}> John Gray
              , Def. 1.1 in:
              = succeed "." do
                %em Closed categories, lax limits and homotopy limits
              %strong 19
              (1980) 127 - 158 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(80)90098-5"}> doi:10.1016/0022-4049(80)90098-5
              \&amp;rbrack;
          %p
            The terminology
            %em adjunction of two variables
            is used in:
          %ul
            %li#Hovey99
              %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
              , Def. 4.1.12 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+Categories"} Model Categories
              %strong 63
              AMS (1999) &amp;lbrack;
              %a{:href => "https://bookstore.ams.org/surv-63-s"}> ISBN:978-0-8218-4361-1
              ,
              = succeed "," do
                %a{:href => "https://doi.org/http://dx.doi.org/10.1090/surv/063"} doi:10.1090/surv/063
              = succeed "," do
                %a{:href => "https://www.sas.rochester.edu/mth/sites/doug-ravenel/otherpapers/hovey-model-cats.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
          %p and:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
              , Def. 4.3.7 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Category+Theory+in+Context"} Category Theory in Context
          %p
            The terminology
            %em trijunction
            is used in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Guitart"}> René Guitart
              ,
              = succeed "." do
                %em Trijunctions and triadic Galois connections
              = succeed ")" do
                %a{:href => "https://cahierstgdc.com/wp-content/uploads/2017/04/Guitart_54-1.pdf"} pdf
          %p
            Generalization to
            = succeed "-variable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li#CGR
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eugenia+Cheng"}> Eugenia Cheng
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nick+Gurski"} Nick Gurski
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/1208.4520"} arXiv:1208.4520
            %li#Shulman
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                ,
                = succeed "," do
                  %em The 2-Chu-Dialectica construction and the polycategory of multivariable adjunctions
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1806.06082"} arxiv:1806.06082
                %a{:href => "https://golem.ph.utexas.edu/category/2017/11/the_polycategory_of_multivaria.html"} blog post
