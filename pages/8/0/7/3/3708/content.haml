                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ω
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \Omega_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mi Ω
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, \Omega_A) \to (B, M)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} Mod
          %h3#ModulesOverSmoothAlgebras Modules over smooth algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothAlg
                %annotation{:encoding => "application/x-tex"} SmoothAlg
            (or
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} C^\infty Ring
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi SmoothAlg
                  %mo →
                  %mi Ring
                %annotation{:encoding => "application/x-tex"}
                  U : SmoothAlg \to Ring
          %p
            to the underlying ordinary
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
          .num_theorem
            %h6#TangentOfSmoothAlgTheorem Theorem
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                    %mover
                      %mo →
                      %mo ≃
                    %mi SmoothAlg
                    %msub
                      %mo ×
                      %mi Ring
                    %msub
                      %mi T
                      %mi Ring
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T_{SmoothAlg} \stackrel{\simeq}{\to}
                    SmoothAlg \times_{Ring} T_{Ring}
                    \\,,
            %p
              where on the right we have the strict
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (i.e. taken in the 1-category
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p We give the proof below. First some remarks and corollaries.
          .num_remark
            %h6#remark Remark
            %p
              We may regard an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"} T_{SmoothAlg}
              as a module over a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"} T_{SmoothAlg}
              does reflect that modules over smooth algebras have a different nature than just bare modules, notably in that the left adjoint to the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                    %mo →
                    %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"} T_{SmoothAlg} \to SmoothAlg
              produces the correct
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential"} Kähler differential
          .num_cor
            %h6#corollary Corollary
            %p
              For any category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi SmoothAlg
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi S
                    %mo ≃
                    %msup
                      %mi SmoothAlg
                      %mi S
                    %msub
                      %mo ×
                      %mrow
                        %msup
                          %mi Ring
                          %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi T
                      %mi Ring
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (T_{SmoothAlg})^S \simeq
                    SmoothAlg^S \times_{Ring^S} (T_{Ring})^S
                    \\,.
            %p
              So in particular for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} S = \Delta
              the
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              we have that
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
              modules over simplicial smooth algebras are as objects just ordinary simplicial modules over the underlying
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+ring"} simplicial ring
          %p
            For proving the
            %a{:href => "#TangentOfSmoothAlgTheorem"} above theorem
            the main step is the following lemma.
          .num_lemma
            %h6#lemma Lemma
            %p
              For a fixed smooth algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi SmoothAlg
                    %mo{:stretchy => "false"} /
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi Ring
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U : Ab(SmoothAlg/R) \to Ab(Ring/U(R))
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
          .proof
            %h6#proof_3 Proof
            %p
              The statement was suggested at some point by
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
              in discussion with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %a.existingWikiWord{:href => "/nlab/show/Herman+Stel"} Herman Stel
              to prove it. A writeup is in (
              %a{:href => "#Stel"}> Stel
              ).
            %p
              We discuss in detail that the functor is injective on objects, in that for an any abelian group object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothAlg
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} SmoothAlg/R
              its smooth algebra structure on the underlying ring structure is the
              %em unique
              such smooth algebra that makes it an abelian group object over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is in fact an isomorphism of categories.
            %p
              The crucial property underlying this statement is that the
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                  %annotation{:encoding => "application/x-tex"} T =
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              over wich smooth algebras are
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %a.existingWikiWord{:href => "/nlab/show/Fermat+theory"} Fermat theory
              in that
              %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
              holds for
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %p
              This implies that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              and every smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi ℝ
                      %mi k
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^k \to \mathbb{R}
              there are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{h_{i,j} \in C^\infty(\mathbb{R}^k \times \mathbb{R}^k, \mathbb{R})\}_{i,j = 1}^n
              such that the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo :
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi k
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    f \circ + : \mathbb{R}^k \times \mathbb{R}^k \to \mathbb{R}
            %p
              has an expansion given for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi w
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p, w \in \mathbb{R}^k
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi l
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi w
                      %mi l
                    %mo ⋅
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi l
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi w
                      %mi i
                    %mo ⋅
                    %msub
                      %mi w
                      %mi j
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f(p+w) = f(p) + \sum_{l = 1}^k w_l \cdot \frac{\partial f}{\partial x_l}(p)
                    +
                    \\sum_{i,j}
                    w_i \cdot w_j h_{i,j}(p,w)
                    \\,.
            %p
              We now use that any
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              regarded as a product-preserving functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi CartSp
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} A : CartSp \to Set
              reflects these relations in that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ,
                    %mi e
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} r, e \in A(k) = U(A)^k
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo +
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi l
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi w
                      %mi l
                    %mo ⋅
                    %mi A
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi l
                      %mo )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi e
                      %mi i
                    %mo ⋅
                    %msub
                      %mi e
                      %mi j
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(f)(r+e)
                    \=
                    A(f)(r) +
                    \\sum_{l = 1}^k w_l \cdot A\left(\frac{\partial f}{\partial x_l}\right)(r)
                    +
                    \\sum_{i,j}
                    e_i \cdot e_j A(h_{i,j})(r,e)
                    \\,.
            %p
              Now if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"} R \in SmoothAlg
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi SmoothAlgebra
                    %mo{:stretchy => "false"} /
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab(SmoothAlgebra/R)
              then in particular its underlying ring will be an object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ab
                      %mo{:stretchy => "false"} (
                      %mi Ring
                      %mo{:stretchy => "false"} /
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ab(Ring/U(R))
              %a{:href => "#OrdinaryModules"} above theorem
              this means that the underlying ring is a
              %a.existingWikiWord{:href => "/nlab/show/square-zero+extension"} square-zero extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi N
                  %annotation{:encoding => "application/x-tex"} U(R) \oplus N
              by some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} N \in U(R) Mod
            %p
              So it follows every element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(1)
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (r, \epsilon)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \epsilon \in N
              and we can always write it as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (r,0) + (0, \epsilon)
                    \\,.
            %p
              Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is by assumption a group object over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^k , \mathbb{R})
              and for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \in R(1)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A(f)(r) = R(f)(r)
                    \\,.
            %p
              So we only need to know how
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              acts on mixed terms. The point now is that the above Hadamard-quotient formula reduces the action of any smooth function to just operations of this form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(f)(r)
              and to ordinary multiplication and addition, so it actually fixes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(f)
              from the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(f)
              to elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (r,0)
              and the module structure on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi l
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi w
                      %mi l
                    %mo ⋅
                    %mi A
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi f
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi l
                      %mo )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    A(f)(r +\epsilon)
                    \=
                    A(f)(r) +
                    \\sum_{l = 1}^k w_l \cdot A\left(\frac{\partial f}{\partial x_l}\right)(r)
                    +
                    0
            %p
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi i
                    %mo ⋅
                    %msub
                      %mi ϵ
                      %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon_i \cdot \epsilon_j = 0
              in the underlying
              %a.existingWikiWord{:href => "/nlab/show/square-0+extension"} square-0 extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and hence also in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              In summary this shows that the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is injective on objects. The above formula also directly implies, conversely, that the functor is surjective on objects, hence an isomorphism on objects, and moreover that it is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
          %p
            Finally we come to the proof of the
            %a{:href => "#TangentOfSmoothAlgTheorem"} full theorem above
          .proof
            %h6#proof_4 Proof
            %p
              The above lemma shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                    %mo ≃
                    %mi SmoothAlg
                    %msub
                      %mo ×
                      %mi Ring
                    %msub
                      %mi T
                      %mi Ring
                  %annotation{:encoding => "application/x-tex"} T_{SmoothAlg} \simeq SmoothAlg \times_{Ring} T_{Ring}
              is a bijection on objects.
            %p
              Since the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                  %annotation{:encoding => "application/x-tex"} T_{SmoothAlg}
              are preserved by the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi SmoothAlg
                    %mo →
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} U : SmoothAlg \to Ring
              (a special case of the general facts about
              = succeed ")," do
                %a{:href => "http://ncatlab.org/nlab/show/Lawvere+theory#AdjCatAlgs"} Relative free T-algebra adjunctions
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi SmoothAlg
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %msub
                      %mi R
                      %mn 1
                    %mo ,
                    %mi B
                    %mo →
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi SmoothAlg
                    %msub
                      %mo ×
                      %mi Ring
                    %msub
                      %mi T
                      %mi Ring
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    T_{SmoothAlg}(A\to R_1,B \to R_2) \to SmoothAlg \times_{Ring} T_{Ring} ((U(A), R_1), (U(B), R_2))
            %p
              amounts to checking for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi R
                      %mn 1
                    %mo →
                    %msub
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : R_1 \to R_2
              bijections of hom-sets of abelian group objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi SmoothAlg
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi Ring
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi f
                      %mo *
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ab(SmoothAlg/R_1)(A, f^* B)
                    \\to
                    Ab(Ring/U(R_1))(U(A), f^* U(B))
                    \\,.
            %p That this is a bijection is the statement of the above lemma.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/tangent+%28%E2%88%9E%2C1%29-category"}> tangent (∞,1)-category
              \.
          %h2#references References
          %p
            The original observation that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi Ring
                  %mo ≃
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} T_{Ring} \simeq Mod
            is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , …
          %p
            A discusson of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi SmoothAlg
                %annotation{:encoding => "application/x-tex"} T_{SmoothAlg}
            is in
          %ul#Stel
            %li
              %a.existingWikiWord{:href => "/nlab/show/Herman+Stel"}> Herman Stel
              ,
              %em
                %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Stel"} ∞-Stacks and their Function Algebras
