          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            %em Mackey theory
            refers to a set of tools for constructing and classifying
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            from that of a
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} N \subset G
            %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induction
            from the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+groups"} stabilizer groups
            of the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on the set of
            %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
          %p
            (Also referred to as
            = succeed "-methods," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/little+group"} little group
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wigner+classification"} Wigner classification
          %h2#details Details
          %h3#for_finite_semidirect_products_with_abelian_groups For finite semidirect products with abelian groups
          %p Consider
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                an
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo ≡
                      %mspace{:width => "thinmathspace"}
                      %mi H
                      %mo ⋊
                      %mi A
                    %annotation{:encoding => "application/x-tex"} G \,\equiv\, H \rtimes A
                a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product group
          %p and denote:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo ˜
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msup
                        %mi ℂ
                        %mo ×
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \widetilde A \,\coloneqq\, Hom(A, \mathbb{C}^\times)
                the dual group of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/group+characters"} group characters
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and the induced action on
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi A
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %mover
                              %mi A
                              %mo ˜
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi A
                              %mo ˜
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi g
                            %mo ,
                            %mi A
                            %mover
                              %mo →
                              %mi χ
                            %msup
                              %mi ℂ
                              %mo ×
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi χ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mtext -
                            %mo{:stretchy => "false"} )
                            %mi g
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{ccc}
                      G \times \widetilde A &amp;\longrightarrow&amp; \widetilde A
                      \\\
                      \\big(g, A \xrightarrow{\chi} \mathbb{C}^\times \big)
                      \&amp;\mapsto&amp;
                      \\chi\big(g^{-1} (\text{-}) g\big)
                      \\end{array}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi χ
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo ∈
                          %mover
                            %mi A
                            %mo ˜
                          %mo{:stretchy => "false"} /
                          %mi H
                    %annotation{:encoding => "application/x-tex"} (\chi_i)_{i \in \widetilde{A}/H}
                a set of representatives of the resulting
                %a.existingWikiWord{:href => "/nlab/show/orbits"} orbits
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi A
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi Stab
                        %mi H
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi χ
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_i \,\coloneqq\, Stab_H(\chi_i)
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroups"} stabilizer subgroups
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi H
                        %mi i
                      %mo ⋊
                      %mi A
                    %annotation{:encoding => "application/x-tex"} G_i \,\coloneqq\, H_i \rtimes A
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p Finally, denote
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi χ
                      %mo ^
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi G
                    %mi i
                  %mo ↠
                  %mi A
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi χ
                        %mi i
                  %msup
                    %mi ℂ
                    %mo ×
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\widehat{\chi}_i
                  \\,\colon\,
                  G_i
                  \\twoheadrightarrow
                  A
                  \\xrightarrow{\chi_i}
                  \\mathbb{C}^{\times}
                  \\,,
          %p
            which is a
            %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi i
                  %annotation{:encoding => "application/x-tex"} G_i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} H_i
          %p
            Similarly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo ∈
                  %mi Irr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \rho \in Irr(H_i)
            an irrep of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi i
                  %annotation{:encoding => "application/x-tex"} H_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ρ
                    %mo ^
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi G
                    %mi i
                  %mo ↠
                  %msub
                    %mi H
                    %mi i
                  %mover
                    %mo →
                    %mi ρ
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\widehat{\rho}
                  \\,\colon\,
                  G_i
                  \\twoheadrightarrow
                  H_i
                  \\xrightarrow{\rho}
                  GL(V)
          %p
            and consider the
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor products
          #eq:MackeyIrrepForFiniteSemProdWithAbelian.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi θ
                    %mrow
                      %mi i
                      %mo ,
                      %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ind
                    %mrow
                      %msub
                        %mi G
                        %mi i
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mover
                      %mi χ
                      %mo ^
                    %mi i
                  %mo ⊗
                  %mover
                    %mi ρ
                    %mo ^
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Rep
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\theta_{i,\rho}
                  \\;\coloneqq\;
                  Ind_{G_i}^G \big(
                  \\widehat{\chi}_i \otimes \widehat{\rho}
                  \\big)
                  \\;\in\;
                  Rep_{\mathbb{C}}(G)
                  \\,.
          %p
          #ForFiniteSemidirectProductsWithAbelianGroups.num_prop
            %h6 Proposition
            %p
            %ol
              %li
                %p
                  The representations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi θ
                          %mrow
                            %mi i
                            %mo ,
                            %mi ρ
                      %annotation{:encoding => "application/x-tex"} \theta_{i,\rho}
                  %a.maruku-eqref{:href => "#eq:MackeyIrrepForFiniteSemProdWithAbelian"} (1)
                  are irreducible.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi θ
                          %mrow
                            %mi i
                            %mo ,
                            %mi ρ
                        %mo ≃
                        %msub
                          %mi θ
                          %mrow
                            %mi i
                            %mo ′
                            %mo ,
                            %mi ρ
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} \theta_{i,\rho} \simeq \theta_{i',\rho'}
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo =
                        %mi i
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} i = i'
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo ≃
                          %mi ρ
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} \rho \simeq \rho'
              %li
                %p
                  Every irrep of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is of the form
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi θ
                            %mrow
                              %mi i
                              %mo ,
                              %mi ρ
                        %annotation{:encoding => "application/x-tex"} \theta_{i, \rho}
            %p
          %p
            (
            %a{:href => "#Serre77"}> Serre 1977 Prop. 25 p 62
            )
          %h2#examples Examples
          %p
          #ExampleIrrepsOfZnRtimesZTwo.num_remark
            %h6 Example
            %p
              Consider the semidirect product group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≡
                      %msub
                        %mi ℤ
                        %mi n
                      %mo ⋊
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G \equiv \mathbb{Z}_n \rtimes \mathbb{Z}_2
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ≡
                        %msub
                          %mi ℤ
                          %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                      %annotation{:encoding => "application/x-tex"} A \equiv \mathbb{Z}_n \,\coloneqq\, \mathbb{Z}/n
                  the
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
                  of
                  %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ≡
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} H \equiv \mathbb{Z}_2
                  the
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
                  acting on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
                  via the sign
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %p
              In order find all the (complex)
              %a.existingWikiWord{:href => "/nlab/show/irreps"} irreps
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                    %mo ⋊
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n \rtimes \mathbb{Z}_2
              we unwind the statement of Prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#ForFiniteSemidirectProductsWithAbelianGroups"}
            %blockquote
              %p
                (We denote
                %a.existingWikiWord{:href => "/nlab/show/congruence+classes"} congruence classes
                by square brackets:
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %mi ℤ
                        %mo ↠
                        %msub
                          %mi ℤ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} [-] \colon \mathbb{Z} \twoheadrightarrow \mathbb{Z}_n
            %p
              First, the complex irreps of the
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
              are themselves labeled by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} [k] \in \mathbb{Z}_n
              and given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi ℤ
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msub
                                %mi χ
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi k
                                  %mo{:stretchy => "false"} ]
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %msup
                            %mi ℂ
                            %mo ×
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi r
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ↦
                        %mtd
                          %msup
                            %mi e
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi r
                                    %mi k
                                  %mi n
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    \\mathbb{Z}_n
                    \&amp;\xrightarrow{\;\; \chi_{[k]} \;\;}&amp;
                    \\mathbb{C}^\times
                    \\\
                    [r] &amp;\mapsto&amp; e^{2 \pi \mathrm{i} \tfrac{r k}{n}}
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              On these, the nontrivial element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sigma \in \mathbb{Z}_2
              acts by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \sigma \colon [k] \mapsto [-k]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %msub
                            %mi χ
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} [
                          %mi r
                          %mo{:stretchy => "false"} ]
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
