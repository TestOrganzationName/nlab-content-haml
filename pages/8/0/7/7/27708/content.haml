                                %mn 2
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} [
                          %mi r
                          %mo{:stretchy => "false"} ]
                          %mo ↦
                          %msup
                            %mi e
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi r
                                    %mi k
                                  %mi n
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ⊗
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} [
                          %mi r
                          %mo{:stretchy => "false"} ]
                          %mo ↦
                          %mn 1
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mi ℂ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                          %msub
                            %mi ℤ
                            %mi p
                          %mo ⋊
                          %msub
                            %mi ℤ
                            %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %msub
                            %mo ⊗
                            %mrow
                              %mi ℂ
                              %mo{:stretchy => "false"} [
                              %msub
                                %mi ℤ
                                %mi p
                              %mo{:stretchy => "false"} ]
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:stretchy => "false"} [
                          %mi r
                          %mo{:stretchy => "false"} ]
                          %mo ↦
                          %msup
                            %mi e
                            %mrow
                              %mn 2
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi r
                                    %mi k
                                  %mi n
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    Ind
                    ^{ \mathbb{Z}_p \rtimes \mathbb{Z}_2 }
                    _{ \mathbb{Z}_p }
                    \\Big(
                    \\big(
                    [r] \mapsto e^{2 \pi \mathrm{i} \tfrac{r k}{n}}
                    \\big)
                    \\otimes
                    \\big(
                    [r] \mapsto 1
                    \\big)
                    \\Big)
                    \\\
                    \\;\simeq\;
                    \\mathbb{C}\big[
                    \\mathbb{Z}_p \rtimes \mathbb{Z}_2
                    \\big]
                    \\otimes_{ \mathbb{C}[\mathbb{Z}_p] }
                    \\Big(
                    [r] \mapsto e^{2 \pi \mathrm{i} \tfrac{r k}{n}}
                    \\Big)
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              These latter irreps are 2-dimensional, with an evident matrix representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{(-)}
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mn 2
                                  %mi π
                                  %mi{:mathvariant => "normal"} i
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mi k
                                      %mi n
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi e
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 2
                                  %mi π
                                  %mi{:mathvariant => "normal"} i
                                  %mstyle{:displaystyle => "false"}
                                    %mfrac
                                      %mi k
                                      %mi n
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                      %mo ]
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{
                    \\big(
                    [1], [0]
                    \\big)
                    }
                    \\;=\;
                    \\left[
                    \\begin{matrix}
                    e^{+ 2 \pi \mathrm{i} \tfrac{k}{n}} &amp; 0
                    \\\
                    0 &amp; e^{- 2 \pi \mathrm{i} \tfrac{k}{n}}
                    \\end{matrix}
                    \\right]
                    \\,,\;\;\;\;\;\;
                    \\widehat{
                    \\big(
                    [0], [1]
                    \\big)
                    }
                    \\;=\;
                    \\left[
                    \\begin{matrix}
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    \\end{matrix}
                    \\right]
                    \\mathrlap{\,.}
            %p
              As a consistency check that we found all irreps, we verify that the
              %a{:href => "regular+representation#SumOfSquaresFormula"} sum of squares formula
              holds:
            %p
              We have found two 1-dimensional irreps when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is odd and four of them when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is even, together with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \lfloor (n-1)/2\rfloor
              irreps of dimension 2, whence the sum of their squares of dimensions is,
            %p
              for odd
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ⋅
                    %msup
                      %mn 1
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ⌋
                    %mo ⋅
                    %msup
                      %mn 2
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo +
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %mn 2
                    %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"}
                    2 \cdot 1^2
                    \\,+\,
                    \\lfloor (n-1)/2\rfloor \cdot 2^2
                    \\;=\;
                    2 + \frac{n-1}{2} 4
                    \\;=\;
                    2 + 2 (n-1)
                    \\;=\;
                    2 n
            %p
              and for even
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mo ⋅
                    %msup
                      %mn 1
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} ⌊
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ⌋
                    %mo ⋅
                    %msup
                      %mn 2
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo ⋅
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo +
                    %mspace{:width => "thinmathspace"}
                    %mfrac
                      %mrow
                        %mi n
                        %mo −
                        %mn 2
                      %mn 2
                    %mn 4
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo ⋅
                    %mn 2
                    %mo +
                    %mn 2
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    4 \cdot 1^2
                    \\,+\,
                    \\lfloor (n-1)/2\rfloor \cdot 2^2
                    \\;=\;
                    2 \cdot 2
                    \\,+\,
                    \\frac{n-2}{2} 4
                    \\;=\;
                    2 \cdot 2 + 2 \cdot (n-2)
                    \\;=\;
                    2 n
                    \\,,
            %p
              correctly coinciding with the
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              of our group :
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℤ
                        %mi n
                      %mo ⋊
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo{:stretchy => "false"} |
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℤ
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\vert \mathbb{Z}_n \rtimes \mathbb{Z}_2 \vert}
                    \\;=\;
                    {\vert \mathbb{Z}_2 \vert}
                    \\cdot
                    {\vert \mathbb{Z}_n \vert}
                    \\;=\;
                    2 n
                    \\,.
            %p
          %p
          .num_remark
            %h6 Example
            %p
              For construction of irreps of
              %a.existingWikiWord{:href => "/nlab/show/wreath+products+of+groups"} wreath products of groups
              see
              = succeed "." do
                %a{:href => "wreath+product+of+groups#IrreducibleRepresentations"} there
          %h2#references References
          %p The original article:
          %ul
            %li#Mackey68
              %a.existingWikiWord{:href => "/nlab/show/George+Mackey"}> George Mackey
              \:
              = succeed "," do
                %em Induced representations of groups and quantum mechanics
              = succeed "&rbrack;" do
                %a{:href => "https://archive.org/details/inducedrepresent0000mack"} ark:/13960/t6841m201
          %p General discussion:
          %ul
            %li
              J. M. G. Fell, R. S. Doran:
              = succeed "," do
                %em
                  Representations of
                  = succeed "-Algebras," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                  = succeed "-Algebraic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
              = succeed "," do
                %em
                  Banach
                  = succeed "-Algebraic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
              = succeed "&rbrack;" do
                %a{:href => "https://shop.elsevier.com/books/representations-of-algebras-locally-compact-groups-and-banach-algebraic-bundles/fell/978-0-12-252722-7"} ISBN:9780122527227
          %p
            Review for the case of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Curtis"}> Charles Curtis
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Irving+Reiner"} Irving Reiner
                = succeed "," do
                  %em Representation theory of finite groups and associative algebras
                = succeed "&rbrack;" do
                  %a{:href => "https://bookstore.ams.org/chel-356.h"} ISBN:978-0-8218-4066-5
            %li#Serre77
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
                , section 8.2 of:
                = succeed "," do
                  %em Linear Representations of Finite Groups
                = succeed "," do
                  %strong 42
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-1-4684-9458-7"} doi:10.1007/978-1-4684-9458-7
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.tau.ac.il/~borovoi/courses/ReprFG/Hatzagot.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Conrad"}> Brian Conrad
                \:
                %em Mackey theory and applications
                \&amp;lbrack;
                %a{:href => "https://math.stanford.edu/~conrad/210BPage/handouts/mackey.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Conrad-MackeyTheory.pdf", :title => "pdf"} pdf
            %li
              %p
                Amirtanshu Prasad, M. K. Vemuri:
                %em Mackey’s Little Group Method
                \&amp;lbrack;
                %a{:href => "https://www.imsc.res.in/~amri/little_groups.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/PrasadVemuri-MackeyMethod.pdf", :title => "pdf"} pdf
            %li
              %p
                S. Martin:
                = succeed "," do
                  %em Mackey Theory
                = succeed "," do
                  %em
                    %a{:href => "https://dec41.user.srcf.net/h/II_L/representation_theory/"} Representation Theory
                %a.existingWikiWord{:href => "/nlab/show/Dexter+Chua"} Dexter Chua
                (2016) &amp;lbrack;
                %a{:href => "https://dec41.user.srcf.net/h/II_L/representation_theory/12"}> pdf
                \&amp;rbrack;
          %p Further developments:
          %ul
            %li
              Geetha Venkataraman:
              = succeed "," do
                %em On irreducibility of induced modules and an adaptation of the Wigner–Mackey method of little groups
              %strong 50
              6 (2013) 1213-1222 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0908.0026"}> arXiv:0908.0026
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.4134/JKMS.2013.50.6.1213"} doi:10.4134/JKMS.2013.50.6.1213
          %p
            Review for the case of
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            (cf.
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Wigner+classification"} Wigner classification
