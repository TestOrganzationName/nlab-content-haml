                  %em Theory of Superconductivity
                = succeed ")" do
                  %a{:href => "https://tu-dresden.de/mn/physik/itp/cmt/ressourcen/dateien/skripte/Skript_Supra.pdf?lang=en"} pdf
          %h3#in_string_theory In string theory
          %p
            Discussion as a
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            in
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+manifolds"} Calabi-Yau manifolds
          %ul
            %li#VafaWarner89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+Warner"} Nicholas Warner
                = succeed "," do
                  %em Catastrophes and the Classification of Conformal Theories
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-2693%2889%2990473-5"} doi:10.1016/0370-2693(89)90473-5
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Greene"}> Brian Greene
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em Calabi–Yau Manifolds and Renormalization Group Flows
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(89)90471-9"} doi:10.1016/0550-3213(89)90471-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Howe"}> Paul Howe
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+West"} Peter West
                = succeed "," do
                  %em Landau-Ginzburg Hamiltonians, string theory and critical phenomena
                = succeed "," do
                  %em Proceedings of 25th International Conference on High Energy Physics
                = succeed "," do
                  %a{:href => "https://inspirehep.net/literature/301119"} inspire:301119
                = succeed "&rbrack;" do
                  %a{:href => "https://inspirehep.net/files/f9b5ac3ccd39ef8c30ca5c7b69b92fc8"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em
                    Phases of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} N=2
                    Theories In Two Dimensions
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9301042"} arXiv:hep-th/9301042
          %p Lecture notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Dynamical aspects of QFT
              = succeed "," do
                %em
                  The Landau–Ginzburg description of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} N=2
                  minimal models; Quantum cohomology and Kähler manifolds
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantum+Fields+and+Strings"} Quantum Fields and Strings
          %p
            In terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/derived+geometry"} derived geometry
          %ul
            %li
              Yalong Cao, Yukinobu Toda, Gufang Zhao:
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
