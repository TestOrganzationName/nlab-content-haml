              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/A.+N.+Schellekens"}> A. N. Schellekens
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Nicholas+P.+Warner"} Nicholas P. Warner
                  = succeed "," do
                    %em Anomalies, characters and strings
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1016/0550-3213(87)90108-8"} doi:10.1016/0550-3213(87)90108-8
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bengt+Nilsson"} Bengt Nilsson
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/A.+N.+Schellekens"} A. N. Schellekens
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Nicholas+P.+Warner"} Nicholas P. Warner
                  = succeed "," do
                    %em Anomaly cancelling terms from the elliptic genus
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1016/0550-3213(88)90468-3"} doi:10.1016/0550-3213(88)90468-3
            %p and then strictly originates with:
            %ul
              %li#Witten87
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                  ,
                  = succeed "," do
                    %em Elliptic genera and quantum field theory
                  = succeed ")" do
                    %a{:href => "http://projecteuclid.org/euclid.cmp/1104117076"} euclid:cmp/1104117076
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                  ,
                  = succeed "," do
                    %em
                      On the Landau-Ginzburg Description of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                            %mo =
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} N=2
                      Minimal Models
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/hep-th/9304026"} arXiv:hep-th/9304026
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Toshiya+Kawai"}> Toshiya Kawai
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Yasuhiko+Yamada"} Yasuhiko Yamada
                  = succeed "," do
                    %em
                      Elliptic Genera and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                            %mo =
                            %mn 2
                          %annotation{:encoding => "application/x-tex"} N=2
                      Superconformal Field Theory
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/hep-th/9306096"} arXiv:hep-th/9306096
                  = succeed ")" do
                    %a{:href => "https://doi.org/10.1016/0550-3213(94)90428-6"} doi:10.1016/0550-3213(94)90428-6
              %li
                %p
                  Sujay K. Ashok, Jan Troost,
                  = succeed "," do
                    %em A Twisted Non-compact Elliptic Genus
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/1101.1059"} arXiv:1101.1059
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Eric+Sharpe"} Eric Sharpe
                  = succeed "," do
