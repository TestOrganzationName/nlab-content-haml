              = succeed "," do
                %em D-Branes in Landau–Ginzburg models and algebraic geometry
              %a#KapustinLi{:href => "http://arxiv.org/abs/hep-th/0210296"} arXiv:hep-th/0210296
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
          %ul#CaldararuTu
            %li#Orlov
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"}> Dmitri Orlov
