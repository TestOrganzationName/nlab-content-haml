              (“H-string”) or
              %a.existingWikiWord{:href => "/nlab/show/type+II+superstring"} type II superstring
              %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
              theory has precursors in
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/A.+N.+Schellekens"}> A. N. Schellekens
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Nicholas+P.+Warner"} Nicholas P. Warner
                  = succeed "," do
