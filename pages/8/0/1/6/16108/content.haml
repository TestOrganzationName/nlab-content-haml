          %title
          %h2#idea Idea
          %p
            We consider a presentation,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} = (X : R)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi N
                  %mo →
                  %mi F
                  %mo →
                  %mi G
                  %mo →
                  %mn 1
                  %mo ,
                %annotation{:encoding => "application/x-tex"} 1\to N \to F \to G \to 1,
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F = F(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N = N(R)
            is the normal closure in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            of the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            by conjugation:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi u
                    %mi c
                    %mo =
                    %mi u
                    %mi c
                    %msup
                      %mi u
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {}^u c = u c u^{-1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi N
                  %annotation{:encoding => "application/x-tex"} c\in N
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} u \in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            are words in the conjugates of the elements of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo =
                  %msup
                    %mrow
                    %mrow
                      %msub
                        %mi u
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi r
                    %mn 1
                    %mrow
                      %msub
                        %mi ε
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %msup
                    %mrow
                    %mrow
                      %msub
                        %mi u
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi r
                    %mn 2
                    %mrow
                      %msub
                        %mi ε
                        %mn 2
                  %mo{:stretchy => "false"} )
                  %mi …
                  %msup
                    %mrow
                    %mrow
                      %msub
                        %mi u
                        %mi n
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi r
                    %mi n
                    %mrow
                      %msub
                        %mi ε
                        %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  c = {}^{u_1}(r_1^{\varepsilon_1}){}^{u_2}(r_2^{\varepsilon_2})\ldots
                  {}^{u_n}(r_n^{\varepsilon_n}),
          %p
            often says such elements are
            %em consequences
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong identity among the relations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is such an element,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            The problem of what this actually
            %em means
            is analogous to that of working with a relation, since, for example, in the presentation,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %msup
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ( a : a^3)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} C_3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is thought of as being an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} C_3
            = succeed "!" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mn 3
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a^3 = 1
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ( a : 1)
            = succeed "?" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo :
                    %mi a
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ( a : a = 1)
          %p
            To get around that mess, the free group on the generators,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\{a\})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mn 3
                %annotation{:encoding => "application/x-tex"} a^3
            is not 1. The relation is thus thought of as being a piece of data that is giving the instruction to rewrite that element to 1.
          %p
            An analogous free algebraic device, namely a
            %a.existingWikiWord{:href => "/nlab/show/free+crossed+module"} free crossed module
            on the presentation can be introduced to handle the identities.
          %p Before giving the formal definition we will look at some examples.
          %h2#example_proper_powers Example (Proper powers)
          %p
            Suppose
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r\in R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} s\in F
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %msup
                      %mi s
                      %mi m
                  %annotation{:encoding => "application/x-tex"} r = s^m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mi s
                  %mo =
                  %mi s
                  %mi r
                %annotation{:encoding => "application/x-tex"} r s = s r
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi s
                  %mi r
                  %msup
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {}^s r r^{-1} = 1
          %p
            so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi s
                  %mi r
                  %mo .
                  %msup
                    %mi r
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} {}^s r . r^{-1}
            is an identity. In fact, there will be a unique
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} z\in F
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %msup
                      %mi z
                      %mi q
                  %annotation{:encoding => "application/x-tex"} r = z^q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            maximal with this property. This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is called the
            %em root of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            and if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q \gt 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is called a
            = succeed "." do
              %em proper power
          %h2#example_standard_presentation_of_
            Example (Standard presentation of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S_3
          %p
            Here we take up the example from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Cayley+graph"} Cayley graph
          %p
            Consider one of the standard presentations of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S_3
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo :
                  %msup
                    %mi a
                    %mn 3
                  %mo ,
                  %msup
                    %mi b
                    %mn 2
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi ab
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (a,b  :  a^3, b^2, (ab)^2).
          %p
            Write
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %msup
                      %mi a
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} r = a^3
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %msup
                      %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} s = b^2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi ab
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} t = (ab)^2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F= F(a,b)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi F
                  %annotation{:encoding => "application/x-tex"} N(R) \subset F
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Nielsen-Schreier+theorem"} Nielsen-Schreier theorem
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cayley+graph"} Cayley graph
          %p
            The set of normal generators of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(R)
            has 3 elements;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(R)
            is free on 7 elements (corresponding to the edges not in the tree), yet it is specified as consisting of products of conjugates of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %em slight
            redundancy, so there must be some identities among the relations!
          %p
            Note that the Cayley graph is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar
          %p
            A path around the first triangle,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %mi a
                    %mo →
                    %msup
                      %mi a
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} 1 \to a \to a^2
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Pick a path to a start vertex of the loop, a path starting at 1. For instance the path that leaves 1 and goes along edges labelled
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            and then goes around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi a
                  %mi a
                %annotation{:encoding => "application/x-tex"} a a a
            before returning by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} b^{-1} a^{-1}
            gives
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi b
                    %mi r
                    %msup
                      %mi b
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a b r b^{-1} a^{-1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mi b
                  %mi a
                  %mi b
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi b
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi b
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi b
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mi a
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mi …
                %annotation{:encoding => "application/x-tex"} (a b a b) b^{-1} a^{-1} b^{-1} (b b) (b^{-1}a^{-1} b^{-1} a^{-1}) \ldots
            and so on, thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            can be written in a non-trivial way as a product of conjugates of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %h2#example_free_abelian_group_
            Example (Free Abelian group
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℤ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}^3
          %p
            In a presentation of the free Abelian group on 3 generators, one would expect the commutators,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x,y]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [x,z]
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [y,z]
          %p
            In a bit more detail, look at this as a
            = succeed "," do
              %em presented group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msup
                    %mi ℤ
                    %mn 3
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo{:stretchy => "false"} [
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi z
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} G=\mathbb{Z}^{3}=\langle x,y,z\mid [y,z],[z,x],[x,y]\rangle
          %p
            then label the relators
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi x
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} r_x= [y,z]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi y
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} r_y=[z,x]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi z
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} r_z= [x,y]
          %p There is an identity:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msup
                    %mrow
                    %mi y
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo .
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msup
                    %mrow
                    %mi z
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo .
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi z
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msup
                    %mrow
                    %mi x
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} [[x,y],{}^y z].[[y,z],{}^z x].[[z,x],{}^x y] =1
          %p
            which is easily checked to hold just by expanding it out and cancelling terms. This is one of the (many) forms of the well-known identity known variously as the
            = succeed "," do
              %em Hall-Witt identity
            = succeed "," do
              %em Jacobi-Hall-Witt identity
            = succeed "," do
              %em Jacobi identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi r
                    %mi z
                  %mo ,
                  %msup
                    %mrow
                    %mi y
                  %mi z
                  %mo{:stretchy => "false"} ]
                  %mo .
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi r
                    %mi x
                  %mo ,
                  %msup
                    %mrow
                    %mi z
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo .
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi r
                    %mi y
                  %mo ,
                  %msup
                    %mrow
                    %mi x
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [r_z,{}^y z].[r_x,{}^z x].[r_y,{}^x y]
          %p
            which can be written out as a product of conjugates of the three relations,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi x
                  %annotation{:encoding => "application/x-tex"} r_x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mi y
                %annotation{:encoding => "application/x-tex"} r_y
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi z
                  %annotation{:encoding => "application/x-tex"} r_z
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(x,y,z)
            %em identity among the relations
            for this presented group.
          %p
            Note the
            %a.existingWikiWord{:href => "/nlab/show/Cayley+quiver"} Cayley quiver
            of this presentation is infinite.
          %h2#definition Definition
          %p
            We can now formally define the module of identities of a presentation,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} = (X : R)
          %p
            We first form the
            %a.existingWikiWord{:href => "/nlab/show/free+crossed+module"} free crossed module
            on the mapping
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R\to F(X)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi 𝒫
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial : C(\mathcal{P}) \to F(X)
          #module.num_defn
            %h6#definition_2 Definition
            %p
              The
              %em module of identities
              ,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                      %mo{:stretchy => "false"} (
                      %mi 𝒫
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \kappa(\mathcal{P})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ker
                      %mspace{:width => "thinmathspace"}
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} Ker\, \partial
          %p
            An
            %em identity among the relations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is then an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo{:stretchy => "false"} (
                    %mi 𝒫
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \kappa(\mathcal{P})
          %p
            By construction, the group presented by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Im
                    %mspace{:width => "thinmathspace"}
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"}
                    G
                    \\cong F(X)/Im\, \partial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Im
                  %mspace{:width => "thinmathspace"}
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} Im \,\partial
            is just the normal closure of the set,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ker
                  %mspace{:width => "thinmathspace"}
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} Ker\, \partial
            is a
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi κ
                  %mo{:stretchy => "false"} (
                  %mi 𝒫
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi 𝒫
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∂
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                  %mo →
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} 0\to \kappa(\mathcal{P}) \to C(\mathcal{P}) \xrightarrow{\partial} F(X)\to G\to 1.
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cayley+graph"} Cayley graph
            %li
              %p
                %span.newWikiWord
                  homotopical syzygy
                  %a{:href => "/nlab/new/homotopical+syzygy"} ?
            %li
              %p
                %span.newWikiWord
                  homological syzygy
                  %a{:href => "/nlab/new/homological+syzygy"} ?
          %h2#references References:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/R.+Brown"} R. Brown
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+Huebschmann"} J. Huebschmann
                = succeed "," do
                  %em Identities among relations
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/M.+Kapranov"} M. Kapranov
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/M.+Saito"} M. Saito
                = succeed "," do
                  %em Hidden Stasheff polytopes in algebraic K-theory and in the space of Morse functions
                %em Higher homotopy structure in topology and mathematical physics
                (Poughkeepsie, N.Y. 1996), volume 227 of Contemporary Mathematics, 191 – 225, AMS
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.-L.+Loday"}> J.-L. Loday
                , 2000,
                = succeed "," do
                  %em Homotopical Syzygies
                = succeed "," do
                  %em Une dégustation topologique: Homotopy theory in the Swiss Alps
