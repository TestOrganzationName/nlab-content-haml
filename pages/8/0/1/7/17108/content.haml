          %p
            %br/
          %h2#properties Properties
          %h3#subgroups_and_supgroups Subgroups and Supgroups
          #Spin7SubgroupsInSpin8.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"}> Spin(7)
                \-
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
            %p
              There are precisely 3
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes+of+subgroups"} conjugacy classes
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              inside
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
              %a.existingWikiWord{:href => "/nlab/show/triality"} triality
              group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Out(Spin(8))
              %a.existingWikiWord{:href => "/nlab/show/action"} acts
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
