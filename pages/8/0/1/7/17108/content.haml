          %p
            (
            %a{:href => "#Varadarajan01"}> Varadarajan 01, Theorem 5 on p. 6
            )
          #G2IsIntersectionOfSpin7SubgroupsInSpin8.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82"} G₂
                is
                %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
                of
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              inside
              %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
              of any two
              = succeed "-subgroups" do
                %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes+of+subgroups"} conjugacy classes of subgroups
              (according to Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#Spin7SubgroupsInSpin8"}
              %a.existingWikiWord{:href => "/nlab/show/exceptional+Lie+group"} exceptional Lie group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82"} G₂
              %a.existingWikiWord{:href => "/nlab/show/pullback+squares"} pullback squares
              of the form
