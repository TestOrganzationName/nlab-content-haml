          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a (
            %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"}> cofibrantly generated
            )
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            be any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "-shape" do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi 𝒟
                  %mo ,
                  %mi 𝒞
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                %annotation{:encoding => "application/x-tex"} [\mathcal{D}, \mathcal{C}]_{proj}
            for the
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
            on the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            of
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
