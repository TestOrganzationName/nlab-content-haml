          %p
          .num_defn
            %h6 Definition
            %p
              A
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the result of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              %a.existingWikiWord{:href => "/nlab/show/monotone+function"} monotone
              in cell dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cell+attachments"} cell attachments
              via the
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GeneratingEquivariantCofibrations"} (1)
          %p
          #FiniteGroupCWComplexesAreCWComplexesWithCellularGAction.num_remark
            %h6 Remark
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %a.existingWikiWord{:href => "/nlab/show/equivariance+groups"} equivariance groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-CW-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %ul
              %li
                %p
                  a plain
                  = succeed "-structure" do
                    %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %li
                %p
                  on which the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/group+action"} action
                  is
                  %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cellular
                  (sends
                  = succeed "-cells" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-cells," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  which on cells that are sent to themselves actually restricts to the
                  %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity
                  (i.e. cells that are fixed under the action are actually fixed point-wise).
            %p
              This special case was the original definition on
              = succeed "." do
                %a{:href => "#Bredon67b"} Bredon 1967b, I.1
          %h2#examples Examples
          %h3#GManifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Manifolds
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+triangulation+theorem"} equivariant triangulation theorem
              says that if a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              acts on a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+triangulation"} equivariant triangulation
          %p
          #GManifoldsAreGCWComplexes.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              %a.existingWikiWord{:href => "/nlab/show/G-manifold"} G-manifold
              admits the structure of a G-CW complex.
          This is due to
          = succeed "," do
            %a{:href => "#Matumoto72"} Matumoto 72, Prop. 4.4
          = succeed "," do
            %a{:href => "#Illman72a"} Illman 72a, Thm. 3.1, Cor. 4.1
          = succeed "," do
            %a{:href => "#Illman72"} Illman 72b, Thm. 2.6
          = succeed "," do
            %a{:href => "#Illman73"} Illman 73, Thm. 2.1
          %a{:href => "equivariant+triangulation+theorem#Illman83"} Illman 83, Thm. 7.1, Cor. 7.2
          – review in
          = succeed "," do
            %a{:href => "#ALR07"} ALR 07, theorem 3.2
          = succeed "." do
            %a{:href => "#Waner80"} Waner 80, p. 6
          %p
            Moreover, if the manifold does have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
            = succeed ")" do
              %a{:href => "equivariant+triangulation+theorem#Illman83"} Illman 83, last sentence above theorem 7.1
          %p In particular:
          #RepresentationSpheresAreGCWComplexes.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/G-representation+spheres+are+G-CW-complexes"}> G-representation spheres are G-CW-complexes
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              (e.g. a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in RO(G)
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V
              admits the structure of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"} G-CW-complex
          %p
            Simple examples of
            %a.existingWikiWord{:href => "/nlab/show/G-manifolds"} G-manifolds
            (
            %a{:href => "#GManifolds"}> above
            ) are
            %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
            with
            = succeed "-action," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-tori" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")." do
              %a{:href => "#EquivariantCellStructureOf2Tori"} below
