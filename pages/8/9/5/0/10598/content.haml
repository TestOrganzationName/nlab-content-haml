                %annotation{:encoding => "application/x-tex"} G
            be
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            (typically required to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            = succeed ")." do
              %a{:href => "compact+Lie+group#InEquivariantHomotopyTheory"} there
          %p
            As
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %munder
                    %mo ⊂
                    %mi clsd
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \underset{clsd}{\subset} G
            ranges over its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+subgroups"} closed subgroups
            %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            as
            %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
            with respect to the residual left multiplication action by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/product+spaces"} product spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                  %mo ×
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} S^n \times G/H
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi n
                  %mo ×
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} D^n \times G/H
            with the
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
          %p
            This way, the canonical
            %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+manifold"} boundary
            inclusions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
