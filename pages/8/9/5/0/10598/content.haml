                  S^{n-1} \xhookrightarrow{\phantom{--}} D^n
          %p
            considered for ordinary
            %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            induces
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+maps"} equivariant maps
          #eq:GeneratingEquivariantCofibrations.maruku-equation
