          #ClosureUnderProductsForFiniteGroups.num_prop
            %h6 Proposition
            %p
              At least for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of two
              = succeed "-CW-complexes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+weak+Hausdorff+spaces"} compactly generated weak Hausdorff spaces
              is itself a
              = succeed "-CW-complex." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .proof
            %h6 Proof
            %p
              Since for finite
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-CW" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cellular
              %a.existingWikiWord{:href => "/nlab/show/group+action"} action
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiniteGroupCWComplexesAreCWComplexesWithCellularGAction"}
              = succeed "." do
                %a{:href => "CW+complex#ClosureOfCWComplexesUnderCartesianProduct"} this Proposition
