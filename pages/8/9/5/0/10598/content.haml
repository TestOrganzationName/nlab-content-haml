            %li#Illman72b
              %p
                %a.existingWikiWord{:href => "/nlab/show/S%C3%B6ren+Illman"}> Sören Illman
                , Section 2 of:
                %em Equivariant singular homology and cohomology for actions of compact lie groups
                (
                %a{:href => "https://doi.org/10.1007/BFb0070055"}> doi:10.1007/BFb0070055
                ) In: H. T. Ku, L. N. Mann, J. L. Sicks, J. C. Su (eds.),
                %em Proceedings of the Second Conference on Compact Transformation Groups
                Lecture Notes in Mathematics, vol 298. Springer 1972 (
                %a{:href => "https://link.springer.com/book/10.1007/BFb0070029"}> doi:10.1007/BFb0070029
                )
            %li#Illman73
