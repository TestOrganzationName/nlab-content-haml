                %strong 18
                (1971) 363-374 &amp;lbrack;
                %a{:href => "https://irdb.nii.ac.jp/en/00926/0001786419"}> irdb:00926/0001786419
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/matumoto.pdf", :title => "PDF"} PDF
            %li#Matumoto72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Takao+Matumoto"}> Takao Matumoto
                ,
                = succeed "," do
