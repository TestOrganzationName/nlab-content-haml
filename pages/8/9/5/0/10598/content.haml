                = succeed "," do
                  %a{:href => "https://repository.dl.itc.u-tokyo.ac.jp/?action=repository_action_common_download&item_id=39826&item_no=1&attribute_id=19&file_no=1"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/MatumotoEquivariantKTheory.pdf", :title => "pdf"} pdf
          %p and, independently, due to:
          %ul
            %li#Illman72a
              %p
