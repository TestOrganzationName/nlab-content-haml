          %h2#idea Idea
          %p
            The
            %em Pontryagin classes
            are
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B O(n)
            of the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            and, by pullback, on the base of any bundle with structural group the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
          %p
            The analogs for the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            are the
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
          %h2#definition Definition
          %p
            The universal Pontryagin
            %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi k
                %annotation{:encoding => "application/x-tex"} P_k
            on the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B O(n)
            are, up to a sign, the pullbacks of the
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mrow
                      %mn 2
                      %mi k
                %annotation{:encoding => "application/x-tex"} c_{2k}
            along the
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            inclusion into the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B O(n) \to B U(n)
                  \\,.
          %h2#properties Properties
          %h3#as_generating_universal_characteristic_classes As generating universal characteristic classes
          %p
            The torsion-free quotient of the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(B SO(2n+1), \mathbb{Z})
            is the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            on all Pontryagin classes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi P
                      %mi i
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{P_i\}_{i = 1}^n
            %a.existingWikiWord{:href => "/nlab/show/Bockstein+homomorphism"} Bockstein
            images of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi BSO
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(BSO(2n+1);\mathbb{F}_2)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stiefel-Whitney+classes"} Stiefel-Whitney classes
          %p
            The torsion-free quotient of the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(B SO(2n), \mathbb{Z})
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            on Pontryagin classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi i
                %annotation{:encoding => "application/x-tex"} P_i
            and the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            by the relation
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi χ
                      %mn 2
                    %mo =
                    %msub
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \chi^2 = P_n
          %h3#FurtherRelationToChernClasses Further relation to Chern classes
          %p Under the other canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi BO
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  j \;\colon\; B U(n) \to BO(2n)
          %p one has
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo +
                      %mi b
                      %mo =
                      %mn 2
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi a
                      %mo +
                      %mi k
                  %msub
                    %mi c
                    %mi a
                  %msub
                    %mi c
                    %mi b
                %annotation{:encoding => "application/x-tex"}
                  j^\ast(P_k) = \sum_{a + b = 2 k} (-1)^{a+k} c_a c_b
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi j
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi c
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  j^\ast(\chi) = c_n
                  \\,.
          %h3#SplittingPrincipleAndChernRoots Splitting principle and Chern roots
          %p Under the inclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ↪
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  i \;\colon\; U(1)^n \hookrightarrow U(n) \to O(2n)
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
            one has that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi σ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  (B i)^\ast(P_k) = \sigma_k(x_1, \cdots, x_n)^2
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi σ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (B i)^\ast(\chi) = \sigma_n(x_1, \cdots, x_n)
          %p
            where the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x_i \in H^\bullet(B U(1)^n, \mathbb{Z})
            are the “
            %a.existingWikiWord{:href => "/nlab/show/Chern+roots"}> Chern roots
            ”.
          %p
            See at
            %em
              %a{:href => "Chern%20class#SplittingPrinciple"} Chern class - Properties – Splitting principle and Chern roots
            and at
            %em
              %a{:href => "splitting+principle#RealVectorBundles"} splitting principle - Examples - Real vector bundles
            for more.
          %div
            %h3#chern_pontrjagin_and_euler_characteristic_forms Chern-, Pontrjagin-, and Euler- characteristic forms
            %p
              We spell out the formulas for the images under the
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+classes"} Pontrjagin classes
              and
              %a.existingWikiWord{:href => "/nlab/show/Euler+classes"} Euler classes
              as
              %a.existingWikiWord{:href => "/nlab/show/characteristic+forms"} characteristic forms
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %h4#preliminaries Preliminaries
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %p Write
            #eq:RingOfEvenDegreeDifferentialForms.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi CAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{2\bullet}(X)
                    \\;\;
                    \\in
                    \\;
                    CAlg_{\mathbb{R}}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              of
              = succeed "-degree" do
                %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              of differential forms. This is naturally a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebra"} graded commutative algebra
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
              (such as
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+Lie+algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(d)
              or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d)
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Rep
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \,\in\, Rep_{\mathbb{C}}(\mathfrak{g})
              over the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+vector+space"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(V) \,=\, n \,\in\, \mathbb{N}
              (for instance the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+representation"} adjoint representation
              or the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+representation"} fundamental representation
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi ρ
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}
                    \\xrightarrow{\;\;\rho\;\;}
                    End_{\mathbb{C}}(V)
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi End
                        %mi ℂ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} End_{\mathbb{C}}(V)
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              as the
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+Lie+algebra"} endomorphism Lie algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              When regarded as an
              %a.existingWikiWord{:href => "/nlab/show/associative+ring"} associative ring
              this is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/square+matrices"} square matrices
            #eq:LinearEndomorphismRing.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    End_{\mathbb{C}}(V)
                    \\;\;
                    \\simeq
                    \\;\;
                    Mat_{n \times n}(\mathbb{C})
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebras
              %a.maruku-eqref{:href => "#eq:RingOfEvenDegreeDifferentialForms"} (1)
              and
              %a.maruku-eqref{:href => "#eq:LinearEndomorphismRing"} (2)
            %p
              is equivalently the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              of even-degree differential forms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{2\bullet}
                    \\big(X\big)
                    \\otimes_{\mathbb{R}}
                    End_{\mathbb{C}}(V)
                    \\;\simeq\;
                    \\Omega^{2\bullet}(X)
                    \\otimes_{\mathbb{R}}
                    \\big(
                    Mat_{n \times n}( \mathbb{R} )
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    Mat_{n \times n}
                    \\big(
                    \\Omega^{2\bullet}(X) \otimes_{\mathbb{R}} \mathbb{C}
                    \\big)
                    \\,.
            %p
              The multiplicative
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            #eq:UnitInAlgebraOfEndomorphismValuedEvenDegreeDifferentialForms.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    I
                    \\;\in\;
                    Mat_{n \times n}
                    \\big(
                    \\Omega^{2\bullet}(X) \otimes_{\mathbb{R}} \mathbb{C}
                    \\big)
            %p
              in this algebra is the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (
              %a.existingWikiWord{:href => "/nlab/show/differential+0-forms"}> differential 0-forms
              ) which is
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+matrix"} identity matrix
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
              on a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                \-valued
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              as an element of this algebra
            #eq:CurvatureFormAsElementOfMatrixValuedEvenDegreeDifferentialForm.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi 𝔤
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi ρ
                        %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi End
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mi ℂ
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
