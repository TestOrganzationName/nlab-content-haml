                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mfrac
                              %mrow
                                %mo{:lspace => "0em", :rspace => "thinmathspace"} tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 8
                                %msup
                                  %mi π
                                  %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %msup
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mn 2
                                %mo −
                                %mn 2
                                %mo ⋅
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 4
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 128
                                %msup
                                  %mi π
                                  %mn 4
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_1(\nabla)
                    \&amp;
                    \\;=\;
                    \-
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    \\\
                    p_2(\nabla)
                    \&amp; \;=\;
                    \\frac
                    {
                    tr\big(  (F_\nabla)^2 \big)^2
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    }
                    {128 \pi^4}
                    \\,.
                    \\end{aligned}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.5
            %h5#euler_forms Euler forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              and with the
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              again regarded as a 2-form valued
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2k) \times (2k)
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mo ≤
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    F_{\nabla}
                    \\;=\;
                    \\big(
                    (F_{\nabla})^a{}_b
                    \\big)_{1 \leq a,b, \leq 2k}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
              is its
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
              of this matrix, hence the following
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(2k)
              with summands signed by the the
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mo ±
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} sgn(\sigma) \in \{\pm 1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                        %mo ⋅
                        %mi k
                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi σ
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{2k}(\nabla)
                    \\;=\;
                    \\frac
                    {(-1)^k}
                    { (4 \pi)^k \cdot k! }
                    \\underset{\sigma}{\sum}
                    sgn(\sigma)
                    \\cdot
                    (F_{\nabla})_{\sigma(1)\sigma(2)}
                    \\wedge
                    (F_{\nabla})_{\sigma(3)\sigma(4)}
                    \\wedge
                    \\cdots
                    \\wedge
                    (F_{\nabla})_{\sigma(2k-1)\sigma(2k)}
                    \\,.
            %p
              The first of these is, using the
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              and the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi ϵ
                          %mrow
                            %mi a
                            %mi b
                            %mi c
                            %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi a
                            %mi b
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi c
                            %mi d
                      %mrow
                        %mn 32
                        %msup
                          %mi π
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_4(\nabla)
                    \\;=\;
                    \\frac
                    { \epsilon^{ a b c d} (F_{\nabla})_{a b} \wedge (F_\nabla)_{c d}  }
                    {32 \pi^2}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.7
          %h2#trivializations_and_structures Trivializations and structures
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structures"} twisted differential c-structures
            corresponding to Pontryagin class include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+differential+string+structure"} twisted differential string structure
                for the first fractional Pontryagin class
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                          %mn 2
                        %mo :
                        %mi B
                        %mi Spin
                        %mo →
                        %msup
                          %mi B
                          %mn 3
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \frac{p_1}{2} : B Spin \to B^3 U(1)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+differential+fivebrane+structure"} twisted differential fivebrane structure
                for the second fractional Pontryagin class
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mn 1
                          %mn 6
                        %msub
                          %mi p
                          %mn 2
                        %mo :
                        %mi B
                        %mi String
                        %mo →
                        %msup
                          %mi B
                          %mn 7
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \frac{1}{6}p_2 : B String \to B^7 U(1)
          %h2#related_concepts Related concepts
          %ul
