                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_\nabla
                    \\,\in\,
                    \\Omega^2(X) \otimes_{\mathbb{R}} \mathfrak{g}
                    \\xrightarrow{\; \rho \;}
                    \\Omega^2(X) \otimes_{\mathbb{R}} End_{\mathbb{C}}(V)
                    \\xhookrightarrow{\;\;\;}
                    \\Omega^{2\bullet}(X) \otimes_{\mathbb{R}} End_{\mathbb{C}}(V)
                    \\;\simeq\;
                    Mat_{n \times n}
                    \\Big(
                    \\mathbb{C} \otimes_{\mathbb{R}} \Omega^{2}(X)
                    \\Big)
                    \\,.
            %h4#the_formulas The formulas
            %h5#chern_forms Chern forms
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/total+Chern+form"} total Chern form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(\nabla)
              is the
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              of the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the unit
              %a.maruku-eqref{:href => "#eq:UnitInAlgebraOfEndomorphismValuedEvenDegreeDifferentialForms"} (3)
              with the curvature form
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CurvatureFormAsElementOfMatrixValuedEvenDegreeDifferentialForm"} (4)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                th
                %a.existingWikiWord{:href => "/nlab/show/Chern+form"} Chern form
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_k(\nabla)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi c
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mo ∇
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mpadded{:lspace => "-50%width", :width => "0"}
                        %mrow
                          %mi deg
                          %mo =
                          %mn 2
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi det
                    %mrow
                      %mo (
                      %mi I
                      %mo +
                      %mfrac
                        %mrow
                          %mi i
                          %msub
                            %mi F
                            %mo ∇
                        %mrow
                          %mn 2
                          %mi π
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c(\nabla)
                    \\;\;
                    \\coloneqq
                    \\;\;
                    \\sum_k
                    \\underset{
                    \\mathclap{
                    deg = 2k
                    }
                    }{
                    \\underbrace{
                    c_k(\nabla)
                    }
                    }
                    \\;\;
                    \\coloneqq
                    \\;\;
                    det
                    \\left(
                    I + \frac{i F_\nabla}{2\pi}
                    \\right)
                    \\,.
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/relation+between+determinant+and+trace"} relation between determinant and trace
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              of the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              of the
              %a.existingWikiWord{:href => "/nlab/show/logarithm"} logarithm
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo +
                      %mfrac
                        %mrow
                          %mi i
                          %msub
                            %mi F
                            %mo ∇
                        %mrow
                          %mn 2
                          %mi π
                    %annotation{:encoding => "application/x-tex"} I + \frac{i F_\nabla}{2\pi}
              %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
              in the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              of the
              %a.existingWikiWord{:href => "/nlab/show/Mercator+series"} Mercator series
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi i
                          %msub
                            %mi F
                            %mo ∇
                        %mrow
                          %mn 2
                          %mi π
                    %annotation{:encoding => "application/x-tex"} \frac{i F_\nabla}{2\pi}
            #eq:ExplicitUnwindingOfTotalChernForm.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi c
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi det
                            %mrow
                              %mo (
                              %mi I
                              %mo +
                              %mfrac
                                %mrow
                                  %mi i
                                  %msub
                                    %mi F
                                    %mo ∇
                                %mrow
                                  %mn 2
                                  %mi π
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi exp
                            %mo ∘
                            %mi tr
                            %mo ∘
                            %mi ln
                            %mrow
                              %mo (
