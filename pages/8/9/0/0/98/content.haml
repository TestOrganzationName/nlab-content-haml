            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+algebra"} de Rham algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mo ∧
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %mo •
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi T
                    %mo *
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi dR
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(T X) = (\wedge^\bullet_{C^\infty(X)} \Gamma(T^* X), d_{dR})
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mi i
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v_i \in \Gamma(T X))
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi Ω
                    %mi n
                  %mo =
                  %msubsup
                    %mo ∧
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %mi n
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n = \wedge^n_{C^\infty(X)} \Gamma(T X)^*
            a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            of degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a{:href => "#OfLieAlgebroids"} formula for the CE-differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mn 0
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mi sgn
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Shuff
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo ,
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi sgn
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi v
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (d\omega)(v_0, \cdots, v_n)
                  \=
                  \\sum_{\sigma \in Sh(1,n)} sgn(\sigma) v_{\sigma(0)}(\omega(v_{\sigma(1)}, \cdots, v_{\sigma(n)}))
                  +
                  \\sum_{\sigma \in Shuff(2,n-1)} sgn(\sigma)
                  \\omega([v_{\sigma(0)},v_{\sigma(1)}],v_{\sigma(2)}, \cdots, v_{\sigma(n)} )
                  \\,,
          %p is indeed that for the de Rham differential.
          %h3#of_the_string_lie_2algebra Of the string Lie 2-algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a semisimple Lie algebra with binary
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            – the
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            – , the CE-algebra of the
            %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔤
                    %mo +
                  %mo ⊕
                  %msup
                    %mi ℝ
                    %mo *
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi string
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{string}) = (\wedge^\bullet( \mathfrak{g}^+ \oplus \mathbb{R}^*[1]), d_{string})
          %p
            where the differential restricted to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}^*
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} [-,-]^*
            while on the new generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            spanning
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mo *
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^*[1]
            it is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi b
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mo ∧
                    %mn 3
                  %msup
                    %mi 𝔤
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d b = \langle -, [-,-]\rangle \in \wedge^3 \mathfrak{g}^*
                  \\,.
          %h3#weil_algebra Weil algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
            given by the
            %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mover
                    %mo →
                    %mi Id
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{g} \stackrel{Id}{\to} \mathfrak{g})
            is the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g})
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mover
                    %mo →
                    %mi Id
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{g} \stackrel{Id}{\to} \mathfrak{g})
                  \=
                  W(\mathfrak{g})
                  \\,.
          %h3#lie_algebra_cohomology Lie algebra cohomology
          %p
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            with coefficients in the left
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Lie
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi Ext
                      %mrow
                        %mi U
                        %mi 𝔤
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^*_{Lie}(\mathfrak{g},M) = Ext_{U\mathfrak{g}}^*(k,M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi 𝔤
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_{\mathfrak{g}}(V(\mathfrak{g}),M)
            (a similar story is for
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+homology"} Lie algebra homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi Λ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V(\mathfrak{g})=U(\mathfrak{g})\otimes\Lambda^*(\mathfrak{g})
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+chain+complex"} Chevalley-Eilenberg chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is finite-dimensional over a field then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi 𝔤
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi Λ
                    %mo *
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} Hom_{\mathfrak{g}}(V(\mathfrak{g}),k) =  CE(\mathfrak{g}) = \Lambda^* \mathfrak{g}^*
            is the underlying complex of the Chevalley-Eilenberg algebra, i.e. the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+cochain+complex"} Chevalley-Eilenberg cochain complex
            with trivial coefficients.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in degree n of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            with values in the trivial module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is a morphism of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g} \to b^{n-1} \mathfrak{u}(1)
                  \\,.
          %p
            In terms of CE-algebras this is a
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi b
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{g}) \leftarrow CE(b^{n-1}\mathfrak{u}(1))
                  \\,.
          %p
            Since by the above example the dg-algebra on he right has a single generator in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and vanishing differential, such a morphism is precisely the same thing as a degree
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mo ∧
                    %mi n
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \omega \in \wedge^n \mathfrak{g}^*
            which is closed under the CE-differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                  %mi ω
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE} \omega = 0
                  \\,.
          %p
            This is what one often sees as the definition of a cocycle in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo →
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \to b^{n-1}\mathfrak{u}(1)
          %h3#brst_complex BRST complex
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo ,
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g}, N)
            of the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            or
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            of a
            %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            of fields is called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
          %p In this context
          %ul
            %li
              %p
                the generators in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                in degree 0 are called
                = succeed ";" do
                  %strong fields
            %li
              %p
                the generators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∈
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \in \mathfrak{g}^*
                in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                are called
                = succeed ";" do
                  %strong ghosts
            %li
              %p
                the generators in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                are called
                = succeed ";" do
                  %strong ghosts of ghosts
            %li
              %p etc.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is itself a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST complex
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
            %li
              %p
                %strong Chevalley-Eilenberg algebra
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+algebra"} differential graded-commutative algebra
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebra"} differential graded-commutative superalgebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
          %h2#references References
          %p An elementary introduction for CE-algebras of Lie algebras is at the beginning of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"}> José de Azcárraga
              , J. M. Izquierdo, J. C. Perez Bueno,
              %em An introduction to some novel applications of Lie algebra cohomology and physics
              (
              %a{:href => "http://arxiv.org/abs/physics/9803046"}> arXiv:physics/9803046
              )
          %p More details are in of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"}> José de Azcárraga
              , José M. Izquierdo, section 6.7 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lie+Groups%2C+Lie+Algebras%2C+Cohomology+and+Some+Applications+in+Physics"} Lie Groups, Lie Algebras, Cohomology and Some Applications in Physics
              , Cambridge monographs of mathematical physics, (1995)
          %p
            See also almost any text on
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            (see the list of references there).
