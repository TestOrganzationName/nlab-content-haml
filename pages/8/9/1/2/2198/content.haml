                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y\} \;\delta\; \{x\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            iff every proximal neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{y\}
            is a proximal neighbourhood of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
          %p
            If the quasiproximity satisfies Symmetry, then this preorder is
            %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
            and hence an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p
            Regardless of Symmetry, a (quasi)-proximity space is separated iff this preorder is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equality+relation"} equality relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x = y
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            belongs to every proximal neighbourhood of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{y\}
            is a proximal neighbourhood of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x\}
            is near
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x\}
            is not apart from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{y\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mi δ
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x\} \;\delta\; \{y\}
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x = y
          %p
            Conversely, given a set equipped with a preorder
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mi δ
                  %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \;\delta\; B
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            and some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} y \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \bowtie B
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            for no
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            and no
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} y \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \ll B
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \leq y
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            implies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} y \in B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            is.
          %p
            In this way, we get the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Proset
                %annotation{:encoding => "application/x-tex"} Proset
            of preordered sets as a
            %a.existingWikiWord{:href => "/nlab/show/reflexive+subcategory"} reflexive subcategory
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QProx
                  %annotation{:encoding => "application/x-tex"} QProx
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SymPreOrd
                %annotation{:encoding => "application/x-tex"} SymPreOrd
            of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+prosets"} symmetric prosets
            (sets equipped with equivalence relations) as a reflexive subcatgory of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prox
                  %annotation{:encoding => "application/x-tex"} Prox
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/inequality+relation"} inequality relation
            that is an
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            if we have Local Decomposability.
          %h3#topological_spaces Topological spaces
          %p
            Every proximity space is a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            belong to the closure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} A \subseteq X
            iff
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \{x\} \;\delta\; A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            belong to the interior of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ≪
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \{x\} \ll A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/completely+regular+space"} completely regular
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            (hence
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+space"} Tychonoff
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} separation axiom
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            for the induced topologies, so we have a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prox
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Prox \to Top
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\tau)
            is a completely regular topological space, then for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} A, B \subseteq X
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \bowtie B
            iff there is a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f: X\to [0,1]
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) = 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f(x) = 1
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x \in B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            is a Hausdorff (hence Tychonoff) topology.
          %p
            In general, a completely regular topology may be induced by more than one proximity. However, if it is moreover
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
            (or more generally any
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/normal+regular+space"} normal regular space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \ll B
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(A) \subseteq Int(B)
          %p
            The construction of a topology works just as well for a quasi-proximity, but the result is no longer necessarily completely regular. In fact, every topology can be induced by some quasi-proximity: define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \ll B
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi int
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq int(B)
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closure+operators"} closure operators
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point-set+apartness+spaces"} point-set apartness spaces
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            (equivalently
            %a.existingWikiWord{:href => "/nlab/show/neighborhood"} neighborhood
            spaces). Note in particular that the Transitivity axiom ensures that (in the three cases) the closure of a set is closed, that the final axiom of a point-set apartness space holds (if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⋈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x\bowtie A
            then
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⋈
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ⋈
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} x\bowtie \{ y \mid \neg(y\bowtie A) \}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \ll B
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi int
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \subseteq int(B)
            as above in the second case, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\bowtie B
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                  %mo ⇒
                  %mi x
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} x\in A \Rightarrow x\bowtie B
            in the first.
          %p
            If a quasi-proximal apartness or neighborhood space satisfies Local Decomposability, then its underlying point-set apartness space or topological space is
            %a.existingWikiWord{:href => "/nlab/show/locally+decomposable+space"} locally decomposable
            (hence the name for the former axiom). Conversely, the canonical quasi-proximial apartness or neighborhood space obtained from a point-set apartness space or topological space satisfies Local Decomposability if the original space was locally decomposable.
          %p
            Unlike in the classical case, the topology underlying a proximity space (which, recall, includes Symmetry) apparently need not be
            %a.existingWikiWord{:href => "/nlab/show/completely+regular+space"} completely regular
            or even
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a proximal apartness or neighborhood space (with Symmetry). Then:
            %ul
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                satisfies Local Decomposability, its underlying topological space is regular.
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                satisfies Decomposability and
                %a.existingWikiWord{:href => "/nlab/show/countable+choice"} countable choice
                holds, then its underlying topological space is completely regular.
          .proof
            %h6#proof_2 Proof
            %p
              Suppose first that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a Locally Decomposable proximal neighborhood space and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is an open set containing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ≪
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \{x\} \ll U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ≪
                    %mi C
                  %annotation{:encoding => "application/x-tex"} \{x\} \ll C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≪
                    %mi U
                  %annotation{:encoding => "application/x-tex"} D\ll U
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi D
                      %mo ∪
                      %msup
                        %mi C
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi c
                    %annotation{:encoding => "application/x-tex"} X = D \cup C^{\mathsf{c}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ≪
                      %mi B
                      %mo ≪
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \{x\} \ll B \ll C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi c
                      %mo ≪
                      %msup
                        %mi B
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi c
                    %annotation{:encoding => "application/x-tex"} C^{\mathsf{c}} \ll B^{\mathsf{c}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi int
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V = int(B^{\mathsf{c}})
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo =
                      %mo ∫
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W = \int(B)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∩
                      %mi W
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} V\cap W = \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is an open neighborhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi D
                      %mo ∪
                      %msup
                        %mi C
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi c
                      %mo ⊆
                      %mi U
                      %mo ∪
                      %mi V
                    %annotation{:encoding => "application/x-tex"} X = D \cup C^{\mathsf{c}} \subseteq U \cup V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is regular.
            %p
              Now suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a Decomposable proximal neighborhood space and we have countable choice. Then given any opens
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A,B
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ≪
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A\ll B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is “well-inside”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:X\to \mathbb{R}
              separating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/lower+real+numbers"} lower
              or upper real numbers, rather than the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/located+real+numbers"} located real numbers
            %p The arguments for proximal apartness spaces are essentially the same.
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a completely regular topological space, then the above definition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \bowtie B
            iff they are separated by a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f: X\to [0,1]
            is also constructively valid, and produces a proximity space satisfying Symmetry and Decomposability.
          %h3#Uniform Uniform spaces
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ⊆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} A, B \subseteq Y
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mi δ
                  %mspace{:width => "thickmathspace"}
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \;\delta\; B
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∩
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \cap (A \times B)
            is
            %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            for every
            %a.existingWikiWord{:href => "/nlab/show/entourage"} entourage
            (aka vicinity)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\bowtie B
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∩
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} V \cap (A \times B) = \emptyset
            for some entourage
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\ll B
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ⊆
                  %mi B
                %annotation{:encoding => "application/x-tex"} V[A] \subseteq B
            for some entourage
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ∃
                    %mi x
                    %mo ∈
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V[A] = \{ y \mid \exists x\in A, (x,y)\in V \}
          %p
            %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous+map"} Uniformly continuous functions
            are proximally continuous for the induced proximities, so we have a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Unif
                  %mo →
                  %mi Prox
                %annotation{:encoding => "application/x-tex"} Unif \to Prox
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Unif
                  %mo →
                  %mi Prox
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Unif \to Prox \to Top
            is the usual “underlying topology” functor of a uniform space, i.e. the topology induced by the uniformity and the topology induced by the proximity structure are the same.
          %p
            Conversely, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a proximity space, consider the family of sets of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %mrow
                      %mi k
                      %mo =
                      %mn 1
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi k
                  %mo ×
                  %msub
                    %mi A
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigcup_{k=1}^n (A_k \times A_k)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi k
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                %annotation{:encoding => "application/x-tex"} (A_k)_k
            is a
            %a.existingWikiWord{:href => "/nlab/show/list"} list
            (a finite family) of sets such that there exists a same-length list of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi k
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                %annotation{:encoding => "application/x-tex"} (B_k)_k
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi k
                  %mo ≪
                  %msub
                    %mi A
                    %mi k
                %annotation{:encoding => "application/x-tex"} B_k \ll A_k
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi B
                      %mi k
                  %annotation{:encoding => "application/x-tex"} X = \bigcup_{k=1}^n B_k
            %a.existingWikiWord{:href => "/nlab/show/totally+bounded+uniformity"} totally bounded uniformity
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            In fact, this is the
            %em unique
            totally bounded uniformity which induces the given proximity: every proximity-class of uniformities contains a unique totally bounded member. Moreover, a proximally continuous function between uniform spaces with totally bounded
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            is automatically uniformly continuous. Therefore, the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Unif
                  %mo →
                  %mi Prox
                %annotation{:encoding => "application/x-tex"} Unif \to Prox
            is a left adjoint, whose right adjoint also lives over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful
            %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
            given by the totally bounded uniform spaces.
          %p
            In general, proximally continuous functions between given uniform spaces need not be uniformly continuous. But in addition to total boundedness of the codomain, a different sufficient condition is that the domain be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
          %p The relation between quasi-uniformities and quasi-proximities is similar.
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo ,
                  %mo ⋈
                  %mo ,
                  %mo ≪
                %annotation{:encoding => "application/x-tex"} \delta,\bowtie,\ll
            may be defined as above from a uniformity. All the axioms of all three kinds of proximity are then provable, except Binary Additivity for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
            %a.existingWikiWord{:href => "/nlab/show/uniform+regularity"} uniform regularity
            for the uniform space, but Decomposability seems unobtainable in this way; it seems to assert
            %a.existingWikiWord{:href => "/nlab/show/located+subspace"} locatedness
            of all subsets.
          %p
            Moreover, constructively not every
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋈
                  %annotation{:encoding => "application/x-tex"} \bowtie
            = succeed "-proximity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\bowtie B
            defined to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi ∅
                    %mo ∨
                    %mi B
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} A = \emptyset \vee B=\emptyset
            = succeed "-proximity," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋈
                  %annotation{:encoding => "application/x-tex"} \bowtie
            %a.existingWikiWord{:href => "/nlab/show/weak+excluded+middle"} weak excluded middle
            holds. To see this, given a proposition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} \xi\in X
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi x
                  %mo =
                  %mi ξ
                  %mo ∧
                  %mi P
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} A = \{ x \mid x=\xi \wedge P\}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi x
                    %mo =
                    %mi ξ
                    %mo ∧
                    %mo ¬
                    %mi P
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} B = \{x \mid x=\xi \wedge \neg P\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi B
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} A\times B = \emptyset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\bowtie B
            in any proximity defined from a uniformity; but to say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi ∅
                  %mo ∨
                  %mi B
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} A = \emptyset \vee B=\emptyset
            is weak excluded middle for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed ".)" do
              %a{:href => "#BridgesVita"} Bridges and Vita
          %p
            However, there is a different way to obtain a proximity underlying a uniformity: define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋈
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\bowtie B
            if there is a uniformly continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f: X\to [0,1]
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} f(x) = 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x \in A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f(x) = 1
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} x \in B
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
            %em if
            our original uniform space was already
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/completely+regular+space"} completely regular
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/countable+choice"} countable choice
          %h3#syntopogenous_spaces Syntopogenous spaces
          %p
            A proximity space can be identified with a
            %a.existingWikiWord{:href => "/nlab/show/syntopogenous+space"} syntopogenous space
            which is both
            %em simple
            and
            = succeed "," do
              %em symmetric
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/syntopogenous+space"} syntopogenous space
          %h3#compactifications Compactifications
          %p
            The (separated) proximities inducing a given (Hausdorff) completely regular topology can be identified with (Hausdorff)
            %a.existingWikiWord{:href => "/nlab/show/compactifications"} compactifications
            of that topology. The compactification corresponding to a proximity on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is called its
            = succeed "." do
              %strong Smirnov compactification
            %strong clusters
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that
          %ol
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} A \in \sigma
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∈
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} B \in \sigma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi δ
                      %mspace{:width => "thickmathspace"}
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \;\delta\; B
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \;\delta\; C
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∈
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} C \in \sigma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} A \in \sigma
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∪
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} (A \cup B) \in \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} A \in \sigma
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∈
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} B \in \sigma
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is nonempty.
          %p
            Note that conditions (1) and (2), together with Isotony for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is upwards-closed. Together with nullary Additivity for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ∉
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \emptyset \notin\sigma
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/filter"} filter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            embeds in its compactification, taking each point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to the “principal cluster”
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi x
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi A
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \sigma_x = \{ A \mid \{x\}\;\delta\; A \}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %h2#profunctors Proximities as profunctors
          %p
            As a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{P}X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            may be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            over a category, also called (more specifically) a distributor or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
          %p
            Then a profunctor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{P}X
            to itself is precisely a binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≪
                %annotation{:encoding => "application/x-tex"} \ll
            on subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that satisfies Isotony. Adding Reflexivity makes it a co-
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            profunctor, and Transitivity morally makes it a
            %a.existingWikiWord{:href => "/nlab/show/coassociative+coalgebra"} coassociative coalgebra
            with Reflexivity as counit. (Actually, coassociativity is trivial when enriched over truth values, as is the claim that Reflexivity, once it exists, is a counit, but we say ‘coassociative’ to clarify which sense of ‘coalgebra’ we mean.)
          %p
            The sense in which Transitivity makes this a coalgebra is actually a bit involved, and it only quite works because of Additivity. A coalgebra with a given profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≪
                %annotation{:encoding => "application/x-tex"} \ll
            as its underlying bimodule has the
            %em structure
            of an operation that, given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≪
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \ll z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≪
                    %mi y
                    %mo ≪
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x \ll y \ll z
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} y'
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ⊆
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} y \subseteq y'
            (or by any equivalence that follows). By Isotony and left binary Additivity,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≪
                  %mi y
                  %mo ∪
                  %mi y
                  %mo ′
                  %mo ≪
                  %mi z
                %annotation{:encoding => "application/x-tex"} x \ll y \cup y' \ll z
            (or use right Additivity and
            = succeed ");" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∩
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y \cap y'
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ,
                    %mi y
                    %mo ′
                    %mo ⊆
                    %mi y
                    %mo ∪
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y, y' \subseteq y \cup y'
          %p
            This suggests that if we want a notion of proximity
            %em without
            Additivity, then Transitivity must become more complicated, being a
            %a.existingWikiWord{:href => "/nlab/show/extra+structure"} structure
            rather than just a property (and a structure that should be preserved by proximal maps).
          %p
            As for Additivity itself, this presumably corresponds to something more general in the world of profunctors related to
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          %p Symmetry probably doesn't fit into this picture very well, but who knows?
          %h2#related_concepts Related concepts
          %div
            %p
              %strong Generalized uniform structures
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/proarrow"} proarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk-complete
                    version
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/pro-object"}> pro
                    \-monad
                  %th symmetric versions
                  %th
                  %th
                  %th
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+relation"} binary relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasiuniformity"} quasiuniformity
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/equality"} equality
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/uniformity"} uniformity
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+function"} binary function
                    to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn ∞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} [0,\infty)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasipseudometric"} quasipseudometric
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasimetric"} quasimetric
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasiprometric"} quasiprometric
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+binary+function"} symmetric binary function
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/pseudometric"} pseudometric
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/metric"} metric
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/prometric"} prometric
