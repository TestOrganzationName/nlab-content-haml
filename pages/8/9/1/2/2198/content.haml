          %h2#idea Idea
          %p
            In addition to the well-known
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
            and
            = succeed "." do
              %em proximity spaces
            %a.existingWikiWord{:href => "/nlab/show/totally+bounded+space"} totally bounded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reflection"} reflection
          %p
            Proximity spaces are often called
            = succeed "," do
              %em nearness spaces
            = succeed ".)" do
              %a{:href => "http://ijmsa.yolasite.com/resources/43--newnew.pdf"} this article
            = succeed "." do
              %em set–set nearness space
            = succeed "," do
              %em apartness space
            %a.existingWikiWord{:href => "/nlab/show/apartness+space"} apartness space
            for a point–set version and
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            for a point–point version.)
          %h2#notation_and_terminology Notation and terminology
          %p
            A
            %strong proximity space
            is a kind of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/structured+set"} structured set
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the set of
            %strong
              %a.existingWikiWord{:href => "/nlab/show/points"} points
            of the space) and a
            %strong proximity structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/binary+relations"} binary relations
            between the
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %ul
            %li
              The
              %strong proximity relation
              or
              %strong nearness relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \delta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are
              %strong proximal
              or
              %strong near
              if
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi δ
                      %mspace{:width => "thickmathspace"}
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \;\delta\; B
            %li
              The
              %strong apartness relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋈
                    %annotation{:encoding => "application/x-tex"} \bowtie
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are
              %strong apart
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⋈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \bowtie B
            %li
              The
              %strong neighbourhood relation
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≪
                    %annotation{:encoding => "application/x-tex"} \ll
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong proximal neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ≪
                      %mi A
                    %annotation{:encoding => "application/x-tex"} B \ll A
          %p
            The conditions required of these relations are given below in the Definitions. (We say ‘proximal neighbourhood’ instead of simply ‘neighbourhood’ to avoid misapplying intuition from general topology. That
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≪
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \ll B
            doesn't necessarily mean that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq Int(B)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(A) \subseteq Int(B)
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⋈
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ≪
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \;\delta\; B \;\iff\; \neg(A \bowtie B) \;\iff\; \neg(A \ll B^{\mathsf{c}})
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mo ⋈
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ≪
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi c
                  %annotation{:encoding => "application/x-tex"} A \bowtie B \;\iff\; \neg(A \;\delta\; B) \;\iff\; A \ll B^{\mathsf{c}}
              ;
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mo ≪
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⋈
                    %msup
                      %mi B
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi c
                  %annotation{:encoding => "application/x-tex"} A \ll B \;\iff\; \neg(A \;\delta\; B^{\mathsf{c}}) \;\iff\; A \bowtie B^{\mathsf{c}}
              \.
          %p
            (Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            indicates
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of truth values, while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi c
                %annotation{:encoding => "application/x-tex"} B^{\mathsf{c}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in
            = succeed "," do
