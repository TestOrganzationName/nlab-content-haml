          %h2#a_proper_whitehead_theorem A proper Whitehead theorem
          %p There are several different types of generalisation of Whitehead’s theorem to the proper homotopy setting. The following is due to Ed Brown (1974):
          .un_thm
            %h6#theorem Theorem
            %p
              %strong (Brown, 1974)
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              be finite dimensional connected locally finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+complexes"} simplicial complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi K
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} f : K \to L
              is a proper homotopy equivalence if, and only if:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi e
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi e
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} e(f) : e(K)\to e(L)
                  is a homeomorphism;
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ,
                        %mo *
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi π
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_n(f) : \pi_n(K,*(0))\to \pi_n(L,f(*(0)))
                  is an isomorphism;
              %li
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} *
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %munder
                            %mi π
                            %mo ̲
                          %mi n
                          %mn ∞
                        %mo{:stretchy => "false"} (
