                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \underline{\pi}_n(X,*) = Ho(Proper)(\underline{S}^n, (X,*)).
          %h3#properties_2 Properties
          %ol
            %li
              %p
                As was pointed out above, the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %munder
                          %mi S
                          %mo ̲
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \underline{S}^n
                are cogroups so the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %munder
                          %mi π
                          %mo ̲
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \underline{\pi}_n(X,*)
                are groups, which are abelian for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n\geq 2
            %li
              %p
                In fact the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %munder
                          %mi π
                          %mo ̲
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \underline{\pi}_n(X,*)
                form a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mi 𝒜
                      %annotation{:encoding => "application/x-tex"} \Pi_\mathcal{A}
                %a.existingWikiWord{:href => "/nlab/show/spherical+object"} algebra
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
                as above. Not only are there the sort of morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \Pi_\mathcal{A}
                that will induce analogues of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Whitehead+products"} Whitehead products
                %a.existingWikiWord{:href => "/nlab/show/composition+operations"} composition operations
                etc. but there are other interesting morphisms there, for instance:
            %li
              %p
                There is a proper
                %strong shift map
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo :
                        %msup
                          %munder
                            %mi S
                            %mo ̲
                          %mi n
                        %mo →
                        %msup
                          %munder
                            %mi S
                            %mo ̲
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S: \underline{S}^n\to \underline{S}^n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %munder
                            %mi π
                            %mo ̲
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %munder
                            %mi π
                            %mo ̲
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo *
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^*(X): \underline{\pi}_n(X,*)\to \underline{\pi}_n(X,*)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %munder
                          %mi π
                          %mo ̲
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \underline{\pi}_n(X,*)
                has more structure than simply being a group.
          %h2#the_variant_at_the_end The variant ‘at the end’
          %h3#the_browngrossman_homotopy_groups_at_
            The Brown-Grossman homotopy groups at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
          .un_defn
            %h6#definition_3 Definition
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              %em
                Brown-Grossman homotopy group of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,*)
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
