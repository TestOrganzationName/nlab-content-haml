                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi H
                        %mo ̲
                    %annotation{:encoding => "application/x-tex"} \underline{H}
                be towers of finitely generated groups, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi G
