        #revision
          %p This entry is about a section of the text
          %ul
            %li
              Michel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Demazure%2C+lectures+on+p-divisible+groups"} Demazure, lectures on p-divisible groups
              %a{:href => "http://sites.google.com/site/mtnpdivisblegroupsworkshop/lecture-notes-on-p-divisible-groups"} web
          %p
            Let
            %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of prime characteristic
            = succeed "." do
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p\gt 0
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              (
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-divisible group)
            %dl
              %dt
                A commutative formal
                = succeed "-group" do
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is called
                %em
                  %a.existingWikiWord{:href => "/nlab/show/p-divisible+group"} p-divisible formal k-group
                or
                %em Barsotti-Tate group
                if it satisfies the following properties:
              %dd
                %p
                  (pdg1)
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ⋅
                        %msub
                          %mi id
                          %mi G
                        %mo →
                        %mi G
                      %annotation{:encoding => "application/x-tex"} p\cdot id_G\to G
                  is an epimorphism.
              %dd
                %p
                  (pdg2)
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is a
                  = succeed "-torsion" do
                    %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %msub
                          %mo ∪
                          %mi j
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mi j
                        %mo ⋅
                        %msub
                          %mi id
                          %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G=\cup_j ker(p^j \cdot id_G)
              %dd
                %p
                  (pdg3)
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ⋅
                        %msub
                          %mi id
                          %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ker(p\cdot id_G)
                  is finite.
            %p
              We have
              = succeed "," do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi rk
                      %mo{:stretchy => "false"} (
                      %mi ker
                      %mspace{:width => "thinmathspace"}
                      %mi p
                      %mo ⋅
                      %msub
                        %mi id
                        %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi p
                        %mi h
                    %annotation{:encoding => "application/x-tex"} rk(ker \,p \cdot id_G)=p^h
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} h\in \mathbb{N}
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is called the
              = succeed "." do
                %em
                  height
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ht
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ht(G)
                  of
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
          .num_rem
            %h6#definition_3 Definition
            %p
              (alternative definition of
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p Let
            .maruku-equation
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_17.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                    %msub
                      %mi G
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                    %msub
                      %mi G
                      %mn 3
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mn 3
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} G_1\stackrel{i_1}{\to}G_2\stackrel{i_2}{\to}G_3\stackrel{i_3}{\to}\cdots
            %p
              be a codirected diagram of
              %span.newWikiWord
                finite k-groups
                %a{:href => "/nlab/new/finite+k-group"} ?
              such that
            %ol
              %li
                %p
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi rk
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi G
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi p
                          %mrow
                            %mi h
                            %mi j
                      %annotation{:encoding => "application/x-tex"} rk(G_j)=p^{h j}
                  ,
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                      %annotation{:encoding => "application/x-tex"} h
                  a fixed integer,
              %li
                %p
                  all sequences
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mover
                          %mo →
                          %mrow
                        %msub
                          %mi G
                          %mi j
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi i
                              %mi j
                        %msub
                          %mi G
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mover
                          %mo →
                          %mrow
                            %msup
                              %mi p
                              %mi j
                        %msup
                          %mi G
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} 0\stackrel{}{\to}G_j\stackrel{i_j}{\to}G_{j+1}\stackrel{p^j}{\to}G^{j+1}
                  are exact.
            %p
              Then
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi colim
                      %mi n
                    %msub
                      %mi G
                      %mi n
                  %annotation{:encoding => "application/x-tex"} colim_n G_n
              is a
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              and
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
