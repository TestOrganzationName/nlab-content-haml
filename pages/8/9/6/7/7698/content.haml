                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ht
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ht(G^\prime)=ht(G)
              and we have
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi j
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_j^\prime=D(i_j)
              and
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi G
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %msup
                        %mo{:stretchy => "false"} )
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %mo ≃
                      %mi G
                    %annotation{:encoding => "application/x-tex"} (G^\prime)^\prime\simeq G
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              Let
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
              denote the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/p-adic+number"} ring of p-adic integers
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℚ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_p
              denote the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/p-adic+number"} field of p-adic numbers
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℚ
                      %mi p
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mi p
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Q}_p /\mathbb{Z}_p)_k
              is a
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
            %p
              Conversely any
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is isomorphic to
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℚ
                        %mi p
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi ℤ
                        %mi p
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mi k
                        %mi h
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Q}_p /\mathbb{Z}_p)^h_k
          .num_example
            %h6#example_2 Example
            %p
              Let
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a commutative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+group"} algebraic k-group
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %msub
                      %mi id
                      %mi G
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p id_G:A\to A
              is an epimorphism. Then
            %ol
              %li
                %p
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ⋅
                        %msub
                          %mi id
                          %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ker(p\cdot id_A)
                  is finite.
              %li
                %p
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo =
                        %msub
                          %mo ∪
                          %mi j
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mi j
                        %msub
                          %mi id
                          %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A(p):=\cup_j ker(p^j id_A)
                  is a
                  = succeed "-divisible" do
                    %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  = succeed "." do
                    %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ^
                            %mo ∘
                          %mo =
                          %msub
                            %mo ∪
                            %mi j
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi F
                            %mi j
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \hat A^\circ=\cup_j ker(F^j G)
              %li
                %p
                  If
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %msub
                          %mi μ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} A=\mu_k
                  we have
                  = succeed "." do
                    %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mo ∪
                            %mi j
                          %msup
                            %mi p
                            %mi j
                          %msub
                            %mi μ
                            %mi k
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi ℚ
                            %mi p
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi ℤ
                            %mi p
                          %msubsup
                            %mo{:stretchy => "false"} )
                            %mi k
                            %mstyle{:scriptlevel => "0"}
                              %mo ′
                        %annotation{:encoding => "application/x-tex"} A(p)=\cup_j p^j \mu_k=(\mathbb{Q}_p /\mathbb{Z}_p)^\prime_k
              %li
                %p
                  If
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is an abelian variety of dimension
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %msub
                          %mi id
                          %mi A
