                      %msup
                        %mi p
                        %mi n
                      %msub
                        %mi id
                        %mi G
                      %mo :
                      %mi G
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi G
                        %mi n
                    %annotation{:encoding => "application/x-tex"} ker(p^n id_G:G\to G)\simeq G_n
          .num_remark
            %h6#remark Remark
            %p
              If
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a p-divisible group in the sense of the first definition, from (pdg1) follows
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi rk
                      %mo{:stretchy => "false"} (
                      %mi ker
                      %msup
                        %mi p
                        %mi j
                      %mo ⋅
                      %msub
                        %mi id
                        %mi G
                      %mo{:stretchy => "false"} )
                      %mn 0
                      %msup
                        %mi p
                        %mrow
                          %mi j
                          %mo ⋅
                          %mi ht
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} rk(ker p^j \cdot id_G)0p^{j\cdot ht (G)}
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi rk
                  %annotation{:encoding => "application/x-tex"} rk
              is multiplicative
            .maruku-equation
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_28.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ker
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi p
                      %mi j
                    %mo ↪
                    %mi ker
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi p
                      %mrow
                        %mi j
                        %mo +
                        %mi k
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi p
                          %mi j
                    %mi ker
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi p
                      %mi k
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0\to ker \,p^j\hookrightarrow ker \,p^{j+k}\stackrel{p^j}{\to}ker\, p^k\to 0
            %p is exact.
          .num_defn
            %h6#definition_4 Definition
            %p
              (
              %span.newWikiWord
                Serre dual
                %a{:href => "/nlab/new/Serre+dual"} ?
              of a
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Let
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %em Serre dual
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} G^\prime
              of
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is defined by: let
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi j
                    %mo :
                    %mo =
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mi j
                    %msub
                      %mi id
                      %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_j:=ker(p^j id_G)
              and let
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi j
                    %mo :
                    %msub
                      %mi G
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo →
                    %msub
                      %mi G
                      %mi j
                  %annotation{:encoding => "application/x-tex"} p_j:G_{j+1}\to G_j
              is the map induced by
              = succeed "." do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mi id
                        %mi G
                    %annotation{:encoding => "application/x-tex"} p id_G
            .maruku-equation
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_38.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi G
                      %mi j
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo :
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_j^\prime:=D(G_j)
            .maruku-equation
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_39.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi i
                      %mi j
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo :
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi G
                      %mi j
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo →
                    %msubsup
                      %mi G
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} i_j^\prime:=D(p_j):G^\prime_j\to G^\prime_{j+1}
            .maruku-equation
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo :
                    %mo =
                    %msub
                      %mi colim
                      %mrow
                        %msup
                          %mi j
                          %mstyle{:scriptlevel => "0"}
                            %mo ′
                    %msubsup
                      %mi G
                      %mi j
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} G^\prime:=colim_{j^\prime}G_j^\prime
            %p
              This is a
              = succeed "-divisible" do
                %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math#mathml_08c4a89b28d2c6f55d44ff91cd0cc906cb906bf5_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ht
                    %mo{:stretchy => "false"} (
                    %msup
