                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi ℤ
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi ℝ
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi ⋮
                      %mo ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo →
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ⋮
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi ℤ
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi ⋮
                      %mo ]
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (
                  \\mathbf{B}^n\mathbb{R}
                  \\to
                  \\mathbf{B}^n \mathbb{R}//\mathbb{Z}
                  \\to
                  \\mathbf{B}^{n+1} \mathbb{Z}
                  )
                  \\;\;\;
                  \=
                  \\;\;\;
                  U \Xi
                  \\left(
                  \\left[
                  \\array{
                  \\vdots
                  \\\
                  \\downarrow
                  \\\
                  0
                  \\\
                  \\downarrow
                  \\\
                  \\mathbb{R}
                  \\\
                  \\downarrow
                  \\\
                  \\vdots
                  }
                  \\right]
                  \\;\;\;
                  \\to
                  \\;\;\;
                  \\left[
                  \\array{
                  \\vdots
                  \\\
                  \\downarrow
                  \\\
                  \\mathbb{Z}
                  \\\
                  \\downarrow
                  \\\
                  \\mathbb{R}
                  \\\
                  \\downarrow
                  \\\
                  \\vdots
                  }
                  \\right]
                  \\;\;\;
                  \\to
                  \\;\;\;
                  \\left[
                  \\array{
                  \\vdots
                  \\\
                  \\downarrow
                  \\\
                  \\mathbb{Z}
                  \\\
                  \\downarrow
                  \\\
                  0
                  \\\
                  \\downarrow
                  \\\
                  \\vdots
                  }
                  \\right]
                  \\right)
                  \\,.
          %p
            Written this way the second morphism is evidently a degreewise surjection, hence is a fibration in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            of the second, which clearly it is.
          %p
            From this fiber sequence we obtain long exact sequences in cohomology, for instance in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an abelian group let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,A) := \pi_0 \infty Grpd( \Pi(X), \mathbf{B}^n A)
          %p
            be its cohomology with coefficients in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            which we may
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} present
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            is the singular simplicial complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mi X
                %annotation{:encoding => "application/x-tex"} Sing X
            and we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mi sSet
                  %mo{:stretchy => "false"} (
                  %mi Sing
                  %mi X
                  %mo ,
                  %mi U
                  %mi Ξ
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,A) = \pi_0 sSet(Sing X, U \Xi A[n])
                  \\,.
          %p
            Then, as discussed
            = succeed "," do
              %a{:href => "LongSequCoh"} above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℤ
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℝ
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi ℤ
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  \\mathbf{B}^{n-1} \mathbb{R}/\mathbb{Z}
                  \\to
                  \\mathbf{B}^n \mathbb{Z}
                  \\to
                  \\mathbf{B}^n \mathbb{R}
                  \\to
                  \\mathbf{B}^n \mathbb{R}/\mathbb{Z}
                  \\to
                  \\mathbf{B}^{n+1} \mathbb{Z}
                  \\to
                  \\cdots
            yields the long exact sequence in cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  H^{n-1}(X,\mathbb{R}/\mathbb{Z})
                  \\to H^n(X,\mathbb{Z}) \to H^n(X,\mathbb{R}) \to
                  H^n(X,\mathbb{R}/\mathbb{Z})
                  \\to
                  H^{n+1}(X,\mathbb{Z})
                  \\to
                  \\cdots
                  \\,.
          %p
            In applications it often happens that one has a situation where the
            %em real
            cohomology is trivial, i.e
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} H^n(X,\mathbb{R}) = 0
            in some degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to H^n(X,\mathbb{Z})
                  \\to 0 \to
                  H^n(X,\mathbb{R}/\mathbb{Z})
                  \\to
                  H^{n+1}(\mathbb{Z})
                  \\to
                  0
                  \\to
                  \\cdots
          %p
            implies that in this case we have an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^n(X,\mathbb{R}/\mathbb{Z})
                  \\stackrel{\simeq}{\to}
                  H^{n+1}(\mathbb{Z})
                  \\,.
          %h3#MayerVietoris Mayer-Vietoris sequences
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
            is a fiber sequence obtained from an
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
          %p if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                          %msub
                            %mo ×
                            %mi C
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A \times_C B &amp;\to&amp; B
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{g}}
                  \\\
                  A &amp;\stackrel{f}{\to}&amp; C
                  }
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} infinity-pullback
            diagram in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi C
                  %mo →
                  %mi A
                  %msub
                    %mo ×
                    %mi C
                  %mi B
                  %mo →
                  %mi A
                  %mo ×
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega C \to A \times_C B \to A \times B
                  \\,.
          %p
            This – or its associated
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
            – is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
            of the pullback. See there for details.
          %h4#of_a_cover Of a cover
          %p
            The original example of Mayer-Vietoris sequences is obtained from the situtation where a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi U
                          %mo ∩
                          %mi V
                        %mtd
                          %mo ↪
                        %mtd
                          %mi U
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  U \cap V &amp;\hookrightarrow&amp; U
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  V &amp;\to&amp; X
                  }
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is given (which modeled in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            or in terms of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            may be modeled by an ordinary pushout), and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} A \in \infty Grpd
            is some coefficient group object. Then applying the
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi op
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(-, A) : \mathbf{H}^{op} \to \infty Grpd
            yields the
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ∩
                          %mi V
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}(X, A) &amp;\to&amp; \mathbf{H}(U,A)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{H}(V,A) &amp;\to&amp; \mathbf{H}(U \cap V, A)
                  }
                  \\,.
          %p By the above this is equivalent to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ∩
                  %mi V
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X,A) \to \mathbf{H}(U,A) \times \mathbf{H}(V,A)
                  \\to \mathbf{H}(U \cap V, A)
          %p
            being a fibration sequence. The corresponding long exact sequence in cohomology (as discussed above) is what is traditionally called the Mayer-Vietoris sequence of the cover of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            in
            = succeed "-cohomology." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber"}> fiber
                ,
                %a.existingWikiWord{:href => "/nlab/show/essential+fiber"} essential fiber
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tower+of+homotopy+fibers"} tower of homotopy fibers
            %li
              %p
                %a{:href => "triangulated+category#LongExactSequences"} triangulated category – long fiber-cofiber sequences
          %h2#references References
          %p
            The observation of
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+of+homotopy+groups"} long exact sequences of homotopy groups
            for homotopy fiber sequences originates (according to
            = succeed ")" do
              %a{:href => "#Switzer75"} Switzer 75, p. 35
          %ul
            %li
              M. G. Barratt,
              = succeed "." do
                %em Track groups I, II
          %p The first exhaustive study of these is due to
          %ul
            %li#Puppe58
              %a.existingWikiWord{:href => "/nlab/show/Dieter+Puppe"}> Dieter Puppe
              ,
              = succeed "," do
                %em Homotopiemengen und ihre induzierten Abbildungen I
          %p
            whence the terminology
            = succeed "." do
              %em Puppe sequences
          %p Classical textbook accounts include
          %ul
            %li#Switzer75
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Switzer"}> Robert Switzer
                , around 2.57 of
                = succeed "," do
                  %em Algebraic Topology - Homotopy and Homology
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , prop. 3.2.6 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
          %p Lecture notes:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"} Akhil Mathew
                %em Spectra and stable homotopy theory
                (2012) &amp;lbrack;
                %a{:href => "http://math.uchicago.edu/~amathew/256y.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/HopkinsMathewStableHomotopyTheory.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cary+Malkiewich"}> Cary Malkiewich
                \:
                %em Fibration Sequences and Pullback Squares
                (2021) &amp;lbrack;
                %a{:href => "https://people.math.binghamton.edu/malkiewich//fibration_sequences.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Malkiewich-FibrationSequences.pdf", :title => "pdf"} pdf
          %p
            The construction in the axiomatic homotopy theory of
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            is due to
          %ul
            %li#Quillen67
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , chapter I.3 of
              %em Axiomatic homotopy theory
              in
              = succeed "," do
                %em Homotopical algebra
          %p
            and in the context of
            %a.existingWikiWord{:href => "/nlab/show/categories+of+fibrant+objects"} categories of fibrant objects
            due to
          %ul
            %li#Brown73
              %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
              , section 4 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract Homotopy Theory and Generalized sheaf Cohomology
          %p
            A discussion of fiber sequences in terms of
            %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundles"} associated ∞-bundles
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Wendt"}> Matthias Wendt
              ,
              %em Classifying spaces and fibrations of simplicial sheaves
              (
              %a{:href => "http://arxiv.org/abs/1009.2930"}> arXiv
              )
          %p
            Related discussion on the behaviour of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization of model categories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Wendt"}> Matthias Wendt
              ,
              = succeed "," do
                %em Fibre sequences and localization of simplicial sheaves
              %p
                Alg. Geom. Topol. 13(3), 2013, pp. 1779–1813. (
                %a{:href => "http://home.mathematik.uni-freiburg.de/arithmetische-geometrie/preprints/wendt-flocal.pdf"} preprint pdf
                and
                = succeed ".)" do
                  %a{:href => "http://arxiv.org/abs/1011.4784"} ArXiv
          %p On the action of the loop space of the base space on the fiber
          %ul
            %li#Brown59
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edgar+Brown"}> Edgar Brown
                \.
                = succeed "." do
                  %em Twisted Tensor Products, I
                = succeed ")." do
                  %a{:href => "https://doi.org/10.2307/1970101"} doi
            %li#EckHil60
              %p
                %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"} Beno Eckmann
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
                = succeed "." do
                  %em Operators and cooperators in homotopy theory
                = succeed ")." do
                  %a{:href => "https://doi.org/10.1007/BF01367447"} doi
            %li#Heath73
              %p
                Philip R. Heath.
                = succeed "." do
                  %em Groupoid operations and fibre-homotopy equivalence. I
                = succeed ")." do
                  %a{:href => "https://doi.org/10.1007/BF01246620"} doi
