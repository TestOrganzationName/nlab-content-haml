          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                          %mo ≃
                          %mi Ω
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mo →
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
