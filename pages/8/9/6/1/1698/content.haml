            is their
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            group, the circle group or
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
