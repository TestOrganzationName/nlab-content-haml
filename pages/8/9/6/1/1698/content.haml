                              %mi X
                              %mn 2
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi Fib
                              %mi ϕ
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
