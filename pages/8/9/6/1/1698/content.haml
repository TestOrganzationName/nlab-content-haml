                        %mtd
                          %mover
                            %mo →
                            %mi ρ
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mi Grpd
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V&amp;\to&amp; V//G &amp;\to&amp; Z
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; \mathbf{B}G &amp;\stackrel{\rho}{\to}&amp; (\infty,1)Grpd
                  }
                  \\,.
          %p
            The resulting total
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Z \to (\infty,1)Cat
            over the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            itself, as indicated.
          %p
            Notice that every fibration sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
