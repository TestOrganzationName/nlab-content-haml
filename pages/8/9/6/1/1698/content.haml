                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    fib(f_1) &amp;\longrightarrow&amp; X_1 &amp;\underoverset{\in Fib}{f_1}{\longrightarrow}&amp; Y_1
                    \\\
                    \\downarrow^{\mathrlap{}} &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
