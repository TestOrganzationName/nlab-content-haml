                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  \\mathbf{B}^{n-1} \mathbb{R}/\mathbb{Z}
                  \\to
                  \\mathbf{B}^n \mathbb{Z}
                  \\to
                  \\mathbf{B}^n \mathbb{R}
                  \\to
                  \\mathbf{B}^n \mathbb{R}/\mathbb{Z}
                  \\to
                  \\mathbf{B}^{n+1} \mathbb{Z}
                  \\to
                  \\cdots
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
