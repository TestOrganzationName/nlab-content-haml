                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo →
                      %msup
                        %mi f
                        %mo *
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_1 \to f^\ast X_2
            %p Hence, it is now sufficient to observe that in category of fibrant objects, base change preserves weak equivalences (…).
          %p Hence, we say:
          #HomotopyFiber.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              any morphism, its
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    hofib(f)\longrightarrow X
            %p
              is the morphism in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of any
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %p
            We may now state the abstract version of the statement of prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#SerreFibrationGivesExactSequenceOfHomotopyGroups"}
          #ExactSequenceOfHomotopyFiberAtOneStage.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              any morphism of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              = succeed "," do
                %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi hofib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    [A,hofib(f)]_\ast \overset{i_\ast}{\longrightarrow} [A,X]_\ast \overset{f_\ast}{\longrightarrow} [A,Y]_{\ast}
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              (the sequence being the image of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              sequence of def.
              %a.maruku-ref{:href => "#HomotopyFiber"}
              under the hom-functor of the pointed
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Set
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [A,-]_\ast \;\colon\; Ho(\mathcal{C}^{/\ast}) \longrightarrow Set^{\ast/}
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              We may choose representatives such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is cofibrant, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a fibration. Then we are faced with an ordinary pullback diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi hofib
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    hofib(f) &amp;\overset{i}{\longrightarrow}&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\ast &amp;\longrightarrow&amp; Y
                    }
            %p
              and the hom-classes are represented by genuine morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(p_\ast)
              includes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(i_\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(p_\ast)
              indeed comes from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(i_\ast)
            %p
              But an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(p_\ast)
              is represented by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha \colon A \to X
              such that there is a left homotopy as in the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi α
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi η
                                %mo{:stretchy => "false"} ˜
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                          %mtd
                            %mi Cyl
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A &amp;\overset{\alpha}{\longrightarrow}&amp; X
                    \\\
                    \&amp;&amp; {}^{\mathllap{i_0}}\downarrow &amp;{}^{\tilde \eta}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    A &amp;\overset{i_1}{\longrightarrow} &amp; Cyl(A) &amp;\overset{\eta}{\longrightarrow}&amp; Y
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    \\ast &amp;&amp; \longrightarrow &amp;&amp; Y
                    }
                    \\,.
            %p
              Now by lemma
              %a.maruku-ref{:href => "#ComponentMapsOfCylinderAndPathSpaceInGoodSituation"}
              the square here has a lift
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo ∘
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} i_1 \circ\tilde \eta
              is left homotopic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mo ∘
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} i_1 \circ \tilde \eta
              factors through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} i \colon hofib(f) \to X
          %h3#in_homotopy_type_theory In homotopy type theory
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            the homotopy fiber of a function term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f : A \to B
            over a function term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pt
                    %mi B
                  %mo :
                  %mo *
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} pt_B : * \to B
            is the type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi pt
                    %mi B
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{a : A} (f(a) = pt_B)
                  \\,,
          %p
            hence the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of the
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pt
                    %mi B
                %annotation{:encoding => "application/x-tex"} pt_B
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/substitution"} substituted
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          %p
            For the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            code see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Voevodsky"}> Vladimir Voevodsky
              ,
              %em
                %a{:href => "https://github.com/vladimirias/Foundations/blob/master/Generalities/uu0.v"} Foundations/Generalities/uuo.v
          %p
            See also at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+type"} fiber type
          %h2#long_fibration_sequences Long fibration sequences
          %p
            A crucial difference between
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %em long
            \: in contrast to the ordinary kernel of a kernel, which is necessarily trivial, the homotopy kernel of a homotopy kernel is typically far from trivial, but is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
          %h3#kernel_of_a_kernel_loop_objects Kernel of a kernel: loop objects
          %p
            In particular the homotopy fiber of the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} {*} \to B
            is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (by definition):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ω
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega B &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\stackrel{}{\to}&amp; B
                  }
                  \\,.
          %p
            Notice that the ordinary 1-categorical
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of a point to itself is necessarily just the point again. Much of what makes
            = succeed "-theory" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "." do
              %strong the kernel of the kernel is in general nontrivial
          %p
            Namely the homotopy kernel of the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} ker(f) \to A
            constructed above is by definition the homotopy limit in the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  ker(ker(f)) &amp;\to&amp; ker(f)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to &amp; A
                  }
          %p
            This is the same kind of diagram as before, just depicted after taking its mirror image along a diagonal. The point of drawing it this way is that this suggests to form the pasting diagram with the one that defines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ker(f)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  ker(ker(f)) &amp;\to&amp; ker(f) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; A &amp;\stackrel{f}{\to}&amp; B
                  }
                  \\,.
          %p
            Since the
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#PushoutPasting"} satisfies the pasting law
            just as ordinary
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            diagrams do, it follows that the total outer square obtained this way is itself a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega B
            this means that the kernel of the kernel is loops:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Ω
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ker(ker(f)) \simeq \Omega B
                  \\,.
          %p I.e. all three squares in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Ω
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mi ker
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega B &amp;\to&amp; ker(f) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                  \\\
                  {*} &amp;\to&amp; A &amp;\stackrel{f}{\to}&amp; B
                  }
          %p are (homotopy) pullback squares.
          %h3#ContinuingToLongFiberSequences Long fibration sequences
          %p
            Continuing this way to the left with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %mi Ω
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Ω
                  %mi A
                  %mover
                    %mo ⟶
                    %mrow
                      %mi Ω
                      %mi f
                  %mi Ω
                  %mi B
                  %mo ⟶
                  %mi ker
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mi g
                  %mi A
                  %mover
                    %mo ⟶
                    %mi f
                  %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  \\Omega ker(f)
                  \\longrightarrow
                  \\Omega A
                  \\stackrel{\Omega f}{\longrightarrow}
                  \\Omega B
                  \\longrightarrow
                  ker(f)
                  \\stackrel{g}{\longrightarrow}
                  A
                  \\stackrel{f}{\longrightarrow} B
                  \\,.
          %p
            A subtlety to be aware of here is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Omega B
            is not quite
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(ker(f))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Ω
                      %mo{:stretchy => "false"} ¯
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \bar \Omega f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Ω
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar \Omega
            denotes loops with reversed orientation.
          %p
            A classical discussion of this in terms of computing homotopy fibers via
            %a.existingWikiWord{:href => "/nlab/show/path+object"} path object
            fibrant replacements is e.g. in (
            %a{:href => "#Switzer75"}> Switzer 75, around 2.57
            ). But let’s see it just diagrammatically:
          %p
            First observe that it is indeed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi f
                %annotation{:encoding => "application/x-tex"} \Omega f
            and not
