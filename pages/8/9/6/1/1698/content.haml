            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo =
                  %msup
                    %mi S
                    %mn 1
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
