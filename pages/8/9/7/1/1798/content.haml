          %h2#idea Idea
          %p
            A
            %em matching family
            of elements is an explicit component-wise characterizaton of a morphism from a
            %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
            into a general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
          %p
            Since such morphisms govern the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            property and the operation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
            %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            and
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            is the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\tau)
            be a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %msup
                    %mi C
                    %mi{:mathvariant => "normal"} op
                  %mo →
                  %mi{:mathvariant => "normal"} Set
                %annotation{:encoding => "application/x-tex"} P:C^{\mathrm{op}}\to\mathrm{Set}
            a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ∈
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S\in \tau(c)
            be a
            = succeed "ing" do
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
            on
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c\in C
            (in particular a subobject of the
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            presheaf
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi c
                  %annotation{:encoding => "application/x-tex"} h_c
          %p
            A
            %strong matching family
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a rule assigning to each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi d
                  %mo →
                  %mi c
                %annotation{:encoding => "application/x-tex"} f:d\to c
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi f
                %annotation{:encoding => "application/x-tex"} x_f
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(d)
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi e
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} g:e\to d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %mi f
                      %mo ∘
                      %mi g
                  %mo .
                %annotation{:encoding => "application/x-tex"} P(g)(x_f) = x_{f\circ g}.
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} f\circ g\in S
            because
