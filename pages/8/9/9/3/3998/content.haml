                  %mi θ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \cos(n\theta)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mi θ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sin(n\theta)
            as functions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \sin\theta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cos
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \cos\theta
            and then supposed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is infinitely large and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mi θ
                %annotation{:encoding => "application/x-tex"} n\theta
            is finite. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \sin\theta
            becomes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cos
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \cos\theta
            becomes 1.
          %p
            If one does with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi k
                  %annotation{:encoding => "application/x-tex"} f_k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \ge 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f_0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in this sequence are the functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi n
                %annotation{:encoding => "application/x-tex"} J_n
            that appear in Cartwright’s proof of the irrationality of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
            %a{:href => "http://en.wikipedia.org/wiki/Proof_that_%CF%80_is_irrational"} Wikipedia’s article
            on the proof of the irrationality of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
          %h2#the_main_question The main question
          %p
            Could a proof of the irrationality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            using only finitary trigonometric identities be lurking somewhere in all this? (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                      %mo {
                      %msub
                        %mi f
                        %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi θ
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi θ
                        %mi ℓ
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mrow
                      %mi k
                      %mo ,
                      %mi ℓ
                %annotation{:encoding => "application/x-tex"} \left\{f_k(\theta_1,\dots,\theta_\ell)\right\}_{k,\ell}
            is a doubly indexed sequence each term of which is the a sum of finitely many products of finitely many factors.)
