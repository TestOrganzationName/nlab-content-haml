          %h4#CircleAndOddLine The circle and the odd line
          %p
            Consider as before the categorical
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            as the corresponding
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          .num_prop
            %h6#proposition_11 Proposition
            %p We have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ⊕
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(S^1) \simeq (k \oplus k[-1])
                    \\,,
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              with the odd generator in degree 1 and trivial differential.
          .proof
            %h6#proof_11 Proof
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              over itself (as described there) of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              constant on the point. This
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              is preserved by the left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi LConst
                      %mo :
                      %mn ∞
                      %mi Grpd
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} LConst : \infty Grpd \to \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \simeq {\lim_{\to}}_{S^1} *
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                    %annotation{:encoding => "application/x-tex"} \mathcal{H}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              is also left adjoint, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(S^1) \simeq {\lim_{\leftarrow}}_{S^1} \mathcal{O}(*)
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi cdgAlg
                        %mi k
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} cdgAlg_k^\circ
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              as the left
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              of the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi cdgAlg
                      %mi k
                      %mo −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi cdgAlg
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (cdgAlg_k^-)^{op} \hookrightarrow (cdgAlg_k)^{op}
              that this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo ←
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq {\lim_{\leftarrow}}_{S^1} k
                    \\,.
            %p
              This is the formula for the
              = succeed "-power" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              by by
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              = succeed "," do
                %a{:href => "#PoweringAndCopoweringIndgContext"} above fact
              = succeed "-groupoid," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/differential+forms+on+simplices"} differential forms on simplices
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq \Omega^\bullet_{poly}(S^1)
                    \\,.
            %p
              By a central theorem of
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              (recalled at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/differential+forms+on+simplices"} differential forms on simplices
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cochains
              on the circle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq C^\bullet(S^1, k)
                    \\,.
            %p
              But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ≃
                    %mi ℬ
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} S^1 \simeq \mathcal{B}\mathbb{Z}
              is a
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of a Lie algebra, so that this is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formal+dg-algebra"} formal dg-algebra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of characteristic 0 this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi k
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi k
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 1
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n(S^1, k) =
                    \\left\{
                    \\array{
                    k &amp; for\; n = 0
                    \\\
                    k &amp; for \; n = 1
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %mi k
                    %mo ⊕
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq k \oplus k[-1]
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec \mathcal{O}(S^1)
              is no longer the circle itself, but the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/odd+line"} odd line
              = succeed "-grading." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %p
              This point is amplified in (
              %a{:href => "#Ben-ZviNadler"}> Ben-ZivNadler
              ).
          %h4#the_cotangent_complex_as_functions_on_the_derived_loop_space The cotangent complex as functions on the derived loop space
          .num_cor
            %h6#corollary_2 Corollary
            %p We have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi Spec
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi U
                    %mo ↦
                    %msub
                      %mi cdgAlg
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [S^1, Spec A] : U \mapsto cdgAlg_k(A, \mathcal{O}(U) \oplus \mathcal{O}(U)[-1])
                    \\,.
          .proof
            %h6#proof_12 Proof
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mi Spec
                            %mi A
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
