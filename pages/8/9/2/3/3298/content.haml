                    \\end{aligned}
                    \\,.
          %p (…)
          %h2#properties_2 Properties
          %h3#AlgebraStrucOnHochschild
            Algebra structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (HH^\bullet(A,A), HH_\bullet(A,A))
          %p There is rich algebraic structure on Hochschild homology and cohomology itself, and on the pairing of the to. We describe various aspects of this.
          %h4#DifferentialCalculus Differential calculus
          %p It turns out that
          %ul
            %li
              %p
                Hochschild homology of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(X)
                encodes
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                Hochschild cohomology of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}(X)
                encodes
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/multivector+field"} multivector field
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                there are natural pairings between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi HH
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH_\bullet(\mathcal{O}(X), \mathcal{O}(X))
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi HH
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH^\bullet(\mathcal{O}(X), \mathcal{O}(X))
                that mimic the structure of the natural pairings between vector fields and differential forms on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          %p
            See (
            %a{:href => "#TamarkinTsygan"}> Tamarkin-Tsygan
            ) and see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Kontsevich+formality"} Kontsevich formality
            for more. This equivalence enters the construction of
            %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifolds"} Poisson manifolds
          %p
            One way to understand or interpret this conceptually is to regard the
            %a.existingWikiWord{:href => "/nlab/show/derived+loop+space"} derived loop space
            object of a 0-
            %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to consist of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
            loops in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h5#HochschildKostantRosenberg Hochschild-Kostant-Rosenberg theorem
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Hochschild-Kostant-Rosenberg+theorem"} Hochschild-Kostant-Rosenberg theorem
            states that under suitable conditions, the Hochschild homology of an algebra (with coefficients in itself) computes the wedge powers of its
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential"} Kähler differential
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a{:href => "#Kaehler1Forms"} identification
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi HH
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  HH_1(A,A) \simeq \Omega^1(A)
          %p
            of the first Hochschild homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with coefficients in itself and degree-1
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Write
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi R
                    %mo ≃
                    %msub
                      %mi HH
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^0(R/k) \coloneqq R \simeq HH_0(R,R)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mo ∧
                    %mi R
                    %mi n
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n(R/k) = \wedge^n_R \Omega(R/k)
            for the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} wedge product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(R/k)
            with itself: the degree
            = succeed "-K\u00E4hler-differentials." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .num_theorem
            %h6#theorem Theorem
            %p
              The isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1(R/k) \simeq H_1(R,R)
              extends to a graded ring morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi \colon \Omega^\bullet(R/k) \to H_\bullet(R,R)
                    \\,.
          %p
            If the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is sufficiently well-behaved, then this morphism is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            that identifies the Hochschild homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n(R/k)
            for all
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Hochschild-Kostant-Rosenberg theorem)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a commutative
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
              which is
            %ul
              %li
                %p essentially of finite type
              %li
                %p
                  smooth over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %p
              then there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of graded
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi HH
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi : \Omega^\bullet(R/k) \stackrel{\simeq}{\to}
                    HH_\bullet(R,R)
                    \\,.
            %p Moreover, dually, there is an isomorphism of Hochschild cohomology with wedge products of derivations:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∧
                      %mi R
                      %mo •
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi HH
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet_R Der(R,R) \simeq HH^\bullet(R,R)
          %p
            This is reviewed for instance as (
            %a{:href => "#Weibel"}> Weibel, theorem 9.4.7
            ) or as (
            %a{:href => "#Ginzburg"}> Ginzburg, theorem 9.1.3
            ).
          %h4#EnAlgebraStructure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_n
            \-algebra structure: Deligne-Kontsevich conjecture/theorem
          %p
            The next statement is known as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Deligne+conjecture"} Deligne conjecture
          #DeligneConjectureViaDerivedMappingSpaces.num_prop
            %h6#proposition_12 Proposition
            %p
              The
              %a{:href => "PirashviliHigherOrder"} higher order Hochschild homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi S
                          %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} (X^{S^d})
              of an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi d
                  %annotation{:encoding => "application/x-tex"} S^d
              and with coefficients in a
              %a.existingWikiWord{:href => "/nlab/show/integral+transforms+on+sheaves"} geometric function object
              is naturally an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Ek-Algebras"} E(d+1)-algebra)
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              over the
              %a.existingWikiWord{:href => "/nlab/show/little+k-cubes+operad"} little k-cubes operad
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi d
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = d+1
              \.
            %p
              For let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                    %mo =
                    %msup
                      %mi D
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                    %mo ∖
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi r
                    %msup
                      %mi D
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma^{d+1} = D^{d+1}\setminus \coprod_r D^{d+1}
              be the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (d+1)
              %a.existingWikiWord{:href => "/nlab/show/ball"} ball
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              small
              = succeed "-balls" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} d+1
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              of boundary inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi Σ
                              %mrow
                                %mi d
                                %mo +
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi r
                            %msup
                              %mi S
                              %mi d
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \Sigma^{d+1}
                    \\\
                    \&amp; \nearrow &amp;&amp; \nwarrow
                    \\\
                    \\coprod_r S^d  &amp;&amp;&amp;&amp; S^d
                    }
            %p
              in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              and under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} LConst : \infty Grpd \to \mathbf{H}
              then also in our
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %p
              Applying the
              %a{:href => "http://ncatlab.org/nlab/show/(infinity,1)-topos#ClosedMonoidalStructure"} (∞,1)-topos internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-,X]
              or equivalent the
              %a{:href => "http://ncatlab.org/nlab/show/limit+in+a+quasi-category#Tensoring"} (∞,1)-powering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{(-)}
              into a given object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              to this
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              produces the
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %msup
                                  %mi Σ
                                  %mrow
                                    %mi d
                                    %mo +
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi r
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi o
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi r
                            %msup
                              %mi X
                              %mrow
                                %msup
                                  %mi S
                                  %mi d
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %msup
                                  %mi S
                                  %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X^{\Sigma^{d+1}}
                    \\\
                    \&amp; {}^{\mathllap{i_r}}\swarrow &amp;&amp; \searrow^{\mathrlap{o}}
                    \\\
                    \\prod_r X^{S^d} &amp;&amp;&amp;&amp; X^{S^d}
                    }
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/integral+transforms+on+sheaves"} integral transforms on sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi o
                      %mn 1
                    %msubsup
                      %mi i
                      %mi r
                      %mo *
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi r
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi S
                          %mi d
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi X
                      %mi d
                  %annotation{:encoding => "application/x-tex"}
                    o_1 i_r^* : \prod_r \mathbf{H}/X^{S^d} \to \mathbf{H}/X^{d}
            %p
              induced by these spans constitute the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %msup
                            %mi S
                            %mi d
                    %annotation{:encoding => "application/x-tex"} X^{S^d}
          %p
            This was observed in (
            %a{:href => "#Ben-ZviFrancisNadler"}> Ben-ZviFrancisNadler, corollary 6.8
            ).
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d = 1
            %a.existingWikiWord{:href => "/nlab/show/HKR+theorem"} HKR theorem
            above (when it applies), the Gerstenhaber bracket is identified with the
            %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
            (
            %a{:href => "https://arxiv.org/abs/math/9904132v1"}> Tsyagin, theorem 2.2.2
            )
          .num_remark
            %h6#remark_8 Remark
            %p
              %strong (Deligne conjecture)
            %p
              Some historical comments on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Deligne+conjecture"} Deligne conjecture
            %p
              Historically it was first found that there is the structure of a
              %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+algebra"} Gerstenhaber algebra
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi HH
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH^\bullet(A,A)
              = succeed ")" do
                %a{:href => "#Cohen"} Cohen
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/E2-algebra"} E2-algebra
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi HH
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HH^\bullet(A,A)
              lifts to an
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/E2-algebra"} E2-algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\bullet(A,A)
            %p
              In
              %a{:href => "#GerstenhaberVoronov"} GerstenhaberVoronov (1994)
              a resolution of the Gerstenhaber algebra structure was given, but the relationship to
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
            %p
              In (
              %a{:href => "#Tamarkin"}> Tamarkin (1998)
              ) a genuine resolution in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
              of the Gerstenhaber operad was given and shown to act via the Gerstenhaber-Voronov construction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\bullet(A,A)
            %p
              Various authors later further refined this result. A summary of this history can be found in (
              %a{:href => "#Hess"}> Hess
              ).
            %p
              In
              %a{:href => "#HuKrizVoronov"} Hu-Kriz-Voronov (2003)
              it was further shown that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/En-algebra"} En-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet(A,A)
              is an
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} E_{n+1}
            %p Notice that the identification of Hochschild (co)homology as coming from higher order free loop spaces makes all this structure manifest.
          %h4#StringTopology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HH
                %annotation{:encoding => "application/x-tex"} HH
            of constant
            = succeed "-stacks:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be the
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
            of ordinary
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-algebraic+theory"} (∞,1)-algebraic theory
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msubsup
                      %mi Alg
                      %mn ∞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} T Alg_\infty^{op}
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            of the
            %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            and the
            = succeed "-equivalence" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %munder
                      %mo ⟶
                      %mi Γ
                    %mover
                      %mo ⟵
                      %mi LConst
                  %mn ∞
                  %mi Grpd
                  %mover
                    %munder
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                    %mover
                      %mo ⟵
                      %mi Π
                  %mi Top
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H} \stackrel{\overset{LConst}{\longleftarrow}}{\underset{\Gamma}{\longrightarrow}}
                  \\infty Grpd
                  \\stackrel{\overset{\Pi}{\longleftarrow}}{\underset{|-|}{\longrightarrow}}
                  Top
          %p
            we may regard every
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a
            %a.existingWikiWord{:href => "/nlab/show/constant+%E2%88%9E-stack"} constant ∞-stack
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mi X
                  %annotation{:encoding => "application/x-tex"} LConst X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_prop
            %h6#proposition_13 Proposition
            %p
              The function algebra on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                    %mi X
                  %annotation{:encoding => "application/x-tex"} LConst X
              is the cosimplicial algebra of singular cochains on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
              it identifies with the cochain
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet(X)
              that computes the
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This has maybe been first made explicit by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"} Bertrand Toën
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras on ∞-stacks
          .num_prop
            %h6#corollary_3 Corollary
            %p
              The Hochschild homology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet(X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mi X
                    %annotation{:encoding => "application/x-tex"} L X
          .proof
            %h6#proof_13 Proof
            %p
              Apply the
              %a{:href => "#GeneralAbstractDefinition"} central identification
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mi ℒ
                      %mo{:stretchy => "false"} (
                      %mi LConst
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi S
                        %mn 1
                      %mo ⋅
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %mi LConst
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{O} \mathcal{L}(LConst X)  \simeq S^1 \cdot \mathcal{O}(LConst X)
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi LConst
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L} LConst X
              of the constant
              = succeed "-stack" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-stack" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LConst
                  %annotation{:encoding => "application/x-tex"} LConst
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+exact+%28%E2%88%9E%2C1%29-functor"} left exact (∞,1)-functor
              and because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo ≃
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}X \simeq L X
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mi LConst
                    %mi L
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} LConst L X
              is singular cochains on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mi X
                    %annotation{:encoding => "application/x-tex"} L X
          %p
            This result, which follows directly from the general abstract desciption of Hichschild homology is known as
            = succeed "." do
              %strong Jones’ theorem
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+manifold"} compact manifold
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
