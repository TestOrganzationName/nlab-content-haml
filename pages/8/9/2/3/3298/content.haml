            of cochains for
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            for the topological
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(L X)
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              There is a linear isomorphism of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                    %mo :
                    %msup
                      %mi HH
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                        %mo −
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∨
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi HH
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{D}
                    \:
                    HH^{-p-q}(C^\bullet(X), C^\bullet(X)^{\vee})
                    \\simeq
                    HH^{-p}(C^\bullet(X), C^\bullet(X))
                    \\,.
          %p
            This is due to (
            %a{:href => "#FelixThomasVigue-Poirrier"}> FelixThomasVigue-Poirrier, section 7
            )).
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              %strong (Jones’ theorem)
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo :
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi HH
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi p
                        %mo −
                        %mi d
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J
                    \:
                    H_{p+q}(L X)
                    \\stackrel{\simeq}{\to}
                    HH^{-p-d}(C^\bullet(X), C^\bullet(X)^{\vee})
            %p
              such that the canonical
              %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
              %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi d
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{\bullet + d}(L X)
              and the
              %a.existingWikiWord{:href => "/nlab/show/Connes+coboundary"} Connes coboundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mo ∨
                  %annotation{:encoding => "application/x-tex"} B^\vee
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi HH
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi d
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HH^{\bullet-d}(C^\bullet(X), C^\bullet(X)^{\vee})
              satisfy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ∘
                    %mi Δ
                    %mo =
                    %msup
                      %mi B
                      %mo ∨
                    %mo ∘
                    %mi J
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J \circ \Delta = B^{\vee} \circ J
                    \\,.
          %p
            This is due to (
            %a{:href => "#Jones"}> Jones
            ).
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Connes+coboundary"} Connes coboundary
              defines via the isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔻
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}
              from above the structure of a
              %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi HH
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH^\bullet(C^\bullet(X), C^\bullet(X))
          %p
            This is (
            %a{:href => "#Menichi"}> Menichi, theorem 3
            ).
          %h3#relation_to_cyclic_cohomology Relation to cyclic (co)homology
          %p
            There is an
            %a{:href => "http://ncatlab.org/nlab/show/free+loop+space+object#CircleAction"} intrinsic circle action
            on Hochschild (co)chains. Passing to the cyclically invariant (co)chains yields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+%28co%29homology"} cyclic (co)homology
          %h3#further Further
          %h4#Extensions Hochschild cohomology and extensions
          .num_defn
            %h6#definition_7 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi N
                    %mo →
                    %mi E
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} 0 \to N \to E \to R
              of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} E \to R
              is a surjective morphism of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                \-split
              extension or a
              %strong Hochschild extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              if the sequence is a
              %a.existingWikiWord{:href => "/nlab/show/split+sequence"} split sequence
              as a sequence of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
            %p
              Two extensions are
              %em equivalent
              if there is an isomorphism or
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mo ≃
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E \stackrel{\simeq}{\to} E'
              that makes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                          %mtd
                            %mo →
                          %mtd
                            %mi R
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mo →
                          %mtd
                            %mi E
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi R
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N &amp;\to&amp; E &amp;\to&amp; R
                    \\\
                    \\downarrow^{\mathrlap{=}} &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    N &amp;\to&amp; E' &amp;\to&amp; R
                    }
            %p commute.
          .num_remark
            %h6#remark_9 Remark
            %p
              Due to the
              = succeed "-splitness" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≃
                    %mi R
                    %mo ⊕
                    %mi N
                  %annotation{:encoding => "application/x-tex"} E \simeq R \oplus N
              and this is equipped with a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              = succeed "mand" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 2
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %msub
                      %mi r
                      %mn 2
                    %mo ,
                    %msub
                      %mi r
                      %mn 1
                    %msub
                      %mi n
                      %mn 2
                    %mo +
                    %msub
                      %mi n
                      %mn 1
                    %msub
                      %mi r
                      %mn 2
                    %mo +
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi r
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (r_1, n_1) \cdot (r_2, n_2) =
                    (r_1 r_2 , r_1 n_2 + n_1 r_2 + f(r_1, r_2))
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi R
                    %msub
                      %mo ⊗
                      %mi k
                    %mi R
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} f : R \otimes_k R \to N
              is some
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is (by definition) associative, it follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              that this satisfies for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mn 0
                    %mo ,
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi r
                      %mn 2
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} r_0, r_1, r_2 \in R
              the
              %em cocycle equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mn 0
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi r
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 0
                    %msub
                      %mi r
                      %mn 1
                    %mo ,
                    %msub
                      %mi r
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 0
                    %mo ,
                    %msub
                      %mi r
                      %mn 1
                    %msub
                      %mi r
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mn 0
                    %mo ,
                    %msub
                      %mi r
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi r
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    r_0 f(r_1, r_2) - f(r_0 r_1, r_2) + f(r_0 , r_1 r_2) - f(r_0, r_1) r_2 = 0
            %p
              as an equation in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              must be a Hochschild cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi HH
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \in HH^2(R,N)
                    \\,.
          %p
            Conversely, every such cocycle yields a
            = succeed "-split" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            this way:
          .num_theorem
            %h6#theorem_6 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              are in bijection with degree 2 Hochschild cohomology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi HH
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} HH^2(R,N)
          %p
            See for instance
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} Weibel, theorem 9.3.1
          %h4#Deformations Hochschild cohomology and deformations
          %p
            As a special case of the above statement about extensions of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %em deformation
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %p
            A standard problem is to deform a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            by introducing a new “parameter”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            that squares to 0 –
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ⋅
                  %mi t
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} t \cdot t = 0
            and a new product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mn 1
                  %msub
                    %mo ⋅
                    %mi t
                  %msub
                    %mi r
                    %mn 2
                  %mo =
                  %msub
                    %mi r
                    %mn 1
                  %msub
                    %mi r
                    %mn 2
                  %mo +
                  %mi t
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mn 1
                  %mo ,
                  %msub
                    %mi r
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  r_1 \cdot_t r_2 = r_1 r_2 + t f(r_1, r_2)
                  \\,.
          %p
            From the above we see that this is the same as finding an
            = succeed "-split" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            by itself. So in particular such extensions are given by Hochschild cocycles
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi HH
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in HH^2(R,R)
          %p
            See for instance
            %a{:href => "http://arxiv.org/PS_cache/math/pdf/0506/0506603v1.pdf"} Ginzburg, section 7
            and for more see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+free+loop+space"} Sullivan model of free loop space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"}> cyclic homology
                ,
                %a.existingWikiWord{:href => "/nlab/show/dihedral+homology"} dihedral homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+Hochschild+homology"} topological Hochschild homology
          %h2#references References
          %p Hochschild cohomology of ordinary algebras was introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gerhard+Hochschild"}> Gerhard Hochschild
              ,
              = succeed "," do
                %em On the cohomology groups of an associative algebra
              %strong 46
              1 (1945) 58-6 &amp;lbrack;
              %a{:href => "http://www.jstor.org/stable/1969145"}> jstor:1969145
              \&amp;rbrack;
          %p Early further discussion:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %em Cohomology of commutative algebra I
              = succeed "," do
                %a{:href => "https://www.math.mcgill.ca/barr/papers/thes.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Barr-CohomologyThesis.pdf", :title => "pdf"} pdf
          %p
            and in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              %em Harrison homology, Hochschild homology and triples
              J. Algebra
              %strong 8
              3 (1968) 314–323 &amp;lbrack;
              %a{:hrf => "https://doi.org/10.1016/0021-8693(68)90062-8"}> doi:10.1016/0021-8693(68)90062-8
              ,
              = succeed "," do
                %a{:href => "https://www.math.mcgill.ca/barr/papers/harr-hoch.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Barr-HarrHochAndTriples.pdf", :title => "pdf"} pdf
          %p Textbook discussions:
          %ul
            %li#Weibel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                , chapter 9 of:
                %em
                  %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
            %li#Ginzburg
              %p
                %a.existingWikiWord{:href => "/nlab/show/Victor+Ginzburg"}> Victor Ginzburg
                , chapter 4 of:
                %em Lectures on noncommutative geometry
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math.AG/0506603"}> arXiv:math/0506603
                \&amp;rbrack;
          %p The definition of the higher order Hochschild complex as (implicitly) the tensoring of an algebra with a simplicial set:
          %ul
            %li#Pirashvili
              %a.existingWikiWord{:href => "/nlab/show/Teimuraz+Pirashvili"}> Teimuraz Pirashvili
              ,
              %em Hodge decomposition for higher order Hochschild homology
              Annales Scientifiques de l’École Normale Supérieure Volume 33, Issue 2, March 2000, Pages 151-179 (
              %a{:href => "http://www.mathematik.uni-bielefeld.de/sfb343/preprints/pr98058.ps.gz"}> ps
              )
          %p A survey of traditional higher order Hochschild (co)homology and further developments and results are described in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
              ,
              %em Higher order Hochschild cohomology
              %p
                (
                %a{:href => "http://www.institut.math.jussieu.fr/~ginot/papers/Higher-Order-Hochschild-Long.pdf"}> pdf
                )
          %p
            A considerably refined discussion of this which almost makes the construction of Hochschild complexes as an
            = succeed "-copowering" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul#GinotTradlerZeinalian
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
              , Thomas Tradler,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
              = succeed "," do
                %em Derived higher Hochschild homology, topological chiral homology and factorization algebras
              %a{:href => "http://arxiv.org/abs/1011.6483"} arxiv/1011.6483
          %ul
            %li
              Nathalie Wahl, Craig Westerland,
              = succeed "," do
                %em Hochschild homology of structured algebras
              %a{:href => "http://arxiv.org/abs/1110.0651"} arxiv/1110.0651
          %p
            The full
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
          %ul#Ben-ZviFrancisNadler
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-function+theory"} Integral transforms and Drinfeld centers in derived algebraic geometry
                (
                %a{:href => "http://arxiv.org/abs/0805.0157"}> arXiv:0805.0157
                )
          %p based on
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %em Loop Spaces and Langlands Parameters
              (
              %a{:href => "http://arxiv.org/abs/0706.0322"}> arXiv:0706.0322
              ) .
          %p
            Specifically the dicussion of differential forms via such an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul#Ben-ZviNadler
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %em Loop Spaces and Connections
              (
              %a{:href => "http://arxiv.org/abs/1002.3636"}> arXiv:1002.3636
              )
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"} Bertrand Toën
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriele+Vezzosi"} Gabriele Vezzosi
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
                \-Equivariant simplicial algebras and de Rham theory
              (
              %a{:href => "http://arxiv.org/abs/0904.3256"}> arXiv:0904.3256
              )
          %p General homotopy-theoretic setups and results for contexts in which this makes sense are discussed in
          %ul#ToenVezzosiStacks
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriele+Vezzosi"} Gabriele Vezzosi
              %em HAG II, geometric stacks and applicatons
              (
              %a{:href => "http://arxiv4.library.cornell.edu/abs/math/0404373v4"}> arXiv:math/0404373v4
              )
          %p Jones’s theorem is due to
          %ul#Jones
            %li
              J. D. S. Jones,
              %em Cyclic homology and equivariant homology
              , Invent. Math. 87 (1987), no. 2, 403-423.
          %p The BV-algebra structure on Hochschild cohomology of singular cochain algebras is discussed in
          %ul#FelixThomasVigue-Poirrier
            %li
              Y. Félix, J.-C. Thomas, M. Vigué-Poirrier,
              %em The Hochschild cohomology of a closed manifold
              Publ. Math. IHÉS Sci. (2004) no 99, 235-252
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Luc+Menichi"}> Luc Menichi
              ,
              %em Batalin-Vilkovisky algebra structures on Hochschild cohomology
              (
              %a{:href => "http://math.univ-angers.fr/perso/lmenichi/BV_Hochschild.pdf"}> pdf
              )
          %p
            The abstract differential caclulus on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (HH^\bullet(A,A), HH_\bullet(A,A))
            is discussed for instance in
          %ul#TamarkinTsygan
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitry+Tamarkin"}> Dmitry Tamarkin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Boris+Tsygan"} Boris Tsygan
              %em Cyclic Formality and Index Theorems
              , Letters in Mathematical Physics
              %p
                Volume 56, Number 2, 85-97 (
                %a{:href => "http://www.springerlink.com/content/u33hv13g0669h414/"}> journal
                )
          %p A review of Deligne’s conjecture and its solutions is in
          %ul#Hess
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"}> Kathryn Hess
              ,
              %em Deligne’s Hochschild cohomology conjecture
              (
              %a{:href => "http://sma.epfl.ch/~hessbell/Pub_DeligneColloq.pdf"}> pdf
              )
          %p More developments are in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
              , Thomas Tradler,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
              = succeed "," do
                %em
                  Higher Hochschild cohomology, Brane topology and centralizers of
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mi n
                        %annotation{:encoding => "application/x-tex"} E_n
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1205.7056"} arXiv:1205.7056
            %li
              Nathalie Wahl,
              = succeed "," do
                %em Universal operations in Hochschild homology
              %a{:href => "http://arxiv.org/abs/1212.6498"} arxiv/1212.6498
          %p
            Relation to
            %a.existingWikiWord{:href => "/nlab/show/factorization+homology"} factorization homology
            is discussed in
          %ul
            %li
              Geoffroy Horel,
              %em Factorization homology and calculus à la Kontsevich Soibelman
              (
              %a{:href => "http://arxiv.org/abs/1307.0322"}> arXiv:1307.0322
              )
          %p
            For more references on the relation to
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+chiral+homology"} topological chiral homology
            see there.
          %p
            Interesting wishlists for treatments of Hochschild cohomology are in
            %a{:href => "http://mathoverflow.net/questions/28472/book-on-hochschild-cohomology"} this
            MO discussion.
        .revisedby
