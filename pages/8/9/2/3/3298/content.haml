                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi cdgAlg
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi 𝒪
