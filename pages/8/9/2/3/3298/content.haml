                    \\\
                    * &amp;\stackrel{r}{\to}&amp; *
                    }
                    \\right)
                    \\,.
          %p
            Now consider the
            %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
            that exhibits the morphism 1 in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Id
                  %annotation{:encoding => "application/x-tex"} Aut(\mathbf{B}\mathbb{Z})_{Id}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
