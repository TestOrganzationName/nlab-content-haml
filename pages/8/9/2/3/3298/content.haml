                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi ℤ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}\mathbb{Z}
                  \\\
                  \&amp;{}^{\mathllap{Id}}\nearrow &amp; \uparrow
                  \\\
                  \\mathbf{B}\mathbb{Z} &amp;\stackrel{\eta}{\to}&amp; \mathbf{B}\mathbb{Z}^{I}
                  \\\
