                              %mo ,
                              %mn 1
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi A
                    %mover
                      %munder
                        %mo ⟶
                        %mi μ
                      %mover
                        %mo ⟶
                        %mi μ
                    %mi A
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Delta[1]/\partial \Delta[1])\cdot A =
                  \\left(
                  \\cdots
                  A\otimes_k A \otimes_k A
                  \\stackrel{\overset{\mu \otimes_k Id \sigma_{2,3,1}}{\to}}{\stackrel{\overset{Id \otimes_k \mu}{\longrightarrow}}{\underset{\mu \otimes_k Id}{\longrightarrow}}} A \otimes_k A
                  \\stackrel{\overset{\mu}{\longrightarrow}}{\underset{\mu}{\longrightarrow}}A
                  \\right)
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            of this simplicial algebra is the traditional
            %strong Hochschild chain complex
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet(A,A) = C_\bullet((\Delta[1]/\partial \Delta[1]) \cdot A)
                  \\,.
          %p
            This we describe in more detail in the section
            = succeed "." do
              %a{:href => "#ExplicitHochschildChains"} Explicit description of the Hochschild complex
          %p
            Generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            any simplicial set,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⋅
                  %mi A
                %annotation{:encoding => "application/x-tex"} K \cdot A
            is the simplicial algebra whose Moore complex is the complex that (
            %a{:href => "#Pirashvili"}> Pirashvili
            ) uses to define higher order Hochschild homology.
          %h4{:id => "IdWithK&#228;hlerForOrdAlgebra"} Identification with Kähler differential forms
          %p
            We spell out in detail how in degree 0 and 1 the
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of the Hochschild complex of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is that of its
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            this is also true in higher degrees, which is the statement of the
            = succeed "." do
              %a{:href => "#HochschildKostantRosenberg"} Hochschild-Kostant-Rosenberg theorem
          #Kaehler1Forms.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
              of the Hochschild complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S^1 \cdot A
              in degree 1 is the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential+form"} Kähler differential form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi HH
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi Ω
                      %mi K
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    HH_1(A,A) = H_\bullet(S^1\cdot A) \simeq \Omega^1_K(A/k)
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              is induced by the identifications
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo *
                                %mo *
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi g
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo →
                                %mo *
                                %mo *
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi h
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo *
                                %mo →
                                %mo *
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mn 1
                              %mn 2
                            %mi f
                            %mo ∧
                            %mi d
                            %mi g
                            %mo ∧
                            %mi d
                            %mi h
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo *
                                %mo{:stretchy => "false"} )
                            %mo ,
                            %mi g
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo *
                                %mo →
                                %mo *
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi f
                            %mo ∧
                            %mi d
                            %mi g
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ∈
                            %msub
                              %mi A
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo *
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots
                    \\\
                    (f \in A_{(* * * )}, g \in A_{(*\to * *)}, h \in A_{(* * \to *)}
                    \&amp; \mapsto &amp; \frac{1}{2} f \wedge d g \wedge d h
                    \\\
                    (f \in A_{(* *)}, g \in A_{* \to *}) &amp;\mapsto&amp; f \wedge d g
                    \\\
                    (f \in A_{(*)}) &amp; \mapsto &amp; f
                    }
                    \\,,
            %p
              where on the left we display elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %msub
                          %mo ⊗
                          %mi k
                  %annotation{:encoding => "application/x-tex"} A^{\otimes_k}
              under the
              %a{:href => "#TensoringWithSimplicialCircleAlgebra"} above
              identification of these tensor powers in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                      %mo ⋅
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S^1 \cdot A
          .proof
            %h6#proof_4 Proof
            %p
              By the above discussion, the
              = succeed "-differential" do
                %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (f,g,h) \in A \otimes_k A \otimes_k A
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ∂
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ,
                            %mi g
                            %mo ,
                            %mi h
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mi g
                            %mo ,
                            %mi h
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ,
                            %mi g
                            %mi h
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mi f
                            %mo ,
                            %mi g
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ∼
                            %mi f
                            %mi g
                            %mo ∧
                            %mi d
                            %mi h
                            %mo −
                            %mi f
                            %mo ∧
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mi h
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi f
                            %mi h
                            %mo ∧
                            %mi d
                            %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\partial (f,g,h)
                    \&amp;=
                    (f g, h) - (f, g h) + (h f, g)
                    \\\
                    \&amp;
                    \\sim
                    f g \wedge d h -  f \wedge d (g h) + f h \wedge d g
                    \\end{aligned}
                    \\,.
            %p
              The last term on the right is precisely the term by which one has to quotient out the module of formal expressions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∧
                    %mi d
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \wedge d g
              to get the module of
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential"} Kähler differential
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi f
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                    %mo ∧
                    %mi d
                    %mi g
                    %mo +
                    %mi g
                    %mo ∧
                    %mi d
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\partial (f,g,h) = 0)
                    \\Leftrightarrow
                    f \wedge ( d(g h) = h \wedge d g + g \wedge d h )
                    \\,.
            %p Therefore we have manifestly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi K
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1_K(A) \simeq C_1(A,A)/im(\partial)
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              We may also compute the
              = succeed "-homology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} \partial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \otimes_k A
              by the image of the degeneracy map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %msub
                        %mo ⊗
                        %mi k
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \sigma : A \to A \otimes_k A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mtd
                            %mtd
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo →
                              %mo *
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    (*) &amp;\to&amp; (* *)
                    \\\
                    \\coprod &amp;&amp; \coprod
                    \\\
                    \\emptyset &amp;\to&amp; (* \to *)
                    }
                    \\right)
                    \\cdot
                    A
            %p and thus maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi f
                    %mo ∧
                    %mi d
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \mapsto f \wedge d 1
                    \\,.
            %p So passage to the normalized chains imposes the condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mn 1
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d 1 = 0
                    \\,.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Under the identification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi HH
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} HH_\bullet(A,A) = H_\bullet(S^1 \cdot A)
              with Kähler differential forms, the
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              on homology identifies with the
              %a.existingWikiWord{:href => "/nlab/show/exterior+algebra"} wedge product
              of differential 0- and 1-forms.
          .proof
            %h6#proof_5 Proof
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+Dold-Kan+correspondence"} monoidal Dold-Kan correspondence
              the product on the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_\bullet(S^1 \cdot A)
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi k
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ∇
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi N
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo ⋅
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    N_\bullet(S^1 \cdot A) \otimes_k
                    N_\bullet(S^1 \cdots)
                    \\stackrel{\nabla}{\to}
                    N_\bullet((S^1 \cdot A) \otimes (S^1 \cdot A))
                    \\stackrel{N_\bullet(\cdot)}{\to}
                    N_\bullet(S^1 \cdot A)
                    \\,,
            %p
              where for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \omega \in (S^1\cdot A)_p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \lambda \in (S^1 \cdot A)_q
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo :
                    %mi ω
                    %mo ⊗
                    %mi λ
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi μ
                        %mo ,
                        %mi ν
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi Shuff
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mi sign
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi s
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi s
                      %mi μ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla : \omega \otimes \lambda \mapsto
                    \\sum_{(\mu,\nu)\in Shuff(p,q)} sign(\mu,\nu) s_\nu(\omega) \otimes s_\mu(\lambda)
                    \\,.
            %p
              For instance for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mi f
                    %mo ∧
                    %mi d
                    %mi g
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ⋅
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \omega = f \wedge d g \in (S^1 \cdot A )_0
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∧
                    %mi d
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo ∧
                    %mi d
                    %mi g
                    %mo ∧
                    %mi d
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    s_1 (f \wedge d g) = f \wedge d g \wedge d 1
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ∧
                    %mi d
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ∧
                    %mi d
                    %mn 1
                    %mo ∧
                    %mi d
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    s_2(h \wedge d q) = (h \wedge d 1 \wedge d q)
            %p
              and the tensor product (in
              = succeed "!)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo ⋅
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} (S^1 \cdot A)_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∧
                    %mi d
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi s
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ∧
                    %mi d
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⊗
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ⊗
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊗
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s_1(f \wedge d g) \otimes s_2(h \wedge d q) = (f \otimes h) \wedge
                    d(g \otimes 1) \wedge d(1 \otimes q)
                    \\,.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mi h
                    %mo ∧
                    %mi d
                    %mi q
                    %mo ∧
                    %mi d
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla(\omega, \lambda) = f h \wedge d q \wedge d q
                    \\,.
          %h4#SimplicialCircleActionForOrdAlgebra The simplicial circle action
          %p
            We describe the canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
            of the circle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo ⋅
                  %mi A
                %annotation{:encoding => "application/x-tex"} S^1 \cdot A
            and how its degree-1 part induces under the
            %a{:href => "#IdWithK&#228;hlerForOrdAlgebra"} above
            identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ⋅
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mi Ω
                    %mi K
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(S^1 \cdot A) \simeq \Omega^\bullet_K(A)
            the action of the de Rham differential.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/automorphism+2-group"} automorphism 2-group
              of the categorical circle is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mrow
                        %mn ∞
                        %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} }
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{\infty Grpd}(\mathbf{B}\mathbb{Z}, \mathbf{B}\mathbb{Z})
                    \\simeq
                    \\coprod_{\{+1,-1\}} \mathbf{B}\mathbb{Z}
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              We may compute the automorphism 2-group in the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊂
                  %annotation{:encoding => "application/x-tex"} \subset
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy 1-types
              at
              %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
              for details). A functor between
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G \to \mathbf{B}H
              is precisely a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G \to H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              are precisely given by multiplication with elements in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \pm 1
            %p The natural transformations between such functors are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ±
                                    %mn 1
                          %mtr
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi ℤ
                            %mtd
                              %msup
                                %mo ⇓
                                %mi r
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi ℤ
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ±
                                    %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mn 1
                          %mtr
                            %mtd
                              %mo *
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mover
                                %mo →
                                %mi r
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ±
                                    %mn 1
