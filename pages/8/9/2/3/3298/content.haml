                            %mtd
                              %mover
                                %mo →
                                %mi r
                            %mtd
                              %mo *
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \&amp; \nearrow \searrow^{\mathrlap{\pm 1}}
                    \\\
                    \\mathbf{B}\mathbb{Z}
                    \&amp; \Downarrow^{r}&amp;
