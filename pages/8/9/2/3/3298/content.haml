                      (* * * *) \coprod (* \to * * *) \coprod (* * \to * *) \coprod (* * * \to * )
                      \&amp;
                      \\\
                      \\\
                      (\Delta[1]/\partial\Delta[1])_2
                      \&amp; = &amp; (* * *) \coprod (*\to* *) \coprod (* * \to *)
                      \\\
                      \\\
                      (\Delta[1]/\partial\Delta[1])_1 &amp; = &amp; (* *) \coprod  (* \to *)
                      \\\
                      \\\
                      (\Delta[1]/\partial\Delta[1])_0 &amp; = &amp;  (*)
                      }
                      \\,.
              %p
                Here for instance the expression
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo *
                      %mo →
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (* * \to * )
                denotes the morphism of simplicial sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo ∂
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[2] \to \Delta[1]/\partial \Delta[1]
                that sends the first edge (the 2-face) of the 2-simplex to the unique degenerate 1-cell and the second edge (the 0-face) to the unique non-degenerate 1-cell of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]/ \partial \Delta[1]
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                of the
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
                of the additive group of
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %p
                This model is fibrant (is a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                %a.existingWikiWord{:href => "/nlab/show/strict+2-group"} strict 2-group
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
                or equivalently the structure of a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                on its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                      %mo ×
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{B}\mathbb{Z} \times \mathbf{B}\mathbb{Z} \to
                      \\mathbf{B}\mathbb{Z}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mover
                        %mo →
                        %mi k
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mover
                        %mo →
                        %mi l
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mover
                        %mo →
                        %mrow
                          %mi k
                          %mo +
                          %mi l
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      ((* \stackrel{k}{\to} * ), (* \stackrel{l}{\to} * ))
                      \\mapsto
                      (* \stackrel{k+l}{\to} * )
                      \\,.
          %h4#TensoringWithSimplicialCircleAlgebra Tensoring with the simplicial circle
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi CAlg
                    %mi k
                %annotation{:encoding => "application/x-tex"} A \in CAlg_k
            be a commutative
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            over a commutative
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Above in the section on
            %a{:href => "#PirashviliHigherOrder"} Higher order Hochschild homology
            we had discussed how the Hochschild homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given by the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+algebra"} simplicial algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi A
                  %mo ∈
                  %msubsup
                    %mi CAlg
                    %mi k
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} (\Delta[1]/\partial \Delta[1]) \cdot A \in CAlg_k^{\Delta^{op}}
            that is the
            %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            regarded as a constant simplicial algebra with the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[1]/\partial \Delta[1]
            (the 1-
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            with its two 0-cells identified).
          %p
            We describe now in detail what this simplicial circle algebra looks like. The proof that this construction is indeed homotopy-good is given below in
            %a{:href => "#FuncsOnDerivedLoopSpace"} As functions on the derived loop space
          %p
            When forming the
            = succeed "ing" do
              %a.existingWikiWord{:href => "/nlab/show/copower"} copower
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with the simplicial circle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            for each item in parenthesis.
          %p To be very explicit, we recall and demonstrate the following elementary fact.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} CAlg_k
              the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi i
                                    %mi A
                            %mtd
                              %mi A
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi B
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                                  %msub
                                    %mi i
                                    %mi B
                            %mtd
                              %mi B
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi Id
                                    %mi A
                                  %msub
                                    %mo ⊗
                                    %mi k
                                  %msub
                                    %mi e
                                    %mi B
                            %mtd
                              %mi A
                              %msub
                                %mo ⊗
                                %mi k
                              %mi B
                            %mtd
                              %mover
                                %mo ←
                                %mrow
                                  %msub
                                    %mi e
                                    %mi A
                                  %mo ⊗
                                  %msub
                                    %mi Id
                                    %mi B
                            %mtd
                              %mi B
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    A
                    \&amp;\stackrel{i_A}{\to}&amp;
                    A \coprod B
                    \&amp;\stackrel{i_B}{\leftarrow}&amp;
                    B
                    }
                    \\right)
                    \\simeq
                    \\left(
                    \\array{
                    A
                    \&amp;\stackrel{Id_A \otimes_k e_B}{\to}&amp;
                    A \otimes_k B
                    \&amp; \stackrel{e_A \otimes Id_B}{\leftarrow}&amp;
                    B
                    }
                    \\right)
          .proof
            %h6#proof_3 Proof
            %p
              We check the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the coproduct: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %msub
                      %mi CAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} C \in CAlg_k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi A
                    %mo ,
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f,g : A,B \to C
              two morphisms, we need to show that there is a unique morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (f,g) : A \otimes_k B \to C
              such that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Id
                                  %mi A
                                %mo ⊗
                                %msub
                                  %mi e
                                  %mi B
                          %mtd
                            %mi A
                            %msub
                              %mo ⊗
                              %mi k
                            %mi B
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi e
                                  %mi A
                                %mo ⊗
                                %msub
                                  %mi Id
                                  %mi B
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A
                    \&amp;\stackrel{Id_A \otimes e_B}{\to}&amp;
                    A \otimes_k B
                    \&amp;\stackrel{e_A \otimes Id_B}{\leftarrow}&amp;
                    B
                    \\\
                    \&amp; {}_{\mathllap{f}}\searrow &amp; \downarrow^{\mathrlap{(f,g)}} &amp; \swarrow_{\mathrlap{g}}
                    \\\
                    \&amp;&amp; C
                    }
            %p
              commutes. For the left triangle to commute we need that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              sends elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,e_B)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              sends elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_A, b)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \otimes_k B
              is a product of two elements of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (a,b) = (a,e_B) \cdot (e_A, b)
            %p
              this already uniquely determines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              to be given on elements by the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (a,b) \mapsto f(a) \cdot g(b)
                    \\,.
            %p
              That this is indeed an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              are
          %p Notice that for all this it is crucial that we are working with commutative algebras.
          .num_cor
            %h6#corollary Corollary
            %p
              We have that the tensoring of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with the map of sets from two points to the single point
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo *
                    %mo →
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi A
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo ⊗
                      %mi k
                    %mi A
                    %mover
                      %mo →
                      %mi μ
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (* \coprod * \to *) \cdot A
                    \\simeq
                    (
                    A \otimes_k A
                    \\stackrel{\mu}{\to}
                    A
                    )
            %p
              is the product morphism on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
