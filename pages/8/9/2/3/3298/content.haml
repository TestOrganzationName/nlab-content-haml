                              %mi S
                              %mn 1
                            %mo ×
                            %mi U
                            %mo ,
                            %mi Spec
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi cdgAlg
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
