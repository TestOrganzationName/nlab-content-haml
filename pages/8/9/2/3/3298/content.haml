                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    [S^1, Spec A](U) &amp; \simeq \mathbf{H}(S^1 \times U , Spec A)
