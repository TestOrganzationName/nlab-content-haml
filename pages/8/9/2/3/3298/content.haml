                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi ℤ
                        %mtd
                          %mover
                            %mo →
