                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo →
                    %msub
                      %mi R
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \phi_{n}\colon S^{n-k} \to R_n
              fitting into commuting diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msup
                              %mi S
                              %mrow
                                %msub
