                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi 𝒟
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi F
