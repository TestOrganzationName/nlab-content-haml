                      %mrow
                        %mi Q
                        %mi X
                    %mo ⊗
                    %msub
                      %mi j
                      %mrow
                        %mi Q
                        %mi Y
                    %mo ⊗
                    %msub
                      %mi j
                      %mrow
                        %mi Q
                        %mi Z
                    %msup
                      %mo{:stretchy => "false"} )
