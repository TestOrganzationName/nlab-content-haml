                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mi FreeMod
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %mi K
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} [
