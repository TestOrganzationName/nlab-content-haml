            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %mi d
                        %mo ∈
                        %mi 𝒞
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{d\in \mathcal{C}}{\int} Maps(\mathcal{C}(c,d), F(d))_\ast
                    \\;\simeq\;
                    F(c)
                    \\,.
            %p
              In this form the statement is also known as
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+reduction"} Yoneda reduction
          %p
            The
            %strong proof
            of prop.
            %a.maruku-ref{:href => "#YonedaReductionTopological"}
            is essentially dual to the proof of the next prop.
            = succeed "." do
              %a.maruku-ref{:href => "#TopologicalCoYonedaLemma"}
          %p
            Now that
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            are phrased in terms of
            %a.existingWikiWord{:href => "/nlab/show/ends"} ends
            (example
            = succeed ")," do
              %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
            = succeed ")," do
              %a.maruku-ref{:href => "#YonedaReductionTopological"}
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dual
            statement involvng
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/coends"} coends
          #TopologicalCoYonedaLemma.num_prop
            %h6#proposition_12 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"}> co-Yoneda lemma
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+categories"} topologically enriched categories
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopEnrichedCategory"}> def.
              ). For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\to Top^{\ast/}_{cg}
              a pointed
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopologicallyEnrichedFunctor"}> def.
              ) and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
              an object, there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mover
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(-)
                    \\simeq
                    \\overset{c \in \mathcal{C}}{\int}
                    \\mathcal{C}(c,-) \wedge F(c)
                    \\,.
            %p
              Moreover, the morphism that hence exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(c)
              as the
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of the two morphisms in def.
              %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              is componentwise the canonical action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(d,c) \wedge F(c)
                    \\longrightarrow
                    F(d)
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              to the component map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(d,c) \to Maps(F(c),F(d))_{\ast}
              of the
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#MMSS00"} MMSS 00, lemma 1.6
          .proof
            %h6#proof_25 Proof
            %p
              The coequalizer of pointed topological spaces that we need to consider has underlying it a coequalizer of underlying pointed sets (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ,
              = succeed "," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LimitsAndColimitsOfPointedObjects"} prop.
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#kTopIsCoreflectiveSubcategory"} prop.
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LimitsAndColimitsOfPointedObjects"} prop.
            %p
              That is just the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{}{\to} c_0,\; x \in F(c) )
                    \\,,
            %p where two such pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mover
                      %mo →
                      %mi g
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{f}{\to} c_0,\; x \in F(c) )
                    \\,,\;\;\;\;
                    ( d \overset{g}{\to} c_0,\; y \in F(d) )
            %p are regarded as equivalent if there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %mi d
                  %annotation{:encoding => "application/x-tex"}
                    c \overset{\phi}{\to} d
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi g
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = g \circ \phi
                    \\,,
                    \\;\;\;\;\;and\;\;\;\;\;
                    y = \phi(x)
                    \\,.
            %p
              (Because then the two pairs are the two images of the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,x)
              under the two morphisms being coequalized.)
            %p
              But now considering the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} d = c_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} d = id_{c_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} f = \phi
              shows that any pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{\phi}{\to} c_0, \; x \in F(c))
            %p is identified, in the coequalizer, with the pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (id_{c_0},\; \phi(x) \in F(c_0))
                    \\,,
            %p
              hence with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x)\in F(c_0)
            %p
              This shows the claim at the level of the underlying sets. To conclude it is now sufficient (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#DescriptionOfLimitsAndColimitsInTop"}> prop.
              ) to show that the topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} F(c_0) \in Top^{\ast/}_{cg}
              is the
              %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#InitialAndFinalTopologies"}> def.
              ) of the system of component morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %munder
                      %mo ∫
                      %mi c
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(d,c) \wedge F(c)
                    \\longrightarrow
                    \\underset{c}{\int} \mathcal{C}(c,c_0) \wedge F(c)
            %p which we just found. But that system includes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(c,c) \wedge F(c) \longrightarrow F(c)
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    id \;\colon\; F(c) \longrightarrow \mathcal{C}(c,c) \wedge F(c)
                    \\longrightarrow F(c)
            %p
              and so if all the preimages of a given subset of the coequalizer under these component maps is open, it must have already been open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(c)
          .num_remark
            %h6#remark_6 Remark
            %p
              The statement of the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              in prop.
              %a.maruku-ref{:href => "#TopologicalCoYonedaLemma"}
              is a kind of
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
              of the following statement in
              %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
              (whence the notation with the integral signs):
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon X \to\mathbb{R}
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta(-,x_0)
              denoting the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dirac+distribution"} Dirac distribution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
