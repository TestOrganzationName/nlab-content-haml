                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mrow
                                %msub
                                  %mi n
                                  %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi n
                                      %mn 2
                                %mrow
                                  %mrow
                                    %mo =
                                    %mi n
                            %mrow
                              %mo (
                              %msub
                                %mi X
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 1
                              %mo ∧
                              %msub
                                %mi X
                                %mrow
                                  %msub
                                    %mi n
                                    %mn 2
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (X \otimes_{Day} Y)_n
                    \&amp; =
                    \\overset{(n_1,n_2)}{\int}
                    Seq(n_1 + n_2 , n)
                    \\wedge
