              is not commutative (due to the
              %a{:href => "smash+product+of+spectra#GradedCommutativity"} graded commutativity in the smash product of spheres
              which is not reflected in the trivial symmetry of the tensor product on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Seq
                    %annotation{:encoding => "application/x-tex"} Seq
            %table
              %thead
                %tr
                  %th
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝕊
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
