                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma(q)/\Sigma(q-n-1)
