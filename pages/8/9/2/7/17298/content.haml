                    %mrow
                      %msub
                        %mi n
                        %mn 2
                      %mo &gt;
                      %msub
                        %mi n
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} n_2 \gt n_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi 𝕊
                              %mi Seq
                            %msup
                              %mi FreeMod
                              %mi op
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi n
