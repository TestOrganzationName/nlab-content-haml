                    }
                    \\,.
            %p
              This shows that the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi A
                  %annotation{:encoding => "application/x-tex"} e_A
              is a homomorphism of monoids
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi μ
                        %mi A
                      %mo ,
                      %msub
                        %mi e
                        %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %msub
                        %mi μ
                        %mi E
                      %mo ,
                      %msub
                        %mi e
                        %mi E
                      %mo ∘
                      %msub
                        %mi e
                        %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,\mu_A, e_A) \longrightarrow (E, \mu_E, e_E\circ e_A)
            %p
              Now for the converse direction, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mi μ
                      %mi A
                    %mo ,
                    %msub
                      %mi e
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\mu_A, e_A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msub
                      %mi μ
                      %mi E
                    %mo ,
                    %mi e
                    %msub
                      %mo ′
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu_E, e'_E)
              are two commutative monoids in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
