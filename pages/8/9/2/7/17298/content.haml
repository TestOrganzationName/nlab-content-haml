                %p
                  and with
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  given by
                  %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                  followed by the composition in
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
