                          %mi op
                        %mover
                          %mo ↪
                          %mi y
                        %mo{:stretchy => "false"} [
                        %mi Dia
                        %mo ,
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} e \in Dia^{op} \stackrel{y}{\hookrightarrow} [Dia, Top^{\ast/}]
                  this takes the value
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi F
                      %mi n
                      %mi dia
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi e
                            %mn 1
                          %mo ⊗
                          %msub
                            %mi e
                            %mn 2
                          %mo →
                          %mi e
                    %mi Dia
