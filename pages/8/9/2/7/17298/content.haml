                    y \colon \mathcal{C}^{op} \hookrightarrow [\mathcal{C}, Top^{\ast/}]
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              goes to the tensor unit of the induced
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top^{\ast/}]
          %p
            (see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            = succeed ")" do
              %a{:href => "Day+convolution#DayConvolutionTensorUnitIsYonedaImageOfTensorUnitInSite"} this lemma
          #StandardRepresentativeOfTheSphereSpectrum.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo ≔
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S} \coloneqq y(S^0) \in [Top_{fin}^{\ast/}, Top^{\ast/}]
            %p
              for the image under the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Top
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top_{fin}^{\ast/}
              with its
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              (the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %a.maruku-ref{:href => "#DayConvolutionTensorUnitIsYonedaImageOfTensorUnitInSite"}
              is the tensor unit in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi Top
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi Day
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([Top_{fin}^{\ast/}, Top^{\ast/}], \otimes_{Day})
            %p
              Since this is going to be the standard presentation of the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+excisive+functors"} model structure for excisive functors
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [Top_{fin}^{\ast/}, Top^{\ast/}]
              we refer to it as
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %p
              For its restrictions along the above sub-site inclusions, prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PropertiesOfTopologicalDiagramCategoriesForSpectra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                    %mo ≔
                    %msup
                      %mi orth
                      %mo *
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mo ≔
                    %msup
                      %mi sym
                      %mo *
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝕊
                      %mi Seq
                    %mo ≔
                    %msup
                      %mi seq
                      %mo *
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Orth} \coloneqq orth^\ast \mathbb{S}
                    \\,,
                    \\;
                    \\mathbb{S}_{Sym} \coloneqq sym^\ast \mathbb{S}_{orth}
                    \\,,
                    \\;
                    \\mathbb{S}_{Seq} \coloneqq seq^\ast \mathbb{S}_{sym}
                    \\,.
          #RestrictionsOfSphereSpectrumAreStillMonoidObjects.num_remark
            %h6#remark Remark
            %p
              While
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              in def.
              %a.maruku-ref{:href => "#StandardRepresentativeOfTheSphereSpectrum"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi Top
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
