                            %mi q
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo +
                            %msub
                              %mo ∧
                              %mrow
                                %mi Q
                                %mo{:stretchy => "false"} (
                                %mi q
                                %mo −
                                %mi k
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi S
                              %mi q
