                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                      %mo +
                                      %msub
                                        %mi n
                                        %mn 2
                        %mtr
