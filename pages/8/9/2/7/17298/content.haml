            %p
              Now lemma
              %a.maruku-ref{:href => "#PushoutSmashProductOfFreeSpectraOnGeneratingCofibrationsOfTop"}
              implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
