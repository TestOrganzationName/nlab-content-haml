                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n_1} \wedge S^{n_2 - k} &amp;\overset{\simeq}{\longrightarrow}&amp; S^{n_1 + n_2 - k}
                    \\\
