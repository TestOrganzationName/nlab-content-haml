          #LaxMonoidalFunctor.num_defn
            %h6#definition_18 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒞
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi 𝒟
                    %mo ,
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D},\otimes_{\mathcal{D}}, 1_{\mathcal{D}} )
              be two (pointed)
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched
              %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#MonoidalCategory"}
              %strong lax monoidal functor
              between them is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ⟶
                        %mi 𝒟
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        F \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
                        \\,,
              %li
                %p a morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
