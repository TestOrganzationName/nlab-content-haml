                    S^{n_1} \wedge R_{n_2} \overset{\rho_{n_1,n_2}}{\longrightarrow} R_{n_1 + n_2}
            %p
              then a homomorphism of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi Seq
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Seq}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \phi \colon F(k)\to R
              has components
