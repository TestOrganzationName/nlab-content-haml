                    \&amp;\stackrel{id}{\longrightarrow}&amp;
                    O(q)_+ \wedge S^q
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{p_2}}
                    \\\
