            %p
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^\ast X)(c)\coloneqq X(f(c))
              preserves
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoids
              under
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi 𝒟
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mo *
                    %mo{:stretchy => "false"} ]
                    %mo ,
