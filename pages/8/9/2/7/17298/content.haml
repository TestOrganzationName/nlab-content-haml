              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
              otherwise.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
