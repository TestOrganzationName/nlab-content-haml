          #PropertiesOfTopologicalDiagramCategoriesForSpectra.num_prop
            %h6#proposition Proposition
            %p
              The sequence of inclusions in def.
              %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
              satisfies the following properties:
            %ol
              %li
                %p
                  All three inclusions are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
              %li
                %p
                  Under passing to
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (-)^\ast
                  along these inclusions and
                  %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo !
                      %annotation{:encoding => "application/x-tex"} (-)_!
                  along them yields a sequence of
                  %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} [
                                %msubsup
                                  %mi Top
                                  %mi fin
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                                %mover
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msup
                                        %mi orth
                                        %mo *
                                  %mover
                                    %mo ⟵
                                    %mrow
                                      %msub
                                        %mi orth
                                        %mo !
                                %mo{:stretchy => "false"} [
                                %mi Orth
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                                %mover
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msup
                                        %mi sym
                                        %mo *
                                  %mover
                                    %mo ⟵
                                    %mrow
                                      %msub
                                        %mi sym
                                        %mo !
                                %mo{:stretchy => "false"} [
                                %mi Sym
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                                %mover
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msup
                                        %mi seq
                                        %mo *
                                  %mover
                                    %mo ⟵
                                    %mrow
                                      %msub
                                        %mi seq
                                        %mo !
                                %mo{:stretchy => "false"} [
                                %mi Seq
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        [Top_{fin}^{\ast/}, Top^{\ast/}]
                        \\stackrel{\overset{orth_!}{\longleftarrow}}{\underset{orth^\ast}{\longrightarrow}}
                        [Orth, Top^{\ast/}]
                        \\stackrel{\overset{sym_!}{\longleftarrow}}{\underset{sym^\ast}{\longrightarrow}}
                        [Sym, Top^{\ast/}]
                        \\stackrel{\overset{seq_!}{\longleftarrow}}{\underset{seq^\ast}{\longrightarrow}}
                        [Seq, Top^{\ast/}]
                        }
                        \\,.
              %li
                %p
                  All four
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
                  become
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
                  with the
                  %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
                  monoidal product structure induced by the monoidal structure of their
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              %li
                %p
                  With respect to this all
                  %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
                  above are symmetric
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+adjunctions"} monoidal adjunctions
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  is even a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#MMSS00"} MMSS 00, I.3
          %p Notice the following:
          #DayConvolutionTensorUnitIsYonedaImageOfTensorUnitInSite.num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ↪
