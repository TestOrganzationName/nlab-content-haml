                          %mi c
                          %mn 1
                        %mo ,
                        %msub
                          %mi d
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 2
                        %mo ,
                        %msub
                          %mi d
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
