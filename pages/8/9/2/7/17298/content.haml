                    %mi n
                    %mo ,
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi 𝕊
                      %mi dia
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F^{dia}_n K)(e)
                    \\;=\;
                    \\underset{\underset{e_1 \otimes e_2 \to e}{\longrightarrow}}{\lim}
                    Dia(n,e_1)\wedge \mathbb{S}_{dia}(e_2) \wedge K
                    \\,.
          %p
            (
            %a{:href => "#MMSS00"}> MMSS00, p. 7 with theorem 2.2
            )
          .proof
            %h6#proof_5 Proof
            %p
              Generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
              an object, then there is an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi c
                      %mover
                        %mo ⟵
                        %mrow
                          %mi y
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}, V]
                    \\stackrel{\overset{y(d)\otimes(-)}{\longleftarrow}}{\underset{(-)_c}{\longrightarrow}}
                    V
            %p
              whose characterizing
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              is the combination of that of
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              with the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi K
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C},V]( y(d) \otimes K, F )
                    \\simeq
                    V( K, [\mathcal{C},V]( y(d), F ) )
                    \\simeq
                    V(K, F(d))
                    \\,.
            %p
              Specializing this to our case with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} V = Top^{\ast/}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %msub
                      %mi 𝕊
                      %mi dia
                    %msup
                      %mi FreeMod
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = \mathbb{S}_{dia} FreeMod^{op}
              yields the first statement. The second follows from similar yoga, see the formula at
              = succeed "." do
                %em
                  %a{:href => "Day+convolution#FreeModulesOverAMonoidInDayConvolution"} Day convolution – Modules
          #ExplicitFormOfFreeSpectra.num_prop
            %h6#proposition_6 Proposition
            %p
              Explicitly, the
              %a.existingWikiWord{:href => "/nlab/show/free+spectra"} free spectra
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
            %p
              For
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi F
                        %mi n
                        %mi Seq
                      %mi K
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi q
                      %mo ≃
                      %mi K
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi q
                          %mo −
                          %mi n
                    %annotation{:encoding => "application/x-tex"} (F^{Seq}_n K)_q \simeq K \wedge S^{q-n}
            %p
              for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi F
                        %mi n
                        %mi Sym
                      %mi K
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi q
                      %mo ≃
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                      %msub
                        %mo ∧
                        %mrow
                          %mi Σ
                          %mo{:stretchy => "false"} (
                          %mi q
                          %mo −
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mi K
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi q
                          %mo −
                          %mi n
                    %annotation{:encoding => "application/x-tex"} (F^{Sym}_n K)_q \simeq \Sigma(q)_+ \wedge_{\Sigma(q-n)} K \wedge S^{q-n}
            %p
              for
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi F
                        %mi n
                        %mi Orth
                      %mi K
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi q
                      %mo ≃
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi q
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                      %msub
                        %mo ∧
                        %mrow
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi q
                          %mo −
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mi K
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi q
                          %mo −
                          %mi n
                    %annotation{:encoding => "application/x-tex"} (F^{Orth}_n K)_q \simeq O(q)_+ \wedge_{O(q-n)} K \wedge S^{q-n}
            %p In particular:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 0
                        %mi K
                        %mo =
                        %msup
                          %mi Σ
                          %mn ∞
                        %mi K
                      %annotation{:encoding => "application/x-tex"} F_0 K = \Sigma^\infty K
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi F
                          %mi n
                          %mi Seq
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} F_n^{Seq}S^n
                  is like the
                  %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
                  of the point (the standard sequential
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  components simply removed.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Schwede12"} Schwede 12, example 3.20
          .proof
            %h6#proof_6 Proof
            %p
              By working out the formula in item 2 of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#ExplicitExpressionForFreeSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Dia
                    %mo =
                    %mi Seq
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Dia = Seq)
              there exists a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi k
                      %mn 2
                    %mo →
                    %msub
                      %mi k
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} k_1 \otimes k_2 \to k_3
              only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo +
                    %msub
                      %mi k
                      %mn 2
                    %mo =
                    %msub
                      %mi k
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} k_1 + k_2 = k_3
              and then there is a unique such. Hence here the colimit in the formula becomes a
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              and we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi F
                              %mi n
                              %mi Seq
                            %mi K
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %msub
                                  %mi e
                                  %mn 1
                                %mo +
                                %msub
                                  %mi e
                                  %mn 2
                                %mo =
                                %mi q
                            %munder
                              %munder
                                %mrow
                                  %mi Seq
                                  %mo{:stretchy => "false"} (
                                  %mi n
                                  %mo ,
                                  %msub
                                    %mi e
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                %mo ⏟
                              %mrow
                                %mo ≃
                                %mrow
                                  %mo {
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %msup
                                            %mi S
                                            %mn 0
                                        %mtd
                                          %mi if
                                          %mspace{:width => "thinmathspace"}
                                          %mi n
                                          %mo =
                                          %msub
                                            %mi e
                                            %mn 1
                                      %mtr
                                        %mtd
                                          %mo *
                                        %mtd
                                          %mi otherwise
                            %mo ∧
                            %msub
                              %mi 𝕊
                              %mi dia
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi K
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi S
                              %mrow
                                %mi q
                                %mo −
                                %mi n
                            %mo ∧
                            %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (F^{Seq}_n K)(q)
                    \&amp; \simeq
                    \\underset{e_1+e_2 = q}{\coprod}
                    \\underset{\simeq\left\{ \array{S^0 &amp; if\, n = e_1 \\ \ast &amp; otherwise}\right.}{\underbrace{Seq(n,e_1)}} \wedge \mathbb{S}_{dia}(e_2) \wedge K
                    \\\
                    \&amp; \simeq
                    S^{q-n}\wedge K
                    \\end{aligned}
                    \\,.
            %p
              In the symmetric case (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi Dia
                    %mo =
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Dia = Sym
              ) the formula is similar except that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo =
                    %mi Seq
