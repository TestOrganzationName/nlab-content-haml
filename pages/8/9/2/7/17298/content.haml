            \-modules
          #TopologicalDiagramCategoriesForSpectra.num_defn
            %h6#definition Definition
            %p
              Define the following
              %a.existingWikiWord{:href => "/nlab/show/pointed+topologically+enriched+categories"} pointed topologically enriched
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
              (the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              is a
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topologically+enriched+functor"} pointed topologically enriched functor
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Seq
                      %annotation{:encoding => "application/x-tex"} Seq
                  has as objects the
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                  and has only identity morphisms, tensor product is the addition of natural numbers, tensor unit is 0. As a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                  the hom-spaces are
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Seq
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi S
                                    %mn 0
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo =
                                  %msub
                                    %mi n
                                    %mn 2
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"}
                        Seq(n_1,n_2) =
                        \\left\{
                        \\array{
                        S^0 &amp; for\; n_1 = n_2
                        \\\
                        \\ast &amp; otherwise
                        }
                        \\right.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                      %annotation{:encoding => "application/x-tex"} Sym
                  is the standard
                  %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeleton
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/core"} core
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1, \cdots,n\}
                  for
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                  and the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{1,\cdots,n\}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Σ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \Sigma_n
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                  of sets, tensor unit is the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                  by adjoining a basepoint:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi Σ
                                    %mrow
                                      %msub
                                        %mi n
                                        %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo +
                                %mtd
                                  %mi for
                                  %mspace{:width => "thickmathspace"}
                                  %msub
                                    %mi n
                                    %mn 1
                                  %mo =
                                  %msub
                                    %mi n
                                    %mn 2
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi otherwise
                      %annotation{:encoding => "application/x-tex"}
                        Sym(n_1, n_2) =
                        \\left\{
                        \\array{
                        (\Sigma_{n_1})_+ &amp; for \; n_1 = n_2
                        \\\
                        \\ast &amp; otherwise
                        }
                        \\right.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Orth
                      %annotation{:encoding => "application/x-tex"} Orth
                  has as objects finite dimenional real linear
                  %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
                  and as morphisms the
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  %a.existingWikiWord{:href => "/nlab/show/isometry"} isometric
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  between these; hence the
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                  of the object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} O(V)
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of linear spaces, the tensor unit is the 0-vector space; again we turn this into a
                  = succeed "-enriched" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Orth
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi V
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi O
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi V
                                %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mo +
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi dim
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi V
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi dim
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi V
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    Orth(V_1,V_2)
                    \\simeq
                    \\left\{
                    \\array{
                    O(V_1)_+ &amp; for \; dim(V_1) = dim(V_2)
                    \\\
                    \\ast &amp; otherwise
                    }
                    \\right.
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi fin
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top_{fin}^{\ast/}
                is the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
                on those
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
                to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+CW-complexes"} finite CW-complexes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} S^0
            %p
              Denote the canonical
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              inclusions by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Seq
                          %mtd
                            %mover
                              %mo ↪
                              %mi seq
                          %mtd
                            %mi Sym
                          %mtd
                            %mover
                              %mo ↪
                              %mi sym
                          %mtd
                            %mi Orth
                          %mtd
                            %mover
                              %mo ↪
                              %mi orth
                          %mtd
                            %msubsup
                              %mi Top
                              %mi fin
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                        %mtr
                          %mtd
                            %mi n
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi S
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi V
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi S
                              %mi V
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Seq
                    \&amp;\stackrel{seq}{\hookrightarrow}&amp;
                    Sym
                    \&amp;\stackrel{sym}{\hookrightarrow}&amp;
                    Orth
                    \&amp;\stackrel{orth}{\hookrightarrow}&amp;
                    Top_{fin}^{\ast/}
                    \\\
                    n
                    \&amp;\mapsto&amp;
                    \\{1,\cdots, n\}
                    \&amp;\mapsto&amp;
                    \\mathbb{R}^n
                    \&amp;\mapsto&amp;
                    S^n
                    \\\
                    \&amp;&amp;
                    \&amp;&amp;
                    V
                    \&amp;\mapsto&amp;
                    S^V
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
