                    %msub
                      %mn 1
                      %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f^\ast
                    \\;\colon\;
                    Mon([\mathcal{D}, Top^{\ast/}_{cg}], \otimes_{Day}, y(1_{\mathcal{D}}))
                    \\longrightarrow
                    Mon([\mathcal{C}, Top_{cg}^{\ast}], \otimes_{Day}, y(1_{\mathcal{C}})
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              are
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetricMonoidalCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+functor"} braided monoidal functor
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              also preserves
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoids+in+a+symmetric+monoidal+category"} commutative monoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
