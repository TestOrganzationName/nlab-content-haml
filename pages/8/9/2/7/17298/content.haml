                              %mo ⟶
                              %mrow
                                %msub
                                  %mi e
                                  %mi A
                                %mo ⊗
                                %mi id
                          %mtd
                            %mi E
                            %msub
                              %mo ⊗
                              %mi A
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi E
                                      %mo{:stretchy => "false"} /
                                      %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes_A E
                    \&amp;\overset{e_A \otimes id}{\longrightarrow}&amp;
                    E \otimes_A E
                    \\\
                    \&amp; {}_{\mathllap{\simeq}}\searrow &amp; \downarrow^{\mathrlap{\mu_{E/A}}}
                    \\\
                    \&amp;&amp; E
                    }
                    \\,.
            %p
              By forgetting the tensor product over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi E
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi e
                                %mo ⊗
                                %mi id
                          %mtd
                            %mi E
                            %mo ⊗
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
