            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo =
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                        %mo −
                        %mi k
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi S
