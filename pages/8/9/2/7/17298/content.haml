                        %msup
                          %mi 𝒞
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                  with the same
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  as
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
