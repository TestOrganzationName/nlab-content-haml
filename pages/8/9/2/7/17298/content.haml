                  %annotation{:encoding => "application/x-tex"} \gamma
              the total top
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              in this diagram gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
