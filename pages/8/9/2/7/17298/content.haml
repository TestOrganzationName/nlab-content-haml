                        %mi 𝒟
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 1
                        %mo ,
                        %msub
                          %mi d
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (\mathcal{C}\times \mathcal{D})((c_1,d_1),\;(c_2,d_2) )
                        \\coloneqq
                        \\mathcal{C}(c_1,c_2)\wedge \mathcal{D}(d_1,d_2)
                %p
                  and whose
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  operation is the
                  %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                  followed by the
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                  of the separate composition operations:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi 𝒞
                                %mo ×
                                %mi 𝒟
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
