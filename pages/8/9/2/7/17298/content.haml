            %p
              does
              %em not
              become highly connected as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              increases, due to the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              underlying the symmetric group. Accordingly the conclusion now is the opposite:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \lambda_n
              is not a stable weak homotopy equivalence in this case.
          %p
            Another use of free spectra is that their
            %a.existingWikiWord{:href => "/nlab/show/pushout+products"} pushout products
            may be explicitly analyzed, and checking the
            %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
            for general cofibrations may be reduced to checking it on morphisms between free spectra.
          #SmashProductOfFreeSpectra.num_lemma
            %h6#lemma_7 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} A, B \in Top^{\ast/}
              and for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ,
                      %mi ℓ
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k,\ell \in \mathbb{N}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              = succeed "," do
                %a.maruku-ref{:href => "#SymmetricSmashProductOfDiagramSpectra"}
              %a.existingWikiWord{:href => "/nlab/show/free+spectra"} free spectra
              from def.
              %a.maruku-ref{:href => "#FreeStructuredSpectrum"}
              relates to the plain
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              via
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi k
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ∧
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi ℓ
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mi ℓ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ∧
                    %mi B
                    %mo{:stretchy => "false"} )
