                        %mo ⊗
                        %mi Day
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([Top_{fin}^{\ast/}, Top^{\ast/}], \otimes_{Day})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi Seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth},\mathbb{S}_{Sym}, \mathbb{S}_{Seq}
              is the tensor unit in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi Orth
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi Day
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi Sym
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi Day
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi Seq
                      %mo ,
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi Day
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([Orth, Top^{\ast/}],\otimes_{Day}), ([Sym, Top^{\ast/}],\otimes_{Day}), ([Seq, Top^{\ast/}],\otimes_{Day})
            %p
              Nevertheless, because by prop.
              %a.maruku-ref{:href => "#PropertiesOfTopologicalDiagramCategoriesForSpectra"}
              the restriction functors are
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
              and because the tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              canonically has the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Orth
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi Seq
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Orth},\mathbb{S}_{Sym}, \mathbb{S}_{Seq}
              inherts the structure of a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              in the respective
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
