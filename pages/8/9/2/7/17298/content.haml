                      %mi q
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
