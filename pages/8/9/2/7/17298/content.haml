                    \\mathbb{S}_{Seq}Mod
                    \\simeq
                    SeqSpec(Top)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of the sequence of
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              to the right of the corresponding category of modules in the diagram below in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SystemOfAdjunctionsForDiagramSpectra"}
              %a.maruku-ref{:href => "#HighlyStructuredSpectraAsDayConvolutionSModules"}
              and landing in the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
          %p
            We would like to lift the horizontal adjunctions in the diagram in remark
            %a.maruku-ref{:href => "#SystemOfStructuredSpectraAndDiagrams"}
            from the bottom row to the top row. To that end, oberve that the
            %a.existingWikiWord{:href => "/nlab/show/categories+of+modules"} categories of modules
            involved here are themselves still
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+categories"} enriched functor categories
          #SModulesAsEnrichedFunctors.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dia
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %mi Orth
                    %mo ,
                    %mi Sym
                    %mo ,
                    %mi Seq
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} {dia} \in \{Top^{\ast/}, {Orth}, {Sym}, {Seq}\}
              be any one of the sites in def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalDiagramCategoriesForSpectra"}
            %ol
              %li
                %p
                  There is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                        %mi Mod
                        %mo ≃
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi 𝕊
                          %mi dia
                        %msup
                          %mi FreeMod
                          %mi op
                        %mo ,
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{S}_{dia} Mod \simeq [ \mathbb{S}_{dia} FreeMod^{op}, Top^{\ast/} ]
                %p
                  between the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
                  (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#HighlyStructuredSpectraAsDayConvolutionSModules"}
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  on the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
                  (hence for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dia
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %msup
                          %mi Top
                          %mo *
                        %mo{:stretchy => "false"} /
                        %mo ,
                        %mi Orth
                        %mo ,
                        %mi Sym
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} dia \in \{Top^\ast/, Orth,Sym\}
                  but not for
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dia
                          %mo =
                          %mi Seq
                        %annotation{:encoding => "application/x-tex"} dia = Seq
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                        %msup
                          %mi FreeMod
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia} FreeMod^{op}
                  carries a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                  structure such that under the above equivalence its
                  %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
                  is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
              %li
                %p
                  There is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi dia
                        %mo ⟶
                        %msub
                          %mi 𝕊
                          %mi dia
                        %msup
                          %mi FreeMod
                          %mi op
                      %annotation{:encoding => "application/x-tex"}
                        \\delta \colon dia \longrightarrow \mathbb{S}_{dia} FreeMod^{op}
                %p
                  which is monoidal when
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝕊
                          %mi dia
                      %annotation{:encoding => "application/x-tex"} \mathbb{S}_{dia}
                  is commutative and which is such that the (
                  %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  = succeed ")-adjunction" do
                    %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                  %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                  along
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi δ
                        %annotation{:encoding => "application/x-tex"} \delta
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi 𝕊
                                  %mi dia
                                %mi Mod
                              %mtd
                                %mo ≃
                              %mtd
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi 𝕊
                                  %mi dia
                                %msup
                                  %mi FreeMod
                                  %mi op
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mi U
                                %mo{:stretchy => "false"} ↓
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mpadded{:width => "0"}
                                    %mi F
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msup
                                        %mi δ
                                        %mo *
                                %mo{:stretchy => "false"} ↓
                                %msup
                                  %mo{:stretchy => "false"} ↑
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi δ
                                        %mo !
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} [
                                %mi dia
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                              %mtd
                                %mo =
                              %mtd
                                %mo{:stretchy => "false"} [
                                %mi dia
                                %mo ,
                                %msup
                                  %mi Top
                                  %mrow
                                    %mo *
                                    %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathbb{S}_{dia} Mod
                        \&amp;\simeq&amp;
