            %p
              In one direction, consider a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e_E \;\colon\; A \longrightarrow E
              and product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mrow
                          %mi E
                          %mo{:stretchy => "false"} /
                          %mi A
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %msub
                        %mo ⊗
                        %mi A
                      %mi E
                      %mo ⟶
                      %mi E
                    %annotation{:encoding => "application/x-tex"} \mu_{E/A} \colon E \otimes_A E \longrightarrow E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi E
                          %mtd
                            %munderover
                              %mphantom
                                %mi AAA
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟶
                                %mrow
                          %mtd
                            %mi E
                            %mo ⊗
                            %mi E
                          %mtd
                            %mover
                              %mo ⟶
                              %mi coeq
                          %mtd
                            %mi E
                            %msub
                              %mo ⊗
                              %mi A
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mi E
                            %mo ↘
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi E
                                      %mo{:stretchy => "false"} /
                                      %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E \otimes A \otimes E
                    \&amp;
                    \\underoverset
                    {\underset{}{\longrightarrow}}
                    {\overset{}{\longrightarrow}}
                    {\phantom{AAA}}
                    \&amp;
                    E \otimes E
                    \&amp;\overset{coeq}{\longrightarrow}&amp;
                    E \otimes_A E
                    \\\
                    \&amp;&amp; &amp; {}_{\mathllap{\mu_E}}\searrow &amp; \downarrow^{\mathrlap{\mu_{E/A}}}
                    \\\
                    \&amp;&amp; &amp;&amp; E
                    }
                    \\,.
            %p
              By considering a diagram of such coequalizer diagrams with middle vertical morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi E
                      %mo ∘
                      %msub
                        %mi e
                        %mi A
                    %annotation{:encoding => "application/x-tex"} e_E\circ e_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mu_E
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %msub
                      %mi μ
                      %mi E
                    %mo ,
                    %msub
                      %mi e
                      %mi E
                    %mo ∘
                    %msub
                      %mi e
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu_E, e_E \circ e_A)
              is a commutative monoid in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, 1)
            %p
              Then consider the two conditions on the unit
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi E
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ⟶
                      %mi E
                    %annotation{:encoding => "application/x-tex"} e_E \colon A \longrightarrow E
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
