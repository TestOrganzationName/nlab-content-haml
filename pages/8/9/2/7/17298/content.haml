                %a{:href => "sequential+spectrum#AsDiagramSpectra"} sequential spectra – As diagram spectra
          .proof
            %h6#proof_2 Proof
            %p
              The free
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Dia
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Dia}
              modules are those of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mi 𝕊
                        %mi Dia
                    %annotation{:encoding => "application/x-tex"} y(d)\wedge \mathbb{S}_{Dia}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi Dia
                  %annotation{:encoding => "application/x-tex"} d \in Dia
              is an object, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dia
                    %mo =
                    %mi Seq
                  %annotation{:encoding => "application/x-tex"} Dia = Seq
              this means that they are labeled by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi Seq
                    %mo ,
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F(k) \in [Seq,Top^{\ast/}]
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi n
                    %mo ↦
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
