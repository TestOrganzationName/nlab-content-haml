            %p Now finally observe that this projection function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    proj
                    \\;\colon\;
                    O(q)/O(q-n-1)
                    \\longrightarrow
                    O(q)/O(q-n)
            %p
              is
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo −
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (q - n -1 )
              = succeed ")." do
                %a{:href => "coset+space#CofiberSequencesOfCosetsOfOrthogonalGroups"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi q
                  %annotation{:encoding => "application/x-tex"} S^q
              is
              = succeed "-connected." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi q
                      %mo −
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2q - n -1 )
            %p
              The key here is the fast growth of the connectivity with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mi s
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mi n
                    %msub
                      %mi λ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{s+q}((\Sigma^n \lambda_n)_q)
              becomes an isomorphism. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mi n
                    %msub
                      %mi λ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Sigma^n \lambda_n
              is a stable weak homotopy equivalence and therefore so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi λ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \lambda_n
            %p
              %strong symmetric case
            %p
              Here the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
