                  %annotation{:encoding => "application/x-tex"} (Top_{cg}^{\ast/}, \wedge, S^0)
              from example
              = succeed "." do
                %a.maruku-ref{:href => "#PointedTopologicalSpacesWithSmashIsSymmetricMonoidalCategory"}
            %ol
              %li
                %p
                  The
                  %strong
                    pointed topologically enriched
                    %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
