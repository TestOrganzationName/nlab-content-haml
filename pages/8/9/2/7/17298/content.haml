                    \&amp; \stackrel{\simeq}{\longrightarrow} &amp; S^q
                    }
            %p
              which says that the image of any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi O
                    %mo{:stretchy => "false"} (
