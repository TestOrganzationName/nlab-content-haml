                    Cof_{stable} = (F I) Cof
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi I
                  %annotation{:encoding => "application/x-tex"} F I
              the class of
              %a.existingWikiWord{:href => "/nlab/show/free+spectra"} free spectra
              on the class of generating cofibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              = succeed "," do
