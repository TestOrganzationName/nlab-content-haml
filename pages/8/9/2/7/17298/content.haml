                    \\,.
            %p
              Hence according to lemma
              %a.maruku-ref{:href => "#SModulesAsEnrichedFunctors"}
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              are equivalently
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
