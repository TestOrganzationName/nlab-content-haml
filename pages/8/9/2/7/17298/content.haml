                    \\,.
          .proof
            %h6#proof_34 Proof
            %p
              This is an immediate corollary of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DayMonoidsAreLaxMonoidalFunctorsOnTheSite"}
          %h3#monoidal_homotopy_theory Monoidal homotopy theory
          %p
            We now combine the concepts of
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          #MonoidalModelCategory.num_defn
            %h6#definition_25 Definition
            %p
              A (symmetric)
              %strong monoidal model category
              is
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with the structure of a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, I)
              such that the following two compatibility conditions are satisfied
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"}> pushout-product axiom
                  ) For every pair of cofibrations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ′
                          %mo{:lspace => "verythinmathspace"} :
                          %mi X
                          %mo ′
                          %mo →
                          %mi Y
                          %mo ′
                        %annotation{:encoding => "application/x-tex"} f' \colon X' \to Y'
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  over ways of forming the tensor product of these objects
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊗
                        %mi Y
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %mi X
                            %mo ⊗
                            %mi X
                            %mo ′
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ⊗
                        %mi X
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Y
                        %mo ⊗
                        %mi Y
                        %mo ′
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (X \otimes Y') \coprod_{X \otimes X'} (Y \otimes X')
                        \\longrightarrow
                        Y \otimes Y'
                        \\,,
                %p
                  is itself a cofibration, which, furthermore, is acyclic if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f'
                  is.
                %p
                  (Equivalently this says that the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                        %mo :
                        %mi C
                        %mo ×
                        %mi C
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \otimes : C \times C \to C
                  is a left
                  = succeed ".)" do
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              %li
                %p
                  (unit axiom) For every cofibrant object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and every cofibrant resolution
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                        %mo ↪
                        %mi Q
                        %mi I
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi p
                              %mi I
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow Q I \stackrel{p_I}{\longrightarrow} \ast
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi I
                        %mo ⊗
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi p
                              %mi I
                            %mo ⊗
                            %mi X
                        %mi I
                        %mo ⊗
                        %mi X
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        Q I \otimes X \stackrel{p_I \otimes X}{\longrightarrow} I\otimes X \stackrel{\simeq}{\longrightarrow} X
            %p is a weak equivalence.
          .num_remark
            %h6#remark_9 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              in def.
              %a.maruku-ref{:href => "#MonoidalModelCategory"}
              implies that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a cofibrant object, then the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \otimes (-)
              preserves cofibrations and acyclic cofibrations.
            %p
              In particular if the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              happens to be cofibrant, then the unit axiom in def.
              %a.maruku-ref{:href => "#MonoidalModelCategory"}
              is implied by the pushout-product axiom.
          #MonoidAxiom.num_defn
            %h6#definition_26 Definition
            %p
              We say a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidalModelCategory"}
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/monoid+axiom"} monoid axiom
              = succeed "," do
                %a.maruku-ref{:href => "#MonoidalModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
              of
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              of
              %a.existingWikiWord{:href => "/nlab/show/tensor+products"} tensor products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mi f
                  %annotation{:encoding => "application/x-tex"} X\otimes f
              of acyclic cofibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a weak equivalence.
          %p
            (
            %a{:href => "#SchwedeShipley"}> Schwede-Shipley 00, def. 3.3.
            ).
          .num_remark
            %h6#remark_10 Remark
            %p
              In particular, the axiom in def.
              %a.maruku-ref{:href => "#MonoidAxiom"}
              says that for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \otimes (-)
              sends acyclic cofibrations to weak equivalences.
          #MonoidalStructureOnHomotopyCategoryOfMonoidalModelCategory.num_prop
            %h6#proposition_22 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes, I)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
              of the tensor product exsists and makes the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              into a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mo ⊗
                        %mi L
                      %mo ,
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Ho(\mathcal{C}), \otimes^L, \gamma(I))
            %p
              If in in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
              satisfies the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoid+axiom+in+a+monoidal+model+category"} monoid axiom
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma\colon \mathcal{C}\to Ho(\mathcal{C})
              carries the structure of a
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mo ⊗
                      %mi L
                    %mo ,
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma
                    \\;\colon\;
                    (\mathcal{C}, \otimes, I)
                    \\longrightarrow
                    (Ho(\mathcal{C}), \otimes^L , \gamma(I))
                    \\,.
          .proof
            %h6#proof_35 Proof
            %p
              Consider the explicit model of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              as the category of fibrant-cofibrant objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              with left/right-homotopy classes of morphisms between them (discussed at
              = succeed ")." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              exists if its restriction to this subcategory preserves weak equivalences. Now the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              implies that on the subcategory of cofibrant objects the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              preserves acyclic cofibrations, and then the preservation of all weak equivalences follows by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ⊗
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \otimes^L
              exists and its
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              follows simply by restriction. It remains to see its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
            %p
              To that end, consider the construction of the localization functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              via a fixed but arbitrary choice of (co-)fibrant replacements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Cof
                      %mrow
                        %msub
                          %mi i
                          %mi X
                    %mi Q
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                      %mrow
                        %msub
                          %mi p
                          %mi x
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Cof
                      %mrow
                        %msub
                          %mi j
                          %mi X
                    %mi R
                    %mi X
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi Fib
                      %mrow
                        %msub
                          %mi q
                          %mi x
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\emptyset \underoverset{\in Cof}{i_X}{\longrightarrow} Q X \underoverset{\in W \cap Fib}{p_x}{\longrightarrow} X
                    \\;\;\,,\;\;
                    X \underoverset{\in W \cap Cof}{j_X}{\longrightarrow} R X \underoverset{\in Fib}{q_x}{\longrightarrow} \ast
                    \\,.
            %p
              Now to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(I)
              is the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ⊗
                        %mi L
                    %annotation{:encoding => "application/x-tex"} \otimes^L
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %msub
                          %mi j
                          %mrow
                            %mi Q
                            %mi I
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mi Q
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi j
                          %mrow
                            %mi Q
                            %mi X
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mi I
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mi I
                    %mo ⊗
                    %mi Q
                    %mi X
                    %mo ≃
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    (R Q I) \otimes (R Q X)
                    \\overset{j_{Q I} \otimes (R Q X)}{\longleftarrow}
                    (Q I) \otimes (R Q X)
                    \\overset{(Q I)\otimes j_{Q X}}{\longleftarrow}
                    (Q I) \otimes (Q X)
                    \\overset{p_I \otimes (Q X)}{\longrightarrow}
                    I \otimes Q X
                    \\simeq
                    Q X
            %p
              all morphisms are weak equivalences: For the first two this is due to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(-)
              this zig-zig gives an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma(I) \otimes^L \gamma(X)\simeq \gamma(X)
            %p
              and similarly for tensoring with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma(I)
              from the right.
            %p
              To exhibit lax monoidal structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo ⊗
                      %mi L
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma(X) \otimes^L \gamma(Y) \longrightarrow \gamma(X \otimes Y)
            %p
              and show that it satisfies the the appropriate
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              and
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
              condition.
            %p
              By the definitions at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi R
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (R Q X) \otimes (R Q Y) \longrightarrow R Q (X\otimes Y)
            %p
              To this end, consider the
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟵
                      %mrow
                        %mo ∈
                        %mi Cof
                        %mo ∩
                        %mi W
                      %mrow
                        %msub
                          %mi j
                          %mrow
                            %mi Q
                            %mi X
                        %mo ⊗
                        %mi R
                        %mi Q
                        %mi Y
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟵
                      %mrow
                        %mo ∈
                        %mi Cof
                        %mo ∩
                        %mi W
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi j
                          %mrow
                            %mi Q
                            %mi Y
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mi X
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Y
                        %mo ⊗
                        %msub
                          %mi p
                          %mi Y
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (R Q X) \otimes (R Q Y)
                    \\underoverset{\in Cof \cap W}{j_{Q X} \otimes R Q Y}{\longleftarrow}
                    (Q X) \otimes (R Q Y)
                    \\underoverset{\in Cof \cap W}{(Q X) \otimes  j_{Q Y} }{\longleftarrow}
                    (Q X) \otimes (Q Y)
                    \\overset{p_X \otimes (Q Y)}{\longrightarrow}
                    X \otimes (Q Y)
                    \\overset{Y \otimes p_Y}{\longrightarrow}
                    X \otimes Y
                    \\,,
            %p
              and observe that the two morphisms on the left are weak equivalences, as indicated, by the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              satisfied by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
            %p
              Hence applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              to this zig-zag, which is given by the two horizontal part of the following digram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟵
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo ⊗
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi R
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mi X
                                      %mo ⊗
                                      %mi Q
                                      %mi Y
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo ⊗
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mrow
                                      %mi X
                                      %mo ⊗
                                      %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %mo ∈
                                %mi Cof
                                %mo ∩
                                %mi W
                              %mrow
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi X
                                %mo ⊗
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi Y
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mi X
                                %mo ⊗
                                %msub
                                  %mi p
                                  %mi Y
                          %mtd
                            %mi X
                            %mo ⊗
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (R Q X) \otimes (R Q Y) &amp;\longleftarrow&amp; R( Q X \otimes Q Y ) &amp;\longrightarrow&amp; R Q (X \otimes Y)
                    \\\
                    \\uparrow^{\mathrlap{id}} &amp;&amp; \uparrow^{\mathrlap{j_{Q X \otimes Q Y}}} &amp;&amp; \uparrow^{\mathrlap{j_{Q(X \otimes Y)}}}
                    \\\
                    \\downarrow^{\mathrlap{id}} &amp;&amp; \downarrow^{\mathrlap{id}} &amp;&amp; \downarrow^{\mathrlap{p_{X\otimes Y}}}
                    \\\
                    (R Q X) \otimes (R Q Y)
                    \&amp;\underoverset{\in Cof \cap W}{j_{Q X} \otimes j_{Q Y}}{\longleftarrow}&amp;
                    (Q X) \otimes (Q Y)
                    \&amp;\overset{p_X \otimes p_Y}{\longrightarrow}&amp;
                    X \otimes Y
                    }
                    \\,,
            %p and inverting the first two morphisms, this yields a natural transformation as required.
            %p
              To see that this satisfies associativity if the monoid axiom holds, tensor the entire diagram above on the right with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Q
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R Q Z)
              and consider the following
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟵
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi X
                            %mo ⊗
                            %mi Q
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mi X
                                      %mo ⊗
                                      %mi Q
                                      %mi Y
                                  %mo ⊗
                                  %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo ⊗
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                                  %mo ⊗
                                  %mi id
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mi Q
                            %mi Z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %mi id
                                %mo ⊗
                                %msub
                                  %mi j
                                  %mrow
                                    %mi Q
                                    %mi Z
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ⊗
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mi Z
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mrow
