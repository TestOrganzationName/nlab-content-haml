              %a.existingWikiWord{:href => "/nlab/show/excisive+functors"}> excisive functors
              , stable equivalences are stable weak homotopy equivalences (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#StableEquivalencesForDiagramSpectra"}
          %p
            (
            %a{:href => "#MMSS00"}> MMSS 00, p.31-32
            )
          .proof
            %h6#proof_idea Proof idea
            %p
              By theorem ref.
              = succeed "," do
                %a.maruku-ref{:href => "#StableModelStructuresOnDiagramSpectra"}
              %a.maruku-ref{:href => "#KInjectiveStableEquivalencesAreStrictEquivalences"}
              and
              = succeed "," do
                %a.maruku-ref{:href => "#RetractsOfRelativeKCellComplexesAreTheStableEquivalencesAndStrictCofibrations"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              followed by weak equivalence in the strict model structure. Since the latter is degreewise a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              it is in particular a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              is a stable weak homotopy equivalence.
            %p
              Observe now that we know this to be true for the elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              itself (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#GeneratingAndGeneratingAcyclicCofibrationsForDiagramSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi J
                  %annotation{:encoding => "application/x-tex"} F J
              are
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              of
              %a.existingWikiWord{:href => "/nlab/show/deformation+retracts"} deformation retracts
              and therefore
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalences"} stable weak homotopy equivalences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k_n
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeneratingAndGeneratingAcyclicCofibrationsForDiagramSpectra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \lambda_n
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#CorepresentationOfAdjunctsOfStructureMaps"}
              = succeed "." do
                %a.maruku-ref{:href => "#AdjunctsOfFreeSpectrumInclusionsAreOrAreNotStableWeakHomotopyEquivalences"}
              %a.existingWikiWord{:href => "/nlab/show/pushout+products"} pushout products
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mi n
                      %mo □
                      %mi i
                    %annotation{:encoding => "application/x-tex"} k_n \Box i
          %p
            This completes the proof of theorem
            = succeed "." do
              %a.maruku-ref{:href => "#RelationBetweenStableEquivalencesAndStableWeakHomotopyEquivalencesForDiagramSpectra"}
          %h4#QuillenEquivalencesOfStableModelStructures Quillen equivalences between the stable model structures
