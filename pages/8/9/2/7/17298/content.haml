                    %msub
                      %mi I
                      %mn 1
                    %mi Cof
                    %mo{:stretchy => "false"} )
                    %mo □
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi I
                      %mn 2
                    %mi Cof
                    %mo{:stretchy => "false"} )
                    %mo ⊂
