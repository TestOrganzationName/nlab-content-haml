                  %mi X
                %annotation{:encoding => "application/x-tex"} x\colon \ast \to X
            a
            %a.existingWikiWord{:href => "/nlab/show/global+point"} global point
            in any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
