          %h3#for_ringed_spaces For ringed spaces
          %p
            Consider a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msup
                    %mi f
                    %mo ♯
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,f^\sharp):(Y,\mathcal{O}_Y)\to(X,\mathcal{O}_X)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo ♯
                  %mo :
                  %msup
                    %mi f
                    %mo *
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo →
                  %msub
                    %mi 𝒪
                    %mi Y
                %annotation{:encoding => "application/x-tex"} f^\sharp:f^*\mathcal{O}_X\to\mathcal{O}_Y
            of sheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is surjective. Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                    %mo =
                    %msub
                      %mi ℐ
                      %mi f
                    %mo =
                    %mi Ker
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi f
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"} \mathcal{I} = \mathcal{I}_f = Ker\,f^\sharp
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi Y
                    %mo =
                    %msup
                      %mi f
                      %mo ♯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℐ
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_Y = f^\sharp(\mathcal{O}_X)/\mathcal{I}_f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^*(\mathcal{O}_Y)
            has the
            = succeed "-preadic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mo •
                  %mo =
                  %msub
                    %mo ⊕
                    %mi n
                  %msubsup
                    %mi ℐ
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} /
                  %msubsup
                    %mi ℐ
                    %mi f
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} Gr_\bullet =\oplus_{n} \mathcal{I}_f^n/\mathcal{I}^{n+1}_f
            which in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            gives the
            %a.existingWikiWord{:href => "/nlab/show/conormal+sheaf"} conormal sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mn 1
                  %mo =
                  %msub
                    %mi ℐ
                    %mi f
                  %mo{:stretchy => "false"} /
                  %msubsup
                    %mi ℐ
                    %mi f
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Gr_1 = \mathcal{I}_f/\mathcal{I}^2_f
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "-augmented" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msup
                    %mi f
                    %mo ♯
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ℐ
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,f^\sharp(\mathcal{O}_X)/\mathcal{I}^{n+1})
            is called the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %strong infinitesimal neighborhood
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            along morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
