                    \\underset{i \in i}{\sqcup} U_i \times k^n
                    \&amp;\overset{( \phi^1_i \circ f_i^{-1} )_{i \in I}}{\longrightarrow}&amp;
                    E_1
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\exists !}}
                    \\\
                    E_2
                    }
                    \\,.
            %p
              This unique function is clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              (by pointwise inspection) and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              is continuous.
          #FiberwiseLinearlyIndependentSectionsTrivialize.num_example
            %h6#example_14 Example
            %p
              %strong (fiberwise linearly independent sections trivialize a vector bundle)
            %p
              If a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              admits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundleSections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi σ
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\{\sigma_k \;\colon\; X \longrightarrow E\}_{k \in \{1, \cdots, n\}}
            %p
              that are linearly independent at each point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is trivializable (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (according to example
              = succeed ")," do
                %a.maruku-ref{:href => "#VectorBundleSections"}
              %em are
              the trivialization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi σ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\sigma_1, \cdots, \sigma_n)
                    \\;\colon\;
                    (X \times k^n)
                    \\overset{\simeq}{\longrightarrow}
                    E
                    \\,.
            %p
              This is because their linear independence at each point means precisely that this morphism of vector bundles is a fiber-wise linear isomorphsm and therefore an isomorphism of vector bundles by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#FiberwiseIsoisIsomorphismOfVectorBundles"}
          %h3#DirectSummandBundles Direct summand bundles
          %p
            We discuss properties of the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
            for topological vector bundles.
          #TopologicalSubBundlesOverParacompactHausdorffSpacesAreDirectSummands.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (sub-bundles over
                %a.existingWikiWord{:href => "/nlab/show/paracompact+spaces"} paracompact spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct summands
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              Then every topological vector sub-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ↪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E_1 \hookrightarrow E
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalVetorSubbundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo ↪
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E_2 \hookrightarrow E
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalVetorSubbundle"}
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi E
                      %mn 2
                    %mo ≃
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_1 \oplus E_2 \simeq E
                    \\,.
          %p
            (
            %a{:href => "#Hatcher"}> e.g. Hatcher, prop. 1.3
            )
          .proof
            %h6#proof_7 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is assumed to be paracompact Hausdorff, there exists an
              %a.existingWikiWord{:href => "/nlab/show/inner+product+on+vector+bundles"} inner product on vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %msub
                      %mo ⊕
                      %mi X
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle
                    \\;\colon\;
                    E \oplus_X E
                    \\longrightarrow
                    X \times k
            %p
              (by
              = succeed ")." do
                %a{:href => "inner+product+of+vector+bundles#ExistenceOfInnerProductOfTopologicalVectorBundlesOverParacompactHausdorffSpaces"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+complement"} orthogonal complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ′
                      %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mo ⊂
                    %msub
                      %mi E
                      %mi x
                  %annotation{:encoding => "application/x-tex"} (E'_x)^\perp \subset E_x
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ′
                        %mi x
                      %mo ↪
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E'_x \hookrightarrow E
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              of these orthogonal complements is readily checked to be a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ′
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ⊥
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (E')^\perp \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ′
                    %msub
                      %mo ⊕
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \;\simeq\; E' \oplus_X (E')^\perp
                    \\,.
          #TopologicalVectorbundleOverCompactHausdorffSpaceIsDirectSummandOfTrivialBundle.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (vector bundles over a
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
                are
                %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct summands
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              Then there exists another topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde E \to X
              such that the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
              of the two is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X \times k^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊕
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E \oplus \tilde E
                    \\;\simeq\;
                    X \times k^n
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              has a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi ϕ
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %msup
                          %mi k
                          %mi n
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi E
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\phi_i
                    \\;\colon\;
                    U_i \times k^n
                    \\overset{\simeq}{\longrightarrow}
                    E\vert_{U_i}
                    \\right\}_{i \in I}
                    \\,.
            %p
              By compactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+cover"} finite sub-cover
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J \subset I
              such tat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                        %mo ⊂
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\{U_i \subset X\}_{i \in J \subset I}
            %p
              is still an open cover over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              trivializes.
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+spaces+equivalently+admit+subordinate+partitions+of+unity"} paracompact Hausdorff spaces equivalently admit subordinate partitions of unity
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi f
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    f_i \;\colon\; X \to [0,1]
                    \\right\}_{i \in J}
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} supp(f_i) \subset U_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mphantom
                                %mi AAAA
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                        %mtr
                          %mtd
                            %mi v
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                            %msub
                              %mi f
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E\vert_{U_i}
                    \&amp;\overset{\phantom{AAAA}}{\longrightarrow}&amp;
                    U_i \times k^n
                    \\\
                    v
                    \&amp;\overset{\phantom{AAA}}{\mapsto}&amp;
                    f_i(x) \cdot \phi_i^{-1}(v)
                    }
            %p extend by 0 to vector bundle homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ⋅
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_i \cdot \phi^{-1}_i
                    \\;\colon\;
                    E
                    \\longrightarrow
                    X \times k^n
                    \\,.
            %p
              The finite pointwise
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these yields a vector bundle homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                    %msub
                      %mi f
                      %mi i
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo ⊕
                        %mrow
                          %mi i
                          %mo ∈
                          %mi J
                      %msup
                        %mi k
                        %mi n
                      %mo )
                    %mo ≃
                    %mi X
                    %mo ×
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi J
                            %mo{:stretchy => "false"} |
                          %mo ˙
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in J}{\oplus} f_i \cdot \phi_i
                    \\;\colon\;
                    E
                    \\longrightarrow
                    X \times \left(
                    \\underset{i \in J}{\oplus}
                    k^n
                    \\right)
                    \\simeq
                    X \times k^{n \dot {\vert J\vert}}
                    \\,.
            %p
              Observe that, as opposed to the single
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                      %mo ⋅
                      %msubsup
                        %mi ϕ
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} f_i \cdot \phi^{-1}_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              is non-vanishing. Hence this is an injection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              into a trivial vector bundle.
            %p
              With this the statement follows by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalSubBundlesOverParacompactHausdorffSpacesAreDirectSummands"}
          .num_remark
            %h6#remark_6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#TopologicalVectorbundleOverCompactHausdorffSpaceIsDirectSummandOfTrivialBundle"}
              is key in the analysis of
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              groups on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+spaces"} compact Hausdorff spaces
              %a{:href => "topological+K-theory#DirectSumHasInverseUpToTrivialBundle"} there
              for more.
          %h3#ConcordanceOfTopolgicslVectorBundles Concordance
          %p
            We discuss that every
            %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
            of topological vector bundles over a
            %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
            makes the restriction of the vector bundle over the endpoints of the interval isomorphic (prop.
            %a.maruku-ref{:href => "#ConcondanceOfTopologicalVectorBundles"}
            below). In particular this implies tht the
            %a.existingWikiWord{:href => "/nlab/show/pullbacks+of+vector+bundles"} pullbacks of vector bundles
            along two
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            are
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            (corollary
            %a.maruku-ref{:href => "#PullbackOfvectorBundlesAlongHomotopicMapsAreIsomorphic"}
            below).
          %p
            This result is apparently due to Steenrod, see Theorem 11.4 in
            = succeed "." do
              %a{:href => "#Steenrod"} Steenrod
            = succeed "." do
              %a{:href => "#Hatcher"} Hatcher, theorem 1.6
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi I
                %annotation{:encoding => "application/x-tex"} X \times I
            for the
            %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
            with the
            %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,1]
            equipped with its
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟵
                    %mrow
                      %msub
                        %mi p
                        %mi X
                  %mi X
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  X \overset{p_X}{\longleftarrow} X \times [0,1] \overset{p_{[0,1]}}{\longrightarrow} [0,1]
          %p
            for the two continuous
            %a.existingWikiWord{:href => "/nlab/show/projections"} projections
            out of the product space.
          #TrivilizationOfVectorBundleOverProductSpaceWithInterval.num_lemma
            %h6#lemma_2 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} E \to X \times [0,1]
              is trivializable (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \times [0,1/2]
              and to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \times [1/2,1]
              are trivializable.
          #CoverForProductSpaceWithIntrval.num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} E \to X \times I
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that the vector bundle trivializes over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ⊂
                      %mi X
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} U_i \times [0,1] \subset X \times [0,1]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
          .proof
            %h6#proof_9 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trvializability
              of the vector bundle, there exists an open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi I
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{V_j \subset X \times I\}_{j \in J}
              over which the bundle trivializes. For each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              this induces a cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{x\} \times [0,1]
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              (for instance by the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi x
                    %mo ⊂
                    %mi I
                  %annotation{:encoding => "application/x-tex"} J_x \subset I
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi i
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi I
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi J
                          %mi x
                  %annotation{:encoding => "application/x-tex"} \{V_i \subset X \times I\}_{i \in J_x}
              still covers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{x\} \times [0,1]
            %p
              By finiteness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi x
                    %annotation{:encoding => "application/x-tex"} J_x
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ≔
                    %munder
                      %mo ∩
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi J
                          %mi x
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U_x \coloneqq \underset{i \in J_x}{\cap} p_X(V_i)
            %p
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi p
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi I
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi J
                          %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\{ p_{[0,1]}(V_i) \subset I \}_{i \in J_x}
            %p
              is an open cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              such that the given vector bundle trivializes over each element of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi x
                      %mo ×
                      %msub
                        %mi p
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi i
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %msub
                            %mi J
                            %mi x
                    %annotation{:encoding => "application/x-tex"} \{U_x \times p_{[0,1]}(V_i)\}_{i \in J_x}
            %p
              By the nature of the Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              each
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a union of intervals. So we may pass to a
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of this cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              such that each element is a single interval. Again by compactness of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi W
                      %mrow
                        %mi x
                        %mo ,
                        %mi k
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\{W_{x,k} \subset [0,1]\}_{k \in K_x}
            %p
              each element of which is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo =
                    %msub
                      %mi t
                      %mn 0
                    %mo &lt;
                    %msub
                      %mi t
                      %mn 1
                    %mo &lt;
                    %msub
                      %mi t
                      %mn 2
                    %mo &lt;
                    %mi ⋯
                    %mo &lt;
                    %msub
                      %mi t
                      %mrow
                        %msub
                          %mi n
                          %mi x
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0 = t_0 \lt t_1 \lt t_2 \lt \cdots \lt t_{n_x} = 1\}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi k
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mn 0
                        %mo ≤
                        %mi k
                        %mo &lt;
                        %msub
                          %mi n
                          %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\{ [t_k, t_{k+1}] \subset [0,1] \}_{0 \leq k \lt n_x}
            %p
              is a cover of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi x
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi k
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} V_x \times [t_k, t_{k+1}]
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi k
                      %mo &lt;
                      %msub
                        %mi n
                        %mi x
                    %annotation{:encoding => "application/x-tex"} 0 \leq k \lt n_x
            %p
              By lemma
              %a.maruku-ref{:href => "#TrivilizationOfVectorBundleOverProductSpaceWithInterval"}
              this implies that the vector bundle in fact trivializes over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} U_x \times [0,1]
            %p
              Applying this procedure for all points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              yields a cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\{ U_x \subset X  \}_{x \in X}
            %p with the required property.
          #ConcondanceOfTopologicalVectorBundles.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
                of
                = succeed ")" do
