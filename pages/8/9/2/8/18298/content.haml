                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mi k
                            %msub
                              %mo ×
                              %mi X
                            %mi E
                            %mo →
                            %mi E
                          %annotation{:encoding => "application/x-tex"} (-)\cdot(-) \;\colon\;  k \times_X E \to E
                %p
                  which satisfy the
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            %p such that
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/local+trivialization"}> local triviality
                  ) there exists
                %ol
                  %li
                    %p
                      an
                      %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo ⊂
                              %mi X
                              %msub
                                %mo{:stretchy => "false"} }
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                            %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
                      %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi U
                            %mo ≔
