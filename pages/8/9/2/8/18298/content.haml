                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(O) = \underset{i \in I}{\cup} \phi_i(O_i)
              is open.
          #CoboundaryCech.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                between
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %msup
                      %mi C
