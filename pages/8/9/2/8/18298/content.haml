                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msqrt
                              %mrow
                                %mn 1
                                %mo −
                                %msup
                                  %mi z
                                  %mn 2
