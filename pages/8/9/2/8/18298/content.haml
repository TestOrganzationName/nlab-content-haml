              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/normal+bundle"}> normal bundle
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mi X
                    %mo ↪
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} i X \hookrightarrow Y
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+differentiable+manifolds"} embedding of differentiable manifolds
              %em
