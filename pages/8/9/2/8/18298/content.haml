                    \\right\}_{i,j \in I}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              (as in def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousFunctionWithValuesInGLn"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi U
                                      %mi i
                                    %mo ∩
                                    %msub
                                      %mi U
                                      %mi j
                          %mtd
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                                %mo ∩
                                %msub
                                  %mi U
                                  %mi j
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi j
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mi U
                                      %mi i
                                    %mo ∩
                                    %msub
                                      %mi U
                                      %mi j
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAA
                          %mtd
                          %mtd
                            %mrow
                              %mo (
                              %mi x
                              %mo ,
