                    \&amp;\overset{ \phi_i|_{U_i \cap U_j} }{\longrightarrow}&amp;
                    E|_{U_i \cap U_j}
                    \&amp;\overset{ \phi_j^{-1}\vert_{U_i \cap U_j} }{\longrightarrow}&amp;
                    (U_i \cap U_j) \times k^n
                    \\\
                    (x,v) &amp;&amp; \overset{\phantom{AAA}}{\mapsto} &amp;&amp; \left( x, g_{i j}(x)(v) \right)
                    }
                    \\,.
            %p
              These are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              for the given local trivialization.
          %p These functions satisfy a special property:
          #CocycleCech.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              A
              %em
                normalized
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
                of degree 1 with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline{GL(n,k)}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousFunctionWithValuesInGLn"}
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i,j \in I
                  a continuous function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo →
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g_{i j} \colon U_i \cap U_j \to GL(n,k)
                  as in def.
                  %a.maruku-ref{:href => "#ContinuousFunctionWithValuesInGLn"}
            %p such that
            %ol
              %li
                %p
                  (normalization)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mo ∀
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %mrow
                          %mo (
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi i
                          %mo =
                          %msub
                            %mi const
                            %mn 1
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\forall}\left( g_{i i} = const_1  \right)
                  (the
                  %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
                  in
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} GL(n,k)
              %li
                %p
                  (cocycle condition)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ∀
                            %mrow
                              %mi i
                              %mo ,
                              %mi j
                              %mo ∈
                              %mi I
                          %mrow
                            %mo (
                            %msub
                              %mi g
                              %mrow
                                %mi j
                                %mi k
                            %mo ⋅
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                            %mo =
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi k
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mtext on
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi U
                              %mi i
                            %mo ∩
                            %msub
                              %mi U
                              %mi j
                            %mo ∩
                            %msub
                              %mi U
                              %mi k
                            %mo )
                        %annotation{:encoding => "application/x-tex"} \underset{i,j \in I}{\forall}\left(  g_{j k} \cdot g_{i j}  = g_{i k}\;\;\text{on}\, U_i \cap U_j \cap U_k\right)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %munder
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^1(X, \underline{GL(n,k)}  )
            %p
              for the set of all such cocycles for given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %munder
                      %mi GL
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %munder
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^1( X, \underline{GL}(k) )
                    \\;\coloneqq\;
                    \\underset{n \in \mathbb{N}}{\sqcup}
                    C^1(X, \underline{GL(n,k)})
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of all these cocycles as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              varies.
          #CocycleCechTransitionFunction.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
                are
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              be a topological vector bundle (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\phi_i \colon U_i \times k^n \overset{\simeq}{\to} E|_{U_{i}}\}_{i \in I}
              be a local trivialization (example
              = succeed ")." do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
            %p
              Then the set of induced
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{g_{i j} \colon U_i \cap U_j \to GL(n)\}
              according to def.
              %a.maruku-ref{:href => "#TransitionFunctions"}
              is a
              = succeed "," do
                %em
                  normalized Cech cocycle on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  with coefficients in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mrow
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mo ̲
                      %annotation{:encoding => "application/x-tex"} \underline{GL(k)}
              = succeed "." do
                %a.maruku-ref{:href => "#CocycleCech"}
          .proof
            %h6#proof_2 Proof
            %p This is immediate from the definition:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi i
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo ∘
                            %msub
                              %mi ϕ
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
