                            %msub
                              %mi pr
                              %mn 1
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [U \times k^n \overset{pr_1}{\to} X]
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi U
                        %msub
                          %mo ×
                          %mi X
                        %mi E
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi pr
                              %mn 1
                        %mi U
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [U \times_X E \overset{pr_1}{\to} U]
                  are regarded as vector space objects in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi U
                      %annotation{:encoding => "application/x-tex"} Top_{U}
                  in the canonical way.
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is constant on
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and then called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              of the vector bundle.
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of topological vector bundles is simple a homomorphism of vector space objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} Top_{/X}
            %p
              Topological vector bundles over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and homomorphisms between them constitutes a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"} Vect(X)
          %p
            Notice that viewed in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi U
                          %mo ×
                          %msup
                            %mi k
                            %mi n
                        %mtd
                          %mover
                            %mo ⟶
                            %mo ≃
                        %mtd
                          %mi U
                          %msub
                            %mo ×
                            %mi X
                          %mi E
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi pb
                          %mo{:stretchy => "false"} )
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi π
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi U
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  U \times k^n
                  \&amp;\overset{\simeq}{\longrightarrow}&amp;
                  U \times_X E
                  \&amp;\overset{}{\longrightarrow}&amp;
                  E
                  \\\
                  \&amp; \searrow &amp; \downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{\pi}}
                  \\\
                  \&amp;&amp; U &amp;\longrightarrow&amp; X
                  }
          %p
            where the square is a
            %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
            and the
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            in the top left is fiber-wise linear.
          %p If we say this yet more explicitly, it yields the definition as found in the traditional textbooks:
          %h3#in_components In components
          #TopologicalVectorBundle.num_defn
            %h6#definition_3 Definition
            %p
              %strong (topological vector bundle in components)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %em topological vector bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi π
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{\pi}{\to} X
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  the stucture of a
                  %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mi x
                        %mo ≔
                        %msup
                          %mi π
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E_x \coloneqq \pi^{-1}(\{x\}) \subset E
            %p
              such that this is
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} locally trivial
              in that there exists
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo ⊂
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                      %annotation{:encoding => "application/x-tex"} i \in I
                  an
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mi i
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n_i \in \mathbb{N}
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %msup
                          %mi k
                          %mrow
                            %msub
                              %mi n
                              %mi i
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msup
                          %mi π
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mi E
                      %annotation{:encoding => "application/x-tex"}
                        \\phi_i \;\colon\; U_i \times k^{n_i} \overset{\simeq}{\longrightarrow} \pi^{-1}(U_i) \subset E
                %p
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                      %annotation{:encoding => "application/x-tex"} U_i
                  with the
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  (equipped with their
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} U_i
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                          %annotation{:encoding => "application/x-tex"} \phi_i
                      is a map over
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi U
                              %mi i
                          %annotation{:encoding => "application/x-tex"} U_i
                      in that
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi π
                              %mo ∘
                              %msub
                                %mi ϕ
                                %mi i
                              %mo =
                              %msub
                                %mi pr
                                %mn 1
                            %annotation{:encoding => "application/x-tex"} \pi \circ \phi_i = pr_1
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %msup
                              %mi k
                              %mrow
                                %msub
                                  %mi n
                                  %mi i
                            %mo{:stretchy => "false"} )
                            %mo ⊂
                            %msup
                              %mi π
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \phi_i(\{x\} \times k^{n_i}) \subset \pi^{-1}(\{x\})
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi ϕ
                              %mi i
                          %annotation{:encoding => "application/x-tex"} \phi_i
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
                      in each fiber in that
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mo ∀
                              %mrow
                                %mi x
                                %mo ∈
                                %msub
                                  %mi U
                                  %mi i
                            %mrow
                              %mo (
                              %msub
                                %mi ϕ
                                %mi i
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mi k
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                              %mover
                                %mo ⟶
                                %mtext linear
                              %msub
                                %mi E
                                %mi x
                              %mo =
                              %msup
                                %mi π
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            \\underset{x \in U_i}{\forall}
                            \\left(
                            \\phi_i(x) \;\colon\;
                            k^{n_i} \overset{\text{linear}}{\longrightarrow}
                            E_x = \pi^{-1}(\{x\})
                            \\right)
                            \\,.
            %p
              Often, but not always, it is required that the numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi i
                  %annotation{:encoding => "application/x-tex"} n_i
              are all equal to some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %em
                %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              this is automatic, but the fiber dimension may be distinct over distinct
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \overset{\pi_1}{\to} X]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi π
                          %mn 2
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \overset{\pi_2}{\to} X]
              two topological vector bundles over the same base space, then a
              %em
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between them is
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi E
                        %mn 1
                      %mo ⟶
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f \colon E_1 \longrightarrow E_2
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  respects the
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/projections"} projections
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                          %mo ∘
                          %mi f
                          %mo =
                          %msub
                            %mi π
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \pi_2 \circ f = \pi_1
              %li
                %p
                  for each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  we have that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                      %annotation{:encoding => "application/x-tex"} f|_x \colon (E_1)_x \to (E_2)_x
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
          #TopologicalVectorBundlesCategory.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"}> category of topological vector bundles
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the topological vector bundles over
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the topological vector bundle homomorphisms
            %p
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"} Vect(X)
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                  %annotation{:encoding => "application/x-tex"} Vect(X)_{/\sim}
              for the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of this category.
          %p
          #FiberwiseOperations.num_remark
            %h6 Remark
            %p
              %strong (fiberwise operations)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/FinDimVect"} FinDimVect
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
              over a
              %a.existingWikiWord{:href => "/nlab/show/topological+field"} topological
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              is canonically a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %a.existingWikiWord{:href => "/nlab/show/product+categories"} product categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi FinDimVect
                        %mi n
                    %annotation{:encoding => "application/x-tex"} FinDimVect^{n}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi FinDimVect
                      %mi n
                    %mo ⟶
                    %mi FinDimVect
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\;\colon\;
                    FinDimVect^n
                    \\longrightarrow
                    FinDimVect
            %p
              induces a functorial construction of new topological vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒱
                      %mn 1
                    %mo ,
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi 𝒱
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{F}(\mathcal{V}_1,, \cdots, \mathcal{V}_n)
              from any
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"} n-tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒱
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒱
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi 𝒱
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{V}_1, \mathcal{V}_2 , \cdots, \mathcal{V}_n)
              of vector bundles over the same base space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b \in B
              to be (e.g.
              = succeed "):" do
                %a{:href => "#MilnorStasheff74"} Milnor &amp; Stasheff 1974, p. 32
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝒱
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi 𝒱
                      %mi n
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒱
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒱
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\big(
                    \\mathcal{V}_1,
                    \\cdots
                    \\mathcal{V}_n
                    \\big)
                    _b
                    \\;\coloneqq\;
                    F
                    \\big(
                    (\mathcal{V}_1)_b,
                    \\cdots,
                    (\mathcal{V}_n)_b
                    \\big)
                    \\,.
            %p For example:
            %ul
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi FinDimVect
                        %mo ⟶
                        %mi FinDimVect
                      %annotation{:encoding => "application/x-tex"} F \,\coloneqq\, (-)^\ast \,\colon\, FinDimVect \longrightarrow FinDimVect
                  is the operation of forming
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dual+vector+spaces"} dual vector spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{F}
                  constructs the fiberwise
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mi det
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %mi FinDimVect
                        %mo ⟶
                        %mi FinDimVect
                      %annotation{:encoding => "application/x-tex"} F \,\coloneqq\, det \,\colon\, FinDimVect \longrightarrow FinDimVect
                  is the operation of forming
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/determinants"} determinants
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{F}
                  is the construction of fiberwise
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundles"} determinant line bundles
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo ⊕
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi FinDimVect
                          %mn 2
                        %mo ⟶
                        %mi FinDimVect
                      %annotation{:encoding => "application/x-tex"} F \,\coloneqq\, \oplus \,\colon\, FinDimVect^2 \longrightarrow FinDimVect
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of vector space, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{F}
                  constructs the fiberwise
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+vector+bundles"} direct sum of vector bundles
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"}> Whitney sum
                  ”);
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mo ⊗
                        %mspace{:width => "thinmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi FinDimVect
                          %mn 2
                        %mo ⟶
                        %mi FinDimVect
                      %annotation{:encoding => "application/x-tex"} F \,\coloneqq\, \otimes \,\colon\, FinDimVect^2 \longrightarrow FinDimVect
                  is the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ^
                      %annotation{:encoding => "application/x-tex"} \widehat{F}
                  constructs the fiberwise
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
            %p
          #TerminologyVectorBundles.num_remark
            %h6#remark_2 Remark
            %p
              %strong (some terminology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              be as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
              one speaks of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{C}
              one speaks of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              one speaks of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/line+bundles"} line bundles
              %em
                %a.existingWikiWord{:href => "/nlab/show/real+line+bundles"} real line bundles
              and of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
          #CommonOpenCoverLocalTrivialization.num_remark
            %h6#remark_3 Remark
            %p
              %strong
                (any two topologial vector bundles have
                %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
                over a common
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \to X]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \to X]
              be two topological vector bundles (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              such that both bundles have a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              over this cover.
          .proof
            %h6#proof Proof
            %p
              By definition we may find two possibly different open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                      %mn 1
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mrow
                          %msub
                            %mi i
                            %mn 1
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \{U^1_{i_1} \subset X\}_{{i_1} \in I_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                      %mn 2
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi i
                          %mn 2
                        %mo ∈
                        %msub
                          %mi I
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \{U^2_{i_2} \subset X\}_{i_2 \in I_2}
              with local tivializations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                      %mn 1
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                          %mn 1
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                          %mn 1
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \{ U^1_{i_1} \underoverset{\simeq}{\phi^1_{i_1}}{\to} E_1\vert_{U^1_{i_1}} \}_{i_1 \in I_1}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 2
                        %mn 2
                      %munderover
                        %mo →
                        %mo ≃
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mrow
                              %msub
                                %mi i
                                %mn 2
                            %mn 2
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msubsup
                            %mi U
                            %mrow
                              %msub
                                %mi i
                                %mn 2
                            %mn 2
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %msub
                            %mi i
                            %mn 2
                          %mo ∈
                          %msub
                            %mi I
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \{ U^2_{i_2} \underoverset{\simeq}{\phi^2_{i_2}}{\to} E_2\vert_{U^2_{i_2}} \}_{i_2 \in I_2}
            %p
              The
              %em
                joint
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of these two covers is the open cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                            %mo ,
                            %msub
                              %mi i
                              %mn 2
                        %mo ≔
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                          %mn 1
                        %mo ∩
                        %msubsup
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 2
                          %mn 2
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %msub
                          %mi i
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                        %mo ×
                        %msub
                          %mi I
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_{i_1, i_2}
                    \\coloneqq
                    U^1_{i_1} \cap U^2_{i_2}
                    \\subset
                    X
                    \\right\}_{(i_1, i_2) \in I_1 \times I_2}
                    \\,.
            %p The original local trivializations restrict to local trivializations on this finer cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                            %mo ,
                            %msub
                              %mi i
                              %mn 2
                        %munderover
                          %mo ⟶
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msubsup
                                  %mi U
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 2
                                  %mn 2
                        %msub
                          %mi E
                          %mn 1
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mrow
                                %msub
                                  %mi i
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi i
                                  %mn 2
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi i
                          %mn 1
                        %mo ,
                        %msub
                          %mi i
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi I
                          %mn 1
                        %mo ×
                        %msub
                          %mi I
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    U_{i_1, i_2}
                    \\underoverset{\simeq}{\phi^1_{i_1}\vert_{U^2_{i_2}}}{\longrightarrow}
                    E_1\vert_{U_{i_1, i_2}}
                    \\right\}_{(i_1, i_2) \in I_1 \times I_2}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                            %mo ,
                            %msub
                              %mi i
