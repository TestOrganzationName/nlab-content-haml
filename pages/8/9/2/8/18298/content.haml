                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi i
                                    %mn 1
                                  %mo ∘
                                  %msubsup
                                    %mi f
                                    %mi i
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi f
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi j
                                    %mn 1
                                  %mo ∘
                                  %msubsup
                                    %mi f
                                    %mi j
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 2
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                                %mo ∩
                                %msub
                                  %mi U
                                  %mi i
                          %mtd
                            %munder
                              %mo ⟶
