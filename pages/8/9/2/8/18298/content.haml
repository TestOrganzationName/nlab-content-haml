                            %mi i
                            %mi α
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_+ \cap U_-
                    \&amp;\overset{g_{\pm \mp}}{\longrightarrow}&amp;
                    GL(1,\mathbb{C})
