          %h2#properties Properties
          %h3#BasicProperties Basic properties
          #FiberwiseIsoisIsomorphismOfVectorBundles.num_lemma
            %h6#lemma Lemma
            %p
              %strong (homomorphism of vector bundles is isomorphism as soon as it is a fiberwise isomorphism)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_1 \to X]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [E_2 \to X]
              be two topological vector bundles (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopologicalVectorBundle"}
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of vector bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \longrightarrow E_2
              restricts on the
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              over each point to a linear isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                  %annotation{:encoding => "application/x-tex"}
                    f\vert_x \;\colon\; (E_1)_x \overset{\simeq}{\longrightarrow} (E_2)_x
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is already an isomorphism of vector bundles.
          .proof
            %h6#proof_6 Proof
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has an
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              of underlying sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo →
                      %mi E
                    %msub
                      %mo
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1} \colon E_2 \to _E_1
              which is a function over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              it it the linear inverse
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                    %annotation{:encoding => "application/x-tex"} (f\vert_x)^{-1} \colon (E_2)_x \to (E_1)_x
            %p What we need to show is that this is a continuous function.
            %p
              By remark
              %a.maruku-ref{:href => "#CommonOpenCoverLocalTrivialization"}
              we find an open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              over which both bundles have a local trivialization.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %munderover
                          %mo →
                          %mo ≃
                          %mrow
                            %msubsup
                              %mi ϕ
                              %mi i
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi U
                              %mi i
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ U_i \underoverset{\simeq}{\phi^1_i}{\to} (E_1)\vert_{U_i}\right\}_{i \in I}
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    \\left\{ U_i \underoverset{\simeq}{\phi^2_i}{\to} (E_2)\vert_{U_i} \right\}_{i \in I}
                    \\,.
            %p
              Restricted to any patch
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              of this cover, the homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} f|_{U_i}
              induces a homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundles"} trivial vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ≔
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mn 2
                    %msup
                      %mo
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo ∘
                    %msubsup
                      %mi ϕ
                      %mi i
                      %mn 1
                    %mphantom
                      %mi AAAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 1
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi f
                                  %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mrow
                                      %msub
                                        %mi U
                                        %mi i
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mi i
                                  %mn 2
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
