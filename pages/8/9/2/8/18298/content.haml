            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo ±
                    %mo ≔
                    %msup
                      %mi S
                      %mn 2
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %mo ±
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_\pm \coloneqq S^2 \setminus \{(0, 0, \pm 1)\}
                    \\,.
            %p Define continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mo +
                            %mo ∩
                            %msub
                              %mi U
                              %mo −
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mrow
                                    %mo ±
                                    %mo ∓
                          %mtd
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
