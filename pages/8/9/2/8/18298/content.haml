            %p
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#CoboundaryCech"}
          .proof
            %h6#proof_4 Proof
            %p
              By example
              %a.maruku-ref{:href => "#FinerCoverCech"}
              we may assume without restriction that the two Cech cocycles are defined with respect to the same open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
