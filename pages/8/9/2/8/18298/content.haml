                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mi E
                            %msub
                              %mo ×
                              %mi X
                            %mi E
                            %mo →
                            %mi E
                          %annotation{:encoding => "application/x-tex"} (-)+(-) \;\colon\; E \times_X E \to E
                  %li
                    %p
                      a morphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
