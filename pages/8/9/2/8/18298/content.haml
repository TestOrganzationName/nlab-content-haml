                                  %mi ϕ
                                  %mi i
                                  %mn 1
                                %mo ∘
                                %msubsup
                                  %mi f
                                  %mi i
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
