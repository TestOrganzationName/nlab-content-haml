            %p
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 2
                      %mi π
                      %mo{:stretchy => "false"} /
                      %mn 6
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon \in (0,2\pi/6)
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              cocycle (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#CechCoycleCondition"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi n
                                %mn 1
                              %mo ,
                              %msub
                                %mi n
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo ,
                              %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi n
                                %mn 1
                              %mo ,
                              %msub
                                %mi n
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo ,
                              %mn 0
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    g_{n_1 n_2} =
                    \\left\{
                    \\array{
                    const_{-1} &amp; \vert &amp; (n_1,n_2) = (0,2)
                    \\\
                    const_{-1} &amp;\vert&amp; (n_1,n_2) = (2,0)
                    \\\
                    const_1 &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/moebiusstrip.jpg", :width => "200"}/
            %p Since there are no non-trivial triple intersections, all cocycle conditions are evidently satisfied.
            %p
              Accordingly by example
              %a.maruku-ref{:href => "#TopologicalVectorBundleFromCechCocycle"}
              these functions define a vector bundle. This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Moebius+strip"} Moebius strip
          .num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"}> basic complex line bundle on the 2-sphere
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                      %mo +
                      %msup
                        %mi z
                        %mn 2
                      %mo =
                      %mn 1
                      %mo }
