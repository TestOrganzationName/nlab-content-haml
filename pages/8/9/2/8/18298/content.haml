                    \\left\{ g_{i j} \coloneqq  \phi_j^{-1}\circ \phi_i  \colon U_i \cap U_j \to GL(n,k) \right\}_{i,j \in I}
            %p
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              (def.
