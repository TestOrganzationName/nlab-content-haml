                of bundle on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
