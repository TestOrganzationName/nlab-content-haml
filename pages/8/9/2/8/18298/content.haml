                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} n \colon I \to \mathbb{N}
                      some
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
