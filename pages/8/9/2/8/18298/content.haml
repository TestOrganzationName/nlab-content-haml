          #TransitionFunctions.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transition+functions"}> transition functions
                )
            %p
              Given a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
              as in def.
              %a.maruku-ref{:href => "#TopologicalVectorBundle"}
              and a choice of
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\phi_i \colon U_i \times k^n \overset{\simeq}{\to} E|_{U_i}\}
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialTopologicalVectorBundle"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i,j \in I
              induced
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo{:stretchy => "false"} )
                        %mo ⟶
