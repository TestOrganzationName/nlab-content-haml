                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϕ
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} U_i
                    \\times
                    k^n
                    \\overset{(\phi_i)_{i \in I}}{\longrightarrow }
                    E
                    \\,.
            %p
              By construction this function respects the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on the disjoint union space given by the transition functions, in that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo ∩
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} x \in U_i \cap U_j
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi j
                    %mo ∘
                    %msubsup
                      %mi ϕ
                      %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mi j
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
