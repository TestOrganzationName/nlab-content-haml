                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
