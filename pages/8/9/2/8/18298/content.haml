                      %annotation{:encoding => "application/x-tex"} \{g_{i j} \colon U_i \cap U_j \to GL(k,n_)\}_{i,j \in I}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
