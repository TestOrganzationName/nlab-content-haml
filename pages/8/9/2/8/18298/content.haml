          %h2#references References
          %p
            The original reference for many results about bundles, including the theorem that
            %a.existingWikiWord{:href => "/nlab/show/concordance"} concordance
            implies
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %ul
            %li#Steenrod
              %a.existingWikiWord{:href => "/nlab/show/Norman+Steenrod"}> Norman Steenrod
              ,
              = succeed "," do
                %em The Topology of Fibre Bundles
              = succeed "&rbrack;" do
                %a{:href => "https://www.jstor.org/stable/j.ctt1bpm9t5"} jstor:j.ctt1bpm9t5
          %p Further textbook accounts:
          %ul
            %li#MilnorStasheff74
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
                = succeed "," do
                  %em Characteristic classes
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/books/paperback/9780691081229/characteristic-classes-am-76-volume-76"} ISBN:9780691081229
                = succeed "," do
                  %a{:href => "https://doi.org/10.1515/9781400881826"} doi:10.1515/9781400881826
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/milnstas.pdf"} pdf
            %li
              %p
                Glenys Luke, Alexander S. Mishchenko,
                = succeed "," do
                  %em Vector bundles and their applications
                = succeed "," do
                  %strong 447
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=99m:55019"} MR99m:55019
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dale+Husemoeller"}> Dale Husemoeller
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Joachim"} Michael Joachim
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Branislav+Jurco"} Branislav Jurco
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Martin+Schottenloher"} Martin Schottenloher
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Basic+Bundle+Theory+and+K-Cohomology+Invariants"} Basic Bundle Theory and K-Cohomology Invariants
                = succeed ")" do
                  %a{:href => "http://www.mathematik.uni-muenchen.de/~schotten/Texte/978-3-540-74955-4_Book_LNP726corr1.pdf"} pdf
          %p
            Lecture notes with an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li#Wirthmuller12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Klaus+Wirthm%C3%BCller"}> Klaus Wirthmüller
                ,
                = succeed "," do
                  %em Vector bundles and K-theory
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/wirthmueller-vector-bundles-and-k-theory.pdf", :title => "pdf"} pdf
            %li#Hatcher
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                , chapter 1 of
                = succeed "," do
