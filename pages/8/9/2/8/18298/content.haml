                    \&amp;
                    \\uparrow^{\mathrlap{f^{-1}}}
                    \&amp; \nwarrow^{\mathrlap{ \phi^1_j \circ f_j^{-1} }}
                    \\\
                    U_i \times k^n
                    \&amp;\underset{\phi^2_i}{\longrightarrow}&amp;
                    (E_2)\vert_{U_i \cap U_i}
                    \&amp;\underset{(\phi^2_j)^{-1}}{\longrightarrow}&amp;
                    U_i \times k^n
                    }
                    \\,.
            %p
              Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
              %a.existingWikiWord{:href => "/nlab/show/extension"} extend
              to a unique continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_2 \to E_1
              such that the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi i
                            %msub
                              %mi U
                              %mi i
                            %mo ×
