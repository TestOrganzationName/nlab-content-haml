          #CechCoboundaryFromIsomorphismBetweenVectoreBundles.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                of topological vector bundles induces
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                between their
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a topological space, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %msup
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %munder
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1, c_2 \in C^1(X, \underline{GL(n,k)}  )
              be two Cech cocycles as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#CocycleCech"}
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of topological vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
