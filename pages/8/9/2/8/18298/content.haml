          .proof
            %h6#proof_10 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CoverForProductSpaceWithIntrval"}
              there exists an open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
