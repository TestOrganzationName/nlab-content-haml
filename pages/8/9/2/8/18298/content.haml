              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mo *
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} q^\ast E'
              of a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} E' \to X/A
              over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
          .proof
            %h6#proof_15 Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mi ϕ
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \times k^n
                    \\underoverset{\simeq}{\phi}{\longrightarrow}
                    E\vert_A
            %p
              be an isomorphism of vector bundles over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi A
                  %annotation{:encoding => "application/x-tex"} E\vert_A
              the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %msup
                      %mi ϕ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^{-1}(x,v) \sim \phi^{-1}(x',v)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi x
                    %mo ′
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x,x' \in A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ∈
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} v \in k^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mo ≔
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    E' \coloneqq E/\sim
            %p
              be the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ′
                      %mi x
                    %mo =
                    %msub
                      %mi E
                      %mi x
                  %annotation{:encoding => "application/x-tex"} E'_x = E_x
              while for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
              we have a canonical identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ′
                        %mrow
                          %mi x
                          %mo{:stretchy => "false"} /
                          %mi A
                      %mo ≃
                      %msup
                        %mi k
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E'_{x/A} \simeq k^n
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi E
                            %mo ′
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mo{:stretchy => "false"} (
                                      %mi x
                                      %mo ,
                                      %mi v
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                      %mo{:stretchy => "false"} |
                                    %mtd
                                      %mi x
                                      %mo ∈
                                      %mi X
                                      %mo ∖
                                      %mi A
                                  %mtr
                                    %mtd
                                      %msubsup
                                        %mi ϕ
                                        %mi x
                                        %mrow
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                      %mo{:stretchy => "false"} (
                                      %mi v
                                      %mo{:stretchy => "false"} )
                                    %mtd
                                      %mo{:stretchy => "false"} |
                                    %mtd
                                      %mi x
                                      %mo ∈
                                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E
                    \&amp;\overset{}{\longrightarrow}&amp;
                    E'
                    \\\
                    (x,v) &amp;\mapsto&amp; \left\{ \array{ (x,v) &amp;\vert&amp; x \in X \setminus A  \\ \phi^{-1}_x(v) &amp;\vert&amp; x\in A }  \right.
                    }
                    \\,.
            %p Since the composite continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi p
                    %mi X
                    %mover
                      %mo ⟶
                      %mi q
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    E \overset{p}{\longrightarrow} X \overset{q}{\longrightarrow} X/A
            %p
              respects the equivalence relation (in that it sends any two equivalent points to the same image point) the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the quotient space yields a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ′
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    p' \;\colon\; E' \to X/A
            %p
              such that the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi p
                                  %mo ′
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi q
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;\longrightarrow&amp; E'
                    \\\
                    {}^{\mathllap{p}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p'}}
                    \\\
                    X &amp;\overset{q}{\longrightarrow}&amp; X/A
                    }
                    \\,.
            %p
              We claim that this is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %p
              By the above description of the top horizontal function, it is a pullback diagram of underlying sets. Hence we need to see that the topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              has a
              %a.existingWikiWord{:href => "/nlab/show/base+for+a+topology"} base
              given by the pre-images of the open subsets in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} E'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} E'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              that either do not contain a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,v)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x \in A
              or if they do, then they also contain all the points of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %msubsup
                      %mi ϕ
                      %mrow
                        %mi x
                        %mo ′
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x', \phi_{x'}^{-1}(\phi_x(v)))
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x' \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,v)
              is in the open subset for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi v
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,v')
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              in some open ball in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
              containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              yields a basis for the topology.
            %p
              Hence it only remains to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mover
                      %mo ⟶
                      %mrow
                        %mi p
                        %mo ′
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} E' \overset{p'}{\longrightarrow} X/A
              is a vector bundle. The fiberwise linearity is clear, we need to show that it is locally trivializable.
            %p
              To that end, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an open cover over which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              has a local trivialization. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              is assumed to be closed, it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ∖
                        %mi A
                        %mo ⊂
                        %mi X
                        %mo ∖
                        %mi A
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ U_i \setminus A \subset X \setminus A\right\}_{i \in I}
            %p
              is an open cover of the complement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+space+topology"} quotient space topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∖
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X\setminus A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} U/A
              of an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ∖
                    %mi A
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} }
                    %mo ⊔
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo ⊂
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\{ U_i \setminus A \subset X/A \} \sqcup \{ U/A \subset X/A \}
            %p
              is an open cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} X/A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                    %mover
                      %mo →
                      %mrow
                        %mi p
                        %mo ′
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} E' \overset{p'}{\to} X/A
              it is clear that this bundle has a local trivialization over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              does, and similarly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E'
              trivializes over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} U/A
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              trivializes over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              does indeed exist by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#IsomorphismOfVectorBundlesOnClosedSubsetOfCompactHausdorffSpaceExtendsToOpenNeighbourhoods"}
          .num_remark
            %h6#remark_7 Remark
            %p
              Prop
              %a.maruku-ref{:href => "#VectorBundleOnClosedSubsetOfCompactHausdorffSpaceIsPullbackOfBundeOnQuotientSpace"}
              is the reason why
              %a.existingWikiWord{:href => "/nlab/show/reduced+K-theory"} reduced
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              satisfies the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+in+cohomology"} long exact sequences in cohomology
              that make it a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology+theory"} generalized (Eilenberg-Steenrod) cohomology theory
          #VectorBundlesOverQuotientByContractibleSubspaceAreEquivalentToVectorBundlesOnTotalSpace.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \subset X
              a
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
              %a.existingWikiWord{:href => "/nlab/show/subspace"} subspace
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X/A
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              (
              %a{:href => "quotient+space#QuotientBySubspace"}> this example
              ) with quotient coprojection denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi A
                    %annotation{:encoding => "application/x-tex"} q \colon X \longrightarrow X/A
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible topological space
              then the
              %a.existingWikiWord{:href => "/nlab/show/pullback+bundle"} pullback bundle
              construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mo ⟶
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    q^\ast \;\colon\; Vect(X/A)_{/\sim} \longrightarrow Vect(X)_{/\sim}
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_16 Proof
            %p
              By example
              %a.maruku-ref{:href => "#TopologicalVectorBundleOverContractibleSpaceIsTrivializable"}
              every vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              is trivializable over the contractible subspace
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.maruku-ref{:href => "#VectorBundleOnClosedSubsetOfCompactHausdorffSpaceIsPullbackOfBundeOnQuotientSpace"}
              implies that it is in the image of the pullback bundle map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi q
                        %mo *
                    %annotation{:encoding => "application/x-tex"} q^\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} q^\ast
              is surjective. Finally, it is clear that it is injective. Therefore it is bijective.
          .num_example
            %h6#example_17 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [0,1] \subset \mathbb{R}
              the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              with its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %p There is
            %ol
              %li
                %p
                  the ordinary
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
                  %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi I
                      %annotation{:encoding => "application/x-tex"} X \times I
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/reduced+cylinder"} reduced cylinder
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∧
                        %msub
                          %mi I
                          %mo +
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo ×
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \wedge I_+ = (X \times I)/( \{x\} \times I )
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                  with the interval that has a base point freely adjoined
            %p and
            %ol
              %li
                %p
                  the ordinary
                  %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mi X
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi I
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S X \coloneqq (X \times I)/( X \times \{0,1\} )
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                          %mi X
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                          %mo ×
                          %mi I
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Sigma X \coloneqq (S X)/( \{x\} \times I )
            %p
              In both cases the reduced space is obtained from the unreduced space by quotienting out the contractible closed subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I \simeq \{x\} \times I
              and hence topological vector bundles do not see the difference between the reduced and the unreduced spaces, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#VectorBundlesOverQuotientByContractibleSubspaceAreEquivalentToVectorBundlesOnTotalSpace"}
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebraic+vector+bundle"} algebraic vector bundle
            %li
              %p
