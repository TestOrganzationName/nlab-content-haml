                %a.existingWikiWord{:href => "/nlab/show/Moebius+strip"}> Moebius strip
                )
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
