                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} U_i \times [0,1]
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              %a{:href => "paracompact+topological+space#CountableCoverOfUnionsofOpenSubsetsInsideGivenCover"} this lemma
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/countable+cover"} countable cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
