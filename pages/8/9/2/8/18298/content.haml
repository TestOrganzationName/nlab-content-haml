                    \\phi_i((x,i),v)
                    \=
                    \\phi_j \circ \phi_j^{-1} \circ \phi_i((x,i),v)
                    \=
                    \\phi_j \circ ((x,j),g_{i j}(x)(v))
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              coprojection this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (\phi_i)_{i \in I}
              uniquely
              %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              to a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              on the quotient space such that the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo (
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msub
                                %mi U
                                %mi i
                              %mo )
                            %mo ×
                            %msup
                              %mi k
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ϕ
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi i
                                    %mo ∈
                                    %mi I
                          %mtd
                            %mi E
                        %mtr
                          %mtd
