                  %annotation{:encoding => "application/x-tex"} A \subset X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
            %p
              If a topological vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
