          %p As a consequence:
          #VectorBundleOnClosedSubsetOfCompactHausdorffSpaceIsPullbackOfBundeOnQuotientSpace.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial
                over
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
