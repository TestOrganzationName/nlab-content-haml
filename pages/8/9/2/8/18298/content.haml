                                %mi k
                                %mi n
                              %mo )
                            %mo{:stretchy => "false"} /
                            %mrow
                              %mo (
                              %msub
                                %mrow
                                  %mo {
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi j
                                  %mo }
                                %mrow
                                  %mi i
                                  %mo ,
                                  %mi j
                                  %mo ∈
                                  %mi I
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\left(
                    \\underset{i \in I}{\sqcup} U_i
                    \\right)
                    \\times
                    k^n
                    \&amp;\overset{(\phi_i)_{i \in I}}{\longrightarrow}&amp;
                    E
                    \\\
                    \\downarrow  &amp; \nearrow_{\exists !}
                    \\\
                    \\left(
                    \\left(
                    \\underset{i \in I}{\sqcup} U_i
                    \\right)
                    \\times
                    k^n
                    \\right)
                    \/
                    \\left(
                    \\left\{
                    g_{i j}
                    \\right\}_{i,j \in I}
                    \\right)
                    }
                    \\,.
            %p
              It is clear that this continuous function is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
              (by
              = succeed ")." do
                %a{:href => "Introduction+to+Topology+--+1#HomeoContinuousOpenBijection"} this prop.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
              be an subset in the quotient space which is open. By definition of the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
              this means equivalently that its restriction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mi i
                  %annotation{:encoding => "application/x-tex"} O_i
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_i \times k^n
              is open for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i
              are homeomorphsms, it follows that the images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mi i
                  %annotation{:encoding => "application/x-tex"} \phi_i(O_i)  \subset  E\vert_{U_ i}
              are open. By the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
