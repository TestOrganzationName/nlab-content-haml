                      %annotation{:encoding => "application/x-tex"} p^2
              %br/
              For a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %ol
              %li
                %p
                  For all
                  %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
