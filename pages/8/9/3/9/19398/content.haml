                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  satisfies the
                  = succeed "-condition" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi p
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} p^2
                  = succeed ")." do
                    %a.maruku-ref{:href => "#pqCondition"}
              %li
                %p
                  For all
                  %a.existingWikiWord{:href => "/nlab/show/prime+number"} primes
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %a.existingWikiWord{:href => "/nlab/show/Sylow+p-subgroup"} Sylow p-subgroup
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is either cyclic or (if
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
