                        %mi v
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi v
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \vec v \,=\, (v_1, \cdots, v_{n+1})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} v_i \,\in\, \mathbb{H}
              (i.e. quaternionic
              = succeed ")" do
