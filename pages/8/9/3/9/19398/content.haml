                    \\,.
            %p
          %p
          #EquivalentVersionsOfPSquareCondition.num_prop
            %h6 Proposition
            %p
              %strong
                (equivalent statements of the
                = succeed "-condition)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi p
