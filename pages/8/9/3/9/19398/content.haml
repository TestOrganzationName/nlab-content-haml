              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              on the unit-
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℍ
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi q
                      %mo{:stretchy => "false"} ¯
                    %mo ⋅
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℍ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"}
                    Sp(1)
                    \\;\coloneqq\;
                    \\big\{
                    q \,\in\, \mathbb{H}^\times
                    \\,\vert\,
                    \\bar q \cdot q \,=\, 1
                    \\big\}
                    \\;\subset\;
                    \\mathbb{H}^\times
            %p we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo |
                              %mi q
                              %mo ⋅
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} →
                              %mo |
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo ⋅
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo †
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo ⋅
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} →
                              %mo †
                            %mo ⋅
                            %munder
                              %munder
                                %mrow
                                  %msup
                                    %mi q
                                    %mo †
                                  %mo ⋅
                                  %mi q
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 1
                            %mo ⋅
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} →
                              %mo †
                            %mo ⋅
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mrow
                                %mo |
                                %mover
                                  %mi v
                                  %mo{:stretchy => "false"} →
                                %mo |
                              %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left\vert
                    q \cdot \vec v
                    \\right\vert
                    \&amp;
                    \\;=\;
                    (q \cdot \vec v)^\dagger
                    \\cdot
                    (q \cdot \vec v)
                    \\\
                    \&amp;
                    \\;=\;
                    \\vec v^\dagger
                    \\cdot
                    \\underset{ = 1}{\underbrace{q^\dagger \cdot q}}
                    \\cdot
                    \\vec v
                    \\\
                    \&amp;
                    \\;=\;
                    \\vec v^\dagger \cdot \vec v
                    \\\
                    \&amp;
                    \\;=\;
                    \\left\vert \vec v\right\vert^2
                    \\,,
                    \\end{aligned}
            %p
              showing that the left multiplication action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(1)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℍ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}^{n+1}
              does restrict to an action on its unit sphere. Moreover, since quaternion-multiplication is clearly
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+topology"} Euclidean topology
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                      %msub
                        %mo ≃
                        %mi ℝ
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{H} \simeq_{\mathbb{R}} \mathbb{R}^4
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 4
                          %mi n
                          %mo +
                          %mn 3
                    %annotation{:encoding => "application/x-tex"} S^{4n+3}
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                    %mspace{:width => "thinmathspace"}
                    %mo ∋
                    %mspace{:width => "thinmathspace"}
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo ↦
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mi q
                      %mo{:stretchy => "false"} ¯
                    %mo ⋅
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H} \,\ni\, q \,\mapsto\, \bar q \cdot q \,\in\, \mathbb{R}
              is positive definite (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi q
                      %mo{:stretchy => "false"} ¯
                    %mo ⋅
                    %mi q
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \bar q \cdot q = 0 \,\;\Leftrightarrow\;\, q = 0
              ), at least one of the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec v
              needs to be non-zero in order for
              %a.maruku-eqref{:href => "#eq:UnitNormConditionOnQuaternionicVectors"} (1)
              to hold. But on this component the left action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ↦
                    %mspace{:width => "thinmathspace"}
                    %mi q
                    %mo ⋅
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"} v_i \,\mapsto\, q \cdot v_i
              is left-multiplication in the
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℍ
                      %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi ℍ
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}^{\times} \,=\, \mathbb{H} \setminus \{0\}
              and hence is free, as the multiplication action of any group on itself is free.
          %p
          .num_remark
            %h6 Remark
            %p
              While an analogous argument as in Ex.
              %a.maruku-ref{:href => "#FiniteADEGroupsActFreelyOnFourNPlusThreeSpheres"}
              shows that with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊂
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \subset Sp(1)
              also the
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} G^{n+1}
              canonically acts on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 4
                        %mi n
                        %mo +
                        %mn 3
                  %annotation{:encoding => "application/x-tex"} S^{4n+3}
              by componentwise left multiplication, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              this action is no longer free, as the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %em no
              free action on spheres of any dimension, see Smith’s
              = succeed "-condition" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p^2
              %a.maruku-ref{:href => "#SmithPSquareCondition"}
              below).
          %h4#Involutions Free involutions
          %p
            The
            %a{:href => "#BasicExamplesOfFreeActionsOnSpheres"} above examples
            of free actions on spheres are all on odd-dimensional spheres, except when the group is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
            (Rem.
            %a.maruku-ref{:href => "#ZTwoActionsAreInvolutions"}
            below), where the antipodal free action (Ex.
            = succeed ")" do
              %a.maruku-ref{:href => "#ActionOfZModTwoByAntipodalInversion"}
            %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
            (Prop.
            %a.maruku-ref{:href => "#OnlyZModTwoCanActFreelyOnEvenDimensionalSpheres"}
            below), and, as in the canonical example, all free involutions on even-dimensional spheres are
            = succeed "-reversing," do
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            %a.maruku-ref{:href => "#FreeZModTwoActionOnEvenDimSphereMustBeOrientationReversing"}
            below).
          %p
            While, therefore, all free involutions on a given
            = succeed "-sphere" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
            to the antipodal involution (Rem.
            %a.maruku-ref{:href => "#FreeInvolutionsOnNSphereAllHaveTheSameHomotopyClass"}
            below), at least in the
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of
            %a.existingWikiWord{:href => "/nlab/show/piecewise-linear+structure"} piecewise-linear
            and of
            %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth
            actions there are families of distinct exotic involutions on
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.maruku-ref{:href => "#NonStandardFreeInvolutions"}
            below).
          %p
          #OnlyZModTwoCanActFreelyOnEvenDimensionalSpheres.num_prop
            %h6 Proposition
            %p
              %strong
                (only
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                has free actions on even-dimensional spheres)
              %br/
              The only
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              with any
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %a.existingWikiWord{:href => "/nlab/show/G-space"} continuous action
              on a
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} S^{2n}
              of
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimension
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
          .proof
            %h6 Proof
            %p
              Given a fixed-point free-action, the
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                    %mover
                      %mo →
                      %mi q
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} S^{2n} \xrightarrow{q} S^{2n}/G
              is a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              with
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ord
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} deg(q) = ord(G)
              equal to the
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Euler+characteristics"} Euler characteristics
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(-)
              and using that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi(-)
                  is always an
                  %a.existingWikiWord{:href => "/nlab/show/integer"} integer
                  (by definition);
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} \chi(S^{2n}) = 2
                  (by
                  = succeed ");" do
                    %a{:href => "Euler+characteristic#EulerCharacteristicOfSpheres"} this Prop.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi(-)
                  of any finite covering coprojection is multiplication by the degree (
                  %a{:href => "Euler+characteristic#EulerCharacteristicOfCoveringSpaces"}> this Prop.
                  )
            %p
              we obtain the
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ord
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    2
                    \\;=\;
                    \\chi(S^{2n})
                    \\;=\;
                    ord(G) \cdot \chi(S^{2n}/G)
                    \\,.
            %p
              The only solutions for this algebraic equation (over the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ord
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} ord(G) \,\in\, \{1, 2\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ord
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} ord(G) = 1
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ord
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} ord(G) = 2
              and the only group of that order is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              = succeed "." do
                %a.maruku-ref{:href => "#ActionOfZModTwoByAntipodalInversion"}
          .num_remark
            %h6 Remark
            %p
              The nature of the
              %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              of finite group actions on even-dimensional spheres is discussed in
              = succeed "." do
                %a{:href => "#Craciun13"} Craciun 2013
          %p
          #ZTwoActionsAreInvolutions.num_remark
            %h6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}>
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                \-
                %a.existingWikiWord{:href => "/nlab/show/group+action"} actions
                are equivalently
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/involutions"} involutions
              %br/
              Any
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ×
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \rho \,\colon\, \mathbb{Z}/2 \times S^n \to S^n
              of the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              is determined by its value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \rho(\sigma) \,\colon\, S^n \to S^n
              on the single non-trivial element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \sigma \,\in\, \mathbb{Z}/2
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
          %p
          #FreeZModTwoActionOnEvenDimSphereMustBeOrientationReversing.num_prop
            %h6 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %ul
              %li
                %p
                  on an
                  = succeed "-dimensional" do
                    %a.existingWikiWord{:href => "/nlab/show/even+number"} even
                  = succeed "-reversing;" do
                    %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
              %li
                %p
                  on an
                  = succeed "-dimensional" do
                    %a.existingWikiWord{:href => "/nlab/show/even+number"} odd
                  = succeed "-preserving." do
                    %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
            %p
          .proof
            %h6 Proof
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lefschetz+fixed+point+theorem"} Lefschetz fixed point theorem
              %a{:href => "Lefschetz+trace+formula#FixedPointTheoremForHomeomorphismsOfnSpheres"} this example
              for details.
          %p
          #FreeInvolutionsOnNSphereAllHaveTheSameHomotopyClass.num_remark
            %h6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#FreeZModTwoActionOnEvenDimSphereMustBeOrientationReversing"}
              implies that the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+class"} homotopy class
              of any fixed-point free
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \,\colon\, S^{n} \to S^n
              is, as an element in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"} homotopy groups of spheres
            %ul
              %li
                %p
                  on an
                  = succeed "-dimensional" do
                    %a.existingWikiWord{:href => "/nlab/show/even+number"} even
                  = succeed "-sphere," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 2
                          %mi k
                        %annotation{:encoding => "application/x-tex"} n = 2k
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi σ
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mo −
                        %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi π
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        [\sigma] \,=\, - 1 \,\in\, \mathbb{Z} \,\simeq\, \pi_{2k}(S^{2k})
              %li
                %p
                  on an
                  = succeed "-dimensional" do
                    %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd
                  = succeed "-sphere," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo =
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n = 2k+1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi σ
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mo +
                        %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo ≃
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi π
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [\sigma] \,=\, + 1 \,\in\, \mathbb{Z} \,\simeq\, \pi_{2k+1}(S^{2k+1})
                        \\,.
            %p
              which means that every free involution on any
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
              to the antipodal involution (Ex.
              %a.maruku-ref{:href => "#ActionOfZModTwoByAntipodalInversion"}>
              ).
          Nevertheless, there are in general several involutions on any given
          = succeed "-sphere" do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
          %em not
          %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
          to the antipodal involution as
          = succeed "-actions," do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
          %p
          #NonStandardFreeInvolutions.num_remark
            %h6 Example
            %p
              %strong
                (non-standard free smooth involutions on
                = succeed "-spheres)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %br/
              There are, in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group+action"} actions
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %ul
              %li
                %p
                  a single free involution on the
                  %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} S^3
                  (hence the antipodal Ex.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ActionOfZModTwoByAntipodalInversion"}
                %p
                  (
                  %a{:href => "#Livesay60"}> Livesay 1960
                  )
              %li
                %p
                  at least 2 distinct free involutions on the
                  %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} S^4
                %p
                  (
                  %a{:href => "#FintushelStern81"}> Fintushel &amp; Stern 1981
                  )
              %li
                %p
                  4 distinct free involutions on the
                  %a.existingWikiWord{:href => "/nlab/show/5-sphere"} 5-sphere
                  %a.existingWikiWord{:href => "/nlab/show/5-sphere"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 5
                        %annotation{:encoding => "application/x-tex"} S^5
              %li
                %p
                  4 distinct free involutions on the
                  %a.existingWikiWord{:href => "/nlab/show/6-sphere"} 6-sphere
                  %a.existingWikiWord{:href => "/nlab/show/6-sphere"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 6
                        %annotation{:encoding => "application/x-tex"} S^6
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi card
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo ⊕
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 28
                        %mo ⊕
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} card(\mathbb{Z}/2 \oplus \mathbb{Z}/28 \oplus \mathbb{Z})
                  distinct free involutions on the
                  %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
                  %a.existingWikiWord{:href => "/nlab/show/7-sphere"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 7
                        %annotation{:encoding => "application/x-tex"} S^7
                %p
                  (
                  %a{:href => "#LopezdeMedrano71"}> López de Medrano, Sec. V.6.1
                  )
            %p
          Here all spheres are equipped with their standard smooth structure (?), it is just the extra involutions which are non-standard.
          %p
            Similarly, there are non-standard involutions on
            = succeed "-spheres" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/piecewise-linear+structures"} piecewise-linear structures
            (
            %a{:href => "#LopezdeMedrano71"}> López de Medrano, p. 2 (11 of 114)
            ) following a similar pattern.
          %p
          #NonStandardFreeTopologicalInvolutions.num_remark
            %h6 Example
            %p
              %strong
                (non-standard free continuous involutions on
                = succeed "-spheres)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              There are also plenty of non-standard involutions on
              = succeed "-spheres" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              By the analog of the
              = succeed "-theorem" do
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+conjecture"} Poincaré conjecture
              = succeed ")," do
                %a{:href => "#Newman66"} Newman 1966, Thm. 7
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of a
              %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
              has a double
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              which is a manifold of the homotopy type of an
              = succeed "-sphere," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to an
              = succeed "-sphere." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Therefore, topological involutions on
              = succeed "-spheres" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "s," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}P^n
              = succeed ")." do
                %a{:href => "https://mathoverflow.net/a/407390/381"} Belegradek, MO:407390
          %h4#GeneralObstructionToAndExistenceOfFreeActions General obstructions and existence
          %p
            Not all
            %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
            have any free continuous action on any
            = succeed "-sphere:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            is Smith’s “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mn 2
                %annotation{:encoding => "application/x-tex"} p^2
            \-condition” (Prop.
            %a.maruku-ref{:href => "#SmithPSquareCondition"}
            below), another is Milnor’s “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 2
                  %mi p
                %annotation{:encoding => "application/x-tex"} 2 p
            \-condition” (Prop.
            %a.maruku-ref{:href => "#Milnor2PCopndition"}
            below). But these are the only two obstructions, and a finite group that evades these is guaranteed to act not just continuously on a sphere of a single dimension, but smoothly on spheres of any dimension which is a multiple of its
            %a.existingWikiWord{:href => "/nlab/show/Artin-Lam+induction+exponent"} Artin-Lam induction exponent
            (Prop.
            %a.maruku-ref{:href => "#MadsenThomasWallTheorem"}
            below).
          %p
          #SmithPSquareCondition.num_prop
            %h6 Proposition
            %p
              %strong
                (Smith’s
                = succeed "-condition)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi p
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} p^2
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p \times \mathbb{Z}/p
              and more generally the higher powers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ≥
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}/p)^{\geq 2}
              of the prime
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              do
              %em not
              have any
              %a.existingWikiWord{:href => "/nlab/show/G-space"} continuous
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free action
              on any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
          (
          %a{:href => "#Smith44"}> Smith 1944, p. 107 (4 of 5)
          )
          %p
          .num_remark
            %h6 Remark
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+finitely+generated+abelian+groups"} fundamental theorem of finitely generated abelian groups
              %a.maruku-ref{:href => "#SmithPSquareCondition"}
              immediately implies that if a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              has any
              %a.existingWikiWord{:href => "/nlab/show/G-space"} continuous
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free action
              on any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p^2
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^2
            %p
              This condition has come to be called the “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p^2
              \-condition” (Def.
              %a.maruku-ref{:href => "#pqCondition"}
              below).
          %p
          #pqCondition.num_defn
            %h6 Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p q
                condition)
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p, q
              a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is said to satisfy the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p q
                \-condition
              if all
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⋅
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p \cdot q
              are
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ord
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi p
                    %mi q
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
