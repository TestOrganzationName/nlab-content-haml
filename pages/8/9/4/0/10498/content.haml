                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi v
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo +
                      %msub
                        %mi v
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(v_1, v_2, v_3) = Q(v_1 + v_2 + v_3) - Q(v_1 + v_2) - Q(v_1 + v_3) - Q(v_2 + v_3) + Q(v_1) + Q(v_2) + Q(v_3)
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} p = 4
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
