                      %mo +
                      %msub
                        %mi v
                        %mn 2
                      %mo +
                      %msub
                        %mi v
                        %mn 4
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi v
                        %mn 3
                      %mo +
                      %msub
                        %mi v
                        %mn 4
                      %mo{:stretchy => "false"} )
