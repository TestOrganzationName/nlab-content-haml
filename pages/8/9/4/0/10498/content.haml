                        %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"}> homotopy hypothesis
                        \-theorem
          %h1#the_polarization_identity The polarization identity
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#statements"} Statements
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#higher_order"} Higher order
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#literature"} Literature
          %h2#idea Idea
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/symmetric+bilinear+form"} symmetric bilinear form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-) \cdot (-)
            defines a
            %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} (-)^2
            %em polarization identity
            reconstructs the bilinear form from the quadratic form.
          %p
            More generally, starting from any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            = succeed "A" do
              %br/
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sesquilinear+forms"} sesquilinear forms
          %p
            The whole business actually applies to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+maps"} bilinear maps
            %a.existingWikiWord{:href => "/nlab/show/base+field"} base field
            or some other
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/line"} line
            %a.existingWikiWord{:href => "/nlab/show/addition"} addition
            (and
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/subtraction"} subtraction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            for the best results. It is also possible to generalize from quadratic forms to higher-order homogenous forms if we can divide by larger integers.
          %h2#statements Statements
          %p Let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                be a
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V,\, W
                be
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:lspace => "verythinmathspace"} :
                      %mi V
                      %mo ×
                      %mi V
                      %mo →
                      %mi W
                    %annotation{:encoding => "application/x-tex"} m\colon V \times V \to W
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
              %p
                (an
                = succeed "-module" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊗
                      %mi V
                      %mo →
                      %mi W
                    %annotation{:encoding => "application/x-tex"} V \otimes V \to W
                out of their
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi V
                      %mo →
                      %mi W
                    %annotation{:encoding => "application/x-tex"} Q\colon V \to W
                be the
                %a.existingWikiWord{:href => "/nlab/show/quadratic+map"} quadratic map
                given by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Q(x) \coloneqq m(x,x)
              %p
                (NB: this is
                %em not
                an
                = succeed "-module" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
          %p Then we have:
          %ul
            %li
              %p
                the
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/parallelogram+law"} parallelogram law
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 2
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      2 Q(x) + 2 Q(y) \,=\, Q(x + y) + Q(x - y)
                      \\,,
          %p and
          %ul
            %li
              %p
                the
                = succeed ":" do
                  %strong polarization identity
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mn 2
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      2 m(x,y) + 2 m(y,x) \,=\, Q(x + y) - Q(x - y)
                      \\,.
          %p
            Writing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(x)
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                %annotation{:encoding => "application/x-tex"} x^2
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(x,y)
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x y
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 2
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %mn 2
                      %msup
                        %mi y
                        %mn 2
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 x^2 + 2 y^2 = (x + y)^2 + (x - y)^2
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 2
                      %mi x
                      %mi y
                      %mo +
                      %mn 2
                      %mi y
                      %mi x
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 x y + 2 y x = (x + y)^2 - (x - y)^2
                \.
          %p The polarization identity also has these alternative forms:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                      %mo +
                      %mi y
                      %mi x
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo −
                      %msup
                        %mi x
                        %mn 2
                      %mo −
                      %msup
                        %mi y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x y + y x = (x + y)^2 - x^2 - y^2
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                      %mo +
                      %mi y
                      %mi x
                      %mo =
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x y + y x = x^2 + y^2 - (x - y)^2
                ;
          %p
            these may derived by adding or subtracting the parallelogram law and the first polarization identity assuming that multiplication by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is cancellable in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p The most general form of such expressions is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi x
                  %mi y
                  %mo +
                  %mi k
                  %mi y
                  %mi x
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi c
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi i
                  %mi x
                  %mo +
                  %msub
                    %mi b
                    %mi i
                  %mi y
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  k x y + k y x = \sum_i c_i (a_i x + b_i y)^2
          %p
            for any
            %a.existingWikiWord{:href => "/nlab/show/finite+sequence"} finite sequence
            of triples
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b,c)
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msubsup
                    %mi a
                    %mi i
                    %mn 2
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msubsup
                    %mi b
                    %mi i
                    %mn 2
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\sum_i a_i ^ 2 c_i = \sum_i b_i ^ 2 c_i = 0
                  \\,,
          %p if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mi b
                    %mi i
                  %msub
                    %mi c
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  k = \sum_i a_i b_i c_i
                  \\,.
          %p
            In the three specific versions of the polarization identity listed above, the values of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            are all always
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
            %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
            of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rig"} rig
            %a.existingWikiWord{:href => "/nlab/show/centipede+mathematics"} centipede mathematics
            since I don't know any application of that case.)
          %p
            Now suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is
            = succeed "," do
              %span.newWikiWord
                symmetric
                %a{:href => "/nlab/new/symmetric+bilinear+map"} ?
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                    %mo =
                    %mi y
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x y = y x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is (not merely cancellable but also) invertible in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} 1/2 \in R
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                      %mo =
                      %mfrac
                        %mn 1
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo −
                      %mfrac
                        %mn 1
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x y = \frac{1}{4} (x + y)^2 - \frac{1}{4} (x - y)^2
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                      %mo =
                      %mfrac
                        %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo −
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi x
                        %mn 2
                      %mo −
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi y
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x y = \frac{1}{2} (x + y)^2 - \frac{1}{2} x^2 - \frac{1}{2} y^2
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi y
                      %mo =
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %mfrac
                        %mn 1
                        %mn 2
                      %msup
                        %mi y
                        %mn 2
                      %mo −
                      %mfrac
                        %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x y = \frac{1}{2} x^2 + \frac{1}{2} y^2 - \frac{1}{2} (x - y)^2
                \.
          %p
            That is, we may recover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            (in any of these ways). The second one is probably the most widely used. Regardless of the original symmetry of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mi y
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mi y
                  %mo +
                  %mi y
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} x \circ y = (x y + y x)/2
            (the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Jordan+product"} Jordan product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \circ y
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∘
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mi x
                      %mo +
                      %msub
                        %mi b
                        %mi i
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %mn 2
                      %msub
                        %mi a
                        %mi i
                      %msub
                        %mi b
                        %mi i
                      %msub
                        %mi c
                        %mi i
                %annotation{:encoding => "application/x-tex"}
                  x \circ y
                  \\;=\;
                  \\frac{\sum_i c_i (a_i x + b_i y)^2}
                  {\sum_i 2 a_i b_i c_i}
          %p
            when the sums of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi a
                    %mn 2
                  %mi c
                %annotation{:encoding => "application/x-tex"} a^2 c
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi b
                    %mn 2
                  %mi c
                %annotation{:encoding => "application/x-tex"} b^2 c
            are zero (as above) and the sum in the denominator is invertible. (In that case, one could also normalize the
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            must be invertible to have any hope of recovering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            or its symmetrization; but we could recover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi y
                  %mo +
                  %mi y
                  %mi x
                %annotation{:encoding => "application/x-tex"} x y + y x
            without that.
          %p
            We can also go the other direction: given a quadratic map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is invertible, then any polarization identity defines a symmetric bilinear map
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            obeys the parallelogram law, and then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            may be recovered from this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            once more.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/star-ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            could be
            %a.existingWikiWord{:href => "/nlab/show/sesquilinear+map"} sesquilinear
            instead of bilinear. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            would satisfy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi t
                    %mo *
                  %mi t
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(t x) = t^* t Q(x)
            (which I don't know a term for, maybe ‘sesqui-quadratic’? or using whatever's Latin for 3/4?) instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi t
                    %mn 2
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(t x) = t^2 Q(x)
            as for a quadratic map. Since everything is still bilinear or quadratic over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %em regardless
            of whether
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is symmetric (or conjugate-symmetric or anything else), we can recover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has (in addition to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1/2
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/imaginary+unit"} imaginary unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo +
                  %msup
                    %mi i
                    %mo *
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} i + i^* = 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mi i
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i^* i = 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 4
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mfrac
                    %mn 1
                    %mn 4
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mfrac
                    %mn 1
                    %mn 4
                  %mi i
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi i
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 4
                  %mi i
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %mi i
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(x,y) = \frac{1}{4} Q(x + y) - \frac{1}{4} Q(x - y) - \frac{1}{4} i Q(x + i y) + \frac{1}{4} i Q(x - i y)
          %p
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is conjugate-linear in the first variable and linear in the second. (Swap the signs on the two terms involving
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is linear in the first variable and conjugate-linear in the second.) The more general version of this is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msub
                        %mi c
                        %mi i
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mi x
                      %mo +
                      %msub
                        %mi b
                        %mi i
                      %mi y
                      %mo{:stretchy => "false"} )
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                      %msubsup
                        %mi a
                        %mi i
                        %mo *
                      %msub
                        %mi b
                        %mi i
                      %msub
                        %mi c
                        %mi i
                %annotation{:encoding => "application/x-tex"}
                  m(x,y)
                  \= \frac{\sum_i c_i Q(a_i x + b_i y)}
                  {\sum_i a_i^* b_i c_i}
          %p when
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msubsup
                    %mi a
                    %mi i
                    %mo *
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msubsup
                    %mi b
                    %mi i
                    %mo *
                  %msub
                    %mi b
                    %mi i
                  %msup
                    %mi c
                    %mi i
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %msub
                    %mi a
                    %mi i
                  %msubsup
                    %mi b
                    %mi i
                    %mo *
                  %msub
                    %mi c
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \sum_i a_i^* a_i c_i = \sum_i b_i^* b_i c^i = \sum_i a_i b_i^* c_i = 0
          %p
            and the denominator is invertible. (Notice that the last two of these conditions are contradictory if the involution is trivial; or rather, they imply that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/trivial+ring"} trivial ring
          %h2#examples Examples
          %p
            This is best known in the case of bilinear and quadratic
            = succeed "," do
              %em forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is the
            %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            into an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is (the square of) the norm, making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normed+space"} normed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} m(x,y)
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle x, y \rangle
            (or any other common notation for an inner product) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Q(x)
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \|x\|^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            may not have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mi x
                  %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} \|x\|
            alone. Even assuming that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} Q(x) \geq 0
            is an additional assumption, the
            %a.existingWikiWord{:href => "/nlab/show/positive-definite"} positive (semi)-definiteness
            of the inner product.)
          %p
            Besides forms, the general theory also applies to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            to be associative; although one rarely studies commutative but
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/non-associative+algebras"} non-associative algebras
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jordan+algebras"} Jordan algebras
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            may be more easily motivated through the squaring operation (since the square of an
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            has a more obvious meaning than the Jordan product of two observables), and the polarization identities allow us to recover multiplication from squaring (and subtraction and division by
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi W
                %annotation{:encoding => "application/x-tex"} V = W
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            %a.existingWikiWord{:href => "/nlab/show/%2A-algebra"} algebra
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            by explicitly taking the adjoint of one argument:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi x
                      %mo *
                    %mi y
                  %annotation{:encoding => "application/x-tex"} m(x,y) \coloneqq x^* y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a complete
            %a.existingWikiWord{:href => "/nlab/show/normed+field"} normed field
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi W
                %annotation{:encoding => "application/x-tex"} V = W
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            must have a principal square root, but now we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mi x
                    %mo *
                  %mi x
                %annotation{:encoding => "application/x-tex"} Q(x) \coloneqq x^* x
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} |
                    %mn 2
                %annotation{:encoding => "application/x-tex"} |x|^2
            rather than
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \|x\|^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |{-}|
            is not an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
          %h2#higher_order Higher order
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ,
                  %mi V
                  %mo ,
                  %mi W
                %annotation{:encoding => "application/x-tex"} R, V, W
            be as before. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} Q\colon V \to W
            be homogeneous of degree
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi t
                    %mi p
                  %mi Q
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} Q(t v) = t^p Q(v) .
          %p
            We wish to turn
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            into a symmetric
            %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            of rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            (so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Sym
                    %mi p
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} m\colon \Sym_p V \to W
            is linear) as follows:
          %ul
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p = 0
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m() = Q(0)
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p = 1
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(v_1) = Q(v_1)
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} p = 2
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(v_1, v_2) = Q(v_1 + v_2) - Q(v_1) - Q(v_2)
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} p = 3
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo ,
                      %msub
                        %mi v
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi v
                        %mn 2
                      %mo +
                      %msub
                        %mi v
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo +
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi Q
