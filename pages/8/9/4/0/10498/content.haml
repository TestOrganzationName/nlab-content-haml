                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} m(v_1, v_2, v_3, v_4) = Q(v_1 + v_2 + v_3 + v_4) - Q(v_1 + v_2 + v_3) - Q(v_1 + v_2 + v_4) - Q(v_1 + v_3 + v_4) - Q(v_2 + v_3 + v_4) + Q(v_1 + v_2) + Q(v_1 + v_3) + Q(v_1 + v_4) + Q(v_2 + v_3) + Q(v_2 + v_4) + Q(v_3 + v_4) - Q(v_1) - Q(v_2) - Q(v_3) - Q(v_4)
            %li etc.
          %p
            (Morally, the expressions on the right-hand side of each item above should end with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ±
                    %mi Q
