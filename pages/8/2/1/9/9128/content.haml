          %h3#TheoriesAndTheirModels Theories and their models
          .num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical field theory
              of
              %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
              is a physical theory which asserts that
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              is modeled by a
              %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
              equipped with certain further
              %a.existingWikiWord{:href => "/nlab/show/force"} force
              and
              %a.existingWikiWord{:href => "/nlab/show/matter"} matter
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Einstein+equations"} Einstein equations
              %em model
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cosmology"} cosmology
              %em
                %a.existingWikiWord{:href => "/nlab/show/FRW+model"} FRW model
              is an example: here one specifies that the given pseudo-Riemannian metric and the
              %a.existingWikiWord{:href => "/nlab/show/matter"} matter
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              content is
              %em homogenous
              and
              = succeed "." do
                %em isotropic
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} k \in \{-1,0,1\}
