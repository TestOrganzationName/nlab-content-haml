                        %annotation{:encoding => "application/x-tex"} SO(10)
              = succeed ")" do
                %a{:href => "http://arxiv.iacs.res.in:8080/jspui/bitstream/10821/6019/1/The%20Prediction%20of%20Mass%20of%20Z%27-Boson_By%20S%20Sahoo.pdf"} pdf
          %h3#in_relation_to_flavour_anomalies In relation to flavour anomalies
          %p
            As a possible solution to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/flavour+anomalies"} flavour anomalies
          %ul
            %li#GauldGoertzHaisch13
              %p
                Rhorry Gauld, Florian Goertz, Ulrich Haisch,
                = succeed "," do
                  %em
                    An explicit Z’-boson explanation of the
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                          %mo →
                          %msup
                            %mi K
                            %mo *
                          %msup
                            %mi μ
                            %mo +
                          %msup
                            %mi μ
                            %mo −
                        %annotation{:encoding => "application/x-tex"} B \to K^\ast \mu^+ \mu^-
                    anomaly
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1310.1082"} arXiv:1310.1082
            %li
              %p
                Richard H. Benavides, Luis Muñoz, William A. Ponce, Oscar Rodríguez, Eduardo Rojas,
                %em
                  Minimal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Z
                          %mstyle{:scriptlevel => "0"}
                            %mo ′
                      %annotation{:encoding => "application/x-tex"} Z^\prime
                  models for flavor anomalies
                (
                %a{:href => "https://arxiv.org/abs/1812.05077"}> arXiv:1812.05077
                )
            %li#DAmbrosioIverPiccininiPolosa19
              %p
                Giancarlo D’Ambrosio, A. M. Iyer, F. Piccinini, A.D. Polosa,
                %em
                  Confronting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                  anomalies with atomic physics
                (
                %a{:href => "https://arxiv.org/abs/1902.00893"}> arXiv:1902.00893
                )
            %li
              %p
                P. Ko,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Takaaki+Nomura"} Takaaki Nomura
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo →
                        %mi s
                        %msup
                          %mi μ
                          %mo +
                        %msup
                          %mi μ
                          %mo −
                      %annotation{:encoding => "application/x-tex"} b \to s \mu^+ \mu^-
                  anomalies and related phenomenology in
