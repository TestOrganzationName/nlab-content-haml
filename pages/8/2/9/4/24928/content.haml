              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ∈
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M \in \mathcal{D}(A)
              is called
              %em solid
              if for any
              %a.existingWikiWord{:href => "/nlab/show/profinite+set"} profinite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
