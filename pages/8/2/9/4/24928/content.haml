                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(\mathcal{O}_{X,\square}):=D((\mathcal{O}_{X^{\ad}},\mathcal{O}_{X^{\ad}}^{+})_{\square})
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi X
                    %mo →
                    %mi{:mathvariant => "normal"} Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F:X\to \mathrm{Spec}(R)
              be a separated and smooth map of finite type, of dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi R
                      %mo =
                      %msup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mi d
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi R
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \omega_{X/R}=\bigwedge^{d}\Omega_{X/R}^{1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi X
                        %mo ,
                        %mo □
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mo □
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{!}:D(\mathcal{O}_{X,\square})\to D(R_{\square})
            %p
              that agrees with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R\Gamma(X,-)
              in the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is proper. It preserves compact objects. There is a natural trace map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %msub
                      %mi ω
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi R
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f_{!}\omega_{X/R}[d]\to R
            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒪
                        %mrow
                          %mi X
                          %mo ,
                          %mo □
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C\in D(\mathcal{O}_{X,\square})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %msub
                          %mi 𝒪
                          %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msub
                      %mi ω
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mi R
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mi C
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R\Hom_{\mathcal{O}_{X}}(C,\omega_{X/R})[d]\to R\Hom_{R}(f_{!}C,R)
            %p is an isomorphism.
          %h2#sixfunctor_formalism Six-functor formalism
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mrow
                      %mi X
                      %mo ,
                      %mo □
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\mathcal{O}_{X,\square})
            admits the
            %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            (
            %a{:href => "#ScholzeLCM"}> ScholzeLCM
            , Lecture XI). The first four functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ⊗
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} -\otimes -
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Hom(-,-)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_{*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^{*}
            are classical and do not require condensed mathematics. The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_{!}
            has to be constructed, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f^{!}
            will be defined to be its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            be a separated map of finite type. Then the corresponding map of
            %a.existingWikiWord{:href => "/nlab/show/adic+spaces"} adic spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                  %mo :
                  %msup
                    %mi X
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                  %mo →
                  %msup
                    %mi Y
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                %annotation{:encoding => "application/x-tex"} f_{\ad}:X^{\ad}\to Y^{\ad}
            factors as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                    %mo :
                    %msup
                      %mi X
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                    %mover
                      %mo →
                      %mi j
                    %msup
                      %mi X
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                            %mo{:stretchy => "false"} /
                            %mi Y
                    %msup
                      %mi Y
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                  %annotation{:encoding => "application/x-tex"} f_{\ad}:X^{\ad}\xrightarrow{j} X^{\ad/ Y} \xrightarrow{f^{\ad /Y}} Y^{\ad}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is an open immersion and an isomorphism if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is proper.
          %p
          .num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#ScholzeLCM"} ScholzeLCM
              Proposition 11.2)
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mo *
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                            %mo{:stretchy => "false"} /
                            %mi Y
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                            %mo{:stretchy => "false"} /
                            %mi Y
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j^{*}:D(\mathcal{O}_{X^{\ad /Y}},\mathcal{O}_{X^{\ad /Y}}^{+})\to D(\mathcal{O}_{X^{\ad}},\mathcal{O}_{X^{\ad}}^{+})
            %p admits a left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mo !
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                            %mo{:stretchy => "false"} /
                            %mi Y
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} j_{!}:D((\mathcal{O}_{X^{\ad}},\mathcal{O}_{X^{\ad }}^{+})_{\square})\to D(\mathcal{O}_{X^{\ad} /Y},\mathcal{O}_{X^{\ad /Y}}^{+})_{\square}).
            %p
          %p
          .num_defn
            %h6 Definition
            %p
              (
              %a{:href => "#ScholzeLCM"} ScholzeLCM
              Definition 11.3) The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo ,
                    %mo □
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi Y
                        %mo ,
                        %mo □
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{!}:D(\mathcal{O}_{X},\square)\to D(\mathcal{O}_{Y,\square})
              is defined to be the composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo =
                    %msubsup
                      %mi f
                      %mo *
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                        %mo{:stretchy => "false"} /
                        %mi Y
                    %mo ∘
                    %msub
                      %mi j
                      %mo !
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f_{!}=f_{*}^{\ad /Y}\circ j_{!}.
            %p
          %p
            It turns out that the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_{!}
            commutes with all direct sums and therefore admits a right adjoint, which will be the sixth functor we call
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f^{!}
          %h2#solid__almostmodules
            Solid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} /
                  %mi π
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}^{+}/\pi
            almost-modules
          %p
            In
            = succeed "," do
              %a{:href => "#Mann22"} Mann22
            %a.existingWikiWord{:href => "/nlab/show/almost+modules"} almost modules
            to construct the derived
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a{:href => "#LurieHA"} LurieHA
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒟
                    %mo □
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} a
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} /
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{D}_{\square}^{\a}(\mathcal{O}_{X}^{+}/ \pi)
            of solid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} /
                  %mi π
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}^{+}/ \pi
            %a.existingWikiWord{:href => "/nlab/show/almost+modules"} almost modules
            and with it the
            %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rigid+analytic+spaces"} rigid analytic spaces
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
          %p
          .num_prop
            %h6 Proposition
            %p
              (
              %a{:href => "#Mann22"}> Mann22
              , Theorem 1.1.1)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be an algebraically closed field of characteristic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              whose residue field is of characteristic
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a proper smooth rigid-analytic variety of pure dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} i\in\mathbb{Z}
              there is a natural perfect pairing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi et
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi 𝔽
                    %msubsup
                      %mi H
                      %mi et
                      %mrow
                        %mn 2
                        %mi d
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi 𝔽
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} H_{et}^{i}(X,\mathbb{F}_{p})\otimes_{\mathbb{F}}H_{et}^{2d-i}(X,\mathbb{F}_{p})\to\mathbb{F}_{p}(-d).
            %p
          %p
            “mod p” Poincare duality for rigid analytic spaces had also previously been proven by Zavyalov in
            = succeed "," do
              %a{:href => "#Zavyalov21"} Zavyalov21
          %p
            The theory of
            %a.existingWikiWord{:href => "/nlab/show/almost+modules"} almost modules
            is necessary in order to make the structure sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo{:stretchy => "false"} /
                  %mi π
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{X}^{+}/\pi
            %span.newWikiWord
              acyclic
              %a{:href => "/nlab/new/acyclic"} ?
            on
            %a.existingWikiWord{:href => "/nlab/show/affinoid"} affinoid
            %a.existingWikiWord{:href => "/nlab/show/perfectoid+spaces"} perfectoid spaces
            (compare the analogous classical situation for
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            or
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            for
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
          %p
            In the course of proving Poincare duality for rigid analytic spaces, Mann also proves a version of a p-torsion
            %a.existingWikiWord{:href => "/nlab/show/Riemann-Hilbert+correspondence"} Riemann-Hilbert correspondence
            for small v-stacks (
            %a{:href => "#Mann22"}> Mann22
            , Theorem 3.9.23).
