            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adic+spaces"} adic spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo ,
                    %msubsup
                      %mi 𝒪
                      %mi X
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}((\mathcal{O}_{X},\mathcal{O}_{X}^{+})_{\square})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an adic space. By passing to the homotopy category we get the triangulated category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi X
                  %mo ,
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo □
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D((\mathcal{O}_{X},\mathcal{O}_{X}^{+})_{\square})
            (
            %a{:href => "#ScholzeLCM"}> ScholzeLCM
            , Lectures IX and X).
          %h2#coherent_duality Coherent duality
          %p
            There exists a notion of coherent duality (analogous to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+duality"} Grothendieck duality
            = succeed "," do
              %a{:href => "#ScholzeLCM"} ScholzeLCM
          %p
            For brevity, given a scheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with associated adic space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} ad
                  %annotation{:encoding => "application/x-tex"} X^{\ad}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi X
                        %mo ,
                        %mo □
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi D
