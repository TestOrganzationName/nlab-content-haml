                        %mo →
                        %mrow
                          %mi A
                          %mo ′
                          %mo ⊆
                          %mi A
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %munder
                        %mo ←
                        %mi i
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ′
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi S
                      %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A_{\square}[S]
                    \\;\coloneqq\;
                    \\underset
                    {\underset{ A'\subseteq A }{\rightarrow}}
                    {\lim}
                    \\;
                    \\underset
                    {\underset{i}{\leftarrow}}
                    {\lim}
                    \\;
                    A'\big[S_{i}\big]
                    \\,,
            %p
