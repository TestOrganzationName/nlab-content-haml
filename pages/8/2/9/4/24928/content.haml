                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+chain+complexes"} of chain complexes of
              = succeed "." do
                %span.newWikiWord
                  condensed
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %a{:href => "/nlab/new/condensed+module"} ?
              %a.existingWikiWord{:href => "/nlab/show/profinite+set"} profinite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %munder
                      %mi lim
                      %munder
                        %mo ←
                        %mi i
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S=\underset{\underset{i}{\leftarrow}}\lim S_{i}
              consider the
              %a.existingWikiWord{:href => "/nlab/show/limit+in+an+%28infinity%2C1%29-category"}
