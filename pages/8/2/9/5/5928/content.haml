              on
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/finitely+presented+object"} finitely presented object
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              over this
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              is the
              %a.existingWikiWord{:href => "/nlab/show/big+topos"} big topos
              version of the
              = succeed "." do
                %strong Zariski topos
          %h2#properties Properties
          %h3#points Points
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            correspond precisely to the
            %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            points of the
            %a.existingWikiWord{:href => "/nlab/show/prime+spectrum"} prime spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
