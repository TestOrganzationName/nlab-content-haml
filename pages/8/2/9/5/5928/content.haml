          %h3#as_a_site As a site
          .num_prop
            %h6#proposition Proposition
            %p
              The Zariski coverage is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subcanonical+coverage"} subcanonical
          .num_prop
            %h6#proposition_2 Proposition
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi CRing
                          %mi fp
                          %mi op
