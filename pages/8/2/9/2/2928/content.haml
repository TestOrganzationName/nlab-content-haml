                          %mi f
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mi f
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi f
                          %mi f
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi id
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi id
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ⇒
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi f
                          %mi g
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
