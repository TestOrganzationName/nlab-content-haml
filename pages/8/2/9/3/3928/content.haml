                        %mo ×
                        %mi M
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \{p\} \times V_p = V \cap \left(\{p\} \times M\right)
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              to
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                  %annotation{:encoding => "application/x-tex"} U_p
              defines a diffeomorphism
              = succeed "." do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mi p
                      %mo →
                      %msub
                        %mi V
                        %mi p
                    %annotation{:encoding => "application/x-tex"}
                      \\eta_p \colon U_p \to
                      V_p
          .proof
            %h6#proof Proof
            %p
              Let us start by showing that
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \eta_p
              is well-defined. Clearly, we can restrict
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              to
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                  %annotation{:encoding => "application/x-tex"} U_p
              to get
              = succeed "," do
                %em something
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
