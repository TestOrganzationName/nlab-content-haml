                    %mo ×
                    %mi M
                  %annotation{:encoding => "application/x-tex"} V \subseteq M \times M
              be the image of
              = succeed "." do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
