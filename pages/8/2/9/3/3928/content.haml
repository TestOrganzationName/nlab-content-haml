                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              over
              = succeed "." do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi p
                    %mo ⊆
                    %mi M
                  %annotation{:encoding => "application/x-tex"} V_p \subseteq M
              be such that
              = succeed "." do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi p
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %msub
                        %mi V
                        %mi p
                      %mo =
                      %mi V
                      %mo ∩
