                  %annotation{:encoding => "application/x-tex"} (\pi \times \eta) \colon U \to V
              to the subset
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
