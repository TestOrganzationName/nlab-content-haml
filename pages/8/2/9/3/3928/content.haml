                    %annotation{:encoding => "application/x-tex"} U_p \subseteq E_p = \pi^{-1}(p)
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                  %annotation{:encoding => "application/x-tex"} U_p
              is contained in
              = succeed "," do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
