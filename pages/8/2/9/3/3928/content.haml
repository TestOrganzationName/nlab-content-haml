                        %mi p
                    %annotation{:encoding => "application/x-tex"} V_p
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
