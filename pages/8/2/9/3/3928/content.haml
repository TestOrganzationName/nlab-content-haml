                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} (p,q) \in V
              and so
              = succeed "." do
                %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi π
                      %mo ×
                      %mi η
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo ∈
