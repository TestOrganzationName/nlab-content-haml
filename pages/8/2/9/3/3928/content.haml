            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_130.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_131.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi g
                %annotation{:encoding => "application/x-tex"} U_g
            and that
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_132.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is a bijection
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_133.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi g
                    %mo →
                    %msub
                      %mi U
                      %mi g
                  %annotation{:encoding => "application/x-tex"} E_g \to U_g
          %p
            Let us start with the image. Let
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_134.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %msub
                      %mi U
                      %mi g
                  %annotation{:encoding => "application/x-tex"} h \in U_g
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_135.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %mi N
                  %mo →
                  %mi M
                  %mo ×
                  %mi M
                %annotation{:encoding => "application/x-tex"} (g,h) \colon N \to M \times M
            takes values in
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_136.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_137.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo ×
                  %mi η
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} (\pi \times \eta)^{-1}
            to get a map
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_138.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi h
                      %mo{:stretchy => "false"} ˇ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \check{h} \colon N \to T M
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_139.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_140.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mi N
                    %mo ×
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} N \to N \times T M
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_141.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mover
                    %mi h
                    %mo{:stretchy => "false"} ˇ
                  %mo =
                  %mi g
                %annotation{:encoding => "application/x-tex"} \pi \check{h} = g
            and so this map ends up in
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_142.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                  %mi T
                  %mi M
                %annotation{:encoding => "application/x-tex"} g^* T M
            (which has the subspace structure). Again by construction, the projection of this map to
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_143.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is the identity and so it is a section of
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_144.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi T
                    %mi M
                  %annotation{:encoding => "application/x-tex"} g^* T M
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_145.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            to
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_146.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi P
                %annotation{:encoding => "application/x-tex"} T P
            follows from the fact that
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_147.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            restricts to a local addition on
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_148.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_149.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} h(Q) \subseteq P
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_150.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi h
                      %mo{:stretchy => "false"} ˇ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi T
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \check{h}(Q) \subseteq T P
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_151.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            is onto. Moreover, this construction yields the inverse of
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_152.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            and so it is a bijection.
          %p
            Thus we have charts for
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_153.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi M
                    %mo ;
                    %mi Q
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(N,M;Q,P)
          %p
            %em … to be continued …
          %h2#diffeomorphisms_from_local_additions Diffeomorphisms from Local Additions
          %p
            Another useful construction from a local addition relates to diffeomorphisms. In differential topology, manifolds have a certain amount of “flexibility”: a common picture is of a rubber sheet that can be deformed. The amount of flexibility is less than that allowed in algebraic topology, but certainly more than that in differential geometry. Being able to deform a manifold a little is a very useful trick in establishing the relationships between the various mapping spaces (for example, it is used in showing that the loop space fibration
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_154.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi M
                  %mo →
                  %mi L
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \Omega M \to L M \to M
            is a
            %a.existingWikiWord{:href => "/nlab/show/fibre+bundle"} fibre bundle
            and not just a fibration) and so it is useful to have a consistent way to perform these deformations that is compatible with a given local addition.
          %p
            The aim of this construction is to produce, for each
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_155.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} v \in U
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_156.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{(t,v)}
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_157.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{(t,v)}(\pi(v)) = \eta(t v)
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_158.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p = \pi(v)
            is deformed along the path
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_159.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \eta(t v)
            to
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_160.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(v)
          %p
            So let
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_161.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \eta \colon U \to M
            be a local addition. Let
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_162.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \nu \colon U \to \mathbb{R}
            be a smooth function with the following fibrewise property: for each
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_163.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} r \in \mathbb{R}
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_164.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi q
                  %mo ∈
                  %msub
                    %mi U
                    %mi p
                  %mo :
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi r
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{q \in U_p : \nu(q) \le r\}
            is a compact,
            %a.existingWikiWord{:href => "/nlab/show/radial"} radial
            subset. The square of the norm coming from a smooth orthogonal structure would suffice. Let
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_165.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℝ
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \rho \colon \mathbb{R} \to [0,1]
            be a smooth function such that
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_166.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \rho(t) = 1
            for
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_167.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ≤
                  %mn 0
                %annotation{:encoding => "application/x-tex"} t \le 0
            and
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_168.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \rho(t) = 0
            for
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_169.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} t \ge 1
          %p
            Now for
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_170.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} v \in U
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_171.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mi v
                %annotation{:encoding => "application/x-tex"} \hat{X}_v
            on
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_172.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                  %annotation{:encoding => "application/x-tex"} U_p
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_173.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p = \pi(v)
          .maruku-equation
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_174.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mi v
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi v
                %annotation{:encoding => "application/x-tex"}
                  \\hat{X}_v(w) \coloneqq \rho(\nu(w) - \nu(v))v
          %p
            Notice that if
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_175.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \nu(w) \ge \nu(v) + 1
            then
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_176.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mi v
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \hat{X}_v(w) = 0
            whilst if
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_177.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi ν
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nu(w) \le \nu(v)
            (so in particular if
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_178.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo =
                  %mi t
                  %mi v
                %annotation{:encoding => "application/x-tex"} w = t v
            for some
            = succeed ")" do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_179.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} t \in [0,1]
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_180.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mi v
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi v
                  %annotation{:encoding => "application/x-tex"} \hat{X}_v(w) = v
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_181.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mi v
                %annotation{:encoding => "application/x-tex"} \hat{X}_v
            is compactly supported on
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_182.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi p
                  %annotation{:encoding => "application/x-tex"} U_p
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_183.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi p
                %annotation{:encoding => "application/x-tex"} \eta_p
            to
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_184.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi p
                %annotation{:encoding => "application/x-tex"} V_p
            and, as it is compactly supported, extend it to all of
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_185.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            by defining it to be
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_186.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            outside
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_187.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi p
                  %annotation{:encoding => "application/x-tex"} V_p
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_188.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi v
                %annotation{:encoding => "application/x-tex"} X_v
            for this vector field.
          %p
            By construction, the map
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_189.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo →
                  %msub
                    %mi X
                    %mi v
                %annotation{:encoding => "application/x-tex"} v \to X_v
            is smooth. As
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_190.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi v
                %annotation{:encoding => "application/x-tex"} X_v
            is compactly supported, we can apply the exponentiation map
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_191.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒳
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{X}_c(M) \to Diff(M)
            and so obtain, for each
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_192.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} v \in U
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_193.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_194.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{(t,v)}
            = succeed "," do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_195.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi v
                  %annotation{:encoding => "application/x-tex"} X_v
            = succeed "." do
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_196.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi p
                  %annotation{:encoding => "application/x-tex"} V_p
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_197.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            moves along the line
            %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_198.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
