                      %mi p
                    %mo ∩
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U_p \coloneqq E_p \cap U
              be the fibre of
              %math#mathml_26ecd24cbcd4290244c987e7239084dea2eb07d3_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
