                  of the actual fields, the antifields
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi c
                          %mi α
                          %mo ‡
                      %annotation{:encoding => "application/x-tex"} c^\ddagger_\alpha
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
                  as well as those of possibly further
                  %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
                  )
            %p we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ′
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi A
                          %mtd
                            %mo ≔
                            %msup
                              %mi e
                              %mrow
                                %mo {
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                  %mi gf
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %mo −
                                %mo }
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ϕ
                              %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi ϕ
                              %mi A
                        %mtr
                          %mtd
                            %mphantom
                              %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ′
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mi A
                              %mo ‡
                          %mtd
                            %mo ≔
                            %msup
                              %mi e
                              %mrow
                                %mo {
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                  %mi gf
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %mo −
                                %mo }
                            %mrow
                              %mo (
                              %msubsup
                                %mi ϕ
                                %mi A
                                %mo ‡
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi ϕ
                              %mi A
                              %mo ‡
                            %mo −
                            %mfrac
                              %mrow
                                %msub
                                  %mover
                                    %mi δ
                                    %mo ←
                                  %mi EL
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                  %mi gf
                              %mrow
                                %mi δ
                                %msup
                                  %mi ϕ
                                  %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (\phi')^A
                    \&amp; \coloneqq
                    e^{\left\{ \mathbf{L}_{gf}\,,\, - \right\}}(\phi^A)
                    \\\
                    \&amp; = \phi^A
                    \\\
                    \\phantom{A}
                    \\\
                    (\phi')^\ddagger_A
                    \&amp; \coloneqq
                    e^{\left\{ \mathbf{L}_{gf}\,,\, - \right\}}
                    \\left( \phi^\ddagger_A \right)
                    \\\
                    \&amp;  =
                    \\phi^\ddagger_A - \frac{\overset{\leftarrow}{\delta}_{EL} \mathbf{L}_{gf}}{\delta \phi^a}
                    \\end{aligned}
            %p
              (and similarly for the higher jets); and the corresponding transformed
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %a.maruku-eqref{:href => "#eq:GaugeFixedLagrangianDensity"} (1)
              may be written as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo −
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo ′
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %msub
                              %mo ′
                              %mi BRST
                          %mtd
                            %mo ≔
                            %msup
                              %mi e
                              %mrow
                                %mo {
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                  %mi gf
                                %mspace{:width => "thinmathspace"}
                                %mo ,
                                %mspace{:width => "thinmathspace"}
                                %mo −
                                %mo }
                            %mrow
                              %mo (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %mo +
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mi BRST
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mstyle{:mathvariant => "bold"}
                                %mi L
                              %mo +
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mi BRST
                              %mo )
                            %mrow
                              %mo (
                              %mi ϕ
                              %mo ′
                              %mo ,
                              %mo{:stretchy => "false"} (
                              %mi ϕ
                              %mo ′
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo ‡
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \-\mathbf{L}' +  \mathbf{L}'_{BRST}
                    \&amp; \coloneqq
                    e^{\left\{ \mathbf{L}_{gf}\,,\, - \right\}}\left( -\mathbf{L} + \mathbf{L}_{BRST} \right)
                    \\\
                    \&amp; =
                    \\left(
                    \-\mathbf{L}
                    +
                    \\mathbf{L}_{BRST}
                    \\right)
                    \\left( \phi', (\phi')^\ddagger  \right)
                    \\end{aligned}
                    \\,,
            %p
              where the notation on the right denotes that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi'
              is
              %a.existingWikiWord{:href => "/nlab/show/substitution"} substituted
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %msub
                      %mo ′
                      %mo ‡
                  %annotation{:encoding => "application/x-tex"} \phi'_\ddagger
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mo ‡
                    %annotation{:encoding => "application/x-tex"} \phi_\ddagger
            %p
              This means that the defining condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}'
              be the antifield-independent summand
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GaugeFixedLagrangianDensity"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ≔
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo +
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi BRST
                      %mo )
                    %mrow
                      %mo (
                      %mi ϕ
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi ϕ
                        %mo ‡
                      %mo =
                      %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}'
                    \\coloneqq
                    \\left(
                    \-\mathbf{L}
                    +
                    \\mathbf{L}_{BRST}
                    \\right)
                    \\left( \phi'(\phi), \phi_\ddagger = 0  \right)
            %p translates into
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ≔
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo +
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi BRST
                      %mo )
                    %mrow
                      %mo (
                      %mi ϕ
                      %mo ′
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ′
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mi A
                        %mo ‡
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mrow
                          %msub
                            %mover
                              %mi δ
                              %mo ←
                            %mi EL
                          %msub
                            %mi L
                            %mi gf
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}'
                    \\coloneqq
                    \\left(
                    \-\mathbf{L}
                    +
                    \\mathbf{L}_{BRST}
                    \\right)
                    \\left( \phi', (\phi')^\ddagger_A  = -\frac{\overset{\leftarrow}{\delta}_{EL} L_{gf}}{\delta \phi^A}  \right)
                    \\,.
            %p
              In this form BV-gauge fixing is considered traditionally (e.g.
              = succeed ")." do
                %a{:href => "gauge+fixing#Henneaux90"} Hennaux 90, section 8.3, page 83, equation (76b) and item (iii)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#AdjoiningAuiliaryFields
            %strong
              adjoining
              %a.existingWikiWord{:href => "/nlab/show/contractible+chain+complexes"} contractible cochain complexes
              of
              %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
          %p
            Typically a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
            for given choice of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundles"} gauge parameter bundles
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing+Lagrangian+density"} gauge fixing Lagrangian density
            (def.
            = succeed ")." do
              %a.maruku-ref{:href => "#GaugeFixingLagrangianDensity"}
            %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
            has been chosen suitably, then the remaining
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            vanishes “up to
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing+Lagrangian+density"} gauge fixing Lagrangian density
            does exist if only one adjoins sufficiently many
            %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
            forming a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contractible+chain+complex"} contractible complex
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
          #AuxiliaryFields.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/antighost+fields"} antighost fields
            %p
              Over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi aux
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    A \overset{aux}{\longrightarrow} \Sigma
            %p
              be any
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#dgManifolds"}
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi b
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (b^i)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %mi aux
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    A[-1] \overset{aux[-1]}{\longrightarrow} \Sigma
            %p
              we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
