                            %mi deg
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mi i
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\text{name:}
                    \&amp;
                    \\array{
