                            %mtr
                              %mtd
                                %mtext fields
                      %msub
                        %mo ×
                        %mi Σ
                      %munder
                        %munder
                          %mrow
                            %mi A
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mo ⏟
