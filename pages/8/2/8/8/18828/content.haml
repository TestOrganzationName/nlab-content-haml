                          %mrow
                            %mi ν
                            %mo ,
                            %mi μ
                        %msub
                          %mrow
                          %mrow
                            %mo ,
                            %mi μ
                        %mo −
                        %msup
                          %mi a
                          %mrow
                            %mi μ
                            %mo ,
                            %mi ν
                        %msub
                          %mrow
                          %mrow
                            %mo ,
                            %mi μ
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \frac{d}{d x^\mu} f^{\mu \nu} = \tfrac{1}{2} \left( a^{\nu,\mu}{}_{,\mu} - a^{\mu,\nu}{}_{,\mu} \right)
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/differential+equations"} differential equations
              for
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge-fixed
              %a.existingWikiWord{:href => "/nlab/show/electromagnetism"} electromagnetism
              on the right in
              %a.maruku-eqref{:href => "#eq:LorenzGaugeFixedEOMForVacuumElectromagnetism"} (7)
              are nothing but the
              %a.existingWikiWord{:href => "/nlab/show/wave+equations"} wave equations
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} of motion
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mn 1
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} (p+1) + 1 + 1
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/mass"} massless
              %a.existingWikiWord{:href => "/nlab/show/scalar+fields"} scalar fields
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#EquationOfMotionOfFreeRealScalarField"}
            %p
              As such, by example
              %a.maruku-ref{:href => "#GreenHyperbolicKleinGordonEquation"}
              they are a system of
              %a.existingWikiWord{:href => "/nlab/show/Green+hyperbolic+differential+equations"} Green hyperbolic differential equations
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#GreenHyperbolicDifferentialOperator"}
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CauchySurface"}
            %p
              Therefore
              %a.maruku-eqref{:href => "#eq:GaussianAveragedLorentzianGaugeFixOfElectromagneticFieldOnMinkowskiSpacetime"} (6)
              indeed is a
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              of the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#GaugeFixingLagrangianDensity"}
            %p
              The gauge-fixed
              %a.existingWikiWord{:href => "/nlab/show/BRST+operator"} BRST operator
              induced from the gauge fixed Lagrangian density
              %a.maruku-eqref{:href => "#eq:GaussianAveragedLorentzianGaugeFixOfElectromagneticFieldOnMinkowskiSpacetime"} (6)
              acts as
            #eq:GaussianAveragedLorentzGaugeFixedBRSTOperator.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mi s
                                    %msub
                                      %mo ′
                                      %mi BRST
                                    %mo =
                                %mtr
                                  %mtd
                                    %mrow
                                      %mo {
                                      %mrow
                                        %mo (
                                        %msub
                                          %mi c
                                          %mrow
                                            %mo ,
                                            %mi μ
                                        %mo{:stretchy => "false"} (
                                        %msup
                                          %mi a
                                          %mo ‡
                                        %msup
                                          %mo{:stretchy => "false"} )
                                          %mi μ
                                        %mo +
                                        %mi b
                                        %msup
                                          %mover
                                            %mi c
                                            %mo ¯
                                          %mo ‡
                                        %mo )
                                      %msub
                                        %mi dvol
                                        %mi Σ
                                      %mo ,
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                      %mo }
                        %mtr
                          %mtd
                            %msub
                              %mi a
                              %mi μ
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi c
                              %mrow
                                %mo ,
                                %mi μ
                        %mtr
                          %mtd
                            %mi b
                          %mtd
                            %mo ↦
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mover
                              %mi c
                              %mo ¯
                          %mtd
                            %mo ↦
                          %mtd
                            %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; \array{ s'_{BRST} = \\ \left\{ \left( c_{,\mu} (a^\ddagger)^\mu + b \overline{c}^{\ddagger}\right) dvol_\Sigma, (-)  \right\}  }
                    \\\
                    a_\mu &amp;\mapsto&amp; c_{,\mu}
                    \\\
                    b &amp;\mapsto&amp; 0
                    \\\
                    \\overline{c} &amp;\mapsto &amp; b
                    }
          %p
            From this we immediately obtain the
            %a.existingWikiWord{:href => "/nlab/show/propagators"} propagators
            for the gauge-fixed
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
          #PhotonPropagatorInGaussianAveragedLorenzGauge.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/photon+propagator"} photon propagator
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Gaussian-averaged+Lorenz+gauge"} Gaussian-averaged Lorenz gauge
            %p
              After
              %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} fixing
              %a.existingWikiWord{:href => "/nlab/show/Gaussian-averaged+Lorenz+gauge"} Gaussian-averaged Lorenz gauge
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#NLGaugeFixingOfElectromagnetism"}
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#GreenFunctionsAreContinuous"}
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              and
              %a.existingWikiWord{:href => "/nlab/show/Nakanishi-Lautrup+field"} Nakanishi-Lautrup field
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mrow
                        %mi EM
                        %mo ,
                        %mi EL
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi Δ
                                %mi photon
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo *
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^{EM, EL}
                    \\;=\;
                    \\left(
                    \\array{
                    \\Delta^{photon} &amp; \ast
                    \\\
                    \\ast &amp; \ast
                    }
                    \\right)
            %p with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mrow
                        %mi μ
                        %mi ν
                      %mi photon
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^{photon}_{\mu \nu}(x,y)
                    \\;=\;
                    \\eta_{\mu \nu} \Delta(x,y)
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mrow
                            %mi μ
                            %mi ν
                      %annotation{:encoding => "application/x-tex"} \eta_{\mu \nu}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
                  %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Delta(x,y)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
                  %a.existingWikiWord{:href => "/nlab/show/mass"} massless
                  %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
                  (prop.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#ModeExpansionOfCausalPropagatorForKleinGordonOnMinkowski"}
            %p
              Accordingly the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              of the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              in
              %a.existingWikiWord{:href => "/nlab/show/Gaussian-averaged+Lorenz+gauge"} Gaussian-averaged Lorenz gauge
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Δ
                      %mi F
                      %mi photon
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi Δ
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\Delta^{photon}_F)_{\mu \nu}(x,y)
                    \\;=\;
                    \\eta_{\mu \nu} \Delta_F(x,y)
                    \\,,
            %p
              where on the right
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta_F(x,y)
              is the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/mass"} massless
              %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            %p
              This is also called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/photon+propagator"} photon propagator
            %p
              Hence by prop.
              %a.maruku-ref{:href => "#FeynmanPropagatorAsACauchyPrincipalvalue"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} distributional Fourier transform
              of the photon propagator is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mrow
                          %msubsup
                            %mi Δ
                            %mi F
                            %mi photon
                        %mo ^
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mi k
                          %mi μ
                        %msub
                          %mi k
                          %mi μ
                        %mo +
                        %mi i
                        %msup
                          %mn 0
                          %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\Delta^{photon}_F}_{\mu \nu}(k)
                    \\;=\;
                    \\frac{1}{- k^\mu k_\mu + i 0^+}
                    \\,.
          %p
            (this is a special case of
            = succeed "," do
              %a{:href => "gauge+fixing#Khavkine14"} Khavkine 14 (99)
            = succeed ")" do
              %a{:href => "perturbative+algebraic+quantum+field+theory#Rejzner16"} Rejzner 16, (7.20)
          .proof
            %h6#proof_3 Proof
            %p
              The Gaussian-averaged Lorenz gauge-fixed equations of motion
              %a.maruku-eqref{:href => "#eq:LorenzGaugeFixedEOMForVacuumElectromagnetism"} (7)
              of the electromagnetic field are just
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              uncoupled
              %a.existingWikiWord{:href => "/nlab/show/mass"} massless
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equations"} Klein-Gordon equations
              %a.existingWikiWord{:href => "/nlab/show/wave+equations"} wave equations
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#EquationOfMotionOfFreeRealScalarField"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+1)
              real components of the
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
              (“
              %a.existingWikiWord{:href => "/nlab/show/vector+potential"}> vector potential
              ”)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                    %msub
                      %mi A
                      %mi μ
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AAAA
                    %mi μ
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Box A_\mu = 0\phantom{AAAA} \mu \in \{0,1,\cdots, p\}
                    \\,.
            %p
              This shows that the propoagator is proportional to that of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+scalar+field"} real scalar field
            %p
              To see that the index structure is as claimed, recall that the
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              and
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              of the
              %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
              in def.
              %a.maruku-ref{:href => "#AdvancedAndRetardedGreenFunctions"}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi{:mathvariant => "normal"} G
                                  %mo ±
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi μ
                                    %mi ν
                                %mo )
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi T
                              %mo *
                            %mi Σ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(T\Sigma)
                    \&amp;\overset{\left( (\mathrm{G}_{\pm})_{\mu \nu} \right)}{\longrightarrow}&amp;
                    \\Gamma_\Sigma(T^\ast \Sigma)
                    }
            %p
              corresponding to a
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              for the
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              which by
              %a.maruku-eqref{:href => "#eq:ElectromagneticFieldEulerLagrangeForm"} (?)
              and
              %a.maruku-eqref{:href => "#eq:LorenzGaugeFixedEOMForVacuumElectromagnetism"} (7)
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi T
                              %mo *
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi η
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mo ∘
                                %mo □
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mi Σ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi μ
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi η
                              %mrow
                                %mi μ
                                %mi ν
                            %mo □
                            %msub
                              %mi A
                              %mi ν
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(T^\ast \Sigma)
                    \&amp;\overset{ \eta^{-1} \circ \Box }{\longrightarrow}&amp;
                    \\Gamma_\Sigma(T \Sigma)
                    \\\
                    A_\mu &amp;\mapsto&amp; \eta^{\mu \nu} \Box A_\nu
                    }
            %p
              Then the defining equation
              %a.maruku-eqref{:href => "#eq:AdvancedRetardedGreenFunctionIsRightInverseToDiffOperator"} (?)
              for the
              %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+Green+functions"} advanced and retarded Green functions
              is, in terms of their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integral+kernels"} integral kernels
              %a.existingWikiWord{:href => "/nlab/show/advanced+and+retarded+propagators"} advanced and retarded propagators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} \Delta_{\pm}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mo ′
                        %mi μ
                    %mo □
                    %munder
                      %mo ∫
                      %mrow
                        %mi y
                        %mo ∈
                        %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mo ±
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi μ
                        %mi ν
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi A
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi A
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
