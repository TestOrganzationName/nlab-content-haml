              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  a choice of
                  %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#AuxiliaryFields"}
                %p hence
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} A[-1]
                  a choice of
                  %a.existingWikiWord{:href => "/nlab/show/antighost+fields"} antighost fields
