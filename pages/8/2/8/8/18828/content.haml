                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                          %mo ≃
                          %mn 0
                      %mo )
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi AA
                        %msub
                          %mo ≃
