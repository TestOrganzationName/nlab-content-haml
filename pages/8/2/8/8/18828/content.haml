                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    T^\ast_{\Sigma,inf}[-1]\left( A \times_\Sigma A^\ast[-1]  \right)
            %p has the following coordinates:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mtext name:
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mtext antifield of
                                %mtr
                                  %mtd
                                    %mtext antighost field
                          %mtd
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mtext antifield of
                                %mtr
                                  %mtd
                                    %mtext auxiliary field
                          %mtd
                            %mtext antighost field
                          %mtd
                            %mtext auxiliary field
                        %mtr
                          %mtd
                            %mtext symbol:
