                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi T
                          %mrow
                            %mi Σ
                            %mo ,
                            %mi inf
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} T^\ast_{\Sigma,inf}[-1](\cdots)
                  the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
