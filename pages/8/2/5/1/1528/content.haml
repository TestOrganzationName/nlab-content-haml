            %p
          (
          %a{:href => "#BarthelRiehl2013"}> Barthel–Riehl 2013, definition 3.2
          )
          %h2#properties Properties
          %h3#functorial_factorization Functorial factorization
          %p
          .num_prop
            %h6 Proposition
            %p
              The Moore mapping path space construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Top
                      %mo →
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \Gamma\colon Top^\to \to Top
              yields a
              %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial factorization
              of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X\to Y
              as a composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mi L
                        %mi f
                    %mi Γ
                    %mi f
                    %mover
                      %mo →
                      %mrow
                        %mi R
                        %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{L f}{\to} \Gamma f \stackrel{R f}{\to} Y
            %p
              of a
              %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} (closed) trivial Hurewicz cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi f
                  %annotation{:encoding => "application/x-tex"} L f
              and a
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi f
                    %annotation{:encoding => "application/x-tex"} R f
          (
          %a{:href => "#BarthelRiehl2013"}> Barthel–Riehl 2013, section 3.1 and corollary 3.12
          )
          %p
          .num_prop
            %h6 Proposition
            %p
              A morphism of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is
            %ul
              %li
                %p
                  a Hurewicz fibration iff it admits an
                  %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+endofunctor"} algebra structure
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/pointed+endofunctor"} pointed endofunctor
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Str%C3%B8m+model+structure"} (closed) trivial Hurewicz cofibration
                  iff it admits a
                  %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebra structure
                  for the
                  %span.newWikiWord
                    copointed endofunctor
                    %a{:href => "/nlab/new/copointed+endofunctor"} ?
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  (a
                  = succeed ")." do
                    %em Moore strong deformation retraction
            %p
          (
          %a{:href => "#BarthelRiehl2013"}> Barthel–Riehl 2013, section 3.3
          )
