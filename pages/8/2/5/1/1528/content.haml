          %h2#idea Idea
          %p
            The classical
            %em Moore path category
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a variant on the usual space of
            %a.existingWikiWord{:href => "/nlab/show/paths"} paths
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} I \to X
            %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
            (even an
            %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal
            %a.existingWikiWord{:href => "/nlab/show/dagger+category"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
              \-category
            in
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %h2#definition Definition
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %strong Moore path category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi X
                  %annotation{:encoding => "application/x-tex"} M X
              has
            %ul
              %li
                %p
                  as space of objects
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi M
                            %mn 0
                          %mi X
                          %mo ≔
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                          %mo ≔
                          %mi X
                        %annotation{:encoding => "application/x-tex"} M_0 X \coloneqq (M X)_0 \coloneqq X
              %li
                %p
                  as space of morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi M
                          %mn 1
                        %mi X
                        %mo ≔
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 1
                        %mo ⊆
                        %msup
                          %mi X
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} ]
                        %mo ×
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} M_1 X \coloneqq (M X)_1 \subseteq X^{[0,\infty]} \times [0,\infty)
                  the subspace of pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo ,
                        %mi len
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\gamma, len(\gamma))
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \gamma \colon [0, \infty) \to X
                  is continuous and constant on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mn ∞
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [len(\gamma), \infty]
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} s(\gamma)
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \gamma(0)
                  and the target
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} t(\gamma)
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  is
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi γ
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \gamma(len(\gamma))=\gamma(\infty)
              %li
                %p
                  as composition
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∘
                          %mo{:lspace => "verythinmathspace"} :
                          %msub
                            %mi M
                            %mn 1
                          %mi X
                          %msub
                            %mo ×
                            %mrow
                              %msub
                                %mi M
                                %mn 0
                              %mi X
                          %msub
                            %mi M
                            %mn 1
                          %mi X
                          %mo →
                          %msub
                            %mi M
                            %mn 1
                          %mi X
                        %annotation{:encoding => "application/x-tex"} {\circ} \colon M_1 X \times_{M_0 X} M_1 X \to M_1 X
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo ′
                          %mo ∘
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi γ
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} len(\gamma' \circ \gamma) = len (\gamma) + len (\gamma')
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo ′
                        %mo ∘
                        %mi γ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
