              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \times E G
              is cofibrant (by the analog of
              = succeed ")" do
                %a{:href => "fine+model+structure+on+topological+G-spaces#MonoidalModelCategoryStructure"} this Prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
