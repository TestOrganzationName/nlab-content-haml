            %h6 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} E G
              is a
              = succeed "," do
