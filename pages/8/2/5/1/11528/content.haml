                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi ϕ
                              %mrow
                                %msub
                                  %mi g
                                  %mi n
                                %mo ⋅
                                %msub
                                  %mi p
                                  %mi n
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi e
                              %mi n
                            %mo ,
                            %msub
                              %mi σ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mover
                                %mi ϕ
                                %mo ˜
                              %mrow
                                %msub
                                  %mi g
                                  %mi n
                                %mo ⋅
                                %msub
                                  %mi p
                                  %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi_{p_n}(g_n, \sigma_n)
                    \&amp; \;=\;
                    \\phi_{p_n}( e_n \cdot g_n, \sigma_n )
                    \\\
                    \&amp; \;=\;
                    \\big(
                    g_n \cdot \phi_{p_n}
                    \\big)
                    ( e_n, \sigma_n )
                    \\\
                    \&amp; \;=\;
                    \\phi_{ g_n \cdot p_n }
                    (e_n, \sigma_n)
                    \\\
                    \&amp; \;=\;
                    {\widetilde \phi}_{g_n \cdot p_n}
                    \\end{aligned}
            %p Here:
            %ul
              %li
                %p
                  the first step is the unit law in the component group
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
              %li
                %p
                  the second step uses the definition
                  %a.maruku-eqref{:href => "#eq:CofreeSimplicialActionInComponents"} (6)
                  of the cofree action;
              %li
                %p
                  the third step is the assumption that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \phi_{(-)}
                  is a homomorphism of
                  = succeed "-actions" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariance
              %li
                %p
                  the fourth step is the definition
                  = succeed "." do
                    %a.maruku-eqref{:href => "#eq:AdjunctOfHomomorphismToCofreeSimplicialAction"} (7)
            %p
              These identifications show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{(-)}
              is uniquely determined by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %msub
                          %mover
                            %mi ϕ
                            %mo ˜
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {\widetilde \phi_{(-)}}
            %p
          %p
          #BZActionOnInertiaGroupoid.num_remark
            %h6 Example
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
                \-
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"} 2-action
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/inertia+groupoid"} inertia groupoid
              %br/
              Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo ∈
                        %mi Groups
                        %mo{:stretchy => "false"} (
                        %mi Sets
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G \in Groups(Sets)
                %p
                  be a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi G
                        %mi Actions
                        %mo{:stretchy => "false"} (
                        %mi Sets
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \in G Actions(Sets)
                %p
                  be a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/group+action"} action
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒳
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⫽
                        %mi G
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ×
                        %mi G
                        %mo ⇉
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mi X
                        %mo ×
                        %msup
                          %mi G
                          %mrow
                            %msup
                              %mo ×
                              %mo •
                        %mo ∈
                        %mi sSet
                      %annotation{:encoding => "application/x-tex"} \mathcal{X} \;\coloneqq\; X \sslash G \;\coloneqq\; N( X \times G \rightrightarrows X ) \,=\, X \times G^{\times^\bullet} \in sSet
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                  (a model for its
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi ℤ
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo ⇉
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ≔
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi ℤ
                          %mrow
                            %msup
                              %mo ×
                              %mo •
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Groups
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\coloneqq\, \mathbf{B}\mathbb{Z} \,\coloneqq\, N(\mathbb{Z} \rightrightarrows \ast)  \,\coloneqq\, \mathbb{Z}^{\times^\bullet} \,\in\, Groups(sSet)
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
                  that is the
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
                  of the additive group of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/functor+groupoid"} functor groupoid
            #eq:InertiaGroupoidAsFunctorGroupoidOutOfBZ.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mspace{:width => "negativethinmathspace"}
                            %mo ⫽
                            %mspace{:width => "negativethinmathspace"}
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≔
                            %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi ℤ
                            %mo ,
                            %mi X
                            %mspace{:width => "negativethinmathspace"}
                            %mo ⫽
                            %mspace{:width => "negativethinmathspace"}
                            %mi G
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi Func
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo ⇉
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ×
                            %mi G
                            %mo ⇉
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo ←
                              %mrow
                                %mo ∈
                                %mi{:mathvariant => "normal"} W
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi g
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi ConjCl
                                %mo{:stretchy => "false"} (
                                %mi G
                                %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %msup
                              %mi X
                              %mi g
                            %mspace{:width => "negativethinmathspace"}
                            %mo ⫽
                            %mspace{:width => "negativethinmathspace"}
                            %msub
                              %mi C
                              %mi g
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Lambda(X \!\sslash\! G)
                    \&amp; \;\coloneqq\;
                    \\big[
                    \\mathbf{B}\mathbb{Z}, X \!\sslash\! G
                    \\big]
                    \\\
                    \&amp;
                    \\;\simeq\;
                    Func
                    \\big(
                    (\mathbb{Z} \rightrightarrows \ast),
                    \\,
                    (X \times G \rightrightarrows X)
                    \\big)
                    \\\
                    \&amp; \;\underset{\in \mathrm{W}}{\leftarrow}\;
                    \\underset{
                    [g] \in ConjCl(G)
                    }{\coprod}
                    \\Big(
                    X^{g} \!\sslash\! C_g
                    \\Big)
                    \\end{aligned}
            %p
              is known as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/inertia+groupoid"} inertia groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mspace{:width => "negativethinmathspace"}
                      %mo ⫽
                      %mspace{:width => "negativethinmathspace"}
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \!\sslash\! G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ConjCla
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi C
                      %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi h
                    %mo ∈
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo |
                      %mspace{:width => "thinmathspace"}
                      %mi h
                      %mo ⋅
                      %mi g
                      %mo =
                      %mi g
                      %mo ⋅
                      %mi h
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"}
                    ConjCla(G)
                    \\;\coloneqq\;
                    G/_{ad} G
                    \\,,
                    \\;\;\;\;\;\;\;\;\;\;\;
                    C_g
                    \\;\coloneqq\;
                    \\big\{
                    h \in G
                    \\,\left\vert\,
                    h \cdot g = g \cdot h
                    \\right.
                    \\big\}
            %p
              denotes, respectively, the set of
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
              of elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/centralizer"} centralizer
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi g
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \{g\} \subset G
              – this data serves to express the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              of the inertia groupoid in the last line of
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:InertiaGroupoidAsFunctorGroupoidOutOfBZ"} (8)
            %p
              Now, by Prop.
              %a.maruku-ref{:href => "#CofreeAction"}
              the inertia groupoid
              %a.maruku-eqref{:href => "#eq:InertiaGroupoidAsFunctorGroupoidOutOfBZ"} (8)
              carries a canonical
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} 2-action
              of the
              %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z}
            %p
              By the formula
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:CofreeSimplicialActionInComponents"} (6)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              the 2-group element in degree 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathcolor => "purple"}
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    {\color{purple}n}
                    \\;\colon\;
                    \\Delta[1]
                    \\longrightarrow
                    \\mathbf{B} \mathbb{Z}
            %p acts on the morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi h
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ⋅
                    %mi x
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mspace{:width => "negativethinmathspace"}
                    %mo ⫽
                    %mspace{:width => "negativethinmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x,g) \overset{h}{\longrightarrow} (h\cdot x, g)
                    \\;\;\;
                    \\in
                    \\;
                    \\Lambda(X \!\sslash\! G)
            %p
              of the inertia groupoid as follows (recall the nature of
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/products+of+simplices"} products of simplices
            %p
              %img{:src => "https://ncatlab.org/nlab/files/BZActionOnInertiaGroupoid20210624.jpg", :width => "800"}/
            %p
          %h4#relation_to_the_fine_model_structure_of_equivariant_homotopy_theory Relation to the fine model structure of equivariant homotopy theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            gives a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            between the Borel model structure and the
            %span.newWikiWord
              final model structure on topological G-spaces
              %a{:href => "/nlab/new/final+model+structure+on+topological+G-spaces"} ?
            for
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            (
            %a{:href => "#Guillou06"}> Guillou 2006, section 5
            ).
          %p The left adjoint is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi id
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi G
                    %mo •
                  %msub
                    %mi Act
                    %mi coarse
                  %mo ⟶
                  %msub
                    %mi G
                    %mo •
                  %msub
                    %mi Act
                    %mi fine
                %annotation{:encoding => "application/x-tex"}
                  L = id
                  \\;\colon\;
                  G_\bullet Act_{coarse}
                  \\longrightarrow
                  G_\bullet Act_{fine}
          %p
            from the Borel model structure to the genuine
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
          %p Because:
          %p
            First of all, by (
            %a{:href => "#Guillou06"}> Guillou 2006, theorem 3.12, example 4.2
            )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mo •
                %annotation{:encoding => "application/x-tex"} sSet^{\mathbf{B}G_\bullet}
            does carry a fine model structure. By (
            %a{:href => "#Guillou06"}> Guillou 2006, last line of page 3
            ) the fibrations and weak equivalences here are those maps which are ordinary fibrations and weak equivalences, respectively, on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            simplicial sets, for all subgroups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
