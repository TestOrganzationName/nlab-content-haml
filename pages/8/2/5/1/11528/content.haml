                      %mi proj
                  %annotation{:encoding => "application/x-tex"} G Act\big(TopSp_{Qu}\big)_{proj}
              from Prop.
              %a.maruku-ref{:href => "#BorelModelStructureOnTopologicalSpaces"}
              is
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              with
              %a.existingWikiWord{:href => "/nlab/show/generating+cofibrations"} generating cofibrations
              being (see
              = succeed ")" do
                %a{:href => "Introduction+to+Homotopy+Theory#GeneratingCofibrationsForProjectiveStructureOnFunctors"} this Def.
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (regarded with its free left multiplication action) of the generating cofibrations of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi TopSp
                          %mi Qu
                      %annotation{:encoding => "application/x-tex"} TopSp_{Qu}
          For
          %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi G
              %annotation{:encoding => "application/x-tex"} G
          a statement along these lines appears as
          = succeed "." do
            %a{:href => "#Guillou06"} Guillou 2006, Prop. 5.3
          .proof
            %h6 Proof
            %p
              This is a special case of
              %a{:href => "Introduction+to+Homotopy+Theory#ProjectiveModelStructureOnTopologicalFunctors"} this Thm.
              about topological functor categories.
            %p
              Alternatively, the statement is a special case of that for the
              %a.existingWikiWord{:href => "/nlab/show/fine+model+structure+on+topological+G-spaces"} fine model structure on topological G-spaces
              for the case of trivial family of closed subgroups (see
              = succeed ")." do
                %a{:href => "fine+model+structure+on+topological+G-spaces#SpecializationToBorelModelStructure"} there
          %p
