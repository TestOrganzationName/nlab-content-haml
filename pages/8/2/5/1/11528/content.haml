                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi x
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mi G
                        %mo →
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi W
                        %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
