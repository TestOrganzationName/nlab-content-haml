              remembering just the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
