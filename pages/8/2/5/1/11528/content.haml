                        %msub
                          %mi sSet
                          %mi Qu
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mi proj
                        %mo ≔
                        %mi sSetCat
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mi proj
                      %annotation{:encoding => "application/x-tex"} G_\bullet Acts\big(sSet_{Qu}\big)_{proj} \coloneqq sSetCat\big(\mathbf{B}G_\bullet, sSet\big)_{proj}
                  for the projective
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
                  (projective
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            %p
              This is the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_\bullet
              = succeed "," do
                %em Borel model structure
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              (
              %a{:href => "#DDK80"}> DDK 80, Prop. 2.4
              ,
              = succeed ")." do
                %a{:href => "#GoerssJardine09"} Goerss &amp; Jardine 09, Chapter V, Thm. 2.3
          %h3#DefinitionInCombSimpModCat In combinatorial simplicial model categories
          %p
            More generally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is an
            %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
            which is also
            %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensored
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  sSet \times \mathbf{C} \longrightarrow \mathbf{C}
                  \\,,
          %p
            then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi sSet
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \in Grp(sSet)
            the
            %a{:href => "enriched+adjoint+functor#ViaHomIsomorphism"} enriched hom-isomorphism
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒢
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi.mathscript 𝒱
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi.mathscript 𝒱
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Hom
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒢
                  %mo ⋅
                  %mi.mathscript 𝒱
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi.mathscript 𝒱
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Hom\big(
                  \\mathcal{G}
                  ,\,
                  \\mathbf{C}(\mathscr{V},\,\mathscr{V})
                  \\big)
                  \\;\;\simeq\;\;
                  Hom\big(
                  \\mathcal{G} \cdot \mathscr{V}
                  ,\,
                  \\mathscr{V}
                  \\big)
          %p
            shows that
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi 𝒢
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\,\colon\,
                  \\mathbf{B}\mathcal{G} \longrightarrow \mathbf{C}
          %p
            may equivalently be thought of as
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ⋅
                  %mi.mathscript 𝒱
                  %mover
                    %mo ⟶
                    %mi ρ
                  %mi.mathscript 𝒱
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G} \cdot \mathscr{V}
                  \\overset{\rho}{\longrightarrow}
                  \\mathscr{V}
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            acting on
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒱
                  %mo ≔
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathscr{V} \coloneqq F(\ast)
            via
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
          %p
            If now
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is in fact a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
            exists (
            %a{:href => "model+structure+on+functors#ExistenceOfProjectiveStructureOnEnrichedFunctors"}> that Prop.
            ), which we may hence think of as the Borel model structure on
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
