                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
            %p
              Prop.
              %a.maruku-ref{:href => "#CofibrantObjectsInTopologicalBorelModelStructure"}
              implies that the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
