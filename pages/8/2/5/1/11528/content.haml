                is
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak hom. equivalent
                to plain
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
