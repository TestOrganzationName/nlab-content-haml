            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              in the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              diagram:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
