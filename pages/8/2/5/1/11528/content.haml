              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+simplicial+complex"} universal principal simplicial complex
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"}> contractible
                  \:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
