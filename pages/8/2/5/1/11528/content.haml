          %h4#topological_borel_construction Topological Borel construction
          %p
          #QuotentQuillenAdjunctionBetweenGSpacesToSpaces.num_prop
            %h6 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi TopSp
                      %mi Qu
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi triv
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi G
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    TopSp_{Qu}
                    \\underoverset
                    {\underset{triv}{\longrightarrow}}
                    {\overset{(-)/G}{\longleftarrow}}
                    {\bot}
                    G Act\big(TopSp_{Qu}\big)_{proj}
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              and the projective Borel model structure from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#BorelModelStructureOnTopologicalSpaces"}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"}> right Quillen functor
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi triv
                        %annotation{:encoding => "application/x-tex"} triv
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+actions"} trivial actions
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"}> left Quillen functor
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
