          %h2#Idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em Borel model structure
            is a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/group+object"} equipped with
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
          %p
            Analogously, given a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_\bullet
            %em Borel model structure
            is a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group+actions"} simplicial group actions
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            equipped with
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
          %p
            Both of these present the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            (see there) presented by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            this is also called the “coarse model structure” (e.g.
            = succeed ")," do
              %a{:href => "#Guillou06"} Guillou 2006, section 5
            %a.existingWikiWord{:href => "/nlab/show/fine+model+structure+on+topological+G-spaces"} fine model structure on topological G-spaces
            that enters
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
          %h2#definition Definition
          %h3#in_topological_spaces In topological spaces
          %p
            Throughout, write
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+weak+Hausdorff+spaces"} compactly generated weak Hausdorff spaces
          %p
          .num_defn
            %h6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(TopSp)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            #eq:BGAsTopEnrichedCategory.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi TopCat
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G \;\in\; TopCat
            %p
              for the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              with a single
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as its unique
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
          %p
          .num_remark
            %h6 Remark
            %p
              There is an evident
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            #eq:IdentifyingTopologicalGSpacesWithTopEnrichedFunctors.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi TopFnctr
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi TopSp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    G Act(TopSp)
                    \\;\simeq\;
                    TopFnctr\big( \mathbf{B}G,\, TopSp \big)
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              and the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              %a.maruku-eqref{:href => "#eq:BGAsTopEnrichedCategory"} (1)
              to
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (topological presheves).
          %p
          #BorelModelStructureOnTopologicalSpaces.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(TopSp)
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              there is a
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi TopSp
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi proj
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi MdlCat
                  %annotation{:encoding => "application/x-tex"}
                    G Act\big(TopSp\big)_{proj}
                    \\;\;\;
                    \\in
                    \\;
                    MdlCat
            %p
              on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+G-spaces"} topological G-spaces
              whose
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              and
              %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              are those
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              whose
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              are so in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
            this may be argued as in
            = succeed "." do
              %a{:href => "#Guillou06"} Guillou 2006, Thm. 5.1
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+enriched+functors"} projective model structure on Top-enriched functor
            (see
            = succeed ")," do
              %a{:href => "Introduction+to+Homotopy+Theory#ProjectiveModelStructureOnTopologicalFunctors"} this Thm.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Act
                  %mo{:stretchy => "false"} (
                  %mi TopSp
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ≃
                  %mspace{:width => "thinmathspace"}
                  %mi TopFun
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ,
                  %mi TopSp
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G Act(TopSp) \,\simeq\, TopFun( \mathbf{B}G, TopSp )
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:IdentifyingTopologicalGSpacesWithTopEnrichedFunctors"} (2)
          %h3#in_simplicial_sets In simplicial sets
          %p
          #BorelModelStructure.num_defn
            %h6 Definition
            %p
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mo •
                  %annotation{:encoding => "application/x-tex"} G_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G_\bullet
                  for the one-object
                  %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+category"} sSet-enriched category
                  (here: a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
                  %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
                  is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mo •
                        %annotation{:encoding => "application/x-tex"} G_\bullet
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mo •
                        %mi Actions
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi sSetCat
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                        %mo ,
                        %mi sSet
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} G_\bullet Actions(sSet) \;\coloneqq\; sSetCat\big(\mathbf{B}G_\bullet, sSet\big)
                  for the
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
                  to
