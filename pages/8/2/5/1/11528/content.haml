                    %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
