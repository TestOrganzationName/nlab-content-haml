          %h4#cofibrations_and_cofibrant_replacement Cofibrations and Cofibrant replacement
          %p
          #CofibrantObjectsInTopologicalBorelModelStructure.num_prop
            %h6 Proposition
            %p
              The model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
