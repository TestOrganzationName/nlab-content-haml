            %p
          (
          %a{:href => "#Guillou06"}> Guillou 2006, Ex. 5.5
          )
          .proof
            %h6 Proof
            %p
              By definition of the weak equivalences and fibrations in Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#BorelModelStructureOnTopologicalSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
