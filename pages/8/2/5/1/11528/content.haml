                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi G
                        %annotation{:encoding => "application/x-tex"} (-)/G
                  %a.existingWikiWord{:href => "/nlab/show/topological+quotient+spaces"} topological quotient spaces
                  by the
                  %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo ×
