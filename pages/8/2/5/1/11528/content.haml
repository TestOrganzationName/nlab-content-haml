              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
              with compatible
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+enriched+category"} monoidal enriched category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
