            %p
          %h4#RelationToModelStructureOnPlainSimplicialSets Relation to the model structure on plain simplicial sets
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi Groups
                  %mo{:stretchy => "false"} (
                  %mi sSets
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Groups(sSets)
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mi Actions
                  %mo{:stretchy => "false"} (
                  %mi sSets
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{G}Actions(sSets)
            for the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
          #CofreeAction.num_prop
            %h6 Proposition
            %p
              %strong (underlying simplicial sets and cofree simplicial action)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi undrl
                  %annotation{:encoding => "application/x-tex"} undrl
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mi Actions
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}Actions
              to underlying simplicial sets is a
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              from the Borel model structure (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BorelModelStructure"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} [
                          %mi 𝒢
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %mover
                        %mo ⟵
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi undrl
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %mi Actions
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    sSet
                    \\underoverset
                    {\underset{ \;\;\; [\mathcal{G},-] \;\;\; }{\longrightarrow}}
                    {\overset{ \;\;\; undrl \;\;\; }{\longleftarrow}}
                    {\bot}
                    \\mathcal{G}Actions(sSet)
            %p
              sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \in sSet
              to
            %ul
              %li
                %p the simplicial set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %mo ,
                        %mi 𝒳
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi sSet
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi 𝒢
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mo •
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi 𝒳
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mi sSet
                      %annotation{:encoding => "application/x-tex"}
                        [\mathcal{G},\mathcal{X}]
                        \\;\coloneqq\;
                        Hom_{sSet}\big( \mathcal{G} \times \Delta[\bullet], \mathcal{X}\big)
                        \\;\;\;
                        \\in
                        sSet
              %li
                %p
                  equipped with the
                  = succeed "-action" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                        %mo ×
                        %mo{:stretchy => "false"} [
                        %mi 𝒢
                        %mo ,
                        %mi 𝒳
                        %mo{:stretchy => "false"} ]
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{G} \times [\mathcal{G},\mathcal{X}]
                        \\overset{ (-) \cdot (-) }{\longrightarrow}
                        \\mathcal{G}
                %p
                  which in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                #eq:CofreeSimplicialActionComponentFunctions.maruku-equation
                  %span.maruku-eq-number (5)
