                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    S \colon A \longrightarrow A
                    \\,,
            %p
              then called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/antipode"} antipode
              or
              = succeed "," do
                %strong coinverse
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
