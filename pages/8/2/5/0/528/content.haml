          #InvolutiveHopfAlgebra.num_defn
            %h6#definition_3 Definition
            %p
              If the antipode of a Hopf algebra (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Antipode"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/anti-involution"} anti-involution
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∘
                      %mi S
                      %mo =
                      %mi id
                    %annotation{:encoding => "application/x-tex"} S \circ S = id
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/involutive+Hopf+algebra"} involutive Hopf algebra
          .num_remark
            %h6#remark Remark
            %p
              If an antipode exists then it is unique, just the way that if inverses exist in a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              then they are unique. One sometimes prefers to have a
              %strong skew-antipode
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{S}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
