                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo ∘
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      h_{(2)}\tilde{S}(h_{(1)}) = \tilde{S}(h_{(2)}) h_{(1)} =
                      (\eta\circ\epsilon) (h)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
