                              %mi p
                              %mi n
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    L_{\mathbb{Z}[1/p]}X
                    \&amp; \simeq
                    \\underset{\longleftarrow}{\lim}_n Ext^1(\mathbb{Z}/p^n \mathbb{Z}, A)
                    \\\
