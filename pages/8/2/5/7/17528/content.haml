                            %mi p
                            %mi ℤ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi p
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi p
                              %mn 2
                            %mi ℤ
