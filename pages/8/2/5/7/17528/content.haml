          .proof
            %h6#proof_7 Proof
            %p
              By theorem
              %a.maruku-ref{:href => "#pCompletionOfAbelianGroupsByHomsOutOfZpinfinity"}
              the localization morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              sits in a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Hom(\mathbb{Z}(p^\infty),A)
                    \\longrightarrow
                    Hom(\mathbb{Z}[1/p],A)
                    \\overset{\phi}{\longrightarrow}
                    Hom(\mathbb{Z},A)
                    \\overset{\delta}{\longrightarrow}
                    Ext^1(\mathbb{Z}(p^\infty), A)
                    \\to
                    \\cdots
                    \\,.
            %p
              Here by def.
              %a.maruku-ref{:href => "#pInvertedInZ"}
              and since the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in the first argument to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo ⟵
                    %mrow
                      %mo (
                      %mi ⋯
                      %mo →
                      %mi A
                      %mover
                        %mo ⟶
                        %mrow
                          %mi p
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi A
                      %mover
                        %mo ⟶
                        %mrow
                          %mi p
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{Z}[1/p],A)
                    \\simeq
                    \\underset{\longleftarrow}{\lim}
                    \\left(
                    \\cdots
                    \\to
                    A \overset{p \cdot (-)}{\longrightarrow} A \overset{p \cdot (-)}{\longrightarrow} A
                    \\right)
                    \\,.
            %p
              But by assumption all these morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \cdot (-)
              that the limit is over are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              in the above sequence is an
