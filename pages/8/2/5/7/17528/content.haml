                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\vdots &amp;&amp; \vdots &amp;&amp; \vdots
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    \\mathbb{Z}/p^3\mathbb{Z}
                    \&amp;\overset{p\cdot (-)}{\longrightarrow}&amp;
                    \\mathbb{Z}/p^4 \mathbb{Z}
                    \&amp;\longrightarrow&amp;
