              such that all torsion elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are annihilated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} p^n
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#MittagLefflerCondition"}> def.
              ) is satisfied by the
              %a.existingWikiWord{:href => "/nlab/show/tower"} tower
              of
              = succeed "-torsion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-term" do
                %a.existingWikiWord{:href => "/nlab/show/lim%5E1"} lim^1
              = succeed ")." do
