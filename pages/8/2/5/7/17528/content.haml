            %p
              By lemma
              %a.maruku-ref{:href => "#OutOfCyclicGroupExt1"}
              the
              %a.existingWikiWord{:href => "/nlab/show/lim%5E1"} lim^1
              on the left is over the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
