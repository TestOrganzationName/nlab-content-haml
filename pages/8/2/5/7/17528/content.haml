            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %blockquote
              %p
                (
                %strong Beware
                that here it would seem more natural to use
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mo •
                    %annotation{:encoding => "application/x-tex"} Ext^\bullet
                instead of
