                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 0 \to \mathbb{Z}[p^{-1}]
          %h2#definition Definition
          #ExtAb.num_remark
            %h6#remark Remark
            %p
              Recall that
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Ext
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Ext^\bullet(A,B)
              between
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A, B \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              are concentrated in degrees 0 and 1 (
              %a{:href => "free+resolution#AbelianGroupHasFreeResolutionOfLength2"}> prop.
              ). Since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ext^0(A,B) \simeq Hom(A,B)
            %p
              is the plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              = succeed "\u201D:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ext
                    %annotation{:encoding => "application/x-tex"} Ext
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
