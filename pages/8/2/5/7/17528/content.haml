          .num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+abelian+group"} finite abelian group
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a.maruku-ref{:href => "#AbelianGrouppComplete"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary part
          .proof
            %h6#proof_8 Proof
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+finite+abelian+groups"} fundamental theorem of finite abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a finite
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ≃
                    %munder
                      %mo ⊕
                      %mi i
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\simeq
                    \\underset{i}{\oplus}
                    \\mathbb{Z}/p_i^{k_i}\mathbb{Z}
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} ordr
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} p_i^{k_1}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k_i \in \mathbb{N}
              (
              %a{:href => "finite+abelian+group#FiniteAbelianGroupIsDirectSumOfCyclics"}> thm.
              ).
            %p
              Since finite direct sums are equivalently
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              (
              %a.existingWikiWord{:href => "/nlab/show/biproducts"}> biproducts
              \:
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              is an
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1( \mathbb{Z}(p^\infty), A )
                    \\simeq
                    \\underset{i}{\prod}
                    Ext^1( \mathbb{Z}(p^\infty), \mathbb{Z}/p_i^{k_1}\mathbb{Z} )
                    \\,.
            %p
              By theorem
              %a.maruku-ref{:href => "#pCompletionOfAbelianGroupsByHomsOutOfZpinfinity"}
              the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msubsup
                        %mi p
                        %mi i
                        %mrow
                          %msub
                            %mi k
                            %mi i
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p_i^{k_i}\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \cdot(-)
              is an isomorphism on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p_i^{k_i}\mathbb{Z}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo ≠
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p_i \neq p
              (because its
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              evidently vanishes), prop.
              %a.maruku-ref{:href => "#pDivisibleGroupsHaveVanishingpCompletion"}
              says that in this case the factor vanishes, so that only the factors with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p_i = p
              remain. On these however
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext^1(\mathbb{Z}(p^\infty),-)
              is the identity by example
              = succeed "." do
                %a.maruku-ref{:href => "#pPrimaryGroupsArePComplete"}
