                %semantics
                  %mrow
                    %mi Elts
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} Elts(A)\to \tilde U
              provides the searched diagonal filler
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \Delta[n]\to \tilde U
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi U
                  %annotation{:encoding => "application/x-tex"} p_U
              is universal since a Kan fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} a:A\to I
              with
              = succeed "-small" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi U
                  %annotation{:encoding => "application/x-tex"} p_U
              along the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi I
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} A:I\to U
              sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\in I([n])
              to an
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta/[n]
              which is isomorphic to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x^* a
              by the Grothendieck construction.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi x
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi U
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi x
                                  %mo *
                                %mi a
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi a
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi p
                                  %mi U
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi x
                          %mtd
                            %mi I
                          %mtd
                            %mover
                              %mo →
                              %mi A
                          %mtd
                            %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_x&amp;\to&amp;A&amp;\to&amp;\tilde U
                    \\\
                    \\downarrow^{x^* a}&amp;&amp;\downarrow^a&amp;&amp;\downarrow^{p_U}
                    \\\
                    * &amp;\xrightarrow{x}&amp;I&amp;\xrightarrow{A}&amp;U
                    }
          .num_cor
            %h6#corollary Corollary
            %p
              The type theoretic universe
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi U
                      %mo :
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} p_U:\tilde U\to U
              = succeed "," do
                %a.maruku-ref{:href => "#2"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo :
                      %mo =
                      %mi Δ
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N:=\Delta(\mathbb{N})
          %h2#identity_types_in_the_lifted_grothendieck_universe_
            Identity types in the lifted Grothendieck universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
          %p
            We consider the factorization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi U
                    %mo{:stretchy => "false"} ˜
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi r
                        %mover
                          %mi U
                          %mo{:stretchy => "false"} ˜
                  %msub
                    %mi Id
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mover
                          %mi U
                          %mo{:stretchy => "false"} ˜
                  %mover
                    %mi U
                    %mo{:stretchy => "false"} ˜
                  %msub
                    %mo ×
                    %mi U
                  %mover
                    %mi U
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde U\xrightarrow{r_{\tilde U}}Id_{\tilde U}\xrightarrow{p_{\tilde U}}\tilde U\times_U \tilde U
            of the diagonal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mrow
                      %msub
                        %mi p
                        %mover
                          %mi U
                          %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \delta_{p_{\tilde U}}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} p_{\tilde U}
            into an acyclic cofibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %mo ∈
                  %mi C
                  %mo ∩
                  %mi W
                %annotation{:encoding => "application/x-tex"} r_{\tilde U}\in C\cap W
            followed by a fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mover
                        %mi U
                        %mo{:stretchy => "false"} ˜
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p_{\tilde U}\in F
          %h3#interpretation_of_the_eliminator_for_identity_types Interpretation of the eliminator for identity types
          %p
            For interpreting the eliminator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            for
            = succeed "-types" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} Id
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo :
                  %msub
                    %mi Id
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                  %mover
                    %mo →
                    %mi U
                  %msup
                    %mi U
                    %mo *
                  %mi U
                  %mo ,
                  %mi d
                  %mo :
                  %msub
                    %mi Π
                    %mi U
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi r
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ˜
                    %mo *
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma:=(C:Id_{\tilde U}\xrightarrow{U}U^* U, d:\Pi_U(r^*_{\tilde U} C))
          %p (…)
          %h2#voevodsky_s_univalence_axiom Voevodsky’ s univalence axiom
          %p Now we will see that Voevodsky’s univalence axiom holds in the model described above.
          %p Fix the following notation
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi iscontr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mi x
                  %mo :
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mi y
                  %mo :
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Id
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} iscontr(X :Set) := (\Sigma_x :X )(\Pi_y:Y ) Id_X (x, y)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hfiber
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo :
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mi x
                  %mo :
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Id
                    %mi Y
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hfiber(X, Y :Set)(f :X \to Y )(y:Y ) := (\Sigma_x :X ) Id_Y (f (x), y)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi isweq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mi y
                  %mo :
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mi iscontr
                  %mo{:stretchy => "false"} (
                  %mi hfiber
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi f
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} isweq(X, Y :Set)(f :X \to Y ) := (\Pi_y:Y ) iscontr(hfiber(X, Y , f , y))
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Weq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Σ
                    %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mi isweq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Weq(X, Y :Set) := (\Sigma_f :X \to Y ) isweq(X, Y , f )
          %p
            The eliminator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            for identity types induces a canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi eqweq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo :
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mi isweq
                  %mo{:stretchy => "false"} (
                  %mi eqweq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} eqweq(X,Y:Set)isweq(eqweq(X,Y))
          %p
            The univalence axiom claims then that all maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi eqweq
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} eqweq(X,Y)
            are themselves weak equivalences, i.e.
          .num_defn
            %h6#definition Definition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi UnivAx
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi X
                    %mo ,
                    %mi Y
                    %mo :
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mi isweq
                    %mo{:stretchy => "false"} (
                    %mi eqweq
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} UnivAx:(\Pi X, Y:Set)isweq(eqweq(X,Y))
          .num_remark
            %h6#remark Remark
            %p
              The univalence axiom implies the
              = succeed ":" do
                %em function extensionality principle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f,g:X\to Y
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi x
                    %mo :
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Id
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi fx
                    %mo ,
                    %mi gx
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Id
                      %mrow
                        %mi X
                        %mo →
                        %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Pi x:X)Id_Y(fx,gx))\to Id_{X\to Y}(f,g)
          %p
            Even without the univalence axiom we have the following result corresponding to the fact that in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            a morphism to a Kan complex is a weak equivalence iff it is a homotopy equivalence.
          .num_remark
            %h6#remark_2 Remark
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isweq
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isweq(X,Y)(f)
              is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isiso
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi x
                    %mo :
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Id
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi fx
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mi y
                    %mo :
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi Id
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi gy
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isiso(X,Y)(f):=(\Sigma g :Y\to X)((\Pi x:X)Id_X(g(fx),x))\times ((\Pi y:Y)Id_Y(f(gy),y))
