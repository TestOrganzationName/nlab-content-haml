          %h2#idea Idea
          %p
            In
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(n)
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            an
            %em
              %a.existingWikiWord{:href => "/nlab/show/instanton"} instanton
            is a field configuration with non-vanishing second
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            that minimizes the Yang-Mills energy.
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            4. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a compact
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} field configuration
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            with
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = SU(n)
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            complex
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi P
                    %msub
                      %mo ×
                      %mi G
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E = P \times_G \mathbb{C}^n
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_\nabla \in \Omega^2(X,End(E))
            for the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} 2-form
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p
            One says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is an
            %strong instanton configuration
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                %annotation{:encoding => "application/x-tex"} F_\nabla
            is
            = succeed "-self" do
              %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %msub
                    %mi F
                    %mo ∇
                  %mo =
                  %msub
                    %mi F
                    %mo ∇
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\star F_\nabla =  F_\nabla
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo :
                  %msup
                    %mi Ω
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mrow
                      %mn 4
                      %mo −
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \star : \Omega^k(X) \to \Omega^{4-k}(X)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          %p
            The second
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi X
                  %mi Tr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi k
                  %mo ∈
                  %msup
                    %mi H
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  c_2(E) = \int_X Tr(F_\nabla \wedge F_\nabla)
                  \=
                  k
                  \\in H^4(X, \mathbb{Z})
          %p
            is called the
            %strong instanton number
            or the
            %strong instanton sector
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p Notice that therefore any connection, even if not self-dual, is in some instanton sector, as its underlying bundle has some second Chern class, meaning that it can be obtained from shifting a self-dual connection. The self-dual connections are a convenient choice of “base point” in each instanton sector.
          %h2#examples Examples
          %h3#FromTheMathsToThePhysicsStory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2)
            \-instantons from the correct maths to the traditional physics story
          %div
            %p
              The traditional story in the
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              textbooks (copied endlessly from one textbook to the next, over generations) of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/instantons"} instantons
              (
              %a.existingWikiWord{:href => "/nlab/show/BPST+instantons"}> BPST instantons
              ) tends to fail to highlight some key global points, without which the whole construction really collapses. The following text means to explain the correct description (using the mathematics of
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              cocycles via the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              on the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
              physics story becomes fully visible – including its crucial fix.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Instantons
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              any
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
              (a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instanton"} Yang-Mills instanton
              on some 4-dimensional
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (whose class is going to be the “instanton sector”), equipped with a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              (this is the actual
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/self-dual+Yang-Mills+theory"} self-dual
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                  %annotation{:encoding => "application/x-tex"} F_\nabla
              satisfies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo ∇
                      %mo =
                      %mo ⋆
                      %msub
                        %mi F
                        %mo ∇
                    %annotation{:encoding => "application/x-tex"} F_\nabla = \star F_{\nabla}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/Hodge+star"} Hodge star
              operator for the given
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} metric
              (which represents the field of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/ADHM+construction"} ADHM construction
              gives an essentially unique self-dual
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on every
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              (ie.: “in every instanton sector”). Therefore classifying and counting instantons amounts to classifying and counting
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            %p
              This is what makes instantons a “topological” structure in the parlance of physics, meaning that they do not depend on
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              information, after all.
            %p
              We now take the
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              to be
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 3
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{3,1}
              and the
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
              to be the
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/BPST-instantons"} BPST-instantons
              %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenology
              of the
              %a.existingWikiWord{:href => "/nlab/show/weak+nuclear+force"} weak nuclear force
              as seen in accelerator experiments) and it already serves to highlight key points. Since, as we just said, we may disregard all metric properties, this means now that we regard spacetime to be just the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
            %p
              Or almost. At this point one needs to be careful with the
              %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
              in order to get the topology right.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Vanishing at infinity
            %p
              The physical
              %a.existingWikiWord{:href => "/nlab/show/energy"} energy
              condition on an instanton is that the
              %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                  %annotation{:encoding => "application/x-tex"} F_\nabla
              vanishes “at infinity”. Mathematically, a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              on a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanishes at infinity
              precisely if it extends to the “
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"}> one-point compactification
              ”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo +
                    %mo ≔
                    %mi X
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X^+ \coloneqq X \cup \{\infty\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              – where we literally adjoin the “point at infinity” “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              ” and glue it to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by defining a suitable
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} X \cup \{\infty\}
            %p
              Hence we may formalize the boundary condition by saying that our
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              actually exists on the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
              %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 4
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mn 4
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^4
                    \\simeq
                    \\mathbb{R}^4 \cup \{\infty\}
                    \\,.
            %p
              It is this passage from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^4
              which takes care of the subtleties that often tend to be glossed over.
            %p
              With the boundary conditions “at infinity” taken care of this way, an
              = succeed "-instanton" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+class"} isomorphism class
              of an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              on the
              %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} S^4
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Instanton number
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BSU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B SU(2)
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              means that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are in
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              with
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BSU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B SU(2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi X
                    %mo →
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mtext -principal bundles
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mtext gauge transformations
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{X \to B SU(2)\}_{/homotopy}
                    \\;\simeq\;
                    \\{ SU(2)\text{-principal bundles}\}_{/\text{gauge transformations}}
                    \\,.
            %p
              Now for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} X = S^4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mn 4
                    %mo →
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mo ≃
                    %msub
                      %mi π
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\{S^4 \to B SU(2)\}_{/homotopy}
                    \\simeq
                    \\pi_4(B SU(2))
                    \\simeq
                    \\mathbb{Z}
            %p
              is the 4th
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BSU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B SU(2)
            %p
              This is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of instantons on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^4
              (hence on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^4
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
              identifies this number with the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/instanton+number"} instanton number
            %p
              But this counting of instantons works more generally, if we use a suitable counting function. First of all, there is a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              whose
              %em only
              non-trivial
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} \pi_4
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},4)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mn 4
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mrow
                        %mi d
                        %mo ≠
                        %mn 4
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{S^4 \to K(\mathbb{Z},4)\}_{/homotopy}
                    \\simeq
                    \\mathbb{Z}
                    \\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;
                    \\{S^{d\neq 4} \to K(\mathbb{Z},4)\}_{/homotopy}
                    \\simeq
                    0
                    \\,.
            %p
              This space has the following remarkable property:
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              into it compute
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mi X
                        %mo ⟶
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo ,
                        %mn 4
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    X \longrightarrow K(\mathbb{Z},4)
                    \\right\}_{/homotopy}
                    \\;\simeq\;
                    H^4(X,\mathbb{Z})
                    \\,.
            %p
              Now there is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    c_2 \;\colon\; B SU(2) \longrightarrow K(\mathbb{Z},4)
            %p
              called the
              = succeed "." do
                %em
                  universal
                  %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi  \;\colon\; X \longrightarrow B SU(2)
            %p to classes in degree-4 cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi B
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi c
                          %mn 2
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c_2(\chi)
                    \\;\colon\;
                    X \longrightarrow B SU(2) \overset{c_2}{\longrightarrow} K(\mathbb{Z},4)
                    \\,.
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/cohomology+class"} cohomology class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi H
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    c_2(\chi) \in H^4(X,\mathbb{Z})
            %p
              is hence called the
              %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %p
              This is one in a whole sequence of
              %em
                %a.existingWikiWord{:href => "/nlab/show/characteristic+classes"} characteristic classes
              which are carried by
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            %p
              But in the special case that the base space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is 4-
              %a.existingWikiWord{:href => "/nlab/show/dimension"}> dimensional
              , we have that only a single one of these classes may be non-trivial, namely the
              %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} c_2
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              in 4d.
            %p
              In conclusion:
              %em
                Where a
                %a.existingWikiWord{:href => "/nlab/show/BPST-instanton"} BPST-instanton
                is manifested by an
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU(2)
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                on a 4-dimensional
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                %a.existingWikiWord{:href => "/nlab/show/instanton+number"} instanton number
                is the
                %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
                of this bundle.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Constructing instantons from gauge transformations
            %p
              We may construct the bundles, that are classified this way, explicitly by using
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
            %ol
              %li
                %p
                  choosing an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (by “
                  %a.existingWikiWord{:href => "/nlab/show/charts"}> charts
                  ”)
              %li
                %p
                  choosing
                  %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi U
                          %mi i
                        %mo ∩
                        %msub
                          %mi U
                          %mi j
                        %mo →
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g_{i j} \colon U_i \cap U_j \to SU(2)
                  on each double overlap of two charts
              %li
                %p
                  such that on triple overlaps the cocycle condition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ⋅
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} \cdot g_{j k} = g_{i k}
                  holds.
            %p
              Now comes the major fact which makes this general theory look like the structures that appear in the physics books: the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
            %p
              Namely, for general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              one needs the charts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              to form a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              in order to guarantee that all isomorphism classes of gauge bundles are captured by the construction via transition functions.
            %p
              But the
              %em
                %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              says that whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              happens to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %em sufficient
              to cover it by two
              %a.existingWikiWord{:href => "/nlab/show/hemispheres"} hemispheres
              that overlap a little:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ≔
                    %mtext upper hemisphere with a little rim
                  %annotation{:encoding => "application/x-tex"}
                    U_+ \coloneqq \text{upper hemisphere with a little rim}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                    %mo ≔
                    %mtext lower hemisphere with a little rim
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_- \coloneqq \text{lower hemisphere with a little rim}
                    \\,.
            %p
              But since everything is topological now, it doesn’t matter that these charts are literally
              = succeed "-spheres" do
                %em hemi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                  %annotation{:encoding => "application/x-tex"} U_+
              maximally large and take it to cover all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^4
              except the “north pole” (which is really the “point at infinity”, due to the
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              above), while we take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                  %annotation{:encoding => "application/x-tex"} U_-
              to be a tiny
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              of that point, sitting there as a tiny ice cap around the north pole. So
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ≔
                    %msup
                      %mi S
                      %mn 4
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mtext point at infinity
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    U_+ \coloneqq S^4 - \{\text{point at infinity}\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                    %mo ≔
                    %mtext tiny neighbourhood of the point at infinity
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_- \coloneqq \text{tiny neighbourhood of the point at infinity}
                    \\,.
            %p
              Topologically this is
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
              to the situation before, and hence just as good.
            %p
              So now back to the general prescription of building
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              via
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ∩
                    %msub
                      %mi U
                      %mo −
                    %mo =
                    %mtext tiny annulus around the point at infinity
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_+ \cap U_- = \text{tiny annulus around the point at infinity}
                    \\,.
            %p Moreover, there is no non-trivial triple overlap, hence no cocycle condition that our transition function is to satisfy.
            %p
              In conclusion,
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              and the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              jointly now say that
              = succeed "-instantons" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ∩
                    %msub
                      %mi U
                      %mo −
                    %mo ⟶
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    U_+ \cap U_- \longrightarrow SU(2)
            %p But notice here that the intersection of two hemi-4-spheres that overlap slightly is just a 3-sphere times a slight thickening:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ∩
                    %msub
                      %mi U
                      %mo −
                    %mo ≃
                    %msup
                      %mi S
                      %mn 3
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi ϵ
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_+ \cap U_-
                    \\simeq
                    S^3 \times \{-\epsilon, \epsilon\}
                    \\,.
            %p Moreover, the thickening direction here is trivial, and so one finds that instantons are classified by homotopy classes of maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 3
                    %mo ⟶
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    g \;\colon\; S^3 \longrightarrow SU(2)
            %p
              This is where this “gauge transformation at infinity” in the physics textbooks really comes from. The key point here is that it is indeed gauge transforming, namely the restriction of our bundle to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                  %annotation{:encoding => "application/x-tex"} U_+
              is gauge transformed to its restriction to the “neighbourhood of infinity”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mo −
                    %annotation{:encoding => "application/x-tex"} U_-
            %p
              But, as topological spaces,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} SU(2) \simeq S^3
              and so
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mo +
                    %mo ∩
                    %msub
                      %mi U
                      %mo −
                    %mo →
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi homotopy
                    %mo ≃
                    %msub
                      %mi π
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{ U_+ \cap U_- \to SU(2) \}_{/homotopy}
                    \\simeq
                    \\pi_3(S^3)
                    \\simeq
                    \\mathbb{Z}
                    \\,.
            %p
              This way we get the same classification from
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              that we got from
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              theory, as it must be. But now we know how that
              %a.existingWikiWord{:href => "/nlab/show/second+Chern+class"} second Chern class
              may be concretely embodied in the “gauge transformation at infinity”.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Gauge fields vanishing at infinity
            %p
              Now we bring in connections. As discussed before, we may just as well consider any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              picture and still using the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              this now means to choose
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi 𝔰𝔲
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
                  \-valued 1-forms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} A_{\pm}
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} U_\pm
              %li
                %p such that on the tiny intersection of the two charts at infinity we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mo −
                        %mo =
                        %mi g
                        %msub
                          %mi A
                          %mo *
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo +
                        %mi g
                        %mi d
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        A_- = g A_* g^{-1} + g d g^{-1}
            %p
              Now observe that in the given situation of using the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              on a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %em choose
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo −
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_- = 0
                    \\,.
            %p
              Because then the above just says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A_+
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                  %annotation{:encoding => "application/x-tex"} U_+
              becomes gauge trivial “at infinity”,
              %em by the given gauge transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mn 3
                    %mo →
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \colon S^3 \to SU(2)
              (the one whose winding number counts our instantons).
            %p
              (In the present case this is really simple; but also generally there is a
              = succeed "-argument" do
                %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              = succeed ".)" do
                %a{:href => "connection+on+a+bundle#ExistenceOfConnections"} here
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong
                Counting instantons by integrating
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi tr
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mo ∇
                      %mo ∧
                      %msub
                        %mi F
                        %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} tr(F_\nabla \wedge F_\nabla)
            %p
              So far we have derived the physics picture of an instanton: An
              = succeed "-gauge" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(2)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                      %mo →
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^3 \to SU(2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                  %annotation{:encoding => "application/x-tex"} U_-
              is part of the picture, and that is necessary now to understand the Chern 4-form.
            %p
              Namely to every
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              we may assign the ordinary (abelian)
              %a.existingWikiWord{:href => "/nlab/show/differential+4-form"} differential 4-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mo ≔
                    %mi tr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\langle F_A \wedge F_A\rangle
                    \\coloneqq
                    tr(F_A \wedge F_A)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F_A
              is the
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              Now a general fact of
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
              is that the 4-form built this way from a single
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is always exact, a potential is given by the
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CS(A)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d CS(A) = \langle F_A \wedge F_A\rangle
                    \\,.
            %p
              But beware that this is only true on
              = succeed "." do
                %em a single chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                  %annotation{:encoding => "application/x-tex"} U_+
              covers “everything except infinity”, we must not forget that there is a second chart
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mo −
                    %annotation{:encoding => "application/x-tex"} U_-
            %p
              Namely the 4-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_\nabla \wedge F_\nabla\rangle
              that is defined on the whole of the 4-sphere
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} S^4
              %em locally exact
              (as every closed 4-form is, by the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Poincare+lemma"} Poincare lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mo +
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mo +
                    %mo ∧
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mo +
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\langle F_{\nabla} \wedge F_\nabla \rangle |_{U_+}
                    \\coloneqq
                    \\langle F_{A_+} \wedge F_{A_+}\rangle
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msub
                          %mi U
                          %mo −
                    %mo ≔
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mo −
                    %mo ∧
                    %msub
                      %mi F
                      %mrow
                        %msub
                          %mi A
                          %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle F_{\nabla} \wedge F_\nabla \rangle |_{U_-}
                    \\coloneqq
                    \\langle F_{A_-} \wedge F_{A_-}\rangle
                    \\,.
            %p
              This does indeed give a globally defined 4-form, no matter what the local connection forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} A_{\pm}
              are, as long as they satisfy the required condition that they are related by a
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              on the overlap
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mo +
                      %mo ∩
                      %msub
                        %mi U
                        %mo −
                    %annotation{:encoding => "application/x-tex"} U_+ \cap U_-
            %p So the 4-form thus defined
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\langle F_{\nabla} \wedge F_{\nabla} \rangle
                    \\in
                    \\Omega^4_{cl}(S^4)
            %p has
            %ol
              %li
                %p
                  a potential 3-form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CS
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mo +
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CS(A_+)
                  when restricted to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mo +
                        %annotation{:encoding => "application/x-tex"} U_+
              %li
                %p
                  a potential 3-form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CS
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi A
                          %mo −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CS(A_-)
                  when restricted to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mo −
                        %annotation{:encoding => "application/x-tex"} U_-
            %p
              but it does not have a potential 3-form on all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} S^4
            %p
              Put this way this should be very obvious now. But it is easy to get confused about this, due to the sheer convenience of the
              %a.existingWikiWord{:href => "/nlab/show/clutching+construction"} clutching construction
              used above: we actually were allowed to choose
              = succeed "!" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo −
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} A_- = 0
            %p
              This might make it superficially look like there is only a single local gauge potential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo +
                  %annotation{:encoding => "application/x-tex"} A_+
              around, and that the 4-form is locally exact. But this is not the case: there are two local gauge potentials on two different charts, and just because one of them happens to be equal to zero still does not mean that the extension of the 4-form to all of the 4-sphere has a global potential. It has a potential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CS(A_+)
              only after restricting it to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mo +
                    %annotation{:encoding => "application/x-tex"} U_+
            %p
              With it thus being understood that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_\nabla \wedge F_\nabla\rangle
              is not globally exact, it becomes believable that the integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 4
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{S^4} \langle F_\nabla \wedge F_\nabla\rangle
                    \\;\in\;
                    \\mathbb{N}
            %p
              is generally non-vanishing, and is in fact yet another incarnation of the same integer that we had before, the instanton number. That this is so is given to us by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              %strong Outlook: Chern-Simons 2-Gerbes
            %p
              In fact the full story is nicer still. Namely the local
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+3-forms"} Chern-Simons 3-forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mo ±
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CS(A_\pm)
              together with the gauge transformation at infinity form a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              cocycle for a
              %a.existingWikiWord{:href => "/nlab/show/circle+3-bundle+with+connection"} circle 3-bundle with connection
              (a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+2-gerbe"} Chern-Simons 2-gerbe
              of the gauge field. And the fourth incarnation of the instanton number is: the
              %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
              of this 2-gerbe
          %h2#properties Properties
          %h3#as_gradient_flows_between_flat_connections As gradient flows between flat connections.
          %p
            We discuss how Yang-Mills instantons may be understood as trajectories of the
            %a.existingWikiWord{:href => "/nlab/show/gradient+flow"} gradient flow
            of the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %msub
                    %mi g
                    %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Sigma,g_\Sigma)
            be a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            3-
            %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            \.
          %p
            Let the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi Σ
                  %mo ×
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  X = \Sigma \times \mathbb{R}
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            with the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            be equipped with the product metric of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            with the canonical metric on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            Consider field configurations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            of
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Sigma \times \mathbb{R}
            with finite Yang-Mills action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi YM
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi Σ
                      %mo ×
                      %mi ℝ
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %mo ⋆
                  %msub
                    %mi F
                    %mo ∇
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo &lt;
                  %mn ∞
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S_{YM}(\nabla) = \int_{\Sigma \times \mathbb{R}} F_\nabla \wedge \star F_\nabla
                  \\,\,\lt  \infty
                  \\,.
          %p
            These must be such that there is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mn 1
                  %mo &lt;
                  %msub
                    %mi t
                    %mn 2
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} t_1 \lt t_2 \in \mathbb{R}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo &lt;
                  %msub
                    %mi t
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} F_\nabla(t \lt t_1) = 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo &gt;
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F_\nabla(T \gt t_2) = 0
            %a.existingWikiWord{:href => "/nlab/show/curvature"} flat
            connections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %msub
                        %mi t
                        %mn 1
                %annotation{:encoding => "application/x-tex"} \nabla_{t_1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %msub
                          %mi t
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \nabla_{t_2}
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %mi ℝ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U\times \mathbb{R}, \mathfrak{g})
            the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-form"} Lie algebra valued 1-form
            corresponding to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mrow
                      %msub
                        %mo ∂
                        %mi t
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} A_{\partial_t} = 0
            (“
            %a.existingWikiWord{:href => "/nlab/show/temporal+gauge"}> temporal gauge
            ”). In this gauge we may hence equivalently think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a 1-parameter family
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ↦
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  t \mapsto A(t) \in \Omega^1(\Sigma, \mathfrak{g})
          %p
            of connections on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⋆
                  %msub
                    %mi F
                    %mo ∇
                %annotation{:encoding => "application/x-tex"}
                  F_\nabla = - \star F_\nabla
          %p reads equivalently
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi t
                  %mi A
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo ⋆
                    %mi g
                  %msub
                    %mi F
                    %mi A
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{d}{d t} A = -\star_{g} F_A
                  \\,\,\,
                  \\in
                  \\Omega^1(\Sigma, \mathfrak{g})
                  \\,.
          #HodgeInnerProduct.num_defn
            %h6#definition_2 Definition
            %p
              On the linear
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1(\Sigma, \mathfrak{g})
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+forms"} Lie algebra valued forms
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              define the
              %a.existingWikiWord{:href => "/nlab/show/Hodge+inner+product"} Hodge inner product
              %a.existingWikiWord{:href => "/nlab/show/metric"} metric
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} ⟨
                    %mi α
                    %mo ∧
                    %msub
                      %mo ⋆
                      %mi g
                    %mi β
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G(\alpha, \beta) := \int_{\Sigma} \langle \alpha \wedge \star_g \beta \rangle
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi 𝔤
                    %mo ⊗
                    %mi 𝔤
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \langle-,-\rangle : \mathfrak{g} \otimes \mathfrak{g} \to \mathbb{R}
              is the
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              on the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .num_prop
            %h6#proposition Proposition
            %p The instanton equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi t
                    %mi A
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ⋆
                      %mi g
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d t} A =
                    \-\star_{g} F_A
            %p
              is the equation characterizing trajectories of the
              %a.existingWikiWord{:href => "/nlab/show/gradient+flow"} gradient flow
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+action+functional"} Chern-Simons action functional
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi CS
                    %mo :
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    S_{CS} : \Omega^1(\Sigma, \mathfrak{g}) \to \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msub
                      %mo ∫
                      %mi Σ
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \mapsto \int_\Sigma CS(A)
            %p
              with respect to the
              %a{:href => "#HodgeInnerProduct"} Hodge inner product metric
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(\Sigma,\mathfrak{g})
          .proof
            %h6#proof Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variation
              of the Chern-Simons action is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %msub
                      %mi S
                      %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} ⟨
                    %mi δ
                    %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\delta S_{CS}(A) = \int_\Sigma \langle \delta A \wedge F_A\rangle
            %p
              (see
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
              for details).
            %p
              In other words, we have the 1-form on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^1(\Sigma,\mathfrak{g})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %msub
                      %mi S
                      %mi CS
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi A
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta S_{CS}(-)_A
                    \=
                    \\int_\Sigma \langle - \wedge F_A \rangle
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/gradient+vector+field"} gradient vector field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %msub
                      %mi S
                      %mi CS
                    %mo :
                    %mo =
                    %msup
                      %mi G
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi δ
                    %msub
                      %mi S
                      %mi CS
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla S_{CS}
                    \:=
                    G^{-1} \delta S_{CS}
            %p is uniquely defined by the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi δ
                            %msub
                              %mi S
                              %mi CS
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo ∇
                            %msub
                              %mi S
                              %mi CS
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mo ∫
                              %mi Σ
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo ⋆
                            %mo ∇
                            %msub
                              %mi S
                              %mi CS
                            %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta S_{CS}(-)
                    \&amp; = G(-,\nabla S_{CS})
                    \\\
                    \\int_\Sigma \langle - , \star \nabla S_{CS}\rangle
                    \\end{aligned}
                    \\,.
            %p
              With the formula (see
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                    %mo ⋆
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi A
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\star \star A = (-1)^{1(3+1)} A = A
            %p we find therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %msub
                      %mi S
                      %mi CS
                    %mo =
                    %msub
                      %mo ⋆
                      %mi g
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla S_{CS} = \star_g F_A
                    \\,.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/gradient+flow"} gradient flow
              equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi t
                    %mi A
                    %mo +
                    %mo ∇
                    %msub
                      %mi S
                      %mi CS
                    %msub
                      %mo
                      %mi A
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d t} A + \nabla S_{CS}_A = 0
            %p is indeed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi t
                    %mi A
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ⋆
                      %mi g
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d t} A =  - \star_g F_A
                    \\,.
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/curvature"} flat
            connections are the
            %a.existingWikiWord{:href => "/nlab/show/critical+loci"} critical loci
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi CS
                %annotation{:encoding => "application/x-tex"} S_{CS}
            this says that a finite-action Yang-Mills instanton on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Sigma \times \mathbb{R}
            is a gradient flow trajectory between two
            %em
              Chern-Simons theory
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacua
            \.
          %p
            Often this is interpreted as saying that “a Yang-Mills instanton describes the
            %a.existingWikiWord{:href => "/nlab/show/tunneling"} tunneling
            between two
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/vacua"} vacua
          %h3#AsDpDpPlus4BraneBoundStates As Dp-D(p+4)-brane bound states
          %p
            Due to the
            %a.existingWikiWord{:href => "/nlab/show/higher+WZW+term"} higher WZW term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∝
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi D
                        %mrow
                          %mi p
                          %mo +
                          %mn 4
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mo ∧
                  %mo{:stretchy => "false"} ⟨
                  %mi F
                  %mo ∧
                  %mi F
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \propto \int_{D_{p+4}} C_{p+1} \wedge \langle F \wedge F \rangle
            in the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma+model"} Green-Schwarz sigma model
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D(p+4)-branes
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            in the
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            on
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D (p+4)
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B4%29-brane+bound+states"} Dp-D(p+4)-brane bound states
            (see e.g.
            = succeed "," do
              %a{:href => "#Polchinski96"} Polchinski 96, 5.4
            = succeed ")." do
              %a{:href => "#Tong05"} Tong 05, 1.4
          %p
            The lift to
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            as
            %a.existingWikiWord{:href => "/nlab/show/M5-MO9+brane+bound+states"} M5-MO9 brane bound states
            is due to
            = succeed "," do
              %a{:href => "#Strominger90"} Strominger 90
            = succeed "." do
              %a{:href => "#Witten96"} Witten 96
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B4%29-brane+bound+states"} Dp-D(p+4)-brane bound states
                and
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/D0-D4+brane+bound+state"} D0-D4 brane bound state
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/D1-D5+brane+bound+state"} D1-D5 brane bound state
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/D4-D8+brane+bound+state"} D4-D8 brane bound state
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/M5-MO9+brane+bound+state"} M5-MO9 brane bound state
          %h2#examples_2 Examples
          %ul
            %li
              %p
                In
                = succeed "-YM" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(2)
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BPST+instanton"} BPST instanton
                \.
            %li
              %p
                In
                = succeed "-YM" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(3)
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/strong+nuclear+force"} strong nuclear force
                %em
                  %a.existingWikiWord{:href => "/nlab/show/instanton+in+QCD"} instanton in QCD
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/theta+vacuum"}> theta vacuum
                ,
                %a.existingWikiWord{:href => "/nlab/show/instanton+sea"} instanton sea
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/instanton"} instanton
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bogomolny+equation"}> Bogomolny equation
                ,
                %a.existingWikiWord{:href => "/nlab/show/Nahm+transform"} Nahm transform
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/small+instanton"} small instanton
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/caloron"} caloron
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative effect
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/instanton+Floer+homology"} instanton Floer homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+field"} self-dual higher gauge field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/magnetic+monopole"} magnetic monopole
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac+monopole"}> Dirac monopole
                ,
                %a.existingWikiWord{:href => "/nlab/show/Yang+monopole"} Yang monopole
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/gravitational+instanton"} gravitational instanton
          %h2#references References
          %p
            The
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ADHM+construction"} ADHM construction
          %ul
            %li#ADHM
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"} Nigel Hitchin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Drinfeld"} Vladimir Drinfeld
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Manin"} Yuri Manin
              = succeed "," do
                %em Construction of instantons
              %strong 65
              3 (1978) 185-187 &amp;lbrack;
              %a{:href => "http://www.new.ox.ac.uk/system/files/ADHM.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/0375-9601(78)90141-X"} doi:10.1016/0375-9601(78)90141-X
          %h3#general General
          %p Introductions and surveys:
          %ul
            %li
              %p
                J. Zinn-Justin,
                = succeed "," do
                  %em The principles of instanton calculus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Shifman"} Mikhail Shifman
                et al.,
                = succeed "," do
                  %em ABC of instantons
                %strong 32
                11 (1984) 585
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tohru+Eguchi"}> Tohru Eguchi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Gilkey"} Peter Gilkey
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrew+Hanson"} Andrew Hanson
                = succeed "," do
                  %em Gravitation, gauge theories and differential geometry
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0370-1573(80)90130-1"} doi:10.1016/0370-1573(80)90130-1
            %li#Tong05
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Tong"}> David Tong
                ,
                %em TASI Lectures on Solitons
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0509216"}> arXiv:hep-th/0509216
                ),
                %em Lecture 1: Instantons
                (
                %a{:href => "http://www.damtp.cam.ac.uk/user/tong/tasi/instanton.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Lindenhovius"}> Bert Lindenhovius
                ,
                = succeed "," do
                  %em Instantons and the ADHM construction
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Lindenhovius-Instantons.pdf", :title => "pdf"} pdf
            %li
              %p
                Nick Dorey, Timothy J. Hollowood, Valentin V. Khoze, Michael P. Mattis,
                = succeed "," do
                  %em The Calculus of Many Instantons
                %strong 371
                (2002) 231-459 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/0206063"}> arXiv:hep-th/0206063
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0370-1573(02)00301-0"} doi:10.1016/S0370-1573(02)00301-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Taro+Kimura"}> Taro Kimura
                ,
                = succeed "," do
                  %em Instanton Counting and Localization
                = succeed "," do
                  %em Instanton Counting, Quantum Geometry and Algebra
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-030-76190-5_4"} doi:10.1007/978-3-030-76190-5_4
          %p
            A survey in view of the
            %a.existingWikiWord{:href => "/nlab/show/asymptotic+series"} asymptotic
            nature of the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            is in
          %ul
            %li#Suslov05
              %a.existingWikiWord{:href => "/nlab/show/Igor+Suslov"}> Igor Suslov
              , section 4.5 of
              = succeed "," do
                %em Divergent perturbation series
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-ph/0510142"} arXiv:hep-ph/0510142
          %p For a fairly comprehensive list of literature see the bibliography of
          %ul
            %li
              Marcus Hutter,
              %em Instantons in QCD: Theory and Application of the Instanton Liquid Model
              (
              %a{:href => "http://arxiv.org/abs/hep-ph/0107098"}> arXiv:hep-ph/0107098
              )
          %p
            Identification of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of instantons with that of
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+maps"} holomorphic maps
            from the
            %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            to the
            %a.existingWikiWord{:href => "/nlab/show/loop+group"} loop group
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
          %ul
            %li#Atiyah84
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %em Instantons in two and four dimensions
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BF01212288"} doi:10.1007/BF01212288
          %p
            with a proposed generalization to a two-dimensional
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          %ul
            %li
              Hong-Liang Hu.
              = succeed "." do
                %em
                  Topological
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                  models with loop groups as the target manifolds
              = succeed ")." do
                %a{:href => "https://doi.org/10.1103/PhysRevD.44.2498"} doi
          %p
            Detailed argument for the
            %a.existingWikiWord{:href => "/nlab/show/theta-vacuum"} theta-vacuum
            structure from
            %a.existingWikiWord{:href => "/nlab/show/chiral+symmetry+breaking"} chiral symmetry breaking
            is offered in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Curtis+Callan"}> Curtis Callan
                , R.F. Dashen,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gross"} David Gross
                = succeed "," do
                  %em The Structure of the Gauge Theory Vacuum
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/3673?ln=en"} spire
            %li
              %p
                G. Morchio,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Franco+Strocchi"} Franco Strocchi
                = succeed "," do
                  %em Chiral symmetry breaking and theta vacuum structure in QCD
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0907.2522"} arXiv:0907.2522
          %p
            The multi-instantons in
            = succeed "-Yang-Mills" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/BPST+instantons"} BPST instantons
          %ul
            %li
              %p
                A. A. Belavin, A.M. Polyakov, A.S. Schwartz, Yu.S. Tyupkin,
                = succeed "," do
                  %em Pseudoparticle solutions of the Yang-Mills equations
                %a{:href => "http://dx.doi.org/10.1016/0370-2693(75)90163-X"} doi
            %li
              %p
                A. A. Belavin, V.A. Fateev, A.S. Schwarz, Yu.S. Tyupkin,
                = succeed "," do
                  %em Quantum fluctuations of multi-instanton solutions
                %a{:href => "http://dx.doi.org/10.1016/0370-2693(79)91117-1"} doi
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"} Nigel Hitchin
                = succeed "," do
                  %em Deformations of instantons
                = succeed "," do
                  %strong 74
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Some comments on the recent twistor space constructions
          %p Methods of algebraic geometry were introduced in
          %ul
            %li
              M. F. Atiyah, R. S. Ward,
              = succeed "," do
                %em Instantons and algebraic geometry
              = succeed "," do
                %strong 55
              = succeed "," do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=0494098"} MR0494098
              %a{:href => "http://projecteuclid.org/euclid.cmp/1103900980"} euclid
          %p
            The more general
            %a.existingWikiWord{:href => "/nlab/show/ADHM+construction"} ADHM construction
            in terms of linear algebra of vector bundles on projective varieties is proposed in
          %ul
            %li
              M.F. Atiyah, N.J. Hitchin, V.G. Drinfeld, Yu.I. Manin,
              = succeed "," do
                %em Construction of instantons
              %a{:href => "http://www.new.ox.ac.uk/system/files/ADHM.pdf"} pdf
          %p Monographs with the standard material include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Karen+Uhlenbeck"} Karen Uhlenbeck
                = succeed "," do
                  %em Instantons and four-manifolds
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"}> Robbert Dijkgraaf
                ,
                %em Topological gauge theories and group cohomology
                (
                %a{:href => "staff.science.uva.nl/~rhd/papers/group.ps"}> ps
                )
            %li
              %p
                Nicholas Manton, Paul M. Sutcliffe,
                = succeed "," do
                  %em Topological solitons
                %a{:href => "http://books.google.com/books?id=e2tPhFdSUf8C"} gBooks
          %p Yang-Mills instantons on spaces other than just spheres are explicitly discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gabor+Kunstatter"}> Gabor Kunstatter
              ,
              = succeed "," do
                %em Yang-mills theory in a multiply connected three space
              = succeed ")" do
                %a{:href => "http://adsabs.harvard.edu/abs/1982LNP...153..118K"} web
          %p based on
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Isham"}> Chris Isham
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gabor+Kunstatter"} Gabor Kunstatter
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1016/0370-2693%2881%2991244-2"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chris+Isham"} Chris Isham
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gabor+Kunstatter"} Gabor Kunstatter
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1063/1.525552"} doi
          %p In
          %ul
            %li
              Henrique N. Sá Earp,
              %em
                Instantons on
                = succeed "\u2212manifolds" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} G_2
              PhD thesis (2009) (
              %a{:href => "http://www.ime.unicamp.br/~hqsaearp/index_files/HENRIQUE_SA_EARP_THESIS_UPDATED.PDF"}> pdf
              )
          %p
            is a discussion of Yang-Mills instantons on a 7-dimensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+special+holonomy"} manifold with special holonomy
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Atiyah"}> Michael Atiyah
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/R.+Bott"} R. Bott
              = succeed "," do
                %em The Yang-Mills equations over Riemann surfaces
              = succeed "," do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=702806"} MR85k:14006
              = succeed "." do
                %a{:href => "http://dx.doi.org/10.1098/rsta.1983.0017"} doi
          %h3#as_dpdp4brane_bound_states_2 As Dp-D(p+4)-brane bound states
          %p
            The argument that
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+instantons"} Yang-Mills instantons
            in the
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            on a
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D(p+4)-brane
            are equivalent to
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B4%29+brane+bound+states"} Dp-D(p+4) brane bound states
            goes back to
          %ul
            %li#Witten96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                ,
                = succeed "," do
                  %em Small Instantons in String Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9511030"} arXiv:hep-th/9511030
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"}> Michael Douglas
                ,
                = succeed "," do
                  %em Branes within Branes
                %em
                  %a{:href => "https://link.springer.com/book/10.1007/978-94-011-4730-9"} Strings, Branes and Dualities
                NATO ASI Series (Series C: Mathematical and Physical Sciences), vol 520. Springer, Dordrecht (
                %a{:href => "https://arxiv.org/abs/hep-th/9512077"}> arxiv:hep-th/9512077
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-94-011-4730-9_10"} doi:10.1007/978-94-011-4730-9_10
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"}> Michael Douglas
                ,
                = succeed "," do
                  %em Gauge Fields and D-branes
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9604198"} arXiv:hep-th/9604198
          %p following
          %ul
            %li#Strominger90
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Strominger"}> Andrew Strominger
              ,
              = succeed "," do
                %em Heterotic solitons
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0550-3213(90)90599-9"} doi:10.1016/0550-3213(90)90599-9
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0550-3213(91)90349-3"} doi:10.1016/0550-3213(91)90349-3
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/27900"} spire:27900
          %p Review is in:
          %ul
            %li#Polchinski96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Polchinski"}> Joseph Polchinski
                , Section 5.4 of:
                %em TASI Lectures on D-Branes
                (
                %a{:href => "https://arxiv.org/abs/hep-th/9611050"}> arXiv:hep-th/9611050
                )
            %li#Tong05
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Tong"}> David Tong
                , Section 1.4 of
                %em TASI Lectures on Solitons
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0509216"}> hep-th/0509216
                )
          %p
            Discussion specifically of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D0-D4-brane+bound+states"} D0-D4-brane bound states
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
              ,
              = succeed "," do
                %em Instantons on D-branes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9512078"} arXiv:hep-th/9512078
          %p
            with emphasis to the resulting
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em A Strong Coupling Test of S-Duality
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9408074"} arXiv:hep-th/9408074
          %p
            Discussion specifically of
            %a.existingWikiWord{:href => "/nlab/show/D1-D5-brane+bound+states"} D1-D5-brane bound states
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Neil+Lambert"}> Neil Lambert
              ,
              = succeed "," do
                %em D-brane Bound States and the Generalised ADHM Construction
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9707156"} arXiv:hep-th/9707156
          %p
            Discussion specifically of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D4-D8-brane+bound+states"} D4-D8-brane bound states
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/Witten-Sakai-Sugimoto+model"} Witten-Sakai-Sugimoto model
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFT"} geometrically engineering
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
            %a.existingWikiWord{:href => "/nlab/show/D4-branes"} D4-branes
            get interpreted as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/baryons"} baryons
          %ul
            %li#SakaiSugimoto04
              %a.existingWikiWord{:href => "/nlab/show/Tadakatsu+Sakai"}> Tadakatsu Sakai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Shigeki+Sugimoto"} Shigeki Sugimoto
              = succeed "," do
                %em Low energy hadron physics in holographic QCD
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0412141"} arXiv:hep-th/0412141
        .revisedby
