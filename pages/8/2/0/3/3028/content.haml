                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \langle v, v\rangle \in [0,\infty)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle v, v\rangle = 0
                if and only if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} v = 0
          %p Ideally, we want to deal solely with Hilbert spaces but first we need to figure out how to deal with completeness without recourse to metric space theory. We do this by using orthonormal families.
          #ofam.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,\langle -, - \rangle)
              be an inner product space. An
              %strong orthogonal family
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊆
                    %mi V
                  %annotation{:encoding => "application/x-tex"} B \subseteq V
              with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi b
                    %mo ,
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \langle b, b'\rangle = 0
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ,
                    %mi b
                    %mo ′
                    %mo ∈
                    %mi B
                  %annotation{:encoding => "application/x-tex"} b,b' \in B
              are distinct.
            %p
              The family is said to be
              %strong orthonormal
              if, in addition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi b
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \langle b, b\rangle = 1
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b \in B
            %p
              Two vectors, say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{u,v\}
              is an orthogonal family.
          %p Using orthogonal families, we can express the notion of completeness as follows.
          #hilb.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong Hilbert space
              is an inner product space,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H, \langle -, -\rangle)
              in which the following property holds. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b_n)
              be an orthonormal sequence and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda_n)
              a sequence of positive real numbers such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msubsup
                      %mi λ
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sum \lambda_n^2
              is bounded. Then there is some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi H
                  %annotation{:encoding => "application/x-tex"} v \in H
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi H
                    %annotation{:encoding => "application/x-tex"} u \in H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msub
                      %mi λ
                      %mi n
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi b
                      %mi n
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sum \lambda_n \langle b_n, u \rangle = \langle v, u \rangle.
          .un_remark
            %h6#remark Remark
            %p
              We need to justify this notion of completeness. One direction is simple: the sequence of partial sums of the series
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msub
                      %mi λ
                      %mi n
                    %msub
                      %mi b
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sum \lambda_n b_n
              is Cauchy and so if the space is complete, it has a limit and this limit satisfies the criterion.
            %p
              The other direction takes a little more effort. The quickest (but dirtiest) route is simply to observe that if that condition is satisfied then whenever we have an isometry from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℓ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \ell^0
              (with its standard inner product) into our space then it extends to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℓ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \ell^2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_n)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Gram%E2%80%93Schmidt+process"} Gram–Schmidt process
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (b_n)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \lambda_k
              as the limit (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi x
                        %mi n
                      %mo ,
                      %msub
                        %mi b
                        %mi k
                      %mo{:stretchy => "false"} ⟩
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\langle x_n, b_k\rangle)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \lambda_k
              a positive real number by taking the phase factor in to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi k
                    %annotation{:encoding => "application/x-tex"} b_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s_n)
              be the sequence of partial sums of the series
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %msub
                        %mi λ
                        %mi k
                      %msub
                        %mi b
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \sum \lambda_k b_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s_n)
              is Cauchy and the interpolation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s_n)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n)
              is also Cauchy. By assumption,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (s_n)
              has a weak limit. As it is Cauchy, the existence of a weak limit is enough to show that it has a strong limit. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n)
              also converges and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is complete.
            %p The tenor of the new definition and its equivalence to the standard one is a theme that will run throughout this page. In our elementary treatment, weak definitions are to be preferred to the standard strong ones. Their equivalence exposes some of the deep results of Hilbert space theory.
          %p
            As this is intended as an elementary treatment, it is likely that at some point we will want to assume that our Hilbert space is “small”, by which (of course) we mean “
            %a.existingWikiWord{:href => "/nlab/show/separable+space"}> separable
            ”. Fortunately, it is not hard to formulate separability without recourse to metric spaces.
          #sep.num_defn
            %h6#definition_4 Definition
            %p
              An inner product space is
              %strong separable
              if it contains a sequence, say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_n)
              with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi x
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \langle x, x_n\rangle = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} x = 0
          %h2#cauchyschwarz Cauchy–Schwarz
          %p The Cauchy–Schwarz inequality is one of the basic results of Hilbert space theory. As we wish to avoid any mention of a norm, we state it as follows.
          #csineq.num_proposition
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              be a Hilbert space,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ∈
                      %mi H
                    %annotation{:encoding => "application/x-tex"} u,v \in H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %msup
                      %mo{:stretchy => "false"} |
                      %mn 2
                    %mo ≤
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    |\langle u, v \rangle|^2 \le \langle u, u \rangle \langle v, v \rangle
            %p
              with equality if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are collinear.
          .query
            %p I removed the square roots here, since there doesn't seem to be much point to them if you're not going to connect with a metric. (On the other hand, surely even an elementary treatment of Hilbert spaces may deign to mention the geometric concept of distance? It's one thing to not assume a knowledge of metric spaces, but it's another thing to refuse to even mention norms.) —Toby
            %p
              As you can (probably) tell, I’m making this up as I go along! I’ve not decided yet whether to allow distances or not, so at the moment I’m avoiding them if possible. Part of my goal is to avoid overwhelming the “reader” with notation just for the sake of it. So I may well implicitly use the norm as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle v, v\rangle
              but without introducing the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi v
                    %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \|v\|
              notation. But although I expect I’ll be the main contributor here, I don’t particularly want to be so I’m more than happy for others to weigh in with their opinions on what an “elementary treatment” would look like. If I disagree then it’ll force me to think carefully
              %em why
              I disagree and that can only improve things.
            %p Pondering a little more, I think that I’m avoiding distance not because I don’t think it belongs in an elementary treatment - as you imply, what could be more simple to understand than distance? - but because it’s a way of keeping metric spaces at bay: once I start talking about distances then it’ll be easy to talk about metrics and the like.
            %p I think you’re right about the square roots, by the way. —Andrew
            %p Since accidentally using metric space theory is always a danger, I understand not wanting to mention distances and norms right away. On the other hand, I do think that any introductory treatment ought to mention them at some point, and even to prove that they satisfy the triangle inequality and Cauchy completeness. But those should be theorems specifically about the concept of distance in a Hilbert space, not anything fundamental to the development of the general theory of Hilbert spaces. So sure, keep them out for now. —Toby
          .proof
            %h6#proof Proof
            %p
              The “if and only if” part gives us the key to the most direct proof. It will simplify matters a little if we assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are non-zero, the case where one of them is zero being easy to establish.
            %p
              Now if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are collinear then there is some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{C}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %mi λ
                      %mi v
                    %annotation{:encoding => "application/x-tex"} u = \lambda v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              which can be found by taking inner products with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              exists such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mi λ
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u = \lambda v
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \lambda = \langle u, v\rangle/\langle v, v\rangle
              = succeed "?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo =
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                    %annotation{:encoding => "application/x-tex"} \langle v, v\rangle u = \langle u, v\rangle v
              = succeed "?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo −
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle v, v\rangle u - \langle u, v\rangle v = 0
            %p
              We have a test for when a vector is non-zero using the inner product. One of the axioms for an inner product says that a vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              is zero if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle w, w\rangle = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi w
                      %mo ,
                      %mi w
                      %mo{:stretchy => "false"} ⟩
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle w, w\rangle \ge 0
            #eq:csineq.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo −
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                      %mo ,
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo −
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                      %mo ⟩
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle \langle v, v\rangle u - \langle u, v\rangle v, \langle v, v\rangle u - \langle u, v\rangle v \right\rangle \ge 0
            %p
              with equality if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are collinear.
            %p Before expanding out the left hand side of this, we note that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo −
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                      %mo ,
                      %mi v
                      %mo ⟩
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle \langle v, v\rangle u - \langle u, v\rangle v , v \right\rangle = 0
            %p
              whence
              %a.maruku-eqref{:href => "#eq:csineq"} (1)
              simplifies to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %mo{:stretchy => "false"} ⟨
                      %mi v
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi u
                      %mo −
                      %mo{:stretchy => "false"} ⟨
                      %mi u
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} ⟩
                      %mi v
                      %mo ,
                      %mi u
                      %mo ⟩
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle \langle v, v\rangle u - \langle u, v\rangle v, u \right\rangle \ge 0
            %p
              with equality if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are collinear. Expanding this out yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %mi u
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟨
                    %mi v
                    %mo ,
                    %mi u
                    %mo{:stretchy => "false"} ⟩
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\langle v,v\rangle \langle u,u\rangle - \langle u, v \rangle \langle v, u\rangle \ge 0
            %p
              with equality if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are collinear. Rearranging and square-rooting produces the traditional statement of the Cauchy–Schwarz inequality.
