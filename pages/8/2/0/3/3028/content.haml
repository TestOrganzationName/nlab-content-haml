                      %mo ×
                      %mo{:stretchy => "false"} |
                      %mi V
                      %mo{:stretchy => "false"} |
                      %mo →
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} |V| \times |V| \to \mathbb{C}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
