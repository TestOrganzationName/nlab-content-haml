                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \langle v, u\rangle = \overline{\langle u, v\rangle}
                ,
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
