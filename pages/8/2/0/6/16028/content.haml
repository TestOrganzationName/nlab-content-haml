                %annotation{:encoding => "application/x-tex"} Q
            there is itself a
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_118.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            that exhibits
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_119.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            itself as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            = succeed "." do
