                  \\hookrightarrow
                  {\widehat \mathbb{R}}^{d-1,1\vert N}
                  \\stackrel{\mathbf{L}_{WZW}}{\longrightarrow}
                  \\mathbf{B}^{p+1} (\mathbb{R}/\Gamma)_{conn}
          %p
            Consider then the
            %a.existingWikiWord{:href => "/nlab/show/quantomorphism+n-group"} quantomorphism n-group
            of this formal WZW term (
            %a{:href => "#FRS13a"}> FRS 13a
            ), defined by sitting in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_133.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QuantMorph
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi WZW
                    %mi formal
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔻
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} |
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi WZW
                        %mi forma
                      %mo ∘
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
