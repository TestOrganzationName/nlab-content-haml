            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi d
