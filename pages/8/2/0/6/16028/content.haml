                  }
                  \\,,
          %p
            hence is some space
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_106.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
