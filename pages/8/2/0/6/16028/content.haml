            is equivalent to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi CE
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (CE(\mathfrak{g}), d_{CE})
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            of this Lie algebra.
          %p
            If we her allow
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            to be a
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            so that
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
            is now
            = succeed "-bigraded," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{Z}, \mathbb{Z}/2)
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                %annotation{:encoding => "application/x-tex"} d_{CE}
            to be of degree
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi even
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (1,even)
            (see at ) then in the same way we find that this is equivalent to the structure of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          %p
            Now more generally, let
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be a
            = succeed "-" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            (degreewise finite dimensional, hence of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi even
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (1,even)
            differentials
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                %annotation{:encoding => "application/x-tex"} d_{CE}
            on
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %msup
                    %mi 𝔤
                    %mo *
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
            are equivalent to choices of
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebra"} super L-∞ algebra
            structures on
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            Finally, still a bit more generally, let
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔞
                    %mn 0
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0 = C^\infty(X)
            be the algebra of functions on some (
            %a.existingWikiWord{:href => "/nlab/show/supermanifold"}> super
            )
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            = succeed "," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕒
                %annotation{:encoding => "application/x-tex"} \mathbb{a}
            be an
            = succeed "-graded" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
            over
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕒
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{a}_0
            which in degree 0 is
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Sym
                    %mrow
                      %msub
                        %mi 𝔞
                        %mn 0
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝔞
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sym^\bullet_{\mathfrak{a}_0}(\mathfrak{a}^\ast)
            for the graded-symmetric algebra of the
            = succeed "-dual" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi CE
                %annotation{:encoding => "application/x-tex"} d_{CE}
            in this (
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} mnathbb
                  %mi R
                %annotation{:encoding => "application/x-tex"} \mnathbb{R}
            \-linear, not necesssarily
            = succeed "-linear)" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔞
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}_0
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_72.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Sym
                    %mrow
                      %msub
                        %mi 𝔞
                        %mn 0
                    %mo •
                  %msup
                    %mi 𝔞
                    %mo *
                  %mo ,
                  %msub
                    %mi d
                    %mi CE
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(\mathfrak{a}) \coloneqq (Sym^\bullet_{\mathfrak{a}_0} \mathfrak{a}^\ast, d_{CE})
          %p
            for this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_73.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %msub
                    %mi L
                    %mn ∞
                  %mi Algd
                  %mo ↪
                  %msup
                    %mi sdgAlg
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  s L_\infty Algd \hookrightarrow sdgAlg^{op}
          %p
            of that of super-
            %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            whose underlying graded algebra is free on a graded super vector space in this way we call that of
            = succeed "." do
              %em
                super
                = succeed "-algebroids" do
                  %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} L_\infty
          %p examples
          %p
            %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"}> super Poincaré Lie algebra
            …
          %p
            %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"}> super Minkowski spacetime
            \:
          %p
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo =
                  %mi 𝔰ℑ𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} |
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi 𝔰𝔬
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N} = \mathfrak{sIso}(d-1,1\vert N)/\mathfrak{so}
          %p
            in fact for higher dimensional
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            we need
            = succeed "\u2026" do
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetimes"} extended super Minkowski spacetimes
          %h2#higher_wesszuminowittentype_sigmamodels Higher Wess-Zumino-Witten-type sigma-models
          %h3#cohomology Cohomology
          %p
            A miracle happens when one passes from
            %a.existingWikiWord{:href => "/nlab/show/Lorentzian+geometry"} Lorentzian geometry
            to Lorentzian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          %p
            While the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            and
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            is fairly trivial…
          %p
            …the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert N}
            turns out to have “exceptional” cohomology classes of degree
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            for some special combinations of
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                of
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %li
              %p
                the real
                %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
                = succeed ";" do
                  %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
            %li
              %p
                the degree
                %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
                (where, see in a few lines below,
                %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                turns out to be the
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                of a
                %a.existingWikiWord{:href => "/nlab/show/super+p-brane"} super p-brane
                propagating through spacetime).
          %p
            More precisely, it is the
            = succeed "-invariant" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(d-1,1)
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            of
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Iso
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} |
                      %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Iso(\mathbb{R}^{d-1,1\vert N})
            which has these exceptional cocycles, and hence the
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            = succeed "." do
              %a{:href => "#TheCompletedBrainScan"} below
          %p
            But the thing is: ever since
            %a.existingWikiWord{:href => "/nlab/show/Paul+Dirac"} Paul Dirac
            it is known that given a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            of degree
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            on
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            – such as a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle+with+connection"} line bundle with connection
            representing the
            %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            – then this serves as the
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background field
            for a
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            describing the propagation of a
            %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
            in
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which is
            %a.existingWikiWord{:href => "/nlab/show/charge"} charged
            under this
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            and feels its
            %a.existingWikiWord{:href => "/nlab/show/forces"} forces
            – such as, for
            = succeed "," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p = 0
            %a.existingWikiWord{:href => "/nlab/show/electron"} electron
            subject to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
          %p
            Moreover, the consideration of
            %a.existingWikiWord{:href => "/nlab/show/Dirac+monopoles"} Dirac monopoles
            and other
            %a.existingWikiWord{:href => "/nlab/show/instantons"} instantons
            and
            %a.existingWikiWord{:href => "/nlab/show/black+branes"} black branes
            shows that given any such
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            %em induces
            %a.existingWikiWord{:href => "/nlab/show/p-branes"} p-branes
            which are charged under it: the
            %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            turns out to give the
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            for which the
            %a.existingWikiWord{:href => "/nlab/show/black+branes"} black branes
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effects"} non-perturbative effects
          %p
            This is how most of the
            %a.existingWikiWord{:href => "/nlab/show/p-branes"} p-branes
            in
            %a.existingWikiWord{:href => "/nlab/show/superstring+theory"} superstring theory
            and
            %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
            were originally found by looking at
            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black brane
            solutions in higher dimesnional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
          %p
            More in detail, the higher dimensional analog of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+force"} Lorentz force
            %a.existingWikiWord{:href => "/nlab/show/p-branes"} p-branes
            is given by
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            which is the
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            (
            %a.existingWikiWord{:href => "/nlab/show/higher+volume+holonomy"}> higher volume holonomy
            ) of the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            over the
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
            %em
              %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
            in
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+WZW+theory"} higher dimensional WZW theory
          %p Locally this is a simple phenomenon, and this local picture is what most of the physics textbook will ever consider:
          %p
            there is a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential
            %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature (p+2)-form
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            on the local model space
            = succeed "," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+space"} Minkowski space
            then it is
            %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible space
            hence there is a “higher
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^{p+1}(G/H)
            such that
            = succeed "," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \omega = \mathbf{d}A
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            in question is just that given by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
          %p
            However, already in local model spaces such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            may not have such a potential that is
            = succeed "-invariant." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
            leaves a given local model space
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} G/H \hookrightarrow X
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+transformation"} higher gauge transformation
            to connect the interaction terms on the two patches. Still worse, these gauge transformation need to glue (need to “
            %a.existingWikiWord{:href => "/nlab/show/descent"}> descent
            ” along the
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            = succeed ")" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_95.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \coprod_i G/H \to X
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/classical+anomalies"} classical anomalies
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_96.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            For the traditional 2d
            %a.existingWikiWord{:href => "/nlab/show/WZW+model"} WZW model
            this was eventually fairly widely appreciated, for
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+WZW+models"} higher dimensional WZW models
            this is still much of an open secret.
          %p
            Before proceeding to the explanation of the global higher WZW terms, we consider some
            %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
            now.
          %h3#higher_wzw_terms Higher WZW terms
          %p
            Observation:
            = succeed "-cocycle" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_97.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_98.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{g} \longrightarrow \mathbf{B}^{}
          .un_prop
            %h6#proposition Proposition
            %p
              These have
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              to global WZW term
            .maruku-equation
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_99.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi WZW
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi Γ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{WZW}
                    \\;\colon\;
                    \\tilde G \longrightarrow \mathbf{B}^{p+1}(\mathbb{R}/\Gamma)_{conn}
          %p
            (
            %a{:href => "#FSS13"}> FSS 13, section 5
            )
          %h3#brane_intersection_laws_and_brane_condensates_in_extended_superspacetime Brane intersection laws and Brane condensates in extended super-spacetime
          %p
            We discuss now a way (
            %a{:href => "#FSS13"}> FSS 13
            ) to find the
            %a.existingWikiWord{:href => "/nlab/show/boundary+conditions"} boundary conditions
            and brane condensates via
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            and via the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            for
            %a.existingWikiWord{:href => "/nlab/show/local+prequantum+field+theory"} local prequantum
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/boundary+field+theory"} boundary field theory
          %p
            So given a
            = succeed "-" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_100.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
            %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+algebroid+cohomology"} cocycle
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/super+Minkowski+spacetime"} super Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
            of the form
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_101.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
