                  \\mathbb{D}^{d-1,1\vert N}
                  \\\
                  \&amp; {}_{\mathllap{\mathbf{L}_{WZW}^{formal}}}\searrow
                  \&amp;\simeq&amp; \swarrow_{\mathrlap{\mathbf{L}_{WZW}^{formal}}}
                  \\\
                  \&amp;&amp;
                  \\mathbf{B}^{p+1} (\mathbb{R}/\Gamma)_{conn}
                  }
                  \\right\}
          %p
            An element in this group is precisely the datum needed to change
            %a.existingWikiWord{:href => "/nlab/show/tangent+spaces"} tangent spaces
            in a
            %a.existingWikiWord{:href => "/nlab/show/Cartan+connection"} Cartan connection
            while carrying also the WZWZ term along! See also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/parameterized+WZW+model"} parameterized WZW model
          %p
            By the discussion in (
            %a{:href => "#FRS13a"}> FRS 13a
            ), this is the general higher and super-analog of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fivebrane+6-group"} fivebrane 6-group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ninebrane+10-group"} ninebrane 10-group
          .maruku-equation
