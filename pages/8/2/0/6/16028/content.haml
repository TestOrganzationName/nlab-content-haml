            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            %em
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            in this algebra is a map
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
