                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
