                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi WZW
                    %mi formal
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  p Brane(d\vert N)
                  \\coloneqq
                  QuantMorph(\mathbf{L}_{WZW}^{formal})
          %p
            Now the claim is that the
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            to globally anomlay free super
            = succeed "-brane" do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_137.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-brane\u201D-structure," do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_138.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_139.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
