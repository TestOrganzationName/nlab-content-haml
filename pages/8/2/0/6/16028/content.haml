            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
            for the
            %a.existingWikiWord{:href => "/nlab/show/bulk+field+theory"} bulk
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            to this space is equipped with a choice of gauge trivialization
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_107.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
