                      %mi conn
                  %annotation{:encoding => "application/x-tex"} [\mathbf{B}^{p+1}(\mathbb{R}/\Gamma)_{conn}
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+connections"} moduli stack of connections
            on the given
            %a.existingWikiWord{:href => "/nlab/show/formal+disk"} formal disk
            inside
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extended+super+Minkowski+spacetime"} extended super Minkowski spacetime
          %p
            Intuitively this
