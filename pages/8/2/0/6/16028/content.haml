                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Sigma_{p+1}
                  \\stackrel{\phi}{\longrightarrow}
                  \\mathbb{R}^{d-1,1 \vert N}
                  \\stackrel{\mu_{p+2}}{\longrightarrow}
                  \\mathbf{B}^{p+1} \mathbb{R}
                  }
          %p
            and the composite is (the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of) the
            %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
            of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            = succeed ")" do
              %a{:href => "#FSS13"} FSS 13
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            to produce from this the full higher
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/WZW+term"} WZW term
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundle"} prequantum n-bundle
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
          .maruku-equation
            %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_103.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi WZW
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
