            which is a graded
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of degree 1 and squares to 0,
            = succeed "." do
              %math#mathml_a0136b00a59018dc879e6912a866dd696f262538_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
