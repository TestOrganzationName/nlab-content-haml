              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              (2-paths)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in the path space type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %mi d
                    %annotation{:encoding => "application/x-tex"} c = d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} e = f
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          #GroupoidDependentlyTypes.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (groupoid –
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependently typed
                definition)
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed ";" do
                    %em
                      set of
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for all
                  %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                  of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi X
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (x,y) \in X \times X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Hom
                          %mo{:stretchy => "false"} (
                          %mi x
