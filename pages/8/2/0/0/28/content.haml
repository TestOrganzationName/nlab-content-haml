                      and
                      %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
                      or
                      %a.existingWikiWord{:href => "/nlab/show/target"} target
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi y
                          %annotation{:encoding => "application/x-tex"} y
              %li
                %p
                  for all
                  %a.existingWikiWord{:href => "/nlab/show/triples"} triples
                  of objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi X
                        %mo ×
                        %mi X
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (x,y,z) \in X \times X \times X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∘
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                            %mo ,
                            %mi z
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\circ_{x,y,z} \;\colon\; Hom(y,z) \times Hom(x,y) \longrightarrow Hom(x,z)
                %p
                  to be called
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              %li
                %p
                  for all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  an element
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mi x
                        %mo ∈
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        id_x \in Hom(x,x)
                %p
                  to be called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
              %li
                %p
                  for all pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mi X
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} (x,y) \in X \times X
                  of objects a function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
