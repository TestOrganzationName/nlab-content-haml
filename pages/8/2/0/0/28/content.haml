                              %mi g
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} t(g h)=t(g)
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
                      \:
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mi h
                              %mo{:stretchy => "false"} )
