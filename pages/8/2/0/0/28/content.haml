                        %msub
                          %mi G
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} g\in G_1
                  is denoted by
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
