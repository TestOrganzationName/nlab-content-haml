          #GroupoidRepresentationsAreProductsOfGroupRepresentations.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoid+representations"} groupoid representations
                are
                %a.existingWikiWord{:href => "/nlab/show/product+category"} products
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/group+representations"} group representations
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              then the following holds:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/category+of+representations"} category of
              %a.existingWikiWord{:href => "/nlab/show/groupoid+representations"} groupoid representations
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to the
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              indexed by the set of
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(\mathcal{G})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidConnectedComponents"}
              %a.existingWikiWord{:href => "/nlab/show/group+representations"} group representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi i
                    %mo ≔
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_i \coloneqq Aut_{\mathcal{G}}(x_i)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InGrupoidAutomorphismGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              any object in the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Rep(\mathcal{G})
                    \\;\simeq\;
                    \\underset{i \in \pi_0(\mathcal{G})}{\prod} Rep(G_i)
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be the category that the representation is on. Then by definition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Rep(\mathcal{G}) = Hom( \mathcal{G} , \mathcal{C}  )
                    \\,.
            %p
              Consider the injection functor of the
              %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
              (from lemma
              = succeed ")" do
                %a.maruku-ref{:href => "#DeloopingGroupoidEquivalence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inc
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                    %mi B
                    %msub
                      %mi G
                      %mi i
                    %mover
                      %mo ⟶
                      %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    inc
                    \\;\colon\;
                    \\underset{i \in \pi_0(\mathcal{G})}{\sqcup} B G_i
                    \\overset{}{\longrightarrow}
                    \\mathcal{G}
                    \\,.
            %p
              By lemma
              %a.maruku-ref{:href => "#HmotopiesWithMorphismsHorizontaComposition"}
              the pre-composition with this constitutes a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi inc
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                    %mi B
                    %msub
                      %mi G
                      %mi i
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    inc^\ast \;\colon\; Hom( \mathcal{G}, \mathcal{C} ) \longrightarrow Hom( \underset{i \in \pi_0(\mathcal{G})}{\sqcup} B G_i, \mathcal{C} )
            %p
              and by combining lemma
              %a.maruku-ref{:href => "#DeloopingGroupoidEquivalence"}
              with lemma
              %a.maruku-ref{:href => "#HorizontalCompositionWithHomotopyIsNaturalTransformation"}
              this is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              %a.maruku-ref{:href => "#GroupoidRepresentationOfDeloopingGroupoid"}
              the category on the right is the product of group representation categories as claimed.
          %p
          %h3#section_As_2-coskeletal_Kan_complexes As 2-coskeletal Kan complexes
          %p
            Groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            are equivalent to 1-
            %a.existingWikiWord{:href => "/nlab/show/hypergroupoids"}> hypergroupoids
            , which are in particular 2-
            %a.existingWikiWord{:href => "/nlab/show/coskeletal"} coskeletal
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(K)
            – their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
          %p
            The objects of the groupoids are the 0-
            %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
            and the morphisms of the groupoid are the 1-simplices of the Kan complex. The
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} (f,g) \mapsto g \circ f
            in the grouopoid is encoded in the 2-simplices of the Kan complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi y
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
