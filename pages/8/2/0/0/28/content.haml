                    \\\
                    x_i &amp;\underset{f_{x_i,z}}{\longrightarrow}&amp; z
                    }
                    \\,.
          #EquivalenceOfGroupoidsFromWeakHomotopyEquivalence.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{G}_1 \longrightarrow \mathcal{G}_2
              be a homomorphism of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              then the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#EquivalenceOfGroupoids"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  in that
                %ol
                  %li
                    %p
                      it induces an
                      %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                      of sets of
                      %a.existingWikiWord{:href => "/nlab/show/connected"} connected
                      components (def.
                      = succeed ");" do
                        %a.maruku-ref{:href => "#GroupoidConnectedComponents"}
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒢
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo ⟶
                              %mo ≃
                            %msub
                              %mi π
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi 𝒢
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                          %annotation{:encoding => "application/x-tex"}
                            \\pi_0(F) \;\colon\; \pi_0(\mathcal{G}_1) \overset{\simeq}{\longrightarrow} \pi_0(\mathcal{G}_0)
                            \\,,
              %li
                %p
                  for each object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi 𝒢
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} x \in \mathcal{G}_1
                  it induces an isomorphism of
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+groups"} automorphism groups
                  (def.
                  = succeed "):" do
                    %a.maruku-ref{:href => "#InGrupoidAutomorphismGroup"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi x
                            %mo ,
                            %mi x
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Aut
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %msub
                          %mi Aut
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        F_{x,x} \;\colon\; Aut_{\mathcal{G}_1}(x) \overset{\simeq}{\longrightarrow} Aut_{\mathcal{G}_2}(F_0(x))
                        \\,.
          .proof
            %h6#proof_7 Proof
            %p
              In one direction, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              has an inverse up to natural isomorphism, then this induces by definition a bijection on connected components, and it induces isomorphism on homotopy groups by lemma
              = succeed "." do
                %a.maruku-ref{:href => "#AutomorphismGroupDependsOnlyOnConnectedComponent"}
            %p
              In the other direction, choose equivalences to
              %a.existingWikiWord{:href => "/nlab/show/skeleta"} skeleta
              as in prop.
              %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
              to get a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in the
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              of groupoids as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 1
                          %mtd
                            %munderover
                              %mo ⟵
                              %mo ≃
                              %mrow
                                %msub
                                  %mi inc
                                  %mn 1
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %msub
                                  %mi π
                                  %mn 0
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi 𝒢
                                  %mn 1
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi Aut
                              %mrow
                                %msub
                                  %mi 𝒢
                                  %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi F
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi F
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                            %msub
                              %mi 𝒢
                              %mn 2
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi inc
                                  %mn 2
                              %mo ≃
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %msub
                                  %mi π
                                  %mn 0
                                %mo{:stretchy => "false"} (
