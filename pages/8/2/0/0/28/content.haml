                                    %msub
                                      %mi x
                                      %mi i
                                    %mo ,
                                    %mi z
                          %mtd
                            %mi z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x_i &amp;\overset{f_{x_i,y}}{\longrightarrow}&amp; y
                    \\\
