                          %mi h
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m(g,h)
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
