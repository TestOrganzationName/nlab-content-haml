              %a.existingWikiWord{:href => "/nlab/show/path+space+type"}> type
              )
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
