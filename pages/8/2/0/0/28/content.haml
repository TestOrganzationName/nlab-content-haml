                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mi h
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} s(g h)=s(h)
                      ,
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi t
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mi h
                              %mo{:stretchy => "false"} )
