                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{G}_1 &amp;\underoverset{\simeq}{inc_1}{\longleftarrow}&amp; \underset{i \in \pi_0(\mathcal{G}_1)}{\sqcup} Aut_{\mathcal{G}_1}(x_i)
                    \\\
                    {}^{\mathllap{F}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\tilde F }}
                    \\\
                    \\mathcal{G}_2 &amp;\underoverset{inc_2}{\simeq}{\longleftarrow}&amp; \underset{i \in \pi_0(\mathcal{G}_1)}{\sqcup} Aut_{\mathcal{G}_2}(F_0(x_i))
                    }
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi inc
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} inc_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi inc
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} inc_2
              are equivalences of groupoids by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is a weak homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde F
              is the union of of deloopings of isomorphisms of groups, and hence has a strict inverse, in particular a homotopy inverse, hence is in particular an euivalence of groupoids.
            %p
              In conclusion, when regarded as a diagram in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
