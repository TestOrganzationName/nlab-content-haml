                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} e(t(g))g=g=ge(s(g))
                      (in particular,
                      = succeed ")," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi s
                              %mo ∘
                              %mi e
                              %mo =
                              %mi t
                              %mo ∘
                              %mi e
                            %annotation{:encoding => "application/x-tex"} s\circ e= t \circ e
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/inverse"}> inverse
                      ,
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
