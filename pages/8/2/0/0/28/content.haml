                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \eta_1 \;\colon\; F \Rightarrow G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⇒
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \eta_2 \;\colon\; G \Rightarrow H
              conjugation actions/natural isomorphisms between these, there is the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mo ∘
                    %msub
                      %mi η
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_2 \circ \eta_1  \;\colon\; F \Rightarrow H
            %p with components the composite of the components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mn 2
                    %mo ∘
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\eta_2 \circ \eta_1)(x) \coloneqq \eta_2(x) \circ \eta_1(x)
                    \\,.
            %p
              This yields for any two groupoid a
              %em
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Grpd}(\mathcal{G}_1, \mathcal{G}_2)
            %p whose objects are the groupoid homomorphisms / functors, and whose morphisms are the conjugation actions / natural transformations.
          .num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                are special cases of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/dagger+categories"} dagger categories
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small groupoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidDependentlyTypes"}
              %span.newWikiWord
                small dagger category
                %a{:href => "/nlab/new/small+dagger+category"} ?
              in which all
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unitary+morphism"} unitary
          .num_remark
            %h6#remark_2 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                are special cases of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small groupoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidDependentlyTypes"}
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              in which all
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphisms
          .num_remark
            %h6#remark_3 Remark
            %p
              %strong (Higher groupoid theory vs higher category theory)
              Due to the two preceding remarks, groupoid theory may be regarded as a special case of
              %span.newWikiWord
                dagger category theory
                %a{:href => "/nlab/new/dagger+category+theory"} ?
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              %a.existingWikiWord{:href => "/nlab/show/higher+groupoid"} higher groupoid
              theory is
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              which is rich but quite tractable, for instance via tools such as
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
              and higher dagger category theory is intricate and becomes tractable mostly by making recourse to higher groupoid theory in the guise of
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+theory"} (infinity,1)-category theory
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-categories"} (infinity,n)-categories
          #GroupoidGlobalDefinition.num_defn
            %h6#definition_3 Definition
            %p
              %strong (groupoid – global definition)
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} G_0
                  called its
                  = succeed ";" do
                    %em
                      set of
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} G_1
                  called its
                  %em
                    set of
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  or
                  %em set of arrows
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                  of
                  %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
