            itself a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
          %p
            This generalizes the
            %a.existingWikiWord{:href => "/nlab/show/hom-tensor+adjunction"} hom-tensor adjunction
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebraic+theory#ClosedMonoidalStructureOnAlgebras"} closed monoidal structure on algebras over a commutative algebraic theory
