          %h2#idea Idea
          %p
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} Algebras
            over a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative monad
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            analogous to the traditional
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
            over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
          %p
            This tensor product satisfies a universal property analogous to the one of the tensor product of modules, namely it
            %a.existingWikiWord{:href => "/nlab/show/representable+multicategory"} represents
            %a.existingWikiWord{:href => "/nlab/show/multimorphisms"} multimorphisms
            in the same way in which the tensor product of modules represents
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+maps"} bilinear maps
          %h2#construction_of_the_tensor_product Construction of the tensor product
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,\mu,\eta)
            be a commutative monad on a symmetric monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\otimes,1)
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal multiplication
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p
            Given
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              \-algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,a)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,b)
            %strong tensor product
            is, if it exists, the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⊗
                    %mi T
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\otimes_T B
            given by the coequalizer in the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
