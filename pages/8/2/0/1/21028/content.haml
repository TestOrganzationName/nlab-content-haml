          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
            %strong has tensors
            if such equalizers exist for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,a)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi T
                %annotation{:encoding => "application/x-tex"} \otimes_T
            is a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                    %mo ×
                    %msup
                      %mi C
                      %mi T
                    %mo →
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T\times C^T\to C^T
          #sealthms.num_theorem
            %h6#theorem Theorem
            %p
              (
              %a{:href => "#Seal12"}> Seal ‘12, Corollary 2.5.6 and Theorem 2.6.4
              ) Suppose that either:
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} C^T
                has tensors, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊗
                        %mi T
                    %annotation{:encoding => "application/x-tex"} \otimes_T
                preserves
                %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizers"} reflexive coequalizers
                in both variables separately (
                %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer#properties"}> hence jointly
                );
            %p or that
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizers"} reflexive coequalizers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⊗
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(-\otimes -)
                preserves them in both variables separately (
                %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer#properties"}> hence jointly
                ).
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \otimes_T
              makes the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
                given by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} T1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                is the unit object of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              %li
                %a.existingWikiWord{:href => "/nlab/show/unitors"} unitors
                and
                %a.existingWikiWord{:href => "/nlab/show/associators"} associators
                induced by those of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊗
                      %annotation{:encoding => "application/x-tex"} \otimes
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \otimes_T
              is symmetric too, with
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              induced by the one of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
          %h2#bimorphisms_and_universal_property Bimorphisms and universal property
          %p
            %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} Commutative monads
            admit a notion of
            %a.existingWikiWord{:href => "/nlab/show/multimorphism"} multimorphism
            of algebras analogous to the notion of
            %a.existingWikiWord{:href => "/nlab/show/bilinear"} bilinear
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multilinear map
          %p
            %strong Caveat.
            Some authors call the analogue of a bilinear map a
            = succeed "." do
              %em bimorphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/binary+morphism"} binary morphism
          %p
            Let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,b)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R,r)
            be
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %strong binary morphism
            of algebras, or
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                \-balanced map
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              \-bilinear
            (or
            = succeed "," do
              %strong bimorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} f:A\otimes B\to R
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
