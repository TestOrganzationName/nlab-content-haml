                              %mfrac
                                %mn 1
                                %mn 2
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mo −
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi y
                              %mo −
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi δ
                              %mrow
                                %mi d
