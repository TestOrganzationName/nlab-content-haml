          %h3#OnASymplecticManifold On a symplectic manifold
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            be a (
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"}> pre
            \-)
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"}> symplectic manifold
            , thought of as the
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} physical system
          %p
            Assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is prequantizable (integral) and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo :
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \nabla : X \to \mathbf{B} U(1)_{conn}
            be a
            %a.existingWikiWord{:href => "/nlab/show/prequantum+bundle"} prequantum bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} F_\nabla = \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_X(E)
            for the space of smooth
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            of the
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            = succeed "." do
              %em prequantum space of states
          .num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(X, \mathbb{C})
              a function on phase space, the corresponding
              %strong pre-quantum operator
              is the linear map on prequantum states
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f : \Gamma_X(E) \to \Gamma_X(E)
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo ↦
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi i
                    %msub
                      %mo ∇
                      %mrow
                        %msub
                          %mi v
                          %mi f
                    %mi ψ
                    %mo +
                    %mi f
                    %mo ⋅
                    %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\psi \mapsto -i \nabla_{v_f} \psi + f \cdot \psi
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi f
                      %annotation{:encoding => "application/x-tex"} v_f
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
                  corresponding to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %msub
                              %mi v
                              %mi f
                        %mo :
                        %msub
                          %mi Γ
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Γ
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \nabla_{v_f} : \Gamma_X(E) \to \Gamma_X(E)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                  of sections along
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mi f
                      %annotation{:encoding => "application/x-tex"} v_f
                  for the given choice of prequantum connection;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi Γ
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Γ
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \cdot (-) : \Gamma_X(E) \to \Gamma_X(E)
                  is the operation of degreewise multiplication pf sections.
          .num_remark
            %h6#remark Remark
            %p
              In terms of
              %a.existingWikiWord{:href => "/schreiber/show/Higher+geometric+prequantum+theory"} Higher geometric prequantum theory
              we may, as discussed there, identify the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰𝔰𝔬𝔫
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{Poisson}(X,\omega)
              with the Lie algebra of the group of automorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ∇
                    %mover
                      %mo →
                      %mo ≃
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \exp(O) \colon \nabla \stackrel{\simeq}{\to} \nabla
              regarded in the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)_{conn}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ∇
                    %mo →
                    %mi ℂ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \Psi \colon \nabla \to \mathbb{C}//U(1)_{conn}
              in the slice from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              into the differential refinement of the smooth universal line bundle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}//U(1) \to \mathbf{B}U(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi O
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mover
                      %mo →
                      %mi Ψ
                    %mi ℂ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mover
                      %mo →
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi O
                        %mo{:stretchy => "false"} )
                    %mo ∇
                    %mover
                      %mo →
                      %mi Ψ
                    %mi ℂ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\exp(O)} \colon (\nabla \stackrel{\Psi}{\to} \mathbb{C}//U(1)_{conn})
                    \\mapsto
                    (\nabla \stackrel{exp(O)}{\to} \nabla \stackrel{\Psi}{\to} \mathbb{C}//U(1)_{conn})
                    \\,.
          %p
            Now after a choice of
            %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
            a
            %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
            is a prequantum
            %a.existingWikiWord{:href => "/nlab/show/wave+function"} wave function
            which is covariantly constant along the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifolds"} Lagrangian submanifolds
            of the foliation. Not all prequantum operators will respect the space of such quantum states inside all quantum states. Those that do become genuine quantum operators.
          #GeometricQuantumOperator.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              be a
              %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
              of the
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
              or
              %a.existingWikiWord{:href => "/nlab/show/wavefunction"} wavefunction
              is a prequantum state
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \nabla \Psi
              vanishes along the
              %a.existingWikiWord{:href => "/nlab/show/leaves"} leaves
              of the polarization.
            %p
              A
              %strong quantum operator
              is a prequantum operator which preserves quantum states among all prequantum states.
          #CompatibiltyOfFlowWithPolarization.num_prop
            %h6#proposition Proposition
            %p
              A prequantum operator given by a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi f
                  %annotation{:encoding => "application/x-tex"} v_f
              is a quantum operator, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeometricQuantumOperator"}
              %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              precisely if its flow preserves
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mi f
                    %mo ,
                    %mi 𝒫
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi 𝒫
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [v_f, \mathcal{P}] \subset \mathcal{P}
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              is a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
              then its underlying
              %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
              it induces a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \colon G \to QuantMorph(X,\nabla)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
              (a homomorphism to the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho(g)
              is a quantum operator in that it preserves the polarization, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CompatibiltyOfFlowWithPolarization"}
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
              is
              = succeed "-invariant." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/index"} index
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+Dirac+operator"} spin^c Dirac operator
              which gives the
              %a{:href => "http://ncatlab.org/nlab/show/geometric%20quantization#AsIndexOfSpinCDiracOperator"} geometric quantization by cohomological quantization
              exists not just in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on the Hilbert space. This is the action of the quantum observables given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              from the point of view of cohomological quantization.
          .num_example
            %h6#example Example
            %p
              Over a phase space which is a
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              and with respect to the corresponding canonical vertical polarization, a Hamiltonian function is a quantum operator precisely if it is at most linear in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
          %p
            See for instance
            %a{:href => "#Blau"} Blau, around p. 35
          %h3#on_an_plectic_smooth_groupoid
            On an
            = succeed "-plectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p (…)
          %h3#irreducible_representations_and_superselection_sectors Irreducible representations and superselection sectors
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
            forms a linear
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+observables"} algebra of observables
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            is physically the decomposition into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/superselection+sectors"} superselection sectors
          %h2#ViaPathIntegral Via time-ordered products
          %div
            %h3#QuantumCommutatorsAreTimeOrderedOrdinaryProducts Quantum commutators are time-ordered ordinary products of observables
            %p#RelationToOperatorProductAndTimeOrder
              The
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              formulation (and generally the notion of
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              satisfying the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+physics"} quantum physics
            %p As slogans, in slightly increasing order of accuracy:
            .un_remark{:style => "border:solid #0000cc;background: #cbe6ef;border-width:1pt;padding:4pt 25pt;margin:5pt 10pt;border-radius:10pt;"}
              %p
                %strong Slogan:
                The
                %a.existingWikiWord{:href => "/nlab/show/quantum+observable"} quantum
                (
                %a.existingWikiWord{:href => "/nlab/show/linear+operator"}> operator
                ) product of
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                is their ordinary product after slightly shifting their
                %a.existingWikiWord{:href => "/nlab/show/time"} time
                domains into operator order.
            %p Or more technically:
            .un_remark{:style => "border:solid #0000cc;background: #cbe6ef;border-width:1pt;padding:4pt 25pt;margin:5pt 10pt;border-radius:10pt;"}
              %p
                %strong Slogan:
                The operator product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ⋆
                      %msub
                        %mi O
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O_2(t) \star O_1(t)
                of observables at equal time
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
                is their ordinary product after slightly shifting the observation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} O_2
                to after
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi O
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} O_1
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %munder
                            %mo ⟶
                            %mrow
                              %mi ϵ
                              %msub
                                %mo →
                                %mo +
                              %mn 0
                        %msub
                          %mi O
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo +
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi O
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \underset{\underset{\epsilon \to_+ 0}{\longrightarrow}}{\lim} O_2(t + \epsilon)  O_1(t)
            %p Or rather:
            .un_remark{:style => "border:solid #0000cc;background: #cbe6ef;border-width:1pt;padding:4pt 25pt;margin:5pt 10pt;border-radius:10pt;"}
              %p
                %strong Slogan:
                The non-commutativity of quantum observables (such as witnessed by the
                %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relation"} canonical
                %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
                between
                %a.existingWikiWord{:href => "/nlab/show/field+observables"} field observables
                and their
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"} canonical momenta
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %munder
                            %mo ⟶
                            %mrow
                              %mi ϵ
                              %msub
                                %mo →
                                %mo +
                              %mn 0
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi O
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo +
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi O
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msub
                          %mi O
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo +
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi O
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} \underset{\underset{\epsilon \to_+ 0}{\longrightarrow}}{\lim} \big( O_2(t + \epsilon)  O_1(t)  - O_1(t + \epsilon)  O_2(t)\big)
            %p
              Here these (limits of) ordinary products of ordinary observables (on
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              with respect to some (arbitrary) state. We proceed to say this in more technical detail.
            %p
              This insight goes back to
              = succeed "," do
                %a{:href => "path+integral#Feynman48"} Feynman 1948 p. 381
              %a.existingWikiWord{:href => "/nlab/show/non-relativistic+particle"} non-relativistic
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            %ul
              %li
                %em
                  %a{:href => "#CCRFromPathIntegralInQM"} In Quantum Mechanics
            %p
              But this generalizes to
              %a.existingWikiWord{:href => "/nlab/show/relativistic+quantum+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            %ul
              %li
                %em>
                  %a{:href => "#CCRFromPathIntegralInQFT"} In Quantum Field Theory
                \.
            %p
              In fact, the analogous statement remains true also in
              %a.existingWikiWord{:href => "/nlab/show/light-front+quantization"} light-front quantization
              (cf. Rem.
              %a.maruku-ref{:href => "#SDCCRDerivationInLightFrontForm"}
              below), where it says that the canonical commutators are given by ordinary products of observables after shifting their
              %em light-front-parameter
              domain into operator order.
            %h4#CCRFromPathIntegralInQM In Quantum Mechanics
            %p
              The following is the original observation of
              = succeed "." do
                %a{:href => "path+integral#Feynman48"} Feynman 1948, p. 381
            %p
              (This has been recalled by
              = succeed ";" do
                %a{:href => "path+integral#FeynmanHibbsStyer2010"} Feynman, Hibbs &amp; Styer 2010 (7.45)
              = succeed ";" do
                %a{:href => "path+integral#Shulman1981"} Schulman 1981, Ch. 8
              = succeed ";" do
                %a{:href => "path+integral#Nagaosa99"} Nagaosa 1999, pp. 33
              = succeed ";" do
                %a{:href => "path+integral#Ong2012"} Ong 2012
              = succeed "," do
                %a{:href => "path+integral#Rischke21\n"} Rischke 2021 Section 5.6
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              in the argument nor comments on generalization beyond the 1d discretized nonrelativistic path integral that Feynman considered and which we recall now.)
            %p
              %br/
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              for a
              %a.existingWikiWord{:href => "/nlab/show/particle"} particle
              propagating on a
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              over positions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi t
                  %annotation{:encoding => "application/x-tex"} x_t
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              discrete time steps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi N
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} t \in \mathbf{N} \coloneqq \{0, 1, \cdots, N-1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                    %mpadded{:width => "0"}
                      %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x \colon \mathbf{N} \longrightarrow S^1
                    \\mathrlap\,.
            %p
              To recall that the
              %a.existingWikiWord{:href => "/nlab/show/quantum+probability+theory"} quantum expectation value
              of an
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} O \colon (S^1) ^{\mathbf{N}} \longrightarrow \mathbb{C}
              with respect to a
              %a.existingWikiWord{:href => "/nlab/show/pure+quantum+state"} pure quantum state
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mn 1
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \psi \colon S^1 \longrightarrow \mathbb{C}
              is expressed as the following (discretized) path integral:
            #eq:ExpectationValuesForParticleOnS1ViaDiscretized.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi O
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mi 𝒩
                    %mo ∫
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi exp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi{:mathvariant => "normal"} i
                        %mi ℏ
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ψ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi D
                    %mi x
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big\langle
                    O
                    \\big\rangle
                    \\;\coloneqq\;
                    \\tfrac{1}{\mathcal{N}}
                    \\int
                    O(x)
                    \\,
                    \\exp\big(\tfrac{\mathrm{i}}{\hbar} S(x)\big)
                    \\,
                    \\psi^\ast(x_N)
                    \\psi(x_0)
                    \\,
                    D x
                    \\mathrlap{\,,}
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒩
                    %mo ≔
                    %mo ∫
                    %mi exp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi{:mathvariant => "normal"} i
                        %mi ℏ
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ψ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi N
                    %mo{:stretchy => "false"} )
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi D
                    %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{N}
                    \\coloneqq
                    \\int
                    \\exp\big(\tfrac{\mathrm{i}}{\hbar} S(x)\big)
                    \\,
                    \\psi^\ast(x_N)
                    \\psi(x_0)
                    \\,
                    D x
            %p
              is the normalization factor (the “
              %a.existingWikiWord{:href => "/nlab/show/partition+function"}> partition function
              ”), and where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi D
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi ⋯
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi{:mathvariant => "normal"} d
                    %msub
                      %mi x
                      %mn 0
                    %mi ⋯
                    %mi{:mathvariant => "normal"} d
                    %msub
                      %mi x
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi N
                        %mo −
                        %mn 1
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int D x
                    \\,\coloneqq\,
                    \\int_{S^1} \cdots \int_{S^1}
                    \\mathrm{d}x_0 \cdots \mathrm{d}x_{\mathbf{N}-1}
                    \\mathrlap{\,.}
            %p
              With that simple setup, ordinary
              %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              gives for an observable which is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi F
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                    %mn 1
                    %mo &lt;
                    %mi t
                    %mo &lt;
                    %mi N
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    O(x)
                    \\,=\,
                    \\tfrac{\partial F}{\partial x_t} (x)
                    \\,,
                    \\phantom{--}
                    1 \lt t \lt N
                    \\mathrlap{\,,}
            %p
              that its
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
              is equivalently expressed as:
            #eq:PartialIntegrationInDiscretizedPathIntegral.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                            %mi O
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                          %mtd
                            %mo ≡
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi F
                                %mrow
                                  %mo ∂
                                  %msub
                                    %mi x
                                    %mi t
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mtr
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mi{:mathvariant => "normal"} i
                                %mi ℏ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                            %mi F
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mrow
                                  %mo ∂
                                  %mi S
                                %mrow
                                  %mo ∂
                                  %msub
                                    %mi x
                                    %mi t
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big\langle
                    O
                    \\big\rangle
                    \&amp; \equiv
                    \\big\langle
                    \\tfrac{\partial F}{\partial x_t}
                    \\big\rangle
                    \\\
                    \&amp;
                    \-\tfrac{\mathrm{i}}{\hbar}
                    \\big\langle
                    F
                    \\tfrac{\partial S}{\partial x_t}
                    \\big\rangle
                    \\end{aligned}
            %p
              (which we may recognize as the 1d discretized form of what is now called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              in
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              more generally).
            %p
              Specializing this to the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/non-relativistic+particle"} non-relativistic particle
              of
              %a.existingWikiWord{:href => "/nlab/show/mass"} mass
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} m \gt 0
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi t
                        %mo &lt;
                        %mi N
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi m
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi t
                        %mo +
                        %mn 1
                    %mo −
                    %msub
                      %mi x
                      %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mi N
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    S(x)
                    \\,=\,
                    \\sum_{1 \leq t \lt N}
                    \\tfrac{m}{2}
                    (
                    x_{t+1}
                    \-
                    x_{t}
                    )^2
                    \\tfrac{1}{N}
                    \\mathrlap{\,,}
            %p the key point to observe is that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi S
                        %mrow
                          %mo ∂
                          %msub
                            %mi x
                            %mi t
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi m
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi t
                          %mo −
                          %msub
                            %mi x
                            %mrow
                              %mi t
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                    %mo −
                    %mi m
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mrow
                              %mi t
                              %mo +
                              %mn 1
                          %mo −
                          %msub
                            %mi t
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{\partial S}{\partial x_t}
                    \\,=\,
                    m
                    \\tfrac{
                    (x_{t} - x_{t-1})
                    }{1/N}
                    \-
                    m
                    \\tfrac{
                    (x_{t+1} - t_n)
                    }{1/N}
                    \\mathrlap{\,.}
            %p
              Using this when entering equation
              %a.maruku-eqref{:href => "#eq:PartialIntegrationInDiscretizedPathIntegral"} (2)
              with the choice
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ≔
                    %msub
                      %mi x
                      %mi t
                  %annotation{:encoding => "application/x-tex"}
                    F
                    \\coloneqq
                    x_t
            %p gives:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mo =
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %msub
                      %mi x
                      %mi t
                    %mspace{:width => "thinmathspace"}
                    %mi m
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi t
                          %mo −
                          %msub
                            %mi x
                            %mrow
                              %mi t
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mo −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi m
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mrow
                              %mi t
                              %mo +
                              %mn 1
                          %mo −
                          %msub
                            %mi x
                            %mi t
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi x
                      %mi t
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{i}\hbar
                    \=
                    \\big\langle
                    x_t
                    \\,
                    m
                    \\tfrac{
                    (x_{t} - x_{t-1})
                    }{1/N}
                    \\big\rangle
                    \-
                    \\big\langle
                    m
                    \\tfrac{
                    (x_{t+1} - x_{t})
                    }{1/N}
                    \\,
                    x_t
                    \\big\rangle
                    \\mathrlap{\,.}
            %p Here we recognize
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi t
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mo ≔
                    %mi m
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mrow
                              %mi t
                              %mo +
                              %mn 1
                          %mo −
                          %msub
                            %mi x
                            %mi t
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                  %annotation{:encoding => "application/x-tex"}
                    p_{t+1/2}
                    \\coloneqq
                    m
                    \\tfrac{
                    (x_{t+1} - x_{t})
                    }
                    {1/N}
            %p
              as the discrete approximation to the
              %a.existingWikiWord{:href => "/nlab/show/momentum"} momentum
              observable at time
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} t + 1/2
            #eq:FeynmanCCRViaTimeShiftedProduct.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} i
                            %mi ℏ
                          %mtd
                            %mo =
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                            %msub
                              %mi x
                              %mi t
                            %mo ⋅
                            %msub
                              %mi p
                              %mrow
                                %mi t
                                %mo −
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo −
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi p
                              %mrow
                                %mi t
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mo ⋅
                            %msub
                              %mi x
                              %mi t
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathrm{i}\hbar
                    \&amp; =
                    \\big\langle
                    x_t
                    \\cdot
                    p_{t - 1/2}
                    \\,-\,
                    p_{t + 1/2}
                    \\cdot
                    x_t
                    \\big\rangle
                    \\,.
                    \\end{aligned}
            %p In the time continuum limit, this becomes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %msub
                      %mi x
                      %mi t
                    %mo ⋅
                    %msub
                      %mi p
                      %mrow
                        %mi t
                        %mo −
                        %mi ϵ
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi p
                      %mrow
                        %mi t
                        %mo +
                        %mi ϵ
                    %mo ⋅
                    %msub
                      %mi x
                      %mi t
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{i}\hbar
                    \\,=\,
                    \\big\langle
                    x_t
                    \\cdot
                    p_{t - \epsilon}
                    \\,-\,
                    p_{t + \epsilon}
                    \\cdot
                    x_t
                    \\big\rangle
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon \to 0
            %p
              But this is clearly the path integral expression for what in operator formalism is the
              %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relation"} canonical commutation relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mo =
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mo ⋅
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ^
                    %mo −
                    %mover
                      %mi p
                      %mo{:stretchy => "false"} ^
                    %mo ⋅
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{i}\hbar
                    \=
                    \\hat x \cdot \hat p - \hat p \cdot \hat x
                    \\,.
            %p
              In conclusion, the observable corresponding to a quantum operator product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \cdot A
              of observables at times
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              may be thought of as the result of first shifting the temporal supports of the observables so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is observation at a time just a little
              %em after
              that of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              As Feynman 1948 also noticed, the same conclusion holds with an ordinary
              %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
              term included in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon\to 0
              limit.
            %h4#CCRFromPathIntegralInQFT In Quantum Field Theory
            %p
              In fact, by using the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              = succeed ")" do
                %a{:href => "https://physics.stackexchange.com/a/685812/5603"} physics.SE:685812
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
              of a
              %a.existingWikiWord{:href => "/nlab/show/nonrelativistic+particle"} nonrelativistic particle
              to general
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theories"} quantum field theories
              with ordinary
              %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
              terms, as follows.
            %blockquote
              %p
                (Conversely, the product of
                = succeed "-values" do
                  %a.existingWikiWord{:href => "/nlab/show/observable"} observable
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
                of the corresponding
                %a.existingWikiWord{:href => "/nlab/show/linear+operators"} linear operators
                (eg.
                = succeed ";" do
                  %a{:href => "path+integral#Polchinski98"} Polchinski 1998 (A.1.17)
                = succeed ".)" do
                  %a{:href => "path+integral#Rischke21"} Rischke 2021 (5.63)
            %p
              Imagine a
              = succeed "-formulation" do
                %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo +
                      %mi d
                    %annotation{:encoding => "application/x-tex"} 1+d
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              determined by a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              with an ordinary
              %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
              term and denote the corresponding
              %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
              in some state by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-\rangle
              — or else regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle-\rangle
              as denoting the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              of its arguments, that’s all we need.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              be one of the
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
              species. (It could be a
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              but it may just as well be a component of any more complex field.)
            %p
              Assuming we are on cylindrical
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 1
                        %mo ,
                        %mi d
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ℤ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1,d} / \mathbb{Z}^{d}
              — just for notational simplicity — then the
              %a.existingWikiWord{:href => "/nlab/show/Schwinger-Dyson+equation"} Schwinger-Dyson equation
              for field insertion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi(y)
              says that
            #eq:SchwingerDysonForComputingCCRs.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} ⟨
                    %munder
                      %munder
                        %mrow
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mfrac
                            %mrow
                              %mo ∂
                              %mi L
                            %mrow
                              %mo ∂
                              %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mo ∂
                            %mi μ
                          %mfrac
                            %mrow
                              %mo ∂
                              %mi L
                            %mrow
                              %mo ∂
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi μ
                              %mi ϕ
                              %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mo ⏟
                      %mrow
                        %mi δ
                        %mi S
                        %mo{:stretchy => "false"} /
                        %mi δ
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "2.4em", :minsize => "2.4em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mrow
                      %mo ⟨
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo ∂
                          %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi δ
                      %mrow
                        %mn 1
                        %mo +
                        %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo −
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bigg\langle
                    \\underset
                    {
                    \\delta S / \delta \phi(x)
                    }{
                    \\underbrace{
                    \\Big(
                    \\frac{ \partial L }{ \partial \phi }
                    (x)
                    \-
                    \\partial_\mu
                    \\frac{ \partial L }{ \partial (\partial_\mu \phi) }
                    \\Big)
                    }
                    }
                    \\,
                    \\phi(y)
                    \\bigg\rangle
                    \\;=\;
                    \\mathrm{i}\hbar
                    \\left\langle
                    \\frac{ \partial \phi(y) }{ \partial \phi}(x)
                    \\right\rangle
                    \\;=\;
                    \\mathrm{i}\hbar
                    \\,
                    \\delta^{1+d}(x-y)
                    \\mathrlap{\,.}
            %blockquote
              %p
                This is the field theoretic version of Feynman’s
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:PartialIntegrationInDiscretizedPathIntegral"} (2)
            %p
              Now consider the
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              of this expression in the variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              over the spacetime region in a small time interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi d
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ℤ
                      %mi d
                  %annotation{:encoding => "application/x-tex"} (y^0- \epsilon, y^0 + \epsilon) \times \mathbb{R}^{d}/\mathbb{Z}^{d}
              and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon \to 0
            %ol
              %li
                %p
                  the first summand on the left of
                  %a.maruku-eqref{:href => "#eq:SchwingerDysonForComputingCCRs"} (4)
                  vanishes (being asymptotically proportional to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  since we are assuming that the potential term and hence the
                  = succeed "-dependence" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                        %annotation{:encoding => "application/x-tex"} \phi
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  is that of an ordinary smooth function),
              %li
                %p
                  by
                  %a.existingWikiWord{:href => "/nlab/show/Stokes%27s+theorem"} Stokes's theorem
                  the spatial integral over the spatial components of the second summand vanishes and
              %li
                %p
                  the remaining temporal integral of its temporal component gives two boundary terms (where we now decompose
                  = succeed "):" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mn 0
                          %mo ,
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} x = (x^0, \vec x)
            #eq:IntegratedSchwingerDysonForComputingCCRs.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi ℤ
                          %mi d
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mo ⟨
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi L
                        %mrow
                          %mo ∂
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mn 0
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo +
                      %mi ϵ
                      %mo ,
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi L
                        %mrow
                          %mo ∂
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mn 0
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo −
                      %mi ϵ
                      %mo ,
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi y
                        %mn 0
                      %mo ,
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\mathrm{d}^d \vec x
                    \\,
                    \\left\langle
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }
                    (y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }
                    (y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\right\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\mathrlap{\,.}
            %p
              Here we recognize the
              %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              to the field
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi L
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mn 0
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi(x)
                    \\;\coloneqq\;
                    \\frac{ \partial L }{ \partial (\partial_0 \phi) }(x)
                    \\mathrlap{\,,}
            %p so that
            #eq:IntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi ℤ
                          %mi d
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\mathrm{d}^d x
                    \\,
                    \\Big\langle
                    \\pi(y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\pi(y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\Big\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\mathrlap{\,.}
            %blockquote
              %p
                This is the field-theoretic version of Feynman’s
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:FeynmanCCRViaTimeShiftedProduct"} (3)
            %p
              We may redo this derivation after multiplication of the original Schwinger-Dyson equation
              %a.maruku-eqref{:href => "#eq:SchwingerDysonForComputingCCRs"} (4)
              with any “smearing function”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(\vec x)
              (a spatial
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/Stokes%27+theorem"} Stokes' theorem
              above we are now faced with an
              %a.existingWikiWord{:href => "/nlab/show/integration+by+parts"} integration by parts
              that picks up terms proportional to the
              %a.existingWikiWord{:href => "/nlab/show/gradient"} gradient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              — but if the dependence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              on spatial derivatives of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              does not have unusual singularities (i.e. if the
              %a.existingWikiWord{:href => "/nlab/show/kinetic+energy"} kinetic energy
              term in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a standard one) then these terms vanish with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              just as the
              %a.existingWikiWord{:href => "/nlab/show/potential+energy"} potential energy
              term does, and hence we end up with
            #eq:IntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi ℤ
                          %mi d
                    %mo ∫
                    %msup
                      %mi{:mathvariant => "normal"} d
                      %mi d
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mspace{:width => "thinmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\int_{\mathbb{R}^{d}/\mathbb{Z}^{d}}
                    \\int \mathrm{d}^d \vec x
                    \\,
                    f(\vec x)
                    \\,
                    \\Big\langle
                    \\pi(y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\pi(y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\Big\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar f(\vec y)
                    \\mathrlap{\,.}
            %p
              But since this holds for all smearing functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distributional
              equation
            #eq:UnIntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ϵ
                          %mo →
                          %mn 0
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo +
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi y
                      %mn 0
                    %mo ,
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi δ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo −
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\underset{\epsilon\to 0}{\longrightarrow}}{\lim}
                    \\Big\langle
                    \\pi(y^0 + \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\;-\;
                    \\pi(y^0 - \epsilon, \vec x)
                    \\,
                    \\phi(y^0, \vec y)
                    \\Big\rangle
                    \\;=\;
                    \-\mathrm{i}\hbar
                    \\,
                    \\delta^d(\vec x - \vec y)
                    \\mathrlap{\,,}
            %p
              which is the claimed incarnation of the
              %a.existingWikiWord{:href => "/nlab/show/canonical+commutation+relation"} canonical commutation relation
              of field operators at equal times,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mover
                      %mi π
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mover
                      %mi ϕ
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo −
                    %mi{:mathvariant => "normal"} i
                    %mi ℏ
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi δ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %mo −
                    %mover
                      %mi y
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    \\widehat{\pi}(\vec x), \widehat{\phi}(\vec x)
                    \\big]
                    \\,=\,
                    \-\mathrm{i}\hbar
                    \\,
                    \\delta^d(\vec x - \vec y)
                    \\mathrlap{\,,}
            %p now re-expressed as an expectation value of ordinary products of observables after shifting their temporal domains into operator order.
            %p
            #SDCCRDerivationInLightFrontForm.num_remark
              %h6 Remark
              %p
                The analogous conclusion holds also for
                = succeed "," do
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/light+front+quantization"} light front quantization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x^0
                now played by the light front parameter
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mo +
                      %annotation{:encoding => "application/x-tex"} x^+
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mo ±
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 0
                      %mo ±
                      %msup
                        %mi x
                        %mi d
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msqrt
                        %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      x^\pm \coloneqq (x^0 \pm x^d)/\sqrt{2}
                      \\,.
              %p
                Here the light-front
                %a.existingWikiWord{:href => "/nlab/show/canonical+momentum"} canonical momentum
                to a field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is (cf.
                %a{:href => "light+front+quantization#Burkardt96"} Burkardt 1996 table 2.1
                for the following equations):
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi L
                        %mrow
                          %mo ∂
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mo +
                          %mi ϕ
                          %mo{:stretchy => "false"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\pi
                      \\,=\,
                      \\frac
                      { \partial L }
                      { \partial (\partial_+ \phi) }
                      \\mathrlap{\,,}
              %p
                which for
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
                with standard
                %a.existingWikiWord{:href => "/nlab/show/kinetic+energy"} kinetic energy
                term
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∂
                        %mo +
                      %mi ϕ
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∂
                        %mo −
                      %mi ϕ
                      %mspace{:width => "thinmathspace"}
                      %mo −
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mover
                          %mo ∇
                          %mo{:stretchy => "false"} →
                        %mo ⊥
                      %mi ϕ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo −
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      L
                      \\,=\,
                      \\partial_+ \phi \, \partial_- \phi
                      \\,-\,
                      \\tfrac{1}{2} (\vec \nabla_\perp \phi)^2 - V(\phi)
              %p comes out as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ∂
                        %mo −
                      %mi ϕ
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\pi
                      \\,=\,
                      \\partial_- \phi
                      \\mathrlap{\,.}
              %p
                While the nature of this light front momentum in canonical quantization (where it is a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/second+class+constraint"} second class constraint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                      %mover
                        %mi π
                        %mo ^
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi x
                        %mo +
                      %mo ,
                      %msup
                        %mi x
                        %mo −
                      %mo ,
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mo ⊥
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi ϕ
                        %mo ^
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi x
                        %mo +
                      %mo ,
                      %msup
                        %mi y
                        %mo −
                      %mo ,
                      %msub
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} →
                        %mo ⊥
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mo −
                      %mi{:mathvariant => "normal"} i
                      %mi ℏ
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 2
                      %mi δ
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi x
                        %mo −
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mi y
                        %mo −
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %msup
                        %mi δ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} →
                        %mo ⊥
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mover
                          %mi y
                          %mo{:stretchy => "false"} →
                        %mo ⊥
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Big[
                      \\widehat{\pi}\big(x^+, x^-, \vec x_\perp\big)
                      ,\,
                      \\widehat{\phi}\big(x^+, y^-, \vec y_\perp\big)
                      \\Big]
                      \\,=\,
                      \-\mathrm{i}\hbar
                      \\tfrac{1}{2}
                      \\delta\big(x^- - y^-\big)
                      \\delta^{d-1}\big(\vec x_\perp - \vec y_\perp\big)
                      \\mathrlap{\,.}
              %p
                And so the above Schwinger-Dyson argument, just with the time coordinate
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x^0
                replaced by the light front parameter
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mo +
                      %annotation{:encoding => "application/x-tex"} x^+
              #eq:LightFrontUnIntegratedSchwingerDysonForComputingCCRsViaMomenta.maruku-equation
                %span.maruku-eq-number (9)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %munder
                              %mi lim
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi ϵ
                                  %mo →
