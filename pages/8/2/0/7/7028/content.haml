                            %mi ϵ
                            %mo ,
                            %msup
                              %mi x
                              %mo −
                            %mo ,
                            %msub
                              %mover
                                %mi x
                                %mo{:stretchy => "false"} →
                              %mo ⊥
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mi ϕ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi y
                              %mo +
                            %mo ,
                            %msup
                              %mi y
                              %mo −
                            %mo ,
                            %msub
                              %mover
                                %mi y
