                    %a.existingWikiWord{:href => "/nlab/show/sifted+%28infinity%2C1%29-category"} sifted (infinity,1)-category
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
                  of shape
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  exist in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CMon
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CMon(C)
                  and are computed in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  if
                  = succeed "-colimits" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  are preserved by tensor product with any object.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CMon
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CMon(C)
                  has all
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
          %p
            This is (
            %a{:href => "#LurieDAG3"}> Lurie DAG III, section 4
            ) or (
            %a{:href => "#LurieHA"}> Lurie HA, sections 3.2.2 and 3.2.3
            ).
          .num_theorem
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-Colimits over simplicial diagrams exists in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CMon(C)
              and are computed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              if they exist in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and a preserved by tensor products.
          %p
            Because the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            is a
            %a.existingWikiWord{:href => "/nlab/show/sifted+%28infinity%2C1%29-category"} sifted (infinity,1)-category
            (as discussed there).
          %h2#examples Examples
          %ul
            %li
              %p
                A commutative monoid in
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+space"} E-∞ space
            %li
              %p
                A commutative monoid in the
                %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category+of+spectra"} stable (infinity,1)-category of spectra
                is a
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectrum"} commutative ring spectrum
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
          %h2#related_concepts Related concepts
          %ul
            %li
