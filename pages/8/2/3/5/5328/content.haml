          %h2#idea Idea
          %p
            The notion of
            %em commutative monoid
            (or
            = succeed "," do
              %em commutative monoid object
            = succeed "," do
              %em commutative algebra
            = succeed ")" do
              %em commutative algebra object
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric monoidal (infinity,1)-category
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+theory"} (infinity,1)-categorical
            generalization of the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoid in a symmetric monoidal category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+%28infinity%2C1%29-category"} monoid in a monoidal (infinity,1)-category
          %p
            Note that
            %em commutative
            here really means
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+operad"} E-infinity operad
          %h2#definition Definition
          %p
            A
            %strong commutative monoid
            in a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric monoidal (infinity,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a lax symmetric monoidal
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
