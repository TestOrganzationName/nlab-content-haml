            %li#LurieHA
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p
            An equivalent reformulation of commutative monoids in terms
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-algebraic+theories"} (∞,1)-algebraic theories
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/James+Cranch"}> James Cranch
              ,
              %em
                Algebraic Theories and
