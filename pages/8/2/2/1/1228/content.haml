                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} V = Top^{\ast/}_{cg}
            (
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            %a{:href => "#EveryPresheafIsAColimitOfRepresentables"} every presheaf is a colimit of representables
