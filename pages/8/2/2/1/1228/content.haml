                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mover
                      %mo →
                      %mi g
                    %mi d
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c_0 \overset{f}{\to} c,\; x \in F(c) )
                    \\,,\;\;\;\;
                    ( c_0 \overset{g}{\to} d,\; y \in F(d) )
            %p are regarded as equivalent if there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %mi d
                  %annotation{:encoding => "application/x-tex"}
                    c \overset{\phi}{\to} d
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi ϕ
                    %mo ∘
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo =
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = \phi \circ f
                    \\,,
                    \\;\;\;\;\;and\;\;\;\;\;
                    x = \phi^\ast(y)
                    \\,.
            %p
              (Because then the two pairs are the two images of the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,y)
              under the two morphisms being coequalized.)
            %p
              But now considering the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} c = c_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} f = id_{c_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} g= \phi
              shows that any pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mover
                      %mo →
                      %mi ϕ
                    %mi d
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c_0 \overset{\phi}{\to} d, \; y \in F(d))
            %p is identified, in the coequalizer, with the pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (id_{c_0},\; \phi^\ast(y) \in F(c_0))
                    \\,,
            %p
              hence with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi^\ast(y)\in F(c_0)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(c_0,d)\times F(d)\longrightarrow F(c_0)
            %p of morphisms on elements of the presheaf by pullback.
          %h2#MacLanesCoYonedaLemma MacLane’s co-Yoneda lemma
          %p
            In a brief uncommented exercise on
            %a{:href => "#MacLane"} MacLane, p. 62
            the following statement, which is attributed to Kan, is called the
            = succeed "." do
              %strong co-Yoneda lemma
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo :
                  %mi D
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} K : D \to Set
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ↓
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (* \darr K)
            be the
            %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            of elements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi K
                    %mi d
                  %annotation{:encoding => "application/x-tex"} x \in K d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ↓
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \Pi: (* \darr K) \to D
            be the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∈
                  %mi K
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi d
                %annotation{:encoding => "application/x-tex"} (x \in K d) \mapsto d
            and let for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi D
                %annotation{:encoding => "application/x-tex"} a \in D
            the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ↓
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} \Delta_a: (* \darr K) \to D
            be the diagonal functor sending everything to the constant value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
            The
            %strong co-Yoneda lemma in the sense of Kan/MacLane
            is the statement that there is a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ↓
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Δ
                    %mi a
                  %mo ,
                  %mi Π
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [D,Set](K, D(a, -)) \cong [(*\darr K), D](\Delta_a, \Pi).
          %p Here is an outline of an explicit proof:
          .proof
            %h6#proof_2 Proof
            %p
              A natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi K
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi: K \to D(a, -)
              assigns to each element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi K
                    %mi c
                  %annotation{:encoding => "application/x-tex"} x \in K c
              an element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_c(x) \in D(a, c)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi a
                      %mo →
                      %mi c
                    %annotation{:encoding => "application/x-tex"} \phi_c(x): a \to c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \psi: \Delta_a \to \Pi
              which assigns to each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi x
                    %mo ∈
                    %mi K
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c, x \in K c)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ↓
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (*\darr K)
              the morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi a
                      %mo →
                      %mi c
                      %mo =
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi_c(x): a \to c = \Pi(c, x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              corresponds to the naturality condition on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
          %p
            Here is a more conceptual proof in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/comma+categories"} comma categories
          .proof
            %h6#proof_3 Proof
            %p
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              classifies discrete fibrations, in the sense that a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi D
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G : D \to Set
              classifies the discrete
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo :
                    %msub
                      %mi Π
                      %mi G
                    %mo :
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    Q : \Pi_G : El(G) \to D
            %p
              and natural transformations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi G
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \alpha : G \to F
              correspond to maps of fibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    El(G) \to El(F)
            %p
              i.e. functor which commute on the nose with the projections
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \Pi_G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Pi_F
              to the base category
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %p
              This applies in particular to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F = hom(a,-)
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} El(hom(a,-))
              is the co-slice
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} ↓
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (a \downarrow D)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %p
              However, the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} ↓
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a \downarrow D)
              is the “lax pullback” (really, the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} ↓
                            %mi D
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mi Π
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇑
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi Id
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    (a \downarrow D) &amp;\stackrel{\Pi}{\to}&amp; D
                    \\\
                    \\downarrow &amp;\Uparrow&amp; \downarrow^{Id}
                    \\\
                    * &amp;\stackrel{a}{\to}&amp; D
                    }
            %p
              and so a fibration map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi El
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} ↓
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} El(G) \to (a \downarrow D)
              corresponds exactly to a lax square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi El
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Π
                                  %mi G
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇑
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi Id
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo →
                              %mi a
                          %mtd
                            %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    El(G) &amp;\stackrel{\Pi_G}{\to}&amp; D
                    \\\
                    \\downarrow &amp;\Uparrow&amp; \downarrow^{Id}
                    \\\
                    * &amp;\stackrel{a}{\to}&amp; D
                    }
                    \\,.
            %p This yields the co-Yoneda lemma in the sense of MacLane’s exercise.
          %h2#references References
          %p
            For enrichment over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
