                    %mrow
                      %mo #
                    %annotation{:encoding => "application/x-tex"} \#
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y\in X
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∈
                      %mi V
                      %mo ∨
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ∈
                      %mi V
                      %mo ∨
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x\in V \vee x\#y) \iff (y\in V \vee x\#y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
              is symmetric, this is equivalent to the unidirectional implication
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ∈
                      %mi V
                      %mo ∨
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ∈
                      %mi V
                      %mo ∨
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x\in V \vee x\#y) \to (y\in V \vee x\#y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x\#y
              always implies itself, this is equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi V
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ∈
                      %mi V
                      %mo ∨
                      %mi x
                      %mo #
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in V \to (y\in V \vee x\#y)
          %p
            Recall that the negation of an apartness relation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an equivalence relation on the
            %em set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em itself
            the diagonal is to say that the discrete locale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
          %p
            Another characterization of the
            = succeed "-open" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is
            = succeed "-open" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi X
                    %mo ⊆
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %msub
                      %mi W
                      %mo #
                  %annotation{:encoding => "application/x-tex"} U\times X \subseteq (X\times U) \cup W_\#
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mo #
                %annotation{:encoding => "application/x-tex"} W_\#
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo #
                %annotation{:encoding => "application/x-tex"} \#
            regarded as a subset of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\times X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                %annotation{:encoding => "application/x-tex"} \mathsf{C}U
            is “closed under the equivalence relation” dual to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with its
            = succeed "-topology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            = succeed "-open" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo #
                  %annotation{:encoding => "application/x-tex"} \#
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the formal complements of arbitrary subsets of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            As a partial converse to the above theorem, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} localically strongly Hausdorff
            topological space, meaning that its diagonal is a strongly closed sublocale, then the pullback of this diagonal to the discrete locale on the set of points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a closed localic equivalence relation, hence an apartness, whose
            = succeed "-topology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "." do
              %a{:href => "/nlab/show/Hausdorff+space#Apartness"} this theorem
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "-topology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
          %h2#bhk_interpretatioin BHK interpretatioin
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/BHK+interpretation"} BHK interpretation
            of the apartness relation, where the
            %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            of the two propositions in the
            %a.existingWikiWord{:href => "/nlab/show/comparison"} comparison
            axiom is replaced with a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/sum+type"} sum type
          %p
            A binary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo #
                %annotation{:encoding => "application/x-tex"} \#
            is a
            %strong pure apartness relation
            if
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/irreflexive+relation"}> irreflexivity
              \: for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi S
                    %annotation{:encoding => "application/x-tex"} x: S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo #
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x \# x
              is false;
            %li
              %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"}> symmetry
              \: for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
