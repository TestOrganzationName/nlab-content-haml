          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#higher_groupoid_convolution_algebras_and_nvector_spacesnmodules"} Higher groupoid convolution algebras and n-vector spaces/n-modules
              %li
