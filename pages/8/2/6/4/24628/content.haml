                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "https://arxiv.org/abs/2002.10360"} arXiv:2002.10360
                  %a{:href => "https://doi.org/10.1103/PhysRevB.102.035161"} doi:10.1103/PhysRevB.102.035161
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
