                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "https://arxiv.org/abs/1808.07469"} arXiv:1808.07469
                  %a{:href => "https://doi.org/10.1126/science.aau8740"} doi:10.1126/science.aau8740
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
