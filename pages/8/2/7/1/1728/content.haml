                %a{:href => "https://arxiv.org/abs/1203.4568"}> arXiv:1203.4568
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00220-013-1723-0"} doi:10.1007/s00220-013-1723-0
            %li
