                        %mtd
                          %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  [\Pi(S^{k-1}), \Pi(H_1/H_2)]
                  \&amp;\leftarrow&amp;
                  [\Pi(D^{k}), \Pi(H_1/H_2)]
                  \&amp;\rightarrow&amp;
                  \\ast
                  }
          %p
            shows that the former models a
            = succeed "-disk" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} S^{k-1}
            take values in the moduli space of the ambient theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(H_1/H_2)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(H_0/H_2)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            To construct such a decay-process span that captures the above story from
            = succeed "," do
              %a{:href => "#PreskillVilenkin92"} Preskill &amp; Vilenkin 1992
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mi k
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 0
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Ω
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 0
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 1
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi pb
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi D
                            %mi k
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 0
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mo *
                          %mo ,
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 0
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mrow
                              %mi k
                              %mo −
                              %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi H
                            %mn 0
                          %mo{:stretchy => "false"} /
                          %msub
                            %mi H
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; [\Pi(S^{k}), \Pi(H_0/H_1)]
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; [\Pi(S^{k-1}), \Omega\Pi(H_0/H_1)]
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  [\Pi(S^{k-1}), \Pi(H_1/H_2)] &amp;&amp; (pb) &amp;&amp; [\Pi(D^k), \Pi(H_0/H_2)] &amp; \simeq &amp; [\ast, \Pi(H_0/H_2)]
                  \\\
                  \&amp; \searrow &amp; &amp; \swarrow
                  \\\
                  \&amp;&amp; [\Pi(S^{k-1}), \Pi(H_0/H_2)]
                  }
          %p This may be read as follows:
          %ol
            %li
              %p
                on the far left
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 1
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Pi(S^k), \Pi(H_1/H_2)]
                is the space of fields of the ambient theory at energy scale
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
                around the defect;
            %li
              %p
                the bottom left map is the “fluctuation” map that sends these fields to fields at the higher energy scale
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} E_1
            %li
              %p
                the bottom right map exhibt the possible “decays”: a lift through this map takes a field configuration that winds around a
                = succeed "-ball" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "-ball," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E_1
                and there having it decay away.
            %li
              %p
                these decaying configurations are therefore given by the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
                of the bottom two functions, which is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi Ω
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi H
                          %mn 0
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi H
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\Pi(S^{k-1}), \Omega\Pi(H_0/H_1)]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E_1
                that wind around a
                = succeed "-ball," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (k+1)
          %p
            Hence the top part of this diagram is a span that exhibits a defect-of-defects which tells just the story that (
            %a{:href => "#PreskillVilenkin92"}> Preskill &amp; Vilenkin 1992
            ) is telling: a codimension-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            defect of the low energy theory decays at higher energy, and the decay is witnessed by the appearance of a codimension
            = succeed "-defect" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mfrac{:linethickness => "0"}
                            %mrow
