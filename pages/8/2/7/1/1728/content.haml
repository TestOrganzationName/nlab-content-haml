          %h4#in_rozanskywitten_theory In Rozansky-Witten theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Kapustin"}> Anton Kapustin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lev+Rozansky"} Lev Rozansky
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Natalia+Saulina"} Natalia Saulina
                %em Three-dimensional topological field theory and symplectic algebraic geometry I
                (
                %a{:href => "https://arxiv.org/abs/0810.5415"}> arXiv:0810.5415
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ilka+Brunner"}> Ilka Brunner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nils+Carqueville"} Nils Carqueville
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Roggenkamp"} Daniel Roggenkamp
