                  %em Abelian duality, walls and boundary conditions in diverse dimensions
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0904.0840"} arXiv:0904.0840
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Kapustin"}> Anton Kapustin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Natalia+Saulina"} Natalia Saulina
                %em Surface operators in 3d TFT and 2d Rational CFT
                in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                (eds.)
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
                AMS, 2011
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nils+Carqueville"}> Nils Carqueville
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ingo+Runkel"} Ingo Runkel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gregor+Schaumann"} Gregor Schaumann
                = succeed "," do
                  %em Line and surface defects in Reshetikhin-Turaev TQFT
                %strong 10
                (2019), 399-439 (
                %a{:href => "https://arxiv.org/abs/1710.10214"}> arXiv:1710.10214
                )
          %p
            In the context of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/3d-3d+correspondence"} 3d-3d correspondence
