                %em
                  lbrack;
                  %a{:href => "http://arxiv.org/abs/1705.06085"}> arXiv:1705.06085
                  ,
                  = succeed "&rbrack;" do
                    %a{:href => "https://doi.org/10.2140/gt.2019.23.781"} doi:10.2140/gt.2019.23.781
          %p Details in dimension 2 and 3 are discussed in
