              uniquely determines its successor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \phi[n+1] = g
          #simp.num_remark
            %h6#remark_2 Remark
            %p
              The preceding proof does not show that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \phi[n]
              fit together to form a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              of simplicial
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              respects faces and degeneracies, the proof of Theorem
              %a.maruku-ref{:href => "#universal"}
              will be complete.
          #exist.num_lemma
            %h6#lemma_2 Lemma
            %p
              Given a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and an algebra map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f: X \to Y[0]
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi: Bar_T(X) \to Y
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \phi[0] = f
          .proof
            %h6#proof_3 Proof
            %p
              It is enough to produce such a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \phi: Bar_T(Y[0]) \to Y
              in the case
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi Y
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f = 1_{Y[0]}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f: X \to Y[0]
              is then given by a composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Bar
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi ϕ
                    %mi Y
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Bar_T(X) \stackrel{Bar_T(f)}{\to} Bar_T(Y[0]) \stackrel{\phi}{\to} Y.
            %p
              We will do something slightly more general. For any category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathbf{C}^{\Delta_a^{op}}, \mathbf{C}^{\Delta_a^{op}}]
              has a comonoid object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ∘
                      %mi D
                    %annotation{:encoding => "application/x-tex"} P = - \circ D
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mover
                      %mo →
                      %mover
                        %mi P
                        %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta_a^{op} \stackrel{\tilde{P}}{\to} [\mathbf{C}^{\Delta_a^{op}}, \mathbf{C}^{\Delta_a^{op}}]
            %p
              which, upon evaluating at an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mrow
                          %msubsup
                            %mi Δ
                            %mi a
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}^{\Delta_a^{op}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi D
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi eval
                      %mi Y
                    %mo ∘
                    %mover
                      %mi P
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                  %annotation{:encoding => "application/x-tex"} B(Y, D, D) \coloneqq eval_Y \circ \tilde{P}: \Delta_a^{op} \to \mathbf{C}^{\Delta_a^{op}}
            %p
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi D
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi Y
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} B(Y, D, D)[n] = Y D^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi D
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(Y, D, D)
              is a double simplicial object. Taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo =
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} = \mathbf{E}^T
              and taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to be a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mi Y
                      %mo →
                      %mi Y
                      %mi D
                    %annotation{:encoding => "application/x-tex"} h: Y \to Y D
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mi T
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi D
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi: B(T, T, Y) \to B(Y, D, D)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi T
                      %mi n
                    %mi Y
                    %mo →
                    %mi Y
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Phi[n]: T^n Y \to Y D^n
              is defined recursively as in the proof of Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#unique"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mn 1
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \Phi[0] = 1_Y
              and taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %msup
                      %mi T
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi Y
                    %mo →
                    %mi Y
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Phi[n+1]: T^{n+1} Y \to Y D^{n+1}
              the unique simplicial
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi T
                              %mi n
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi u
                                %msup
                                  %mi T
                                  %mi n
                                %mi Y
                          %mtd
                            %msup
                              %mi T
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi Φ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Φ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo +
                                  %mn 1
                                  %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mi Y
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi h
                                %msup
                                  %mi D
                                  %mi n
                          %mtd
                            %mi Y
                            %msup
                              %mi D
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T^n Y &amp; \stackrel{u T^n Y}{\to} &amp; T^{n+1} Y \\
                    _\mathllap{\Phi[n]} \downarrow &amp; &amp; \downarrow_\mathrlap{\Phi[n+1]} \\
                    Y D^n &amp; \underset{h D^n}{\to} &amp; Y D^{n+1}
                    }
            %p
              commutes for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              respects faces and degeneracies, the same will be true for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi Φ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mi n
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msup
                        %mi T
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %msup
                        %mi D
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi Y
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \phi[n] = \Phi[n][0]: (T^n Y)[0] = T^n(Y[0]) \to (Y D^n)[0] = Y[n]
              = succeed "." do
                %a.maruku-ref{:href => "#simp"}
            %p
              The claim is proved by induction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi D
                    %mo →
                    %msub
                      %mn 1
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \epsilon: D \to 1_{\Delta_a^{op}}
              be the counit and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mi D
                    %mo →
                    %mi D
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \delta: D \to D D
              be the comultiplication. We have face maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mi j
                    %mi m
                    %msup
                      %mi T
                      %mrow
                        %mi n
                        %mo −
                        %mi j
                        %mo −
                        %mn 1
                    %mi Y
                    %mo :
                    %msup
                      %mi T
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi Y
                    %mo →
                    %msup
                      %mi T
                      %mi n
                    %mi Y
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi Y
                    %msup
                      %mi D
                      %mi j
                    %mi ϵ
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo −
                        %mi j
                    %mo :
                    %mi Y
                    %msup
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi Y
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T^j m T^{n-j-1} Y: T^{n+1} Y \to T^n Y, \qquad Y D^j \epsilon D^{n-j}: Y D^{n+1} \to Y D^n
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} j = 0
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %msup
                      %mi T
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi Y
                    %mo :
                    %mi T
                    %mi Y
