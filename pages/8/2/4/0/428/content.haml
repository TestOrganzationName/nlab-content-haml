          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+algebra"} categorical algebra
            %em bar construction
            takes an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            and systematically “puffs it up”, replacing it with a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bar_T(A)
            in which all
            %a.existingWikiWord{:href => "/nlab/show/equations"} equations
            in the original algebra are replaced by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/1-simplices"} 1-simplices
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/syzygies"} syzygies
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-simplices"} 2-simplices
          %p
            More precisely, the bar construction takes an
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \rho)
            of a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T, \mu, \epsilon)
            on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to an
            %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+object"} augmented
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bar_T(A)
            in the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C^T
            of that monad. The face and degeneracy maps of this augmented simplicial object are given by the structure maps of the monad and its action on the algebra
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo (
                    %mi ⋯
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi T
                    %mi T
                    %mi A
                    %mover
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi A
                          %mi T
                          %mo ⋅
                          %mi ρ
                          %mphantom
                            %mi A
                      %mover
                        %mo ⟶
                        %mrow
                          %mi μ
                          %mo ⋅
                          %msub
                            %mi Id
                            %mi A
                    %mi T
                    %mi A
                    %mover
                      %mo ⟶
                      %mi ρ
                    %mi A
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Bar_T(A)
                  \\coloneqq
                  \\left(
                  \\cdots
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  T T A
                  \\stackrel{\stackrel{\mu \cdot Id_A}{\longrightarrow}}{\stackrel{\phantom{A} T \cdot \rho \phantom{A}}{\longrightarrow}}
                  T A \stackrel{\rho}{\longrightarrow} A
                  \\right)
                  \\,.
          %p
            If we apply the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mi C
                    %mi T
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} U : C^T \to C
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bar_T(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            called the
            %strong bar resolution
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mi ⋯
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi U
                    %mi T
                    %mi T
                    %mi A
                    %mover
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi A
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo ⋅
                          %mi ρ
                          %mo{:stretchy => "false"} )
                          %mphantom
                            %mi A
                      %mover
                        %mo ⟶
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi μ
                          %mo ⋅
                          %msub
                            %mi Id
                            %mi A
                          %mo{:stretchy => "false"} )
                    %mi U
                    %mi T
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %mi U
                        %mi ρ
                    %mi U
                    %mi A
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U Bar_T(A) = \left(
                  \\cdots
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  U T T A
                  \\stackrel{\stackrel{U (\mu \cdot Id_A)}{\longrightarrow}}{\stackrel{\phantom{A} U(T \cdot \rho) \phantom{A}}{\longrightarrow}}
                  U T A \stackrel{U \rho}{\longrightarrow} U A
                  \\right)
                  \\,.
          %p
            This is called a
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            because it is equipped with a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+equivalence"} simplicial homotopy equivalence
            to the underlying
            = succeed "-object" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi A
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U A \in C
            = succeed "." do
              %a.maruku-ref{:href => "#acyclic"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a universal property: it is initial among resolutions of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.maruku-ref{:href => "#universal"}
          %p
            Here we distinguish between the bar construction and the bar resolution, although the terms are often used interchangeably. It is worth noting that the bar
            %em construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bar_T(A)
            is not, in general, simplicially homotopy equivalent to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in the category of simplicial objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C^T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi C
                    %mi T
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} U \colon C^T \to C
            do we obtain a key feature of the bar
            = succeed ":" do
              %em resolution
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi U
                    %mi A
                  %annotation{:encoding => "application/x-tex"} U Bar_T(A) \simeq U A
          %p
            (Above we are identifying objects in a category, either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} A \in C^T
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mi A
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U A \in C
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (terminology)
              %br/
              The ‘
              %em> bar complex
              ’ got its name from the original notation used by
              = succeed "," do
                %a{:href => "#EM53"} Eilenberg &amp; MacLane 1953
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              for tensors (
              %a{:href => "#Ginzburg"}> Ginzburg
              ). Thus ‘bar’ does not need to be capitalized.
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                %annotation{:encoding => "application/x-tex"} \mathbf{E}
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi m
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mi T
                  %mo →
                  %mi T
                  %mo ,
                  %mi u
                  %mo :
                  %msub
                    %mn 1
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T, m \colon T T \to T, u: 1_{\mathbf{E}} \to T)
            be a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mathbf{E}^T
            denote the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                %annotation{:encoding => "application/x-tex"} U: \mathbf{E}^T \to \mathbf{E}
            the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            which is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            Recall that the
            %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+set"} augmented
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            %a.existingWikiWord{:href => "/nlab/show/ordinals"} ordinals
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            and order-preserving maps, is the “
            %a.existingWikiWord{:href => "/nlab/show/walking+structure"} walking
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            among strict
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            equipped with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            is ordinal addition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [m]+[n] = [m+n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is the
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            carries a unique monoid structure and represents the “generic monoid”
            %sup#fnref:2>
              %a{:href => "#fn:2", :rel => "footnote"} 2
            \.
          %p
            Similarly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Delta_a^{op}
            is the walking
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi U
                %annotation{:encoding => "application/x-tex"} F U
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mathbf{E}^T
            can be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            in the strict monoidal category of
            %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathbf{E}^T, \mathbf{E}^T]
            (with endofunctor composition as monoidal product), there is a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            (or in fact a unique
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/strict+monoidal+functor"} strict monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Bar
                        %mi T
                  %mo{:stretchy => "false"} [
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta_a^{op} \stackrel{Bar_T}{\to} [\mathbf{E}^T, \mathbf{E}^T]
          %p
            that takes the generic monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi U
                %annotation{:encoding => "application/x-tex"} F U
            and generally
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mi U
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∘
                        %mi n
                  %annotation{:encoding => "application/x-tex"} (F U)^{\circ n}
          %p
            If furthermore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi eval
                        %mi A
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi T
                %annotation{:encoding => "application/x-tex"} [\mathbf{E}^T, \mathbf{E}^T] \stackrel{eval_A}{\to} \mathbf{E}^T
          %p and we have the following definition:
          .num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong bar construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bar_T(A)
              is the simplicial
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Bar
                          %mi T
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi eval
                          %mi A
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \Delta_a^{op} \stackrel{Bar_T}{\to} [\mathbf{E}^T, \mathbf{E}^T] \stackrel{eval_A}{\to} \mathbf{E}^T.
            %p The composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Bar
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mover
                      %mo →
                      %mi U
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \Delta_a^{op} \stackrel{Bar_T(A)}{\to} \mathbf{E}^T \stackrel{U}{\to} \mathbf{E}
            %p
              will here be called the
              %strong bar resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p
            In the notation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/two-sided+bar+constructions"} two-sided bar constructions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi T
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Bar_T(A) = B(F, T, A)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ,
                    %mi T
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(T, T, A)
          %h2#dcalage_and_resolutions Décalage and resolutions
          %h3#dcalage Décalage
          %p
            To explain the sense in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U Bar_T(A)
            is a
            %em resolution
            of (the constant simplicial object)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"} décalage
            construction. Very simply, putting
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                  %mo →
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                %annotation{:encoding => "application/x-tex"} D = [1] + (-): \Delta_a^{op} \to \Delta_a^{op}
          %p
            the décalage functor on simplicial objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi a
                        %mi op
                %annotation{:encoding => "application/x-tex"} C^{\Delta_a^{op}}
            (valued in a category
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi a
                        %mi op
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mi D
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi a
                        %mi op
                  %mo .
                %annotation{:encoding => "application/x-tex"} P: \mathbf{C}^{\Delta_a^{op}} \stackrel{\mathbf{C}^D}{\to} \mathbf{C}^{\Delta_a^{op}}.
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            has a comonad structure (inherited from the comonoid structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Delta_a^{op}
            = succeed ")," do
              %em
                %a{:href => "decalage#DecalageComonad"} décalage – comonad structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            also carries a comonad structure. Notice also that there is a comonad map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ∘
                  %mo !
                %annotation{:encoding => "application/x-tex"} D \to [1]\circ !
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mn 1
                  %mo →
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                %annotation{:encoding => "application/x-tex"} [1]: 1 \to \Delta_a^{op}
            is left adjoint to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo :
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} !: \Delta_a^{op} \to 1
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            is initial in
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Delta_a^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mi i
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]+i: [1]+[0] \to [1]+[m]
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} P X \to {|X|}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|-|}
            is the composite (“discretization”):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi a
                        %mi op
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ev
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                  %mi C
                  %mover
                    %mo →
                    %mi diag
                  %msup
                    %mi C
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi a
                        %mi op
                  %mo .
                %annotation{:encoding => "application/x-tex"} C^{\Delta_a^{op}} \stackrel{ev_{[1]}}{\to} C \stackrel{diag}{\to} C^{\Delta_a^{op}}.
          %p
            The notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is chosen because décalage is essentially a kind of
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            construction, i.e., in the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{C} = Set
            it is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            analogue of a topological pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mi X
                            %mi I
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ev
                                %mn 1
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msub
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ev
                                  %mn 0
                        %mtd
                      %mtr
                        %mtd
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi X
                            %mo{:stretchy => "false"} |
                        %mtd
                          %munder
                            %mo →
                            %mi id
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P X &amp; \to &amp; X^I &amp; \stackrel{ev_1}{\to} X \\
                  \\downarrow &amp; &amp; \downarrow_\mathrlap{ev_0} &amp; \\
                  {|X|} &amp; \underset{id}{\to} &amp; X
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi id
                  %mo :
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} id: {|X|} \to X
            is the identity inclusion of the underlying set with the discrete topology.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            is essentially a sum of spaces of based paths
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi x
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\alpha: (I, 0) \to (X, x_0)
            over all possible choices of basepoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            is acyclic.
          %p The following definition names a nonce expression; this author (Todd Trimble) does not know how this is (or might be) referred to in the literature:
          #acyclic.num_defn
            %h6#definition_3 Definition
            %p
              An
              %strong acyclic structure
              on a simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X: \Delta_a^{op} \to C
              is a
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi P
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \to P X
          %p
            Here a
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the same as a
            %em right
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-comodule)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mo ∘
                  %mi D
                %annotation{:encoding => "application/x-tex"} h: X \to X \circ D
            satisfying evident equations. In more nuts-and-bolts terms, it consists of a series of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi n
                  %mo :
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h_n: X([n]) \to X([n+1])
            satisfying suitable equations.
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mi D
                %annotation{:encoding => "application/x-tex"} h: X \to X D
            may be viewed as a homotopy. Again, turning to the topological analogue for intuition, the corresponding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} h: X \to P X
            is a homotopy (or rather, the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi P
                  %mi X
                  %mo →
                  %msup
                    %mi X
                    %mi I
                %annotation{:encoding => "application/x-tex"} X \to P X \to X^I
            can be turned into a homotopy
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} I \times X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} h: X \to P X
            has a retraction given by the counit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo :
                    %mi P
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \varepsilon: P X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            becomes a retract of an acyclic space, hence acyclic itself.
          #rem.num_remark
            %h6#remark Remark
            %p
              Definition
              %a.maruku-ref{:href => "#acyclic"}
              gives an
              %em absolute
              notion of acyclicity, in the sense that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} X: \Delta_a^{op} \to \mathbf{C}
              carries an acyclic structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mi D
                  %annotation{:encoding => "application/x-tex"} h: X \to X D
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} G: \mathbf{C} \to \mathbf{C}'
              is any functor, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G X
              automatically carries an acyclic structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi h
                      %mo :
                      %mi G
                      %mi X
                      %mo →
                      %mi G
                      %mi X
                      %mi D
                    %annotation{:encoding => "application/x-tex"} G h: G X \to G X D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"} G X
              becomes acyclic in a standard model category sense under any functor
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} G: \mathbf{C} \to Set
          %h3#resolutions Resolutions
          %p
            Returning now to the bar resolution
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mi Bar
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U Bar_T(A)
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ∘
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo ≅
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo ∘
                  %mi D
                %annotation{:encoding => "application/x-tex"} T \circ U Bar_T \cong U Bar_T \circ D
            obtained as the following 2-cell pasting (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                %annotation{:encoding => "application/x-tex"} U Bar_T
            abbreviates the top and bottom horizontal composites)
          #eq:strong.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi Δ
                            %mi a
                            %mi op
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi Bar
                                %mi T
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi id
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %msub
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi D
                                %mo =
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %mo{:stretchy => "false"} ]
                                %mo +
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ≅
                        %mtd
                          %msub
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi id
                                %mo ,
                                %mi F
                                %mi U
                                %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ≅
                        %mtd
                          %msub
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi id
                                %mo ,
                                %mi U
                                %mi F
                                %mo{:stretchy => "false"} ]
                                %mo =
                                %mo{:stretchy => "false"} [
                                %mi id
                                %mo ,
                                %mi T
                                %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %msubsup
                            %mi Δ
                            %mi a
                            %mi op
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi Bar
                                %mi T
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi id
                              %mo ,
                              %mi U
                              %mo{:stretchy => "false"} ]
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi T
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mo{:stretchy => "false"} ]
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Delta_a^{op} &amp; \stackrel{Bar_T}{\to} &amp; [\mathbf{E}^T, \mathbf{E}^T] &amp; \stackrel{[id, U]}{\to} &amp; [\mathbf{E}^T, \mathbf{E}] \\
                  _\mathllap{D = [1] + (-)} \downarrow &amp; \cong &amp; _\mathllap{[id, F U]} \downarrow &amp; \cong &amp; \downarrow_\mathrlap{[id, U F] = [id, T]} \\
                  \\Delta_a^{op} &amp; \underset{Bar_T}{\to} &amp; [\mathbf{E}^T, \mathbf{E}^T] &amp; \underset{[id, U]}{\to} &amp; [\mathbf{E}^T, \mathbf{E}],
                  }
          %p whence there is a homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mover
                    %mo →
                    %mrow
                      %mi u
                      %mi U
                      %msub
                        %mi Bar
                        %mi T
                  %mi T
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo ≅
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} h = (U Bar_T \stackrel{u U Bar_T}{\to} T U Bar_T \cong U Bar_T D).
          .num_prop
            %h6#proposition Proposition
            %p
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is an acyclic structure, def.
              = succeed "," do
                %a.maruku-ref{:href => "#acyclic"}
              = succeed "-coalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          .proof
            %h6#proof Proof
            %p
              We verify the coassociativity condition for the coaction
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mi U
                      %msub
                        %mi Bar
                        %mi T
                      %mo →
                      %mi U
                      %msub
                        %mi Bar
                        %mi T
                      %mi D
                    %annotation{:encoding => "application/x-tex"} h: U Bar_T \to U Bar_T D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F U
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ≔
                      %mi F
                      %mi u
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \delta \coloneqq F u U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo =
                    %mi u
                    %mi U
                    %mo :
                    %mi U
                    %mo →
                    %mi U
                    %mi F
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \eta = u U: U \to U F U
              for a right
              = succeed "-coaction," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi U
                    %annotation{:encoding => "application/x-tex"} F U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              follows from a naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mi η
                          %mtd
                            %mi U
                            %mi F
                            %mi U
                        %mtr
                          %mtd
                            %msub
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi η
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi U
                                  %mi δ
                        %mtr
                          %mtd
                            %mi U
                            %mi F
                            %mi U
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mi η
                                %mi F
                                %mi U
                          %mtd
                            %mi U
                            %mi F
                            %mi U
                            %mi F
                            %mi U
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U &amp; \stackrel{\eta}{\to} &amp; U F U \\
                    _\mathllap{\eta} \downarrow &amp; &amp; \downarrow_\mathrlap{U\delta} \\
                    U F U &amp; \underset{\eta F U}{\to} &amp; U F U F U.
                    }
            %p
              Apply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi T
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [id_{\mathbf{E}^T}, -]
              to this coassociativity square to get another coassociativity, this time for the comonad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi T
                    %mo ,
                    %mi F
                    %mi U
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K \coloneqq [id_{\mathbf{E}^T}, F U]
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathbf{E}^T, \mathbf{E}^T]
              (with comultiplication denoted
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi K
                    %annotation{:encoding => "application/x-tex"} \delta_K
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ≔
                      %mo{:stretchy => "false"} [
                      %mi id
                      %mo ,
                      %mi η
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi id
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi id
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                      %mi K
                    %annotation{:encoding => "application/x-tex"} H \coloneqq [id, \eta]: [id, U] \to [id, U] \circ K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi id
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi H
                    %mo{:stretchy => "false"} [
                    %mi id
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} ]
                    %mi K
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi H
                          %mi K
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi id
                          %mo ,
                          %mi U
                          %mo{:stretchy => "false"} ]
                          %msub
                            %mi δ
                            %mi K
                    %mo{:stretchy => "false"} [
                    %mi id
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} ]
                    %mi K
                    %mi K
                    %mo .
                  %annotation{:encoding => "application/x-tex"} [id, U] \stackrel{H}{\to} [id, U]K \stackrel{\overset{[id, U]\delta_K}{\to}}{\underset{H K}{\to}} [id, U]K K.
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Bar
                      %mi T
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi T
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Bar_T: \Delta_a^{op} \to [\mathbf{E}^T, \mathbf{E}^T]
              is a strong monoidal functor (see the left isomorphism in
              = succeed ")," do
                %a.maruku-eqref{:href => "#eq:strong"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi id
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mi Bar
                              %mi T
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi H
                                %msub
                                  %mi Bar
                                  %mi T
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi id
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} ]
                            %mi K
                            %msub
                              %mi Bar
                              %mi T
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %mi H
                                  %mi K
                                  %msub
                                    %mi Bar
                                    %mi T
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi id
                                  %mo ,
                                  %mi U
                                  %mo{:stretchy => "false"} ]
                                  %msub
                                    %mi δ
                                    %mi K
                                  %msub
                                    %mi Bar
                                    %mi T
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi id
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} ]
                            %mi K
                            %mi K
                            %msub
                              %mi Bar
                              %mi T
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi h
                            %mo ↘
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≅
                          %mtd
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≅
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi id
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mi Bar
                              %mi T
                            %mi D
                          %mtd
                            %mover
                              %munder
                                %mo →
                                %mrow
                                  %mi h
                                  %mi D
                              %mover
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi id
                                  %mo ,
                                  %mi U
                                  %mo{:stretchy => "false"} ]
