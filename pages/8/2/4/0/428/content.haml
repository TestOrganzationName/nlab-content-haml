                  %annotation{:encoding => "application/x-tex"} T
          %p
            Now recalling that the bar construction takes any algebra of any monad and turns it into a simplicial object in the category of algebras of that monad, write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bar_T(1)
            for the augmented simplicial set obtained by applying this to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} 1 \in G Set
          %p
            By Theorem
            = succeed "," do
              %a.maruku-ref{:href => "#universal"}
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U Bar_T(1)
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"} contractible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi G
                %annotation{:encoding => "application/x-tex"} E G
            (and as such known as the
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal
            %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"} simplicial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mi G
                %annotation{:encoding => "application/x-tex"} W G
            (see
            %a{:href => "simplicial+classifying+space#WGInComponents"} here
            at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
          %p
            Working through the details, we see that the set of
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi G
                %annotation{:encoding => "application/x-tex"} E G
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} G^{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi G
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo →
                  %msup
                    %mi G
                    %mi n
                %annotation{:encoding => "application/x-tex"} \partial_i \colon G^{n+1} \to G^n
            are given by multiplying successive entries in the
            = succeed "-tuple," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 0
                  %mo ,
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi i
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\partial_i (g_0, g_1, \dots, g_n)
                  \\;=\;
                  (g_0, \dots, g_i g_{i+1}, \dots, g_n)
          %p
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i = 0, \dots, n-1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 0
                  %mo ,
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 0
                  %mo ,
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi g
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial_n (g_0, g_1, \dots, g_n)
                  \\;=\;
                  (g_0, g_1, \dots, g_{n-1})
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G \coloneqq (E G)/G
            is known as the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (also denoted
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{W}G
            %a.existingWikiWord{:href => "/nlab/show/topological+realization"} topological realization
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi G
                  %mo →
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} E G \to B G
            is the “
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          %p
            The simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            is also the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
            of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h3#for_modules_over_an_algebra For modules over an algebra
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a commutative
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} A Mod
            for the category of right
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            a right module, also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %msub
                    %mo ⊗
                    %mi k
                  %mi A
                %annotation{:encoding => "application/x-tex"} M \otimes_k A
            is canonically a right module. This construction extends to a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi k
                  %mi A
                  %mo :
                  %mi A
                  %mi Mod
                  %mo →
                  %mi A
                  %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T = (-) \otimes_k A :
                  A Mod
                  \\to
                  A Mod
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            into a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} A Mod
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            For any right
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi M
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \rho \colon M \otimes A \to M
            makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            into an algebra of the monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bar
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Bar_T(A)
            is then the simplicial
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mover
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mo ⟶
                  %mi M
                  %msub
                    %mo ⊗
                    %mi k
                  %mi A
                  %msub
                    %mo ⊗
                    %mi k
                  %mi A
                  %mover
                    %munder
                      %mo ⟶
                      %mrow
                        %mi ρ
                        %mo ⊗
                        %mi Id
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Id
                        %mo ⊗
                        %mi μ
                  %mi M
                  %msub
                    %mo ⊗
                    %mi k
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  M \otimes_k A \otimes_k A \stackrel{\overset{Id \otimes \mu}{\longrightarrow}}{\underset{\rho \otimes Id}{\longrightarrow}} M \otimes_k A
                  \\,.
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            functor of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            is given by the alternating sums of the face maps indicated above.
          %p
            This chain complex is what originally was called the
            %strong bar complex
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
          %p
            This chain complex provides a free resolution of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tor
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi A
                  %mo ×
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Tor(M, A \times A)
                  \\,.
          %p
            This gives the
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h3#for_differential_graded_hopf_algebras For differential graded (Hopf) algebras
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bar+and+cobar+construction"} bar and cobar construction
          %h3#for_algebras
            For
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            See (
            %a{:href => "#Fresse"}> Fresse
            ).
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+resolution"}> simplicial resolution
                ; this is essentially the same concept but from a slightly different perspective.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/canonical+resolution"} canonical resolution
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monadic+cohomology"} monadic cohomology
          %h2#references_and_literature References and Literature
          %p The original reference for bar constructions in the generality of monads is
          %ul
            %li#Godement58
              %a.existingWikiWord{:href => "/nlab/show/Roger+Godement"}> Roger Godement
              ,
              = succeed "," do
                %em Topologie algébrique et theorie des faisceaux
              = succeed "," do
                %strong 1252
              = succeed "," do
                %a{:href => "https://www.editions-hermann.fr/livre/topologie-algebrique-et-theorie-des-faisceaux-roger-godement"} webpage
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Godement-TopologieAlgebrique.pdf", :title => "pdf"} pdf
          %p whereas in the homological context the first appearance is:
          %ul
            %li#EM53
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              = succeed "," do
                %em
                  On the groups of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo{:stretchy => "false"} (
                        %mi Π
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H(\Pi, n)
                  I
              %strong 58
              (1953) 55–106 &amp;lbrack;
              %a{:href => "https://doi.org/10.2307/1969820"}> doi:10.2307/1969820
              \&amp;rbrack;
          %p A general discussion of bar construction for monads:
          %ul
            %li#Trimble
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"}> Todd Trimble
              ,
              %em On the Bar Construction
              (
              %a{:href => "http://golem.ph.utexas.edu/category/2007/05/on_the_bar_construction.html"}> blog
              )
          %p Textbook accounts::
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"}> Saunders Mac Lane
                , section IV.5 of
                %em Homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
                , section 8.6 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
                (1994)
            %li#Richter19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Birgit+Richter"}> Birgit Richter
                , section 10.4 in:
                = succeed "," do
                  %em From categories to homotopy theory
                = succeed "," do
                  %strong 188
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108855891"} doi:10.1017/9781108855891
                = succeed "," do
                  %a{:href => "https://www.math.uni-hamburg.de/home/richter/catbook.html"} webpage
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.uni-hamburg.de/home/richter/bookdraft.pdf"} pdf
          %p The bar complex of a bimodule is reviewed for instance in
          %ul
            %li#Ginzburg
              %a.existingWikiWord{:href => "/nlab/show/Victor+Ginzburg"}> Victor Ginzburg
              , around page 16 of:
              %em Lectures on noncommutative geometry
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math.AG/0506603"}> arXiv:math/0506603
              \&amp;rbrack;
          %p .
          %p
            The bar complex for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+algebra"} E-infinity algebra
          %ul
            %li#Fresse
              %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"}> Benoit Fresse
              ,
              = succeed "," do
                %em The bar complex of an E-infinity algebra
          %p
            The compositional structure of the bar construction of several monads, as well as its interpretation in terms of
            %a.existingWikiWord{:href => "/nlab/show/partial+evaluation"} partial evaluations
            is studied in
          %ul
            %li
              Carmen Constantin,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tobias+Fritz"} Tobias Fritz
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"} Paolo Perrone
              %em Partial evaluations and the compositional structure of the bar construction
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2009.07302"}> arXiv:2009.07302
              \&amp;rbrack;
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  N.B.: including the empty ordinal.
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
              %li#fn:2
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo :
                        %msubsup
                          %mi Δ
                          %mi a
                          %mi op
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} X: \Delta_a^{op} \to \mathbf{C}
                  is a simplicial object, then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X([n])
                  is what is usually denoted
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} X_{n-1}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n-1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi X
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} X([0]) = X_{-1}
                  is the augmented component. The
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  can be thought of as the number of vertices of a simplex of dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} n-1
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  over the geometric dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n-1
                  as it is more convenient for our purposes.
                  %a{:href => "#fnref:2", :rev => "footnote"} ↩
