                  %annotation{:encoding => "application/x-tex"} (T, m: T T \to T, u: 1 \to T)
              be a monad on a category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
