          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi X
                  %mover
                    %mo →
                    %mi g
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ρ
                  %mi K
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
