            and hence to every
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle 2-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi Π
                  %mi X
                  %mo →
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha : \Pi X \to B^2 U(1)
            is associated the corresponding
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mi U
                  %annotation{:encoding => "application/x-tex"} K U
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi X
                  %mover
                    %mo →
                    %mi α
                  %msup
                    %mi B
                    %mn 2
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ρ
                  %mi K
                  %mi U
                  %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi X \stackrel{\alpha}{\to} B^2 U(1) \stackrel{}{\to}
                  B GL_1(K U) \stackrel{\rho}{\to} K U Mod
                  \\,.
          %p
            Or for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo =
                  %mi tmf
                %annotation{:encoding => "application/x-tex"} K = tmf
            the
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            spectrum, there is a canonical morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi tmf
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B^3 U(1) \to B GL_1(tmf)
            and hence to every
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle 3-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi Π
                  %mi X
                  %mo →
                  %msup
                    %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha : \Pi X \to B^3 U(1)
            is associated the corresponding
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tmf
                  %annotation{:encoding => "application/x-tex"} tmf
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi X
                  %mover
                    %mo →
                    %mi α
                  %msup
                    %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %mi B
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi tmf
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ρ
                  %mi tmf
                  %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi X \stackrel{\alpha}{\to} B^3 U(1) \stackrel{}{\to}
                  B GL_1(tmf) \stackrel{\rho}{\to} tmf Mod
                  \\,.
          %p
            This was amplified by Ando, Blumberg, Gepner, Hopkins, and Rezk (see the reference at
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} K-(co)homology
            – including notably its
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            theory and its
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            – is neatly captured by simple statements about such
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-bundles." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation in generalized cohomology
            simply boils down to the notion of trivialization of such
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-bundles:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            a vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            is
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              \-oriented
            precisely if the corresponding
            = succeed "-bundle" do
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            = succeed "-line" do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi S
                  %mi Line
                %annotation{:encoding => "application/x-tex"} V: \Pi(X) \to S Line
            is such that the canonically associated
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mi is
                  %mi K
                  %mo −
                  %mi orientable
                  %mo{:stretchy => "false"} )
                  %mo ⇔
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi V
                  %mi S
                  %mi Line
                  %mo →
                  %mi K
                  %mi Line
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi const
                    %mi K
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (V is K-orientable)
                  \\Leftrightarrow
                  ( (\Pi(X) \stackrel{V}{\to} S Line \to K Line)
                  \\simeq
                  const_K  )
                  \\,.
          %p
            For our discussion here this means that Cohen-Godin’s finding that the string topology HQFT exists for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "-orientable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Recall that if we interpret an
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            for a
            = succeed "-model," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            any 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+space"} (∞,1)-vector space
            of states assigned to, say, the incoming boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi in
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial_{in} \Sigma
            is defined to be the
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of this
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
            the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mo ∂
                          %mi in
                        %mi Σ
                  %annotation{:encoding => "application/x-tex"} X^{\partial_{in} \Sigma}
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a{:href => "ExpositionQuantization"} above
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo :
                  %mo =
                  %munder
                    %mi lim
                    %mo →
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo →
                  %mi S
                  %mi Line
                  %mo →
                  %mi K
                  %mi Mod
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_{\partial_{in} \Sigma}
                  \:=
                  \\lim_\to(\Pi X^{\partial_{in} \Sigma} \to S Line \to  K Mod )
                  \\,.
          %p
            This one can compute. By triviality of the bundle, Ando-Blumberg-Gepner-Hopkins-Rezk observe that this is the
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                %annotation{:encoding => "application/x-tex"} X^{\partial_{in} \Sigma}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi K
                  %mo ∈
                  %mi K
                  %mi Mod
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots \simeq (\Sigma^\infty X^{\partial_{in} \Sigma}) \wedge K
                  \\in K Mod
                  \\,.
          %p
            (Here the main point is that for the bundle
            %em not
            being trivial the result encodes the corresponding
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            , but for our purposes at the moment we want the oriented/trivializable case.)
          %p
            This is hence the
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi in
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial_{in} \Sigma
            assigned by a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            a
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-oriented" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
          %p
            Notice that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo =
                  %mi H
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} K = H \mathbb{Z}
            the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            for the
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi ℤ
                  %mi Mod
                  %mo ≃
                  %msub
                    %mi Ch
                    %mo •
                %annotation{:encoding => "application/x-tex"}
                  H \mathbb{Z} Mod \simeq Ch_\bullet
          %p and in fact
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi ℤ
                  %mi Alg
                  %mo ≃
                  %msub
                    %mi dgAlg
                    %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  H \mathbb{Z} Alg \simeq dgAlg_{\mathbb{Z}}
          %p
            betwee the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/module+spectra"} module spectra
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/algebra+spectra"} algebra spectra
            (see there for details on this equivalence) and the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
            by the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-algebras"} on dg-algebras
            = succeed "-space" do
              %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Σ
                    %mn ∞
                  %msup
                    %mi X
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi K
                  %mo ∼
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\Sigma^\infty X^{S^1}) \wedge K
                  \\sim
                  C_\bullet(X^{S^1})
                  \\,.
          %p
            The “
            %a.existingWikiWord{:href => "/nlab/show/decategorification"}> decategorification
            ” of this
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Γ
                    %mrow
                      %mo ∂
                      %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_\bullet(\Gamma_{\partial \Sigma}) = H_\bullet(X^{\partial_{in} \Sigma}, K)
                  \\,.
          %h3#GWTheory
            The topological
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            The quantum
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            %a.existingWikiWord{:href => "/nlab/show/sigma+model"} sigma model
            whose
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            – often called the
            %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
            – is given by the
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gromov-Witten+theory"} Gromov-Witten theory
          %p
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#QuantumAbelianCS Quantum abelian Chern-Simons
          %p For the moment see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Topological+Quantum+Field+Theories+from+Compact+Lie+Groups"}> Topological Quantum Field Theories from Compact Lie Groups
              \.
