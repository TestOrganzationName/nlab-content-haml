                            %a.existingWikiWord{:href => "/nlab/show/11d+Chern-Simons+theory"} 11d Chern-Simons theory
                          %ul
                            %li
                              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
                    %li
                      %p
                        %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-model"} AKSZ sigma-model
                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-Chern-Simons+theory+-+contents"} Edit this sidebar
          %blockquote
            %p
              This is a sub-entry of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
          %hr/
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#exposition_of_quantum_sigmamodels"} Exposition of quantum sigma-models
              %ul
                %li
                  %a{:href => "#particle_on_the_line"} Particle on the line
                %li
                  %a{:href => "#StringTopology"} Topological string on a smooth manifold and string topology operations
                %li
                  %a{:href => "#GWTheory"}
                    The topological
                    = succeed "-model" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                %li
                  %a{:href => "#QuantumAbelianCS"} Quantum abelian Chern-Simons
          %h2#exposition_of_quantum_sigmamodels Exposition of quantum sigma-models
          %p
            Above we have discussed some standard
            %a{:href => "#ExpositionClassical"} classical sigma-models
            and
            = succeed "," do
              %a{:href => "#GaugeTheoryAsSigmaModel"} higher gauge theories as sigma-models
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of these models (or some of them) to
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
            %em
              quantum
              = succeed "-models" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
            \.
          %h3#particle_on_the_line Particle on the line
          %p for the moment see the discussion at
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/path+integral+as+a+pull-push+transform"} path integral as a pull-push transform
          %h3#StringTopology Topological string on a smooth manifold and string topology operations
          %p
            Chas and Sullivan famously noticed, that the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi X
                %annotation{:encoding => "application/x-tex"} L X
            of a
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are equipped with an interesting paring operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi dim
                      %mi X
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H_\bullet(L X) \otimes H_\bullet(L X) \to H_{\bullet - dim X}(L X)
          %p
            that generalizes the
            %a.existingWikiWord{:href => "/nlab/show/Goldman+bracket"} Goldman bracket
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi F
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_0(L X) \simeq F \pi_1(X)
            %em string product
            \. Its study has come to be known as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+topology"} differential topology
          %p
            It was soon realized that there indeed ought to be a relation to
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            physics: there ought to be a 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            associated with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            a 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/surface"} surface
            with incoming and outgoing
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            components
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi in
                    %mi Σ
                    %mover
                      %mo →
                      %mi in
                    %mi Σ
                    %mover
                      %mo ←
                      %mi out
                    %msub
                      %mo ∂
                      %mi out
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \partial_{in} \Sigma \stackrel{in}{\to} \Sigma \stackrel{out}{\leftarrow} \partial_{out} \Sigma
            = succeed "s\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/state"} state
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(X^{\partial_{in} \Sigma})
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mo ∂
                          %mi out
                        %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_\bullet(X^{\partial_{out} \Sigma})
            %a.existingWikiWord{:href => "/nlab/show/path+integral+as+a+pull-push+transform"} path integral as a pull-push transform
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            ought to be given by push-forward and dual
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi out
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi in
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo !
                  %mo :
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi dim
                      %mi X
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi out
                      %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (X^{out})_* \circ (X^{in})^! : H_\bullet(X^{\partial_{in} \Sigma})
                  \\to
                  H_{\bullet- dim X}(X^{\partial_{out} \Sigma})
          %p
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            %a.existingWikiWord{:href => "/nlab/show/span"} span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi X
                            %mi Σ
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mi X
                                  %mi in
                          %mo ↙
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mi X
                                  %mi out
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %msub
                                %mo ∂
                                %mi in
                              %mi Σ
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %msub
                                %mo ∂
                                %mi out
                              %mi Σ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; X^{\Sigma}
                  \\\
                  \&amp; {}^{\mathllap{X^{in}}}\swarrow &amp;&amp; \searrow^{\mathrlap{X^{out}}}
                  \\\
                  X^{\partial_{in} \Sigma} &amp;&amp;&amp;&amp; X^{\partial_{out} \Sigma}
                  }
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ≃
                  %msup
                    %mi S
                    %mn 1
                  %mo ∨
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \Sigma \simeq S^1 \vee S^1
            the 3-holed sphere with two incoming and one outgoing circle, this would describe an operation on string states induced by the merging of two closed strings to a single one
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H_\bullet(X^{S^1 \coprod S^1})
                  \\simeq
                  H_\bullet(L X) \times H_\bullet(L X)
                  \\to
                  H_\bullet(L X)
          %p and this ought to be Chas-Sullivan string product operation.
          %p
            That this is indeed the case was finally demonstrated by
            %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"} Ralph Cohen
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Veronique+Godin"} Veronique Godin
            %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
            for all references.) While the idea is rather simple, the concrete realization, especially when taking open strings into account, is fairly technical (see for instance
            = succeed ")." do
              %a{:href => "http://mathoverflow.net/questions/66977/pull-push-in-godins-hcft-for-string-topology"} this MO discussion
          %p
            But there should be more to it: one expects that these operations on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular chains
            %em
              %a.existingWikiWord{:href => "/nlab/show/HQFT"} HQFT
            – a
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            that depends only on the
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            (which in this dimension is widely but somewhat unfortunately known under the term “
            %a.existingWikiWord{:href => "/nlab/show/TCFT"}> TCFT
            ”). Remarks on how that might be obtained have been made in print by Costello and Lurie.
          %p
            In the context of our discussion of
            = succeed "-models," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            that manifold, and using some suitable
            = succeed "?" do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
          %p
            Given that the string topology
            %a.existingWikiWord{:href => "/nlab/show/TCFT"} TCFT
            itself has not been fully identified yet, we cannot expect a complete answer to this at the moment, but we will discuss some crucial ingredients that are available.
          %p
            Notably we can first ignore the dynamics of the system, just consider the kinematics and ask the simple question:
            %em
              which quantum
              = succeed "-models" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              have
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-vector+space"} (∞,n)-vector space
              %a.existingWikiWord{:href => "/nlab/show/states"} states
              whose
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
              are graded
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mrow
                        %mo ∂
                        %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_\bullet(X^{\partial \Sigma})
              of mapping spaces of
              = succeed "?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            The answer to this question is more more transparent after we formulate the question in more generality: as observed by Cohen and Godin in their
            %em
              %a.existingWikiWord{:href => "/nlab/show/A+Polarized+View+of+String+Topology"} A Polarized View of String Topology
            , we may assume without restriction that the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            with coefficients in any
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} commutative ∞-ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            (as long as this is an “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-field” and as long as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} oriented
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                      %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mo ∂
                        %mi in
                  %mi Σ
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_\bullet(X^{\partial_{in} \Sigma})
                  \:=
                  H_\bullet(X^{\partial_{in}} \Sigma, K)
                  \\,.
          %p
            Most every statement about ordinary commutative rings has its analog for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} commutative ∞-rings
          %p
            An
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+space"} (∞,1)-vector space
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
            and we have an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            of such
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the ordinary notion of
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            only in the “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            ”-direction of the lattice of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (r,n)-categories
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-vector+space"} (∞,n)-vector space
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            – as appears in the description of general
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (\cdots ((K Mod) Mod) \cdots ) Mod
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is something like
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (K Mod) Mod
          %p
            This means that an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
            with flat
            %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connection
            over some
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalently encoded by an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi Π
                  %mi X
                  %mo →
                  %mi K
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  \\alpha : \Pi X \to K Mod
          %p
            out of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
            thus encoded – to each path in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            between the fibers over its endpoints, and so on: this is the
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
            of a flat
            = succeed "-connection." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Pi X
            on
            = succeed "-modules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %em
              %a.existingWikiWord{:href => "/nlab/show/representation+up+to+homotopy"} representation up to homotopy
            \. For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = B G
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-group"} discrete ∞-group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-vector+bundle"} (∞,1)-vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are precisely
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            There is an evident
            %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mi Line
                  %mo ↪
                  %mi K
                  %mi Mod
                %annotation{:encoding => "application/x-tex"}
                  K Line \hookrightarrow K Mod
          %p
            of 1-dimensional
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-lines" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            itself regarded as a
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            An
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
