                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1\}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo ≔
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} 2 \coloneqq \{0, 1\}
                have rank
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} 2
          %p
            and so on. Each ordinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            has rank
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          .num_theorem
            %h6#theorem Theorem
            %p
              For every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mi On
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in On(V)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in R(\alpha)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              appears as an element somewhere within the cumulative hierarchy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi …
                    %mo ⊂
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi …
                    %mo ⊂
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo +
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi …
                  %annotation{:encoding => "application/x-tex"} R(0) \subset R(1) \subset \ldots \subset R(\omega) \subset R(\omega + 1) \subset \ldots \subset R(\omega + \omega) \subset \ldots
          %p
            The proof is essentially that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %mrow
                      %mi α
                      %mo ∈
                      %mi On
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigcup_{\alpha \in On(V)} R(\alpha)
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \in
            %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} inductive set
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, \in)
            is well-founded (by the axiom of foundation). Details may be found in any reasonable text on ZFC set theory, for example
            = succeed "." do
              %a{:href => "#Kunen"} Kunen
          .num_remark
            %h6#remark Remark
            %p
              The notation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              so widely seen in set theory texts and articles is a kind of visual pun that refers to the cumulative hierarchy: one imagines the V as outlining an angle, with a horizontal cross-section of the space inside the angle at height
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              suggesting a set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(\alpha)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              increases; the ordinals
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              themselves may be pictured as vertebrae of a spine or line therein. All sets in the cumulative hierarchy lie somewhere within the V.
          %h2#in_algebraic_set_theory In algebraic set theory
          %p
            The idea of a cumulative hierarchy is realized in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+set+theory"} algebraic set theory
            via the construction of an initial “ZF-algebra”. In broad-brush terms, there is a general connection between well-foundedness and initial algebras, as in Paul Taylor’s theory of recursion where an initial
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/taut+functor"} taut functor
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/well-founded+coalgebra"} well-founded coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi θ
                  %mo :
                  %mi X
                  %mo →
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \theta: X \to T X)
            for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            is an isomorphism (i.e., a maximal well-founded coalgebra). Algebraic set theory can be seen as exploiting this connection and working out the details in cases specific to operations on “small sets”, eventually enabling one to get at the cumulative hierarchy
            = succeed "," do
              %em per se
            %em well-founded sets
            (as well as the universe of ordinals, etc.).
          %p
            This deserves to be discussed at length, but let us try to give a few hints for now. One starts with a
            %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (whose objects are regarded as “classes”) equipped with a suitable notion of “smallness”: to say a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f: E \to X
            in the pretopos is “small” means intuitively that all its
            %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
            are “small” (i.e., sets). Thus one assumes some reasonable axioms on the class of small maps in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "\u201D:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                  %annotation{:encoding => "application/x-tex"} el
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} E \to U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            naming small sets and the fiber over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            the actual (small) set of its elements. The smallness axioms allow one to construct a small-
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            functor
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi s
                    %mo :
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} P_s: \mathcal{C} \to \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the class of small subsets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            structure whose algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi sup
                  %mo :
                  %msub
                    %mi P
                    %mi s
                  %mi X
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \sup: P_s X \to X)
            are “small-complete” posets in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            To get at the actual cumulative hierarchy (with attendant global membership relation
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \in
            %em ZF-algebra
            to be a small-complete poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo ≤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, \leq)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} s: V \to V
            satisfying suitable conditions; here one is to think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            as “inclusion” and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s(x)
            as a singleton
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \in y
            can then be interpreted as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi y
                  %annotation{:encoding => "application/x-tex"} s(x) \leq y
          .num_remark
            %h6#remark_2 Remark
            %p The details of the construction of the initial ZF-algebra should be examined with attention to connections with Taylor’s theory of well-founded coalgebras; for example, systematic use is made of bisimulations which has a general meaning in coalgebra theory.
          %p
            This program, initiated by
            %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
            %em intuitionistic
            ZF-set theory and intuitionistic ordinals. The reader is referred to their
            %a{:href => "#JM"} monograph
            for details, and to the
            %a{:href => "http://www.phil.cmu.edu/projects/ast/"} Algebraic Set Theory
            page for further pointers to the literature.
