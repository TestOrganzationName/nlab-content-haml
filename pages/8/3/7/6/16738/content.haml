          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#in_zfc"} In ZFC
              %li
                %a{:href => "#in_algebraic_set_theory"} In algebraic set theory
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+foundation"} axiom of foundation
            that the membership relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            is an extensional (but not necessarily
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} well-founded relation
            = succeed "," do
              %em cumulative hierarchy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            is born the power set of Day
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h2#in_zfc In ZFC
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/model"} model
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is defined to be
            %em transitive
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi x
                %annotation{:encoding => "application/x-tex"} b \in x
            implies
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ⊂
                    %mi x
                  %annotation{:encoding => "application/x-tex"} b \subset x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi b
                  %mo ∈
                  %mi x
                %annotation{:encoding => "application/x-tex"} a \in b \in x
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi x
                  %annotation{:encoding => "application/x-tex"} a \in x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            on the set consisting of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and the elements of its transitive closure is itself
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi b
                  %mo ∈
                  %mi c
                %annotation{:encoding => "application/x-tex"} a \in b \in c
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} c = x
            %em is
            transitive, then it is transitive, and extensional (by the extensionality axiom), and well-founded (by the axiom of foundation), and hence a well-order according to the argument
            = succeed "." do
              %a{:href => "/nlab/show/well-order#wellorders_are_linear"} here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is by definition an
            %a.existingWikiWord{:href => "/nlab/show/ordinal+number"} ordinal number
            (in the sense of von Neumann).
          %p
            Letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi On
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} On(V)
            be the class of ordinals (= ordinal numbers), one may define with the help of the replacement axiom a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi On
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} R: On(V) \to V
          %p
            by transfinite induction as follows:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R(0) = 0
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(\alpha + 1) = P(R(\alpha))
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                denotes power set),
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                        %mrow
                          %mi α
                          %mo &lt;
                          %mi β
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(\beta) = \bigcup_{\alpha \lt \beta} R(\alpha)
                when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
                is a limit ordinal.
          .num_prop
            %h6#proposition Proposition
            %p
              Each of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(\alpha)
              is transitive, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ≤
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha \leq \beta
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(\alpha) \subseteq R(\beta)
          .proof
            %h6#proof Proof
            %p
              First, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a transitive set, then so is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P(X)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \in P(X)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
