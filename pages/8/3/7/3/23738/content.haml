                        %mi lcm
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} lcm(a,b)
                  exists and is equal to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
