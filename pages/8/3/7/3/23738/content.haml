                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} gcd(a,b)=0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  are zero since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} gcd(a,b)
                  divides both of them. If both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  are zero, we already know from the previous point that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} gcd(a,b)=0
              %li
                %p
                  If
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} lcm(a,b)=0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ab
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} ab=0
                  since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi lcm
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} lcm(a,b)
                  divides
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ab
                        %annotation{:encoding => "application/x-tex"} ab
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is zero. Now, suppose that one of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  is zero. We already know that both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  divide
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} c \in R
                  is such that both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  divides
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                        %annotation{:encoding => "application/x-tex"} c
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ,
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a,b
                  being zero, it follows that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  divides
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                        %annotation{:encoding => "application/x-tex"} c
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} lcm(a,b)=0
            %p
          %p We will now proceed to prove that a GCD domain can equivalently be defined as an integral domain such that every pair of elements admits an lcm. First, we need a lemma about the compatibility of gcd’s with multiplication.
          %p
          .num_lemma
            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be an integral domain. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a,b\in R
              and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} m \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(a,b)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(ma,mb)
              exist. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo ⋅
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(ma,mb)=m\cdot gcd(a,b)
              (up to multiplication by an invertible element).
          .proof
            %h6 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} m=0
              then, we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi gcd
                      %mo{:stretchy => "false"} (
                      %mi ma
                      %mo ,
                      %mi mb
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo =
                      %mi m
                      %mo ⋅
                      %mi gcd
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} gcd(ma,mb)=0=m\cdot gcd(a,b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is nonzero.
            %ol
              %li
                %p
                  Since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} gcd(a,b)
                  divides both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                        %mo ⋅
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} m\cdot gcd(a,b)
                  divides both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                      %annotation{:encoding => "application/x-tex"} ma
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi mb
                        %annotation{:encoding => "application/x-tex"} mb
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo ⋅
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m\cdot gcd(a,b) \mid gcd(ma,mb)
              %li
                %p
                  We know that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                  divides both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                      %annotation{:encoding => "application/x-tex"} ma
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi mb
                        %annotation{:encoding => "application/x-tex"} mb
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m \mid gcd(ma,mb)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi ma
                        %mo ,
                        %mi mb
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi mu
                      %annotation{:encoding => "application/x-tex"} gcd(ma,mb)=mu
                  for some
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} u \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi mu
                      %annotation{:encoding => "application/x-tex"} mu
                  divides both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                      %annotation{:encoding => "application/x-tex"} ma
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi mb
                      %annotation{:encoding => "application/x-tex"} mb
                  i.e. there exists
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} s,t \in R
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                        %mo =
                        %mi msu
                      %annotation{:encoding => "application/x-tex"} ma=msu
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi mb
                          %mo =
                          %mi mtu
                        %annotation{:encoding => "application/x-tex"} mb=mtu
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                  is nonzero, we deduce that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo =
                        %mi su
                      %annotation{:encoding => "application/x-tex"} a=su
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                          %mo =
                          %mi tu
                        %annotation{:encoding => "application/x-tex"} b=tu
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
                  divides both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} u \mid gcd(a,b)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                        %annotation{:encoding => "application/x-tex"} m
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi m
                          %mo ⋅
                          %mi gcd
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} gcd(ma,mb) \mid m\cdot gcd(a,b)
            %p
              From the two previous points, we deduce that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(ma,mb)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ⋅
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m \cdot  gcd(a,b)
              are associated.
          %p
            We can now prove that:
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be an integral domain and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi R
                      %mo \
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} a,b \in R \backslash \{0\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lcm
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} lcm(a,b)
              exists iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(ma,mb)
              exists for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi R
                      %mo \
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} m \in R \backslash \{0\}
          .proof
            %h6 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⇐
                  %annotation{:encoding => "application/x-tex"} \Leftarrow
              \: Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi R
                    %mo \
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a,b \in R \backslash \{0\}
              are such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(ma,mb)
              exists for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
