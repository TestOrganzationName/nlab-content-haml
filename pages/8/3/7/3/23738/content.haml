          = succeed "." do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R,\mid)
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi a
              %annotation{:encoding => "application/x-tex"} a
          and
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi b
              %annotation{:encoding => "application/x-tex"} b
          exists, then the lcm’s of
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi a
              %annotation{:encoding => "application/x-tex"} a
          and
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi b
              %annotation{:encoding => "application/x-tex"} b
          are exactly the products of this first lcm by any invertible element.
          %p
            The following proposition treats the interactions of gcd, lcm and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be an integral domain.
            %ul
              %li
                %p
                  Let
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi r
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} r \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi r
                      %annotation{:encoding => "application/x-tex"} gcd(r,0)=r
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi r
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} lcm(r,0)=0
              %li
                %p
                  Let
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo ,
                          %mi b
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} a,b \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi gcd
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} gcd(a,b)
                  exists and is equal to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                  iff both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
