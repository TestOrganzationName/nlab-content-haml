                    %mo ⋅
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m\cdot gcd(a,b)
              is a gcd of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ma
                  %annotation{:encoding => "application/x-tex"} ma
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi mb
                    %annotation{:encoding => "application/x-tex"} mb
            %p
              We know that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gcd(a,b)
              divides both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ⋅
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m \cdot gcd(a,b)
              divides both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ma
                  %annotation{:encoding => "application/x-tex"} ma
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi mb
                    %annotation{:encoding => "application/x-tex"} mb
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} v \in R
              be such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              divides both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ma
                  %annotation{:encoding => "application/x-tex"} ma
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi mb
                    %annotation{:encoding => "application/x-tex"} mb
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is nonzero. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ma
                    %mo =
                    %mi v
                    %mi α
                  %annotation{:encoding => "application/x-tex"} ma=v\alpha
              from which we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi mab
                      %mo =
                      %mi v
                      %mi α
                      %mi b
                    %annotation{:encoding => "application/x-tex"} mab=v\alpha b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi α
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \mid \alpha b
              (since
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi mb
                    %annotation{:encoding => "application/x-tex"} v \mid mb
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi α
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b \mid \alpha b
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lcm
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi α
                      %mi b
                    %annotation{:encoding => "application/x-tex"} lcm(a,b) \mid \alpha b
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lcm
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mi v
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi α
                      %mi bv
                      %mo =
                      %mi mab
                    %annotation{:encoding => "application/x-tex"} lcm(a,b)v \mid \alpha bv=mab
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ab
                      %mo =
                      %mi lcm
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mi gcd
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ab=lcm(a,b)gcd(a,b)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi m
                      %mo ⋅
                      %mi gcd
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \mid m\cdot gcd(a,b)
            %p
              We have verified the two conditions for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ⋅
                    %mi gcd
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m\cdot gcd(a,b)
              to be a gcd of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ma
                  %annotation{:encoding => "application/x-tex"} ma
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi mb
                    %annotation{:encoding => "application/x-tex"} mb
          We can therefore state:
          .num_cor
            %h6 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be an integral domain. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a GCD domain iff every pair of elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              admits an lcm.
          %h3#properties_of_gcds_and_lcms Properties of gcd’s and lcm’s
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a GCD domain. We already know that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi ma
                  %mo ,
                  %mi mb
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi m
                  %mo ⋅
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gcd(ma,mb)=m \cdot gcd(a,b)
            for every
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi m
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a,b,m \in R
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a GCD domain. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a,b \in R
              and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} m \in R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lcm
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi m
                    %mo ⋅
                    %mi lcm
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} lcm(ma,mb)=m\cdot lcm(a,b)
              (up to multiplication by a unit).
          .proof
            %h6 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} m=0
              then the two sides of the equation are zero. We can thus suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is nonzero.
            %ol
              %li
                %p
                  We know that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} a \mid lcm(a,b)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} b \mid lcm(a,b)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi m
                        %mo ⋅
                        %mi lcm
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ma \mid m\cdot lcm(a,b)
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi mb
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi m
                          %mo ⋅
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} mb \mid m\cdot lcm(a,b)
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} lcm
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi m
                          %mo ⋅
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \lcm(ma,mb) \mid m\cdot lcm(a,b)
              %li
                %p
                  We know that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi ma
                        %annotation{:encoding => "application/x-tex"} m \mid ma
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m \mid lcm(ma,mb)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi lcm
                        %mo{:stretchy => "false"} (
                        %mi ma
                        %mo ,
                        %mi mb
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi mu
                      %annotation{:encoding => "application/x-tex"}
                        lcm(ma,mb)=mu
                %p
                  where
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                          %mo ∈
                          %mi R
                        %annotation{:encoding => "application/x-tex"} u \in R
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ma
                      %annotation{:encoding => "application/x-tex"} ma
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi mb
                      %annotation{:encoding => "application/x-tex"} mb
                  divides
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi mu
                        %annotation{:encoding => "application/x-tex"} mu
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                  is nonzero, we obtain that both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  divides
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi u
                        %annotation{:encoding => "application/x-tex"} u
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi u
                        %annotation{:encoding => "application/x-tex"} lcm(a,b) \mid u
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                        %annotation{:encoding => "application/x-tex"} m
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo ⋅
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %mi lcm
                          %mo{:stretchy => "false"} (
                          %mi ma
                          %mo ,
                          %mi mb
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} m \cdot lcm(a,b) \mid lcm(ma,mb)
            %p
              From the two previous points, we conclude that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lcm
                    %mo{:stretchy => "false"} (
                    %mi ma
                    %mo ,
                    %mi mb
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} lcm(ma,mb)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ⋅
                    %mi lcm
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} m \cdot lcm(a,b)
              are associated.
          %p
            The compatibility of the product with gcd’s and lcm’s implies that the multiplicative monoid of an integral domain is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prelattice-ordered+commutative+monoid"} prelattice-ordered commutative monoid
          %h3#other_properties Other properties
          %p
            Every GCD domain of
            %a.existingWikiWord{:href => "/nlab/show/Krull+dimension"} dimension
            at most 1 is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout domain
          %h2#examples Examples
          %ul
            %li
              %p
                The ring of integers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %li
              %p
                For any
                %a.existingWikiWord{:href => "/nlab/show/GCD+domain"} GCD domain
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[x]
                on one generator
            %li
