                            n \in \mathbb{N}_+
                            }{\forall}
                            \\;\;
                            [S^n, X]
                            \\underoverset
                            {\simeq}
                            {f_\ast}
                            {\longrightarrow}
                            [S^n, Y]
                            \\,.
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
                      on the free homotopy set out of the
                      %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                      of
                      %a.existingWikiWord{:href => "/nlab/show/circles"} circles
                      %a.existingWikiWord{:href => "/nlab/show/index+set"} indexed
                      by (the set
                      = succeed ")" do
                        %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                      %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                      of
                      = succeed ":" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Y
                            %annotation{:encoding => "application/x-tex"} Y
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %munder
                              %mo ∨
                              %mrow
                                %msub
                                  %mi π
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi X
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                            %mover
                              %mo ↠
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi f
                                  %mo *
                                %mspace{:width => "thickmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %munder
                              %mo ∨
                              %mrow
                                %msub
                                  %mi π
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi S
                              %mn 1
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi Y
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %annotation{:encoding => "application/x-tex"}
                            \\big[
                            \\underset{\pi_1(Y)}{\vee} S^1
                            ,\,
                            X
                            \\big]
                            \\overset{\; f_\ast \;}{\twoheadrightarrow}
                            \\big[
                            \\underset{\pi_1(Y)}{\vee} S^1
                            ,\,
                            Y
                            \\big]
            %p
          (
          %a{:href => "#MatumotoMinamiSugawara84"}> Matumoto, Minami and Sugawara 1984, Thm. 2
          )
          .proof
            %h6 Proof
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1) \Rightarrow (2)
              is a standard/classical conclusion in homotopy theory, for example it is a small special case of the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Map(K,-)
              out of any cell complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              preserves weak homotopy equivalences (
              %a{:href => "classical+model+structure+on+topological+spaces#HomProductAdjunctionForCofibrantObjectInTopCGIsQuillen"}> this Prop.
              ).
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2) \Rightarrow (3)
              is trivial, as the conditions in (3) are just a special case of the condition in (2).
            %p
              So the point of the statement is that (3) is already sufficient to recover (1). This is the content of
              = succeed "." do
                %a{:href => "#MatumotoMinamiSugawara84"} Matumoto, Minami and Sugawara 1984, Thm. 1 &amp; Lem. 1.3
          %h2#for_other_kinds_of_spaces For other kinds of spaces
          %p
            A map of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            is called a weak homotopy equivalence equivalently if its
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            is a weak homotopy equivalence of topological spaces, as above. (Since the geometric realization of any simpicial set is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            Likewise, a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            categories is sometimes said to be a weak homotopy equivalence if its
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            is a weak homotopy equivalence of simplicial sets, hence of topological spaces after
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+categories"} geometric realization of categories
            %a.existingWikiWord{:href => "/nlab/show/Thomason+model+structure"} Thomason model structure
            on categories (not the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"} canonical model structure
            %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+A"} Quillen's theorem A
            and
            %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+B"} Quillen's theorem B
            in in this contex.
          %p
            Similarly, one can define weak homotopy equivalences between any sort of object that has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-category"} n-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-fold+category"} n-fold category
          %p
            Note that in some of these cases, such as as simplicial sets, symmetric sets, and probably cubical sets, there is also a notion of “homotopy equivalence” from which this notion needs to be distinguished. A simplicial homotopy equivalence, for instance, is a simplicial map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            with an inverse
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} g:Y\to X
            and simplicial homotopies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\times \Delta^1 \to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ×
                  %msup
                    %mi Δ
                    %mn 1
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y\times \Delta^1 \to Y
            relating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi g
                %annotation{:encoding => "application/x-tex"} f g
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi f
                %annotation{:encoding => "application/x-tex"} g f
            to identities.
          %p
            A different direction of generalization is the notion of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence+of+toposes"} homotopy equivalence of toposes
          %h2#examples Examples
          %h3#ExamplesOfNonReversibleWHEs Of non-reversible weak homotopy equivalences
          %p
            We discuss examples of weak homotopy equivalences that have no weak homotopy equivalence going the other way, according to prop.
            %a.maruku-ref{:href => "#ReflexiveAndTransitiveButNotSymmetric"}
            above.
          #CircleAndPseudoCircle.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S^1 \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              denote the ordinary
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pseudocircle"} pseudocircle
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} S^1 \to \mathbb{S}
              which is a weak homotopy equivalence, hence in particular
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \pi_1(\mathbb{S}) \simeq \mathbb{Z}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \pi_1
          %p
            This is the simplest in a class of counter-examples discussed in (
            %a{:href => "#McCord"}> McCord
            ).
