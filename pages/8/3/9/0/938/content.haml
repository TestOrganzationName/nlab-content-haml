                      %a.maruku-eqref{:href => "#eq:FreeHomotopySets"} (1)
                      out of
                      = succeed "any" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi K
