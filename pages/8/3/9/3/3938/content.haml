                %a{:href => "https://arxiv.org/abs/math/0605534"}> arXiv:math/0605534
                ,
                = succeed "&rbrack;" do
                  %a{:href => "www.morfismos.cinvestav.mx/Portals/morfismos/SiteDocs/Articulos/Volumen11/No2/Zhang/arz.pdf"} Morfismos pdf
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the transgression operation from
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbes"} bundle gerbes
            (
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe+with+connection"}> with connection
