          %h2#idea Idea
          %p
            At least in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            may be written in
            %em
              base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            for any
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            (binary for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} n = 10
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \gt 1
            (especially
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi{:mathvariant => "normal"} e
                    %mo ≈
                    %mn 2.718
                  %annotation{:encoding => "application/x-tex"} n = \mathrm{e} \approx 2.718
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 60
                %annotation{:encoding => "application/x-tex"} 60
            (around 2000 BCE), perfected in the Gupta Empire using base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 10
                %annotation{:encoding => "application/x-tex"} 10
            (around 400), and popularized in Europe by
            %span.newWikiWord
              Fibonacci
              %a{:href => "/nlab/new/Fibonacci"} ?
            (in 1202). For arbitrary real numbers, these were first used by
            %span.newWikiWord
              Abu'l-Hasan al-Uqlidisi
              %a{:href => "/nlab/new/Abu%27l-Hasan+al-Uqlidisi"} ?
            (around 952) and popularized by
            %span.newWikiWord
              Simon Stevin
              %a{:href => "/nlab/new/Simon+Stevin"} ?
            (in 1585). This notation (in base
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} 10
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            in elementary mathematics.
          %p
            Radix notation in base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is the basis of
            = succeed "," do
              %span.newWikiWord
                floating point arithmetic
                %a{:href => "/nlab/new/floating+point+arithmetic"} ?
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/computing"} computing
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            be the set of natural numbers (including
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/zero"} zero
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo −
                    %mn 2
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} [n] = \{0, 1, 2, \ldots, n - 2, n - 1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is called a
            %strong digit
            (in base
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            be the set of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi …
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} = \{\ldots, -2, -1, 0, 1, 2, \ldots\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is called a
            = succeed "." do
              %strong place
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is a doubly-infinite
            %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            of digits, one digit for each place. Such a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℤ
                %annotation{:encoding => "application/x-tex"} a = (a_i)_{i\colon{\mathbb{Z}}}
            defines a doubly-infinite
            %a.existingWikiWord{:href => "/nlab/show/series"} series
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn ∞
                      %mo &lt;
                      %mi i
                      %mo &lt;
                      %mn ∞
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sum_{-\infty \lt i \lt \infty} a_i n^{-i} .
          %p
            (The term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                %annotation{:encoding => "application/x-tex"} a_i n^{-i}
            is the
            %strong place value
            of the digit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} a_i
            at the place
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a_i = 0
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &lt;
                    %mi N
                  %annotation{:encoding => "application/x-tex"} i \lt N
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mi N
                    %mn ∞
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sum_{i = N}^\infty a_i n^{-i} .
          %p
            In this way, a sequence of digits (finite on one end, infinite on the other) represents a nonnegative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mi i
                %annotation{:encoding => "application/x-tex"} n^i
            is used instead of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                  %annotation{:encoding => "application/x-tex"} n^{-i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                %annotation{:encoding => "application/x-tex"} n^{-i}
            so that the places are written in order.)
          %p
            As a representation of real numbers, this is almost unique. Specifically, two distinct sequences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            of digits represent the same real number (meaning that the sums of the series are equal) if and only if there is some place
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            such that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo =
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} a_i = b_i
              for every place
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo &lt;
                      %mi m
                    %annotation{:encoding => "application/x-tex"} i \lt m
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi m
                    %mo =
                    %msub
                      %mi b
                      %mi m
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a_m = b_m + 1
              (or the reverse), and
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo =
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a_i = n - 1
              for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mi m
                  %annotation{:encoding => "application/x-tex"} i \gt m
              while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b_i = 0
              for every
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo &gt;
                      %mi m
                    %annotation{:encoding => "application/x-tex"} i \gt m
          %p
            In this case, the sequence with
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %span.newWikiWord
              adic rational
              %a{:href => "/nlab/new/adic+rational"} ?
            numbers, that is the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            that are positive integer multiples of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi m
                %annotation{:encoding => "application/x-tex"} n^{-m}
            for some integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            (the same
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            as above).
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and a place
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} a_i
            be the
            %span.newWikiWord
              remainder
              %a{:href => "/nlab/new/remainder"} ?
            modulo
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            of the
            %a.existingWikiWord{:href => "/nlab/show/floor"} floor
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msup
                      %mi n
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x n^i
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo ≔
                    %mo{:stretchy => "false"} ⌊
                    %mrow
                      %mi x
                      %msup
                        %mi n
                        %mi i
                    %mo{:stretchy => "false"} ⌋
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi n
                  %annotation{:encoding => "application/x-tex"} a_i \coloneqq \lfloor{x n^i}\rfloor \mod n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi a
                      %mi i
                    %msup
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                  %annotation{:encoding => "application/x-tex"} x = \sum_i a_i n^{-i}
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "s;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⌈
                    %mrow
                      %mi x
                      %msup
                        %mi n
                        %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ⌉
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                    %mi n
                  %annotation{:encoding => "application/x-tex"} a_i = (\lceil{x n^i} - 1\rceil) \mod n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is represented only by a sequence of all
            = succeed "s." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            unique symbols for the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            digits, the real number represented by a sequence of digits may be written by, beginning at the smallest place whose digit is nonzero, writing the symbols in order, with a dot (or comma), called the
            = succeed "," do
              %strong radix point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and place
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (and padding zeroes after the radix point if the first nonzero digit has not yet been reached). Of course, the sequence is still infinite and cannot be written down, but we may write any finite portion. The
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            may be represented exactly by a bar over a list of digits that repeats infinitely. (It is a theorem that every non-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-adic rational number can be uniquely represented in this way; in fact, only rational numbers can be so represented.) A subscript may be used to indicate the base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            (with a default base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 10
                %annotation{:encoding => "application/x-tex"} 10
            in practice). Finally, a negative real number is written by writing its
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            after a minus sign.
          %h2#decimal_radix_notation_and_real_numbers Decimal radix notation and real numbers
          %p
            Mathematician and Usenet legend
            = succeed "," do
              %span.newWikiWord
                Alexander Abian
                %a{:href => "/nlab/new/Alexander+Abian"} ?
            = succeed "." do
              %a{:href => "#Abian1981"} Abian 1981
          %p
            There is a similar definition that is also commonly used in presentations of the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            to elementary students: first of the
            %a.existingWikiWord{:href => "/nlab/show/irrational+numbers"} irrational numbers
            as the non-repeating infinite sequence of decimal digits, and then the real numbers as consisting of the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            and the irrational numbers (e.g.
            = succeed "," do
              %a{:href => "#Nicholas92"} Nichols 1992
            = succeed ")." do
              %a{:href => "#Marecek20"} Marecek 2020
          %p
            More formally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            be the set of
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 9]
            denote the
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            in the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            of all natural numbers between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 9
                %annotation{:encoding => "application/x-tex"} 9
            inclusive. Infinite decimals representations are elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 9
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times [0, 9]^\mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i, d)
            consists of an integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and a sequence of digits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(n)
            in the infinite decimal representation. The
            %a.existingWikiWord{:href => "/nlab/show/series"} series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %mi i
                  %mo +
                  %mfrac
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mn 10
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                %annotation{:encoding => "application/x-tex"} \sum_{n = 0}^\infty i + \frac{d(n)}{10^{n + 1}}
          %p
            can be shown to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
          %p
            The set of repeating infinite decimal representations is the subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo ×
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times [0, 9]^\mathbb{N}
            such that for pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i, d)
            in the subset, there exist natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and positive natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that the sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi m
                  %mo .
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo +
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda m.d(m + k)
            factors through the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi m
                  %mo .
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo +
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 9
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \lambda m.d(m + k):\mathbb{N} \to \mathbb{Z}/n\mathbb{Z} \to [0, 9]
          %p
            Two infinite decimal representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i, d)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (j, e)
            are said to be
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apart from
            each other if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≠
                  %mi j
                %annotation{:encoding => "application/x-tex"} i \neq j
            or there exists a natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi e
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(n) \neq e(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is said to be strictly non-repeating if it is apart from every repeating base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            infinite radix expansion. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕁
                %annotation{:encoding => "application/x-tex"} \mathbb{J}
            be the set of strictly non-repeating infinite decimal representations. These are referred to as the
            %a.existingWikiWord{:href => "/nlab/show/irrational+numbers"} irrational numbers
            in the prealgebra and high school algebra literature. Then the set of real numbers is the (
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"}> disjoint
            )
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕁
                  %annotation{:encoding => "application/x-tex"} \mathbb{J}
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/analytic+LPO"} analytic LPO
            when irrational is defined strictly in the sense of being
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} apart from
            the rational numbers, and equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/analytic+WLPO"} analytic WLPO
            when irrational is defined weakly in the sense of the negation of equality with any rational number.
          %p In addition, not every strictly irrational number is the limit of the series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %mi i
                  %mo +
                  %mfrac
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mn 10
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                %annotation{:encoding => "application/x-tex"} \sum_{n = 0}^\infty i + \frac{d(n)}{10^{n + 1}}
          %p
            given by a strictly non-repeating infinite decimal representation. However, it is still the case that strictly irrational numbers which are also a
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+number"} Cauchy real number
            are interdefinable with strictly non-repeating infinite decimal representation.
          %h2#generalizations Generalizations
          %p
            Given any number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            (not necessarily a natural number), still called the
            = succeed "," do
              %em base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            of numbers, whose elements are called
            = succeed "," do
              %em digits
            = succeed ")." do
              %em places
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            as part of its data (since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            may not be one of the digits), so the places are all (or perhaps only some) of the integers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mi N
                  %annotation{:encoding => "application/x-tex"} i \geq N
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mi N
                    %mn ∞
                  %msub
                    %mi a
                    %mi i
                  %msup
                    %mi n
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                %annotation{:encoding => "application/x-tex"} \sum_{i=N}^\infty a_i n^{-i}
          %p still converges to a real number.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            is a natural number and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \gt 1
            is any real number and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} ⌈
                    %mi n
                    %mo{:stretchy => "false"} ⌉
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\lceil{n}\rceil]
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/lexicographic+ordering"} lexicographic ordering
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq 2
            is a natural number and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} [n] + 1 = \{1, 2, 3, \ldots, n - 1, n\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            unless we allow the
            %a.existingWikiWord{:href => "/nlab/show/empty+list"} empty list
            of digits). If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is again
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} [n] + 1 = \{1\}
            %a.existingWikiWord{:href => "/nlab/show/shift"} shift
            of place; this is called
            = succeed "." do
              %strong tally notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n \geq 3
            is a natural number and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a set of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            consecutive integers that includes both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n = 3
            and so
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D = \{-1, 0, 1\}
            = succeed ");" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 1/3
            %strong balanced
            radix notation.
          %h2#examples Examples
          %p Here are some representations of well-known real numbers in well-known radixes:
          %table
            %tr
              %th Number
              %th
                Decimal (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 10
                    %annotation{:encoding => "application/x-tex"} n = 10
                ,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 10
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} D = [10]
              %th
                Binary (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n = 2
                ,
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} D = \{0, 1\}
              %th
                Positive binary (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n = 2
                ,
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} D = \{1, 2\}
              %th
                Natural (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mi{:mathvariant => "normal"} e
                    %annotation{:encoding => "application/x-tex"} n = \mathrm{e}
                ,
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} D = \{0, 1, 2\}
              %th
                Ternary (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n = 3
                ,
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} D = \{0, 1, 2\}
              %th
                Balanced ternary (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} n = 3
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo ,
                        %mn 0
                        %mo ,
                        %mn 1
