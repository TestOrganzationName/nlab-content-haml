                      %mi ϕ
                  %mi I
                  %mo ×
                  %mi I
                  %mo ,
                %annotation{:encoding => "application/x-tex"} C \stackrel{pair}{\to} C \times C \stackrel{\phi \times \phi}{\to} I \times I,
          %p
            denoted say
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
