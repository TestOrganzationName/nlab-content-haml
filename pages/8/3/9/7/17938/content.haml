                              %mo{:stretchy => "false"} )
                              %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mrow
                              %mo |
                              %mi t
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mi g
