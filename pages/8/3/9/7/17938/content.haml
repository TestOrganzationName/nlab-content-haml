                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi I
                  %mo ×
                  %mi I
                %annotation{:encoding => "application/x-tex"} f: I \to I \times I
            by linear interpolation: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} x \in I
            belongs to one of the open intervals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
