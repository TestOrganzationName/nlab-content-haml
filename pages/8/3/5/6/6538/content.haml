              = succeed "," do
                %a{:href => "http://books.google.com/books/about/Kac_algebras_and_duality_of_locally_comp.html?id=U6e6aD1gj3oC"} gBooks
              %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1215933"} MR94e:46001
            %li
