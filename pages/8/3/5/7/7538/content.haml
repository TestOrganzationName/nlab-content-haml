                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_{C \circ \phi} f \mathrm{d}s = \int_C f \mathrm{d}s ,
          %p the reparametrisation theorem.
          %p
            We cannot interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            as the differential of anything; rather,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            is the magnitude of the line integral element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \mathrm{d}\vec{r}
            from the previous section. In particular, identifying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{r}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            again, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo ≔
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ‖
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}s \coloneqq \int_a^b f(\vec{r}(t)) {\|\vec{r}'(t)\|} \,\mathrm{d}t ,
          %p
            so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            seems to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} {\|\vec{r}'(t)\|} \,\mathrm{d}t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            to change the
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi t
                %annotation{:encoding => "application/x-tex"} \mathrm{d}t
            to the pseudo-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            \-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi{:mathvariant => "normal"} d
                      %mi t
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\mathrm{d}t|}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi s
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi{:mathvariant => "normal"} d
                      %mover
                        %mi r
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}s = {\|\mathrm{d}\vec{r}\|}
          %p
            But for this to really make sense, we have to see what kind of object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            is on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em
              %a.existingWikiWord{:href => "/nlab/show/absolute+differential+form"} absolute
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %em unoriented
            curve. If we interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \mathrm{d}\vec{r}
            as the canonical vector-valued
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi{:mathvariant => "normal"} d
                    %mover
                      %mi r
                      %mo{:stretchy => "false"} →
                    %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s = {\|\mathrm{d}\vec{r}\|}
            is literally true.
          %p
            It would be nice to have notation without fake differentials and with the one piece of structure that actually plays a role: the metric. If we multiply two
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/symmetric+product"} symmetric product
            (instead of the
            %a.existingWikiWord{:href => "/nlab/show/exterior+product"} exterior product
            as usual for differential forms), then we get a symmetric
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            is the metric
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi s
                %annotation{:encoding => "application/x-tex"} \mathrm{d}s
            is positive, we can reasonably call it the
            %em principal
            %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %msqrt
                    %mi g
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}s = \int_C f \sqrt{g}
          %p defines the line integral of a scalar field along an unoriented curve in a Riemannian manifold.
          %p
            On a
            = succeed "-Riemannian" do
              %em pseudo
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            itself may not be positive and so may not have a square root. In that case, we can take the absolute value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            first and use
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %msqrt
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi g
                      %mo{:stretchy => "false"} |
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}s = \int_C f \sqrt{|g|} ,
          %p
            although this is most intuitive for curves that are consistently
            %a.existingWikiWord{:href => "/nlab/show/timelike+curve"} timelike
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacelike+curve"} spacelike
            %a.existingWikiWord{:href => "/nlab/show/purely+imaginary+number"} imaginary
            arclength; which one depends on conventions. In any case, a line integral along a
            %a.existingWikiWord{:href => "/nlab/show/lightlike+curve"} lightlike curve
            is zero.
          %h3#contour_integral_of_a_complex_function Contour integral of a complex function
          %p
            Classically, we have the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} f\colon \mathbb{C} \to \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/continuously+differentiable+map"} continuously differentiable map
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} C\colon [a,b] \to \mathbb{C}
            %strong
              %a.existingWikiWord{:href => "/nlab/show/contour+integral"} contour integral
            (or
            %strong line integral
            again) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo ≔
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}z \coloneqq \int_a^b f(C(t)) C'(t) \,\mathrm{d}t ,
          %p
            where the integral on the right is a
            %a.existingWikiWord{:href => "/nlab/show/Riemann+integral"} Riemann integral
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            is the
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi e
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi\colon [e,f] \to [a,b]
            is a continuously differentiable
            %a.existingWikiWord{:href => "/nlab/show/monotone+function"} increasing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi C
                      %mo ∘
                      %mi ϕ
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_{C \circ \phi} f \mathrm{d}z = \int_C f \mathrm{d}z ,
          %p the reparametrisation theorem.
          %p
            We start to justify the classical notation by interpreting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            as the same map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} [a,b] \to \mathbb{C}
            as
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                  %mo ≔
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi z
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}z \coloneqq \int_a^b f(z(t)) z'(t) \,\mathrm{d}t ,
          %p
            in which case the classical notation seems again to be suppressing some of the notation in the formal definition. In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} \mathrm{d}z
            is interpreted as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} z'(t) \,\mathrm{d}t
          %p
            But again, we should really be looking at differential forms. We may identify the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            with the
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            and so identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            with a
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is only serving to parametrise the curve, it should be interpreted as the
            %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} \mathrm{d}z
            is a
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} f \mathrm{d}z
            is a
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given up to an increasing reparametrisation, it is an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            = succeed "-submanifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} \int_C f \mathrm{d}z
          %p
            literally as the integral of a
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be given by a continuously differentiable parametrisation; the vector-valued
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is continuously differentiable regardless, and so we only need
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to be a
            %span.newWikiWord
              rectifiable curve
              %a{:href => "/nlab/new/rectifiable+curve"} ?
            (although it is a theorem that such a curve must have a continuously differentiable parametrisation after all).
          %h3#absolute_contour_integral_of_a_complex_function Absolute contour integral of a complex function
          %p
            Classically, we have the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℂ
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} f\colon \mathbb{C} \to \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/continuously+differentiable+map"} continuously differentiable map
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} C\colon [a,b] \to \mathbb{C}
            %strong absolute contour integral
            (or whatever one calls it) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi C
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f {|\mathrm{d}z|} \coloneqq \int_a^b f(C(t)) {|C'(t)|} \,\mathrm{d}t ,
          %p
            where the integral on the right is a
            %a.existingWikiWord{:href => "/nlab/show/Riemann+integral"} Riemann integral
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            is the
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi e
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi\colon [e,f] \to [a,b]
            is a continuously differentiable
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            (whether increasing or decreasing), then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %mi C
                      %mo ∘
                      %mi ϕ
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo =
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_{C \circ \phi} f {|\mathrm{d}z|} = \int_C f {|\mathrm{d}z|} ,
          %p the reparametrisation theorem.
          %p
            As before, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is interpreted as the same map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} [a,b] \to \mathbb{C}
            as
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo ≔
                  %msubsup
                    %mo ∫
                    %mi a
                    %mi b
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi z
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi t
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \int_C f {|\mathrm{d}z|} \coloneqq \int_a^b f(z(t)) {|z'(t)|} \,\mathrm{d}t ,
          %p
            so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|\mathrm{d}z|}
            seems to mean
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} {|z'(t)|} \,\mathrm{d}t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            to change the
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi t
                %annotation{:encoding => "application/x-tex"} \mathrm{d}t
            to the pseudo-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            \-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi{:mathvariant => "normal"} d
                      %mi t
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|\mathrm{d}t|}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|\mathrm{d}z|}
            is the absolute value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} \mathrm{d}z
            from before.
          %p
            Of course, we should really be looking at differential forms. Again,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            is the
            %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi z
                %annotation{:encoding => "application/x-tex"} \mathrm{d}z
            is a
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|\mathrm{d}z|}
            is a (positive definite)
            %a.existingWikiWord{:href => "/nlab/show/absolute+form"} absolute
            = succeed "-form," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} f {|\mathrm{d}z|}
            is a (more general) absolute
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given up to an arbitrary reparametrisation, it is an unoriented
            = succeed "-submanifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi C
                  %mi f
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \int_C f {|\mathrm{d}z|}
          %p
            literally as the integral of an absolute
            = succeed "-form." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p This is actually a special case of the line integral of a scalar field, since
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi x
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi y
                    %mo{:stretchy => "false"} |
                  %mo =
                  %msqrt
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} d
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} d
                      %mi y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mn 2
                  %mo =
                  %msqrt
                    %mi g
                  %mo =
                  %mi{:mathvariant => "normal"} d
                  %mi s
                  %mo ,
                %annotation{:encoding => "application/x-tex"} {|\mathrm{d}z|} = {|\mathrm{d}(x + \mathrm{i}y)|} = {|\mathrm{d}x + \mathrm{i} \,\mathrm{d}y|} = \sqrt{(\mathrm{d}x)^2 + (\mathrm{d}y)^2} = \sqrt{g} = \mathrm{d}s ,
          %p
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi y
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathrm{d}x^2 + \mathrm{d}y^2
            is the standard metric on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %h2#properties Properties
          %h3#cauchys_theorems Cauchy’s theorems
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+integral+formula"} Cauchy integral formula
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+integral+theorem"} Cauchy integral theorem
          %h2#references References
          %p Here are a couple of old Usenet posts that explain how line integrals of scalar fields should be viewed in terms of forms and pseudoforms.
          %ul
            %li
              %a{:href => "https://groups.google.com/group/sci.physics.research/msg/2774cbbc982e200e?dmode=source"} first
            %li
              %a{:href => "https://groups.google.com/group/sci.physics.research/msg/424da828e75b6b90?dmode=source"} second
          %p
