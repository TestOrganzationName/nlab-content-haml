                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                then
                %a{:href => "#ucta"} UCT1
                holds.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Atiyah"} Atiyah
                gives a method in
                %a{:href => "#Ati62"} Ati62
                for
                %a{:href => "#ktc"} KT3
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
