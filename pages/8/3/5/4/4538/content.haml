                        %mo =
                        %mi S
                      %annotation{:encoding => "application/x-tex"} E = S
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
