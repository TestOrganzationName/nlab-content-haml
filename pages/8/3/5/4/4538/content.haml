                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                finite complexes.
          %h4#a_special_case A Special Case
          %p
            In both
            %a{:href => "#Ada69"} Ada69
            and
            = succeed "," do
              %a{:href => "#Ada74"} Ada74
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            = succeed ")" do
              %a{:href => "#Ati62"} Ati62
          %p
          #adams_assumption.num_theorem
            %h6 Assumption
            %p
              %em
                (Condition 13.3 in
                = succeed "," do
                  %a{:href => "#Ada74"} Ada74
                = succeed ")" do
                  %a{:href => "#Ada69"} Ada69
            %p
              The spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+limit"} direct limit
              of finite spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi α
                  %annotation{:encoding => "application/x-tex"} E_\alpha
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi D
                    %msub
                      %mi E
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(D E_\alpha)
              is
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                  %annotation{:encoding => "application/x-tex"} E_*
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi D
                    %msub
                      %mi E
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %msub
                          %mi E
                          %mo *
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi D
                    %msub
                      %mi E
                      %mi α
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F^*(D E_\alpha) \to \Hom^*_{E_*}(E_*(D E_\alpha), F_*)
            %p
              is an isomorphism for all
              %a.existingWikiWord{:href => "/nlab/show/module-spectra"} module-spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %msub
                      %mi E
                      %mi α
                  %annotation{:encoding => "application/x-tex"} D E_\alpha
              is the
              %a.existingWikiWord{:href => "/nlab/show/S-dual"} S-dual
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mi α
                    %annotation{:encoding => "application/x-tex"} E_\alpha
            %p
          %p
            The main difference between the two treatments is that in
            = succeed "," do
              %a{:href => "#Ada69"} Ada69
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is stated for a
            %em single
            module-spectrum, not for
            %em all
            module-spectra, and there are alternatives for homology (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_*(-)
            ) and cohomology (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^*(-)
            ).
          %p
            In the comments following Assumption 20 in
            = succeed "," do
              %a{:href => "#Ada69"} Ada69
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            which makes no reference to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a ring spectrum, this reduces to:
          %ol
            %li
              The spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi α
                    %mo ;
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^*(E_\alpha; E^*) \Rightarrow E^*(E_\alpha)
              is trivial, and
            %li
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mi α
                    %mo ;
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^p(E_\alpha; E^*)
              is projective as an
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
          %p With this assumption, Adams shows the following result:
          #uctholds.num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a ring spectrum satisfying Assumption
              = succeed "." do
                %a.maruku-ref{:href => "#adams_assumption"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be a module-spectrum over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.maruku-ref{:href => "#uctb"}
              holds, and the spectral sequence is convergent.
          %p
            What “convergent” means here is spelled out in
            = succeed "." do
              %a{:href => "#Ada74"} Ada74, Theorem 8.2
          %p
          #uctproj.num_cor
            %h6 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be a ring spectrum satisfying Assumption
              = succeed "." do
                %a.maruku-ref{:href => "#adams_assumption"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X)
              is projective over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E_*
              %a.maruku-ref{:href => "#uctb"}
              collapses at the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E^2
              term. That is,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %msub
                          %mi E
                          %mo *
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F^*(X) \to \Hom^*_{E_*}(E_*(X),F_*)
            %p is an isomorphism.
          %p
            In
            = succeed "," do
              %a{:href => "#Ada74"} Ada74
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(-)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H\mathbb{Z}_p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MO
                  %annotation{:encoding => "application/x-tex"} MO
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MU
                  %annotation{:encoding => "application/x-tex"} MU
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MSp
                  %annotation{:encoding => "application/x-tex"} MSp
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KO
                  %annotation{:encoding => "application/x-tex"} KO
          %h4#freeness_and_flatness Freeness and Flatness
          %p
            In
            %a{:href => "#BJW95"} BJW95
            and
            %a{:href => "#Boa95"} Boa95
            there are various versions of the universal coefficient theorems and Künneth theorems which are stated and proved (or indications given on how to prove) under assumptions of either
            %a.existingWikiWord{:href => "/nlab/show/free+module"} freeness
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/flat+module"} flatness
          %p
            Here, we shall gather together all the statements made. In all the following,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^*(-)
            is a multiplicative generalised cohomology theory with representing ring spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_*(-)
            for the associated homology theory. Following
            %a{:href => "#Boa95"} Boa95
            and
            = succeed "," do
              %a{:href => "#BJW95"} BJW95
            %em not
            reduced in this section.
          #homkun.num_theorem
            %h6#theorem_4 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 4.2
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(Y)
              is a free or flat
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\times \colon E_*(X) \otimes E_*(Y) \to E_*(X \times Y),
            %p
              induces the Künneth isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X \times Y) \cong E_*(X) \otimes E_*(Y)
              in homology.
          %p The next result relates homology and cohomology.
          #strdual.num_theorem
            %h6#theorem_5 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 4.14
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X)
              is a free
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has strong duality, i.e. the duality map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \colon E^*(X) \to D E_*(X)
              is a homeomorphism between the profinite topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X)
              and the dual-finite topology on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %msub
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D E_*(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X)
              is complete Hausdorff.
          %p Combining these two gives the Künneth theorem for cohomology.
          #cokun.num_theorem
            %h6#theorem_6 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 4.19
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(Y)
              are free
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⊗
                      %mo ^
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X \times Y) \cong E^*(X) \widehat{\otimes} E^*(Y)
              in cohomology.
          %p
            There are similar results for spectra. Boardman, Johnson, and Wilson write reduced homology and cohomology as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi o
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_*(X,o)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X,o)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a spectrum (and so the reduced theories are all that there are).
          #homkunsp.num_theorem
            %h6#theorem_7 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 9.20
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X,o)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(Y,o)
              is a free or flat
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \times \colon E_*(X,o) \otimes E_*(Y,o) \to E_*(X \wedge Y,o)
              is an isomorphism in homology.
          #strdusp.num_theorem
            %h6#theorem_8 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 9.25
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X,o)
              is a free
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has strong duality, i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \colon E^*(X,o) \to D E_*(X,o)
              is a homeomorphism between the profinite topology on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X,o)
              and the dual-finite topology on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %msub
                        %mi E
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi o
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D E_*(X,o)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^*(X,o)
              is complete Hausdorff.
          #cokunsp.num_theorem
            %h6#theorem_9 Theorem
            %p
              (
              %a{:href => "#Boa95"}> Boa95, 9.31
              ) Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(X,o)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_*(Y,o)
              are free
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E^*
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⊗
                      %mo ^
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ,
                    %mi o
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\times \colon E^*(X,o) \widehat{\otimes} E^*(Y,o) \to E^*(X \wedge Y,o)
            %p induces the cohomology Künneth homeomorphism.
          %h2#examples Examples
          %h3#InTopology For singular cohomology
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mi X
                %annotation{:encoding => "application/x-tex"} Sing X
            for its
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi N
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet(X)
                  \\coloneqq
                  N \mathbb{Z}[Sing X]
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
            of the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
            obtained by forming degreewise the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_\bullet(X)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            some
            %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(X,A)
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            with coefficients in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Comparison with the ordinary universal coefficient theorem
            %a.maruku-ref{:href => "#OrdinaryStatementInCohomology"}
            shows that:
          #OrdinaryStatementInTopology.num_theorem
            %h6#theorem_10 Theorem
            %p
              %strong (universal coefficient theorem in topology)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \geq 1 \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              and
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              fit into a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Ext^1(H_{n-1}(X), A)
                    \\longrightarrow
                    H^n(X,A)
                    \\longrightarrow
                    Hom_{Ab}(H_n(X), A)
                    \\to
                    0
                    \\,.
          #UniversalCoefficientTheoremInRationalCohomology.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
            %p
              For
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/Ext+groups"} Ext groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ;
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext^1(-;\mathbb{Q})
              vanish, and hence the
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              identifies
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} groups
              with the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              of the
              %a.existingWikiWord{:href => "/nlab/show/rational+vector+space"} rational vector space
              of rational
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mi ℤ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %msub
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet
                    \\big(
                    \-; \, \mathbb{Q}
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    Hom_{\mathbb{Z}}
                    \\Big(
                    H_\bullet\big(-;\,\mathbb{Q} \big);
                    \\,
                    \\mathbb{Q}
                    \\Big)
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "rational+homotopy+theory#Moerman15"} Moerman 15, Cor. 1.2.1
