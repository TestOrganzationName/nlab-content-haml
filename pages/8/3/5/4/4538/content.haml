                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_{*}
                is
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo *
                    %annotation{:encoding => "application/x-tex"} E_{*}
                then
                %a{:href => "#ucta"} UCT1
                holds, whence
                %a{:href => "#kta"} KT1
                holds if either
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
