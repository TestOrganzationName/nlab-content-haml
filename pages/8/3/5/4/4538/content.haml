          %h2#idea Idea
          %p
            The
            %em universal coefficient theorem
            states how
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            determines
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            with arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            (of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            (the
            = succeed ")," do
              %em coefficient field
            %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_p(C,F)
            and the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^p(C,F)
            are indeed related by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dualization"} dualization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^p(C,F) \simeq Hom_F(H_p(C,F), F)
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            but an arbitrary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "-group." do
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            = succeed "." do
              %em
                %a{:href => "#InCohomology"} For ordinary cohomology
          %p
            Dually, again if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a field then there is an isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi F
                  %mo ≃
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(C) \otimes F \simeq H_n(C \otimes F)
            and for more general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            this is corrected by a
            = succeed "-group." do
              %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            = succeed "." do
              %em
                %a{:href => "#InHomology"} For ordinary homology
          %p
            More generally, under suitable conditions there are universal coefficient theorems that relate
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            to the dual of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            = succeed "." do
              %em
                %a{:href => "#ForGeneralizedCohomology"} For generalized cohomology
          %p
            There is also a version of the theorem for Kasparov’s
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            = succeed "." do
              %a{:href => "#ReferencesForKK"} references
          %h2#statement Statement
          %h3#InCohomology For ordinary cohomology
          %h4#in_terms_of_homology In terms of homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            be a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an arbitrary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          %p Write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo •
                      %mo ≔
                      %msub
                        %mi Hom
                        %mi Ab
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\bullet \coloneqq Hom_{Ab}(C_\bullet, A)
                for the dual
                %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                with respect to
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n(C)
                for the
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} C_\bullet
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^n(C,A)
                for the
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} C^\bullet
                hence for the cochain cohomology of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} C_\bullet
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
          .num_remark
            %h6#remark Remark
            %p
              There is a canonical morphism of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{(-)}(-) : H^n(C,A) \to Hom_{Ab}(H_n(C,\mathbb{Z}), A)
            %p
              given by sending a
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              to
              %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
              of that cocycle on a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/chain"} chain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ω
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %mi σ
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mo ∫
                        %mi σ
                      %mi ω
                      %mo ≔
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    [\omega] \mapsto
                    \\left( [\sigma] \mapsto \int_{\sigma} \omega \coloneqq \omega(\sigma) \right)
          #OrdinaryStatementInCohomology.num_theorem
            %h6#theorem Theorem
            %p
              %strong (universal coefficient theorem in ordinary cohomology)
            %p
              The morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is surjective and its
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is the
              %a.existingWikiWord{:href => "/nlab/show/Ext+group"} Ext group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ext^1(H_{n-1}(C, \mathbb{Z}), A)
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to
                    Ext^1(H_{n-1}(C), A)
                    \\to
                    H^n(C, A)
                    \\to
                    Hom_{Ab}(H_n(C), A)
                    \\to
                    0
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to
                    Ext^1(H_{n-1}(C), A)
                    \\to
                    H^n(Hom_{Ab}(C_\bullet,A))
                    \\to
                    Hom_{Ab}(H_n(C), A)
                    \\to
                    0
            %p
              Moreover, this sequence
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splits
              (non-canonically).
          %p
            We reproduce the direct proof given for instance in (
            %a{:href => "#Boardman"}> Boardman
            ).
          #LemmaForUCTInOrdinaryCohomology.num_lemma
            %h6#lemma Lemma
            %p
              Given a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi A
                      %mn 2
                    %mover
                      %mo →
                      %mi g
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} A_1 \stackrel{f}{\to} A_2 \stackrel{g}{\to} A_3
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              together with a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %msub
                      %mi A
                      %mn 3
                    %mo →
                    %msub
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} s : A_3 \to A_2
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi coker
                    %mi f
                    %mover
                      %mo →
                      %mrow
                        %mi g
                        %mo ′
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to coker f \stackrel{g'}{\to} coker(g \circ f) \to coker(g) \to 0
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Since we work in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              appearing here (as discussed there) may be expressed as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotients"} quotients
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} coker(f) \simeq A_2/im(f)
            %p
              The sequence of inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi A
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} im(g \circ f) \hookrightarrow im(g) \hookrightarrow A_3
              induces the canonical
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mfrac
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mfrac
                      %mrow
                        %msub
                          %mi A
                          %mn 3
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mfrac
                      %mrow
                        %msub
                          %mi A
                          %mn 3
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\frac{im(g)}{im(g \circ f)}
                    \\to
                    \\frac{A_3}{im(g \circ f)}
                    \\to
                    \\frac{A_3}{im(g)}
                    \\to
                    0
            %p
              and we claim that this is already isomorphic to the one stated in the lemma. This is manifestly true for the two terms on the right. For the term on the left observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              induces a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ′
                      %mo :
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi A
                        %mn 3
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∘
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g' : A_2 / im(f) \to A_3 / im(g \circ f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              this has itself a retract. Moreover it factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                    %mo :
                    %msub
                      %mi A
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi A
                      %mn 3
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ∘
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g' : A_2/im(f) \to im(g)/im(g \circ f) \hookrightarrow A_3/ im(g \circ f)
                    \\,.
            %p Therefore the first morphism here on the left has to be an isomorphism, too.
          .proof
            %h6#proof_of_theorem_
              Proof (of theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryStatementInCohomology"}
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to B_n \to Z_n \to H_n \to 0
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
              is assumed to be a
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Z_n
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Nielsen-Schreier+theorem"} Nielsen-Schreier theorem
              %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              of the group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                    %annotation{:encoding => "application/x-tex"} H_n
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ext^1(H_n,A)
              is characterized by the short exact sequence
            #eq:ExtES.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(Z_n, A) \to Hom(B_n,A) \to Ext^1(H_n,A) \to 0
                    \\,.
            %p Notice also that the short exact sequence
            #eq:ChainCycleBoundarySES.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mover
                      %mo →
                      %mo ∂
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_n \to C_n \stackrel{\partial}{\to} B_{n-1} \to 0
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              because, as before,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} B_{n-1}
              is free abelian. Using these two exact sequences on the left and right of the short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_n/B_n \to C_n/B_n \to C_n/Z_n \to 0
            %p shows that this is equivalent to
            #eq:HomologyBoundariesSES.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mover
                      %mo →
                      %mo ∂
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to H_n \to C_n/B_n \stackrel{\partial}{\to} B_{n-1}
                    \\,.
            %p
              Again this splits as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} B_{n-1}
              is free abelian.
            %p In addition to these exact sequence consider the decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %msub
                      %mi C
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Z
                      %mi n
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\partial
                    \:
                    C_n
                    \\to
                    C_n/B_n
                    \\to
                    C_n/Z_n
                    \\stackrel{\simeq}{\to}
                    B_{n-1}
                    \\hookrightarrow
                    Z_{n-1}
                    \\hookrightarrow
                    C_{n-1}
            %p
              and apply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(-,A)
              to obtain the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi H
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi B
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi i
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mi n
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi B
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Hom
                                  %mo{:stretchy => "false"} (
                                  %mover
                                    %mo ∂
                                    %mo{:stretchy => "false"} ¯
                                  %mo ,
                                  %mi A
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo ←
                          %mtd
                            %msup
                              %mi Ext
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi H
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ←
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi B
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo ←
                          %mtd
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Z
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; 0
                    \\\
                    \&amp;&amp; &amp;&amp; \uparrow
                    \\\
                    \&amp;&amp; &amp;&amp; Hom(H_n,A)
                    \\\
                    \&amp;&amp; &amp;&amp; \uparrow
                    \\\
                    Hom(B_n,A) &amp;\leftarrow&amp; Hom(C_n,A)
                    \&amp;\stackrel{i}{\leftarrow}&amp;
                    Hom(C_n/B_n,A)
                    \&amp;\leftarrow&amp;
                    0
                    \&amp;&amp;
                    0
                    \\\
                    \&amp;&amp; &amp;&amp; \uparrow^{\mathrlap{Hom(\bar \partial,A)}}
                    \&amp;&amp; &amp;&amp; \uparrow
                    \\\
                    0 &amp;\leftarrow&amp; Ext^1(H_n,A) &amp;\leftarrow&amp; Hom(B_{n-1},A)
                    \&amp;&amp; \leftarrow &amp;&amp;
                    Hom(Z_{n-1},A)
                    \\\
                    \&amp;&amp; &amp;&amp; \uparrow &amp;&amp; \nwarrow &amp;&amp; \uparrow
                    \\\
                    \&amp;&amp; &amp;&amp; 0 &amp;&amp; &amp;&amp; Hom(C_{n-1},A)
                    }
            %p
              Here the right vertical sequence is exact, because
              %a.maruku-eqref{:href => "#eq:ChainCycleBoundarySES"} (2)
              splits, and the left vertical sequence is exact because
              %a.maruku-eqref{:href => "#eq:HomologyBoundariesSES"} (3)
              splits. The upper horizontal sequence is exact because the
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
              takes
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              to
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              and finally the lower horizontal sequence is the exact sequence
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ExtES"} (1)
            %p
              Since therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ¯
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom(\bar \partial,A)
              are monomorphisms, it follows that the degree
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ≔
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Z^{n-1} \coloneqq ker( Hom(C_{n-1},A) \to Hom(C_n,a) )
                    \\simeq
                    ker( Hom(C_{n-1},A) \to Hom(B_{n-1}, A) )
                    \\,.
            %p
              Using this for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n-1
              replaced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              shows by the upper horizontal exact sequence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mi n
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Z^n = Hom( C_n/B_n, A)
                    \\,.
            %p
              Similarly the
              %a.existingWikiWord{:href => "/nlab/show/coboundaries"} coboundaries
              are seen to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi n
                    %mo ≔
                    %mi im
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B^n \coloneqq im Hom(\partial,A) \simeq
                    im ( Hom(Z_{n-1}, A) \to Hom(C_n/B_n), A )
                    \\,.
            %p Together this gives the cochain cohomology as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi B
                      %mi n
                    %mo ≃
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Z
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n(C,A) \coloneqq Z^n / B^n
                    \\simeq
                    coker ( Hom(Z_n, A) \to Hom( C_n/B_n, A ) )
                    \\,.
            %p
              Now the universal coefficient theorem follows by going into lemma
              %a.maruku-ref{:href => "#LemmaForUCTInOrdinaryCohomology"}
              with the identifications
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                      %mo =
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Z
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_1 = Hom(Z_{n-1}, A)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 2
                      %mo =
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi B
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_2 = Hom(B_{n-1}, A)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 3
                      %mo =
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi B
                        %mi n
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_3 = Hom(C_n/B_n,A)
          %h4#UCTForOrdinaryCohomologyInTermsOfCohomology In terms of cohomology
          %p There is also a UCT relating cohomology to cohomology:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be chain complexes of
            %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            over a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            which is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mn 1
                %annotation{:encoding => "application/x-tex"} N_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mn 2
                %annotation{:encoding => "application/x-tex"} N_2
            be
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Tor
                        %mi R
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mn 1
                      %mo ,
                      %msub
                        %mi N
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Tor_R(N_1,N_2) = 0
                (the
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
                group of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} N_1
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} N_2
                vanishes);
            %li
              %p
                at least one of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %msub
                        %mi N
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^\bullet(A,N_1)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %msub
                        %mi N
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^\bullet(B,N_2)
                is of
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
          %p
            then there are
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %munder
                    %mo ⊕
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo =
                      %mi n
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi N
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %mi B
                  %mo ,
                  %msub
                    %mi N
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi Tor
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi N
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0
                  \\to
                  \\underset{p+q = n}{\oplus} H^p(A,N_1) \otimes H^q(B,N_2)
                  \\longrightarrow
                  H^n(A \otimes B, N_1 \otimes N_2)
                  \\longrightarrow
                  Tor(H^\bullet(A,N_1), H^\bullet(B,N_2))
                  \\to
                  0
          %p
            (
            %a{:href => "#Spanier66"}> Spanier 66, section 5.5, theorem 11
            )
          %h3#InHomology For ordinary homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet \in Ch_\bullet(Ab)
            be a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} A \in
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            be any abelian group. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ⊗
                  %mi A
                %annotation{:encoding => "application/x-tex"} C_\bullet \otimes A
            etc. for the degreewise
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            which is a
            %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
            (in the above
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
            is the ring of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ∈
                  %msub
                    %mi Ch
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mi Mod
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet \in Ch_\bullet(R Mod)
            be a chain complex of
            %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi R
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} A \in R Mod
            be any
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi k
                  %msub
                    %mo ⊗
                    %mi R
                  %mi A
                %annotation{:encoding => "application/x-tex"} C_k \otimes_R A
            for the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          #TheoremInOrdinaryHomology.num_theorem
            %h6#theorem_2 Theorem
            %p
              For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi R
                    %mi A
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %msub
                      %mo ⊗
                      %mi R
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi Tor
                      %mn 1
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    H_n(C_\bullet) \otimes_R A
                    \\to
                    H_n(C_\bullet \otimes_R A)
                    \\to
                    Tor_1^{R Mod}(H_{n-1}(C_\bullet), A)
                    \\to
                    0
                    \\,
            %p
              where on the right we have the first
              = succeed "-module" do
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{n-1}(C_\bullet)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .num_remark
            %h6#remark_2 Remark
            %p
              A fairly direct generalization of this statement and its proof is the
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
              in ordinary homology, see at
              = succeed "." do
                %em
                  %a{:href => "http://ncatlab.org/nlab/show/K%C3%BCnneth+theorem#InOrdinaryHomology"} Künneth theorem - In ordinary homology
          %p
            We spell out a proof along the lines for instance given in (
            %a{:href => "#Hatcher"}> Hatcher, 3.A
            ) or (
            %a{:href => "#Chen"}> Chen, section 3
            ).
          #LongSequenceForHomologyWithCoefficients.num_lemma
            %h6#lemma_2 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mo ⊗
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mi n
                        %mo ⊗
                        %mi A
                    %msub
                      %mi Z
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⊗
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ⊗
                        %mi A
                    %msub
                      %mi Z
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to B_n \otimes A \stackrel{i_n \otimes A}{\to} Z_n \otimes A \to H_n(C_\bullet \otimes A) \to B_{n-1} \otimes A \stackrel{i_{n-1}\otimes A}{\to} Z_{n-1} \otimes A \to \cdots
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n
              are the
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Z_n
              the
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mi n
                    %mo ↪
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i_n \colon B_n \hookrightarrow Z_n
              is the canonical inclusion.
          .proof
            %h6#proof_2 Proof
            %p
              Since, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dedekind-Nielsen-Schreier+theorem"} Dedekind-Nielsen-Schreier theorem
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of a
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              is itself free abelian, such as the subgroup of
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mi n
                      %mo ↪
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Z_n \hookrightarrow C_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we have a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splitting
              of the
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 0 \to Z_n \to C_n \to B_{n-1}
              and hence (as discussed at
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mo ≃
                    %msub
                      %mi Z
                      %mi n
                    %mo ⊕
                    %msub
                      %mi B
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_n \simeq  Z_n \oplus B_{n-1}
                    \\,.
            %p
              Here the second direct summand on the right identifies under the differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \partial^C
              with the
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              in one degree lower, since by construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \partial^C
              is injective on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi Z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} C_n/Z_n
            %p
              Accordingly, if we regard the graded abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} B_\bullet
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Z_\bullet
              as chain complexes with vanishing
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %a.existingWikiWord{:href => "/nlab/show/chain+maps"} chain maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                    %mo ↪
                    %msub
                      %mi C
                      %mo •
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_\bullet \hookrightarrow C_\bullet \to B_{\bullet-1} \to 0
            %p
              which is degreewise a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              distributes over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (-)\otimes A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                    %mo ⊗
                    %mi A
                    %mo ↪
                    %msub
                      %mi C
                      %mo •
                    %mo ⊗
                    %mi A
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⊗
                    %mi A
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to Z_\bullet \otimes A \hookrightarrow C_\bullet \otimes A \to B_{\bullet-1} \otimes A \to 0
            %p
              is still a short exact sequence. The induced
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homology+long+exact+sequence"} homology long exact sequence
          .proof
            %h6#proof_3 Proof
            %p
              %strong
                of theorem
                %a.maruku-ref{:href => "#TheoremInOrdinaryHomology"}
            %p
              By lemma
              %a.maruku-ref{:href => "#LongSequenceForHomologyWithCoefficients"}
              we have
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    coker(i_n \otimes A)
                    \\to
                    H_n(C_\bullet \otimes A)
                    \\to
                    ker(i_n \otimes A)
                    \\to
                    0
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              it preserves
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mo =
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    coker(i_n \otimes A) \simeq coker(i_n) \otimes A = H_n(C) \otimes A
                    \\,.
            %p
              The dual statement were true if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (-)\otimes A
              were also a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              = succeed "-group:" do
                %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
            %p
              Notice that by assumption and by the
              %a.existingWikiWord{:href => "/nlab/show/Dedekind-Nielsen-Schreier+theorem"} Dedekind-Nielsen-Schreier theorem
              the defining
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi Z
                      %mi n
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to B_n \stackrel{i_n}{\to} Z_n \to H_n(C_\bullet) \to  0
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mo →
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\cdots \to 0 \to B_n \to Z_n] \stackrel{\simeq_{qi}}{\to} H_n(C)
              as a
              %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n(C_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/Tor"} Tor
              the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tor_1(H_n(C_\bullet), A)
              is the chain homology in degree 1 of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ⋯
                    %mo →
                    %mn 0
                    %mo →
                    %msub
                      %mi B
                      %mi n
                    %mo ⊗
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mi n
                        %mo ⊗
                        %mi A
                    %msub
                      %mi Z
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\cdots \to 0 \to B_n \otimes G \stackrel{i_n \otimes A}{\to} Z_n \otimes A]
                    \\,,
            %p which is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Tor
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tor_1(H_n(C_\bullet), A)
                    \\simeq
                    ker(i_n \otimes A)
                    \\,.
          #sectiona.num_section
          %h3#ForGeneralizedCohomology For generalised cohomology theories
          %p
            The situation for
            %a.existingWikiWord{:href => "/nlab/show/generalised+cohomology+theories"} generalised cohomology theories
            is much more complicated than that for ordinary cohomology due to the fact that it is harder (or impossible!) to use the tools of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            %a{:href => "#Ada69"} Ada69
            (for use in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            = succeed "." do
              %a{:href => "#Ada74"} Ada74, III.13
            %a{:href => "#Ada69"} Ada69
            is worth quoting in its entirety as motivation for this study.
          %blockquote
            %p It is an established practice to take old theorems about ordinary homology, and generalise them so as to obtain theorems about generalised homology theories. For example, this works very well for duality theorems about manifolds. We may ask the following question. Take all those theorems about ordinary homology which are standard results in every day use. Which are the ones which still lack a fully satisfactory generalisation to generalised homology theories? I want to devote this lecture to such problems.
            %p
              %em{:style => "text-align: right"} J. F. Adams
          %p
            The lecture concentrates on the Universal Coefficient Theorem and, as a by-product, the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo *
                %annotation{:encoding => "application/x-tex"} E^*
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F^*
            be two
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theories"} generalized cohomology theories
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo *
                %annotation{:encoding => "application/x-tex"} E_*
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo *
                %annotation{:encoding => "application/x-tex"} F_*
            two
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology+theories"} generalized homology theories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %ol
            %li
              %p
              #enumiAa.num_enuma
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_{*}(X)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_{*}(X)
            %li
              %p
              #enumiAb.num_enuma
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_{*}(X)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^{*}(X)
            %li
              %p
              #enumiAc.num_enuma
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^{*}(X)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_{*}(X)
            %li
              %p
              #enumiAd.num_enuma
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^{*}(X)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^{*}(X)
          %p
            In
            = succeed "," do
              %a{:href => "#Ada69"} Ada69
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E^{*}(-)
            is the
            %a.existingWikiWord{:href => "/nlab/show/generalised+cohomology+theory"} generalised cohomology theory
            associated to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectrum"} commutative ring spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^{*}(-)
            is assumed to come from a left
            %a.existingWikiWord{:href => "/nlab/show/module-spectrum"} module-spectrum
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is itself a ring spectrum. Following Adams, we shall also assume that all our cohomology and homology theories are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced
          %p There are two statements that one would like to hold. These are not themselves theorems, rather the theorem would say “Under certain conditions, these statements hold”. The statements are the following.
          %p
          #ucta.num_theorem
            %h6 Statement
            %p
              %em (UCT1)
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Tor
                      %mrow
                        %mi p
                        %mo ,
                        %mo *
                      %mrow
                        %msub
                          %mi E
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⇒
                      %mrow
                        %mi p
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Tor_{p,*}^{E_{*}} (E_{*}(X), F_{*}) \xRightarrow[p]{}    F_{*}(X)
            %p with edge homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi E
                          %mo *
                    %msub
                      %mi F
                      %mo *
                    %mo →
                    %msub
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_{*}(X) \otimes _{E_{*}} F_{*} \to F_{*}(X).
            %p
          %p
          #uctb.num_theorem
            %h6 Statement
            %p
              %em (UCT2)
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Ext
                      %mrow
                        %msub
                          %mi E
                          %mo *
                      %mrow
                        %mi p
                        %mo ,
                        %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⇒
                      %mrow
                        %mi p
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Ext_{E_{*}}^{p,*} (E_{*}(X), F^{*}) \xRightarrow[p]{}    F^{*}(X)
            %p with edge homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                      %mrow
                        %msub
                          %mi E
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi F
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^{*}(X) \to \Hom_{E_{*}} (E_{*}(X), F^{*}).
            %p
          %p
            For finite
            %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            then we can derive two further statements from the above by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mi X
                %annotation{:encoding => "application/x-tex"} D X
            for the
            %a.existingWikiWord{:href => "/nlab/show/Spanier-Whitehead+dual"} Spanier-Whitehead dual
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            For a finite CW-complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a{:href => "#ucta"} UCT1
            and
            %a{:href => "#uctb"} UCT2
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mi X
                %annotation{:encoding => "application/x-tex"} D X
            in place of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and then use the various isomorphisms relating the cohomologies of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
