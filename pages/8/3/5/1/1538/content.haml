                %annotation{:encoding => "application/x-tex"} \rho : \mathbf{B}^k U(1) \to k Vect_{\mathbb{C}}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
