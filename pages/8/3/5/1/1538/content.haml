                    \\tau_k [\Pi(X_{n-k}), \mathbf{B}^n U(1)]
                    \\simeq
                    \\mathbf{B}^k U(1)
          .proof
            %h6#proof Proof
            %p
              By general abstract reasoning (recalled at
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_i[\Pi(X_{n-k}),\mathbf{B}^n U(1)]
                    \\simeq
                    H^{n-i}(X_{n-k}, U(1))
                    \\,.
            %p
              Now use the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Ext^1(H_{n-i-1}(X_{n-k},\mathbb{Z}),U(1))
                    \\to
                    H^{n-i}(X_{n-k},U(1))
                    \\to
                    Hom(H_{n-i}(X_{n-k},\mathbb{Z}),U(1))
                    \\to 0
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              is an
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1(-,U(1))=0
                    \\,.
            %p
              Together this means that we have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^{n-i}(X_{n-k},U(1))
                    \\simeq
                    Hom_{Ab}(H_{n-i}(X_{n-k},\mathbb{Z}),U(1))
            %p
              that identifies the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
              in question with the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              from the integral
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
              group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} X_{n-k}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo &lt;
                      %mi k
                    %annotation{:encoding => "application/x-tex"} i\lt k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi for
                    %mi i
                    %mo &lt;
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_i[\Pi(X_{n-k}),\mathbf{B}^n U(1)]=0 \;\;\;\;
                    for i\lt k
                    \\,.
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} i=k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mrow
                          %mi n
                          %mo −
                          %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H_{n-i}(X_{n-k},\mathbb{Z})\simeq \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} X_{n-k}
              is a closed
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-k)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_k[\Pi(X_{n-k}),\mathbf{B}^n U(1)]\simeq U(1)
                    \\,.
          .num_prop
            %h6#remark Remark
            %p
              Another proof of the isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n-k}(X_{n-k},U(1))\cong U(1)
              and of the identities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H^{n-i}(X_{n-k},U(1))=0
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &lt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i\lt k
              can be obtained as follows. Consider the short exact sequence of locally constant sheaves of abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mo →
                    %mi ℝ
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0\to \mathbb{Z}\to \mathbb{R}\to U(1)\to 1.
            %p This induces a long exact sequence in cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to H^{n-i-1}(X_{n-k},U(1))\to H^{n-i}(X_{n-k},\mathbb{Z})\to H^{n-i}(X_{n-k},\mathbb{R}) \to H^{n-i}(X_{n-k},U(1))\to H^{n-i+1}(X_{n-k},\mathbb{Z})\to \cdots
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &lt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i\lt k
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H^{n-i}(X_{n-k},U(1))=0
              by dimensional reasons, while for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i=k
              we find the exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to H^{n-k}(X_{n-k},\mathbb{Z})\to H^{n-k}(X_{n-k},\mathbb{R}) \to H^{n-k}(X_{n-k},U(1))\to 0.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} X_{n-k}
              is a closed oriented manifold, we have
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^{n-k}(X_{n-k},\mathbb{Z})=\mathbb{Z}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} H^{n-k}(X_{n-k},\mathbb{R})=\mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n-k}(X_{n-k},\mathbb{Z})\to H^{n-k}(X_{n-k},\mathbb{R})
              is the inclusion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mi k
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mi ℝ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                      %mo ≅
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
