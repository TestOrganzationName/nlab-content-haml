            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/highly+structured+ring+spectra"} highly structured ring spectra
            %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} seminar
            we consider applications to
            %a.existingWikiWord{:href => "/nlab/show/cobordism+theory"} cobordism theory
            and
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
            such as to converge in the end to a glimpse of the modern picture of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chromatic+homotopy+theory"} chromatic homotopy theory
