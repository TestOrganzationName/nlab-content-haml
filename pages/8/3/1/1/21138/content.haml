              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
                  ,
                  %em K-Theory Torsion
                  \&amp;lbrack;
                  %a{:href => "https://arxiv.org/abs/hep-th/0005103"}> arXiv:hep-th/0005103
                  \&amp;rbrack;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Ilka+Brunner"}> Ilka Brunner
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"} Jacques Distler
                  = succeed "," do
                    %em Torsion D-Branes in Nongeometrical Phases
                  %strong 5
                  (2002) 265-309 [
                  %a{:href => "https://doi.org/10.4310/ATMP.2001.v5.n2.a3"}> doi:10.4310/ATMP.2001.v5.n2.a3
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0102018"} arXiv:hep-th/0102018
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Ilka+Brunner"}> Ilka Brunner
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jacques+Distler"} Jacques Distler
                  = succeed "," do
                    %em Return of the Torsion D-Branes
                  %strong 5
                  (2002) 311-352 [
                  %a{:href => "https://doi.org/10.4310/ATMP.2001.v5.n2.a4"}> doi:10.4310/ATMP.2001.v5.n2.a4
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0106262"} arXiv:hep-th/0106262
            %p
              Review of D-branes charge seen in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            %ul
              %li#Szabo
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"}> Richard Szabo
                ,
                = succeed "," do
                  %em D-branes and bivariant K-theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0809.3029"} arXiv:0809.3029
            %p based on
            %ul
              %li#ReisSzabo05
                %p
                  Rui Reis,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
                  %em Geometric K-Homology of Flat D-Branes
                  , Commun. Math. Phys.
                  %strong 266
                  (2006) 71-122 &amp;lbrack;
                  %a{:href => "https://arxiv.org/abs/hep-th/0507043"}> arXiv:hep-th/0507043
                  \&amp;rbrack;
              %li#BrodzkiMathaiRosenbergSzabo06
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jacek+Brodzki"}> Jacek Brodzki
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
                  = succeed "," do
                    %em D-Branes, RR-Fields and Duality on Noncommutative Manifolds
                  %strong 277
                  (2008) 643-706
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/hep-th/0607020"} arXiv:hep-th/0607020
                  %a{:href => "https://doi.org/10.1007/s00220-007-0396-y"} doi:10.1007/s00220-007-0396-y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li#BMRS2
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jacek+Brodzki"}> Jacek Brodzki
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
                  = succeed "," do
                    %em Noncommutative correspondences, duality and D-branes in bivariant K-theory
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/0708.2648"} arXiv:0708.2648
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jacek+Brodzki"}> Jacek Brodzki
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
                  = succeed "," do
                    %em D-branes, KK-theory and duality on noncommutative spaces
                  %strong 103
                  012004 (2008)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/0709.2128"} arXiv:0709.2128
                  %a{:href => "https://doi.org/10.1088/1742-6596/103/1/012004"} doi:10.1088/1742-6596/103/1/012004
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %p
              In particular (
              %a{:href => "#BMRS2"}> BMRS2
              ) discusses the definition and construction of D-brane charge as a generalized
              %a.existingWikiWord{:href => "/nlab/show/index"} index
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              and hence
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
              is in
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"}> Richard Szabo
                ,
                = succeed "," do
                  %em D-Branes, Tachyons and K-Homology
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0209210"} arXiv:hep-th/0209210
            %h4#DBraneChargeInKTheoryReferencesConceptualProblems Conceptual problems
            %p#KTheorySubtleties But there remain conceptual issues with the proposal that D-brane charge is in K-theory, as highlighted in
            %ul
              %li#BDHKMMS01
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jan+de+Boer"}> Jan de Boer
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"} Robbert Dijkgraaf
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Kentaro+Hori"} Kentaro Hori
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Arjan+Keurentjes"} Arjan Keurentjes
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/David+Morrison"} David Morrison
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"} Savdeep Sethi
                  = succeed "," do
                    %em Triples, Fluxes, and Strings
                  %strong 4
                  (2002) 995-1186 [
                  %a{:href => "https://arxiv.org/abs/hep-th/0103170"}> arXiv:hep-th/0103170
                  ,
                  = succeed "]" do
                    %a{:href => "https://www.intlpress.com/site/pub/files/_fulltext/journals/atmp/2000/0004/0005/ATMP-2000-0004-0005-a001.pdf"} pdf
              %li#Evslin06
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Jarah+Evslin"}> Jarah Evslin
                  , section 8 of:
                  = succeed "," do
                    %em What Does(n’t) K-theory Classify?
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0610328"} arXiv:hep-th/0610328
            %p
              In particular, actual checks of the proposal that D-brane charge is given by K-theory, via concrete computation in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/boundary+conformal+field+theory"} boundary conformal field theory
            %ul
              %li#FredenhagenQuella05
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Stefan+Fredenhagen"}> Stefan Fredenhagen
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Thomas+Quella"} Thomas Quella
                  = succeed "," do
                    %em Generalised permutation branes
                  = succeed "," do
                    %a{:href => "https://arxiv.org/abs/hep-th/0509153"} arXiv:hep-th/0509153
                  = succeed "]" do
                    %a{:href => "https://iopscience.iop.org/article/10.1088/1126-6708/2005/11/004"} doi:10.1088/1126-6708/2005/11/004
                %blockquote
                  %p It might surprise that despite all the progress that has been made in understanding branes on group manifolds, there are usually not enough D-branes known to explain the whole charge group predicted by (twisted) K-theory. […] it is fair to say that a satisfactory answer is still missing.
            %p
              The closest available towards an actual check of the argument for K-theory via
              %a.existingWikiWord{:href => "/nlab/show/Sen%27s+conjecture"} open superstring tachyon condensation
              (
              %a{:href => "#Witten98"}> Witten 98, Section 3
              ) seems to be
            %ul
              %li#Erler13
                %a.existingWikiWord{:href => "/nlab/show/Theodore+Erler"}> Theodore Erler
                ,
                = succeed "," do
                  %em Analytic Solution for Tachyon Condensation in Berkovits’ Open Superstring Field Theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/JHEP11(2013)007"} doi:10.1007/JHEP11(2013)007
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/1308.4400"} arXiv:1308.4400
            %p
              which, however, concludes (on
              = succeed ")" do
                %a{:href => "https://arxiv.org/pdf/1308.4400.pdf#page=33"} p. 32
            %blockquote
              %p
                It would also be interesting to see if these developments can shed light on the long-speculated relation between string field theory and the K-theoretic description of D-brane charge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "D-brane#DBraneChargeQuantizationInTopologicalKTheory"} 75, 76, 77
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
            %p See also
            %ul
              %li#Erler19
                %a.existingWikiWord{:href => "/nlab/show/Theodore+Erler"}> Theodore Erler
                ,
                %em Four Lectures on Analytic Solutions in Open String Field Theory
                (
                %a{:href => "https://arxiv.org/abs/1912.00521"}> arXiv:1912.00521
                ,
                = succeed ")" do
                  %a{:href => "https://inspirehep.net/literature/1768105"} spire:1768105
            %p
              which still lists (on
              = succeed ")" do
                %a{:href => "https://arxiv.org/pdf/1912.00521.pdf#page=113"} p. 112
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
            %blockquote
              %p “Are there topological invariants of the open string star algebra representing D-brane charges?”
            %h4#for_orbifolds_in_equivariant_ktheory For orbifolds in equivariant K-theory
            %p#ChargeInEquivariantKTheory
              The proposal that D-brane charge on
              %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
              is measured in
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              (
              %a.existingWikiWord{:href => "/nlab/show/orbifold+K-theory"}> orbifold K-theory
              ) goes back to
            %ul
              %li
                %a{:href => "#Witten98"} Witten 98, section 5.1
            %p It was pointed out that only a subgroup of equivariant K-theory can be physically relevant in
            %ul
              %li#BDHKMMS01
                %a.existingWikiWord{:href => "/nlab/show/Jan+de+Boer"}> Jan de Boer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"} Robbert Dijkgraaf
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kentaro+Hori"} Kentaro Hori
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Arjan+Keurentjes"} Arjan Keurentjes
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Morgan"} John Morgan
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Morrison"} David Morrison
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"} Savdeep Sethi
                = succeed "," do
                  %em Triples, Fluxes, and Strings
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0103170"} arXiv:hep-th/0103170
            %p
              Further discussion of
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
              for D-branes on
              %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
              includes the following:
            %ul
              %li
                %p
                  Hugo García-Compeán,
                  = succeed "," do
                    %em D-branes in orbifold singularities and equivariant K-theory
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/9812226"} arXiv:hep-th/9812226
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Gaberdiel"}> Matthias Gaberdiel
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bogdan+Stefanski"} Bogdan Stefanski
                  = succeed "," do
                    %em Dirichlet Branes on Orbifolds
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/9910109"} arXiv:hep-th/9910109
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"}> Igor Kriz
                  , Leopoldo A. Pando Zayas, Norma Quiroz,
                  = succeed "," do
                    %em Comments on D-branes on Orbifolds and K-theory
                  %strong 23
                  (2008) 933-974 [
                  %a{:href => "https://arxiv.org/abs/hep-th/0703122"}> arXiv:hep-th/0703122
                  ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"}> Richard Szabo
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Alessandro+Valentino"} Alessandro Valentino
                  = succeed "," do
                    %em Ramond-Ramond Fields, Fractional Branes and Orbifold Differential K-Theory
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/0710.2773"} arXiv:0710.2773
            %p
              Discussion of
              %a.existingWikiWord{:href => "/nlab/show/real+K-theory"} real K-theory
              for D-branes on
              %a.existingWikiWord{:href => "/nlab/show/orientifolds"} orientifolds
              includes the following:
            %p
              The original observation that
              %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
              for
              %a.existingWikiWord{:href => "/nlab/show/orientifolds"} orientifolds
              should be in
              %a.existingWikiWord{:href => "/nlab/show/KR-theory"} KR-theory
              is due to
            %ul
              %li
                %a{:href => "#Witten98"} Witten 98, section 5
            %p and was then re-amplified in
            %ul
              %li#Gukov99
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                  ,
                  = succeed "," do
                    %em K-Theory, Reality, and Orientifolds
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/9901042"} arXiv:hep-th/9901042
              %li#BergmanGimonSugimoto01
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Oren+Bergman"}> Oren Bergman
                  , E. Gimon,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Shigeki+Sugimoto"} Shigeki Sugimoto
                  = succeed "," do
                    %em Orientifolds, RR Torsion, and K-theory
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0103183"} arXiv:hep-th/0103183
            %p With further developments in
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Murray"} Michael Murray
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Stevenson"} Daniel Stevenson
                = succeed "," do
                  %em Type I D-branes in an H-flux and twisted KO-theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0310164"} arXiv:hep-th/0310164
            %p
              Discussion of orbi-orienti-folds using
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant
              %a.existingWikiWord{:href => "/nlab/show/KO-theory"} KO-theory
              is in
            %ul
              %li
                %p
                  N. Quiroz,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bogdan+Stefanski"} Bogdan Stefanski
                  = succeed "," do
                    %em Dirichlet Branes on Orientifolds
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0110041"} arXiv:hep-th/0110041
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bogdan+Stefanski"} Bogdan Stefanski
                  %em Orientifolds and K-theory
                  (
                  %a{:href => "https://arxiv.org/abs/hep-th/0206158"}> arXiv:hep-th/0206158
                  )
              %li
                %p
                  H. Garcia-Compean, W. Herrera-Suarez, B. A. Itza-Ortiz, O. Loaiza-Brito,
                  = succeed "," do
                    %em D-Branes in Orientifolds and Orbifolds and Kasparov KK-Theory
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/0809.4238"} arXiv:0809.4238
            %p
              Discussion of the alleged K-theory classification of D-brane charge in relation to the
              %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
              is in
            %ul
              %li#DMW00
                %a.existingWikiWord{:href => "/nlab/show/Duiliu-Emanuel+Diaconescu"}> Duiliu-Emanuel Diaconescu
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gregory+Moore"} Gregory Moore
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 8
                        %annotation{:encoding => "application/x-tex"} E_8
                    Gauge Theory, and a Derivation of K-Theory from M-Theory
                = succeed ")," do
                  %a{:href => "http://arxiv.org/abs/hep-th/0005090"} arXiv:hep-th/0005090
                %em A Derivation of K-Theory from M-Theory
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0005091"}> arXiv:hep-th/0005091
                )
            %p See also
            %ul
              %li#GarciaUranga05
                Inaki Garcia-Etxebarria,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"} Angel Uranga
                = succeed "," do
                  %em From F/M-theory to K-theory and back
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0510073"} arXiv:hep-th/0510073
            %p
              More complete discussion of
              %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
              of the
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
              in 11d to the expected
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              and
              %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
              %a.existingWikiWord{:href => "/nlab/show/flux"} flux
              forms in 10d:
            %ul
              %li#MathaiSati03
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                  = succeed "," do
                    %em
                      Some Relations between Twisted K-theory and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi E
                              %mn 8
                          %annotation{:encoding => "application/x-tex"} E_8
                      Gauge Theory
                  = succeed ")" do
                    %a{:href => "http://arxiv.org/abs/hep-th/0312033"} arXiv:hep-th/0312033
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/schreiber/show/Rational+sphere+valued+supercocycles+in+M-theory+and+type+IIA+string+theory"} Rational sphere valued supercocycles in M-theory and type IIA string theory
                  = succeed "," do
                    %a{:href => "http://arxiv.org/abs/1606.03206"} arXiv:1606.03206
                  = succeed ")" do
                    %a{:href => "http://dx.doi.org/10.1016/j.geomphys.2016.11.024"} doi:10.1016/j.geomphys.2016.11.024
        .revisedby
