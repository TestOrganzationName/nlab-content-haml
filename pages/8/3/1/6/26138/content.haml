          %h3#inference_rules Inference rules
          %p
            The inference rules for forming two-type identity types and terms are as follows. First the inference rule that defines the two-type identity type itself, as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p Formation rule for two-type identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi B
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi e
                      %mo :
                      %mi A
                      %mo ≃
                      %mi B
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi x
                      %mo :
                      %mi A
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi y
                      %mo :
                      %mi B
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash B \; \mathrm{type} \quad \Gamma \vdash e:A \simeq B \quad \Gamma \vdash x:A \quad \Gamma \vdash y:B}{\Gamma \vdash \mathrm{Id}_{A, B}(e, a, b) \; \mathrm{type}}
          %p Now the basic “introduction” rule, which says that everything is equal to itself in a canonical way.
          %p Introduction rule for two-type identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi x
                      %mo :
                      %mi A
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} trefl
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %mi A
                          %mo ,
                          %mi A
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma \vdash x:A}{\Gamma \vdash \mathrm{trefl}_{A}(x):\mathrm{Id}_{A, A}(\mathrm{id}_A, x, x)}
          %p Next we have the “elimination” rule:
          %p Elimination rule for two-type identity types:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mtr
