                %annotation{:encoding => "application/x-tex"} \mathrm{Id}_{T(A), T(B)}(\mathrm{transport}_U(A, B, p), x, y) \simeq \mathrm{hId}_{X:U.T(X)}(A, B, p, x, y)
          %p
            One could treat
            %a.existingWikiWord{:href => "/nlab/show/Russell+universes"} Russell universes
            as a
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            whose type family is represented by the zero-width whitespace instead of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
