                          %mo :
                          %mi A
                          %mo ,
                          %mi y
                          %mo :
                          %mi B
                          %mo ,
                          %mi q
                          %mo :
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mrow
                              %mi A
                              %mo ,
                              %mi B
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo ,
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo ⊢
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi e
                          %mo ,
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi{:mathvariant => "normal"} type
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi t
                          %mo :
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mi x
                              %mo :
                              %mi A
                          %mi C
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi{:mathvariant => "normal"} Id
                            %mi A
                          %mo ,
                          %mi x
