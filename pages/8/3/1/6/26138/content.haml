                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi Γ
                          %mo ⊢
                          %mi e
                          %mo :
                          %mi A
                          %mo ≃
                          %mi B
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi x
                          %mo :
                          %mi A
                          %mspace{:width => "1em"}
                          %mi Γ
                          %mo ⊢
                          %mi y
