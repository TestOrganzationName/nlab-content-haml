          %h2#idea Idea
          %p
            A
            %em hypercover
            is the generalization of a
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
            of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of an object obtained by iteratively applying covering families.
          %h2#definition Definition
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ↪
                    %mover
                      %mo ←
                      %mi L
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (L \dashv i) : Sh(C) \stackrel{\overset{L}{\leftarrow}}{\hookrightarrow}
                  PSh(C)
          %p
            be the
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            defining a
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(C)
            into a
            %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
          #CoskeletonDefinition.num_defn
            %h6#definition_2 Definition
            %p A morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mover
                      %mo →
                      %mi f
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"}
                    (Y \stackrel{f}{\to} X) \in PSh(C)^{\Delta^{op}}
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(C)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              %strong hypercover
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %msub
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi cosk
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    Y_{n} \to (\mathbf{cosk}_{n-1} Y)_n \times_{(\mathbf{cosk}_{n-1} X)_n} X_n
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(C)
              are
              %a.existingWikiWord{:href => "/nlab/show/local+epimorphisms"} local epimorphisms
              (in other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a “
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy
              local-epimorphism”).
            %p
              Here this morphism into the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              is that induced from the
              %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{cosk}_{n-1} Y &amp;\longrightarrow&amp; \mathbf{cosk}_{n-1} X
                    }
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit
              of the
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi cosk
                        %mi n
                      %mo :
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo →
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_n : PSh(C)^{\Delta^{op}} \to PSh(C)^{\Delta^{op}}
            %p
              A hypercover is called
              %strong bounded
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \geq n
              the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi k
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi cosk
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi k
                    %msub
                      %mi X
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Y_{k} \to (\mathbf{cosk}_{k-1} Y)_k \times_{(\mathbf{cosk}_{k-1} X)_k} X_k
              are
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              The smallest
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              for which this holds is called the
              %strong height
              of the hypercover.
          #SplitHypercover.num_defn
            %h6#definition_3 Definition
            %p
              A hypercover that also satisfies the
              %a{:href => "model+structure+on+simplicial+presheaves#CofibrantObjects"} cofibrancy condition
              in the projective
              %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
              in that
            %ol
              %li
                %p
                  it is simplicial-degree wise a
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              %li
                %p
                  degenerate cells split off as a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} direct summand
            %p
              is called a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
          %p
            (
            %a{:href => "#DuggerHollanderIsaksen02"}> Dugger-Hollander-Isaksen 02, def. 4.13
            ) see also (
            %a{:href => "#Low"}> Low 14-05-26, 8.2.15
            )
          .num_remark
            %h6#remark Remark
            %p
              Definition
              %a.maruku-ref{:href => "#CoskeletonDefinition"}
              is equivalent to saying that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : Y \to X
              is a
              %em local
              acyclic fibration: for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              every lifting problem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %mo ⋅
                              %mi U
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %mo ⋅
                              %mi U
                            %mtd
                              %mo →
                            %mtd
                              %mi X
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mi U
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo →
                            %mtd
                              %mi X
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    \\partial \Delta[n] \cdot U &amp;\to&amp; Y
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    \\Delta[n]\cdot U &amp;\to&amp; X
                    }
                    \\right)
                    \\;\;\simeq
                    \\;\;
                    \\left(
                    \\array{
                    \\partial \Delta[n] &amp;\to&amp; Y(U)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f(U)}}
                    \\\
                    \\Delta[n] &amp;\to&amp; X(U)
                    }
                    \\right)
            %p
              has a solution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\sigma_i)
              after refining to some
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo :
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo →
                            %mtd
                              %mi Y
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∃
                                    %msub
                                      %mi σ
                                      %mi i
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi U
                                      %mi i
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo →
                            %mtd
                              %mi X
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\forall i :
                    \\left(
                    \\array{
                    \\partial \Delta[n] &amp;\to&amp; Y(U_i)
                    \\\
                    \\downarrow &amp;{}^{\mathllap{\exists \sigma_i}}\nearrow&amp; \downarrow^{\mathrlap{f(U_i)}}
                    \\\
                    \\Delta[n] &amp;\to&amp; X(U_i)
                    }
                    \\right)
                    \\,,
          %p
            (
            %a{:href => "#DuggerHollanderIsaksen02"}> Dugger-Hollander-Isaksen 02, prop. 7.2
            ).
          .num_remark
            %h6#remark_2 Remark
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              has
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
              a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : Y \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} Sh(C)^{\Delta^{op}}
              is a hypercover if all its
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          %p
            In this form the notion of hypercover appears for instance in (
            %a{:href => "#Brown73"}> Brown 73
            ).
          %p
            In some situations, we may be interested primarily in hypercovers that are built out of data entirely in the site
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to be a discrete simplicial object which is representable, and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi n
                %annotation{:encoding => "application/x-tex"} Y_n
            to be a coproduct of representables. This notion can equivalently be formulated in terms of diagrams
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (\Delta/A) \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is some simplicial set and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Delta/A)
            is its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplices"} category of simplices
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              Consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi const
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X = const X_0
              is simplicially constant. Then the conditions on a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              to be a hypercover is as follows.
            %ul
              %li
                %p
                  in degree 0:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Y
                          %mn 0
                        %mo →
                        %msub
                          %mi X
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} Y_0 \to X_0
                  is a local epimorphism.
              %li
                %p in degree 1: The commuting diagram in question is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi Y
                                  %mn 1
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi X
                                  %mn 0
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi diag
                            %mtr
                              %mtd
                                %msub
                                  %mi Y
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi Y
                                  %mn 0
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi X
                                  %mn 0
                                %mo ×
                                %msub
                                  %mi X
                                  %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        Y_1 &amp;\to&amp; X_0
                        \\\
                        \\downarrow &amp;&amp; \downarrow^{\mathrlap{diag}}
                        \\\
                        Y_0 \times Y_0 &amp;\to&amp; X_0 \times X_0
                        }
                        \\,.
                %p
                  Its
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Y
                            %mn 0
                          %mo ×
                          %msub
                            %mi Y
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mrow
                              %msub
                                %mi X
                                %mn 0
                              %mo ×
                              %msub
                                %mi X
                                %mn 0
                          %msub
                            %mi X
                            %mn 0
                          %mo ≃
                          %msub
                            %mi Y
                            %mn 0
                          %msub
                            %mo ×
                            %mrow
                              %msub
                                %mi X
                                %mn 0
                          %msub
                            %mi Y
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} (Y_0 \times Y_0)\times_{X_0 \times X_0} X_0 \simeq Y_0 \times_{X_0} Y_0
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                        %mo →
                        %msub
                          %mi Y
                          %mn 0
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi X
                              %mn 0
                        %msub
                          %mi Y
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} Y_1 \to Y_0 \times_{X_0} Y_0
                  is a local epimorphism.
              %li
                %p in degree 2: The commuting diagram in question is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi Y
                                  %mn 2
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi X
                                  %mn 0
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mi Id
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi Y
                                  %mn 1
                                %msub
                                  %mo ×
                                  %mrow
                                    %msub
                                      %mi Y
                                      %mn 0
                                %msub
                                  %mi Y
                                  %mn 1
                                %msub
                                  %mo ×
                                  %mrow
                                    %msub
                                      %mi Y
                                      %mn 0
                                %msub
                                  %mi Y
                                  %mn 1
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %msub
                                      %mo ×
                                      %mrow
                                        %msub
                                          %mi Y
                                          %mn 0
                                        %mo ×
                                        %msub
                                          %mi Y
                                          %mn 0
                                %msub
                                  %mi Y
                                  %mn 0
                              %mtd
                                %mo →
                              %mtd
                                %msub
                                  %mi X
                                  %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        Y_2 &amp;\to&amp; X_0
                        \\\
                        \\downarrow &amp;&amp; \downarrow^{Id}
                        \\\
                        (Y_1 \times_{Y_0} Y_1 \times_{Y_0}Y_1)_{\times_{Y_0 \times Y_0}}  Y_0
                        \&amp;\to&amp; X_0
                        }
                        \\,.
                %p So the condition is that the vertical morphism is a local epi.
              %li
                %p
                  Similarly, in any degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \geq 2
                  the condition is that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Y
                          %mi n
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi cosk
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                      %annotation{:encoding => "application/x-tex"}
                        Y_n \to (\mathbf{cosk}_{n-1} Y)_n
                %p is a local epimorphism.
          %h2#properties Properties
          %h3#existence_and_refinements Existence and refinements
          %h4#ech_nerves Čech nerves
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U = \{U_i \to X\}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(U) \to X
              is a hypercover of height 0.
          %h4#OverGeneralSites Over general sites
          #ExistenceOfSplitRefinements.num_prop
            %h6#proposition_2 Proposition
            %p
              Given any
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},J)
              and given a diagram of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi hcov
                        %mtr
                          %mtd
                            %mi X
                            %mo ′
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{hcov}}
                    \\\
                    X' &amp;\longrightarrow&amp; X
                    }
            %p
              where the vertical morphism is a hypercover, then there exists a completion to a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %mo ′
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi hcov
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi hcov
                        %mtr
                          %mtd
                            %mi X
                            %mo ′
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y' &amp;\longrightarrow&amp; Y
                    \\\
                    \\downarrow^{\mathrlap{hcov}} &amp;&amp; \downarrow^{\mathrlap{hcov}}
                    \\\
                    X' &amp;\longrightarrow&amp; X
                    }
            %p
              where the left vertical morphism is a split hypercover, def.
              = succeed "." do
                %a.maruku-ref{:href => "#SplitHypercover"}
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, K)\to (\mathcal{C},J)
              is a
              %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} Y'
              as above exists such that it is simplicial-degree wise a
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of (
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              by) objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Low"} Low 14-05-26, lemma 8.2.20
          .num_remark
            %h6#remark_3 Remark
            %p
              In particular taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ′
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X'\to X
              in prop.
              %a.maruku-ref{:href => "#ExistenceOfSplitRefinements"}
              to be an identity, the proposition says that every hypercover may be refined by a split hypercover.
          %p
            (see also
            = succeed ")" do
              %a{:href => "#Low"} Low 14-05-26, lemma 8.2.23
          %h4#OverVerdierSites Over Verdier sites
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Verdier+site"} Verdier site
              is a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              with finite
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/basis+for+a+Grothendieck+topology"} basis for a Grothendieck topology
              such that the generating
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_i \to X
              all have the property that their
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo ×
                      %mi X
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    U_i \to U_i \times_X U_i
            %p
              is also a generating covering. We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_i \to X
              is
              = succeed "." do
                %strong basal
          .num_example
            %h6#example_2 Example
            %p
              It is sufficient that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_i \to X
              are
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %p
              Examples include the standard
              = succeed "-topology" do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #BasalHypercover.num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong basal hypercover
              over a
              %a.existingWikiWord{:href => "/nlab/show/Verdier+site"} Verdier site
              is a hypercover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \to X
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the components of the maps into the matching object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi n
                    %mo →
                    %mi M
                    %msub
                      %mi U
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_n \to M U_n
              are basal maps, as above.
          .num_theorem
            %h6#theorem Theorem
            %p
              Over a Verdier site, every hypercover may be refined by a split (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SplitHypercover"}
              = succeed ")." do
                %a.maruku-ref{:href => "#BasalHypercover"}
          %p
            This is (
            %a{:href => "#DuggerHollanderIsaksen02"}> Dugger-Hollander-Isaksen 02, theorem 8.6
            ).
          %h3#HypercoverHomology Hypercover homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f : Y \to X
            be a hypercover. We may regard this as an object in the
            %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sh(C)/X
            %a{:href => "http://ncatlab.org/nlab/show/category+of+presheaves#RelWithOvercategories"} here
            this is equivalently
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C/X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ab(Sh(C/X))
            for the category of abelian
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C/X)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          %p
            Forming in the sheaf topos the
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            abelian group on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                %annotation{:encoding => "application/x-tex"} f_n
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo ∈
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \bar f \in Ab(Sh(C/X))^{\Delta}
            %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} normalized chain complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_\bullet(\bar f)
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : Y \to X
              a hypercover, the
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(\bar f)
              vanishes in positive degree and is the group of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ab
                      %mo{:stretchy => "false"} (
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ab(Sh(C)(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi p
                              %mo ≥
                              %mn 1
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi for
                              %mspace{:width => "thickmathspace"}
                              %mi p
                              %mo =
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_p(N(f)) \simeq
                    \\left\{
                    \\array{
                    0 &amp; for \; p \geq 1
                    \\\
                    \\mathbb{Z} &amp; for \; p = 0
                    }
                    \\right.
                    \\,.
          %h3#DescentAndCohomology Descent and cohomology
          %p
            The following theorem characterizes the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            = succeed "-condition" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
            of an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            by a
            %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
            in terms of descent along hypercovers.
          #DescentFromDescentAlongHypercovers.num_theorem
            %h6#theorem_2 Theorem
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} PSh(C)^{\Delta^{op}}
              an object is fibrant precisely if it is fibrant in the global
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              and in addition satisfies
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              along all hypercovers over representables that are degreewise
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
          %p
            This is the central theorem in (
            %a{:href => "#DuggerHollanderIsaksen02"}> Dugger-Hollander-Isaksen 02
            ).
          %p
            The following theorem is a corollary of this theorem, using the discussion at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (Verdier’s hypercovering theorem)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              a
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is given
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mrow
                        %mi Y
                        %mo →
                        %mi X
                    %msup
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Hom
                      %mi Sh
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Y
                      %mo •
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^q(X, F) \simeq {\lim_{\to}}_{Y \to X} H^q(Hom_{Sh}(Y^\bullet,F))
            %p
              by computing for each hypercover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \to X
              the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
              of the cosimplicial abelian group obtained by evaluating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              degreewise on the hypercover, and then taking the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of the result over the
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              of all hypercovers over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            A proof of this result in terms of the structure of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            on the category of simplicial presheaves appears in (
            %a{:href => "#Brown73"}> Brown 73, section 3
            ).
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/hypersheaf"} hypersheaf
          %h2#reference Reference
          %p
            The concept of hypercovers was introduced for
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Verdier"}> Jean-Louis Verdier
              , Exposé V, sect. 7 of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
          %p
            An early standard reference founding
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+homotopy+theory"} étale homotopy theory
            is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Artin"}> Michael Artin
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"} Barry Mazur
              %em Étale Homotopy
              , Lecture Notes in Mathematics 100, Springer- Verlag, Berline-Heidelberg-New York (1972).
          %p
            The modern reformulation of their notion of hypercover in terms of simplicial presheaves is mentioned for instance at the end of section 2, on
            %a{:href => "http://www.math.uwo.ca/~jardine/papers/Fields-01.pdf#page=6"} p. 6
            of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Frederick+Jardine"}> John Frederick Jardine
              ,
              %em Fields Lectures: Simplicial presheaves
              (
              %a{:href => "http://www.math.uwo.ca/~jardine/papers/Fields-01.pdf"}> pdf
              )
          %p
            A discussion of hypercovers of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            and relation to
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+homotopy+type"} étale homotopy type
            of
            %a.existingWikiWord{:href => "/nlab/show/smooth+schemes"} smooth schemes
            and
            %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"} A1-homotopy theory
            is in
          %ul
            %li#Isaksen01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"}> Daniel Isaksen
                ,
                = succeed "," do
                  %em
                    Étale realization of the
                    = succeed "-homotopy" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi 𝔸
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                = succeed ")" do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0495/"} K-theory archive
            %li#DuggerIsaksen05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"} Daniel Isaksen
                = succeed "," do
                  %em Hypercovers in topology
                = succeed "," do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0528/hypercover.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0528/"} K-Theory archive
          %p A discussion in a topos with enough points in in
          %ul
            %li#Brown73
              %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract homotopy theory and generalized sheaf cohomology
          %p
            A thorough discussion of hypercovers over representables and their role in
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            for simplicial presheaves is in
          %ul
            %li#DuggerHollanderIsaksen02
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sharon+Hollander"} Sharon Hollander
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Isaksen"} Daniel Isaksen
              = succeed "," do
                %em Hypercovers and simplicial presheaves
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/math/0205027"} arXiv:0205027
              = succeed ")" do
                %a{:href => "http://www.math.uiuc.edu/K-theory/0563/"} K-theory archive
          %p On the Verdier hypercovering theorem see
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} Abstract Homotopy Theory and Generalized Sheaf Cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Frederick+Jardine"}> John Frederick Jardine
                ,
                %em The Verdier hypercovering theorem
                (
                %a{:href => "https://www.cambridge.org/core/journals/canadian-mathematical-bulletin/article/verdier-hypercovering-theorem/13FA7ACF61C486C2FD5C06FFF6483562"}> doi
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Zhen+Lin+Low"}> Zhen Lin Low
                ,
                = succeed "," do
                  %em Cocycles in categories of fibrant objects
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1502.03925v3"} pdf
          %p Split hypercover refinement over general sites is discussed in
          %ul
            %li#Low
              %a.existingWikiWord{:href => "/nlab/show/Zhen+Lin+Low"}> Zhen Lin Low
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Notes+on+homotopical+algebra"} Notes on homotopical algebra
