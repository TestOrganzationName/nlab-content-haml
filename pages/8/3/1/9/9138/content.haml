                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/ground+state"}> ground state
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/excited+state"} excited state
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/quasi-free+state"} quasi-free state
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Fock+space"}> Fock space
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/second+quantization"} second quantization
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/vacuum"}> vacuum
                      ,
                      %a.existingWikiWord{:href => "/nlab/show/vacuum+state"} vacuum state
                    %ul
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/Hadamard+state"} Hadamard state
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/vacuum+diagram"} vacuum diagram
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/vacuum+expectation+value"}> vacuum expectation value
