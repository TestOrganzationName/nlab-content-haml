                        %p
                          %a.existingWikiWord{:href => "/nlab/show/quantum+reader+monad"} quantum reader monad
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/measurement+problem"} measurement problem
                      %li
                        %p
