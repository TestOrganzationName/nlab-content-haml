                    %mrow
                      %msub
                        %mi U
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %mi P
                      %mi Alg
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} U_0\colon P Alg \to Set
                picks out the set of objects, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} F_0
                is its left adjoint, which constructs the free
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n\gt 0
                %strong n-computad
                consists of an
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi P
                      %mi Alg
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi P
                      %msub
                        %mo ∂
                        %mi n
                      %mo ,
                      %msub
                        %mi F
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi GSet
                      %mo{:stretchy => "false"} (
                      %msub
                        %mo ∂
                        %mi n
                      %mo ,
                      %msub
                        %mi U
                        %mi P
                      %msub
                        %mi F
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} x\colon X\to P Alg(F_P \partial_n, F_{n-1} C) = GSet(\partial_n, U_P F_{n-1} C).
              %p
                We call
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the set of
                = succeed "." do
                  %strong n-cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                simply equips each
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mi C
                      %annotation{:encoding => "application/x-tex"} F_{n-1} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %msub
                        %mi Cptd
                        %mi P
                    %annotation{:encoding => "application/x-tex"} n Cptd_P
                is the
                %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi B
                          %mi n
                      %annotation{:encoding => "application/x-tex"} Set / B_n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi B
                          %mi n
                        %mo =
                        %mi P
                        %mi Alg
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi P
                        %msub
                          %mo ∂
                          %mi n
                        %mo ,
                        %msub
                          %mi F
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B_n = P Alg(F_P \partial_n, F_{n-1} -)
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %mi P
                      %mi Alg
                      %mo →
                      %mi n
                      %msub
                        %mi Cptd
                        %mi P
                    %annotation{:encoding => "application/x-tex"} U_n\colon P Alg \to n Cptd_P
                sends a
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to the
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mi A
                    %annotation{:encoding => "application/x-tex"} U_{n-1} A
                together with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                defined by the following pullback square in
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo →
                                %mrow
                            %mtd
                              %mi P
                              %mi Alg
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi F
                                %mi P
                              %msub
                                %mn 2
                                %mi n
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mi x
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi P
                              %mi Alg
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi F
                                %mi P
                              %msub
                                %mo ∂
                                %mi n
                              %mo ,
                              %msub
                                %mi F
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %msub
                                %mi U
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                            %mtd
                              %mi P
                              %mi Alg
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi F
                                %mi P
                              %msub
                                %mo ∂
                                %mi n
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{X &amp; \overset{}{\to} &amp; P Alg(F_P 2_n, A)\\
                      ^x \downarrow &amp;&amp; \downarrow\\
                      P Alg(F_P \partial_n, F_{n-1} U_{n-1} A) &amp; \underset{}{\to} &amp; P Alg(F_P \partial_n, A)}
              %p
                Here the bottom map is induced by the counit of the adjunction
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo ⊣
                        %msub
                          %mi U
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} F_{n-1}\dashv U_{n-1}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi n
                        %mo ↪
                        %msub
                          %mn 2
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \partial_n \hookrightarrow 2_n
            %li
              %p
                The left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi n
                    %annotation{:encoding => "application/x-tex"} F_n
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi n
                    %annotation{:encoding => "application/x-tex"} U_n
                is defined by taking an
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D = (C,X,x)
                to the following pushout in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mi Alg
                      %annotation{:encoding => "application/x-tex"} P Alg
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %mo ⋅
                              %msub
                                %mi F
                                %mi P
                              %msub
                                %mo ∂
                                %mi n
                            %mtd
                              %mover
                                %mo →
                                %mover
                                  %mi x
                                  %mo ¯
                            %mtd
                              %msub
                                %mi F
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %mi C
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi X
                              %mo ⋅
                              %msub
                                %mi F
                                %mi P
                              %msub
                                %mn 2
                                %mi n
                            %mtd
                              %munder
                                %mo →
                                %mrow
                            %mtd
                              %msub
                                %mi F
                                %mi n
                              %mi D
                    %annotation{:encoding => "application/x-tex"}
                      \\array{X\cdot F_P \partial_n &amp; \overset{\overline{x}}{\to} &amp; F_{n-1} C\\
                      \\downarrow &amp;&amp; \downarrow\\
                      X \cdot F_P 2_n &amp; \underset{}{\to} &amp; F_n D}
              %p
                Here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋅
                    %annotation{:encoding => "application/x-tex"} \cdot
                denotes a
                %a.existingWikiWord{:href => "/nlab/show/copower"} copower
                by a set, the top map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{x}
                is the
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∂
                          %mi n
                        %mo ↪
                        %msub
                          %mn 2
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \partial_n \hookrightarrow 2_n
          %p
            Finally, the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} \omega Cptd_P
            of
            = succeed "-computads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            of the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo →
                  %mn 2
                  %msub
                    %mi Cptd
                    %mi P
                  %mo →
                  %mn 1
                  %msub
                    %mi Cptd
                    %mi P
                  %mo →
                  %mn 0
                  %msub
                    %mi Cptd
                    %mi P
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} \dots \to 2 Cptd_P \to 1 Cptd_P \to 0 Cptd_P \to (-1) Cptd_P
          %p
            consisting of the functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %msub
                    %mi Cptd
                    %mi P
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} n Cptd_P \to (n-1)Cptd_P
            taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,X,x)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi n
                %annotation{:encoding => "application/x-tex"} U_n
            form a
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            over this diagram and thus induce a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi ω
                    %mo{:lspace => "verythinmathspace"} :
                    %mi P
                    %mi Alg
                    %mo →
                    %mi ω
                    %msub
                      %mi Cptd
                      %mi P
                  %annotation{:encoding => "application/x-tex"} U_\omega\colon P Alg \to \omega Cptd_P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C_n)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} \omega Cptd_P
            to the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msub
                    %mi C
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mn 0
                  %msub
                    %mi C
                    %mn 0
                  %mo →
                  %msub
                    %mi F
                    %mn 1
                  %msub
                    %mi C
                    %mn 1
                  %mo →
                  %msub
                    %mi F
                    %mn 2
                  %msub
                    %mi C
                    %mn 2
                  %mo →
                  %mi …
                  %mo .
                %annotation{:encoding => "application/x-tex"} F_{-1} C_{-1} \to F_0 C_0 \to F_1 C_1 \to F_2 C_2 \to \dots.
          %h4#examples Examples
          %p
            For simplicity, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            be the terminal globular operad, such that
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-categories"} strict ∞-categories
          %ul
            %li
              %p
                As in the definition, a 0-computad is just a set, and the free
                %a.existingWikiWord{:href => "/nlab/show/0-category"} 0-category
                on a 0-computad is just itself, considered as a discrete
                = succeed "-category." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
            %li
              %p
                A 1-computad consists of 0-computad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                (i.e. a set) together with another set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and a function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi GSet
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∂
                          %mn 1
                        %mo ,
                        %msub
                          %mi U
                          %mi P
                        %msub
                          %mi F
                          %mn 0
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X\to GSet(\partial_1, U_P F_0 C)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \partial_1
                is just a pair of objects, so this means that each element of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is equipped with a pair of elements of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %a.existingWikiWord{:href => "/nlab/show/source"} source
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/target"} target
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quiver"} quiver
            %li
              %p The free 1-category on a 1-computad is the usual free category on a quiver. That is, its objects are the vertices of the graph and its morphisms are finite composable strings of edges in the quiver.
            %li
              %p
                A 2-computad is given by a quiver together with a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_2
                of 2-cells, each equipped with a source and a target which are composable strings of edges in the graph. For example, if the given quiver is a square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                              %mover
                                %mo →
                                %mi f
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mi h
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi k
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                              %munder
                                %mo →
                                %mi g
                            %mtd
                              %mo •
                    %annotation{:encoding => "application/x-tex"}
                      \\array{\bullet &amp; \overset{f}{\to} &amp; \bullet \\
                      ^h\downarrow &amp;&amp; \downarrow^k\\
                      \\bullet&amp; \underset{g}{\to} &amp; \bullet}
              %p
                then the free category it generates is the free noncommutative square, having two diagonals
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi f
                    %annotation{:encoding => "application/x-tex"} k f
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi h
                      %annotation{:encoding => "application/x-tex"} g h
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                with source
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi f
                    %annotation{:encoding => "application/x-tex"} k f
                and target
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mi h
                      %annotation{:encoding => "application/x-tex"} g h
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                              %mover
                                %mo →
                                %mi f
                            %mtd
                              %mo •
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mi h
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ↙
                                %mi α
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi k
                          %mtr
                            %mtd
                              %mo •
                            %mtd
                              %munder
                                %mo →
                                %mi g
                            %mtd
                              %mo •
                    %annotation{:encoding => "application/x-tex"}
                      \\array{\bullet &amp; \overset{f}{\to} &amp; \bullet\\
                      ^h\downarrow &amp; \swarrow_\alpha &amp; \downarrow^k\\
                      \\bullet &amp; \underset{g}{\to} &amp; \bullet}
            %li
              %p
                Any
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular set
                can be considered as an
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ,
                      %mi t
                      %mo :
                      %msub
                        %mi C
                        %mi n
                      %mo ⇉
                      %msub
                        %mi F
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s, t: C_n \rightrightarrows F_{n-1}(\mathcal{C})_{n-1}
                land inside
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} C_{n-1}
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-computad" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-globular" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
                can be presented by a computad, as can every
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/opetope"} opetope
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cube"} cube
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"} geometric shapes for higher structures
          %h3#on_inverse_diagrams On inverse diagrams
          %p
            The above definition can easily be generalized by replacing the
            %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
            by any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/direct+category"} direct category
            %a.existingWikiWord{:href => "/nlab/show/opposite"} opposite
            of an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inverse+category"} inverse category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            be any inverse category, and consider the
            %a.existingWikiWord{:href => "/nlab/show/diagram+category"} diagram category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                      %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \Set^{\mathcal{I}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} n\in \mathcal{I}
            has a
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi n
                  %mo ∈
                  %msup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                    %mi ℐ
                %annotation{:encoding => "application/x-tex"} Y_n\in \Set^{\mathcal{I}}
            defined by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ℐ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y_n(x) = \mathcal{I}(n,x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi n
                  %mo ⊂
                  %msub
                    %mi Y
                    %mi n
                %annotation{:encoding => "application/x-tex"} \partial_n \subset Y_n
            consisting of all nonidentity morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} n\to x
            (as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            varies). These play the role of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 2
                    %mi n
                %annotation{:encoding => "application/x-tex"} 2_n
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi n
                %annotation{:encoding => "application/x-tex"} \partial_n
            above.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            be a monad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                    %mi ℐ
                %annotation{:encoding => "application/x-tex"} \Set^{\mathcal{I}}
            with induced adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi P
                    %mo :
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                      %mi ℐ
                    %mo ⇄
                    %mi P
                    %mi Alg
                    %mo :
                    %msub
                      %mi U
                      %mi P
                  %annotation{:encoding => "application/x-tex"} F_P : \Set^{\mathcal{I}} \rightleftarrows P Alg : U_P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} \mathcal{I}
            have a
            %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"} well-founded relation
            given by the existence of nonidentity arrows, we will define by well-founded recursion on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℐ
                %annotation{:encoding => "application/x-tex"} n\in \mathcal{I}
            the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} n Cptd_P
            and an adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %msub
                      %mi Cptd
                      %mi P
                    %munderover
                      %mo ⇄
                      %mrow
                        %msub
                          %mi U
                          %mi n
                      %mrow
                        %msub
                          %mi F
                          %mi n
                    %mi P
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} n Cptd_P \underoverset{U_n}{F_n}{\rightleftarrows} P Alg
          %p
            Assume, therefore, that this adjunction has been defined for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            for which there is any nonidentity morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n\to k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo &lt;
                  %mi n
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} (\lt n) Cptd_P
            be the limit of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} k Cptd_P
            for all such
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mrow
                      %mo &lt;
                      %mi n
                  %mo ⊣
                  %msub
                    %mi U
                    %mrow
                      %mo &lt;
                      %mi n
                %annotation{:encoding => "application/x-tex"} F_{\lt n} \dashv U_{\lt n}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} P Alg
            (see below). Now define an
            = succeed "-computad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-computad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo &lt;
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lt n)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi P
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi P
                  %msub
                    %mo ∂
                    %mi n
                  %mo ,
                  %msub
                    %mi F
                    %mrow
                      %mo &lt;
                      %mi n
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi Set
                    %mi ℐ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mi n
                  %mo ,
                  %msub
                    %mi U
                    %mi P
                  %msub
                    %mi F
                    %mrow
                      %mo &lt;
                      %mi n
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} x\colon X\to P Alg(F_P \partial_n, F_{\lt n} C) = Set^{\mathcal{I}}(\partial_n, U_P F_{\lt n} C).
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi n
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mi Alg
                  %mo →
                  %mi n
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} U_n\colon P Alg \to n Cptd_P
            is defined as before: it sends a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to the
            = succeed "-computad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-computad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo &lt;
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lt n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mrow
                      %mo &lt;
                      %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"} U_{\lt n} A
            together with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            defined by the following pullback square in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                        %mtd
                          %mi P
                          %mi Alg
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mi P
                          %msub
                            %mi Y
                            %mi n
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mi x
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi P
                          %mi Alg
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mi P
                          %msub
                            %mo ∂
                            %mi n
                          %mo ,
                          %msub
                            %mi F
                            %mrow
                              %mo &lt;
                              %mi n
                          %msub
                            %mi U
                            %mrow
                              %mo &lt;
                              %mi n
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %munder
                            %mo →
                            %mrow
                        %mtd
                          %mi P
                          %mi Alg
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mi P
                          %msub
                            %mo ∂
                            %mi n
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{X &amp; \overset{}{\to} &amp; P Alg(F_P Y_n, A)\\
                  ^x \downarrow &amp;&amp; \downarrow\\
                  P Alg(F_P \partial_n, F_{\lt n} U_{\lt n} A) &amp; \underset{}{\to} &amp; P Alg(F_P \partial_n, A)}
          %p
            Similarly, its left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi n
                %annotation{:encoding => "application/x-tex"} F_n
            takes an
            = succeed "-computad" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D = (C,X,x)
            to the following pushout in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} P Alg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mo ⋅
                          %msub
                            %mi F
                            %mi P
                          %msub
                            %mo ∂
                            %mi n
                        %mtd
                          %mover
                            %mo →
                            %mover
                              %mi x
                              %mo ¯
                        %mtd
                          %msub
                            %mi F
                            %mrow
                              %mo &lt;
                              %mi n
                          %mi C
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                          %mo ⋅
                          %msub
                            %mi F
                            %mi P
                          %msub
                            %mi Y
                            %mi n
                        %mtd
                          %munder
                            %mo →
                            %mrow
                        %mtd
                          %msub
                            %mi F
                            %mi n
                          %mi D
                %annotation{:encoding => "application/x-tex"}
                  \\array{X\cdot F_P \partial_n &amp; \overset{\overline{x}}{\to} &amp; F_{\lt n} C\\
                  \\downarrow &amp;&amp; \downarrow\\
                  X \cdot F_P Y_n &amp; \underset{}{\to} &amp; F_n D}
          %p
            This definition is not quite correct as written, because it assumes in the definition of
            = succeed "-computads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo &lt;
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lt n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %msub
                    %mi Cptd
                    %mi P
                %annotation{:encoding => "application/x-tex"} k Cptd_P
            are defined with adjunctions to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} P Alg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            varies that commute with these adjunctions. Thus, formally speaking it has to be phrased as a definition of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %a{:href => "http://www.staff.science.uu.nl/~ooste110/realizability/wellffunctors.pdf"} here
          %p
            For example, if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                    %mo =
                    %mi 𝒫
                    %mo ×
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{I} = \mathcal{P}\times \mathcal{P}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⇉
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} = (1 \rightrightarrows 0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi ℐ
                %annotation{:encoding => "application/x-tex"} Set^{\mathcal{I}}
            whose algebras are double categories, and in this way we can obtain a notion of “double computad”.
          %h2#computads_presheaves_and_opetopes Computads, presheaves and opetopes
          %p
            The category of computads relative to a globular operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is sometimes a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Ctp
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{Ctp^{op}}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ctp
                %annotation{:encoding => "application/x-tex"} Ctp
            is the category of “computopes.” A “computope” is, intuitively, one possible “
            %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"}> shape
            ” for an
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-algebra)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/globe"} globe
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cube"} cube
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular set
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
          %p
            However, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the terminal globular operad whose algebras are
            %em strict
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/strict+n-categories"} strict n-categories
            are insufficient for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n\gt 2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %em no
            1-cells, and two 2-cells
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            must then both be the identity 1-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi x
                %annotation{:encoding => "application/x-tex"} id_x
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mi α
                    %mo =
                    %mi α
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta\alpha = \alpha\beta
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eckmann-Hilton+argument"} Eckmann-Hilton argument
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            whose source (say) is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mi α
                    %mo =
                    %mi α
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta\alpha = \alpha\beta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            to the computope-shape of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            (i.e. neither one is the “first” or the “second”).
          %p
            This argument only kicks in for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n\ge 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is “suitably weak.” To define what this means, one considers the “slices” of the operad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            induces a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi k
                %annotation{:encoding => "application/x-tex"} P_k
            on the category of
            = succeed "-globular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} P_n Alg
            on the objects whose underlying globular set is
            = succeed "-terminal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \lt n
            %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
            over the category of sets; the resulting monad on
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            is called the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-slice
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "," do
              %a{:href => "http://arxiv.org/abs/math.CA/0209035"} Computads and slices of operads
            = succeed "-computads" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a presheaf category if the
            = succeed "-slices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            are
            %span.newWikiWord
              strongly regular theories
              %a{:href => "/nlab/new/strongly+regular+theory"} ?
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 0\leq k \leq n-1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is an operad for Batanin weak
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            On the other hand, even in the strict case we can obtain presheaf categories of suitably restricted computads. For instance, if we consider only “many-to-one” computads in which the target of each
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-cell" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/opetopic+set"} opetopic set
            = succeed "." do
              %a{:href => "#Henry17"} Henry 2017
          %h2#monadicity Monadicity
          %p
            The monadicity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mi Cptd
                %annotation{:encoding => "application/x-tex"} \omega Cptd
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \omega Cat
            was first claimed by Batanin in his ‘98 paper. The proof however made use of the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mi Cptd
                %annotation{:encoding => "application/x-tex"} \omega Cptd
            was a category of presheaves, which was later found to be false. Métayer provided a corrected proof in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fran%C3%A7ois+M%C3%A9tayer"}> François Métayer
              ,
              = succeed "." do
                %a{:href => "https://arxiv.org/abs/1606.00139"}
                  Strict
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega
          %h2#computads_as_cofibrant_resolutions Computads as cofibrant resolutions
          %p
            Quite generally, computads can be used to describe
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant replacements
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"} canonical model structure
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-categories"} strict ∞-categories
          %ul
            %li
              %p
                F. Métayer,
                %em Cofibrant complexes are free
                (
                %a{:href => "http://arxiv.org/abs/math.CT/0701746"}> arXiv
                )
            %li
              %p
                F. Métayer,
                %em Resolutions by polygraphs
                (
                %a{:href => "http://www.tac.mta.ca/tac/volumes/11/7/11-07.pdf"}> tac
                )
          %p
            The cofibrant resolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi cof
                  %mo →
                  %mi Id
                  %mo :
                  %mi ω
                  %mi Cat
                  %mo →
                  %mi ω
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (-)_{cof} \to Id : \omega Cat \to \omega Cat
            given by Métayer in these articles is the one counit of the
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mi Cptd
                    %mo →
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \omega Cptd  \to \omega Cat
            %em every
            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-category"} strict ∞-category
            is equivalent as an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            It is to be expected that similar results are true for Batanin weak
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            Moreover, for any globular operad
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %msub
                    %mi Cptd
                    %mi P
                  %mo ⇄
                  %mi P
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} \omega Cptd_P \rightleftarrows P Alg
            is the same as the “canonical” cofibrant replacement
            %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic weak factorization system
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} P Alg
            generated by the boundary inclusions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi P
                    %msub
                      %mo ∂
                      %mi n
                    %mo →
                    %msub
                      %mi F
                      %mi P
                    %msub
                      %mn 2
                      %mi n
                  %annotation{:encoding => "application/x-tex"} F_P \partial_n \to F_P 2_n
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
              ,
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/0810.4450"} Homomorphisms of higher categories
          %p
            In particular, the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            of this comonad is a good candidate for the category of
            %em weak functors
            between Batanin weak
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/syzygy"} syzygy
          %h2#references References
          %p 2-computads were originally defined by Ross Street in the paper
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "." do
                %em Limits indexed by category-valued 2-functors
          %p
            The goal there was to describe which 2-categories are “finitely presented” (the presentation being given by a 2-computad) in order to describe the correct notion of “finite
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/2-limit"} 2-limit
          %p
            I don’t know the first use of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-computads,” but
            %a.existingWikiWord{:href => "/nlab/show/Michael+Makkai"} Michael Makkai
            has studied them as a way to define
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/opetopic+sets"} opetopic sets
          %ul
            %li
              %p
                Makkai, Harnik, and Zawadowski,
                = succeed "," do
                  %em Multitopic sets are the same as many-to-one computads
                = succeed "." do
                  %a{:href => "http://www.math.mcgill.ca/makkai/m_1_comp/"} link
            %li
              %p
                Makkai,
                = succeed "," do
                  %em The word problem for computads
                = succeed "." do
                  %a{:href => "http://www.math.mcgill.ca/makkai/computad.zip"} link
          %p
            Computads were studied by
            %a.existingWikiWord{:href => "/nlab/show/Burroni"} Burroni
            under the name “polygraph” in the framework of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rewriting"} rewriting
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Albert+Burroni"}> Albert Burroni
              ,
              %em Higher dimensional word problems with applications to equational logic
              (
              %a{:href => "https://www.irif.fr/_media/users/burroni/high_word_pb.pdf"}> pdf
              )
          %p The following more recent papers are referred to above:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Batanin"}> Michael Batanin
                ,
                %a{:href => "http://arxiv.org/abs/math.CA/0209035"} Computads and slices of operads
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/0810.4450"} Homomorphisms of higher categories
            %li#Henry17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Henry"}> Simon Henry
                ,
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1711.00744"} Non-unital polygraphs form a presheaf category
          %p
            Disucssion of computads as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christopher+J.+Dean"}> Christopher J. Dean
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eric+Finster"} Eric Finster
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ioannis+Markakis"} Ioannis Markakis
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Reutter"} David Reutter
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jamie+Vicary"} Jamie Vicary
              %em
                Computads for weak
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2208.08719"}> arXiv:2208.08719
              \&amp;rbrack;
          %p
            One should beware that there are some erroneous claims in some of Batanin’s papers; in particular the claim that computads relative to a globular operad are
            %em always
            a presheaf category. This was explicitly shown to be false in
          %ul
            %li
              %p
                Michael Makkai and Marek Zawadowski,
                = succeed "," do
                  %em The category of 3-computads is not cartesian closed
                = succeed "." do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2440266"} MR
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eugenia+Cheng"}> Eugenia Cheng
                ,
                %a{:href => "http://arxiv.org/abs/1209.0414"} A direct proof that the category of 3-computads is not cartesian closed
          %p Some blog discussion:
          %ul
            %li
              %a{:href => "http://golem.ph.utexas.edu/category/2008/10/freely_generated_categories.html"}> Freely generated ω-categories
              \.
