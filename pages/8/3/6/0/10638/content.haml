                            %a.existingWikiWord{:href => "/nlab/show/Dedekind+eta+function"} Dedekind eta function
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/elliptic+genus"}> elliptic genus
                            ,
                            %a.existingWikiWord{:href => "/nlab/show/Witten+genus"} Witten genus
                    %li
                      %p
