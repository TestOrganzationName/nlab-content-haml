            %li#Steane96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+M.+Steane"}> Andrew M. Steane
                ,
                = succeed "," do
                  %em Error Correcting Codes in Quantum Theory
                = succeed ")" do
