                  132 (2022)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  %a{:href => "https://doi.org/10.1038/s41534-022-00643-y"} doi:10.1038/s41534-022-00643-y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
