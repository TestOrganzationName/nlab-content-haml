              %a.existingWikiWord{:href => "/nlab/show/magnetic+flux"} magnetic flux
              through (
              %a.existingWikiWord{:href => "/nlab/show/Josephson+junctions"} Josephson junctions
              in)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/superconductors"} superconductors
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/electromagnetic+radiation"} electromagnetic pulses
            %ul
              %li
                %p
