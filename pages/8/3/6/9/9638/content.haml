            )
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+R.+Simon"}> Daniel R. Simon
                ,
                = succeed "," do
                  %em On the power of quantum computation
                %strong 26
                5 (1997) &amp;lbrack;
                %a{:href => "https://doi.org/10.1137/S0097539796298637"}> doi:10.1137/S0097539796298637
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://courses.cs.washington.edu/courses/cse599/01wi/papers/simon_qc.pdf"} pdf
            %li
              %p
