            of the space of
            %a.existingWikiWord{:href => "/nlab/show/local+observable"} local
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
