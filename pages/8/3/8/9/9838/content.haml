                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} normalization scheme
            %li
              %p
                under
                %a.existingWikiWord{:href => "/nlab/show/scaling+transformations"} scaling transformations
                on
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mi ρ
                    %annotation{:encoding => "application/x-tex"} \sigma_\rho
                (
                %a{:href => "#Duetsch18"}> Dütsch 18, def. 3.19
                ) we have that with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒮
                        %mrow
