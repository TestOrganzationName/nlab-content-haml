                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{S}(g S_{int} + j A)
                  \\;=\;
                  \\mathcal{S}'\left( \mathcal{Z}(g S_{int} + j A) \right)
          %p
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/main+theorem+of+perturbative+renormalization"} main theorem of perturbative renormalization
            %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
            at coincident interaction points are related by a re-definition of the original
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A
          %p Now it may happen that
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
