                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ⟨
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi 𝒮
                                %mi vac
                        %mtd
                          %mi PolyObs
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi mc
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi ℏ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi j
                          %mi A
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mi 𝒮
                            %mi vac
                          %mo{:stretchy => "false"} (
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi j
                          %mi A
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g, j \rangle
                  \&amp; \overset{\mathcal{S}_{vac}}{\longrightarrow} &amp;
                  PolyObs(E_{\text{BV-BRST}})_{mc}( ( \hbar ) )[ [ g, j ] ]
                  \\\
                  g S_{int} + j A
                  \&amp;\mapsto&amp;
                  \\mathcal{S}_{vac}(g S_{int} + j A)
                  }
          %p
            from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiatically switched
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            to
            = succeed "-elements" do
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}( g S_{int} + j A)
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            in the given vacuum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathbf{L}'
            for the given interaction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/St%C3%BCckelberg-Petermann+renormalization+group"} Stückelberg-Petermann renormalization group
            is a group of transformations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi LocObs
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi ℏ
                          %mo ,
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ⟨
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mover
                            %mo ⟶
                            %mi Z
                        %mtd
                          %mi LocObs
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi E
                            %mtext BV-BRST
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} [
                          %mo{:stretchy => "false"} [
                          %mi ℏ
                          %mo ,
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ⟨
                          %mi g
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi J
                          %mi A
                        %mtd
                          %mo ↦
                        %mtd
                          %mi 𝒵
                          %mo{:stretchy => "false"} (
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi j
                          %mi A
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]\langle g, j \rangle
                  \&amp;\overset{Z}{\longrightarrow}&amp;
                  LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g, j \rangle
                  \\\
                  g S_{int} + J A
                  \&amp;\mapsto&amp;
                  \\mathcal{Z}(g S_{int} + j A)
                  }
          %p
            such that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{S}'
            two
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/renormalization+schemes"} normalization schemes
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            schemes, there is a unique
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒵
                %annotation{:encoding => "application/x-tex"} \mathcal{Z}
            relating them by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
          #eq:SMatricesRelatedBySPRenormalizationGroupElement.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo{:stretchy => "false"} (
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo +
                  %mi j
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi 𝒮
                  %mo ′
                  %mrow
                    %mo (
                    %mi 𝒵
                    %mo{:stretchy => "false"} (
                    %mi g
