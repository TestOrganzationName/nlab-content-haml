                    %mn 0
                %annotation{:encoding => "application/x-tex"} f-CDGA_0
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CDGA
                %annotation{:encoding => "application/x-tex"} CDGA
            formed by the connected cdgas of finite type and with codomain
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
