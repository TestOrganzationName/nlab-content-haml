                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mo{:stretchy => "false"} (
