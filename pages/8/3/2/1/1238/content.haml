                  \\langle sa_1.sa_2;\partial_2s^{-1}b\rangle &amp; =&amp; (-1)^{|a_1|}\langle a_1.a_2;b\rangle ; \quad a\in A, a_i\in A,b\in \#A.}
          %p The three conditions
          %p
            (a)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
