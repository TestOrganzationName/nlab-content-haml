                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mi i
                  %mo ,
                  %msub
                    %mi su
                    %mi j
                  %mo ,
                  %msub
                    %mi su
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %mi s
                  %mover
                    %mrow
                      %msub
                        %mi u
                        %mi i
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %mi …
                  %mo ,
                  %mi s
