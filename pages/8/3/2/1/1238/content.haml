            has then a commutative graded algebra structure induced via
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi L
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{L}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi L
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathbb{L}(W),\partial) = L_*(A,d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ⊕
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo ,
                  %msub
                    %mo ∂
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k \oplus s^{-1}\#H(W,\partial_1)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(A,\partial)
            is an algebra isomorphism.
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            is decomposable,
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi 𝕃
                      %mrow
                        %mo ≥
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\partial(W) \subset \mathbb{L}^{\geq 2}(W)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ⊕
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi W
                %annotation{:encoding => "application/x-tex"} k \oplus s^{-1}\#W
            has a graded commutative algebra structure defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi L
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mo ∂
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{L}(\mathbb{L}(W),\partial_2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi W
                %annotation{:encoding => "application/x-tex"} s^{-1}\#W
            is characterised by
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi s
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msub
                    %mi x
                    %mn 1
                  %mo .
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msub
                    %mi x
                    %mn 2
                  %mo ;
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} |
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ;
                  %msub
                    %mo ∂
                    %mn 2
                  %mi w
                  %mo{:stretchy => "false"} ⟩
                  %mo ;
                  %mspace{:width => "1em"}
                  %mi w
                  %mo ∈
                  %mi W
                  %mo ,
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %mo #
                  %mi W
                  %mo .
                %annotation{:encoding => "application/x-tex"} \langle s(s^{-1}x_1.s^{-1}x_2;w\rangle  = (-1)^{|x_2| + 1}\langle x_1,x_2;\partial_2 w\rangle ; \quad w\in W,x_i \in\#W.
