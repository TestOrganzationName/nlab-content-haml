                    %mi su
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (su_1, \ldots, su_p)\to (su_i,su_j,su_1,\ldots, s\hat{u_i}, \ldots,s\hat{u_j},\ldots,su_p),
          %p
            where ‘’
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi s
                  %mover
                    %mrow
                      %msub
                        %mi u
                        %mi i
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} s\hat{u_i}
            ’‘ indicates that the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi su
                    %mi i
                %annotation{:encoding => "application/x-tex"} su_i
            has been omitted. Putting
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %msub
                      %mi d
                      %mn 1
                    %mo +
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d = d_1 + d_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
