                  %annotation{:encoding => "application/x-tex"} L_*
          %h3#cochain_functors_
            Cochain functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo *
                  %mo :
                  %mi DGLA
                  %mo →
                  %mi CDGA
                %annotation{:encoding => "application/x-tex"} C^* : DGLA\to CDGA
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V,\partial)
            be a differential graded vector space. We let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo =
                      %mi r
                  %msup
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} C^r(V) = \bigoplus_{p+q=r}C^{p,q} (V),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msup
                    %mi Hom
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ⊗
                    %mi p
                  %mi sV
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{p,q} (V) \subset Hom^{p+q}(\otimes^p sV, k)
            is the subspace of (graded)
            %em symmetric
            functions:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} f(su_1,\ldots,su_p) = \varepsilon(\sigma)f(su_{\sigma(1)},\ldots,su_{\sigma(p))}),
          %p
            for each permutation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon(\sigma)
            as its Koszul sign.
          %p
            The product of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                %annotation{:encoding => "application/x-tex"} f\in C^{p,q}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %msup
                    %mi C
                    %mrow
                      %mi r
                      %mo ,
                      %mi s
                %annotation{:encoding => "application/x-tex"} g\in C^{r,s}
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∧
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi p
                      %mo +
                      %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi σ
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi r
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (f\wedge g)(su_1, \ldots,su_{p+r}) = \sum_{\sigma}\varepsilon(\sigma)f(su_{\sigma(1)},\ldots, su_{\sigma(p)})g(su_{\sigma(p+1)},\ldots,su_{\sigma(p+r)}),
          %p
            where the sum is over all
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,r)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/shuffles"} shuffles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon(\sigma)
            is the Koszul sign of :
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo ,
                  %msub
                    %mi su
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi p
                      %mo +
                      %mi r
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi g
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi su
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mi r
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (f,g,su_1,\ldots, su_{p+r})\to (f,su_{\sigma(1)},\ldots, su_{\sigma(p)},g,su_{\sigma(p+1)},\ldots,su_{\sigma(p+r)}).
          %p
            With this product,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(V)
            is a commutative graded algebra.
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,\partial)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+Lie+algebra"} differential graded Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mn 1
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi su
                            %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi su
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi f
                              %mo{:stretchy => "false"} |
                          %munderover
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo =
                              %mn 1
                            %mi p
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi su
                                %mn 1
                              %mo{:stretchy => "false"} |
                              %mo +
                              %mi …
                              %mo +
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi su
                                %mrow
                                  %mi i
                                  %mo −
                                  %mn 1
                              %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi su
                            %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %mi s
                          %mo ∂
                          %msub
                            %mi u
                            %mi i
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi su
                            %mi p
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi d
                            %mn 2
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi su
                            %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi su
                            %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi f
                              %mo{:stretchy => "false"} |
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi i
                              %mo &lt;
                              %mi j
                          %msub
                            %mi ε
                            %mi ij
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi su
                                %mi i
                              %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi u
                            %mi i
                          %mo ,
                          %msub
                            %mi u
                            %mi j
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %msub
                            %mi su
                            %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %mi s
                          %mover
                            %mrow
                              %msub
                                %mi u
                                %mi i
                            %mo{:stretchy => "false"} ^
                          %mo ,
                          %mi …
                          %mo ,
                          %mi s
                          %mover
                            %mrow
                              %msub
                                %mi u
                                %mi j
                            %mo{:stretchy => "false"} ^
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi su
                            %mi p
                          %mo{:stretchy => "false"} )
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (d_1f)(su_1,\ldots,su_n) &amp;=&amp;(-1)^{|f|}\sum_{i=1}^p(-1)^{|su_1|+ \ldots + |su_{i-1}|}f(su_1,\ldots,s\partial u_i,\ldots,su_p) \\
                  (d_2f)(su_1,\ldots,su_n)&amp;=&amp;(-1)^{|f|}\sum_{i\lt j}\varepsilon_{ij}(-1)^{|su_i|}f(s[u_i,u_j],su_1,\ldots, s\hat{u_i}, \ldots,s\hat{u_j},\ldots,su_p),}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi ij
                %annotation{:encoding => "application/x-tex"} \varepsilon_{ij}
            is the Koszul sign of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi su
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
