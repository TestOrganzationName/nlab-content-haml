                  %mo ,
                  %msub
                    %mi y
                    %mi i
                  %mo{:stretchy => "false"} ⟩
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \langle x_1\otimes \ldots x_p,y_1,\ldots , y_p\rangle  = \varepsilon \prod_{i=1}^{p}\langle x_i,y_i\rangle ,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            is the Koszul sign of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi p
                  %mo ,
                  %msub
                    %mi y
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi y
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi y
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %mo ,
                  %msub
                    %mi x
                    %mi p
                  %mo ,
                  %msub
                    %mi y
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (x_1,\ldots,x_p,y_1,\ldots,y_p)\to (x_1,y_1,\ldots, ,x_p,y_p).
          %p
            The free commutative graded algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mo #
                  %mi V
                %annotation{:encoding => "application/x-tex"} \bigwedge\# V
            then can be identified as the algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^*(V)
            defined above, via the canonical injection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mo #
                    %mi V
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mo #
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi : \bigwedge \# V\to T(\# V)
          %h2#the_cochains_of_a_dgla__of_finite_type
            The cochains of a dgla,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,\partial)
          %p Applying the preceding conventions, we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi L
                          %mo ,
                          %mo ∂
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo #
                          %mi L
                          %mo ,
                          %mi d
                          %mo =
                          %msub
                            %mi d
                            %mn 1
                          %mo +
                          %msub
                            %mi d
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ;
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi d
                            %mn 1
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi z
                          %mo ;
                          %mi sx
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} ⟨
                          %mi z
                          %mo ;
                          %mo ∂
                          %mi x
                          %mo{:stretchy => "false"} ⟩
                          %mo ;
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi d
                            %mn 2
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi z
                          %mo ;
                          %msub
                            %mi sx
                            %mn 1
                          %mo ,
                          %msub
                            %mi sx
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi x
                                %mn 1
                              %mo{:stretchy => "false"} |
                          %mo{:stretchy => "false"} ⟨
                          %mi z
                          %mo ;
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi x
                            %mn 1
                          %mo ,
                          %msub
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\array{C^*(L,\partial) &amp;=&amp; (\bigwedge s^{-1}\#L, d = d_1+d_2);\\
                  \\langle d_1s^{-1}z;sx\rangle  &amp;=&amp; - \langle z;\partial x\rangle ;\\
                  \\langle d_2s^{-1}z;sx_1,sx_2\rangle &amp;=&amp; (-1)^{|x_1|}\langle z;[x_1,x_2]\rangle }
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo ∈
                  %mo #
                  %mi L
                  %mo ,
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %mi L
                  %mo ,
                  %mi x
                  %mo ∈
                  %mi L
                  %mo .
                %annotation{:encoding => "application/x-tex"} z\in \#L, x_i\in L, x\in L.
          %h2#remark Remark
          %p
            The differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is a sum of a linear differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d_1
            and a quadratic differential,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} d_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi d
                    %mn 2
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d^2 = 0
            is equivalent to
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msubsup
                              %mi d
                              %mn 1
                              %mn 2
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %msub
                              %mi d
                              %mn 2
                            %mo +
                            %msub
                              %mi d
                              %mn 2
                            %msub
                              %mi d
                              %mn 1
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msubsup
                              %mi d
                              %mn 2
                              %mn 2
                            %mo =
                            %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\left\{\array{
                  (a) &amp; d_1^2 = 0\\
                  (b) &amp; d_1d_2 + d_2d_1 = 0\\
                  (c) &amp; d_2^2 = 0
                  }\right.
          %p
            If one lifts the definitions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d_2
            back to the Lie algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,\partial)
          %p
            (a) is equivalent to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^2 = 0
          %p
            (b) is equivalent to ‘
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                %annotation{:encoding => "application/x-tex"} \partial
            is a Lie algebra derivation’;
          %p (c) is equivalent to ‘the bracket satisfies the Jacobi identity’.
          %p
            Conversely if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                  %mo ,
                  %msub
                    %mi d
                    %mn 1
                  %mo +
                  %msub
                    %mi d
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\bigwedge V,d_1 + d_2)
            is a cdga, free on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            as a cga, we can define a dgla structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi V
                %annotation{:encoding => "application/x-tex"} s^{-1}\#V
            using the above formulae.
          %h2#definition Definition
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CDGA
                    %mi fg
                %annotation{:encoding => "application/x-tex"} CDGA_{fg}
            will denote the subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CDGA
                %annotation{:encoding => "application/x-tex"} CDGA
            with
          %ul
            %li
              %p
                as objects the cdgas
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mi V
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\bigwedge V, d)
                of finite type, which are free as cgas on a gvs of generators
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi k
                          %mo ≥
                          %mn 1
                      %msup
                        %mi V
                        %mi k
                    %annotation{:encoding => "application/x-tex"} V = \sum_{k\geq 1}V^k
                with differential given by a linear part and a quadratic part;
            %li
              %p as arrows, the cdga morphisms that send generators to generators.
          %p The preceding remark translates as
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
              is an isomorphism between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CDGA
                      %mi fg
                  %annotation{:encoding => "application/x-tex"} CDGA_{fg}
              and the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DGLA
                  %annotation{:encoding => "application/x-tex"} DGLA
              formed by Lie algebras of finite type.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi C
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{C}
            be the inverse functor.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %mi V
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\bigwedge V, d)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                  %msup
                    %mi V
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo ,
                  %msup
                    %mi d
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\bigwedge V^\prime, d^\prime)
            be two cdgas of finite type, which are free as cgas. Denote by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi d
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{d}
            induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo ,
                    %msub
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %msub
                      %mi d
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(\bigwedge V, d_1) = \bigwedge H(V,d_1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msub
                        %mi d
                        %mn 2
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{d_2}
            is thus a differential. It determines, via
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s^{-1}\#H(V,d_1)
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mi V
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\bigwedge V, d) = C^*(L,\partial)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %msub
                    %mi d
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s^{-1}\#H(V,d_1)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mo ∂
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(L,\partial)
            is a Lie algebra isomorphism.
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is decomposable,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mo ≥
                        %mn 2
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d(V)\subseteq \bigwedge^{\geq 2}V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi s
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo #
                  %mi V
                %annotation{:encoding => "application/x-tex"} s^{-1}\#V
            has a Lie algebra structure defined by
            = succeed "." do
