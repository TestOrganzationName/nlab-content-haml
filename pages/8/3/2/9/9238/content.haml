                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta(a \cdot b)
                        \\coloneqq
                        (\Delta a) \cdot b
                        +
                        (-1)^{deg(a)}
                        a \cdot (\Delta b)
                        +
                        \\{a,b\}
                        \\,.
                %p
                  See below at
                  %em
                    %a{:href => "#TheQuantumObservables"} The quantum observables
                  for more.
            %p
              A closed element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo ∈
                    %msup
