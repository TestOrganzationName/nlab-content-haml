                            %mo ∧
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi σ
                              %mi d
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_a^i \wedge \mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^d
                    \&amp; \coloneqq
                    \\frac{\partial}{\partial u^a_i} L
                    \\\
                    \&amp; =
                    \\left(
                    g^{i j} \eta_{a b} \phi^a_{,j}
                    \\right)
                    \\wedge
                    \\mathbf{d}\sigma^1 \wedge \cdots \wedge \mathbf{d}\sigma^d
                    \\end{aligned}
          .num_remark
            %h6#remark_2 Remark
            %p
              So the boundary term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
              %a{:href => "covariant+phase+space#CanonicalThetaDensityInLocalCoordinates"} this remark
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              ) is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi u
                              %mi a
                            %mo ∧
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi i
                            %mrow
                              %mo (
                              %mfrac
                                %mo ∂
                                %mrow
                                  %mo ∂
                                  %msubsup
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi i
                                    %mi a
                              %mi L
                              %mo )
                          %mtd
                            %mo =
                            %msubsup
                              %mi p
                              %mi a
                              %mi i
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mrow
                                    %msup
                                      %mi σ
                                      %mi i
                            %mi vol
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %msup
                              %mi u
                              %mi a
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mi p
                              %mi a
                              %mi i
                            %mo ∧
                            %msubsup
                              %mi dq
                              %mi i
                              %mi a
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathbf{d}u^a
                    \\wedge
                    \\iota_{\partial_i}
                    \\left(
                    \\frac{\partial}{\partial \phi^a_{,i}}L
                    \\right)
                    \&amp; =
                    p^i_a \wedge (\iota_{\partial_{\sigma^i}} vol) \wedge \mathbf{d}u^a
                    \\\
                    \&amp; =  p^i_a \wedge dq_i^a
                    \\,,
                    \\end{aligned}
            %p
              where in the last line we adopted the notation of
              %a{:href => "#multisymplectic+geometry#CanonicalFormInGoodCoordinates"} this remark
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
            %p
              This shows that the canonical
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+form"} multisymplectic form
              is the “covariant symplectic potential current density” which is induced by the free field Lagrangian.
          %h3#in_bvformalism In BV-formalism
          %h4#kinematics_and_dynamics Kinematics and dynamics
          %p
            In the formalization of
            %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
            via
            %a.existingWikiWord{:href => "/nlab/show/BV-quantization"} BV-quantization
            as in (
            %a{:href => "#CostelloGwilliam"}> Costello-Gwilliam
            ), a free field theory is given by a
            %a.existingWikiWord{:href => "/nlab/show/BV-complex"} BV-complex
            that arises from the following data.
          %p
            The following appears for instance as (
            %a{:href => "#Gwilliam"}> Gwilliam 2.6.2
            ).
          #FreeFieldTheory.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong free field theory
              (
              %a.existingWikiWord{:href => "/nlab/show/local+quantum+field+theory"}> local
              ,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian"} Lagrangian
            %p
              %strong>
                %a.existingWikiWord{:href => "/nlab/show/kinematics"} kinematics
              \:
            %ul
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"}> spacetime
                  ”/“
                  %a.existingWikiWord{:href => "/nlab/show/worldvolume"}> worldvolume
                  ”);
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                  %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \to X
                  (the “
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"}> field bundle
                  ” containing also in general
                  %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
                  and
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/ghosts"} ghosts
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  (the “
                  %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
                  = succeed "\u201D)" do
                    %a.existingWikiWord{:href => "/nlab/show/density"} density
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ⟩
                          %mi loc
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi E
                        %mo ×
                        %mi E
                        %mo →
                        %msub
                          %mi Dens
                          %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\langle -,-\rangle_{loc} \;\colon\; E \times E \to Dens_X
                %p
                  from the fiberwise
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  with itself to the compex
                  %a.existingWikiWord{:href => "/nlab/show/density+bundle"} density bundle
                  which is fiberwise
                %ul
                  %li
                    %p non-degenerate
                  %li
                    %p anti-symmetric
                  %li
                    %p of degree -1
            %p
              (See also at
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Verdier+duality"} Verdier duality
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi c
                    %mo ≔
                    %msub
                      %mi Γ
                      %mi cp
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_c \coloneqq \Gamma_{cp}(E)
              for the space of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℰ
                      %mi c
                    %mo ⊗
                    %msub
                      %mi ℰ
                      %mi c
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle
                    \\;\colon\;
                    \\mathcal{E}_c
                    \\otimes
                    \\mathcal{E}_c
                    \\to
                    \\mathbb{C}
            %p for the induced pairing on sections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi ϕ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mo{:stretchy => "false"} ⟨
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mi loc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \phi, \psi\rangle
                    \=
                    \\int_{x \in X} \langle \phi(x), \psi(x)\rangle_{loc}
                    \\,.
            %p
              The paring being non-degenerate means that we have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi E
                      %mo *
                    %mo ⊗
                    %msub
                      %mi Dens
                      %mi X
                  %annotation{:encoding => "application/x-tex"} E \stackrel{\simeq}{\to} E^* \otimes Dens_X
              and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo !
                    %mo ≔
                    %msup
                      %mi E
                      %mo *
                    %mo ⊗
                    %msub
                      %mi Dens
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^! \coloneqq E^* \otimes Dens_X
                    \\,.
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            %ul
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
                  on sections of the
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi ℰ
                        %mo →
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"}
                        Q \;\colon\; \mathcal{E} \to \mathcal{E}
                %p of degree 1 such that
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ℰ
                            %mo ,
                            %mi Q
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\mathcal{E}, Q)
                      is an
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/elliptic+complex"} elliptic complex
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                          %annotation{:encoding => "application/x-tex"} Q
                      is
                      %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint
                      with respect to
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} ⟨
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ⟩
                          %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
                      in that for all
                      %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ϕ
                            %mo ,
                            %mi ψ
                            %mo ∈
                            %msub
                              %mi ℰ
                              %mi c
                          %annotation{:encoding => "application/x-tex"} \phi,\psi \in \mathcal{E}_c
                      of homogeneous degree we have
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} ⟨
                              %mi ϕ
                              %mo ,
                              %mi Q
                              %mi ψ
                              %mo{:stretchy => "false"} ⟩
                              %mo =
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mi ϕ
                                  %mo{:stretchy => "false"} |
                              %mo{:stretchy => "false"} ⟨
                              %mi Q
                              %mi ϕ
                              %mo ,
                              %mi ψ
                              %mo{:stretchy => "false"} ⟩
                            %annotation{:encoding => "application/x-tex"} \langle \phi , Q \psi\rangle = (-1)^{{\vert \phi\vert}} \langle Q \phi, \psi\rangle
          .num_remark
            %h6#remark_3 Remark
            %p From this data we obtain:
            %ul
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi ℰ
                          %mi c
                        %mo →
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} S \colon \mathcal{E}_c \to \mathbb{C}
                  of this corresponding free field theory is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi ϕ
                        %mo ↦
                        %msub
                          %mo ∫
                          %mi X
                        %mo{:stretchy => "false"} ⟨
                        %mi ϕ
                        %mo ,
                        %mi Q
                        %mi ϕ
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        S \;\colon\; \phi \mapsto \int_X \langle \phi, Q \phi\rangle
                        \\,.
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/classical+BV-complex"} classical BV-complex
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                        %msubsup
                          %mi ℰ
                          %mi c
                          %mo !
                      %annotation{:encoding => "application/x-tex"} Sym  \mathcal{E}^!_c
                  of
                  %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly suppported
                  %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mo !
                      %annotation{:encoding => "application/x-tex"} E^!
                  equipped with the induced action of the differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  and the pairing
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi α
                        %mo ,
                        %mi β
                        %mo{:stretchy => "false"} }
                        %mo ≔
                        %msub
                          %mo ∫
                          %mrow
                            %mi x
                            %mo ∈
                            %mi X
                        %mo{:stretchy => "false"} ⟨
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi β
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\{\alpha,\beta\} \coloneqq  \int_{x \in X} \langle \alpha(x), \beta(x)\rangle
                        \\,.
                %p
                  See below at
                  %em
                    %a{:href => "#TheClassicalObservables"} The classical observables
                  for more.
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/quantum+BV-complex"} quantum BV-complex
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Obs
                          %mi q
                        %mo ≔
                        %mo{:stretchy => "false"} (
                        %mi Sym
                        %msubsup
                          %mi ℰ
                          %mi c
                          %mo !
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi Q
                        %mo +
                        %mi ℏ
                        %mi Δ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Obs^q \coloneqq (Sym \mathcal{E}^!_c[ [\hbar] ], Q + \hbar \Delta)
                %p
                  is the deformation of the above to the
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
                  tensored with the
                  %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
                  ”)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sym
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℰ
                          %mo !
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} Sym(\mathcal{E}^!)[ [\hbar] ]
                  and differential
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo +
                        %mi ℏ
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} Q + \hbar \Delta
                  with
                  %a.existingWikiWord{:href => "/nlab/show/BV-Laplacian"} BV-Laplacian
                  defined to vanish on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Sym
                            %mrow
                              %mo ≤
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} Sym^{\leq 1}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo ⋅
                        %mi β
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mi α
                        %mo ,
                        %mi β
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta (\alpha \cdot \beta) \coloneqq \{\alpha,\beta\}
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ,
                        %mi β
                        %mo ∈
                        %msup
                          %mi ℰ
                          %mo !
                      %annotation{:encoding => "application/x-tex"} \alpha,\beta \in \mathcal{E}^!
                  and extended by the formula
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ⋅
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mi b
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo{:stretchy => "false"} )
                        %mi a
                        %mo ⋅
                        %mo{:stretchy => "false"} (
