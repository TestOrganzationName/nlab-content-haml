                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} \in Obs^q
              is an
              %a.existingWikiWord{:href => "/nlab/show/observable"} observable
              and its formal
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi 𝒪
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \mathcal{O}\rangle
              is its image in the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
