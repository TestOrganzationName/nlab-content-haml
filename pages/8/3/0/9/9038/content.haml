          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar fields
