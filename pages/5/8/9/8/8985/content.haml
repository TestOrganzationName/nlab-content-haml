              %em qua
              pointed endofunctor). Thus, by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedQuotient"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
