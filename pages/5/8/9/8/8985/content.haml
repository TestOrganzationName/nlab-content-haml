                    %mo ′
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M',K)
          %h2#basic_concepts Basic concepts
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            which we consider will be
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
            for some sufficiently large
            %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transfinite+compositions"} transfinite compositions
          .num_defn
            %h6#definition Definition
            %p
              An endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo :
                    %mi 𝒜
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} S:\mathcal{A}\to \mathcal{A}
              is called
              %strong
                %a.existingWikiWord{:href => "/nlab/show/pointed+endofunctor"} pointed
              if it is equipped with a natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo :
                      %msub
                        %mi Id
                        %mi 𝒜
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \sigma:Id_\mathcal{A} \to S
              %strong well-pointed
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi σ
                    %mo =
                    %mi σ
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S\sigma = \sigma S
              (as natural transformations
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo →
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S\to S^2
          %p
            Of course, a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            can be regarded as a pointed endofunctor where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is its unit. Such an endofunctor is well-pointed precisely when the monad is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
          .num_defn
            %h6#definition_2 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is an endofunctor, then an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+endofunctor"} algebra
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              together with a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi A
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} H A\to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              is a pointed endofunctor, then an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi S
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:S A \to A
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %msub
                        %mi σ
                        %mi A
                      %mo =
                      %msub
                        %mn 1
                        %mi A
                    %annotation{:encoding => "application/x-tex"} a \sigma_A = 1_A
          %p
            We have obvious categories of algebras of both sorts. Of course, any
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+a+monad"} algebra for a monad
            is also an algebra for that monad
            %em qua
            pointed endofunctor. The converse holds in the well-pointed/idempotent case. In fact, we have:
          #WellPointedAlgebras.num_lemma
            %h6#lemma Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              is well-pointed, then an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              admits at most one
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \sigma_A
              is an isomorphism, in which case its inverse is that unique algebra structure.
          .proof
            %h6#proof Proof
            %p Commutativity of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi S
                          %mi S
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi S
                              %mi a
                        %mtd
                          %mi S
                          %mi A
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi σ
                                  %mrow
                                    %mi S
                                    %mi A
                                %mo =
                                %mi S
                                %msub
                                  %mi σ
                                  %mi A
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} ↑
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi σ
                                  %mi A
                      %mtr
                        %mtd
                          %mi S
                          %mi A
                        %mtd
                          %munder
                            %mo →
                            %mi a
                        %mtd
                          %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    S S A &amp; \overset{S a}\to &amp; S A \\
                    \\mathllap{\scriptsize{\sigma_{S A}=S\sigma_A}}\uparrow &amp;&amp; \;\;\;\;\uparrow\mathrlap{\scriptsize{\sigma_A}} \\
                    S A &amp; \underset{a}\to &amp; A
                    \\end{array}
            %p
              gives that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mi A
                      %mo ∘
                      %mi a
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mi S
                          %mi A
                    %annotation{:encoding => "application/x-tex"} \sigma_A\circ a= 1_{S A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %msub
                      %mi σ
                      %mi A
                    %mo =
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} a\sigma_A= 1_A
              gives the invertibility of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a\colon S A\to A
              and the uniqueness of the algebra structure.
          %p
            Thus, when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is well-pointed, the category of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          #WellPointedQuotient.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              is a well-pointed endofunctor and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \alpha\colon S\to T
              is a natural transformation whose components are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is also well-pointed.
          .proof
            %h6#proof_2 Proof
            %p
              The putative transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mn 1
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \eta\colon 1\to T
              is the composition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∘
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \alpha\circ \sigma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mi T
                      %mo ∘
                      %mi α
                      %mo =
                      %mi S
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \sigma T\circ \alpha = S\eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi S
                          %msub
                            %mi η
                            %mi A
                        %mtd
                          %mo =
                          %mi S
                          %msub
                            %mi α
                            %mi A
                          %mo ∘
                          %mi S
                          %msub
                            %mi σ
                            %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi S
                          %msub
                            %mi α
                            %mi A
                          %mo ∘
                          %msub
                            %mi σ
                            %mrow
                              %mi S
                              %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi σ
                            %mrow
                              %mi T
                              %mi A
                          %mo ∘
                          %msub
                            %mi α
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{cc}
                    S\eta_A &amp;= S \alpha_A \circ  S\sigma_A \\
                    \&amp;= S\alpha_A \circ \sigma_{S A}\\
                    \&amp;= \sigma_{T A}\circ \alpha_A
                    \\end{array}
            %p
              by naturality of the transformations involved. Now, it suffices to show that
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mi T
                      %mo ∘
                      %mi α
                      %mo =
                      %mi T
                      %mi η
                      %mo ∘
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \eta T \circ \alpha = T\eta \circ \alpha
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi η
                          %mi T
                          %mo ∘
                          %mi α
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi A
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi α
                            %mrow
                              %mi T
                              %mi A
                          %mo ∘
                          %msub
                            %mi σ
                            %mrow
                              %mi T
                              %mi A
                          %mo ∘
                          %msub
                            %mi α
                            %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi α
                            %mrow
                              %mi T
                              %mi A
                          %mo ∘
                          %mi S
                          %msub
                            %mi η
                            %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi T
                          %msub
                            %mi η
                            %mi A
                          %mo ∘
                          %msub
                            %mi α
                            %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mi η
                          %mo ∘
                          %mi α
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    (\eta T \circ \alpha)_A &amp;=&amp; \alpha_{T A}\circ \sigma_{T A}\circ \alpha_A \\
                    \&amp;=&amp; \alpha_{T A} \circ S \eta_A\\
                    \&amp;=&amp; T \eta_A \circ \alpha_A \\
                    \&amp;=&amp; (T\eta \circ\alpha)_A\end{array}
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              is an epimorphism, we can conclude.
          #WellPointedCointersection.num_lemma
            %h6#lemma_3 Lemma
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %msub
                      %mi σ
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i,\sigma_i)
              is a family of (accessible) well-pointed endofunctors and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mi Id
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \sigma:Id \to S
              be the
              %a.existingWikiWord{:href => "/nlab/show/wide+pushout"} wide pushout
              of all the points
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi σ
                        %mi i
                      %mo :
                      %mi Id
                      %mo →
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \sigma_i:Id \to S_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              is (accessible and) well-pointed, and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mi Alg
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mi i
                      %mi Alg
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S Alg = \bigcap_i (S_i Alg)
          .proof
            %h6#proof_3 Proof
            %p
              The last statement is almost obvious using Lemma
              %a.maruku-ref{:href => "#WellPointedAlgebras"}
              above. Well-pointedness for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              follows adapting Lemma
              %a.maruku-ref{:href => "#WellPointedQuotient"}
              to the case of a jointly epimorphic family of arrows
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi S
                        %mi i
                      %mo →
                      %mi S
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{S_i\to S\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          #WellPointedTransfer.num_lemma
            %h6#lemma_4 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi 𝒜
                    %mo ⇄
                    %mi ℬ
                    %mo :
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F:\mathcal{A} \rightleftarrows \mathcal{B} :G
              be an adjunction and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ′
                    %mo ,
                    %mi σ
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S',\sigma')
              an (accessible) well-pointed endofunctor on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              be the pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi F
                                %mi σ
                                %mo ′
                                %mi G
                          %mtd
                            %mi F
                            %mi S
                            %mo ′
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Id
                          %mtd
                            %mover
                              %mo →
                              %mi σ
                          %mtd
                            %mi S
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ F G &amp; \xrightarrow{F \sigma' G} &amp; F S' G \\
                    \\downarrow &amp;&amp; \downarrow \\
                    Id &amp; \xrightarrow{\sigma} &amp; S. }
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\sigma)
              is (accessible and) well-pointed, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
              is an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi B
                  %annotation{:encoding => "application/x-tex"} G B
              is an
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} S'
          .proof
            %h6#proof_4 Proof
          %h2#free_algebras_for_wellpointed_endofunctors Free algebras for well-pointed endofunctors
          %p The basic theorem to which all others can be reduced is the following.
          #WellPointedFreeAlgebras.num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is an accessible well-pointed endofunctor, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} S Alg
              is
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              exists (and is accessible).
          .proof
            %h6#proof_5 Proof
            %p
              Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/induction"} inductively
              the following transfinite sequence in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi S
                    %mi A
                    %mo →
                    %msup
                      %mi S
                      %mn 2
                    %mi A
                    %mo →
                    %msup
                      %mi S
                      %mn 3
                    %mi A
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} A \to S A \to S^2 A \to S^3 A \to \cdots
            %p
              in which each transition map is a component of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              = succeed "-filtered" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is
              = succeed "-accessible," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              will preserve the relevant colimit, and hence we have an induced action
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi α
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi S
                        %mi α
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S(S^\alpha A) \to S^\alpha A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi α
                    %mi A
                  %annotation{:encoding => "application/x-tex"} S^\alpha A
              into a reflection of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} S Alg
          %p Some important constructions are directly examples of this theorem.
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be a set of morphisms in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
              is said to be
              %em orthogonal
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}(k,A)
              is a bijection for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k\in K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒜
                    %mo →
                    %msup
                      %mi Set
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}(k,-):\mathcal{A}\to Set^{\mathbf{2}}
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to an isomorphism, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}}
              is the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} Set^{\mathbf{2}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mi k
                    %annotation{:encoding => "application/x-tex"} R_k
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedTransfer"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S_k
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              whose algebras are the objects orthogonal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedCointersection"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              whose algebras are those objects orthogonal to all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k\in K
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedFreeAlgebras"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is reflective in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .num_example
            %h6#example_2 Example
            %p
              Applying the previous example on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/slice+categories"} slice categories
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+systems"} orthogonal factorization systems
          %p
            The rest of the constructions proceed by building, out of other data, a well-pointed endofunctor, and applying Theorem
            = succeed "." do
              %a.maruku-ref{:href => "#WellPointedFreeAlgebras"}
          %h2#free_algebras_for_pointed_endofunctors Free algebras for pointed endofunctors
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,\tau)
            be a general (accessible) pointed endofunctor, not necessarily well-pointed. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} /
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
            denote the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,a)
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi T
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} a:T A \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} /
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
            is again locally presentable.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi T
                  %mo ′
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} \alpha:T'\to T
            is a natural transformation, we have an adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mo !
                  %mo :
                  %mi T
                  %mo ′
                  %mo{:stretchy => "false"} /
                  %mi 𝒜
                  %mo ⇄
                  %mi T
                  %mo{:stretchy => "false"} /
                  %mi 𝒜
                  %mo :
                  %msup
                    %mi α
                    %mo *
                %annotation{:encoding => "application/x-tex"} \alpha_! : T'/\mathcal{A} \rightleftarrows T/\mathcal{A}: \alpha^*
            in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi α
                    %mo *
                %annotation{:encoding => "application/x-tex"} \alpha^*
            sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,a)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi a
                  %mo ∘
                  %msub
                    %mi α
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,a\circ \alpha_A)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mo !
                %annotation{:encoding => "application/x-tex"} \alpha_!
            is defined by a pushout.
          %p
            Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo :
                    %mi Id
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \tau:Id \to T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi τ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau^*(A,B,a)
            is the composite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi τ
                        %mi A
                  %mi T
                  %mi A
                  %mover
                    %mo →
                    %mi a
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \xrightarrow{\tau_A} T A \xrightarrow{a} B
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒜
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo =
                    %mi Id
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^{\mathbf{2}} = Id/\mathcal{A}
          #PointedAlgebrasInComma.num_lemma
            %h6#lemma_5 Lemma
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
          .proof
            %h6#proof_6 Proof
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              is a full subcategory assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,a)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,b)
              are two algebras, and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              is a morphism between the associated objects of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi a
                      %mo =
                      %mi b
                      %mo ∘
                      %mi T
                      %mi f
                    %annotation{:encoding => "application/x-tex"} g\circ a = b\circ T f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi b
                      %mo ∘
                      %msub
                        %mi τ
                        %mi B
                      %mo ∘
                      %mi f
                      %mo =
                      %mi b
                      %mo ∘
                      %mi T
                      %mi f
                      %mo ∘
                      %msub
                        %mi τ
                        %mi A
                      %mo =
                      %mi g
                      %mo ∘
                      %mi a
                      %mo ∘
                      %msub
                        %mi τ
                        %mi A
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f = b\circ \tau_B\circ f = b\circ T f\circ \tau_A = g\circ a \circ \tau_A = g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f=g
              is an algebra morphism.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B,a)
              lies in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              just when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi τ
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau^*(A,B,a)
              is an isomorphism. The isomorphisms are a reflective subcategory of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒜
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}^{\mathbf{2}}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedTransfer"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              whose algebras are precisely the
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %a.maruku-ref{:href => "#WellPointedFreeAlgebras"}
          #PointedAlgebras.num_theorem
            %h6#theorem_2 Theorem
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              is monadic over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/algebraically-free+monad"} algebraically-free monad
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              exists and is accessible.
          .proof
            %h6#proof_7 Proof
            %p
              A left adjoint to the forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                    %mo →
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T Alg \to \mathcal{A}
              is supplied by reflecting the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi T
                    %mi A
                    %mo ,
                    %msub
                      %mi τ
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,T A,\tau_A)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} T Alg
              %a.existingWikiWord{:href => "/nlab/show/monadicity+theorem"} monadicity theorem
              then applies. Colimits can be constructed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              and then reflected into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} T Alg
          %p
            It is possible to
            %a.existingWikiWord{:href => "/nlab/show/beta-reduction"} beta-reduce
            this proof and describe the resulting transfinite construction more explicitly. Given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B,a)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi T
                          %msub
                            %mi X
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %mi T
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi T
                          %msub
                            %mi X
                            %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %mi …
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi x
                                %mn 0
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi x
                                %mn 1
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi x
                                %mn 2
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 0
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mn 3
                        %mtd
                          %mo →
                        %mtd
                          %mi …
                %annotation{:encoding => "application/x-tex"}
                  \\array{ &amp;&amp; T X_0 &amp; \to &amp; T X_1 &amp; \to &amp; T X_2 &amp; \to &amp; \dots \\
                  \&amp;&amp; \downarrow^{x_0} &amp;&amp; \downarrow^{x_1} &amp;&amp; \downarrow^{x_2} \\
                  X_0 &amp; \to &amp; X_1 &amp; \to &amp; X_2 &amp; \to &amp; X_3 &amp; \to &amp; \dots }
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi β
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} X_\beta \to X_{\beta+1}
            is equal to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi β
                    %mo ∘
                    %msub
                      %mi τ
                      %mrow
                        %msub
                          %mi X
                          %mi β
                  %annotation{:encoding => "application/x-tex"} x_\beta \circ \tau_{X_\beta}
          %p
            We begin with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X_0=A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"} X_1=B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x_0 = a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi β
                %annotation{:encoding => "application/x-tex"} X_\beta
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{\beta+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                  %mo :
                  %mi T
                  %msub
                    %mi X
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mi β
                      %mo +
                      %mn 2
                %annotation{:encoding => "application/x-tex"} x_{\beta+1}:T X_{\beta+1}\to X_{\beta+2}
            to be the coequalizer of the two composites
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %msub
                    %mi X
                    %mi β
                  %mspace{:width => "thickmathspace"}
                  %munderover
                    %mo ⇉
                    %mrow
                      %mi T
                      %mi τ
                    %mrow
                      %mi τ
                      %mi T
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi T
                    %mn 2
                  %msub
                    %mi X
                    %mi β
                  %mover
                    %mo →
                    %mrow
                      %mi T
                      %msub
                        %mi x
                        %mi β
                  %mi T
                  %msub
                    %mi X
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} T X_\beta \;\underoverset{T \tau}{\tau T}{\rightrightarrows}\; T^2 X_\beta \xrightarrow{T x_\beta} T X_{\beta+1}.
          %p
            At limit ordinals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            we take colimits, and at successors of limit ordinals we let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi α
                  %mo :
                  %mi T
                  %msub
                    %mi X
                    %mi α
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mi α
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} x_\alpha : T X_\alpha \to X_{\alpha+1}
            be the coequalizer of the two maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                            %mrow
                              %mi β
                              %mo &lt;
                              %mi α
                          %msub
                            %mi X
                            %mrow
                              %mi β
                              %mo +
                              %mn 1
                          %mo =
                          %msub
                            %mi X
                            %mi α
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mi τ
                      %mtr
                        %mtd
                          %msub
                            %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                            %mrow
                              %mi β
                              %mo &lt;
                              %mi α
                          %mi T
                          %msub
                            %mi X
                            %mi β
                        %mtd
                        %mtd
                          %mo →
                        %mtd
                        %mtd
                          %mi T
                          %msub
                            %mi X
                            %mi α
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{ &amp;&amp; \colim_{\beta\lt\alpha} X_{\beta+1} = X_\alpha \\
                  \&amp; \nearrow &amp;&amp; \searrow^{\tau} \\
                  \\colim_{\beta\lt\alpha} T X_\beta &amp;&amp; \to &amp;&amp; T X_\alpha.}
          .num_example
            %h6#example_3 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              consists of building the free monad on a pointed endofunctor.
          %h2#free_algebras_for_unpointed_endofunctors Free algebras for unpointed endofunctors
          %p
            An algebra for an unpointed endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the same as an algebra for the pointed endofunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≔
                    %mi Id
                    %mo +
                    %mi H
                  %annotation{:encoding => "application/x-tex"} T \coloneqq Id + H
            %a.maruku-ref{:href => "#PointedAlgebras"}
            can be applied to unpointed endofunctors as well.
          %p
            In this case, the transfinite sequence for the free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            is much simpler: we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                  %mo =
                  %mi A
                %annotation{:encoding => "application/x-tex"} X_0 = A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi β
                        %mo +
                        %mn 1
                    %mo =
                    %mi A
                    %mo +
                    %mi H
                    %msub
                      %mi X
                      %mi β
                  %annotation{:encoding => "application/x-tex"} X_{\beta+1} = A + H X_\beta
          .num_example
            %h6#example_4 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/W-type"} W-type
              in a category is an initial algebra for a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/polynomial+functor"} polynomial functor
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inductive+types"} inductive types
          %h2#colimits_of_algebras_for_a_monad Colimits of algebras for a monad
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be a monad on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} T Alg
            denote the category of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %em qua
            monad.
          #MonadAlgebras.num_theorem
            %h6#theorem_3 Theorem
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              is a reflective subcategory of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
          .proof
            %h6#proof_8 Proof
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} (A,B,a)\in T/\mathcal{A}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi T
                              %mn 2
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi μ
                          %mtd
                            %mi T
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %mi T
                                %mi a
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi T
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi c
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ T^2 A &amp; \xrightarrow{\mu} &amp; T A \\
                    ^{T a}\downarrow &amp;&amp; \downarrow\\
                    T B &amp; \xrightarrow{c} &amp; D }
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} L:T/\mathcal{A}\to T/\mathcal{A}
              to take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B,a)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi D
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,D,c)
              in this pushout. Then
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %em qua
              pointed endofunctor) are precisely
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %em qua
              monad), and we have a pointwise epimorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo →
                      %mi L
                    %annotation{:encoding => "application/x-tex"} S\to L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the well-pointed endofunctor from the proof of Theorem
              %a.maruku-ref{:href => "#PointedAlgebras"}
              whose algebras are the
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %em qua
              pointed endofunctor). Thus, by Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#WellPointedQuotient"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is well-pointed; now apply Theorem
              = succeed "." do
                %a.maruku-ref{:href => "#WellPointedFreeAlgebras"}
          .num_cor
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              is locally presentable. Moreover, any functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                    %mo →
                    %mi T
                    %mo ′
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg \to T' Alg
              induced by a monad morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ′
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T'\to T
              has a left adjoint.
          .proof
            %h6#proof_9 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} T Alg
              is reflective in the cocomplete
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              %a.existingWikiWord{:href => "/nlab/show/accessible+category"} accessible
              by the
              = succeed "," do
                %a{:href => "/nlab/show/accessible+category#Limits"} limit theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                    %mo →
                    %mi T
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} T/\mathcal{A} \to T'/\mathcal{A}
              has an easily defined left adjoint; now compose it with the reflection into
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
          %h2#ColimitsOfMonads Colimits of monads
          %p
            When speaking of colimits of monads, we are not interested merely in colimits in the category of monads, but
            %em algebraic colimits
            in the following sense. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo :
                  %mi K
                  %mo →
                  %mi Monad
                  %mo{:stretchy => "false"} (
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V:K\to Monad (\mathcal{A})
            be a diagram in the category of monads on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              \-algebra
            to be an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            together with
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi k
                  %annotation{:encoding => "application/x-tex"} V_k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          .num_defn
            %h6#definition_3 Definition
            %p
              An
              %strong algebraic colimit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              whose usual
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} P Alg
              is equivalent, over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          %p
            It follows, by arguments similar to those for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraically-free+monads"} algebraically-free monads
          #ColimitsOfMonads.num_theorem
            %h6#theorem_4 Theorem
            %p Algebraic colimits of (accessible) monads exist (and are accessible).
          .proof
            %h6#proof_10 Proof
            %p
              WLOG we may assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              has an initial object; otherwise, give it a new initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              and define
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 0
                      %mo =
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} V_0 = Id
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be the (pointwise) colimit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              in the category of endofunctors of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi k
                      %mo :
                      %msub
                        %mi V
                        %mi k
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} r_k:V_k \to T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              gives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              a unique point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo →
                    %msub
                      %mi V
                      %mn 0
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} Id \to V_0 \to T
              such that each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi k
                  %annotation{:encoding => "application/x-tex"} r_k
              is a map of pointed endofunctors. Moreover, a
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %em qua
              pointed endofunctor) is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              together with compatible pointed-endofunctor-algebra structures for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi k
                    %annotation{:encoding => "application/x-tex"} V_k
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              We will show the category of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B,a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi T
                    %mi B
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} c:T B \to D
              be the joint coequalizer of all the parallel pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi V
                              %mi k
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msub
                                  %mi μ
                                  %mi k
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mrow
                                %msub
                                  %mi V
                                  %mi k
                                %msub
                                  %mi τ
                                  %mi k
                        %mtr
                          %mtd
                            %msubsup
                              %mi V
                              %mi k
                              %mn 2
                            %mi A
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi id
                          %mtd
                          %mtd
                            %msubsup
                              %mi V
                              %mi k
                              %mn 2
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi V
                                  %mi k
                                %mo{:stretchy => "false"} (
                                %mi a
                                %msub
                                  %mi r
                                  %mi k
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi V
                              %mi k
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi r
                                  %mi k
                            %mi T
                            %mi B
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ &amp;&amp; V_k A \\
                    \&amp; ^{\mu_k}\nearrow &amp;&amp; \searrow^{V_k \tau_k}\\
                    V_k^2 A &amp;&amp; \xrightarrow{id} &amp;&amp; V_k^2 A &amp;
                    \\xrightarrow{V_k (a r_k)} &amp; V_k B &amp; \xrightarrow{r_k } T B. }
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi D
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(A,B,a) \coloneqq (B,D,c)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} /
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} T/\mathcal{A}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is accessible, and an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              admits an epimorphic transformation from the well-pointed endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              defined as in Theorem
              %a.maruku-ref{:href => "#PointedAlgebras"}
              whose algebras are the
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
