          %h2#idea Idea
          %p
            The notion of
            %em
              reflective
              = succeed "-subcategory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            is the generalization of the notion of
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            from
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            to
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory.
          %h2#definition Definition
          %h3#reflective_subcategory
            Reflective sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-category
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong (local objects, local equivalences)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi D
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    R : D \hookrightarrow C
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              as a
              %strong
                reflective
                %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              (of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} L : C \to D
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi D
                    %mover
                      %munder
                        %mo ↪
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R) : D \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\hookrightarrow}}
                    C
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              moreover is a left
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
              in that it preserves
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              = succeed "." do
                %strong exact
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            or its composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Loc
                  %mo :
                  %mo =
                  %mi R
                  %mo ∘
                  %mi L
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  Loc := R \circ L : C \to C
          %p
            may be understood as exhibiting a
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            at those morphisms that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            sends to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            preserves
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
            %strong exact localization
          %h3#LocalObjects Local objects and local morphisms
          %p
            One finds, as discussed
            = succeed "," do
              %a{:href => "#Properties"} below
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Loc
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} Loc : C \to C
            sends to weak equivalences.
          .num_defn
            %h6#definition_3 Definition
            %p
              %strong (local objects, local equivalences)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              be a class of morphisms.
            %ul
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} c \in C
                  is called an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
                  if for all morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} f : x \to y
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  the induced morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_C(f,c) : Hom_C(y,c) \to Hom_C(x,c)
                %p
                  is an equivalence (of
                  = succeed "s)." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %li
                %p
                  An morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} f : x \to y
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is called an
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/local+morphism"} local morphism
                  or
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/local+equivalence"} local equivalence
                  if for all
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} c  \in C
                  we have that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_C(f,c) : Hom_C(y,c) \to Hom_C(x,c)
                %p
                  is an equivalence (of
                  = succeed "s)." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            Notice that the class of
            = succeed "-equivalences" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            itself. Hence passing from a collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to its class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi S
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar S
            of
            = succeed "-equivalences" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %a{:href => "#Properties"} below
          .num_defn
            %h6#definition_4 Definition
            %p
              %strong (strongly saturated class of morphisms)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              with small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %msub
                      %mi C
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S \subset C_1
              of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is said to be
              %strong strongly saturated
              if its satisfies the following three conditions
            %ol
              %li
                %p
                  It is stable under
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
              %li
                %p
                  The full
                  %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Func
                        %mo{:stretchy => "false"} (
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Func(\Delta[1], C)
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  has all
                  = succeed "s;" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %li
                %p
                  it satisfies the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3 property
          %p Notice that this definition has some immediate consequences:
          %p
            The identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi ∅
                %annotation{:encoding => "application/x-tex"} Id_\emptyset
            on the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func(\Delta[1],C)
            is in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
            is a
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mi ∅
                %annotation{:encoding => "application/x-tex"} Id_{\emptyset}
            so
          %ul
            %li
              A strongly saturated class contains every
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          %p
            Given any collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mi i
                %annotation{:encoding => "application/x-tex"} \{S_i\}_i
            of strongly saturated classes of morphisms in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of morphisms, there is a smallest strongly saturated class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi S
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar S
            containing it. We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            %strong generates
            the strongly saturated class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi S
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi S
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar S
            is said to be
            = succeed "." do
              %strong of small generation
          %p
            The smallest strongly saturated class of morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is that containing only the equivalences of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p Of importance are the strongly saturated classes arising as follows.
          .num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              two
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F : C \to D
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              that preserves small
              = succeed "-colimits," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F^{-1}(S)
              is a strongly saturated class in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              In particular the class of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              sent to equivalences by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is strongly saturated.
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              The class of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+equivalence"} local equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S_0
              any class of morphisms is strongly saturated.
          .proof
            %h6#proof Proof
            %p
              For each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo →
                    %mn ∞
                    %msup
                      %mi Grpd
                      %mi op
                  %annotation{:encoding => "application/x-tex"} j(c) : C \to \infty Grpd^{op}
              be the functor
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi c
                  %annotation{:encoding => "application/x-tex"} S_c
              be the class of morphisms sent by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(c)
              to weak equivalences in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(c)
              preserves small colimits, this is a strongly saturated class, by the above lemma. Now observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msub
                      %mo ∩
                      %mi c
                    %msub
                      %mi S
                      %mi c
                  %annotation{:encoding => "application/x-tex"} S = \cap_c S_c
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              ranges over the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
          %p
            In the following this language of local morphisms is used to characterize reflective
            = succeed "-subcategories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#Properties Properties
          %h3#CharacterizationOfReflectors Characterization of reflectors
          %p
            The following proposition characterizes the
            %em reflectors
            of a reflective
            = succeed "-subcategory." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            via
            %a.existingWikiWord{:href => "/nlab/show/universal+arrows"} universal arrows
            (via
            = succeed ")," do
              %a{:href => "adjoint+functor#CollectionOfUniversalArrowsEquivalentToAdjointFunctor"} this prop.
            = succeed "-adjunction.)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          #UniversalityOfReflectionCounit.num_lemma
            %h6#lemma_3 Lemma
            %p
              %strong (universality of reflection counit)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D \hookrightarrow C
              a full
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              precisely if
            %ul
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} c \in C
                  there is a
                  %em localization
                  or
                  = succeed ":" do
                    %em reflection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi c
                        %mo →
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} f : c \to \bar c
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ¯
                        %mo ∈
                        %mi D
                        %mo ↪
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \bar c \in D\hookrightarrow C
                  and such that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi D
                        %mo ↪
                        %mi C
                      %annotation{:encoding => "application/x-tex"} e \in D \hookrightarrow C
                  we have that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi c
                          %mo{:stretchy => "false"} ¯
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Hom_C(f,e) : Hom_C(\bar c,e) \to Hom_C(c,e)
                %p
                  is an equivalence (of
                  = succeed "s)." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.2.7.8
          .proof
            %h6#proof_2 Proof
            %p
              We produce an evident
              %a.existingWikiWord{:href => "/nlab/show/cograph+of+a+functor"} cograph
              realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              of the inclusion and check that it being also a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              as a right adjoint, is equivalent to the second statement.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi C
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K \subset C \times \Delta[1]
              be the full subcategory on those objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c,i)
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} c \in D
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi K
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p : K \to \Delta[1]
              be the induced projection. One checks that this is the correspondence which is
              %a{:href => "http://ncatlab.org/nlab/show/(infinity,1)-Grothendieck+construction#FibsOverInterval"} associated to the inclusion functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ↪
                      %mi C
                    %annotation{:encoding => "application/x-tex"} D \hookrightarrow C
            %p
              Therefore by the properties of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is not only a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              but also a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
            %p
              To see that this is the case precisely if every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              has a reflection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi c
                      %mo →
                      %mi d
                    %annotation{:encoding => "application/x-tex"} f : c \to d
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+morphism"} coCartesian morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde f : (c,0) \to (d,1)
              as those making the squares
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi K
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi Hom
                                  %mi K
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                                %mo ,
                                %mo{:stretchy => "false"} (
                                %mi e
                                %mo ,
                                %mi i
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msub
                              %mi Hom
                              %mi K
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mi Δ
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mi Δ
                                %mo{:stretchy => "false"} [
                                %mn 1
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_K((d,1),(e,i)) &amp;\stackrel{Hom_K(\tilde f,(e,i))}{\to} &amp; Hom_K((c,0),(e,i))
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    Hom_{\Delta[1]}(1, i)
                    \&amp;\stackrel{}{\to}&amp;
                    Hom_{\Delta[1]}(0, i)
                    }
            %p
              being
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              squares, for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} (e,i) \in K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
              all
              %a.existingWikiWord{:href => "/nlab/show/hom-object+in+a+quasi-category"} hom-objects
              are either empty or are points, so that the bottom morphism becomes the identity on the point if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i = 0
              everything becomes entirely trivial we consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i =1
              and hence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} e \in D
            %p In that case the homotopy-pullback property is equivalent to the top morphism being an equivalence, hence to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(d,e) \stackrel{Hom_C(f,e)}{\to}  Hom_C(c,a)
            %p
              being an equivalence. This way the reflectors are identified precisely with the coCartesian morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K \to \Delta[1]
              that exhibit the left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              to the inclusion functor.
          %p
            The following proposition asserts that localizations are entirely determined by the corresponding
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
          .num_prop
            %h6#proposition Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mover
                      %munder
                        %mo ↪
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    D \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\hookrightarrow}} C
            %p
              be a localization of the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mi L
                    %mi D
                    %mover
                      %mo ↪
                      %mi R
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    Loc : C \stackrel{L}{\to} D \overset{R}{\hookrightarrow} C
            %p
              be the corresponding localization
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-monad"} (∞,1)-monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              for the collection of morphisms that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                  %annotation{:encoding => "application/x-tex"} Loc
              sends to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalences
            %p Then
            %ul
              %li
                %p
                  an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} c \in C
                  is an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
                  precisely if it is in the essential image of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Loc
                      %annotation{:encoding => "application/x-tex"} Loc
                  (equivalent to an object of the form
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Loc
                          %mi x
                        %annotation{:encoding => "application/x-tex"} Loc x
              %li
                %p
                  every
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  %a.existingWikiWord{:href => "/nlab/show/local+morphism"} local morphism
                  is already in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 5.5.4.2
          .proof
            %h6#proof_3 Proof
            %p
              The reasoning is entirely analogous to the 1-categorical case (see for instance
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              and
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %p
              First notice that because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D \hookrightarrow C
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              we have that the counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi R
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Id
                      %mi D
                  %annotation{:encoding => "application/x-tex"} L R \stackrel{\simeq}{\to} Id_D
              is an equivalence. From this it follows that precomposition with the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi z
                    %mo :
                    %mi z
                    %mo →
                    %mi Loc
                    %mi z
                  %annotation{:encoding => "application/x-tex"} i_z : z \to Loc z
              of morphisms in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                  %annotation{:encoding => "application/x-tex"} Loc
              is a weak equivalence: for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ,
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} z,x \in C
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi z
                    %mo ,
                    %mi Loc
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi Loc
                    %mi z
                    %mo ,
                    %mi Loc
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %mi Loc
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(i_z, Loc z)
                    \:
                    Hom_C(Loc z, Loc x)
                    \\stackrel{\simeq}{\to}
                    Hom_C(z, Loc x)
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is itself in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Loc
                    %annotation{:encoding => "application/x-tex"} Loc
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo →
                    %mi Loc
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z \to Loc z
              is an isomorphism on
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Loc
                      %mi C
                    %annotation{:encoding => "application/x-tex"} Loc C
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              is itself an isomorphism in the homotopy category, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi z
                    %mo :
                    %mi z
                    %mo →
                    %mi Loc
                    %mi z
                  %annotation{:encoding => "application/x-tex"} i_z : z \to Loc z
              is a weak equivalence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              is itself in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Loc
                    %annotation{:encoding => "application/x-tex"} Loc
            %p
              Applying this statement to the naturality square for the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo →
                    %mi Loc
                  %annotation{:encoding => "application/x-tex"} Id \to Loc
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi s
                  %annotation{:encoding => "application/x-tex"} i_s
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi s
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mi s
                          %mtd
                            %mi Loc
                            %mi s
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi s
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Loc
                                  %msub
                                    %mi i
                                    %mi s
                        %mtr
                          %mtd
                            %mi Loc
                            %mi s
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi i
                                  %mrow
                                    %mi Loc
                                    %mi s
                          %mtd
                            %mi Loc
                            %mi Loc
                            %mi s
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    s &amp;\stackrel{i_s}{\to} &amp; Loc s
                    \\\
                    \\downarrow^{\mathrlap{i_s}} &amp;&amp; \downarrow^{\mathrlap{Loc i_s}}
                    \\\
                    Loc s &amp;\stackrel{i_{Loc s}}{\to}&amp; Loc Loc s
                    }
            %p
              we find that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Loc
                      %msub
                        %mi i
                        %mi s
                      %mo ≃
                      %msub
                        %mi i
                        %mrow
                          %mi Loc
                          %mi s
                    %annotation{:encoding => "application/x-tex"} Loc i_s \simeq i_{Loc s}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %msub
                      %mi i
                      %mi s
                  %annotation{:encoding => "application/x-tex"} Loc i_s
              is a weak equivalence, and hence that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi s
                  %annotation{:encoding => "application/x-tex"} i_s
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} s \in C
            %p
              Now to show that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi x
                  %annotation{:encoding => "application/x-tex"} Loc x
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi y
                    %mo →
                    %mi z
                  %annotation{:encoding => "application/x-tex"} f : y \to z
              be in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              and consider the induced square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi Loc
                            %mi z
                            %mo ,
                            %mi Loc
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi Loc
                            %mi y
                            %mo ,
                            %mi Loc
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi z
                            %mo ,
                            %mi Loc
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ,
                            %mi Loc
                            %mi x
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_C(Loc z, Loc x) &amp;\stackrel{\simeq}{\to}&amp; Hom_C(Loc y, Loc x)
                    \\\
                    \\downarrow^{\mathrlap{\simeq}} &amp;&amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    Hom_C(z, Loc x) &amp;\to&amp; Hom_C(y, Loc x)
                    }
                    \\,.
            %p
              Here the vertical morphisms are equivalences by the above remark, and the top morphism is an equivalence by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi x
                  %annotation{:encoding => "application/x-tex"} Loc x
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x \in C
            %p
              Conversely, to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} s \in C
              an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is in the essential image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                  %annotation{:encoding => "application/x-tex"} Loc
              use that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi s
                    %mo :
                    %mi s
                    %mo →
                    %mi Loc
                    %mi s
                  %annotation{:encoding => "application/x-tex"} i_s : s \to Loc s
              is in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mi s
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi Loc
                      %mi s
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_C(i_s, s) : Hom_C(Loc s, s) \stackrel{\simeq}{\to} Hom_C(s,s)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi s
                    %mo →
                    %mi s
                  %annotation{:encoding => "application/x-tex"} Loc s \to s
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo →
                      %mi Loc
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s \to Loc s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi s
                    %mo →
                    %mi s
                  %annotation{:encoding => "application/x-tex"} Loc s \to s
              is itself in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (since the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              evidently satisfy
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-three
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi s
                    %mo →
                    %mi s
                  %annotation{:encoding => "application/x-tex"} Loc s \to s
              has itself a left inverse. That implies that it is actually an inverse of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo →
                      %mi Loc
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s \to Loc s
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is indeed in the essential iamge of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Loc
                    %annotation{:encoding => "application/x-tex"} Loc
            %p
              Finally, to show that every
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f : x \to y
              be such an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi x
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mi y
                        %mtr
                          %mtd
                            %mi Loc
                            %mi x
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi Loc
                                %mi f
                          %mtd
                            %mi Loc
                            %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x &amp;\stackrel{f}{\to}&amp; y
                    \\\
                    \\downarrow^{\mathrlap{i_x}} &amp;&amp; \downarrow^{\mathrlap{i_y}}
                    \\\
                    Loc x &amp;\stackrel{Loc f}{\to}&amp; Loc y
                    }
                    \\,.
            %p
              By the above we know now that the vertical morphisms here are also
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Loc
                    %mi f
                    %mo :
                    %mi Loc
                    %mi x
                    %mo →
                    %mi Loc
                    %mi y
                  %annotation{:encoding => "application/x-tex"} Loc f : Loc x \to Loc y
              on the homotopy category of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Loc
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Loc C)
              corepresents an isomorphism, hence by the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lof
                    %mi f
                  %annotation{:encoding => "application/x-tex"} Lof f
              is a weak equivalence. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is indeed in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %h3#reflective_localization_at_a_set_of_morphisms Reflective localization at a set of morphisms
          %p
            Above is discussed that every reflective subcategory is the localization at the collection local morphisms, those which the left adjoint functor inverts. One can turn this around and define or construct reflective
            = succeed "-subcategories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          #LocalizationProposition.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (localization proposition)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S_0
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              of morphisms of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              Then the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi D
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    R : D \hookrightarrow C
            %p
              on
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              = succeed "-subcategory." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} L : C \to D
              denotes the left
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              of the inclusion, then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in Mor(C)
              a morphism, the following are equivalent
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} S_0
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/local+equivalence"} local equivalence
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  belongs to the strongly saturated class
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  generated by
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} S_0
              %li
                %p
                  the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mi f
                      %annotation{:encoding => "application/x-tex"} L f
                  is an equivalence.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.5.4.15
          %p
            The main ingredient in the proof of this assertion is the following lemma, whose proof we give below in
            = succeed "." do
              %a{:href => "#ProofOfLocalization"} Proof of the localization lemma
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (localization lemma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              be a strongly saturated collection of morphisms, generated from a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
            %p
              Then for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              there exists a reflector, i.e. a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} f \in S
          %p With that in hand we look at the proof of the above proposition:
          .proof
            %h6#proof_4 Proof
            %p (localization proposition)
            %p
              The localization lemma gives for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              a reflector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              = succeed "-local." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.maruku-ref{:href => "#UniversalityOfReflectionCounit"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mover
                      %munder
                        %mo ↪
                        %mi R
                      %mover
                        %mo ←
                        %mi L
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    D \stackrel{\overset{L}{\leftarrow}}{\underset{R}{\hookrightarrow}} C
            %p
              of the full subcateory of
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              It remains to prove the statements about the role of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              in the localization:
            %p
              First, by one of the above lemmas, we have that the
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              That the first and the third condition are equivalent follows from noticing that for any local object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi R
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_C(f,R d)
              is an equivalence precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi f
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_D(L f, d)
              is and then applying the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (for instance in the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28infinity%2C1%29-category"} homotopy category
            %p
              It remains to show that the third item implies the second. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              be a morphism such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mi f
                    %mo :
                    %mi L
                    %mi c
                    %mo →
                    %mi Ld
                  %annotation{:encoding => "application/x-tex"} L f : L c \to Ld
              is an equivalence. Consider the commuting triangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi d
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi L
                            %mi c
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi L
                                %mi f
                          %mtd
                            %mi L
                            %mi d
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c &amp;\stackrel{f}{\to}&amp; d
                    \\\
                    \\downarrow &amp;\searrow&amp; \downarrow
                    \\\
                    L c &amp;\stackrel{L f}{\to}&amp; L d
                    }
                    \\,.
            %p
              Since every reflector is in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and the reflectors are the units of the reflective adjunction constructed from them, we have that the vertical morphisms in this diagram are in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              twice it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %h3#ProofOfLocalization Proof of the localization lemma
          %p We here spell out the proof of
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %strong (localization lemma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
              be a strongly saturated collection of morphisms, generated from a
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S_0
            %p
              Then for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              there exists a reflector, i.e. a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} f \in S
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.5.5.14
          .proof
            %h6#proof_5 Proof
            %p
              Regard all
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              for the purpose of this proof. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ⊂
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D \subset Func(\Delta[1], C)
              for the full sub-quasicategory on the elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi D
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi c
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo →
                          %mtd
                            %mi Func
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D_c &amp;\to&amp; D
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\{c\} &amp;\to&amp; Func(\{0\}, C)
                    }
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is by assumption closed under pushouts in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \to y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D \simeq Func(\{0\}, C)
              and each lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo →
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi x
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x &amp;\to&amp; y
                    \\\
                    \\downarrow
                    \\\
                    x'
                    }
            %p
              of its source to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(\Delta[1], C)
              a lift of this morphism with this source, given by the the pushout square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo →
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi x
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi x
                            %mo ′
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi x
                            %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x &amp;\to&amp; y
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    x' &amp;\to&amp; x' \coprod_x y
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func(\Delta[1], C)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+morphism"} coCartesian lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo →
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi C
                  %annotation{:encoding => "application/x-tex"} D \to Func(\{0\}, C) \simeq C
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coCartesian+fibration"} coCartesian fibration
              %a{:href => "http://ncatlab.org/nlab/show/Cartesian+fibration#BehaviourUnderPullback"} behaviour under pullback
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              diagram in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} Joyal model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Joyal
                    %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
            %p
              Use now that
              %a.existingWikiWord{:href => "/nlab/show/accessible+%28infinity%2C1%29-category"} accessible quasi-categories
              are stable under
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              to conclude that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi c
                  %annotation{:encoding => "application/x-tex"} D_c
              is accessible. Moreover, one can check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi c
                  %annotation{:encoding => "application/x-tex"} D_c
              has all small colimits. Together this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi c
                  %annotation{:encoding => "application/x-tex"} D_c
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi c
                  %annotation{:encoding => "application/x-tex"} D_c
              also has all small
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              and hence contains a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+a+quasi-category"} terminal object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi c
                      %mo →
                      %mi d
                    %annotation{:encoding => "application/x-tex"} f : c \to d
            %p
              We now complete the proof by showing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              being terminal in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi c
                  %annotation{:encoding => "application/x-tex"} D_c
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} t : a \to b
              any element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(t,d) : Hom_C(b,d) \to Hom_C(a,d)
                    \\,.
            %p
              This in turn may be checked
              %a{:href => "http://ncatlab.org/nlab/show/fiber+sequence#CharOfEquivalences"} by
              checking that all its
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              %a{:href => "http://ncatlab.org/nlab/show/fiber+sequence#OfFuncCats"} homotopy fiber of functor categories
              the homotopy fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_C(t,d)
              over a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi a
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} g : a \to d
              of
