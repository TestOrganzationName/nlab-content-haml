              is an
              %a.existingWikiWord{:href => "/nlab/show/accessible+%28%E2%88%9E%2C1%29-functor"} accessible
              reflective inclusion with reflector
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:lspace => "verythinmathspace"} :
