          %h3#TransportOfReflectiveSubcategories Transport of reflective subcategories
          #TransportOfReflectionAlongAdjunction.num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
