            %p
              %br/
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/knots"} knots
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/braids"} braids
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/chord+diagram"}> chord diagram
                    ,
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagram"} Jacobi diagram
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagram"} horizontal chord diagram
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/1T+relation"}> 1T
                    \&amp;
                    %a{:href => "4T+relation#ForCircularChordDiagrams"} 4T relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/2T+relation"}> 2T
                    \&amp;
                    %a{:href => "4T+relation#ForHorizontalChordDiagrams"}> 4T relation
                    \/
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+braid+relations"} infinitesimal braid relations
                %tr
                  %td{:style => "text-align: left;"}
