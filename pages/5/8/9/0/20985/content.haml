          %h2#idea Idea
          %p
            Where a
            %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
            on
            %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/weight+system"} weight system
            on
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            (since
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/chord+diagrams+modulo+4T+are+Jacobi+diagrams+modulo+STU"} chord diagrams modulo 4T are Jacobi diagrams modulo STU
            = succeed "-factors" do
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude"} Feynman amplitude
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons-
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            (in the presence of a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Wilson+loop"} Wilson loop
            %em stringy weight system
            assigns such amplitude factors instead to the
            %a.existingWikiWord{:href => "/nlab/show/ribbon+graph"} ribbon graph
            %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
            of
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            %a.existingWikiWord{:href => "/nlab/show/worldsheets"} worldsheets
            which become
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            in the
            %a.existingWikiWord{:href => "/nlab/show/worldline+formalism"} point particle limit
            (
            %a{:href => "#BarNatan95"}> Bar-Natan 95, Theorem 10
            , see also
            = succeed ")" do
              %a{:href => "#Kneissler97"} Kneissler 97, Section 1.3
          %h2#details Details
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}
          #eq:LinearSpanOfMarkedSurfaces.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Span
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi MarkedSurfaces
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi Vect
                %annotation{:encoding => "application/x-tex"}
                  Span\big( MarkedSurfaces_{/\sim} \big)
                  \\;\in\;
                  Vect
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            of the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
