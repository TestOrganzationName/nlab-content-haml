                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#generalizations"} Generalizations
              %li
                %a{:href => "#details"} Details
              %ul
                %li
                  %a{:href => "#preliminaries"} Preliminaries
                %li
                  %a{:href => "#grothendiecks_axioms"} Grothendieck’s axioms
              %li
                %a{:href => "#the_classical_case_of_fields"} The classical case of fields
              %li
                %a{:href => "#galois_theorem_for_locales_and_topoi"} Galois theorem for locales and topoi
              %li
                %a{:href => "#related_entries"} Related entries
