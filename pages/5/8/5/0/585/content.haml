                    %msub
                      %mi V
                      %mi n
                  %annotation{:encoding => "application/x-tex"} V_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} P_n
            in his definition came from one master operad
            = succeed "," do
