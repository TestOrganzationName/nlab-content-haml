          %p because of Adamek’s theorem that the limit
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo →
                  %msup
                    %mi E
                    %mi n
                  %mn 1
                  %mo →
