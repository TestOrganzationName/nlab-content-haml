                %annotation{:encoding => "application/x-tex"} \dots \to E^n 1 \to \dots \to E^2 1 \to E 1 \to 1
          %p
            always produces a terminal
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            preserves limits of sequences of this form. In our case,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi n
                  %mo !
                %annotation{:encoding => "application/x-tex"} E^n !
            works out to be the usual globular truncation from
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo :
                  %mo{:stretchy => "false"} ⟨
                  %mi V
                  %mo ,
                  %mi Π
                  %mo{:stretchy => "false"} ⟩
                  %mo ↦
                  %mo{:stretchy => "false"} ⟨
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi Π
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi Cat
                  %mo ,
                  %msup
                    %mi Π
                    %mo +
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} E: \langle V, \Pi \rangle \mapsto \langle (V, \Pi)-Cat, \Pi^+ \rangle
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo :
                  %mi Top
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} \Pi: Top \to V
            preserves finite products (and coproducts), where
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, \Pi)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            is the category of
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,\Pi(T))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Π
                    %mo +
                %annotation{:encoding => "application/x-tex"} \Pi^+
            takes a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mo ∼
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X^\sim)
            as a
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,\Pi(T))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi n
                  %mo !
                %annotation{:encoding => "application/x-tex"} E^n !
            works out to be precisely the globular truncation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Dec
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mo →
                  %mi Dec
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Dec(n+1)Cat \to Dec(n)Cat
          %p
            and so the terminal
            = succeed "-coalgebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Trimble
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Trimble(\omega)Cat
            as described above, equipped with the fundamental
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mi ω
                  %mo :
                  %mi Top
                  %mo →
                  %mi Trimble
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \Pi_\omega: Top \to Trimble(\omega)Cat
          %h3#Coinductive As a coinductive definition
          %p
            It is often convenient to reason about terminal coalgebras using
            %a.existingWikiWord{:href => "/nlab/show/coinduction"} coinduction
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/corecursion"} corecursion
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mi Cat
                  %mo =
                  %mi Trimble
                  %mi ω
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \omega Cat = Trimble \omega Cat
            and a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Top
                    %mo →
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \Pi\colon Top \to \omega Cat
          %ul
            %li
              An object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \omega Cat
              (that is, a Trimble
              = succeed "-category)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mi Cat
                      %mo ,
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\omega Cat,\Pi(T))
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} \omega Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with composition operations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi …
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(T)_n \times X(x_0, x_1) \times \ldots X(x_{n-1}, x_n) \to X(x_0, x_n)
              satisfying the evident axioms.
            %li
              Similarly, a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \omega Cat
              is a (strict)
              = succeed "-functor," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mi Cat
                      %mo ,
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\omega Cat,\Pi(T))
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} \omega Cat
              = succeed "-structure." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(T)
            %li
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              takes a space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mo ∼
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(X^\sim)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mo ∼
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(X^\sim(x,y))
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(T)
          %p
            This sort of coinductive definition is that used in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/calculus+of+coinductive+constructions"} calculus of coinductive constructions
          %h2#CatTheory
            Category theory for Trimble
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs
              \:
            %p
              suppose I wanted to serious apply the Trimble
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              The main reason why
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-categories
              and other models for
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-categories
              are popular is that Joyal and Lurie showed that beyond just having a definition, one can
              %em do category theory
              with them. I would like to understand to which extent we know how to “do category theory” with Trimble
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              I understand that much of this will remain to be worked out, but probably in particular
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd
              has many ideas about how one should go about approaching this. I’d be interested in whatever idea or tentative suggestion there is.
            %p So:
            %p What can be said about
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/universal+construction"}> universal construction
                  s
                %ul
                  %li
                    definition of
                    = succeed "/weak" do
                      %a.existingWikiWord{:href => "/nlab/show/weak+limit"} weak limit
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                    %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            %p
              43 in Trimble
              = succeed "-catgeories?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              For instance for what I am doing I’d need in particular weak pullbacks and the resulting
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/fibration+sequence"} fibration sequence
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              What is known about the reflection of Trimble
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %ul
              %li
                %p
                  Is there a definition of Trimble
                  = succeed "-categorry" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n+1)
                  = succeed "-categories?" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  A Trimble
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed "-categories?" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
            %p What is the relation to
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+for+weak+omega-categories"}> simplicial models for weak omega categories
                  ,
                %ul
                  %li
                    %p
                      do we have a notion of
                      %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
                      of a Trimble
                      = succeed "-category?" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi n
                            %annotation{:encoding => "application/x-tex"} n
                  %li
                    %p
                      can we characterize the nerves of Trimble
                      = succeed "-categories?" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi n
                            %annotation{:encoding => "application/x-tex"} n
            %p
              Probably we want to define the cosimplicial Trimble
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              to the fundamental Trimble
              = succeed "-path" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-groupoidal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed
              Trimble path
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              What can be said about
              = succeed "-cases" do
                %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
