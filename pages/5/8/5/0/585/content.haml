                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo &gt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} j \gt n
            to be identity cells, that is by taking the quotient of the set of
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} D^n \to X
            with respect to homotopy-equivalence rel boundary
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %msup
