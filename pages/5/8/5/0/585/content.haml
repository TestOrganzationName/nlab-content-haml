            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                    %mo =
                    %msub
                      %mi D
                      %mn 0
                    %mi T
                  %annotation{:encoding => "application/x-tex"} D_1 = D_0 T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mi n
                %annotation{:encoding => "application/x-tex"} D_n
            preserves coproducts and finite products by induction, starting with the base observation that the underlying set functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            preserves coproducts and finite products. Thus by induction we have a category of incoherent
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
