            %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
            out of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi X
                  %mover
                    %mo ⟶
                    %mrow
                      %mi fib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ev
                        %mo *
                      %mo{:stretchy => "false"} )
                  %mi ℒ
                  %mi X
