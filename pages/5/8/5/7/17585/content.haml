            is represented by the ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
          %p
          #SullivanModelForBasedLoopSpace.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
                for
                = succeed ")" do
