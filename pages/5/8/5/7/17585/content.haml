              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              and
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
              with
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
