                  X
                  \\,.
          %p
            With the dgc-algebra model from Prop.
            %a.maruku-ref{:href => "#SullivanModelForTheFreeLoopSpace"}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            it follows that the dgc-algebra model for the based loop space is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
            %a.existingWikiWord{:href => "/nlab/show/dgc-algebra"} dgc-algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mrow
                      %mi Ω
                      %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\wedge^\bullet( s V ), d_{\Omega X})
            in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mrow
                      %mi Ω
                      %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟵
                    %mrow
                      %mi cofib
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
