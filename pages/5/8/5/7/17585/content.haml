                      %msub
                        %mi ev
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ⊕
                  %mi s
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi d
                    %mrow
                      %mi ℒ
                      %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟵
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ev
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                  %mo{:stretchy => "false"} (
