                          %mi S
                          %mn 1
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Big(
                    \\wedge^\bullet(
                    V\oplus s V \oplus \langle \omega_2\rangle
                    )
                    ,\,
                    d_{\mathcal{L}X/S^1}
                    \\Big)
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ω
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \omega_2
                  is in degree 2;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi ℒ
                            %mi X
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} d_{\mathcal{L}X/S^1}
                  is defined on generators
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                        %mo ∈
                        %mi V
                        %mo ⊕
                        %mi s
                        %mi V
                      %annotation{:encoding => "application/x-tex"} w \in V\oplus s V
                  by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mrow
                            %mi ℒ
                            %mi X
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi S
                              %mn 1
                        %mi w
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi d
                          %mrow
                            %mi ℒ
                            %mi X
                        %mi w
                        %mo +
                        %msub
                          %mi ω
                          %mn 2
                        %mo ∧
                        %mi s
                        %mi w
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d_{\mathcal{L}X/S^1} w
                        \\;\coloneqq\;
                        d_{\mathcal{L}X} w + \omega_2 \wedge s w
                        \\,.
            %p
              Moreover, the canonical sequence of morphisms of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∧
                    %msub
                      %mi ω
                      %mn 2
                    %mo ,
                    %mi d
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⊕
                    %mi s
                    %mi V
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi ℒ
                        %mi X
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⊕
                    %mi s
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi ℒ
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\wedge \omega_2, d = 0)
                    \\longrightarrow
                    (\wedge^\bullet(  V\oplus s V \oplus \langle \omega_2\rangle ), d_{\mathcal{L}X/S^1})
                    \\longrightarrow
                    (\wedge^\bullet(  V\oplus s V ), d_{\mathcal{L}X})
            %p
              is a model for the
              %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi X
                    %mo ⟶
                    %mi ℒ
                    %mi X
                    %mo ⫽
                    %msup
                      %mi S
                      %mn 1
                    %mo ⟶
                    %mi B
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}X
                    \\longrightarrow
                    \\mathcal{L}X \sslash S^1
                    \\longrightarrow
                    B S^1
            %p
              which exhibits the
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
              (by the discussion there) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}X
          %p
            This is due to (
            %a{:href => "#VigueBurghelea85"}> Vigué-Burghelea 85, theorem A
            ).
          %p
          #SullivanModelOfCyclicLoopOfEm.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
                of
                %a.existingWikiWord{:href => "/nlab/show/cyclic+loop+space"} cyclic loop space
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} EM-space
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
              consider the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi B
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} X \,=\, B^{n+1} \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+classifying+space"} Sullivan model of a classifying space
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝔩
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi{:mathvariant => "normal"} d
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE\big(
                    \\mathfrak{l}
                    B^{n+1} \mathbb{Q}
                    \\big)
                    \\;\;
                    \=
                    \\;\;
                    \\mathbb{Q}[c_{n+1}]
                    \\big/
                    \\big(
                    \\mathrm{d} \, c_{n+1}  \;=\; 0
                    \\big)
                    \\,.
            %p
              Notice – from
              %a{:href => "free+loop+space+of+classifying+space#FreeLoopSpaceOfClassifyingSpaceOfSimplicialAbelianGroup"} this Prop
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+of+classifying+space"} free loop space of classifying space
              – that its
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              is the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℚ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi B
                      %mi n
                    %mi ℚ
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℚ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}
                    \\;
                    B^{n+1} \mathbb{Q}
                    \\;\simeq\;
                    B^{n} \mathbb{Q}
                    \\,\times\,
                    B^{n+1} \mathbb{Q}
                    \\,.
            %p
              Now Prop.
              %a.maruku-ref{:href => "#ModelForS1quotient"}
              shows that the corresponding
              %a.existingWikiWord{:href => "/nlab/show/cyclic+loop+space"} cyclic loop space
              is as in the middle item here:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mi n
                          %mi ℚ
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mover
                            %mover
                              %mrow
                                %mi ℒ
                                %mspace{:width => "thickmathspace"}
                                %msup
                                  %mi B
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                                %mi ℚ
                              %mo ⏞
                            %mrow
                              %msup
                                %mi B
                                %mi n
                              %mi ℚ
                              %mspace{:width => "thinmathspace"}
                              %mo ×
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi B
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mi ℚ
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mo ⫽
                          %msup
                            %mi S
                            %mn 1
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi B
                            %mi n
                          %mi ℚ
                      %mtr
                        %mtd
                          %mrow
                            %mo (
                            %mtable{:columnalign => "left center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mi d
                                %mtd
                                  %msub
                                    %mi c
                                    %mi n
                                %mtd
                                  %mo =
                                  %mn 0
                            %mo )
                        %mtd
                          %mo ⟵
                        %mtd
                          %mrow
                            %mo (
                            %mtable{:columnalign => "left center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mi d
                                %mtd
                                  %msub
                                    %mi c
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                                %mtd
                                  %mo =
                                  %msub
                                    %mi ω
                                    %mn 2
                                  %mo ∧
                                  %msub
                                    %mi c
                                    %mi n
                              %mtr
                                %mtd
                                  %mi d
                                %mtd
                                  %msub
                                    %mi c
                                    %mi n
                                %mtd
                                  %mo =
                                  %mn 0
                              %mtr
                                %mtd
                                  %mi d
                                %mtd
                                  %msub
                                    %mi ω
                                    %mn 2
                                %mtd
                                  %mo =
                                  %mn 0
                            %mo )
                        %mtd
                          %mo ⟵
                        %mtd
                          %mrow
                            %mo (
                            %mtable{:columnalign => "left center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                              %mtr
                                %mtd
                                  %mi d
                                %mtd
                                  %msub
                                    %mi c
                                    %mi n
                                %mtd
                                  %mo =
                                  %mn 0
                            %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccc}
                    B^n \mathbb{Q}
                    \&amp;\longrightarrow&amp;
                    \\Big(
                    \\overset{
                    B^{n} \mathbb{Q}
                    \\,\times\,
                    B^{n+1} \mathbb{Q}
                    }{
                    \\overbrace{
                    \\mathcal{L} \;B^{n+1} \mathbb{Q}
                    }
                    }
                    \\Big)
                    \\sslash S^1
                    \&amp;\longrightarrow&amp;
                    B^n \mathbb{Q}
                    \\\
                    \\left(
                    \\begin{array}{lcl}
                    d &amp; c_{n} &amp; = 0
                    \\end{array}
                    \\right)
                    \&amp;
                    \\longleftarrow
                    \&amp;
                    \\left(
                    \\begin{array}{lcl}
                    d &amp; c_{n+1} &amp; = \omega_2 \wedge c_n
                    \\\
                    d &amp; c_{n} &amp; = 0
                    \\\
                    d &amp; \omega_2 &amp; = 0
                    \\end{array}
                    \\right)
                    \&amp;
                    \\longleftarrow
                    \&amp;
                    \\left(
                    \\begin{array}{lcl}
                    d &amp; c_{n} &amp; = 0
                    \\end{array}
                    \\right)
                    \\end{array}
            %p
              Incidentally, as indicated by the full diagram, this readily shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℒ
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⫽
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \big(\mathcal{L}\, B^{n+1} \mathbb{Q}\big) \sslash S^1
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retracts
              onto
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi n
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} B^{n} \mathbb{Q}
          %h3#RelationToHochschildHomology Relation to Hochschild- and cyclic-homology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                %annotation{:encoding => "application/x-tex"} H^\bullet
            of its
            %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi HH
                    %mo •
                %annotation{:encoding => "application/x-tex"} HH_\bullet
            of its
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular chains
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℒ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H^\bullet(\mathcal{L}X)
                  \\simeq
                  HH_\bullet( C^\bullet(X) )
                  \\,.
          %p
            Moreover the
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %a.existingWikiWord{:href => "/nlab/show/cyclic+loop+space"} cyclic loop space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                  %mo ⫽
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X \sslash S^1
            is the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+homology"} cyclic homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi HC
                    %mo •
                %annotation{:encoding => "application/x-tex"} HC_\bullet
            of the singular chains:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℒ
                  %mi X
                  %mo ⫽
                  %msup
                    %mi S
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi HC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^\bullet(\mathcal{L}X \sslash S^1)
                  \\simeq
                  HC_\bullet( C^\bullet(X) )
          %p
            (
            %a{:href => "cyclic+homology#Jones87"}> Jones 87, Thm. A
            , review in
            = succeed "," do
              %a{:href => "cyclic+homology#Loday92"} Loday 92, Cor. 7.3.14
            = succeed ")" do
              %a{:href => "cyclic+homology#Loday11"} Loday 11, Sec 4
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is of
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            then by prop.
            %a.maruku-ref{:href => "#SullivanModelForTheFreeLoopSpace"}
            and prop.
            = succeed "," do
              %a.maruku-ref{:href => "#ModelForS1quotient"}
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            of the above
            %a.existingWikiWord{:href => "/nlab/show/minimal+Sullivan+models"} minimal Sullivan models
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝓁
                  %mi X
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{l}X/S^1
            compute the rational
