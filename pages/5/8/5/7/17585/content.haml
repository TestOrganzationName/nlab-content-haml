            regarded as
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
            by any base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
