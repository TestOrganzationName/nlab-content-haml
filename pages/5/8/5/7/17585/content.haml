              be a
              %a.existingWikiWord{:href => "/nlab/show/central+extension"} central
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} Lie algebra extension
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              of a finite dimensional Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ⟶
                    %mi b
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \longrightarrow b \mathbb{R}
              be the corresponding
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ 2-cocycle
              with coefficients in the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie 2-algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b \mathbb{R}
              = succeed ")" do
                %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} FSS 13, prop. 3.5
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔤
                      %mo{:stretchy => "false"} ^
                    %mo ⟶
                    %mi 𝔤
                    %mover
                      %mo ⟶
                      %mrow
