                    %annotation{:encoding => "application/x-tex"} \partial^1 \colon E^1_{p,q} \to E^1_{p-1, q}
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              acts as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
