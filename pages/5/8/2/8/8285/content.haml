                  %annotation{:encoding => "application/x-tex"} c \in C_{p,q}
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi vert
                      %mi c
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^{vert} c = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %msubsup
                        %mi E
                        %mrow
