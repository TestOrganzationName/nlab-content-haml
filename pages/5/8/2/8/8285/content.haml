                      %p
                        %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#Properties"} Properties
              %ul
                %li
                  %a{:href => "#LowDegreePages"} Low-degree pages
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                %annotation{:encoding => "application/x-tex"} C_{\bullet, \bullet}
            (in some
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            whose second page is the “naïve double cohomology”
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 2
                  %mo =
                  %msubsup
                    %mi H
                    %mi p
                    %mi hor
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi H
                    %mi q
                    %mi vert
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  E^2_{p,q} = H_p^{hor}(H_q^{vert}(C))
          %p
            and which converges, under mild conditions, to the correct
            %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
            of the
            %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Tot(C_{\bullet, \bullet})
          %p
            This is the special case of the
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tot
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
                %annotation{:encoding => "application/x-tex"} Tot(C)_\bullet
            %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered
            by row-degree (or dually, by column-degree).
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mo •
                      %mo ,
                      %mo •
                %annotation{:encoding => "application/x-tex"} C_{\bullet,\bullet}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tot
                  %mi C
                %annotation{:encoding => "application/x-tex"} Tot C
            is given in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            by the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Tot
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo =
                  %msub
                    %mo ⊕
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo =
                      %mi n
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                %annotation{:encoding => "application/x-tex"}
                  (Tot C)_n = \oplus_{p+q = n} C_{p,q}
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            acts on elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                %annotation{:encoding => "application/x-tex"} c \in C_{p,q}
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∂
                    %mi Tot
                  %mo{:lspace => "verythinmathspace"} :
                  %mi c
                  %mo ↦
                  %msup
                    %mo ∂
                    %mi hor
                  %mi c
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi p
                  %msup
                    %mo ∂
                    %mi ver
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial^{Tot} \colon c \mapsto \partial^{hor} c + (-1)^{p} \partial^{ver} c
                  \\,.
          #HorVertFiltration.num_defn
            %h6#definition_2 Definition
            %p
              The
              %strong horizontal filtration
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Tot
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Tot C
              is the
              %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %mi Tot
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F_\bullet Tot C
              given in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              by the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi p
                      %mi hor
                    %mo{:stretchy => "false"} (
                    %mi Tot
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %msub
                      %mo ⊕
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo =
                            %mi n
                        %mrow
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %mo ≤
                            %mi p
                    %msub
                      %mi C
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^{hor}_p (Tot C)_n \coloneqq
                    \\oplus_{{n_1+n_2 = n} \atop {n_1 \leq p} } C_{n_1,n_2}
                    \\,.
            %p
              Similarly the
              %strong vertical filtration
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi p
                      %mi vert
                    %mo{:stretchy => "false"} (
                    %mi Tot
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %msub
                      %mo ⊕
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %mo +
                            %msub
                              %mi n
                              %mn 2
                            %mo =
                            %mi n
                        %mrow
                          %mrow
                            %msub
                              %mi n
                              %mn 2
                            %mo ≤
                            %mi p
                    %msub
                      %mi C
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F^{vert}_p (Tot C)_n \coloneqq
                    \\oplus_{{n_1+n_2 = n} \atop {n_2 \leq p} } C_{n_1,n_2}
                    \\,.
          #SpectralSequenceOfDoubleComplex.num_defn
            %h6#definition_3 Definition
            %p
              The (vertical/horizontal)
              %em spectral sequence of the double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} C_{\bullet,\bullet}
              is the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
              for the filtered total complex from def.
              = succeed "." do
                %a.maruku-ref{:href => "#HorVertFiltration"}
          %h2#Properties Properties
          %h3#LowDegreePages Low-degree pages
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              be the spectral sequence of a
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mo •
                          %mo ,
                          %mo •
                    %annotation{:encoding => "application/x-tex"} C_{\bullet, \bullet}
              = succeed "," do
                %a.maruku-ref{:href => "#SpectralSequenceOfDoubleComplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p,q \in \mathbb{Z}
              given by
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 0
                        %mo ≃
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                      %annotation{:encoding => "application/x-tex"} E^0_{p,q} \simeq C_{p,q}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 1
                        %mo ≃
                        %msub
                          %mi H
                          %mi q
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo ,
                            %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^1_{p,q} \simeq H_q(C_{p, \bullet})
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn 2
                        %mo ≃
                        %msub
                          %mi H
                          %mi p
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi H
                          %mi q
                          %mi vert
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^2_{p,q} \simeq H_p(H^{vert}_q(C))
                  \.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} C_{\bullet, \bullet}
              is concentrated in the first quadrant (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} 0 \leq p,q
              ), then the spectral sequence
              %a{:href => "spectral+sequence#ConvergenceOfSpectralSequences"} converges
              to the chain homology of the total complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ≃
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi Tot
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\infty_{p,q} \simeq G_p H_{p+q}(Tot(C)_\bullet)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              This is a matter of unwinding the definition, using the general properties of
              = succeed "." do
                %a{:href => "spectral+sequence+of+a+filtered+complex#InLowDegreePages"} spectral sequences of a filtered complex – in low degree pages
            %p
              The 0th page is by definition the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              piece
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 0
                          %mtd
                            %mo ≔
                            %msub
                              %mi G
                              %mi p
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %msub
                              %mi F
                              %mi p
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi F
                              %mrow
                                %mi p
                                %mo −
                                %mn 1
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mfrac
                              %mrow
                                %munder
                                  %mo ⊕
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mrow
                                        %msub
                                          %mi n
                                          %mn 1
                                        %mo +
                                        %msub
                                          %mi n
                                          %mn 2
                                        %mo =
                                        %mi p
                                        %mo +
                                        %mi q
                                    %mrow
                                      %mrow
                                        %msub
                                          %mi n
                                          %mn 1
                                        %mo ≤
                                        %mi p
                                %msub
                                  %mi C
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mi n
                                      %mn 2
                              %mrow
                                %munder
                                  %mo ⊕
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mrow
                                        %msub
                                          %mi n
                                          %mn 1
                                        %mo +
                                        %msub
                                          %mi n
                                          %mn 2
                                        %mo =
                                        %mi p
                                        %mo +
                                        %mi q
                                    %mrow
                                      %mrow
                                        %msub
                                          %mi n
                                          %mn 1
                                        %mo &lt;
                                        %mi p
                                %msub
                                  %mi C
                                  %mrow
                                    %msub
                                      %mi n
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mi n
                                      %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi C
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^0_{p,q}
                    \&amp; \coloneqq
                    G_p Tot(C)_{p+q}
                    \\\
                    \&amp; \coloneqq
                    F_p Tot(C)_{p+q} / F_{p-1} Tot(C)_{p+q}
                    \\\
                    \&amp; \coloneqq
                    \\frac{
                    \\underset{ {n_1 + n_2 = p+q} \atop {n_1 \leq p} }{\oplus} C_{n_1, n_2}
                    }
                    {
                    \\underset{ {n_1 + n_2 = p+q} \atop {n_1 \lt p} }{\oplus} C_{n_1, n_2}
                    }
                    \\\
                    \&amp; \simeq
                    C_{p,q}
                    \\,.
                    \\end{aligned}
            %p
              The first page is the chain homology of the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              chain complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mn 1
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mi p
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi C
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi p
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi p
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^1_{p,q}
                    \&amp; \simeq
                    H_{p+q}(G_p Tot(C)_\bullet)
                    \\\
                    \&amp; \simeq
                    H_{p+q}( C_{p,\bullet} )
                    \\\
                    \&amp; \simeq H_q(C_{p, \bullet})
                    \\end{aligned}
                    \\,.
            %p
              In particular this means that representatives of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
