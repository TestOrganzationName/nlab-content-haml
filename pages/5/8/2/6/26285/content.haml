          %h2#idea Idea
          %p
            In the context of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+forms"} Hermitian forms
            and in particular of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+K-theory"} Hermitian K-theory
            %em hyperbolic functor
            one refers to the construction which sends a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒱
                %annotation{:encoding => "application/x-tex"} \mathscr{V}
            over a given (
            %a.existingWikiWord{:href => "/nlab/show/star-algebra"}> star
            \-)
            %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            to its
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒱
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi.mathscript 𝒱
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi.mathscript 𝒱
                  %mo ⊕
                  %msup
                    %mi.mathscript 𝒱
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{V}
                  \\;\mapsto\;
                  H(\mathscr{V})
                  \\;\coloneqq\;
                  \\mathscr{V}
                  \\oplus
                  \\mathscr{V}^\ast
          %p
            with its (
            %a.existingWikiWord{:href => "/nlab/show/anti-dual+linear+space"}> anti
            \-)
            %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
            and then equipped with the (
            %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"}> sesqui
            \- or)
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi.mathscript 𝒱
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi H
                          %mo{:stretchy => "false"} (
                          %mi.mathscript 𝒱
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi R
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  H(\mathscr{V})
                  \\otimes
                  H(\mathscr{V})
                  \&amp;\longrightarrow&amp;
                  R
                  }
          %p
            which on the mixed summands is (the
            %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} conjugation
            of) the
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi.mathscript 𝒱
                  %mo ⊗
                  %msup
                    %mi.mathscript 𝒱
                    %mo *
                  %mo ⟶
                  %mi R
                %annotation{:encoding => "application/x-tex"}
                  \\mathscr{V} \otimes \mathscr{V}^\ast
                  \\longrightarrow
                  R
          %p and vanishing on the homogeneous summands.
          %p
            This construction extends to
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from the
            %a.existingWikiWord{:href => "/nlab/show/core+groupoid"} core groupoid
            %a.existingWikiWord{:href => "/nlab/show/Mod"}
              of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            to that of
            %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
            with
            %a.existingWikiWord{:href => "/nlab/show/isometries"} isometries
            between them, by sending an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi.mathscript 𝒱
                  %mover
                    %mo →
                    %mo ∼
                  %mi.mathscript 𝒲
                %annotation{:encoding => "application/x-tex"} \phi \colon \mathscr{V} \overset{\sim}{\to} \mathscr{W}
            to its
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            with the
            %a.existingWikiWord{:href => "/nlab/show/dual+linear+map"} dual linear map
            of its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thinmathspace"}
                  %mo ↦
                  %mspace{:width => "thinmathspace"}
                  %mi ϕ
                  %mo ⊕
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϕ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi \,\mapsto\, \phi \oplus (\phi^{-1})^\ast
                  \\,.
          %p
            Regarded with suitable
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo ×
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2 \times \mathbb{Z}/2
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariance
            %a.existingWikiWord{:href => "/nlab/show/KR-theory"} KR-theory
            and
            %a.existingWikiWord{:href => "/nlab/show/topological+Hermitian+K-theory"} topological Hermitian K-theory
            (see the references
            = succeed ")." do
              %a{:href => "Hermitian+K-theory#ReferencesTopologicalHermitianKTheory"} there
          %h2#example Example
          %p
          .num_remark
            %h6 Example
            %p
              In the simple special case that the
              %a.existingWikiWord{:href => "/nlab/show/ground+ring"} ground ring
              is the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathscr{V}
              is also
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              over itself, and finally identifying
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mo *
                      %mo ≃
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^\ast \simeq \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              is the
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo =
                    %mi ℝ
                    %mo ⊕
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 = \mathbb{R} \oplus \mathbb{R}
              equipped with its standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
            %p
              Here the subspaces of fixed non-vanishing
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              are the usual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hyperbolas"} hyperbolas
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒱
                      %mo ⊕
                      %msup
                        %mi.mathscript 𝒱
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathscr{V} \oplus \mathscr{V}^\ast
          %h2#references References
          %p The term “hyperbolic functor” seems to originate with:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hyman+Bass"} Hyman Bass
              (notes by Amit Roy), §5.2 in:
              = succeed "," do
                %em Lectures on Topics in Algebraic K-Theory
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Bass-HyperbolicFunctor.pdf", :title => "pdf"} pdf
          %p See also:
          %ul
            %li#Wall69
              %a.existingWikiWord{:href => "/nlab/show/C.+T.+C.+Wall"} C. T. C. Wall
              (ed.
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Ranicki"} Andrew Ranicki
              = succeed "," do
                %em Surgery on compact Manifolds
              %strong 69
              (1969) &amp;lbrack;
              %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/books/scm.pdf"}> pdf
              \&amp;rbrack;
          %p
            Further discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+K-theory"} Hermitian K-theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Orlando+Villamayor"} Orlando Villamayor
                = succeed "," do
                  %em K-théorie algébrique et K-théorie topologique II
                %strong 32
                (1973) 57-86 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/24490565"}> jstor:24490565
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Karoubi"}> Max Karoubi
                , pp. 307 (7 of 111) in:
                = succeed "," do
                  %em Périodicité de la K-théorie hermitienne
                %a.existingWikiWord{:href => "/nlab/show/Hyman+Bass"} Hyman Bass
                (ed.),
                = succeed "," do
                  %em Algebraic K-Theory III – Hermitian K-Theory and Geometric Applications
                %strong 343
                (1973) 301-411 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BFb0061366"}> doi:10.1007/BFb0061366
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Bak"}> Anthony Bak
                , §3 in:
                = succeed "," do
                  %em Grothendieck Groups of Modules and Forms Over Commutative Orders
                %strong 99
                1 (1977) 107-120 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/2374010"}> jstor:2374010
                ,
                = succeed "&rbrack;" do
