                        \\mathscr{H}
                        \\\
                        \\left(
                        \\begin{matrix}
                        \\psi_+
                        \\\
                        \\psi_-
                        \\end{matrix}
                        \\right)
                        \&amp;\mapsto&amp;
                        \\left(
                        \\begin{matrix}
