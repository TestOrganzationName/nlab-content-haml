                        %msubsup
                          %mi C
                          %mn 2
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mi id
                        %mo ,
                        %mi C
                        %mo ≔
                        %mi P
                        %mi T
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} C_2^{(c)} \coloneqq \{id, C \coloneqq P T\}
                  denote the group generated by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                          %mo ∘
                          %mi T
                        %annotation{:encoding => "application/x-tex"} P \circ T
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
