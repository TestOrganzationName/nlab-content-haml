                  denote the corresponding projective group
            %p Finally, combine all this to consider the following:
            %h4#PCTQuantumSymmetryDefinitionAndClassification Definition and Classification
            %p
            .num_defn
              %h6 Definition
              %p
                The group of
                %em graded quantum symmetries
                is the
                %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
              #eq:GradedQuantumSymmetries.maruku-equation
                %span.maruku-eq-number (6)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi QS
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mrow
                          %mi{:mathvariant => "normal"} U
                          %mo{:stretchy => "false"} (
                          %mi.mathscript ℋ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %mrow
                          %mi{:mathvariant => "normal"} U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo ⋊
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msubsup
                        %mi C
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} )
                      %mo ×
                      %msubsup
                        %mi C
                        %mn 2
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      QS
                      \\;\coloneqq\;
                      \\frac{
                      \\mathrm{U}(\mathscr{H})^2
                      }{
                      \\mathrm{U}(1)
                      }
                      \\rtimes
                      \\big(
                      C_2^{(t)} \times C_2^{(c)}
                      \\big)
                      \\mathrlap{\,,}
              %p
                of the even graded projective unitary group with the operations of degree involution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and complex involution
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mrow
                          %mi{:mathvariant => "normal"} U
                          %mo{:stretchy => "false"} (
                          %mi.mathscript ℋ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                        %mrow
                          %mi{:mathvariant => "normal"} U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi QS
                    %mo ↠
                    %msubsup
                      %mi C
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msubsup
                      %mi C
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tfrac{
                    \\mathrm{U}(\mathscr{H})^2
                    }{
                    \\mathrm{U}(1)
                    }
                    \\hookrightarrow
                    QS
                    \\twoheadrightarrow
                    C_2^{(t)} \times C_2^{(c)}
            %p of
            #eq:PCTgroup.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msubsup
                      %mi C
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mi id
                    %mo ,
                    %mi T
                    %mo ,
                    %mi C
                    %mo ,
                    %mi P
                    %mo ≔
                    %mi C
                    %mi T
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C_2^{(t)} \times C_2^{(c)}
                    \\;=\;
                    \\big\{
                    id, T, C, P \coloneqq C T
                    \\big\}
                    \\,,
            %p
              which we may call the group of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/PCT+symmetries"} PCT symmetries
            %p
            #PCTQuantumSymmetry.num_defn
              %h6 Definition
              %p
