                        %mi id
                        %mo ,
                        %mi P
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} C_2^{(p)} \coloneqq \{id, P\}
                  denote the group generated by
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi P
                        %annotation{:encoding => "application/x-tex"} P
              %li
