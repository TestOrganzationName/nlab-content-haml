          %h2#idea Idea
          %p
            The
            %em singular homology
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+homology"} simplicial homology
            of its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
          %p
            a
            %strong
              singular
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/chain"} chain
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
            of
            %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma : \Delta^n \to X
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
            is such a chain such that its oriented
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            vanishes. Two singular chains are
            %strong homologous
            if they differ by a boundary. The
            %strong singular homology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is the group of
            = succeed "-cycles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Singular homology of a topological space conincide with its
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            as defined more abstractly (see at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology+theory"} generalized homology theory
          %p
            (Here “singular” refers to the contrast with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi top
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Delta_{top} \to X
            in the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            is not required to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+embedding"} topological embedding
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
          %h2#Definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} X \in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sing
                  %mi X
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} Sing X \in
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            for its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %strong
                singular
                = succeed "-chain" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an element in the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} (
                      %mi Sing
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[(Sing X)_n]
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combinations"} formal linear combinations
              of
              %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_remark
            %h6#remark Remark
            %p
              These are the
              %a.existingWikiWord{:href => "/nlab/show/chains+on+a+simplicial+set"} chains on a simplicial set
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Sing X
          %p
            The groups of singular chains combine to the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mi Ab
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[Sing X] \in Ab^{\Delta^{op}}
          #SingularComplex.num_defn
            %h6#definition_3 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/alternating+face+map+complex"} alternating face map complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Sing
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    C_\bullet(X)
                    \\coloneqq
                    C_\bullet(\mathbb{Z}[Sing X]) \in Ch_\bullet
            %p
              is the
              %strong singular complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              is the ordinary
              %strong singular homology
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            One usually writes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(X, \mathbb{Z})
            or just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_n(X)
            for the singular homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
          .num_remark
            %h6#remark_2 Remark
            %p So we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi ⋯
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 1
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    C_\bullet(X)
                    \=
                    [
                    \\cdots
                    \\stackrel{\partial_2}{\to}
                    \\mathbb{Z}[(Sing X)_2]
                    \\stackrel{\partial_1}{\to}
                    \\mathbb{Z}[(Sing X)_1]
                    \\stackrel{\partial_0}{\to}
                    \\mathbb{Z}[(Sing X)_0]
                    ]
            %p
              where the differentials are defined on
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi Sing
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \sigma \in (Sing X)_n
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi n
                    %mi σ
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi d
                      %mi i
                    %mi σ
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_n \sigma
                    \=
                    \-
                    \\sum_{i = 0}^n
                    (-1)
                    d_i \sigma
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d_i
              the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial face map
            %p
              (One may change the global signs and obtain a
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
              complex, in particular with the same homology groups.)
          .num_remark
            %h6#remark_3 Remark
            %p
              This means that a
              %a.existingWikiWord{:href => "/nlab/show/singular+chain"} singular chain
              is a
              %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
              if the formal linear combination of the oriented
              %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              of all its constituent
              %a.existingWikiWord{:href => "/nlab/show/singular+simplices"} singular simplices
              sums to 0. See the
              %em
                %a{:href => "#BasicExamples"} basic examples
              below
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            any unital
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            one can form the degreewise
            %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi Sing
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[Sing X]
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %em
              singular homology with coefficients in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H_n(X,R)
          .num_defn
            %h6#definition_4 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              between topological spaces, and given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma : \Delta^n \to X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is sent to a singular
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi σ
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                    %mover
                      %mo →
                      %mi σ
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f_* \sigma : \Delta^n \stackrel{\sigma}{\to} X \stackrel{f}{\to} Y
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %strong push-forward
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo :
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_*)_n : C_n(X) \to C_n(Y)
                    \\,.
          #PushForwardChainMap.num_prop
            %h6#proposition Proposition
            %p These push-forward maps make all diagrams of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mo *
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi C
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi X
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mo ∂
                                    %mi n
                                    %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi f
                                  %mo *
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                          %mtd
                            %msub
                              %mi C
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C_{n+1}(X) &amp;\stackrel{(f_*)_{n+1}}{\to}&amp; C_{n+1}(Y)
                    \\\
                    \\downarrow^{\mathrlap{\partial^X_n}} &amp;&amp; \downarrow^{\mathrlap{\partial^Y_n}}
                    \\\
                    C_n(X) &amp;\stackrel{(f_*)_n}{\to}&amp; C_n(Y)
                    }
            %p
              commute. In other words, push-forward along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_* : C_\bullet(X) \to C_\bullet(Y)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              It is in fact evident that push-forward yields a functor of
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complexes"} singular simplicial complexes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi Sing
                    %mi X
                    %mo →
                    %mi Sing
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_* : Sing X \to Sing Y
                    \\,.
            %p
              From this the statement follows since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi sSet
                    %mo →
                    %mi sAb
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[-] : sSet \to sAb
              is a functor.
          %p Accordingly we have:
          #SingularHomologyAsAFunctor.num_prop
            %h6#proposition_2 Proposition
            %p
              Sending a topological space to its singular chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              = succeed "," do
                %a.maruku-ref{:href => "#SingularComplex"}
              = succeed "," do
                %a.maruku-ref{:href => "#PushForwardChainMap"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo →
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C_\bullet(-,R) : Top \to Ch_\bullet(R Mod)
            %p
              from the category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            %p
              In particular for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              singular homology extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Top
                    %mo →
                    %mi R
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_n(-,R) : Top \to R Mod
                    \\,.
          %h2#examples Examples
          %h3#BasicExamples Basic examples
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a topological space. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mn 1
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma^1 : \Delta^1 \to X
              be a singular 1-simplex, regarded as a 1-chain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi σ
                      %mn 1
                    %mo ∈
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
