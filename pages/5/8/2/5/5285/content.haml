          %h3#HomologyOfDisksAndSpheres Homology of cells: disks and spheres
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %a.existingWikiWord{:href => "/nlab/show/reduced+singular+homology"} reduced singular homology
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo =
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_k(S^n)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; if\; k = n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              The
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ≔
                    %msup
                      %mi D
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    S^n \simeq D^n/S^{n-1} \coloneqq D^{n} \coprod_{S^{n-1}} *
            %p
              which is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/ball"} ball
              with its
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point"} point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^{n-1} \hookrightarrow D^n
              is a “good pair” in the sense of def.
              = succeed "," do
                %a.maruku-ref{:href => "#GoodPair"}
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              from prop.
              %a.maruku-ref{:href => "#RelativeHomologyLongExactSequence"}
              yields a long exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to \tilde H_{k+1}(S^n) \to \tilde H_k(S^{n-1}) \to \tilde H_k(D^n) \to \tilde H_k(S^n) \to \tilde H_{k-1}(S^{n-1}) \to \cdots
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/disks"} disks
              are all
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+spaces"} contractible topological spaces
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} H_k(D^n) \simeq 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k,n
              by
              %a{:href => "reduced+homology#ReducedHomologyOfPoints"} this example
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reduced+homology"} reduced homology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_{k+1}(S^{n+1}) \to \tilde H_k(S^n)
            %p
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_n(S^0) \simeq
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; if \; n = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p
              (by
              %a{:href => "reduced+homology#ReducedHomologyOf0Sphere"} this example
              at
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reduced+homology"} reduced homology
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %h2#properties Properties
          %h3#HomotopyInvariant Homotopy invariance
          %p
            Singular homology is
            = succeed ":" do
              %em homotopy invariant
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              which is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_n(f) : H_n(X) \to H_n(Y)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              In other words: the singular chain functor of prop.
              %a.maruku-ref{:href => "#SingularHomologyAsAFunctor"}
              sends
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
          %p
            A proof (via
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/CW+approximations"} CW approximations
            = succeed ")." do
              %a{:href => "#Hatcher"} Hatcher, prop. 4.21
          %h3#RelationToHomotopyGroups Relation to homotopy groups
          %p
            The singular
            %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
            of a topologial space serve to some extent as an approximation to the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of that space.
          #HurewiczHomomorphism.num_defn
            %h6#definition_5 Definition
            %p
              %strong (Hurewicz homomorphism)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              a
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %strong Hurewicz homomorphism
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_k(X,x) \to H_k(X)
            %p
              from the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
              group defined by sending
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo :
                    %msup
                      %mi S
                      %mi k
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ∼
                    %mo ↦
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi S
                      %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : (f : S^k \to X)_{\sim} \mapsto f_*[S_k]
            %p
              a representative singular
              = succeed "-sphere" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the push-forward along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi S
                        %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msub
                        %mi H
                        %mi k
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} [S_k] \in H_k(S^k) \simeq \mathbb{Z}
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a topological space the Hurewicz homomorphism in degree 0 exhibits an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\pi_0(X)]
              on the set of
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the degree-0 singular homlogy:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %msub
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[\pi_0(X)]
                    \\simeq
                    H_0(X)
                    \\,.
          %p
            Since a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            in positive degree depends on the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
            of the base point, while the singular homology does not depend on a basepoint, it is interesting to compare these groups only for the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is connected.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              the
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
              in degree 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_1(X,x) \to H_1(X)
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              is the
              %a.existingWikiWord{:href => "/nlab/show/commutator+subgroup"} commutator subgroup
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from the
              %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi ab
                      %mo ≔
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi π
                        %mn 1
                      %mo ,
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)^{ab} \coloneqq \pi_1(X,x)/[\pi_1,\pi_1]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ab
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(X,x)^{ab}
                    \\stackrel{\simeq}{\to}
                    H_1(X)
                    \\,.
          %p
            For higher connected
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            we have the
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/n-connected+object+in+an+%28infinity%2C1%29-topos"} (n-1)-connected
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo :
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Phi : \pi_n(X,x) \to H_n(X)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This is known as the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
          %h3#RelationToRelativeHomology Relation to relative homology
          %p For the present purpose one makes the following definition.
          #GoodPair.num_defn
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is called a
              %strong good pair
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
                  and
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  has a
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  of which it is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/deformation+retract"} deformation retract
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi A
                %annotation{:encoding => "application/x-tex"} X/A
            for the
            %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
            of the inclusion, hence for the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo ↪
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\hookrightarrow&amp; X
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  * &amp;\to&amp; X/A
                  }
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          #RelativeHomologyLongExactSequence.num_prop
            %h6#proposition_7 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow X
              is a good pair, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GoodPair"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} X/A
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              relative to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\tilde H_n(A)
                    \\to
                    \\tilde H_n(X)
                    \\to
                    \\tilde H_n(X/A)
                    \\to
                    \\tilde H_{n-1}(A)
                    \\to
                    \\tilde H_{n-1}(X)
                    \\to
                    \\tilde H_{n-1}(X/A)
                    \\to
                    \\cdots
                    \\,.
          %p
            For instance (
            %a{:href => "#Hatcher"}> Hatcher, theorem 2.13
            ).
          %h3#relation_to_generalized_homology Relation to generalized homology
          %p
            Singular homology computes the
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            with coefficients in the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi R
                  %annotation{:encoding => "application/x-tex"} H R
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+homology"} Čech homology
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/duality"} dual
                notion is that of
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            %li
              %p
                The analogous notion in
                %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
                is given by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Chow+groups"} Chow groups
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kan-Thurston+theorem"} Kan-Thurston theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Borel-Moore+homology"} Borel-Moore homology
          %h2#references References
          %h3#general General
          %p
            Original references on
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            and
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Poincar%C3%A9"}> Henri Poincaré
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Analysis+Situs"} Analysis Situs
                = succeed "," do
                  %a{:href => "https://gallica.bnf.fr/ark:/12148/bpt6k4337198/f7"} gallica:12148/bpt6k4337198/f7
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/John+Stillwell"} John Stillwell
                = succeed "," do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/poincare2009.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Stillwell_AnalysisSitus.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                ,
                = succeed "," do
                  %em Über die Dualität im Aufbau der kombinatorischen Topologie
                = succeed ")" do
                  %a{:href => "http://mi.mathnet.ru/msb5361"} mathnet
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrei+Kolmogoroff"}> Andrei Kolmogoroff
                ,
                = succeed "," do
                  %em Homologiering des Komplexes und des lokal-bicompakten Raumes
                = succeed "." do
                  %a{:href => "http://mi.mathnet.ru/msb5475"} mathnet
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                ,
                = succeed "," do
                  %em On the chains of a complex and their duals
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1073/pnas.21.8.509"} doi:10.1073/pnas.21.8.50
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                ,
                = succeed "," do
                  %em On the ring of a compact metric space
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1073/pnas.21.8.511"} doi:10.1073/pnas.21.8.511
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+W.+Alexander"}> J. W. Alexander
                ,
                = succeed "," do
                  %em On the connectivity ring of an abstract space
                = succeed "," do
                  %a{:href => "https://doi.org/10.2307/1968484"} doi:10.2307/1968484
                = succeed ")" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/alexcon.pdf"} pdf
          %p Lecture notes:
          %ul
            %li
              %p
                Rob Thompson, Len Evens ,
                %em
                  %a{:href => "http://math.hunter.cuny.edu/~rthompso/topology_notes/"} Topology notes
                %em Chapter 6, Singular homology
                (
                %a{:href => "http://math.hunter.cuny.edu/~rthompso/topology_notes/chapter%20six.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+H.+Fremlin"}> David H. Fremlin
                ,
                %em Singular homology for amateurs
                (2016)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://www1.essex.ac.uk/maths/people/fremlin/n16703.pdf"} pdf
                %a.existingWikiWord{:href => "/nlab/files/FremlinSIngularHomology.pdf", :title => "pdf"} pdf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p
            Textbook discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            is around Application 1.1.4 of
          %ul#Weibel
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/An+Introduction+to+Homological+Algebra"} An Introduction to Homological Algebra
          %p
            and in the context of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
            in chapter 2.1 of
          %ul
            %li#Hatcher
              %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
              ,
              %em Algebraic Topology
              (
              %a{:href => "http://www.math.cornell.edu/~hatcher/AT/ATpage.html"}> web
              )
          %p
            and
            %a{:href => "http://www.math.upenn.edu/~ghrist/EAT/EATchapter4.pdf"} chapter 4
            of
          %ul#Ghrist
            %li
              %a.existingWikiWord{:href => "/nlab/show/Robert+Ghrist"}> Robert Ghrist
              ,
              %em Elementary applied topology
              (
              %a{:href => "http://www.math.upenn.edu/~ghrist/notes.html"}> web
              )
          %p
            Discussion in the context of computing
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            is in
          %ul#Hutchings
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Hutchings"}> Michael Hutchings
              ,
              %em Introduction to higher homotopy groups and obstruction theory
              (
              %a{:href => "http://math.berkeley.edu/~hutching/teach/215b-2011/homotopy.pdf"}> pdf
              )
          %p Lecture notes include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marco+Gualtieri"}> Marco Gualtieri
              ,
              %em Homology
              (
              %a{:href => "http://www.math.toronto.edu/mgualt/MAT1300/Week%206-9%20Term%202.pdf"}> pdf
              )
          %p See also
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Singular_homology"} Singular homology
