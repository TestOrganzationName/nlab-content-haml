                          %annotation{:encoding => "application/x-tex"} \infty
                %li
                  %a{:href => "#as_vector_spaces"}
                    As
                    = succeed "-vector" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-categories"} locally presentable (∞,1)-categories
            and
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
            between them (
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+distributions"}> Lawvere distributions
            ).
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
            is a
            %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ×
                  %mi D
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} C \times D \to E
            from the cartesian
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            of two presentable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %em bilinear
            if it respects colimits in both variables.
          %p
            It turns out that there is a
            %em universal
            such bilinear functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ×
                  %mi D
                  %mo →
                  %mi C
                  %mo ⊗
                  %mi D
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C \times D \to C \otimes D
                  \\,,
          %p
            which thereby defines a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+presentable+%28%E2%88%9E%2C1%29-categories"} tensor product of presentable (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28infinity%2C1%29-category"} monoidal structure
            on presentable
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric
          %p
            The collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            of presentable
            = succeed "-cateories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
            between them (i.e. with “
            %em> linear
            ” functors between them!), is an
            = succeed "-generalization" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} Set Mod
            of ordinary categories and
            %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            %a.existingWikiWord{:href => "/nlab/show/distributors"} distributors
            between them. See
            %a.existingWikiWord{:href => "/nlab/show/distributor"} distributor
            and in particular the discussion there about the equivalent reformulation in terms of colimit-preserving functors.
          %p
            Using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            with its notion of “linearity” one obtains a very general notion of
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-function+theory"} geometric ∞-function theory
          %h2#definition Definition
          %h3#unstable_version Unstable version
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cat
                    %mn 1
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat_1
            for the
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
            whose
          %ul
            %li
              %p
                objects are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-categories
            %li
              %p
                morphisms are
                = succeed "-preserving" do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
          %h3#stable_version Stable version
          %p
            The symmetric monoidal structure on presentable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-categories
          %p
            The tensor unit of stable presentable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category+of+spectra"} stable (∞,1)-category of spectra
          %h2#properties Properties
          %h3#adjoint_functor_theorem Adjoint functor theorem
          %p
            A functor between locally presentable
            = succeed "-categories:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              if and only if it preserves small colimits (hence, in particular, is accessible), and
            %li
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              if and only if it preserves small limits and is accessible.
          %h3#homobjects Hom-objects
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ,
                      %mi D
                      %mo ∈
                      %mi Pr
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} C, D \in Pr(\infty,1)Cat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Func^L(C,D) \subset Func(C,D)
            %p
              be the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              on those that preserve all small
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              (equivalently, are left adjoints).
          %p
            Evidently
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Func
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func^L(C,D)
            would be the hom-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-category of an enhancement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            to an
            = succeed "-category;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat(C,D)
          .num_prop
            %h6#proposition Proposition
            %p
              For all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ,
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C,D
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func^L(C,D)
              is itself locally presentable.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.5.3.8
          %h3#EmbeddingIntoCat
            Embedding into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
          #LimitsAndColimits.num_prop
            %h6#proposition_2 Proposition
            %p
              All small
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} limits and colimits
              exists in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pr
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat \hookrightarrow
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 5.5.3.13
          %h3#tensor_product Tensor product
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_1, \cdots, C_n
              be a finite collection of locally presentable
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_1 \otimes \cdots \otimes C_n
              and an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi C
                      %mi n
                    %mo →
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    C_1 \times \cdots \times C_n \to C_1 \otimes \cdots \otimes C_n
            %p
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %ol
              %li
                %p
                  it preserves
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %li
                %p
                  for every
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi D
                          %mo ∈
                          %mi Pr
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mi Cat
                        %annotation{:encoding => "application/x-tex"} D \in Pr(\infty,1)Cat
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  produces an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Func
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msubsup
                      %mi Func
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mi L
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msubsup
                      %mi Func
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ×
                    %mi ⋯
                    %mo ×
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Func_{(\infty,1)}^L(C_1 \otimes \cdots \otimes C_n,D)
                    \\stackrel{\simeq}{\to}
                    Func^{L}_{(\infty,1)}(C_1 \times \cdots \times C_n,D)
                    \\hookrightarrow
                    Func^{}_{(\infty,1)}(C_1 \times \cdots \times C_n,D)
            %p
              onto the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of those functors, that preserves colimits in each argument.
          %p
            This is (
            %a{:href => "#LurieNoncommutative"}> Lurie, NA, theorem 4.1.4
            ).
          %p
            This tensor product makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+%28infinity%2C1%29-category"} closed
            %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Func
                    %mi L
                %annotation{:encoding => "application/x-tex"} Func^L
            supply
            %a.existingWikiWord{:href => "/nlab/show/right+adjoints"} right adjoints
            to the tensor product (
            %a{:href => "#Lurie09HTT"}> Lurie 09, Rem. 5.5.3.9
            ).
          %p
            The definition of the tensor product is easy:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊗
                    %mi D
                    %mo =
                    %mi Cts
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \otimes D = Cts(C^{op},D)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cts
                %annotation{:encoding => "application/x-tex"} Cts
            denotes the category of continuous (small-limit-preserving) functors. Equivalently, this is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cocts
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msup
                      %mi D
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Cocts(C,D^{op})^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cocts
                %annotation{:encoding => "application/x-tex"} Cocts
            denotes the category of cocontinuous (small-colimit-preserving) functors; it is tempting to write this as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Func
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %msup
                      %mi D
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Func^L(C,D^{op})^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} D^{op}
            is not itself locally presentable. However,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} D^{op}
            is nevertheless cocomplete, so any cocontinuous functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} C \to D^{op}
            has a right adjoint.
          %p
            To show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cts
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cts(C^{op},D)
            is locally presentable, recall that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≃
                  %msub
                    %mi Ind
                    %mi κ
                  %mi A
                %annotation{:encoding => "application/x-tex"} C \simeq Ind_\kappa A
            for some small
            = succeed "-cocomplete" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cts
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi κ
                    %mi Cts
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi op
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cts(C^{op},D) \simeq \kappa Cts (A^{op},D)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mi Cts
                %annotation{:encoding => "application/x-tex"} \kappa Cts
            denotes the category of
            = succeed "-limit-preserving" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fun
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fun(A^{op},D)
            and hence locally presentable.
          %p
            To show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cts
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cts(C^{op},D)
            has the right universal property, we compute
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi Func
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo ,
                          %msup
                            %mi Func
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo ,
                          %mi E
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≃
                          %mi κ
                          %mi CoCts
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %msup
                            %mi Func
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo ,
                          %mi E
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mspace{:width => "1em"}
                          %mtext (by the universal property of
                          %mspace{:width => "thickmathspace"}
                          %mi C
                          %mo =
                          %msub
                            %mi Ind
                            %mi κ
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi κ
                          %mi Cts
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi A
                            %mi op
                          %mo ,
                          %msup
                            %mi Func
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo ,
                          %mi E
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                        %mtd
                          %mspace{:width => "1em"}
                          %mtext (by taking opposites)
                      %mtr
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi κ
                          %mi Cts
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi A
                            %mi op
                          %mo ,
                          %mi CtsAcc
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mi D
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                        %mtd
                          %mspace{:width => "1em"}
                          %mtext (by the adjoint functor theorem)
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi CtsAcc
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ,
                          %mi κ
                          %mi Cts
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi A
                            %mi op
                          %mo ,
                          %mi D
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                        %mtd
                          %mspace{:width => "1em"}
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %msup
                            %mi Func
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi κ
                          %mi Cts
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi A
                            %mi op
                          %mo ,
                          %mi D
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi E
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mspace{:width => "1em"}
                          %mtext (by the adjoint functor theorem)
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Func^L(C,Func^L(D,E))
                  \&amp;\simeq \kappa CoCts (A,Func^L(D,E)) &amp; \quad \text{(by the universal property of }\; C = Ind_\kappa(A))\\
                  \&amp;\simeq \kappa Cts (A^{op},Func^L(D,E)^{op})^{op} &amp;\quad \text{(by taking opposites)}\\\\
                  \&amp;\simeq \kappa Cts (A^{op},CtsAcc(E,D))^{op} &amp;\quad \text{(by the adjoint functor theorem)}\\
                  \&amp;\simeq CtsAcc(E,\kappa Cts (A^{op},D))^{op} &amp;\quad (*)\\
                  \&amp;\simeq Func^L(\kappa Cts (A^{op},D),E) &amp;\quad \text{(by the adjoint functor theorem)}
                  \\end{aligned}
          %p
            To justify the step
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (*)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                    %mo ×
                    %mi E
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} A^{op} \times E \to D
            = succeed "-limits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "-variable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A^{op}
            = succeed "-variable." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a\in A
            the corresponding functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} E\to D
            is accessible, i.e. preserves
            = succeed "-filtered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \lambda_a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \lambda_a
            %a.existingWikiWord{:href => "/nlab/show/currying"} curried
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi κ
                  %mi Cts
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E\to \kappa Cts (A^{op},D)
            is accessible, i.e. preserves
            = succeed "-filtered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed "-filtered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed "-limits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo ≥
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \mu\ge \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                  %mi Cts
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \kappa Cts (A^{op},D)
            are pointwise, so we are at least talking about the same colimits, so the right-hand condition implies the left (take each
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi a
                    %mo =
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \lambda_a = \mu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is small, if the left-hand condition holds we can take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo =
                  %msub
                    %mi sup
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                  %msub
                    %mi λ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \mu = \sup_{a\in A} \lambda_a
            to make the right-hand condition hold.
          %h3#colimits Colimits
          %p
            Above we remarked that the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat \to (\infty,1)Cat
            preserves limits. It does not preserve colimits, but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            does have colimits; they are constructed by passing to right adjoints and taking the limit there.
          %p In particular, this implies there are some cases in which colimits coincide with limits. For instance:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Small coproducts in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
              coincide with small products.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %msub
                      %mi C
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \prod_i C_i
              be a product in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pr
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi i
                            %msub
                              %mi C
                              %mi i
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi Cts
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi i
                            %msub
                              %mi C
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi i
                            %mi Cts
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mo ,
                            %msub
                              %mi C
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mi i
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mi i
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Func^L(\prod_i C_i, D)
                    \&amp;\simeq Cts(D, \prod_i C_i)\\
                    \&amp;\simeq \prod_i Cts(D,C_i)\\
                    \&amp;\simeq \prod_i Func^L(C_i,D)
                    \\end{aligned}
          %p
            To be precise, the next result requires an enhancement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            to an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %a.existingWikiWord{:href => "/nlab/show/powers"} powers
            and
            %a.existingWikiWord{:href => "/nlab/show/copowers"} copowers
            by small
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/copower"} copower
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} C\in Pr(\infty,1)Cat
              by a small
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-presheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category of
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mrow
                          %msup
                            %mi A
                            %mi op
                    %annotation{:encoding => "application/x-tex"} C^{A^{op}}
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi A
                  %annotation{:encoding => "application/x-tex"} P A
              denote the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf+%28%E2%88%9E%2C1%29-category"} (∞,1)-presheaf (∞,1)-category
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Func
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi A
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi C
                        %mi A
                    %annotation{:encoding => "application/x-tex"} Func^L(P A,C) \simeq C^A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (P A)^{op}
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+completion"} free completion
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi op
                    %annotation{:encoding => "application/x-tex"} A^{op}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cts
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi C
                        %mrow
                          %msup
                            %mi A
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Cts((P A)^{op},C) \simeq C^{A^op}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ,
                            %mi D
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi A
                          %mtd
                            %mo ≃
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ,
                            %msup
                              %mi D
                              %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ,
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo ⊗
                            %mi P
                            %mi A
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %mi Cts
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mi P
                            %mi A
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi Func
                              %mi L
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi C
                              %mrow
                                %msup
                                  %mi A
                                  %mi op
                            %mo ,
                            %mi D
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Func^L(C,D)^A
                    \&amp;\simeq Func^L(C,D^A)\\
                    \&amp;\simeq Func^L(C,Func^L(P A,D))\\
                    \&amp;\simeq Func^L(C \otimes P A, D)\\
                    \&amp;\simeq Func^L(Cts((P A)^{op},C),D)\\
                    \&amp;\simeq Func^L(C^{A^op},D)
                    \\end{aligned}
            %p
          %p
            In general, this sort of argument should work for all lax colimits of lax functors; for instance,
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+objects"} Kleisli objects
            should also coincide with
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+objects"} Eilenberg-Moore objects
            (though this also requires enhancing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            to an
            = succeed "-category)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            with
            %a.existingWikiWord{:href => "/nlab/show/local+colimits"} local colimits
            (colimits in each hom-category distributed over by composition), lax colimits of lax functors are also lax limits.
          %h3#RelationToInfinityProfunctors
            Relation to
            = succeed "-profunctors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In analogy to the situation for
            %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
            between
            %a.existingWikiWord{:href => "/nlab/show/1-categories"} 1-categories
            (see
            = succeed ")," do
              %a{:href => "profunctor#FuncsOnPresheaves"} there
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-profunctors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-profunctors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mi ⇸
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{C} &amp;#8696; \mathcal{D}
          %p
            are equivalently plain but
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-colimit"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-colimit
            %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserving
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mspace{:width => "thickmathspace"}
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi 𝒟
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  PSh_\infty(\mathcal{C})
                  \\xrightarrow{\;}
                  PSh_\infty(\mathcal{D})
          %p
            between the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories+of+%28infinity%2C1%29-presheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-categories of
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            In this way
            %a.existingWikiWord{:href => "/nlab/show/small+%28infinity%2C1%29-categories"}
              small
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            with
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-profunctors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-profunctors
            between them form a
            %a.existingWikiWord{:href => "/nlab/show/full+sub-%28infinity%2C1%29-category"}
              full sub-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-category
            of of the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Pr%28%E2%88%9E%2C1%29Cat"} Pr(∞,1)Cat
            that of
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-categories"}
              presentable
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            with
            %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-functors
            between them.
          %h3#as_vector_spaces
            As
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In some context it makes good sense to think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            as a model for an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-abelian" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            has local colimits, making certain limits and colimits coincide, is a sort of categorification of the fact that of
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            and
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            are
            %a.existingWikiWord{:href => "/nlab/show/additive+categories"} additive categories
            in which finite products and coproducts coincide.
          %p
            More on this analogy is at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+transforms+on+sheaves"} integral transforms on sheaves
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is to be thought of as a
            %em basis
            and the locally presentable
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ↪
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \hookrightarrow PSh_{(\infty,1)}(C)
            as the
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            play the role of addition of vectors and the fact that morphisms in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            are colimit-presserving means that they play the role of
            %em linear
            maps between vector spaces. This is described also at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+distribution"} Lawvere distribution
          %p
            The monoidal product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                  %mo :
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mo ×
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                  %mo →
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} \otimes : Pr(\infty,1)Cat \times Pr(\infty,1)Cat \to Pr(\infty,1)Cat
            plays the role of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of vector spaces, with a morphism out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \otimes D
            being a bilinear morphism out of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \times D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            is closed monoidal reflects the fact that
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            is closed monoidal. The construction of the tensor product as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cts
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cts(C^{op},D)
            corresponds to the fact that, at least for finite-dimensional
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %mi W
                    %mo ≅
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V\otimes W \cong Hom(V^\ast,W)
          %p
            (A related decategorification of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            is the category
            %a.existingWikiWord{:href => "/nlab/show/Sup"} Sup
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suplattices"} suplattices
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (Application)
              %br/
              Combined with the fact that the embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat \hookrightarrow (\infty,1)Cat
              preserves limits (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#LimitsAndColimits"}
            %p
              For instance with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
              regarded as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} \infty Vect
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mi Pr
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} \rho : \mathbf{B}G \to Pr(\infty,1)Cat
              as a linear
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is sent to a presentable
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              and the morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              then define an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on that.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/PrCat"} PrCat
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
            %li
              %p
                %span.newWikiWord>
                  2Ab
                  %a{:href => "/nlab/new/2Ab"} ?
                ,
                %a.existingWikiWord{:href => "/nlab/show/2Ring"} 2Ring
          %h2#references References
          %p
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            is introduced in section 5.5.3 of
          %ul
            %li#Lurie09HTT
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            The monoidal structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pr
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Pr(\infty,1)Cat
            is described in section 4.1 of
          %ul#LurieNoncommutative
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Noncommutative+Algebra"} Noncommutative Algebra
          %p That this is in fact a symmetric monoidal structure is discussed in section 6 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Commutative+Algebra"} Commutative Algebra
          %p
            (see proposition 6.14 and remark 6.18). This monoidal structure is exhibited as a restriction of a monoidal structure on all cocomplete
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          .property
