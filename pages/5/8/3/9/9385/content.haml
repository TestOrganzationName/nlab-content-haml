          %h2#idea Idea
          %p
            The generalization of the notion of
            %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
            from
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            to
            %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            and generally to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mo ⊣
                  %mo ♭
                  %mo ⊣
                  %mo ♯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\esh \dashv \flat \dashv \sharp)
            with
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                %annotation{:encoding => "application/x-tex"} \esh
            and
            %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                  %annotation{:encoding => "application/x-tex"} \flat
            %strong
              flat
              = succeed "-connection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            on an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mo →
                  %mo ♭
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\nabla \;\colon\; X \to \flat A
          %p or equivalently a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla \;\colon\; \esh(X) \to A
                  \\,.
          %p
            This is also sometimes called a
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %em
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %em constant
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            For more see at
            = succeed "." do
              %em
                %a{:href => "cohesive+%28infinity,1%29-topos+--+structures#FlatDifferentialCohomology"} structures in a cohesive (∞,1)-topos – flat ∞-connections
          %h2#examples Examples
          %h3#flat_principal_bundles
            Flat principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} A = \mathbf{B}G
            the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are a special case of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connections"} principal ∞-connections
          %h3#flat_vector_bundles_local_systems
            Flat
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-local" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Ch
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = Core(Ch_k)
            the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+chain+complexes"} (infinity,1)-category of chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                  %mi X
                  %mo ⟶
                  %mi A
                %annotation{:encoding => "application/x-tex"} \esh X \longrightarrow A
            are
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-vector+bundles"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-vector bundles
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connections"}
                flat
                = succeed "-connections" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p
            In parts of the literature this case is understood by default when speaking of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-local systems”. Other parts refer to this as “
            %a.existingWikiWord{:href => "/nlab/show/representations+up+to+homotopy"}> representations up to homotopy
            ” (really: up to
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/higher+homotopy"} higher homotopy
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+smooth+principal+infinity-bundle"} connection on a smooth principal infinity-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinity-local+system"}> infinity-local system
                ,
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/infinity-group+infinity-algebra"} infinity-group infinity-algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/constant+infinity-stack"} constant infinity-stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Riemann-Hilbert+correspondence"} Riemann-Hilbert correspondence
          %h2#references References
          %h3#general General
          %p
            On higher version of
            %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            via
            %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+infinity-stacks"}
                locally constant
                = succeed "-stacks" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
                ,
                = succeed "," do
                  %em Vers une interprétation galoisienne de la théorie de l’homotopie
                %strong 43
                4 (2002) 257-312 &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/?id=CTGDC_2002__43_4_257_0"}> numdam:CTGDC_2002__43_4_257_0
                \&amp;rbrack;
            %li#PoleselloWaschkies05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Polesello"}> Pietro Polesello
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ingo+Waschkies"} Ingo Waschkies
                = succeed "," do
                  %em Higher monodromy
                %strong 7
                1 (2005) 109-150 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0407507"}> arXiv:0407507
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://eudml.org/doc/51918"} eudml:51918
          %p
            In view of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+theory"} cohesive homotopy theory
          %ul
            %li
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} dcct §3.8.5
          %p
            In the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-module+bundles"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-module bundles
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"}> Michael Hopkins
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              = succeed "," do
                %em Local Systems
              %em
                %a.existingWikiWord{:href => "/nlab/show/Ambidexterity+in+K%28n%29-Local+Stable+Homotopy+Theory"} Ambidexterity in K(n)-Local Stable Homotopy Theory
              (2013) &amp;lbrack;
              %a{:href => "http://www.math.harvard.edu/~lurie/papers/Ambidexterity.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/HopkinsLurie-Ambidexterity.pdf", :title => "pdf"} pdf
          %h3#ReferencesFlatInfinityVectorBundles
            Flat
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-local" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/infinity-local+systems"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-local systems
            in the sense of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-vector+bundles"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-vector bundles
            with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connections"}
                flat
                = succeed "-connections" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
          %p Component-definitions are due to:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Camilo+Arias+Abad"}> Camilo Arias Abad
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Florian+Sch%C3%A4tz"} Florian Schätz
                = succeed "," do
                  %em
                    The
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} A_\infty
                    de Rham theorem and integration of representations up to homotopy
                %strong 2013
                16 (2013) 3790–3855 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1011.4693"}> arXiv:1011.4693
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1093/imrn/rns166"} doi:10.1093/imrn/rns166
            %li#BlockSmith14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Block"}> Jonathan Block
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aaron+M.+Smith"} Aaron M. Smith
                = succeed "," do
                  %em The higher Riemann–Hilbert correspondence
                %strong 252
                (2014) 382-405 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0908.2843"}> arXiv:0908.2843
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2013.11.001"} doi:10.1016/j.aim.2013.11.001
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Camilo+Arias+Abad"}> Camilo Arias Abad
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Florian+Sch%C3%A4tz"} Florian Schätz
                = succeed "," do
                  %em
                    Flat
                    = succeed "-graded" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ℤ
                          %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                %strong 2018
                4 (2018) 961–1008 &amp;lbrack;
                %a{:href => "https://doi.org/10.1093/imrn/rnw258"}> doi:10.1093/imrn/rnw258
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/1510.04975"} arXiv:1510.04975
          %p
            Identification with
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-functors
            is made explicit in:
          %ul
            %li
              %p
                %a{:href => "#BlockSmith14"} Block &amp; Smith (2014), below Def. 2.3 (§2.2 in the preprint)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Manuel+Rivera"}> Manuel Rivera
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
                = succeed "," do
                  %em
                    The colimit of an
                    = succeed "-local" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                %strong 4
                1 (2020) 33-56 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1805.01264"}> arXiv:1805.01264
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://higher-structures.math.cas.cz/api/files/issues/Vol4Iss1/RiveraZeinalian"} higher-structures:Vol4Iss1
          %p
            and construction of a
