          %h2#definition Definition
          #HermitianForm.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+space"} Hermitian space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:lspace => "verythinmathspace"} :
                      %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} J\colon V \to V
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is
            %ul
              %li
                %p
                  a complex-valued real-
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi V
                        %mo ⊗
                        %mi V
                        %mo ⟶
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"}
                        h \;\colon\; V \otimes V \longrightarrow \mathbb{C}
            %p
              such that this is
              = succeed "," do
                %em symmetric sesquilinear
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                      %annotation{:encoding => "application/x-tex"} h
                  is complex-linear in the first argument;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mi w
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mrow
                            %mo (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} h(w,v) = \left(h(v,w) \right)^\ast
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                        %mo ,
                        %mi w
                        %mo ∈
                        %mi V
                      %annotation{:encoding => "application/x-tex"} v,w \in V
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (-)^\ast
              denotes
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
            %p
              A Hermitian form is
              %em positive definite
              (often assumed by default) if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in V
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} h(v,v) \geq 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mphantom
                          %mi AA
                        %mo ⇔
                        %mphantom
                          %mi AA
                        %mi v
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} h(v,v) = 0 \phantom{AA} \Leftrightarrow \phantom{AA} v = 0
                  \.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,J)
              equipped with a (positive definite) Hermitian form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is called a (positive definite)
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+space"} Hermitian space
          %p
          .num_remark
            %h6 Remark
            %p
              A positive-definite and complete Hermitian vector space is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
          %h2#properties Properties
          %h3#general_properties General properties
          #BasicPropertiesOfHermitianForms.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (basic properties of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+forms"} Hermitian forms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((V,J),h)
              be a positive definite
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+space"} Hermitian space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#HermitianForm"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        g(-,-) \;\coloneqq\; Re(h(-,-))
                %p
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi V
                        %mo ⊗
                        %mi V
                        %mo →
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"}
                        g \;\colon\; V \otimes V \to \mathbb{R}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mi Im
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\omega(-,-) \;\coloneqq\; -Im(h(-,-))
                %p
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi V
                        %mo ∧
                        %mi V
                        %mo →
                        %mi ℝ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\omega \;\colon\; V \wedge V \to \mathbb{R}
                        \\,.
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi g
                    %mo −
                    %mi i
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h = g - i \omega
                    \\,.
            %p The two components are related by
            #eq:RelationBetweennOmegaAndgOnHermitianSpace.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAAA
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(v,w)
                    \\;=\;
                    g(J(v),w)
                    \\phantom{AAAAA}
                    g(v,w)
                    \\;=\;
                    \\omega(v,J(v))
                    \\,.
            %p Finally
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    h(J(-),J(-)) = h(-,-)
            %p
              and so the Riemannian metrics
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              appearing from (and fully determining) Hermitian forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              via
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi g
                    %mo −
                    %mi i
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} h = g - i \omega
              are precisely those for which
            #eq:HermitianMetric.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g(J(-),J(-)) = g(-,-)
                    \\,.
            %p
              These are called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+metrics"} Hermitian metrics
          %p
            (eg.
            = succeed ")" do
              %a{:href => "#Huybrechts04"} Huybrechts 2004, Lem. 1.2.15
          .proof
            %h6#proof Proof
            %p
              The positive-definiteness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is immediate from that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              follows from the symmetric sesquilinearity of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mrow
                              %mo (
                              %mi h
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi w
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    g(w,v)
                    \&amp; \coloneqq
                    Re(h(w,v))
                    \\\
                    \&amp; =
                    Re\left( h(v,w)^\ast\right)
                    \\\
                    \&amp; =
                    Re(h(v,w))
                    \\\
                    \&amp; =
                    g(v,w)
                    \\,.
                    \\end{aligned}
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is invariant under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              follows from its sesquilinarity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h(J(v),J(w))
                    \&amp;=
                    i h(v,J(w))
                    \\\
                    \&amp; =
                    i (h(J(w),v))^\ast
                    \\\
                    \&amp; =
                    i (-i) (h(w,v))^\ast
                    \\\
                    \&amp; =
                    h(v,w)
                    \\end{aligned}
            %p
              and this immediately implies the corresponding invariance of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %p
              Analogously it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is skew symmetric:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mrow
                              %mo (
                              %mi h
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi w
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega(w,v)
                    \&amp; \coloneqq
                    \-Im(h(w,v))
                    \\\
                    \&amp; =
                    \-Im\left( h(v,w)^\ast\right)
                    \\\
                    \&amp; =
                    Im(h(v,w))
                    \\\
                    \&amp; = - \omega(v,w)
                    \\,,
                    \\end{aligned}
            %p and the relation between the two components:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega(v,w)
                    \&amp; =
                    \- Im(h(v,w))
                    \\\
                    \&amp; =
                    Re(i h(v,w))
                    \\\
                    \&amp; =
                    Re(h(J(v),w))
                    \\\
                    \&amp; =
                    g(J(v),w)
                    \\end{aligned}
            %p as well as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi J
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    g(v,w)
                    \&amp; =
                    Re(h(v,w)
                    \\\
                    \&amp; =
                    Im(i h(v,w))
                    \\\
                    \&amp; =
                    Im(h(J(v),w))
                    \\\
                    \&amp; =
                    Im(h(J^2(v),J(w)))
                    \\\
                    \&amp; =
                    \- Im(h(v,J(w)))
                    \\\
                    \&amp; = \omega(v,J(w))
                    \\,.
                    \\end{aligned}
          %p Saying the same again in other words:
          %p
          #HermitianFormsViaHermitianMetrics.num_remark
            %h6 Remark
            %p
              %strong (Hermitian forms via Hermitian metrics)
              %br/
              The decomposition of a Hermitian form into its
              %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
              and
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              is traditionally written with the symbols
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\langle-\vert-\rangle
                    \\;=\;
                    g(-,-)
                    +
                    \\mathrm{i} \omega(-,-)
            %p or similar, where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ℜ
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    g(-,-)
                    \\;\coloneqq\;
                    \\Re \langle-\vert-\rangle
                    \\,,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ℑ
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(-,-)
                    \\;\coloneqq\;
                    \\Im \langle-\vert-\rangle
                    \\,.
            %p
              are real
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              on the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            %p In fact, the real part fully determines the imaginary part and hence the Hermitian form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi ω
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi ℑ
                          %mo{:stretchy => "false"} ⟨
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi ℜ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi{:mathvariant => "normal"} i
                          %mo{:stretchy => "false"} ⟨
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi ℜ
                          %mo{:stretchy => "false"} ⟨
                          %mi{:mathvariant => "normal"} i
                          %mo −
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi ℜ
                          %mo{:stretchy => "false"} ⟨
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} ⟩
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi g
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\omega(-,-)
                    \&amp; =
                    \\Im \langle-\vert-\rangle
                    \\\
                    \&amp; =
                    \\Re \big(-\mathrm{i} \langle-\vert-\rangle\big)
                    \\\
                    \&amp; =
                    \\Re \langle \mathrm{i} - \vert - \rangle
                    \\\
                    \&amp; =
                    \\Re \langle J(-) \vert - \rangle
                    \\\
                    \&amp; =
                    g\big(J(-), -\big)
                    \\,,
                    \\end{array}
            %p
              where in the last line we introduced the
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              on the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              real vector space which promotes it back to the original complex vector space.
            %p
              Notice that the complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+map"} orthogonal map
              with respect to the inner product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+metric"} Hermitian metric
              with respect to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi g
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi J
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi ℜ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                          %mi{:mathvariant => "normal"} i
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                          %mi{:mathvariant => "normal"} i
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
