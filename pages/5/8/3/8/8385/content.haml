              = succeed ".)" do
                %a{:href => "geometric+morphism#BetweenPresheafToposes"} Geometric morphisms between presheaf toposes
          .num_remark
            %h6#remark_2 Remark
            %p
              This is a “contravariant” construction in that a morphism of sites going one way gives a geometric morphisms of toposes going the opposite way. Another condition, the
              %em
                %a.existingWikiWord{:href => "/nlab/show/covering+lifting+property"} covering lifting property
              gives a covariant assignment.
          %p Conversely, any geometric morphism which restricts and corestricts to a functor between sites of definition is induced by a morphism between those sites:
          #GeometricMorphismsComeFromMorphismsOfSites.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J)
              be a small site and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, K)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/small-generated+site"} small-generated site
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f : Sh(\mathcal{D}, K) \to Sh(\mathcal{C}, J)
            %p
              is induced by a morphism of sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                  %annotation{:encoding => "application/x-tex"} (\mathcal{D}, K) \leftarrow (\mathcal{C}, J) : F
              precisely if the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image+functor"} inverse image functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              respects the
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              making the following diagram commute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ←
                              %mi F
                          %mtd
                            %mi 𝒞
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mi 𝒟
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi j
                                    %mi 𝒞
                        %mtr
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo ,
                            %mi K
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{D } &amp;\stackrel{F}{\leftarrow}&amp; \mathcal{C}
                    \\\
                    {}^{\mathllap{j_{\mathcal{D}}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{j_{\mathcal{C}}}}
                    \\\
                    Sh(\mathcal{D}, K) &amp;\stackrel{f^*}{\leftarrow}&amp;
                    Sh(\mathcal{C}, J)
                    }
                    \\,.
          %p
            In the special case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            have finite limits and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            is subcanonical, so that morphisms of sites can be defined using representably flat functors, this appears as (
            %a{:href => "#Johnstone"}> Johnstone, lemma C2.3.8
            ). We give the proof in this case; for the general case see (
            %a{:href => "#Shulman"}> Shulman, Prop. 11.14
            ). Note that the general case would not be true for the classical definition of “morphism of sites”.
          .proof
            %h6#proof_2 Proof
            %p
              It suffices to show that given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is, if it exists, necessarily a morphism of sites: because since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and thus preserves all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              is a colimit of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is fixed by the factorization. By uniqueness of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              it is the geometric morphism induced from the morphism of sites, by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MorphismsOfSitesInduceGeometricMorphisms"}
            %p
              So we show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is necessarily a morphisms of sites:
            %ol
              %li
                %p
                  since the
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                  and
                  %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                  as well as
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %msub
                          %mi j
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} f^* j_{\mathcal{C}}
                  and hence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves finite limits, hence is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/flat+functor"} flat functor
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %msub
                          %mi h
                          %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} f^* h_{\mathcal{C}}
                  preserves
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo ,
                          %mi K
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Sh(D, K)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  is assumed to be subcanonical it follows from
                  %a{:href => "site#CharacterizationOfSubcanonicalSites"} this prop.
                  that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi j
                          %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} j_{\mathcal{D}}
                  also reflects covers. Therefore
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves covers.
          #LemmaForClassifyingToposes.num_cor
            %h6#corollary Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},J)
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              site and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Topos
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo ,
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Site
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Topos(\mathcal{E}, Sh(\mathcal{C}, J))
                    \\simeq
                    Site((\mathcal{C}, J), \mathcal{E})
            %p
              between the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}, J)
              and the morphisms of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, J)
              to the
              %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{E}, C)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              the
              %a.existingWikiWord{:href => "/nlab/show/canonical+coverage"} canonical coverage
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, cor. C2.3.9
            ).
          .proof
            %h6#proof_3 Proof
            %p
              Since for the
              %a.existingWikiWord{:href => "/nlab/show/canonical+coverage"} canonical coverage
              the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              = succeed "." do
                %a.maruku-ref{:href => "#GeometricMorphismsComeFromMorphismsOfSites"}
          .num_remark
            %h6#remark_3 Remark
            %p
              Corollary
              %a.maruku-ref{:href => "#LemmaForClassifyingToposes"}
              leads to the notion of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
          %h3#between_ary_sites
            Between
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-ary+sites"} ∞-ary sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f:C\to D
              is a morphism of sites if and only if it preserves finite local
              = succeed "-prelimits." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
          .proof
            %h6#proof_4 Proof
            %p
              See (
              %a{:href => "#Shulman"}> Shulman, Prop. 4.8
              )
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
                = succeed "," do
