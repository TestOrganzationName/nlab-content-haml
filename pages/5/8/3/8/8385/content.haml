                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#morphisms_of_sites Morphisms of sites
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#RelationToGeometricMorphisms"} Relation to geometric morphisms
                %li
                  %a{:href => "#between_ary_sites"}
                    Between
                    = succeed "-ary" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi κ
                          %annotation{:encoding => "application/x-tex"} \kappa
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em morphism of sites
            is, unsurprisingly, the appropriate sort of
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            between
            %a.existingWikiWord{:href => "/nlab/show/toposes+of+sheaves"} toposes of sheaves
            (or, more generally,
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/exact+completions"} exact completions
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f:C\to D
              is a
              %strong morphism of sites
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/flat+functor#SiteValuedFunctors"} covering-flat
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  preserves covering families, i.e. for every
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi p
                          %mi i
                        %mo :
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{p_i : U_i \to U\}
                  of an object
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ∈
                          %mi C
                        %annotation{:encoding => "application/x-tex"} U \in C
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{f(p_i) : f(U_i) \to f(U)\}
                  is a covering of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi D
                        %annotation{:encoding => "application/x-tex"} f(U) \in D
          .num_remark
            %h6#remark Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and all covering families in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+epimorphisms"} strong epimorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserving
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representably+flat+functor"} representably flat functor
            %p
              For general
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %em implies
              being covering-flat, but not conversely. Thus, the above definition of morphism of sites is more general than the common one. There are few practical examples where the distinction matters, but our definition has better formal properties (see below).
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              are
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \to B
              is equivalently a frame
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/meet"} meet
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/join"} join
          .num_example
            %h6#example_2 Example
            %p
              %strong (slice sites)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a site and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} U \in C
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C / U)
              inherits a topology from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} (C/U) \to C
              constitutes a morphism of sites. This is also called the
              %a.existingWikiWord{:href => "/nlab/show/big+site"} big site
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/restriction+and+extension+of+sheaves"} restriction and extension of sheaves
              from a sub-site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and back.
            %p
              For instance, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a topological space and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \in Op(X)
              is an open subset, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              regarded as a topological space in its own right has corresponding to it the site
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ↓
                      %mi U
                    %annotation{:encoding => "application/x-tex"} Op(U) = Op(X) \downarrow U
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular categories
              equipped with their
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/regular+coverage"} regular coverage
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/regular+functor"} regular functor
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-ary+regular+categories"} ∞-ary regular categories
              with their
              = succeed "-canonical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
          .num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              any site with finite limits, there is canonically a morphism of sites to its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
          %h2#properties Properties
          %h3#RelationToGeometricMorphisms Relation to geometric morphisms
          %p
            We discuss how morphisms of sites induce
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "es," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            = succeed "." do
              %em
                %a{:href => "geometric+morphism#BetweenPresheafToposes"} geometric morphisms – between presheaf toposes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi 𝒟
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f : (\mathcal{C},J) \to (\mathcal{D},K)
            be a morphism of sites, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            small. Then precomposition with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            defines a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between categories of presheaves
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi f
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\circ f : PSh(\mathcal{D}) \to PSh(\mathcal{C})
          #MorphismsOfSitesInduceGeometricMorphisms.num_prop
            %h6#proposition Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              between the
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (f^* \dashv f_*) : Sh(\mathcal{D},K) \stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}
                    Sh(\mathcal{C},J)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              is the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} (-)\circ f
              to sheaves.
          %p
            For the classical definition of morphisms of sites, using representably-flat functors, this appears for instance as
            = succeed "." do
              %a{:href => "#Johnstone"} Johnstone, lemma C2.3.3, cor. C2.3.4
            = succeed "." do
              %a{:href => "#Shulman"} Shulman 2012
          .proof
            %h6#proof Proof
            %p
              By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              preserves covers we have that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} (-)\circ f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi K
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_K(\mathcal{D})
              indeed factors through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}) \hookrightarrow PSh(\mathcal{C})
            %p
              Because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              a
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
