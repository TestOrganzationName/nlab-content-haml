          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            at an
            %a.existingWikiWord{:href => "/nlab/show/ADE-singularity"} ADE-singularity
            and their
            %a.existingWikiWord{:href => "/nlab/show/open+string"} open string
            %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            = succeed "):" do
              %a{:href => "ADE+singularity#ReferencesTypeIIStringsOnADE"} here
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Carsten+Andrew+L%C3%BCtken"} Carsten Andrew Lütken
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %em D-Branes on ALE Spaces and the ADE Classification of Conformal Field Theories
              %strong 622
              (2002) 269-278 (
              %a{:href => "https://doi.org/10.1016/S0550-3213%2801%2900613-7"}> doi:10.1016/S0550-3213%2801%2900613-7
              ,
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/0006247"} arXiv:hep-th/0006247
          %p
            The
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/FRS-theorem+on+rational+2d+CFT"} FRS-theorem on rational 2d CFT
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ingo+Runkel"}> Ingo Runkel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jens+Fjelstad"} Jens Fjelstad
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"} Jürgen Fuchs
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %em Topological and conformal field theory as Frobenius algebras
              = succeed "," do
                %em Categories in Algebra, Geometry and Mathematical Physics
              %strong 431
              (2007) 225-248 &amp;lbrack;
              %a{:href => "http://dx.doi.org/10.1090/conm/431"}> doi:10.1090/conm/431
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/math/0512076"} arXiv:math/0512076
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} defects
            and
            %a.existingWikiWord{:href => "/nlab/show/duality+in+physics"} duality
            (“
            %a.existingWikiWord{:href => "/nlab/show/generalized+global+symmetry"}> generalized global symmetry
            ”) in
            %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            (via the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/FRS+theorem+on+2d+rational+CFT"} FRS theorem on 2d rational CFT
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"} Jürgen Fuchs
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ingo+Runkel"} Ingo Runkel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
                = succeed "," do
                  %em Kramers-Wannier duality from conformal defects
                %strong 93
                (2004) 070601 &amp;lbrack;
                %a{:href => "https://doi.org/10.1103/PhysRevLett.93.070601"}> doi:10.1103/PhysRevLett.93.070601
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/cond-mat/0404051"} arXiv:cond-mat/0404051
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrg+Fr%C3%B6hlich"}> Jürg Fröhlich
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"} Jürgen Fuchs
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ingo+Runkel"} Ingo Runkel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
                = succeed "," do
                  %em Duality and defects in rational conformal field theory
                %strong 763
                (2007) 354-430 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/hep-th/0607247"}> arXiv:hep-th/0607247
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.nuclphysb.2006.11.017"} doi:10.1016/j.nuclphysb.2006.11.017
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"}> Christoph Schweigert
              \:
              = succeed "," do
                %em Introduction to conformal field theory
              = succeed "&rbrack;" do
                %a{:href => "https://www.math.uni-hamburg.de/home/schweigert/skripten/cftskript.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/QFTs+with+defects"} QFTs with defects
            via
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+algebra"} categorical algebra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"}> Jürgen Fuchs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alessandro+Valentino"} Alessandro Valentino
              = succeed "," do
                %em Bicategories for boundary conditions and for surface defects in 3-d TFT
              %strong 321
              (2013) 543–575 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1203.4568"}> arXiv:1203.4568
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-013-1723-0"} doi:10.1007/s00220-013-1723-0
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/extended+functorial+field+theory"} extended
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+field+theory"} homotopy field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"}> Christoph Schweigert
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lukas+Woike"} Lukas Woike
              = succeed "," do
                %em Extended Homotopy Quantum Field Theories and their Orbifoldization
              %strong 224
              4 (2020) 106213 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1802.08512"}> arXiv:1802.08512
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/j.jpaa.2019.106213"} doi:10.1016/j.jpaa.2019.106213
          %p
            On potential generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/logarithmic+CFT"} logarithmic CFT
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/J%C3%BCrgen+Fuchs"}> Jürgen Fuchs
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              = succeed "," do
                %em Full Logarithmic Conformal Field theory - an Attempt at a Status Report
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Structures+in+M-Theory+2018"} Higher Structures in M-Theory 2018
              %strong 67
              8-9 (2019)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1903.02838"} arXiv:1903.02838
              %a{:href => "https://doi.org/10.1002/prop.201910018"} doi:10.1002/prop.201910018
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p
            Constructing
            %a.existingWikiWord{:href => "/nlab/show/correlators"} correlators
            in
            %a.existingWikiWord{:href => "/nlab/show/rational+conformal+field+theory"} rational conformal field theory
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/string+net+models"} string net models
