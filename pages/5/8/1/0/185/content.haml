          %h2#idea Idea
          %p
            A
            %strong smooth algebra
            or
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
              \-ring
            is an
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            over the reals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            for which not only the product operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                  %mo :
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \cdot : \mathbb{R} \times \mathbb{R} \to \mathbb{R}
            lifts to the algebra product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \times A \to A
            %em every smooth map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %msup
                    %mi ℝ
                    %mi m
                %annotation{:encoding => "application/x-tex"} f : \mathbb{R}^n \to \mathbb{R}^m
            (
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi A
                    %mi n
                  %mo →
                  %msup
                    %mi A
                    %mi m
                %annotation{:encoding => "application/x-tex"} A(f) : A^n \to A^m
            in a compatible way.
          %p
            In short this means that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
          %ul
            %li
              %p
                a
                = succeed "-preserving" do
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
                on
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %li
              %p
                equivalently: an algebra for the
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
          %p
            The smoothness of such
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Fermat+theory"} Fermat theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} categories of sheaves
            that serve as
            %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} models
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          %h2#motivating_example Motivating example
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ↦
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}^n \mapsto C^\infty(X,\mathbb{R}^n)
                  \= Hom_{Diff}(X,\mathbb{R}^n)
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of smooth
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is clearly covariant and hence yields a copresheaf on
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊂
                %annotation{:encoding => "application/x-tex"} \subset
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi CartSp
                  %mo →
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X,-) : CartSp \to Set
                  \\,.
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            sends
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            preserving.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi ℝ
                    %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X, \mathbb{R}^n \times \mathbb{R}^m)
                  \\simeq
                  C^\infty(X,\mathbb{R}^n)
                  \\times
                  C^\infty(X, \mathbb{R}^m)
          %p
            If as usual we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(X) := C^\infty(X,\mathbb{R})
            for the set of just
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\cdot :  C^\infty(X) \times C^\infty(X) \to C^\infty(X)
          %p
            can be regarded as the image of our copresheaf under the muliplication map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mover
                    %mo →
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R} \times \mathbb{R} \stackrel{-\cdot -}{\to} \mathbb{R}
            on the algebra of real numbers:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdot
                  \:
                  C^\infty(X)
                  \\times
                  C^\infty(X)
                  \:=
                  C^\infty(X,\mathbb{R})
                  \\times
                  C^\infty(X,\mathbb{R})
                  \\simeq
                  C^\infty(X,\mathbb{R}\times \mathbb{R})
                  \\stackrel{C^\infty(X,-\cdot-)}{\to}
                  C^\infty(X,\mathbb{R})
                  \=:
                  C^\infty(X)
                  \\,.
          %h2#definitions Definitions
          .num_defn
            %h6#definition Definition
            %p
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              is the full subcategory of
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %p
              on manifolds of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %a.existingWikiWord{:href => "/nlab/show/copresheaf"} copresheaf
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              preserving
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi CartSp
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A : CartSp \to Set
                    \\,.
            %p
              The category of such functors and
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} C^\infty Alg
          .num_remark
            %h6#remark_on_terminology Remark on terminology
            %p
              The standard name in the literature for generalized smooth algebras is
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} C^\infty
                  \-rings
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher categorical
              structures.
          %h3#tensor_product Tensor product
          .num_defn
            %h6#definition_smooth_tensor_product Definition (smooth tensor product)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} C^\infty Alg
              we call the
              %strong smooth tensor product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mn ∞
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %mi Alg
                    %mo ×
                    %msup
                      %mi C
                      %mn ∞
                    %mi Alg
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mi Alg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes_\infty : C^\infty Alg \times C^\infty Alg
                    \\to C^\infty Alg
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} i : C \to A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi C
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} j : C \to B
              two morphisms in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} C^\infty Alg
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                            %mi A
                            %msub
                              %mo ⊗
                              %mi C
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\stackrel{i}{\to}&amp; A
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    B &amp;\stackrel{j}{\to}&amp; A \otimes_C B
                    }
            %p
              the
              %strong
                smooth tensor product over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %h3#finitely_generated_rings
            Finitely generated
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              is the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Hom
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
