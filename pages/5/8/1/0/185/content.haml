                                %msup
                                  %mi f
                                  %mo *
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msup
                                  %mi g
                                  %mo *
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi Z
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\infty(X) \otimes_{C^\infty(Z)} C^\infty(Y)
                    \=: &amp; C^\infty(X \times_Z Y) &amp;\leftarrow&amp; C^\infty(X)
                    \\\
                    \&amp; \uparrow &amp;&amp; \uparrow^{f^*}
                    \\\
                    \&amp; C^\infty(Y) &amp;\stackrel{g^*}{\leftarrow}&amp; C^\infty(Z)
                    }
          %p
            In particular this implies (for
            = succeed ")that" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} Z = {*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is the algebra of functions on the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mn ∞
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X \times Y) \simeq C^\infty(X) \otimes_\infty C^\infty(Y)
                  \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              The ordinary algebraic tensor product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)(\mathbb{R})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(Y)(\mathbb{R})
              regarded as ordinary algebras does
              %em not
              in general satisfy this property. Rather one has an inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(X)(\mathbb{R}) \otimes C^\infty(Y)(\mathbb{R})
                    \\subset
                    C^\infty(X \times Y)(\mathbb{R})
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              In the context of
              %a.existingWikiWord{:href => "/nlab/show/geometric+function+theory"} geometric function theory
              the corresponding general statement (without the transversality condition) says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              is a “good” kind of function. The above equation is one sub-aspect of the one of the fundamental theorems of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-function+theory"} geometric infinity-function theory
          %p
            Turning this inclusion into an equivalence is usually called a
            %em completion
            of the algebraic tensor product. Therefore we see:
          .standout
            %p The smooth tensor product is automatically the completed tensor product.
          %p In summary this yields the following characterization of smooth function algebras on manifolds.
          .num_theorem
            %h6#theorem__theorem_28
              Theorem (
              %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"}> MSIA
              , theorem 2.8)
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Diff
                    %mo →
                    %msup
                      %mi C
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} C^\infty(-) = Hom_{Diff}(-,-) : Diff \to C^\infty Alg
            %ul
              %li
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              %li
                %p
                  takes values in finitely presented smooth
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} C^\infty
              %li
                %p
                  sends transversal
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
          %h2#deformation_theory_of_smooth_algebras Deformation theory of smooth algebras
          %blockquote
            %p
              %strong under construction
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            any category whose objects we think of as “functions algebras on test spaces”, such as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} C = C^\infty Ring
            %a.existingWikiWord{:href => "/nlab/show/tangent+complex"} tangent complex
            and
            %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
            of such objects.
          %p
            As describe there, the key structure of interest from which all the other structure here is induced is the
            %strong tangent category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi C
                  %mo →
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T C \to C
                  \\,.
          %p
            This is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi C
                  %mo =
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T C = Ab(Arr(C))
            the
            %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            “fiberwise stabilized”, meaning that in each fiber one takes it to consist of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab(C/A)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
          %p
            We now first recall what this means for ordinary rings and how it induces the ordinary notion of derivations and modules for ordinary rings by setting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %msup
                      %mi C
                      %mn ∞
                    %mi Rings
                  %annotation{:encoding => "application/x-tex"} C = C^\infty Rings
          %p
            By an old argument by Quillen, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi C
                  %mo =
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} T C = Mod
            is the
            %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi A
                  %mover
                    %mo →
                    %mo ≃
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Mod_A \stackrel{\simeq}{\to} Ab(C/A)
                  \\,.
          %p
            This is induced by the functor that sends an
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            to the corresponding object in the square-0-extension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ⊕
                    %mi N
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R \oplus N \to R
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
          %p From this structure alone a lot of further structure follows:
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo :
                      %mi A
                      %mo →
                      %mi N
                    %annotation{:encoding => "application/x-tex"} \delta: A \to N
                is precisely a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                of the corresponding morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊕
                      %mi N
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \oplus N \to A
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} /
                        %mi A
                      %annotation{:encoding => "application/x-tex"} C/A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                namely a ring homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                            %mtd
                              %mover
                                %mo →
                                %mi δ
                            %mtd
                            %mtd
                              %mi A
                              %mo ⊕
                              %mi N
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mo =
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;&amp;\stackrel{\delta}{\to}&amp;&amp; A \oplus N
                      \\\
                      \&amp; {}_ {=}\searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; A
                      }
                      \\,.
            %li
              %p
                The forgetful functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Ring
                      %mo ≃
                      %mi Mod
                      %mo →
                      %mi Ring
                    %annotation{:encoding => "application/x-tex"} T Ring \simeq Mod \to Ring
                has a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi K
                        %mn 1
                      %mo :
                      %mi Ring
                      %mo →
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega_K^1 : Ring \to Mod
              %p
                that sends each ring to its module of
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+differential"} Kähler differential
              %p The fact that it is left adjoint is the universal property of the Kähler differentials as the objects co-representing derivations:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mrow
                          %mi Ab
                          %mo{:stretchy => "false"} (
                          %mi Ring
                          %mo{:stretchy => "false"} /
                          %mi R
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Ω
                        %mi K
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Hom
                        %mrow
                          %mi Ring
                          %mo{:stretchy => "false"} /
                          %mi A
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo ⊕
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{Ab(Ring/R)}(\Omega_K^1(A),N) \simeq
                      Hom_{Ring/A}(A,A \oplus N).
              %p
                So every derivation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo :
                      %mi A
                      %mo →
                      %mi N
                    %annotation{:encoding => "application/x-tex"} \delta : A \to N
                uniquely corresponds to a module morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi K
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi N
                      %annotation{:encoding => "application/x-tex"} \Omega^1_K(A) \to N
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mi a
                        %mo ↦
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d a \mapsto \delta(a)
          %p
            This abstract story remains precisely the same for
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            The crucial observation is (as one can show) that an abelian group object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mi Ring
                  %mo{:stretchy => "false"} /
                  %mi A
                %annotation{:encoding => "application/x-tex"} C^\infty Ring/A
            is a square-0 extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊕
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A \oplus N)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            an (ordinary) module of the
            %em underlying
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %em uniquely
            equipped with the
            = succeed "-Ring-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi n
                    %mo ,
                    %msub
                      %mi n
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %msup
                          %mn 1
                          %mi n
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msub
                          %mi x
                          %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi n
                      %mi i
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (f \in C^\infty(\mathbb{R}^n) \to \mathbb{R})
                  \\mapsto
                  \\left(
                  (a_1, n_1), \cdots, (a_n, n_n))
                  \\mapsto
                  f(a_1, \cdots, a_n)
                  +
                  \\sum_{i = 1^n} \frac{\partial f}{\partial x_i}(a_1, \cdots, a_n) n_i
                  \\right)
                  \\,.
          %p
            This uniquely induced smooth structure on objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ab
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mi Ring
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ab(C^\infty Ring/A)
            then in turn affects the nature of the notion of derivation and of Kähler differentials, as those are defined by general abstract reasoning from the former.
          %p
            First of all it follows that a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            – by general abstract definition a morphism of
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Id
                  %mo ⊕
                  %mi δ
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                  %mo ⊕
                  %mi N
                %annotation{:encoding => "application/x-tex"} Id \oplus \delta : A \to A \oplus N
            – is a morphism that satisfies
            %em for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n, \mathbb{R})
            that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi a
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi i
                  %mfrac
                    %mrow
                      %mo ∂
                      %mi f
                    %mrow
                      %mo ∂
                      %msub
                        %mi x
                        %mi i
                  %mi δ
                  %msub
                    %mi a
                    %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta : f(a_1, \cdots, a_n) \mapsto
                  \\sum_i \frac{\partial f}{\partial x_i}
                  \\delta a_i
                  \\,.
          %p
            For ordinary rings only the compatibility
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ⋅
                  %msub
                    %mi a
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi a
                    %mn 2
                  %mo +
                  %msub
                    %mi a
                    %mn 1
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta (a_1 \cdot a_2) = \delta (a_1) a_2 + a_1 \delta(a_2)
            with the single product operation is required. Here, however, compatibility with infinitely more operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n, \mathbb{R})
            is demanded.
          %p
            Accordingly, then, the Kähler differentials as defined with respect to such derivations are different from the purely ring-theoretic ones: they produce the
            %em right
            notion of smooth 1-forms here, whereas the ring-theoretic one does not.
          %h2#variants Variants
          %p
            The generalization of the notion of smooth algebra for
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/smooth+%28%E2%88%9E%2C1%29-algebra"}> smooth (∞,1)-algebra
              \.
          %p
            The generalization to
            %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
            is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/smooth+superalgebra"}> smooth superalgebra
              \.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/module+over+a+C%5E%E2%88%9E-ring"} module over a C^∞-ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/C%5E%E2%88%9E-derivation"}> C^∞-derivation
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+C%5E%E2%88%9E-differential"} Kähler C^∞-differential
                %a.existingWikiWord{:href => "/nlab/show/differential+graded+C%5E%E2%88%9E-ring"} differential graded C^∞-ring
            %li
