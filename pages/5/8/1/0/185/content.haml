              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ell C^\infty(\mathbb{R})
            %p
              Then we have for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %msup
                      %mi Ring
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} A \in C^\infty Ring^{fin}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mi ℓ
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi R
                      %mi n
                    %mo ↦
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    C(Y\ell A) : R^n \mapsto A({*})^n
          .proof
            %h6#proof Proof
            %p This is a straightforward manipulation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Sh
                              %mi 𝕃
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msup
                              %mi R
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi Sh
                              %mi 𝕃
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi PSh
                              %mi 𝕃
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi 𝕃
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi A
                            %mo ,
                            %mi ℓ
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi C
                              %mn ∞
                            %msup
                              %mi Ring
                              %mi fin
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mo *
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Sh_{\mathbb{L}}(Y(\ell A), R^n)
                    \&amp; =
                    Sh_{\mathbb{L}}(Y(\ell A), Y(\ell C^\infty(\mathbb{R}^n)))
                    \\\
                    \&amp; = PSh_{\mathbb{L}}(Y(\ell A), Y(\ell C^\infty(\mathbb{R}^n)))
                    \\\
                    \&amp; \simeq \mathbb{L}(\ell A, \ell C^\infty(\mathbb{R}^n))
                    \\\
                    \&amp; \simeq C^\infty Ring^{fin}(C^\infty(\mathbb{R}^n), A)
                    \\\
                    \&amp; \simeq A({*})^n
                    \\end{aligned}
            %p Here
            %ol
              %li
                %p the first step expresses the nature of the line object in the models under consideration
              %li
                %p
                  the second step expresses that the embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sh
                        %mo{:stretchy => "false"} (
                        %mi 𝕃
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi 𝕃
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sh(\mathbb{L}) \to PSh(\mathbb{L})
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              %li
                %p
                  the third step expresses that the
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              %li
                %p
                  the fourth step is the definition of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕃
                      %annotation{:encoding => "application/x-tex"} \mathbb{L}
                  as the
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %msup
                          %mi Ring
                          %mi fin
                      %annotation{:encoding => "application/x-tex"} C^\infty Ring^{fin}
              %li
                %p
                  the fifth step expresses that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi R
                          %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(R^n)
                  is the free generalized smooth algebra on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  generators (
                  %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"}> MSIA, chaper I, prop 1.1
                  )
          %h3#local_algebra
            Local
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            The category
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            carries a natural
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
          %p A smooth algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %mi CartSp
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  A : CartSp \to Set
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/locally+algebra-ed+topos"} local algebra
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            sends
            %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            families to epimorphism families: for each covering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
            the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi i
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\coprod_i A(U_i) \to A(U)
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          .num_prop
            %h6#proposition_2 Proposition
            %p Local smooth algebras are precisely the “local Archimedian” algebras (…).
          %p
            This is (
            %a{:href => "#BungeDubuc"}> Bunge-Dubuc, prop. 2.1
            ).
          %h2#examples Examples
          %h3#functions_on_smooth_manifolds Functions on smooth manifolds
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              is the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Hom
                      %mi Diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(X) := Hom_{Diff}(X,-)
          %h3#weil_algebras_functions_on_small_infinitesimal_spaces Weil algebras: functions on small infinitesimal spaces
          %p
            A
            %em Weil algebra
            in this context is a finite-dimensional commutative
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            with a maximal ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo ≃
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} W/I \simeq \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi I
                    %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} I^n = 0
            for some
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              There is a unique
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              a finitely presented
              = succeed "-ring." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} C^\infty
          .num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
              corresponding to Weil algebras are
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal space
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
          %h3#power_series Power series
          %p …
          %h3#Germs Functions on germs of manifolds
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{R}^n
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/germ"} germ
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            carries an evident
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                  %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)_p
          %p
            With
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi p
                  %mo ⊂
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I_p \subset C^\infty(\mathbb{R}^n)
            the ideal of functions that vanish on a neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi I
                    %mi p
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C^\infty_p(\mathbb{R}^n) \simeq C^\infty(\mathbb{R}^n)/I_p
                  \\,,
          %p
            yielding a finitely generated but not (for
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            = succeed "-ring." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %h2#properties Properties
          %h3#limits_and_colimits Limits and colimits
          .num_prop
            %h6#proposition_4 Proposition
            %p
              All
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mi Ring
                  %annotation{:encoding => "application/x-tex"} C^\infty Ring
              are computed objectwise in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi CartSp
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CartSp,Set]
              as limits in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          .proof
            %h6#proof_2 Proof
            %p
              As discussed at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi CartSp
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CartSp,Set]
              are computed objectwise, so the remaining question is if they preserve the property of functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} CartSp \to Set
              to preserved products. The claim follows from the observation that
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} MSIA, p. 22
          %h3#UnderlyingAlgebra The underlying ordinary algebra
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mi Alg
                  %mo →
                  %mi Alg
                %annotation{:encoding => "application/x-tex"}
                  U : C^\infty Alg \to Alg
          %p
            from generalized smooth algebras to ordinary algebras which is given by evaluation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi A
                  %mo ↦
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U : A \mapsto A(\mathbb{R})
          %p
            and equipping the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(\mathbb{R})
            with the algebra structure induced on it:
          %p
            the product and sum on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(\mathbb{R})
            is the image of the corresponding operations on the algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⋅
                    %mi A
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdot_A
                  \:
                  A(\mathbb{R}) \times A(\mathbb{R})
                  \\stackrel{\simeq}{\to}
                  A(\mathbb{R}\times \mathbb{R})
                  \\stackrel{A(\cdot)}{\to}
                  A(\mathbb{R})
                  \\,.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi A
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo +
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  +_A :
                  A(\mathbb{R}) \times A(\mathbb{R})
                  \\stackrel{\simeq}{\to}
                  A(\mathbb{R} + \mathbb{R})
                  \\stackrel{A(\cdot)}{\to}
                  A(\mathbb{R})
                  \\,.
          %p Moreover there is canonically a morphism of rings
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R} \to A(\mathbb{R})
          %p given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo =
                  %msup
                    %mi ℝ
                    %mn 0
                  %mover
                    %mo →
                    %mi c
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo =
                  %mi A
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (* = \mathbb{R}^0 \stackrel{c}{\to} \mathbb{R})
                  \\mapsto
                  (* = A(\mathbb{R}^0) \stackrel{A(c)}{\to} A(\mathbb{R}))
                  \\,.
          %p
            This makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(\mathbb{R})
            an
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              fits into an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi C
                      %mn ∞
                    %msub
                      %mi Alg
                      %mi ℝ
                    %mover
                      %munder
                        %mo →
                        %mi U
                      %mover
                        %mo ←
                        %mi F
                    %msub
                      %mi Alg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F \dashv U)
                    \:
                    C^\infty Alg_{\mathbb{R}}
                    \\stackrel{\overset{F}{\leftarrow}}{\underset{U}{\to}}
                    Alg_{\mathbb{R}}
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p This statement may be understood as a special case of the following more general statement:
            %ul
              %li
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                are
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/finitary+monad"} finitary monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi S
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} f: S \to T
                is a monad morphism, then the relative forgetful functor
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %mo :
                        %msub
                          %mi Alg
                          %mi T
                        %mo →
                        %msub
                          %mi Alg
                          %mi S
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} f^*: Alg_T \to Alg_S,
                %p
                  which
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pulls back
                  a
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ξ
                        %mo :
                        %mi T
                        %mi X
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \xi: T X \to X
                  to the
                  = succeed "-algebra" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ξ
                          %mo ∘
                          %mi f
                          %mi X
                          %mo :
                          %mi S
                          %mi X
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \xi \circ f X: S X \to X
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %p
              (In the case under discussion,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the free algebra monad on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the free smooth algebra monad, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} f: S \to T
              is induced from the obvious inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(n): S(n) \to T(n)
              which interprets an
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Th
                        %mi S
                    %annotation{:encoding => "application/x-tex"} Th_S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Th
                        %mi T
                    %annotation{:encoding => "application/x-tex"} Th_T
              %a.existingWikiWord{:href => "/nlab/show/finitary+monad"} finitary monad
              for discussion on the connection between finitary monads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and Lawvere theories
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Th
                        %mi T
                    %annotation{:encoding => "application/x-tex"} Th_T
            %p
              The desired left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              takes an algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi S
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \theta: S X \to X
              to the
              %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
              exhibited as a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi S
                    %mi X
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi T
                          %mi θ
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi μ
                            %mi T
                          %mo ∘
                          %mi T
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mi X
                    %mi T
                    %mi X
                    %mover
                      %mo →
                      %mi π
                    %mi T
                    %msub
                      %mo ⊗
                      %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T S X \stackrel{\overset{(\mu_T \circ T f)X}{\to}}{\underset{T\theta}{\to}} T X \stackrel{\pi}{\to} T \otimes_S X
            %p
              in the category of
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi μ
                      %mi T
                    %mo :
                    %mi T
                    %mi T
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} \mu_T: T T \to T
              is the monad multiplication. The coequalizer is denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msub
                      %mo ⊗
                      %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T \otimes_S X
              to emphasize the analogy with pushing forward
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              along a ring homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} f: S \to T
              to get
              = succeed "-modules;" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              A finitary monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/reflexive+coequalizer#applications_4"} preserves reflexive coequalizers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msub
                      %mo ⊗
                      %mi S
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi T
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T(T \otimes_S X) \cong (T T) \otimes_S X
            %p
              It follows that
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "-module)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ¯
                      %mo :
                      %mi T
                      %msub
                        %mo ⊗
                        %mi S
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \bar{g}: T \otimes_S X \to Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mi T
                            %msub
                              %mo ⊗
                              %mi S
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi T
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ¯
                          %mtd
                            %mi T
                            %mi Y
                        %mtr
                          %mtd
                            %mi μ
                            %msub
                              %mo ⊗
                              %mi S
                            %mi X
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi ξ
                        %mtr
                          %mtd
                            %mi T
                            %msub
                              %mo ⊗
                              %mi S
                            %mi X
                          %mtd
                            %munder
                              %mo →
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ¯
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T T \otimes_S X &amp; \stackrel{T\bar{g}}{\to} &amp; T Y \\
                    \\mu \otimes_S X \downarrow &amp; &amp; \downarrow \xi \\
                    T \otimes_S X &amp; \underset{\bar{g}}{\to} &amp; Y
                    }
            %p
              are in bijection with maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi T
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} g: T X \to Y
              that render commutative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %mi T
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi T
                                %mi g
                          %mtd
                            %mi T
                            %mi Y
                        %mtr
                          %mtd
                            %mi μ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi ξ
                        %mtr
                          %mtd
                            %mi T
                            %mi X
                          %mtd
                            %munder
                              %mo →
                              %mi g
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T T X &amp; \stackrel{T g}{\to} &amp; T Y \\
                    \\mu \downarrow &amp; &amp; \downarrow \xi \\
                    T X &amp; \underset{g}{\to} &amp; Y
                    }
            %p
              (that is to say,
              = succeed "-algebra" do
