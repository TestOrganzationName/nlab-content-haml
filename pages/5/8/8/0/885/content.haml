          %h3#division_and_remainder Division and remainder
          %p
            Given a natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ÷
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo ×
                  %msub
                    %mi ℕ
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} m \div n: \mathbb{N} \times \mathbb{N}_{+} \to \mathbb{N}
            such that
          %ul
            %li
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} m:\mathbb{N}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo :
                      %msub
                        %mi ℕ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} n:\mathbb{N}_{+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m \lt n
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ÷
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} m \div n = 0
            %li
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} m:\mathbb{N}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo :
                      %msub
                        %mi ℕ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} n:\mathbb{N}_{+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ÷
                    %mi n
                    %mo =
                    %mn 1
                    %mo +
                    %mi m
                    %mo ÷
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m + n) \div n = 1 + m \div n)
          %p and the remainder function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mspace{:width => "thickmathspace"}
                  %mi %
                  %mspace{:width => "thickmathspace"}
                  %mi n
                  %mo ≔
                  %mi m
                  %mo −
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ÷
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi n
                %annotation{:encoding => "application/x-tex"} m\ \%\ n \coloneqq m - (m \div n) \cdot n
          %h2#natural_numbers_objects Natural numbers objects
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                %annotation{:encoding => "application/x-tex"} \mathbf{N}
            is a
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            in
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is not used) and a successor operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ↦
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \mapsto n + 1
            (or simply
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ↦
                    %msup
                      %mi n
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n \mapsto n^+
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                  %annotation{:encoding => "application/x-tex"} n+
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi X
                  %annotation{:encoding => "application/x-tex"} a: X
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} s: X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi N
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f: \mathbf{N} \to X
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn 0
                  %mo =
                  %mi a
                %annotation{:encoding => "application/x-tex"} f_0 = a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_{n+1} = s(f_n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is said to be constructed by
            = succeed "." do
              %strong primitive recursion
            %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
            are also possible.)
          %p
            The basic idea is that we define the values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            one by one, starting with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} f_0 = a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_1 = s(a)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 2
                    %mo =
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_2 = s(s(a))
            %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            to ensure that this can go on uniquely forever.
          %h2#properties Properties
          %h3#minima_of_subsets_of_natural_numbers Minima of subsets of natural numbers
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
            subset of the natural numbers possesses a minimal element. In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          #BrouwerianCounterexample.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Brouwerian+counterexample"} Brouwerian counterexample
            %p
              If every inhabited subset of the natural numbers possesses a minimal element, then the
              %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} law of excluded middle
              holds.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              be an arbitrary arithmetical formula. Then the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi n
                    %mo ∈
                    %mi ℕ
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mi n
                    %mo =
                    %mn 1
                    %mo ∨
                    %mi φ
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} U := \{ n \in \mathbb{N} \,|\, n = 1 \vee \varphi \} \subseteq \mathbb{N}
            %p
              is inhabited. By assumption, it possesses a minimal element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} n_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 0
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n_0 = 0
              or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi n
                        %mn 0
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n_0 \gt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \varphi
              holds. In the second case,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi φ
                  %annotation{:encoding => "application/x-tex"} \neg\varphi
              holds.
          %p
            In this sense, the natural numbers are not complete, and it’s fruitful to study their completion: For instance, the global sections of the completed natural numbers object in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} sheaf topos
            on a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are in one-to-one correspondence with upper semicontinuous functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} X \to \mathbb{N}
            (details at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/one-sided+real+number"} one-sided real number
          %p We can salvage the minimum principle in two ways:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Any
              %strong
                %a.existingWikiWord{:href => "/nlab/show/decidable+subset"} detachable
              inhabited subset of the natural numbers possesses a minimal element.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Any inhabited subset of the natural numbers does
              %strong not not
              possess a minimal element.
          %p
            For instance, any finitely generated vector space over a
            %a.existingWikiWord{:href => "/nlab/show/field"} residue field
            does
            %em not not
            possess a finite basis (pick a minimal generating set, guaranteed to
            %em not not
            exist). Interpreting this in the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of the sheaf topos of a
            %a.existingWikiWord{:href => "/nlab/show/reduced+scheme"} reduced scheme
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally free on a dense open subset.
          %h3#decreasing_sequences_of_natural_numbers Decreasing sequences of natural numbers
          %p
            Classically, any
            %em weakly
            decreasing sequence of natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} (a_n)_n
            is eventually constant, i.e. admits an index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi N
                    %mo =
                    %msub
                      %mi a
                      %mrow
                        %mi N
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi a
                      %mrow
                        %mi N
                        %mo +
                        %mn 2
                    %mo =
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} a_N = a_{N+1} = a_{N+2} = \cdots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            that there exists an index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi N
                    %mo =
                    %msub
                      %mi a
                      %mrow
                        %mi N
                        %mo +
                        %mn 1
                    %mo =
                    %mi ⋯
                    %mo =
                    %msub
                      %mi a
                      %mrow
                        %mi N
                        %mo +
                        %mi M
                  %annotation{:encoding => "application/x-tex"} a_N = a_{N+1} = \cdots = a_{N+M}
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            so that
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≤
                    %msub
                      %mi a
                      %mn 0
                    %mi M
                  %annotation{:encoding => "application/x-tex"} N \leq a_0 M
            %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            (which follows already when
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a_0 = 1
          %p
            On the other hand, there can be no
            %em strictly
            decreasing sequence of natural numbers. This is constuctively valid (proved by contradiction and induction on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_0
          %p
            This is relevant to
            = succeed "," do
              %span.newWikiWord
                constructive algebra
                %a{:href => "/nlab/new/constructive+algebra"} ?
