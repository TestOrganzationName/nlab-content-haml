                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            Every coreflexive morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ≤
                  %msub
                    %mn 1
                    %mi X
                %annotation{:encoding => "application/x-tex"} r \leq 1_X
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Reg
                %annotation{:encoding => "application/x-tex"} Reg
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/retract"} splits
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Reg
                  %annotation{:encoding => "application/x-tex"} Reg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mi id
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi i
                  %mi X
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Ext(r) \overset{id}{\leftarrow} Ext(r) \overset{i}{\to} X,
          %p
            whose opposite
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mi op
                  %mo :
                  %mi X
                  %mo →
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i^op: X \to Ext(r)
            also belongs to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Reg
                %annotation{:encoding => "application/x-tex"} Reg
            (that is,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is an open embedding), and the equations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mi op
                  %mo ∘
                  %mi i
                  %mo =
                  %msub
                    %mn 1
                    %mrow
                      %mi Ext
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mi i
                  %mo ∘
                  %msup
                    %mi i
                    %mi op
                  %mo =
                  %mi r
                %annotation{:encoding => "application/x-tex"} i^{op} \circ i = 1_{Ext(r)} \qquad i \circ i^{op} = r
          %p
            hold. The object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ext
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ext(r)
            may be called the
            %em extension
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %span.newWikiWord
              comprehension principle
              %a{:href => "/nlab/new/comprehension+principle"} ?
            familiar from the theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/allegory"} allegories
          %p
            A
            %strong cartology
            is a (locally
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi C
                  %mo ↪
                  %mi Reg
                %annotation{:encoding => "application/x-tex"} i: C \hookrightarrow Reg
            such that
          %ul
            %li
              (Closure under open subspaces) If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ob(C)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≤
                    %msub
                      %mn 1
                      %mi X
                  %annotation{:encoding => "application/x-tex"} r \leq 1_X
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Reg
                    %annotation{:encoding => "application/x-tex"} Reg
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i: Ext(r) \to X
              and its opposite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mi op
                  %annotation{:encoding => "application/x-tex"} i^{op}
              are morphisms of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              (“Sheaf condition”) The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi C
                    %mo →
                    %mi Reg
                  %annotation{:encoding => "application/x-tex"} i: C \to Reg
              reflects and preserves local joins.
          %p
            Intended examples include the case where the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are Euclidean spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi ℝ
                    %mi m
                  %mo →
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} (U, f): \mathbb{R}^m \to \mathbb{R}^n
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is smooth.
          %p
            Given a cartology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} r = (U, f): X \to Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %strong pseudo-invertible
            if there exists
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} s = (V, g): Y \to X
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∘
                  %mi r
                  %mo =
                  %msub
                    %mn 1
                    %mi U
                %annotation{:encoding => "application/x-tex"} s \circ r = 1_U
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∘
                    %mi s
                    %mo =
                    %msub
                      %mn 1
                      %mi V
                  %annotation{:encoding => "application/x-tex"} r \circ s = 1_V
          .num_lemma
            %h6#lemma Lemma
            %p
              In a cartology, the pseudo-invertible morphisms from an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to itself form a pseudogroup (as defined earlier).
          %p
            The notion of a
            = succeed "-manifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is defined just as before, using the pseudogroup on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            implied by the previous lemma. In particular, we have
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong charts
            of an atlas structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Reg
                %annotation{:encoding => "application/x-tex"} Reg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ←
                    %mi i
                  %mi U
                  %mover
                    %mo →
                    %mi ϕ
                  %mi M
                %annotation{:encoding => "application/x-tex"} X \overset{i}{\leftarrow} U \overset{\phi}{\to} M
          %p
            satisfying the expected properties. We can thus speak of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong manifolds
            (or
            = succeed "-manifolds" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, X)
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Now, given a cartology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-manifolds." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            = succeed "-manifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            a
            = succeed "-manifold." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, Y)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong morphism
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi M
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} f: M \to N
            such that the
            = succeed "-composite" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Reg
                  %annotation{:encoding => "application/x-tex"} Reg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi U
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi M
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi V
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mi i
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                          %mi ϕ
                        %mtd
                        %mtd
                          %mn 1
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                          %mi f
                        %mtd
                        %mtd
                          %mi ψ
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                          %mi j
                        %mtd
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi M
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi N
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; U &amp;&amp;&amp;&amp; M &amp;&amp;&amp;&amp; V &amp;&amp; \\
                  \&amp; i \swarrow &amp;&amp; \searrow \phi &amp;&amp; 1 \swarrow &amp;&amp; \searrow  f &amp;&amp; \psi \swarrow &amp;&amp; \searrow j &amp; \\
                  X &amp;&amp;&amp;&amp; M &amp;&amp;&amp;&amp; N &amp;&amp;&amp;&amp; Y
                  }
          %p
            belongs to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} (U, \phi): X \to M
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Y
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} (V, \psi): Y \to N
          %p
            These definitions need to be carefully checked against known examples (e.g., the categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PL
                  %annotation{:encoding => "application/x-tex"} PL
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                  %annotation{:encoding => "application/x-tex"} Smooth
          %h2#generalizations Generalizations
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+space"} generalized smooth space
            %li
