              = succeed ")" do
                %a.maruku-ref{:href => "#LinearPermutationRepresentation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                    %mover
                      %mo ⟶
                      %mrow
                        %mi k
