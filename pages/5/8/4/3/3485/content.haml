          #VirtualPermuationRepresentationOfS4.num_example
            %h6#example_4 Example
            %p
              %strong
                (virtual permutation representations of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %msub
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} G = S_n
              a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements, the comparison morphism from the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
              to the
              %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMapBurnsideRingRepresentationRing"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi β
                    %mi R
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A(S_n)
                    \\overset{\beta}{\longrightarrow}
                    R(S_n)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective map
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              but also over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %p
              The special case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S_4
              is made explicit for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k =\mathbb{R}
              in
              = succeed "," do
                %a{:href => "#Montaldi"} Montaldi
              = succeed "," do
                %a{:href => "http://www.maths.manchester.ac.uk/~jm/wiki/Representations/S4"} this page
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} k =\mathbb{C}
              at
              = succeed "." do
                %em
                  %a{:href => "Gram-Schmidt+process#CategorifiedGramSchmidtProcess"} Categorified Gram-Schmidt process
