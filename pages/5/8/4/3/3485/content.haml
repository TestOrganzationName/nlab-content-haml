                        %annotation{:encoding => "application/x-tex"} A(G) \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Burnside+ring+is+equivariant+stable+cohomotopy+of+the+point"&gt;Segal 71&lt;/a&gt;}}{\simeq}  \mathbb{S}_G(\ast)  \overset{ \text{compl.} }{\longrightarrow} \widehat {\mathbb{S}_G(\ast)} \!\! \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Segal-Carlsson+completion+theorem"&gt;Carlsson 84&lt;/a&gt;}}{\simeq} \!\!\!\!\!\! \mathbb{S}(B G)
                    %br/
          %h3#characters Characters
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} characters
            of permutation representations are the
            %a.existingWikiWord{:href => "/nlab/show/Burnside+marks"} Burnside marks
            of the underlying
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
          #MarkHomomorphismIsCharactersOfPermutationRepresentation.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/mark+homomorphism"} mark homomorphism
                on
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
                agrees with
                %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} characters
                of corresponding
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/permutation+representations"} permutation representations
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi G
                    %msub
                      %mi Set
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} S \in G Set_{fin}
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              any
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi Rep
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k[S] \in Rep_k(G)
              the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+representation"} character
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \chi_{k[S]}
              of the
              %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
              at any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              equals the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+marks"} Burnside marks
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BurnsideCharacter"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              under the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \langle g\rangle \subset G
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi g
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo |
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} ⟨
                          %mi g
                          %mo{:stretchy => "false"} ⟩
                      %mo |
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo ⟶
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{k[S]}\big( g \big)
                    \\;=\;
                    \\left\vert X^{\langle g \rangle} \right\vert
                    \\;\in\;
                    \\mathbb{Z} \longrightarrow k
                    \\,.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/mark+homomorphism"} mark homomorphism
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BurnsideCharacter"}
              = succeed "-sets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              coincides with the
              %a.existingWikiWord{:href => "/nlab/show/character+of+a+representation"} characters
              of their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutation+representations"} permutation representations
            %p
              This statement immediately generalizes from plain representations to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/virtual+representations"} virtual representations
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#tomDieck09"} tom Dieck 09, (2.15)
          .proof
            %h6#proof Proof
            %p
              By definition of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/character+of+a+linear+representation"} character of a linear representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi tr
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mi S
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{k[S]}(g)
                    \=
                    tr_{k[S]}(g)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              of the
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi g
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[S] \overset{g}{\to} k[S]
              of the given
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            %p
              Now the canonical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[S]
              is of course the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              itself, and so
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi χ
                              %mrow
                                %mi k
                                %mo{:stretchy => "false"} [
                                %mi S
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi s
                                %mo ∈
                                %mi S
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mn 1
                                    %mtd
                                      %mo{:stretchy => "false"} |
                                    %mtd
                                      %mi g
                                      %mo{:stretchy => "false"} (
                                      %mi s
                                      %mo{:stretchy => "false"} )
                                      %mo =
                                      %mi s
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mo{:stretchy => "false"} |
                                    %mtd
                                      %mtext otherwise
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo |
                              %msup
                                %mi S
                                %mi g
                              %mo |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo |
                              %msup
                                %mi S
                                %mrow
                                  %mo{:stretchy => "false"} ⟨
                                  %mi g
                                  %mo{:stretchy => "false"} ⟩
                              %mo |
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\chi_{k[S]}(g)
                    \&amp; =
                    \\underset{
                    s \in S
                    }{\sum}
                    \\left\{
                    \\array{
                    1 &amp;\vert&amp; g(s) = s
                    \\\
                    0 &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
                    \\\
                    \&amp; =
                    \\left\vert S^g \right\vert
                    \\\
                    \&amp;
                    \=
                    \\left\vert S^{\langle g \rangle} \right\vert
                    \\end{aligned}
            %p
              Here in the first step we spelled out the definition of
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              in the canonical basis, and in the second step we observed that the
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+set"} fixed point set
              of a
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              equals that of any one of its generating elements.
          %h2#examples Examples
          %h3#basic_examples Basic examples
          #RegularRepresentation.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"}> regular representation
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi s
                  %annotation{:encoding => "application/x-tex"} G_s
              for its underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %msub
                              %mi G
                              %mi s
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ρ
                                  %mi ℓ
                          %mtd
                            %msub
                              %mi G
                              %mi s
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ,
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi g
                            %mo ⋅
                            %mi s
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G \times G_s
                    \&amp;\overset{ \rho_\ell }{\longrightarrow}&amp;
                    G_s
                    \\\
                    (g,s) &amp;\mapsto&amp; g \cdot s
                    }
            %p
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself, by left multiplication in the group. The corresponding linear permutation representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi G
                      %mi s
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mi ℓ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k[G_s], k(\rho_\ell))
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearPermutationRepresentation"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/induced+representation+of+the+trivial+representation"}> induced representation of the trivial representation
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mover
                      %mo ↪
                      %mi ι
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \overset{\iota}{\hookrightarrow} G
              a
              = succeed "-inclusion." do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induced representation
              in
              %a.existingWikiWord{:href => "/nlab/show/representation+category"} Rep(G)
              of the
              %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ∈
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{1} \in Rep(H)
              is the
              %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[G/H]
              of the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} ind
                      %mi H
                      %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{ind}_H^G\big( \mathbf{1}\big)
                    \\;\simeq\;
                    k[G/H]
                    \\,.
            %p
              This follows directly as a special case of the general formula for
              %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
              (
              %a{:href => "induced+representation#InductionOfFiniteDimensionalRepresentationsOfFiniteGroups"}> this Example
              ).
            %p
              See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/induced+representation+of+the+trivial+representation"} induced representation of the trivial representation
              for more.
          %h3#ExamplesVirtualPermutationRepresentations Virtual permutation representations
          %p
            We discuss here examples of the operation of forming
            %em virtual
            linear permutation representations (Remark
            = succeed ")," do
              %a.maruku-ref{:href => "#VirtualLinearPermuationRepresentations"}
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mphantom
                        %mi AA
                      %mi β
                      %mo ≔
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mphantom
                        %mi AA
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(G) \overset{ \phantom{AA} \beta \coloneqq K(k[-]) \phantom{AA} }{\longrightarrow} R(G)
          %p
            from Def.
            = succeed "." do
              %a.maruku-ref{:href => "#ComparisonMapBurnsideRingRepresentationRing"}
          %p
            For emphasis, notice that among plain
            %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
            the linear permutation representations generally form but a tiny sub-class, i.e. generically a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            is
            %em not
            a linear permutation representation. But this statement may change radically as we pass to
            %em virtual
            representations:
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#ComparisonMapBurnsideRingRepresentationRing"}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective function
            %em all
            virtual linear
            = succeed "-representation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.maruku-ref{:href => "#WhenAllVirtualLinearRepsAreVirtualPermutationReps"}
            below.
          %p
            Notice that when this is the case, it means that the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            of the given group is, in a precise sense, purely
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/combinatorics"} combinatorial
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:ComparisonInStableHomotopytheoryInStages"} (1)
            %a.existingWikiWord{:href => "/nlab/show/absolute+ground+field"} absolute ground field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
          #WhenAllVirtualLinearRepsAreVirtualPermutationReps.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong (virtual linear reps from virtual permutation reps)
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{Q}
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi β
                        %mo =
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A(G) \overset{ \beta = K(k[-]) }{\longrightarrow} R(G)
            %p
              from Def.
              = succeed "," do
                %a.maruku-ref{:href => "#ComparisonMapBurnsideRingRepresentationRing"}
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} virtual G-sets
              to their permutation rep
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} virtual linear G-representations
            %ol
              %li
                %p
                  is
                  %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  among one of the following classes of
                  %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
                  (not mutually exclusive)
                %ol
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"}> cyclic groups
                      ,
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"}> symmetric groups
                      ,
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/p-groups"}> p-groups
                      ,
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/binary+dihedral+groups"} binary dihedral groups
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mspace{:width => "thickmathspace"}
                          %annotation{:encoding => "application/x-tex"} \;
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                            %msub
                              %mi D
                              %mrow
                                %mn 2
                                %mi n
                          %annotation{:encoding => "application/x-tex"} 2 D_{2n}
                      for (at least)
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 2
                            %mi n
                            %mo ≤
                            %mn 12
                          %annotation{:encoding => "application/x-tex"} 2 n \leq 12
                  %li
                    %p
                      the
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/binary+tetrahedral+group"} binary tetrahedral group
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/binary+octahedral+group"} binary octahedral group
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo ,
                            %msub
                              %mi 𝔽
                              %mn 3
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} GL(2,\mathbb{F}_3)
              %li
                %p
                  is
                  %em not
                  %a.existingWikiWord{:href => "/nlab/show/surjective+map"} surjective
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 3
                        %mo ×
                        %msub
                          %mi Q
                          %mn 8
                      %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/3 \times Q_8
                  (
                  %a.existingWikiWord{:href => "/nlab/show/direct+product"} direct product
                  of
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
                  of
                  %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
                  3 with
                  %a.existingWikiWord{:href => "/nlab/show/quaternion+group"} quaternion group
                  of order 8);
              %li
                %p
                  is
                  %a.existingWikiWord{:href => "/nlab/show/injective+map"} injective
                  precisely for
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              %li
                %p
                  hence is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  precisely for cyclic groups.
          .proof
            %h6#proof_2 Proof
            %p
              Isomorphy for the case of cyclic groups is spelled out in
              = succeed "." do
                %a{:href => "#tomDieck09"} tom Dieck 09, Example (4.4.4)
            %p
              Surjectivity for the case of symmetric groups follows from the theory of
              %a.existingWikiWord{:href => "/nlab/show/Young+diagrams"} Young diagrams
              (
              %a{:href => "#Dress86"}> Dress 86, section 3
              ), see also Example
              %a.maruku-ref{:href => "#VirtualPermuationRepresentationOfS4"}
              below for further pointers.
            %p
              The proof of surjectivity for
              %a.existingWikiWord{:href => "/nlab/show/p-primary+groups"} p-primary groups
              is due to
              = succeed "." do
                %a{:href => "#Segal72"} Segal 72
              = succeed "." do
                %a{:href => "#Feit67"} Feit 67 (14.3)
              = succeed ".)" do
                %a{:href => "#Ritter72"} Ritter 72
              = succeed "." do
                %a{:href => "#tomDieck79"} tom Dieck 79, Theorem 4.4.1
            %p
              Surjectivity for
              %a.existingWikiWord{:href => "/nlab/show/binary+dihedral+groups"} binary dihedral groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %msub
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} 2 D_{2n}
              for (at least)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo ≤
                      %mn 12
                    %annotation{:encoding => "application/x-tex"} 2 n \leq 12
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/binary+tetrahedral+group"} binary tetrahedral group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/binary+octahedral+group"} binary octahedral group
              %a.existingWikiWord{:href => "/nlab/show/binary+icosahedral+group"} binary icosahedral group
              and the
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(2,\mathbb{F}_3)
              is checked by
              %a.existingWikiWord{:href => "/nlab/show/computer+experiment"} computer experiment
              in
              = succeed "." do
                %a{:href => "#BurtonSatiSchreiber18"} Burton-Sati-Schreiber 18
            %p
              The non-surjectivity for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 3
                    %mo ×
                    %msub
                      %mi Q
                      %mn 8
                  %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/3 \times Q_8
              is an exercise in
              = succeed "." do
                %a{:href => "#Serre77"} Serre 77, p. 104
            %p
              To see that injectivity holds at most for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{Q}
              we have that
            %ol
              %li
                %p
                  the number of
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
                  of
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  equals the number of
                  %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
                  of
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %li
                %p
                  the number of
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
                  of indecomposable (
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"}> transitive
                  )
                  %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
                  (i.e.
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
                  types) is the number of
                  %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
                  of
                  %em all
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            %p
              (
              %a{:href => "#tomDieck09"}> tom Dieck 09, Prop. 4.5.4
              )
            %p
              This means that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              not a cyclic group we have that the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(G))
              has more
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators
              than
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(G)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              cannot be injective.
          %p
            A more general analysis of the
            %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is due to
            = succeed "," do
              %a{:href => "#Berz94"} Berz 94
            = succeed "." do
              %a{:href => "#HambletonTaylor99"} Hambleton-Taylor 99
            = succeed "." do
              %a{:href => "#BartelDokchitser14"} Bartel-Dokchitser 14, p. 1
          %p
            The following result is adapted from an exercise in
            = succeed "." do
              %a{:href => "#Serre77"} Serre 77, p. 104
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of characteristic zero.
          #WhenNotAllVirtualLinearRepsAreVirtualPermutationReps.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong (nonsurjectivity of the map from virtual permutation representations to virtual linear representations)
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a finite group with a linear representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              such that:
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                is
                %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
                and
                %a.existingWikiWord{:href => "/nlab/show/faithful+representation"} faithful
              %li
                every subgroup of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                appears with multiplicity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n \ge 2
                in the
                %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %p
              Then the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta: A(G) \to R(G)
              is not surjective.
          .proof
            %h6#proof_3 Proof
            %p
              It suffices to prove that the multiplicity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              in any permutation representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a multiple of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ρ
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\rho] \in R(G)
              cannot be in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
            %p
              Since every finite
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
              for subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a direct sum of those on spaces of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[G/H]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              in the representation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[G/H]
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is the trivial group, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              otherwise.
            %p
              The former holds by assumption 3. For the latter, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a nontrivial subgroup of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is normal by assumption 2, every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %mi H
                  %annotation{:encoding => "application/x-tex"} h \in H
              acts trivially on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[G/H]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              act on an arbitrary basis element
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi H
                      %mo =
                      %mi H
                      %mi g
                      %mo ∈
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} g H = H g \in G/H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mi H
                    %mi g
                    %mo =
                    %mi H
                    %mi g
                    %mo .
                  %annotation{:encoding => "application/x-tex"} h H g = H g .
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is nontrivial, it contains elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} h \ne 1
              that act trivially on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[G/H]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} h \ne 1
              can act trivially on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is faithful, by assumption 1. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              cannot be a subrepresentation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[G/H]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              appears with multiplicity
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[G/H]
          %p
            It is an exercise in
            %a{:href => "#Serre77"} Serre 77, p. 104
            to show that the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 3
                  %mo ×
                  %msub
                    %mi Q
                    %mn 8
                %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/3 \times Q_8
            obeys the conditions of this proposition, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta : A(G) \to R(G)
            is nonsurjective. As a hint, Serre suggests to embed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/3
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mn 8
                %annotation{:encoding => "application/x-tex"} Q_8
            in the multiplicative group of the algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℍ
                    %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{H}_{\mathbb{Q}}
            (the quaternions defined over
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mn 3
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/3
            act by left multiplication and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mn 8
                %annotation{:encoding => "application/x-tex"} Q_8
            act by right multiplication, one obtains a 4-dimensional irreducible representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            which appears with multiplicity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \ge 2
            in the regular representation. Furthermore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is faithful and irreducible, and every subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is normal.
          #VirtualPermutationRepresentationsOfZ2.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/virtual+permutation+representations"} virtual permutation representations
                of the
                %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} G = \mathbb{Z}/2
              be the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
            %p
              It has two
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo =
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} H =\mathbb{Z}/2
                  the group itself,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} H = 1
                  the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
            %p
              and hence two
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
              %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} (\mathbb{Z}/2)/(\mathbb{Z}/2) = \ast
                  the
                  %a.existingWikiWord{:href => "/nlab/show/point"} point
                  with the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mn 1
                        %mo =
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} (\mathbb{Z}/2)/1 = \mathbb{Z}/2
                  the group itself, with the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
            %p
              The corresponding linear permutation representations (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LinearPermutationRepresentation"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} k[ (\mathbb{Z}/2)/(\mathbb{Z}/2)] \;\simeq\; \mathbf{1}
                  ,
                %p
                  the 1-dimensional
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mo ⊕
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mn 1
                          %mi alt
                      %annotation{:encoding => "application/x-tex"} k[ (\mathbb{Z}/2)/1 ] \; \simeq\; \mathbf{1} \oplus \mathbf{1}_{alt}
                  ,
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of the 1d
                  %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
                  with the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/alternating+representation"} alternating representation
            %p
              To see the second item, observe that the non-trivial element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \sigma \in \mathbb{Z}/2
              is represented on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} ⟨
                    %mi e
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} k[\mathbb{Z}/2] \simeq \langle e,\sigma\rangle
              by the
              %a.existingWikiWord{:href => "/nlab/show/permutation+matrix"} permutation matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\,,
            %p
              which is
              %a.existingWikiWord{:href => "/nlab/show/diagonal+matrix"} diagonalizable
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{Z}
              with
              %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mn 1
                              %mtr
                                %mtd
                                  %mn 1
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\array{ 1 \\ 1 }\right]
                  of
                  %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} 1
                  %a.existingWikiWord{:href => "/nlab/show/linear+span"} spanning
                  the
                  %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbf{1}
                  of dimension 1;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo [
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mn 1
                              %mtr
                                %mtd
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                          %mo ]
                      %annotation{:encoding => "application/x-tex"} \left[\array{ 1 \\ -1 }\right]
                  of
                  %a.existingWikiWord{:href => "/nlab/show/eigenvalue"} eigenvalue
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} -1
                  %a.existingWikiWord{:href => "/nlab/show/linear+span"} spanning
                  the
                  %a.existingWikiWord{:href => "/nlab/show/alternating+representation"} alternating representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mn 1
                          %mi alt
                      %annotation{:encoding => "application/x-tex"} \mathbf{1}_{alt}
                  of dimension 1.
            %p
              Hence, the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
              may be identified with the
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} ⟨
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi alt
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    R(\mathbb{Z}/2) \;\simeq_k\; \langle \mathbf{1}, \mathbf{1}_{alt}  \rangle
            %p
              and the comparison morphism from the
              %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComparisonMapBurnsideRingRepresentationRing"}
            .maruku-equation
