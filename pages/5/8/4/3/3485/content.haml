                  %annotation{:encoding => "application/x-tex"}
                    \\big(G Set, \sqcup, \times\big)
                    \\overset{ \phantom{AA} k[-] \phantom{AA} }{\longrightarrow}
                    \\big(G Rep, \oplus, \otimes \big)
                    \\,.
