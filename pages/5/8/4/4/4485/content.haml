                        %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+%28%E2%88%9E%2C1%29-site"} étale (∞,1)-site
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+stack"} Deligne-Mumford stack
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/%E2%84%93-adic+cohomology"} ℓ-adic cohomology
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#pullbacks"} Pullbacks
                %li
                  %a{:href => "#epimorphisms_and_coverings"} Epimorphisms and coverings
                %li
                  %a{:href => "#ehresmanns_theorem"} Ehresmann’s theorem
                %li
