                %annotation{:encoding => "application/x-tex"} G_{int}
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            and in degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d + 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            the effective
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            of the given material (in practice:
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
