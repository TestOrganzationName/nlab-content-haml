                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ×
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ⊗
                      %mo ¯
                    %mi Y
                    %mo ,
