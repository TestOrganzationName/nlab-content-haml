                %annotation{:encoding => "application/x-tex"} P^A_{B,C}
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
