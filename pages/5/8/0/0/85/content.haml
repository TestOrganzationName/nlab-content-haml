                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C},V] \otimes [\mathcal{C},V] \to [\mathcal{C},V]
          %h3#for_promonoidal_categories For promonoidal categories
          %p
            The
            %a{:href => "#InTermsOfProfunctors"} above
            description in terms of profunctors makes it clear that the construction only depends on the representable profunctor induced by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %mi 𝒞
                    %mo ⊗
                    %mi 𝒞
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \otimes : \mathcal{C}\otimes \mathcal{C}\to \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed ")," do
              %a{:href => "#Day70"} Day 70
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is assumed only to be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
          %p
            Before continuing our discussion, we comment a bit on a convention adopted in
            = succeed "." do
              %a{:href => "#Day70Thesis"} (Day’s thesis)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+structures"} promonoidal structures
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒜
                      %mi{:mathvariant => "normal"} op
                    %mo ×
                    %msup
                      %mi 𝒜
                      %mi{:mathvariant => "normal"} op
                    %mo ×
                    %mi 𝒜
                    %mo →
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} P\colon\mathcal{A}^\mathrm{op}\times\mathcal{A}^\mathrm{op}\times\mathcal{A} \to \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
            = succeed "\u21F8" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒜
                    %mo ×
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} P\colon\mathcal{A}\times\mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            is a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒜
                      %mi{:mathvariant => "normal"} op
                    %mo ×
                    %mi 𝒜
                    %mo ×
                    %mi 𝒜
                    %mo →
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} P\colon\mathcal{A}^\mathrm{op}\times\mathcal{A}\times\mathcal{A} \to \mathcal{V}
            = succeed "," do
              %a{:href => "#Corner2016"} (Corner 2016)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
            = succeed "-presheaves." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi P
                  %mo ,
                  %mi I
                  %mo ,
                  %mi λ
                  %mo ,
                  %mi ρ
                  %mo ,
                  %mi α
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C},P,I,\lambda,\rho,\alpha)
            be a small
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            equipped with the structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi P
                    %mrow
                      %mi B
                      %mo ,
