                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Lan
                              %mrow
                                %msub
                                  %mo ⊗
                                  %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mover
                              %mo ⊗
                              %mo ¯
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mover
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi c
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo ⊗
                              %mi 𝒞
                            %msub
                              %mi c
                              %mn 2
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mover
                              %mo ⊗
                              %mo ¯
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo ,
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi c
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo ⊗
                              %mi 𝒞
                            %msub
                              %mi c
                              %mn 2
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi V
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Lan_{\otimes_{\mathcal{C}}} (X\overline{\otimes} Y)(c)
                    \&amp;
                    \\simeq
                    \\overset{(c_1,c_2)}{\int}
                    \\mathcal{C}(c_1 \otimes_{\mathcal{C}} c_2, c )
                    \\wedge
                    (X\overline{\otimes}Y)(c_1,c_2)
                    \\\
                    \&amp; =
                    \\overset{(c_1,c_2)}{\int}
                    \\mathcal{C}(c_1 \otimes_{\mathcal{C}} c_2, c)
                    \\wedge
                    X(c_1) \otimes_V Y(c_2)
                    \\end{aligned}
                    \\,.
          %p
            Proposition
            %a.maruku-ref{:href => "#DayConvolutionViaKanExtensionOfExternalTensorAlongTensor"}
            implies the following fact, which is the key for the identification of “
            %a.existingWikiWord{:href => "/nlab/show/functors+with+smash+product"}> functors with smash product
            ”.
          #DayConvolutionViaNaturalIsosInvolvingExternalTensorAndTensor.num_cor
            %h6#corollary Corollary
            %p
              The operation of
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi Day
                  %annotation{:encoding => "application/x-tex"} \otimes_{Day}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalDayConvolutionProduct"}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
