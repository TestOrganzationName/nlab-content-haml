                %annotation{:encoding => "application/x-tex"} P(A,B,C)
            (this is called the Einstein notation for profunctors; see (
            %a{:href => "#Fosco"}> Loregian 2019, Definition 5.1.10
            )).
          #DayConvolutionForPromonoidalCategories.num_defn
            %h6#definition_4 Definition
            %p
              The
              %strong Day convolution tensor product
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^\mathsf{op},\mathcal{V}]
              is the bifunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \otimes_{Day}\colon[\mathcal{C}^\mathsf{op},\mathcal{V}]\times[\mathcal{C}^\mathsf{op},\mathcal{V}]\longrightarrow[\mathcal{C}^\mathsf{op},\mathcal{V}]
            %p
              defined on objects by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %msub
                      %mo ⊗
                      %mi Day
                    %mi G
                    %mo =
                    %mover
                      %mo ∫
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ∈
                        %mi 𝒞
                    %mi F
