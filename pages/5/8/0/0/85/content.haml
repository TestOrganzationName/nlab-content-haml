                            \\mathcal{C}(c_1 \otimes_{\mathcal{C}} c_4, c_2 ) \otimes \mathcal{C}(c_5,c_5)
                            \\longrightarrow
                            \\mathcal{C}(c_1 \otimes_{\mathcal{C}} c_4 \otimes_{\mathcal{C}} c_5, c_2 \otimes_{\mathcal{C}} c_5)
                  %li
                    %p
                      the monoidal functor incarnation
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 4
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi V
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 5
                            %mo{:stretchy => "false"} )
                            %mo ⟶
                            %mi R
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 4
                            %msub
                              %mo ⊗
                              %mi 𝒞
                            %msub
                              %mi c
                              %mn 5
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} R(c_4) \otimes_V R(c_5)\longrightarrow R(c_4 \otimes_{\mathcal{C}} c_5 )
                      of the monoid structure on
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi R
                            %annotation{:encoding => "application/x-tex"} R
              %li
                %p
                  the second morphism is, in the integrand, given by composition in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  the last morphism is the morphism induced on
                  %a.existingWikiWord{:href => "/nlab/show/coends"} coends
                  by regarding
                  %a.existingWikiWord{:href => "/nlab/show/extranatural+transformation"} extranaturality
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} c_4
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} c_5
                  separately as a special case of extranaturality in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 6
                        %mo ≔
                        %msub
                          %mi c
                          %mn 4
                        %mo ⊗
                        %msub
                          %mi c
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} c_6 \coloneqq c_4 \otimes c_5
                  (and then renaming).
            %p
              It is fairly straightforward to see that, under the above identifications, functoriality under this composition is equivalently functoriality in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              together with the action property over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %h2#examples Examples
          .num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
              over a set, which is hence a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              (for instance a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋅
                    %annotation{:encoding => "application/x-tex"} \cdot
            %p Then the Day convolution product is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⋆
                    %mi G
                    %mo :
                    %mi e
                    %mo ↦
                    %msub
                      %mo ⊕
                      %mrow
                        %mi c
                        %mo ⋅
                        %mi d
                        %mo =
                        %mi e
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F \star G : e \mapsto \oplus_{c \cdot d = e} F(c) \times G(d)
                    \\,.
            %p
              Notice that if we regard the presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              here, assuming they take values in finite sets, as
              %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorifications
              of
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi F
                      %mo{:stretchy => "false"} |
                      %mo ,
                      %mo{:stretchy => "false"} |
                      %mi G
                      %mo{:stretchy => "false"} |
                      %mo :
                      %mi C
                      %mo →
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} |F|, |G| : C \to \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo ⋅
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi Set
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} |\cdot| : Set \to \mathbb{N}
              is the cardinality operation on finite sets, then this reproduces precisely the ordinary convolution product of these
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                            %mi F
                            %mo ⋆
                            %mi G
                            %mo{:stretchy => "false"} |
                            %mo :
                            %mi e
                          %mtd
                            %mo ↦
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi c
                                %mo ,
                                %mi d
                                %mo ∈
                                %mi C
                            %mo{:stretchy => "false"} |
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %mo ×
                            %mo{:stretchy => "false"} |
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %mo ×
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi c
                            %mo ⊗
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi c
                                %mo ⋅
                                %mi d
                                %mo =
                                %mi e
                            %mo{:stretchy => "false"} |
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %mo ⋅
                            %mo{:stretchy => "false"} |
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    |F \star G| : e &amp;\mapsto
                    \\sum_{c,d \in C}
                    |F(c)| \times |G(d)| \times \delta(e, c \otimes d)
                    \&amp; =
                    \\sum_{c \cdot d = e} |F(c)| \cdot |F(d)|
                    \\end{aligned}
            %p
              This uses in particular that for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi δ
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(c,-) = \delta_c
            %p
              is in this sense the Kronecker delta-function on the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              supported at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has only identity morphisms.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mi if
                              %mi c
                              %mo =
                              %mi d
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mi if
                              %mi c
                              %mo ≠
                              %mi d
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(c,d) = \left\{ \array{
                    * &amp; if c = d
                    \\\
                    \\emptyset &amp; if c \neq d
                    } \right.
          %p Further examples:
          %ul
            %li
              %p
                There is an obvious monoidal structure on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical sets
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"} strict omega-categories
            %li
              %p
                There is a monoidal structure on the
                %a.existingWikiWord{:href => "/nlab/show/augmented+simplex+category"} augmented simplex category
                which by Day convolution induces a monoidal structure on the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+sets"} augmented simplicial sets
                %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join operation
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                %a.existingWikiWord{:href => "/nlab/show/large+category"} large category
                in one
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/universe"} universe
                %a.existingWikiWord{:href => "/nlab/show/universe+enlargement"} universe enlargement
                to a bigger universe can be given a closed monoidal structure via Day convolution.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
                of
                %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
                obtained from Girard’s “phase spaces”, or more generally from
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/ternary+frames"} ternary frames
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/posets"} posets
          #SymmetricSmashProductOfSpectra.num_example
            %h6#example_3 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+of+spectra"} symmetric smash product of spectra
              on, in particular,
              %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              and
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
              is the Day convolution product for
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
              on monoidal categories of
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
              = succeed ")." do
                %a{:href => "#MMSS00"} MMSS 00, theorem 1.7 and section 21.
            %p
              Similarly the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+product+of+spectra"} symmetric smash product of spectra
              on the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+excisive+functors"} model structure for excisive functors
              is Day convolution for
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
              on the plain
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of finite pointed
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              (
              %a{:href => "#Lydakis98"}> Lydakis 98
              ).
            %p
              See also at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/functor+with+smash+products"} functor with smash products
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/monoidal+topos"} monoidal topos
          %h2#References References
          %p The concept, and many of its basic properties, originates in several works of Brian Day, including:
          %ul
            %li#Day70Thesis
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                ,
                = succeed "," do
                  %em Construction of Biclosed Categories
                = succeed "." do
                  %a{:href => "https://doi.org/10.26190/unsworks/8048"} DOI
            %li#Day70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                ,
                = succeed "," do
                  %em On closed categories of functors
                = succeed ")," do
                  %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/DayReport.pdf"} pdf
            %li#Day74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                ,
                = succeed "," do
                  %em On closed categories of functors II
            %li#Day77
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Day"}> Brian Day
                ,
                = succeed "," do
                  %em Promonoidal functor categories
          %p
            (Note that some unproven statements in
            %a{:href => "#Day70"} (Day’s report)
            are proved in
            %a{:href => "#Day70Thesis"} (Day’s thesis)
            and vice versa.)
          %p The universal property of the Day convolution, in the sense of free monoidal cocompletion, is discussed in
          %ul
            %li
              Geun Bin Im and G. M. Kelly,
              = succeed "," do
                %em A universal property of the convolution monoidal structure
          %p
            A generalisation to
            = succeed "-cocompletions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            of weights is discussed in §3 of:
          %ul
            %li
              S. R. Johnson,
              = succeed "," do
                %em Monoidal Morita equivalence
          %p General discussion includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd Trimble
              on Day convolution
              %a{:href => "http://golem.ph.utexas.edu/category/2008/01/the_concept_of_a_space_of_stat.html#c014365"} here
          %p
            The application of Day convolution to the construction of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+smash+products+of+spectra"} symmetric smash products of spectra
            for
            %a.existingWikiWord{:href => "/nlab/show/highly+structured+spectra"} highly structured spectra
            is due to
          %ul
            %li#MMSS00
              %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"}> Michael Mandell
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
              = succeed "," do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/mmssLMSDec30.pdf"} pdf
              = succeed ")" do
                %a{:href => "http://plms.oxfordjournals.org/content/82/2/441.short?rss=1&ssource=mfc"} publisher
          %p
            and for
            %a.existingWikiWord{:href => "/nlab/show/excisive+functors"} excisive functors
            due to
          %ul
            %li#Lydakis98
              Lydakis,
              %em Simplicial functors and stable homotopy theory
              Preprint, available via Hopf archive, 1998 (
              %a{:href => "http://hopf.math.purdue.edu/Lydakis/s_functors.pdf"}> pdf
              )
          %p
            (see also at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/functors+with+smash+product"} functors with smash product
          %p
            Day convolution for
            %a.existingWikiWord{:href => "/nlab/show/monoidal+bicategories"} monoidal bicategories
            is developed in
          %ul
            %li#Corner2016
              %span.newWikiWord>
                Alexander Corner
                %a{:href => "/nlab/new/Alexander+Corner"} ?
              ,
              = succeed "," do
                %em Day convolution for monoidal bicategories
              = succeed "." do
                %a{:href => "http://etheses.whiterose.ac.uk/16767/"} White Rose theses database
          %p
            Day convolution for
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-categories"} symmetric monoidal (∞,1)-categories
            is discussed in
          %ul
            %li
              Saul Glasman,
              %em Day convolution for infinity-categories
              (
              %a{:href => "http://arxiv.org/abs/1308.4940"}> arXiv:1308.4940
              )
          %p
            Day convolution for
            = succeed "-promonoidal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-operad"} ∞-operad
            is discussed in
          %ul
            %li
              Jay Shah,
              %em Parameterized higher category theory II: universal constructions
              (
              %a{:href => "https://arxiv.org/abs/2109.11954"}> arXiv:2109.11954
              )
          %p Other references cited in this page:
          %ul
            %li#Fosco
              %a.existingWikiWord{:href => "/nlab/show/Fosco+Loregian"}> Fosco Loregian
              ,
              %em Coend calculus
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/1501.02503"}> arXiv
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-colimits"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
