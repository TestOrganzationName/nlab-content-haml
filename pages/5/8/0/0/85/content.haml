          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mover
                    %mo →
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi 𝒞
                  %mo ⊗
                  %mi 𝒞
                  %mover
                    %mo →
                    %mrow
                      %mi E
                      %mo ⊗
                      %mi E
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo ⊗
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{C}\xrightarrow{\mathcal{C}(\otimes,1)} \mathcal{C}\otimes \mathcal{C}\xrightarrow{E\otimes E} [\mathcal{C},V]^{op} \otimes [\mathcal{C},V]^{op}
          %p
            is a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ⊗
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} ]
