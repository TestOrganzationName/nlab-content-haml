                  %mo :
                  %mi 𝒞
                  %mo ⊗
                  %mi 𝒞
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \otimes :\mathcal{C}\otimes \mathcal{C}\to \mathcal{C}
            induces a representable profunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo ⊗
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒞
                    %mi ⇸
                    %mi 𝒞
                    %mo ⊗
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(\otimes,1): \mathcal{C} &amp;#8696; \mathcal{C}\otimes \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} X,Y\in [\mathcal{C},V]
            are regarded as profunctors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mi ⇸
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} &amp;#8696; I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the unit
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %msub
                    %mo ⊗
                    %mi Day
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\otimes_{Day} Y
            is the composite of profunctors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mover
                    %mo →
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi 𝒞
                  %mo ⊗
                  %mi 𝒞
                  %mover
                    %mo →
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                  %mi I
                  %mo ⊗
                  %mi I
                  %mo ≅
                  %mi I
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathcal{C}\xrightarrow{\mathcal{C}(\otimes,1)} \mathcal{C}\otimes \mathcal{C}\xrightarrow{X\otimes Y} I\otimes I \cong I.
          %p
            A more “global” way to say the same thing is to consider the “evaluation” functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi 𝒞
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} [\mathcal{C},V] \otimes \mathcal{C} \to V
            to be a profunctor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo :
                    %mi 𝒞
