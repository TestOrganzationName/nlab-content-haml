                      %mi G
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^n(B G, \mathbb{Z})
                has no
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion
                %em at most one
                extended prequantization of a given invariant polynomial.
            %li
              %p
                %strong selecting physically natural theories
                While the traditional formalization of
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
                field theory does capture crucial aspects of those
                %a.existingWikiWord{:href => "/nlab/show/theories+%28physics%29"} theories
                that one is interested in in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/physics"} physics
                %em generic
                %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian"} local Lagrangian
                (in the sense of a horizontal form on the
                %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                %a.existingWikiWord{:href => "/nlab/show/theory+%28physics%29"} theories
                of relevance in theoretical physics do no share.
          %p
            The remaining question then is how accurately
            %a.existingWikiWord{:href => "/nlab/show/extended+prequantum+field+theory"} extended prequantum field theory
            constrains the space of possible
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangians"} local Lagrangians
            %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
            or
            = succeed "?" do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Wess-Zumino-Witten+theory"} ∞-Wess-Zumino-Witten theory
          %p
            As a hint to the answer of this question, here is a list of names examples of
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/1d+Chern-Simons+theory"} 1d Chern-Simons theory
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Wilson+loop"} Wilson loop
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/2d+Chern-Simons+theory"} 2d Chern-Simons theory
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"}> Poisson sigma-model
                        ,
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/A-model"}> A-model
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
                        %a.existingWikiWord{:href => "/nlab/show/topological+string"} topological string
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/3d+Chern-Simons+theory"} 3d Chern-Simons theory
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/3d+quantum+gravity"} 3d quantum gravity
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/4d+Chern-Simons+theory"} 4d Chern-Simons theory
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Yetter+model"} Yetter model
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/BF-theory"} BF-theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/5d+Chern-Simons+theory"} 5d Chern-Simons theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/6d+Chern-Simons+theory"} 6d Chern-Simons theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
                  %ul
                    %li
                      %p
                        topological
                        = succeed "-sector" do
                          %a{:href => "http://ncatlab.org/nlab/show/AdS-CFT#AdS7CFT6"} AdS7/CFT6
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/topological+M-theory"} topological M-theory
            %li
              %p
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Dijkgraaf-Witten+theory"} ∞-Dijkgraaf-Witten theory
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+gravity"} higher dimensional Chern-Simons gravity
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-model"} AKSZ sigma-model
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
          %p
            The last example here brings us back full circle to where we started this motivation with
            = succeed ":" do
              %a{:href => "#IngredientsOfFundamentalPhysics"} above
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
            (or some
            %a.existingWikiWord{:href => "/nlab/show/KK-reduction"} KK-reduction
            thereof) contains
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Einstein-Yang-Mills+theory"} Einstein-Yang-Mills theory
