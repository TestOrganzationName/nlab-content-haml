                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H} \coloneqq
                  \&amp; Sh_\infty(\mathcal{C})
                  \&amp;
                  \\stackrel{
                  \\overset{\infty-stackif.}{\leftarrow}
                  }{
                  \\hookrightarrow
                  }
                  \&amp;
                  PSh_\infty(\mathcal{C})
                  \\\
                  \&amp; \uparrow^{\mathrlap{\simeq}} &amp;&amp; \uparrow^{\mathrlap{\simeq}}
                  \\\
                  \&amp; L_{lwhe} Func(\mathcal{C}^{op}, sSet)
                  \&amp;
                  \\stackrel{
                  \\overset{\mathbb{L} id}{\leftarrow}
                  }{
                  \\underset{\mathbb{R} id}{\rightarrow}
                  }&amp;
                  L_{whe} Func(\mathcal{C}^{op}, sSet)
                  }
                  \\,.
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            encoded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            in which all of our constructions take place.
          %p
            In order to formulate not just
            %a.existingWikiWord{:href => "/nlab/show/kinematics"} kinematics
            but also
            %a.existingWikiWord{:href => "/nlab/show/dynamics"} dynamics
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has an intrinsic notion of what it means to have a
            %em path
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/trajectory"} trajectory
            inside one of its objects. This is axiomatized by the notion of
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            satisfies some properties that make it an an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-cohesive+site"} infinity-cohesive site
            %a.existingWikiWord{:href => "/nlab/show/global+section+geometric+morphism"} global section geometric morphism
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            extended to an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
