                            %mo →
                          %mtd
                            %msup
                              %mi C
                              %mi I
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
