              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function"} function
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
              for the expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{b \colon B}{\sum} fib(f,b)
                    \=
                    \\underset{b \colon B}{\sum} \underset{a \colon A}{\sum} (f(a) = b)
            %p
              is the canonical
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as it appears notably in the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
