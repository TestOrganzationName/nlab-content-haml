                        %msub
                          %mi pr
                          %mn 2
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{X} \!\times_X\! \widehat{X}
                    \\underoverset{pr_2}{pr_1}{\rightrightarrows}
                    X
            %p
