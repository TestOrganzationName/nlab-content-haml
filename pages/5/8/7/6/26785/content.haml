                      %mi E
                      %mi a
                    %mo ⊗
                    %msubsup
                      %mi pr
                      %mn 2
                      %mo *
                    %msup
                      %mi E
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{a b}
                    \\,
                    pr_1^\ast E^a
                    \\otimes
                    pr_1^\ast E^b
                    \\;\;
                    \=
                    \\;\;
                    \\delta_{a b}
                    \\,
                    pr_2^\ast E^a
                    \\otimes
                    pr_2^\ast E^b
            %p
              where we use the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of such local co-frames is regarded as equivalent if their induced metric tensors agree on the common
              %a{:href => "refinement#RefinementOfOpenCovers"} refinement
              of their respective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
          %p
            %br/
          %h3#AdaptedDarbouxCoframes Local Darboux (co-)frame field
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,g)
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %ul
            %li
              %p
                an
                %strong orthonormal local frame
                is an
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mi X
                        %mo ^
                      %mo ↠
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p \colon \widehat{X} \twoheadrightarrow X
                equipped with a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                of
                %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mi D
                      %mover
                        %mo →
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %mi T
                      %mover
                        %mi X
                        %mo ^
                    %annotation{:encoding => "application/x-tex"}
                      V
                      \\;\colon\;
                      \\mathbb{R}^{D} \xrightarrow{\;\;} T \widehat X
              %p
                such that at each point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi X
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat x \,\in\, \widehat{X}
                we have that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi V
                      %mo ,
                      %mi V
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      g\big(V,V\big)(x)
              %p
                is the canonical
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
                on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^D
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi V
                        %mi a
                      %mo ,
                      %msub
                        %mi V
                        %mi b
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi δ
                        %mrow
                          %mi a
                          %mi b
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      g\big(V_a, V_b\big)(x)
                      \\;=\;
                      \\delta_{a b}
                      \\,;
            %li
              %p
                an
                %strong orthonormal local co-frame
                is an
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mover
                        %mi X
                        %mo ^
                      %mo ↠
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p \colon \widehat{X} \twoheadrightarrow X
                equipped with a
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi D
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^D
                %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi T
                      %mover
                        %mi X
                        %mo ^
                      %mover
                        %mo →
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℝ
                        %mi D
                    %annotation{:encoding => "application/x-tex"}
                      E
                      \\;\colon\;
                      T\widehat{X}
                      \\xrightarrow{\;\;}
                      \\mathbb{R}^D
              %p
                such that at each point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mi X
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat x \,\in\, \widehat{X}
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mrow
                          %mi a
                          %mi b
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mi E
                        %mi a
                      %mo ⊗
                      %msup
                        %mi E
                        %mi b
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mi g
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\delta_{a b} \, E^a \otimes E^b
                      \\;=\;
                      g
                      \\,.
          %p
            Now given moreover an
            %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma \hookrightarrow X
            into a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
          %ul
            %li
              %p
                such an orthonormal local frame
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is called
                %em adapted
                or
                %em Darboux
                (generalizing terminology originating in the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differential+geometry+of+curves+and+surfaces"} differential geometry of curves and surfaces
                = succeed "," do
                  %a{:href => "#Guggenheimer77"} Guggenheimer 1977, p. 210
                = succeed ")" do
                  %a{:href => "differential+geometry+of+curves+and+surfaces#PetruninBarrera20"} Petrunin &amp; Barrera 2020, p. 107
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                if for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma
                and each lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} )
                        %mo ^
                      %mo ∈
                      %mover
                        %mi X
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\phi(\sigma)} \in \widehat{X}
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi(\sigma) \in X
                its first
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} dim(\Sigma)
                components are tangent to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              #eq:DarbouxFrameProperty.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∀
                        %mrow
                          %mi a
                          %mo ≤
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi V
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi T
                        %mi σ
                      %mi Σ
                      %mo ⊂
                      %msub
                        %mi T
                        %mover
                          %mrow
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                          %mo ^
                      %mover
                        %mi X
                        %mo ^
                    %annotation{:encoding => "application/x-tex"}
                      \\underset
                      { a \leq dim(\Sigma) }
                      {\forall}
                      \\;\;\;\;\;
                      V_a(\sigma)
                      \\,\in\,
                      T_\sigma \Sigma
                      \\subset
                      T_{\widehat{\phi(\sigma)}} \widehat{X}
              %p
                (
                %a{:href => "#Sternberg64"}> Sternberg 1964, Def. 2.1 on p. 244
                ;
                = succeed ";" do
                  %a{:href => "#GriffithsHarris79"} Griffiths &amp; Harris 1979 (1.12)
                = succeed ";" do
                  %a{:href => "#BergerBryantGriffiths83"} Berger, Bryant &amp; Griffiths 1983, p. 818
                = succeed ")" do
                  %a{:href => "#Yang92"} Yang 1992, p. 157
            %li
              %p
                such an orthonormal local co-frame
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is called
                %em adapted
                or
                %em Darboux
                (generalizing again the terminology from
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/differential+geometry+of+curves+and+surfaces"} differential geometry of curves and surfaces
                = succeed ")" do
                  %a{:href => "#Cartan26"} Cartan 1926, p. 211
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                if its last
                = succeed "-components" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} dim(X)-dim(\Sigma)
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
              #eq:DarbouxCoFrameProperty.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ∀
                        %mrow
                          %mi a
                          %mo &gt;
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ϕ
                        %mo *
                      %msup
                        %mi E
                        %mi a
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\underset
                      { a \gt dim(\Sigma) }
                      {\forall}
                      \\;\;\;\;\;
                      \\phi^\ast E^a
                      \\;=\;
                      0
              %p
                (
                %a{:href => "#Sternberg64"}> Sternberg 1964, (2.11) on p. 246
                ;
                = succeed ";" do
                  %a{:href => "#Zandi88"} Zandi 1988, p. 426
                = succeed ";" do
                  %a{:href => "#MastroliaRigoliSetti12"} Mastrolia, Rigoli &amp; Setti 2012, Def. 1.17
                = succeed ";" do
                  %a{:href => "#Giron20"} Giron 2020, §3.2.2
                = succeed ")" do
                  %a{:href => "#ChenGiron21"} Chen &amp; Giron 2021, §2.4
          %p
          #DarbouxCoFramePullingBackToCoframeOnImmersedManifold.num_remark
            %h6 Remark
            %p
              The Darboux co-frame property
              %a.maruku-eqref{:href => "#eq:DarbouxCoFrameProperty"} (2)
              immediately implies that the pullback of the remaining frame components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi e
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ϕ
                      %mo *
                    %msup
                      %mi E
                      %mi a
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi a
                        %mo ≤
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    e
                    \\;\coloneqq\;
                    \\big(
                    e^a
                    \\;\coloneqq\;
                    \\phi^\ast E^a
                    \\big)_{
                    a \leq dim(\Sigma)
                    }
            %p
              constitute a local frame on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              gives
            #eq:DarbouxCoframePullsBackToCoframe.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %msup
                      %mi E
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ≤
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mtext for
                            %mspace{:width => "thickmathspace"}
                            %mi a
                            %mo ≥
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^\ast E^a
                    \\;=\;
                    \\left\{
                    \\begin{array}{ll}
                    e^a &amp; \text{for}\; a \leq dim(\Sigma)
                    \\\
                    0 &amp; \text{for}\; a \geq dim(\Sigma)
                    \\,.
                    \\end{array}
                    \\right.
            %p
              (cf.
              = succeed ")." do
                %a{:href => "#GriffithsHarris79"} Griffiths &amp; Harris 1979 (1.13)
            %p
              Incidentally, we may observe with
              %a{:href => "superembedding+formalism#GSS24"} GSS24, §2
              that this situation
              %a.maruku-eqref{:href => "#eq:DarbouxCoframePullsBackToCoframe"} (3)
              of Darboux co-frames, when lifted/applied to the bosonic coframe components of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/super+spacetimes"} super spacetimes
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/super-embedding+approach"} super-embedding approach
              %a.existingWikiWord{:href => "/nlab/show/super+p-branes"} super p-branes
              \&amp;lbrack;
              %a{:href => "super-embedding+approach#Sorokin00"}> Sorokin 2000 (4.36-37)
              ;
              = succeed ";" do
                %a{:href => "super-embedding+approach#Bandos11"} Bandos 2011 (2.6-2.9)
              = succeed "&rbrack;," do
                %a{:href => "super-embedding+approach#BandosSorokin23"} Bandos &amp; Sorokin 2023 (5.13-14)
              = succeed "," do
                %a{:href => "super-embedding+formalism#BPSTV95"} Bandos et al. 1995 (2.23)
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:DarbouxCoframePullsBackToCoframe"} (3)
          %p
          #ExistenceOfDarbouxFrames.num_prop
            %h6 Proposition
            %p Given an immersion into a Riemannian manifold, local Darboux (co-)frames always exist.
          .proof
            %h6 Proof
            %p
              Given an immersion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \iota \colon \Sigma \to X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma
              %em locally
              an
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
              (see
              = succeed ")," do
                %a{:href => "immersion+of+smooth+manifolds#ImmersionsAreLocalEmbeddings"} here
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi U
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \sigma \in U \subset \Sigma
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi_{\vert U} \colon U \to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+smooth+manifolds"} embedding
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
              = succeed ")" do
                %a{:href => "submanifold#ExistenceOfSiceCharts"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ′
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U' \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \iota(\sigma) \in X
              which serves as a
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⊃
                    %mi U
                    %mo ′
                    %mover
                      %mo →
                      %mi ϕ
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \supset U' \xrightarrow{\phi} \mathbb{R}^n
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and a slice chart for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma \subset X
              in that it exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo ∩
                    %mi U
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \Sigma \cap U'
              as a rectilinear
              %a.existingWikiWord{:href => "/nlab/show/hyperplane"} hyperplane
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi(U') \subset \mathbb{R}^n
            %p
              Hence in this slice
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              a local frame for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is given by the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              canonical coordinate
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of them forming a local frame field on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mo ∂
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mo ∂
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mo ↪
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mo ∂
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mo ∂
                      %mi k
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mo ∂
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mo ∂
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big\{ \partial_1, \cdots, \partial_{k} \big\}
                    \\hookrightarrow
                    \\big\{
                    \\partial_1, \cdots, \partial_{k},
                    \\,
                    \\partial_{k+1}, \cdots, \partial_n
                    \\big\}
                    \\,.
            %p
              From this local frame the
              %a.existingWikiWord{:href => "/nlab/show/Gram-Schmidt+process"} Gram-Schmidt process
              produces an
              %em orthonormal
              frame, first for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              and then extended to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mo ↪
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi k
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi v
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi v
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi a
                    %mo ,
                    %msub
                      %mi v
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi δ
                      %mrow
                        %mi a
                        %mi b
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\big\{ v_1, \cdots, v_{k} \big\}
                    \\hookrightarrow
                    \\big\{
                    v_1, \cdots, v_{k},
                    \\,
                    v_{k+1}, \cdots, v_n
                    \\big\}
                    \\,,
                    \\;\;\;
                    g(v_a, v_b) = \delta_{a b}
                    \\,
            %p
              This demonstrates the existence of orthonormal local frame fields (cf.
              = succeed ")." do
                %a{:href => "#Kayban21"} Kayban 2021, Prop. 3.1
            %p To obtain the desired orthonormal local co-frame field we just dualize this local frame field:
            %p
              By construction, the matrix
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi v
                      %mi a
                      %mi μ
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi a
                        %mo ,
                        %mi μ
                  %annotation{:encoding => "application/x-tex"} \big(v_a^\mu\big)_{a,\mu}
              of components of the above frame (given by
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi v
                        %mi a
                        %mi μ
                      %msub
                        %mo ∂
                        %mi μ
                      %mo =
                      %msub
                        %mi v
                        %mi a
                    %annotation{:encoding => "application/x-tex"} v_a^\mu \partial_\mu = v_a
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            %p
              This means (cf. e.g.
              = succeed ")" do
                %a{:href => "inverse+matrix#SD23"} here
              %a.existingWikiWord{:href => "/nlab/show/inverse+matrix"} inverse matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi e
                      %mi μ
                      %mi a
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi μ
                        %mo ,
                        %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mi v
                      %mi a
                      %mi μ
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi μ
                        %mo ,
                        %mi a
                    %msup
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\big(e^a_\mu\big)_{\mu,a}
                    \\,\coloneqq\,
                    \\Big(\big(v_a^\mu\big)_{\mu,a}\Big)^{-1}
            %p is block diagonal, with its upper diagonal block being the inverse matrix of the original upper left block.
            %p
              This gives the desired
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi e
                      %mi μ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %msup
                      %mi x
                      %mi μ
                  %annotation{:encoding => "application/x-tex"}
                    e^{a}
                    \\,\coloneqq\,
                    e^a_\mu \, \mathrm{d}x^\mu
            %p
              which is orthonormal on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi e
                      %mi a
                    %mo ⊗
                    %msub
                      %mi e
                      %mi a
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    e^a \otimes e_a
                    \\;=\;
                    g(-,-)
            %p because
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi v
                      %mi a
                      %mi μ
                    %msub
                      %mi g
                      %mrow
                        %mi μ
                        %mi ν
                    %msubsup
                      %mi v
                      %mi b
                      %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi δ
                      %mrow
                        %mi a
                        %mi b
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi g
                      %mrow
                        %mi μ
                        %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi e
                      %mi μ
                      %mi a
                    %msub
                      %mi δ
                      %mrow
                        %mi a
                        %mi b
                    %msubsup
                      %mi e
                      %mi ν
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_a^\mu g_{\mu \nu} v_b^\nu
                    \\;=\;
                    \\delta_{a b}
                    \\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;
                    g_{\mu \nu}
                    \\;=\;
                    e^a_\mu
                    \\delta_{a b}
                    e^b_\nu
                    \\,.
            %p
              and which is Darboux by the block-diagonal structure of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msubsup
                        %mi e
                        %mi μ
                        %mi a
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \big(e^a_\mu\big)
          %p
            (For the further generality of
            %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            of Darboux frames for suitable
            %a.existingWikiWord{:href => "/nlab/show/sequences"} sequences
            of immersions, see
            %a{:href => "#Giron20"} Giron 2020
            and
            = succeed ".)" do
              %a{:href => "#ChenGiron21"} Chen &amp; Giron 2021, Thm. 2.2
          %p
          .num_remark
            %h6 Remark
            %p
              In particular, an immersion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \iota \colon \Sigma \hookrightarrow X
              of Riemannian manifolds is isometric iff around each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota(\sigma)
              any of its Darboux coframe fields pull back to locally induce the given metric on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            %br/
          %h3#SecondFundamentalForm Second fundamental form
          %p
            The “second fundamental form” (on the terminology cf. Rem.
            %a.maruku-ref{:href => "#TerminologySecondFundamentalForm"}
            below) of a Riemannian immersion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mover
                    %mo →
                    %mphantom
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Sigma \xrightarrow{\phantom{-}} X
            measures the transversal change of
            %a.existingWikiWord{:href => "/nlab/show/tangent+vectors"} tangent vectors
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} transport
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            inside
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We first discuss the second fundamental form in terms of
            = succeed "," do
              %a{:href => "#AdaptedDarbouxCoframes"} local Darboux co-frame fields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivatives"} covariant derivatives
          %p
            %br/
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma \to X
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/immersion"} immersion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ≡
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi E
                    %mi a
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi a
                      %mo =
                      %mn 1
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E \equiv (E^a)_{a =1}^{dim(X)}
            (which exists by Prop.
            = succeed ")," do
              %a.maruku-ref{:href => "#ExistenceOfDarbouxFrames"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi ϕ
                          %mo *
                        %msup
                          %mi E
                          %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                      %mtd
                        %mtext for
                        %mspace{:width => "thickmathspace"}
                        %mi a
                        %mo ∈
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %mtr
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi e
                          %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi ϕ
                          %mo *
                        %msup
                          %mi E
                          %mi a
                        %msubsup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi a
                            %mo =
                            %mn 1
                          %mrow
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                      %mtd
                        %mtext is a co-frame on
                        %mspace{:width => "thickmathspace"}
                        %mi Σ
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  \\phi^\ast E^a \;=\; 0
                  \&amp;
                  \\text{for}
                  \\;
                  a \in \big\{dim(\Sigma)+1, \cdots, dim(X)\big\}
                  \\\
                  \\big(
                  e^a \;\coloneqq\; \phi^\ast E^a
                  \\big)_{a = 1}^{dim(\Sigma)}
                  \&amp;
                  \\text{is a co-frame on}\; \Sigma
                  \\end{array}
          %p
            For brevity we will say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} a \in \{1, \cdots, dim(X)\}
            is
          %ul
            %li
              %p
                %em tangential
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %annotation{:encoding => "application/x-tex"} a \in \big\{1, \cdots, dim(\Sigma)\big\}
            %li
              %p
                %em transversal
                if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %annotation{:encoding => "application/x-tex"} a \in \big\{dim(\Sigma)+1, \cdots, dim(X)\big\}
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            be the unique
            = succeed "-free" do
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+metric+connection"} torsion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          #eq:TorsionConstraintOnTarget.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi E
                    %mi a
                  %mo −
                  %msup
                    %mi Ω
                    %mi a
                  %msub
                    %mrow
                    %mi b
                  %msup
                    %mi E
                    %mi b
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{d} E^a
                  \-
                  \\Omega^a{}_b E^b
                  \\;=\;
                  0
                  \\,.
          %p
            and denote the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
            of its tangential and transversal components, respectively, by
          #eq:SecondFundamentalFormViaCoframeFields.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi ω
                          %mi a
                        %msub
                          %mrow
                          %mi b
                      %mtd
                        %mo ≔
                      %mtd
                        %msup
                          %mi ϕ
                          %mo *
                        %msup
                          %mi Ω
                          %mi a
                        %msub
                          %mrow
                          %mi b
                      %mtd
                        %mtext for tangential
                        %mspace{:width => "thickmathspace"}
                        %mtext and tangential
                        %mspace{:width => "thickmathspace"}
                        %mi b
                    %mtr
                      %mtd
                        %msubsup
                          %mi Ⅱ
                          %mrow
                            %msub
                              %mi b
                              %mn 1
                            %msub
                              %mi b
                              %mn 2
                          %mi a
                        %msup
                          %mi e
                          %mrow
                            %msub
                              %mi b
                              %mn 1
                      %mtd
                        %mo ≔
                      %mtd
                        %msup
                          %mi ϕ
                          %mo *
                        %msup
                          %mi Ω
                          %mi a
                        %msub
                          %mrow
                          %mrow
                            %msub
                              %mi b
                              %mn 2
                      %mtd
                        %mtext for transversal
                        %mspace{:width => "thickmathspace"}
                        %mi a
                        %mspace{:width => "thickmathspace"}
                        %mtext and tangential
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi b
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{cccl}
                  \\omega^a{}_b
                  \&amp;\coloneqq&amp;
                  \\phi^\ast \Omega^a{}_b
                  \&amp;
                  \\text{for tangential}\;\text{and tangential}\;b
                  \\\
                  {&amp;#8545;}^a_{b_1 b_2} e^{b_1}
                  \&amp;\coloneqq&amp;
                  \\phi^\ast \Omega^a{}_{b_2}
                  \&amp;
                  \\text{for transversal}\;a\;\text{and tangential}\;b_2
                  \\,.
                  \\end{array}
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
            of the torsion constraint
            %a.maruku-eqref{:href => "#eq:TorsionConstraintOnTarget"} (4)
            is equivalent to the following pair of conditions on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msup
                            %mi e
                            %mi a
                          %mo −
                          %msup
                            %mi ω
                            %mi a
                          %msub
                            %mrow
                            %mi b
                          %mspace{:width => "thinmathspace"}
                          %msup
                            %mi e
                            %mi b
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 0
                        %mtd
                          %mtext for tangential
                          %mspace{:width => "thickmathspace"}
                          %mi a
                      %mtr
                        %mtd
                          %msubsup
                            %mi Ⅱ
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                            %mi a
                          %msup
                            %mi e
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                          %msup
                            %mi e
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 0
                        %mtd
                          %mtext for transversal
                          %mspace{:width => "thickmathspace"}
                          %mi a
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\begin{array}{ll}
                  \\mathrm{d} e^a - \omega^a{}_b \, e^b \;=\; 0
                  \&amp;
                  \\text{for tangential}\;a
                  \\\
                  {&amp;#8545;}^a_{b_1 b_2} e^{b_1} e^{b_2} \;=\; 0
                  \&amp;
                  \\text{for transversal}\;a
                  \\end{array}
                  \\right.
          %p
            The first one just says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is the torsion-free connection with respect to the induced coframe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            The second one says that the skew symmetric part
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ⅱ
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi b
                        %mn 1
                      %msub
                        %mi b
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %mi a
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} {&amp;#8545;}^a_{[b_1 b_2]} = 0
            vanishes, hence that
          #eq:TheSecondFundamentalForm.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ⅱ
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %msub
                        %mi b
                        %mn 2
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Ⅱ
                    %mrow
                      %msub
                        %mi b
                        %mn 2
                      %msub
                        %mi b
                        %mn 1
                    %mi a
                %annotation{:encoding => "application/x-tex"}
                  {&amp;#8545;}^a_{b_1 b_2}
                  \\;=\;
                  {&amp;#8545;}^a_{b_2 b_1}
          %p
            is symmetric in its tangential indices
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi i
                  %annotation{:encoding => "application/x-tex"} b_i
            %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is called the
            %strong second fundamental form
            of the immersion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Willmore96"} Willmore 1996, p. 125-126
            = succeed ";" do
              %a{:href => "#BergerBryantGriffiths83"} Berger, Bryant &amp; Griffiths 1983, p. 819
            = succeed ";" do
              %a{:href => "#Chavel93"} Chavel 1993 (II.2.12)
            = succeed ")" do
              %a{:href => "#Wang24"} Wang 2024, Def. 2.2
          %p
          #TerminologySecondFundamentalForm.num_remark
            %h6 Remark
            %p
              %strong (terminology)
              Historically, by the “first fundamental form” authors used to refer to the pullback of the
              %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
              along an immersion. While this usage is no longer practiced, the term “second fundamental form” for
              %a.maruku-eqref{:href => "#eq:TheSecondFundamentalForm"} (6)
              has become standard.
          (cf.
          = succeed ";" do
            %a{:href => "#Chavel93"} Chavel 1993, Rem. II..1
          = succeed ")" do
            %a{:href => "Riemannian+geometry#Lee18"} Lee 2018, pp. 227
          %p#SecondFundamentalFormViaCovDerOfVectorFields
            In much of the literature the second fundamental form is alternatively expressed instead in terms of
            %a.existingWikiWord{:href => "/nlab/show/covariant+derivatives"} covariant derivatives
            of and along tangential
            %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            (e.g.:
            = succeed ";" do
              %a{:href => "#Chavel93"} Chavel 1993 §II.2
            = succeed ";" do
              %a{:href => "#BairdWood03"} Baird &amp; Wood 2003, §3.2
            = succeed ")," do
              %a{:href => "Riemannian+geometry#Lee18"} Lee 2018, pp. 225
          %blockquote
            %p
              (which is well-known but seems hard to cite explicitly, cf. maybe
              = succeed "):" do
                %a{:href => "#Willmore96"} Willmore 1996, p. 126
          %p
          #FromCoframeVersionOfScndFundFormToCoDevVersion.num_prop
            %h6 Proposition
            %p
              The second fundamental form obtained from a local Darboux coframe field as in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:SecondFundamentalFormViaCoframeFields"} (5)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              from the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              to the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              relative to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ⅱ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi T
                    %mi Σ
                    %mo ⊗
                    %mi T
                    %mi Σ
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mi ϕ
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    {&amp;#8545;} \;\colon\;
                    T\Sigma \otimes T \Sigma
                    \\xrightarrow{\;}
                    N_\phi X
                    \\,,
            %p
              is given by
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivatives"} covariant derivatives
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
              as follows:
            #eq:SecondFundamentalFormAsDifferenceOfCovariantDerivatives.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ⅱ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mo ∇
                      %mi v
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mo ∇
                      %mi v
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mi w
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {&amp;#8545;}(v,w)
                    \\;=\;
                    \\nabla^X_{v} \, \mathrm{d}\phi(w)
                    \\;-\;
                    \\mathrm{d}\phi\big( \nabla^\Sigma_v \, w \big)
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mrow
                        %mi dim
                        %mi X
                  %annotation{:encoding => "application/x-tex"} (v_a)_{a = 1}^{dim X}
              be a local Darboux
              %em frame
              %a.maruku-eqref{:href => "#eq:DarbouxFrameProperty"} (1)
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mrow
                        %mi dim
                        %mi Σ
                  %annotation{:encoding => "application/x-tex"} (v_a)_{a =1}^{dim \Sigma}
              is a local frame on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (called the
              %em tangential
              frame vectors, the others being the
              %em transversal
              ones).
            %p It follows that pushforward of vector field in this Darboux basis is just the canonical injection
            #eq:PushforwardOfDarbouxFrame.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "right center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi{:mathvariant => "normal"} d
                          %msub
                            %mi ϕ
                            %mi σ
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi T
                            %mi σ
                          %mi Σ
                        %mtd
                          %mover
                            %mo →
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                        %mtd
                          %msub
                            %mi T
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi σ
                              %mo{:stretchy => "false"} )
                          %mi X
                      %mtr
                        %mtd
                          %msub
                            %mi v
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %msub
                            %mi v
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi σ
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{rcc}
                    \\mathrm{d}\phi_\sigma
                    \\;\colon\;
                    T_\sigma \Sigma
                    \&amp;\xrightarrow{\phantom{--}}&amp;
                    T_{\phi(\sigma)} X
                    \\\
                    v_a(\sigma) &amp;\mapsto&amp; v_a(\sigma)
                    \\end{array}
            %p
              (shown for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma
              inside the given chart).
            %p
              Remembering that for tangential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} b_1, b_2
              we set
            #eq:PullbackOfConnection.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %msub
                      %mi Ω
                      %mrow
                        %msub
                          %mi b
                          %mn 1
                    %msup
                      %mrow
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %msub
                          %mi b
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msub
                              %mi ω
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                            %msup
                              %mrow
                              %mi a
                            %msub
                              %mrow
                              %mrow
                                %msub
                                  %mi b
                                  %mn 2
                          %mtd
                            %mtext tangential
                            %mspace{:width => "thickmathspace"}
                            %mi a
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ⅱ
                              %mrow
                                %msub
                                  %mi b
                                  %mn 1
                                %msub
                                  %mi b
                                  %mn 2
                              %mi a
                          %mtd
                            %mtext transversal
                            %mspace{:width => "thickmathspace"}
                            %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^\ast \Omega_{b_1}{}^a{}_{b_2}
                    \\;\equiv\;
                    \\left\{
                    \\begin{array}{ll}
                    \\omega_{b_1}{}^a{}_{b_2} &amp; \text{tangential}\; a
                    \\\
                    {&amp;#8545;}^a_{b_1 b_2} &amp; \text{transversal}\; a
                    \\end{array}
                    \\right.
            %p this makes it immediate that
            #eq:ComputingScndFundFormViaCovDerivatives.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                            %mi X
                          %mi{:mathvariant => "normal"} d
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi v
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi{:mathvariant => "normal"} d
                          %mi ϕ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                            %mi Σ
                          %msub
                            %mi v
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                            %mi X
                          %msub
                            %mi v
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %mo −
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                            %mi Σ
                          %msub
                            %mi v
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi ϕ
                            %mo *
                          %msub
                            %mi Ω
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                          %msup
                            %mrow
                            %mi a
                          %msub
                            %mrow
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %msub
                            %mi v
                            %mi a
                          %mo −
                          %msub
                            %mi ω
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                          %msup
                            %mrow
                            %mi a
                          %msub
                            %mrow
                            %mrow
                              %msub
                                %mi b
                                %mn 2
                          %msub
                            %mi v
                            %mi a
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mtext II
                            %mrow
                              %msub
                                %mi b
                                %mn 1
                              %msub
                                %mi b
                                %mn 2
                            %mi a
                          %msub
                            %mi v
                            %mi a
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    \\nabla^X_{b_1} \mathrm{d}\phi(v_{b_2})
                    \-
                    \\mathrm{d}\phi\big( \nabla^\Sigma_{b_1} v_{b_2} \big)
                    \\\
                    \\;=\;
                    \\nabla^X_{b_1} v_{b_2}
                    \-
                    \\nabla^\Sigma_{b_1} v_{b_2}
                    \\\
                    \\;=\;
                    \\phi^\ast \Omega_{b_1}{}^{a}{}_{b_2} v_a
                    \-
                    \\omega_{b_1}{}^a{}_{b_2} v_a
                    \\\
                    \\;=\;
                    \\text{II}^a_{b_1 b_2} v_a
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              In words, the computation
              %a.maruku-eqref{:href => "#eq:ComputingScndFundFormViaCovDerivatives"} (10)
              shows that the covariant derivative on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of and along tangent vectors to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              plus the contribution of the second fundamental form, hence their difference extracts the latter.
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (further alternative expressions)
              %br/
              As the proof
              %a.maruku-eqref{:href => "#eq:ComputingScndFundFormViaCovDerivatives"} (10)
              of Prop.
              %a.maruku-ref{:href => "#FromCoframeVersionOfScndFundFormToCoDevVersion"}
              shows, the second fundamental form extracts the normal component of the ambient covariant derivative of and along tangential vectors:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext II
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∇
                      %mi v
                      %mi X
                    %mi w
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊥
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\text{II}(v,w)
                    \\;=\;
                    (\nabla^X_v w)^\perp
                    \\,.
            %p
              In this form it appears for instance in
              = succeed "," do
                %a{:href => "#KobayashiNomizu63"} Kobayashi &amp; Nomizu 1963 §VII.3
              = succeed ";" do
                %a{:href => "#Chavel93"} Chavel 1993 (II.2.2)
              %a.maruku-eqref{:href => "#eq:SecondFundamentalFormAsDifferenceOfCovariantDerivatives"} (7)
              is made explicit by
              = succeed "," do
                %a{:href => "#BairdWood03"} Baird &amp; Wood 2003 Def. 3.2.3
              = succeed "." do
                %a{:href => "#Willmore96"} Willmore 1996, p. 126
            %p
              Alternatively, the
              %a.existingWikiWord{:href => "/nlab/show/pushforward+of+vector+fields"} pushforward of vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}\phi
              may be understood as a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi T
                    %msup
                      %mi Σ
                      %mo *
                    %mo ⊗
                    %msup
                      %mi ϕ
                      %mo *
                    %mi T
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{d}\phi
                    \\;\in\;
                    \\Gamma\big(
                    T\Sigma^\ast \otimes \phi^\ast T X
                    \\big)
                    \\,,
            %p
              whence the expression
              %a.maruku-eqref{:href => "#eq:SecondFundamentalFormAsDifferenceOfCovariantDerivatives"} (7)
              may be understood as the induced
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
              on that tensor bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mo ∇
                      %mi v
                      %mi X
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
                      %mo ∇
                      %mi v
                      %mi Σ
                    %mi w
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\nabla \mathrm{d}\phi)(v,w)
                    \\;\coloneqq\;
                    \\nabla^X_{v} \mathrm{d}\phi(w)
                    \\;-\;
                    \\mathrm{d}\phi\big( \nabla^\Sigma_v w \big)
                    \\,.
            %p In this sense the second fundamental form is simply expressed as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ⅱ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo ∇
                    %mi{:mathvariant => "normal"} d
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {&amp;#8545;}
                    \\;=\;
                    \\nabla \mathrm{d}\phi
                    \\,.
            %p
              This is how it appears in
              = succeed "," do
                %a{:href => "#EellsSampson64"} Eells &amp; Sampson 1964 p. 123
              = succeed "." do
                %a{:href => "#BairdWood03"} Baird &amp; Wood 2003 (3.2.1)
            %p
              Finally, one may write out the covariant derivatives in a
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              in terms of the
              %a.existingWikiWord{:href => "/nlab/show/Christoffel+symbols"} Christoffel symbols
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi l
                    %msup
                      %mrow
                      %mi m
                    %msub
                      %mrow
                      %mi n
                  %annotation{:encoding => "application/x-tex"} L_{l}{}^m{}_n
              for the
              %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi i
                    %msup
                      %mrow
                      %mi l
                    %msub
                      %mrow
                      %mi j
                  %annotation{:encoding => "application/x-tex"} \Gamma_i{}^l{}_j
              of the pullback connection to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            #eq:SecondFundamentalFormInCoordinates.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi Ⅱ
                            %mrow
                              %mi i
                              %mi j
                            %mi k
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mo ∂
                                %mi i
                            %mi X
                          %mi{:mathvariant => "normal"} d
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mi j
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo −
                          %mi{:mathvariant => "normal"} d
                          %mi ϕ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msubsup
                            %mo ∇
                            %mrow
                              %msub
                                %mo ∂
                                %mi i
                            %mi Σ
                          %msub
                            %mo ∂
                            %mi j
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mrow
                              %msub
                                %mo ∂
                                %mi i
                              %msub
                                %mo ∂
                                %mi j
                              %msup
                                %mi ϕ
                                %mi l
                              %mo +
                              %msub
                                %mi L
                                %mi m
                              %msup
                                %mrow
                                %mi l
                              %msub
                                %mrow
                                %mi n
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi i
                              %msup
                                %mi ϕ
                                %mi m
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi j
                              %msup
                                %mi ϕ
                                %mi n
                              %mo{:stretchy => "false"} )
                            %mo ⏞
                          %mo −
                          %mover
                            %mrow
                              %msub
                                %mi Γ
                                %mi i
                              %msup
                                %mrow
                                %mi k
                              %msub
                                %mrow
                                %mi j
                              %msub
                                %mo ∂
                                %mi k
                              %msup
                                %mi ϕ
                                %mi l
                            %mo ⏞
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mo ∂
                            %mi i
                          %msub
                            %mo ∂
                            %mi j
                          %msup
                            %mi ϕ
                            %mi l
                          %mo −
                          %msub
                            %mi Γ
                            %mi i
                          %msup
                            %mrow
                            %mi k
                          %msub
                            %mrow
                            %mi j
                          %msub
                            %mo ∂
                            %mi k
                          %msup
                            %mi ϕ
                            %mi l
                          %mo +
                          %msub
                            %mi L
                            %mi m
                          %msup
                            %mrow
                            %mi l
                          %msub
                            %mrow
                            %mi n
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mi i
                          %msup
                            %mi ϕ
                            %mi m
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mo ∂
                            %mi j
                          %msup
                            %mi ϕ
                            %mi n
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{l}
                    {&amp;#8545;}^k_{i j}
                    \\\
                    \\;=\;
                    \\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;\;
                    \\nabla^X_{\partial_i}
                    \\mathrm{d}\phi(
                    \\partial_j
                    )
                    \\;\;\;\;\;\;\;\;\;\;\;\;
                    \-
                    \\mathrm{d}\phi\big(
                    \\nabla^\Sigma_{\partial_i} \partial_j
                    \\big)
                    \\\
                    \\;=\;
                    \\overbrace{
                    \\partial_i
                    \\partial_j \phi^l
                    +
                    L_{m}{}^l{}_n
                    (\partial_i \phi^m) (\partial_j \phi^n)
                    }
                    \-
                    \\overbrace{
                    \\Gamma_{i}{}^k{}_j \partial_k \phi^l
                    }
                    \\\
                    \\;=\;
                    \\partial_i
                    \\partial_j \phi^l
                    \-
                    \\Gamma_{i}{}^k{}_j \partial_k \phi^l
                    +
                    L_{m}{}^l{}_n
                    (\partial_i \phi^m) (\partial_j \phi^n)
                    \\,.
                    \\end{array}
            %p
              In this guise the second fundamental form was originally given in
              %a{:href => "#EellsSampson64"} Eells &amp; Sampson 1964 (p. 118 &amp; 123 with p. 111)
              following
              = succeed "," do
                %a{:href => "#Eisenhart25"} Eisenhart 1925, §43
              = succeed "." do
                %a{:href => "#BairdWood03"} Baird &amp; Wood 2003 (3.2.2)
          %p
          #TotallyGeodesicImmersion.num_remark
            %h6 Remark
            %p
              %strong (totally geodesic immersions)
              %br/
              If the fundamental form Ⅱ of a Riemannian immersion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ,
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi \colon, \Sigma \to X
              vanishes, then
              %a.existingWikiWord{:href => "/nlab/show/geodesics"} geodesics
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              are taken by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              to geodesics in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is said to be
              %em totally geodesic
              \&amp;lbrack;
              %a{:href => "#EellsSampson64"}> Eells &amp; Sampson 1964 p. 126
              ,
              = succeed "&rbrack;." do
                %a{:href => "#BairdWood03"} Baird &amp; Wood 2003 Def. 3.2.1
          %p
            %br/
          %h3#TensionField Tension field
          %p
          #TheTensionField.num_defn
            %h6 Definition
            %p
              The
              %em tension field
              of the immersion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is the contraction (trace) of the
              = succeed ":" do
                %a{:href => "#SecondFundamentalForm"} second fundamental form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi τ
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi η
                      %mrow
