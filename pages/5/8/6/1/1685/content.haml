                      %p
                        %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#Statement"} Statement
              %ul
                %li
                  %a{:href => "#theorem_"} Theorem (
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Tohoku"} Tohoku
                %li
                  %a{:href => "#theorem__2"} Theorem (
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Tohoku"} Tohoku
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %em Grothendieck spectral sequence
            is a
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            that computes the
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            of two
            %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"} derived functors
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories+of+chain+complexes"} categories of chain complexes
          %h2#Statement Statement
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{A},\mathcal{B},\mathcal{C}
            be
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian categories
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒜
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} F \colon \mathcal{A}\to \mathcal{B}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mi ℬ
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} G \colon \mathcal{B}\to \mathcal{C}
            be
            %a.existingWikiWord{:href => "/nlab/show/exact+functor"} left exact
            %a.existingWikiWord{:href => "/nlab/show/additive+functor"} additive
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ,
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{A}, \mathcal{B}
            have
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} enough injectives
          .num_theorem
            %h6#theorem_
              Theorem (
              %a.existingWikiWord{:href => "/nlab/show/Tohoku"}> Tohoku
              )
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi F
                    %mo ⊂
                    %mi{:mathvariant => "normal"} Ob
                    %mi A
                  %annotation{:encoding => "application/x-tex"} R_F\subset \mathrm{Ob} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi G
                    %mo ⊂
                    %mi{:mathvariant => "normal"} Ob
                    %mi B
                  %annotation{:encoding => "application/x-tex"} R_G\subset\mathrm{Ob} B
              for the
              %a.existingWikiWord{:href => "/nlab/show/class+of+adapted+objects"} classes of objects adapted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              respectively, and let furthermore
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi R
                        %mi B
                    %annotation{:encoding => "application/x-tex"} F(R_A)\subset R_B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi F
                      %mo :
                      %msup
                        %mi D
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi D
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R F:D^+(A)\to D^+(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi G
                    %mo :
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R G:D^+(B)\to D^+(C)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi D
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(G\circ  F):D^+(A)\to D^+(C)
              are defined and the natural morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                    %mi G
                    %mo ∘
                    %mi R
                    %mi F
                  %annotation{:encoding => "application/x-tex"} R(G\circ F)\to R G\circ R F
              is an isomorphism.
          .num_theorem
            %h6#theorem__2
              Theorem (
              %a.existingWikiWord{:href => "/nlab/show/Tohoku"}> Tohoku
              )
            %p
              In the above situation, assume that for every
              %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} I \in \mathcal{A}
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} F(I) \in \mathcal{B}
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic object
            %p
              Then for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}(A)\}_{r,p,q}
              called the
              %strong Grothendieck spectral sequence
              whose
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi R
                      %mi p
                    %mi G
                    %mo ∘
                    %msup
                      %mi R
                      %mi q
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^{p,q}_2(A) = R^p G \circ R^q F (A)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"} right derived functors
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R^n(G\circ F)
              of the composite of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi R
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{p,q}_\infty(A) \simeq R^{p+q}(G \circ F)(A)
                    \\,.
            %p
              Moreover, this is
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A \in \mathcal{A}
          .proof
            %h6#proof Proof
            %p
              By assumption of enough injectives, we may find an
              %em
                %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %msup
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    A \stackrel{\simeq_{qi}}{\to} C^\bullet
            %p
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %em
                %a{:href => "projective+resolution#ExistenceAndConstructionOfResolutionsOfComplexes"} injective resolution – Existence and construction
              we may find a
              %em fully injective
              resolution of the chain complex
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(C^\bullet)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi I
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0 \to F(C^\bullet) \to I^{\bullet, \bullet}
                    \\,,
            %p
              where hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} I^{\bullet, \bullet}
              is a
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              of
              %a.existingWikiWord{:href => "/nlab/show/injective+objects"} injective objects
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi I
                      %mrow
                        %mi n
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} 0 \to F(C^n) \to I^{n,\bullet}
              is an ordinary injective resolution of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} F(C^n) \in \mathcal{B}
            %p
              Thus we have the corresponding double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(I^{\bullet,\bullet})
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+double+complex"} spectral sequence of a double complex
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi I
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(I^{\bullet, \bullet})
              equipped with the vertical-degree
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtration
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mrow
                        %mi vert
                      %msubsup
                        %mi E
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                        %mi r
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{{}^{vert}E^r_{p,q}(A)\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi vert
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi R
                      %mi p
                    %mi G
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mi q
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {}^{vert} E^2_{p,q}(A) \simeq R^p G (R^q F(A))
                    \\,.
            %p
              To see this, notice that by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} I^{\bullet,\bullet}
              is a
              %em fully
              injective projective resolution, the short exact sequences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi B
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Z
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0 \to B^{q,p}(I) \to Z^{q,p}(I) \to H^{q,p}(I) \to 0
            %p
              are
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              (by the discussion there) and hence so is their image under any functor and hence in particular under
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi vert
                            %msubsup
                              %mi E
                              %mn 1
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mi p
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Z
                              %mrow
                                %mi q
                                %mo ,
                                %mi p
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi B
                              %mrow
                                %mi q
                                %mo ,
                                %mi p
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi G
                            %msup
                              %mi H
                              %mrow
                                %mi q
                                %mo ,
                                %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^{vert}E^{p,q}_1
                    \&amp; \simeq
                    H^q(G(I^{\bullet,p}))
                    \\\
                    \&amp; \simeq (G(Z^{q,p})) / (G(B^{q,p}))
                    \\\
                    \&amp; \simeq G H^{q,p}
                    \\end{aligned}
            %p (the first two equivalences by general properties of the filtration spectral sequence, the last by the above splitness). Hence it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi vert
                            %msubsup
                              %mi E
                              %mn 2
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mi p
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi H
                              %mrow
                                %mi q
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi R
                              %mi p
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi R
                              %mi q
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^{vert}E^{p,q}_2
                    \&amp; \simeq
                    H^p(G(H^{q,\bullet}))
                    \\\
                    \&amp; \simeq
                    R^p G (R^q F (A))
                    \\end{aligned}
                    \\,,
            %p
              where in the last step we used that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi q
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} H^{q,\bullet}
              is be construction an injective resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi R
                      %mi q
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^q(F(C^\bullet)) \simeq R^q F(A)
              (using the
              = succeed "-acyclicity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(C^\bullet)
            %p This establishes the spectral sequence and its second page as claimed. It remains to determine its convergence.
            %p
              To that end, consider dually, the spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mrow
                      %mi hor
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{{}^{hor}E^{p,q}_r\}
              coming from the horizontal filtration on the double complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi I
                        %mrow
                          %mo •
                          %mo ,
                          %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G(I^{\bullet, \bullet})
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+double+complex"} spectral sequence of a double complex
              this converges to the same value as the previous one. But for this latter spectral sequence we find
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi hor
                            %msubsup
                              %mi E
                              %mn 1
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mi q
                            %mo{:stretchy => "false"} (
                            %mi G
                            %msup
                              %mi I
                              %mrow
                                %mi p
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi R
                              %mi q
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi C
                              %mi p
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    {}^{hor}E^{p,q}_1 &amp; \simeq H^q(G I^{p,\bullet})
                    \\\
                    \&amp; \simeq R^q G(F(C^p))
                    \\end{aligned}
                    \\,,
            %p
              the first equivalence by the general properties of filtration spectral sequences, the second then by the definition of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derived+functor+in+homological+algebra"} right derived functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(C^p)
              is
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/acyclic+object"} acyclic
              and hence all these derived functors vanish in positive degree, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi hor
                    %msubsup
                      %mi E
                      %mn 1
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi F
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi C
                                %mi p
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi q
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {}^{hor}E^{p,q}_1 \simeq
                    \\left\{
                    \\array{
                    G(F(C^p)) &amp; if\; q = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Next, the
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G(F(C^\bullet))
              and this is by definition now the derived functor of the composite of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mi hor
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi R
                                %mi p
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo ∘
                              %mi F
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi q
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {}^{hor}E^{p,q}_2 \simeq
                    \\left\{
                    \\array{
                    R^p(G \circ F) &amp; if \; q  = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Since this is concentrated in the
              = succeed "-row" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (q = 0)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msup
                              %mi G
                              %mi n
                            %msup
                              %mi H
                              %mrow
                                %mi n
                                %mo +
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi E
                              %mn ∞
                              %mrow
                                %mi n
                                %mo ,
                                %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^n(Tot(G(I^{\bullet,\bullet})))
                    \&amp;\simeq
                    G^n H^{n+0}(Tot(G(I^{\bullet,\bullet})))
                    \\\
                    \&amp; \simeq
                    E^{n,0}_\infty
                    \\end{aligned}
            %p So in conclusion we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi R
                              %mi p
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi R
                              %mi q
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msup
                              %mrow
                              %mi vert
                            %msubsup
                              %mi E
                              %mn 2
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                        %mtr
                          %mtd
                          %mtd
                            %mo ⇒
                            %msup
                              %mrow
                              %mi vert
                            %msubsup
                              %mi E
                              %mn ∞
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi G
                              %mi vert
                              %mi p
                            %msup
                              %mi H
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi G
                              %mi hor
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %msup
                              %mi H
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %mi Tot
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi I
                              %mrow
                                %mo •
                                %mo ,
                                %mo •
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mrow
                              %mi hor
                            %msubsup
                              %mi E
                              %mn ∞
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi R
                              %mrow
                                %mi p
                                %mo +
                                %mi q
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo ∘
                            %mi F
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    R^p G(R^q F(A))
                    \&amp; \simeq
                    {}^{vert}E^{p,q}_2
                    \\\
                    \&amp; \Rightarrow
                    {}^{vert} E^{p,q}_\infty
                    \\\
                    \&amp; \simeq
                    G^p_{vert} H^{p+q}(Tot(G(I^{\bullet, \bullet})))
                    \\\
                    \&amp; \simeq
                    H^{p+q}(Tot(G(I^{\bullet, \bullet})))
                    \\\
                    \&amp; \simeq
                    G^{p+q}_{hor} H^{p+q}(Tot(G(I^{\bullet, \bullet})))
                    \\\
                    \&amp; \simeq
                    {}^{hor} E^{p+q,0}_\infty(A)
                    \\\
                    \&amp; \simeq
                    R^{p+q}(G \circ F)(A)
                    \\end{aligned}
          %h2#examples Examples
          %p Many other classes of spectral sequences are special cases of the Grothendieck spectral sequence, for instance the
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hochschild-Serre+spectral+sequence"} Hochschild-Serre spectral sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Leray+spectral+sequence"} Leray spectral sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/base+change+spectral+sequence"} base change spectral sequence
          %h2#references References
          %p Leture notes include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Milne"}> James Milne
                , section 10 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lectures+on+%C3%89tale+Cohomology"} Lectures on Étale Cohomology
            %li
              %p
                Jinhyun Park,
                %em Personal notes on Grothendieck spectral sequence
                (
                %a{:href => "http://mathsci.kaist.ac.kr/~jinhyun/note/g_s_sequence/sequence.pdf"}> pdf
                )
