                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/lax+%28%E2%88%9E%2C1%29-colimit"} lax (∞,1)-colimit
            %li
