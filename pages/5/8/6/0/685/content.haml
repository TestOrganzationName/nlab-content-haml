          %h2#references References
          %ul
            %li#Street74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                %em Elementary cosmoi I
                (§6) in
                = succeed "," do
                  %em Category Seminar
                = succeed "," do
                  %strong 420
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/BFb0063103"} doi:10.1007/BFb0063103
            %li#StreetLimitsIndexed
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                %em Limits indexed by category-valued 2-functors
                Journal of Pure and Applied Algebra
                = succeed "," do
                  %strong 8
                %a{:href => "https://doi.org/10.1016/0022-4049(76%2990013-X"} 10.1016/0022-4049(76)90013-X
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
                ,
                = succeed "," do
                  %em Elementary observations on 2-categorical limits
                %a{:href => "https://doi.org/10.1017/S0004972700002781"} 10.1017/S0004972700002781
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                = succeed "," do
                  %em Fibrations in Bicategories
                %strong 21
                (1980) no. 2, pp 111-160.
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1980__21_2_111_0"} Numdam
                and correction, Cahiers de Topologie et Géométrie Différentielle Catégoriques, Volume
                %strong 28
                (1987) no. 1, pp 53-56
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1987__28_1_53_0"} Numdam
          %p Section 6, page 37 in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steve+Lack"}> Steve Lack
                ,
                = succeed "." do
                  %em A 2-categories companion
                %strong 152
                2010 Springer, New York, NY. doi:
                %a{:href => "https://doi.org/10.1007/978-1-4419-1524-5_4"}> 10.1007/978-1-4419-1524-5_4
                , arXiv:
                %a{:href => "http://arxiv.org/abs/math.CT/0702535"}> math.CT/0702535
                \.
            %li
              %p
                G. J. Bird,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Power"} John Power
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em Flexible limits for 2-categories
                %strong 61
                Issue 1 (1989) pp 1-27. doi:
                %a{:href => "http://dx.doi.org/10.1016/0022-4049(89%2990065-0"} 10.1016/0022-4049(89)90065-0
                Chapters 3,4,5 in
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Fiore"}> Thomas Fiore
                ,
                = succeed "," do
                  %em Pseudo Limits, Biadjoints, and Pseudo Algebras: Categorical Foundations of Conformal Field Theory
                %strong 182
                (2006), no. 860 (
                %a{:href => "http://arxiv.org/abs/math/0408298"}> arXiv:math/0408298
                ) (
                %a{:href => "http://bookstore.ams.org/memo-182-860"}> AMS page
                ,
                = succeed ")" do
                  %a{:href => "https://books.google.com.au/books?id=y_DUCQAAQBAJ"} Google Books
          %p
            Another example of a 2-limit is the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+of+monoids"} category of monoids
          %ul
            %li
              Łukasz Sienkiewicz and
              = succeed "," do
                %span.newWikiWord
                  Marek Zawadowski
                  %a{:href => "/nlab/new/Marek+Zawadowski"} ?
