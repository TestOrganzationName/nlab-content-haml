                    %mo ′
                    %mo ,
                    %mi f
                    %mo :
                    %mi F
                    %mi c
                    %mo →
                    %mi F
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c', f:F c\to F c')
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fc
                    %mo{:stretchy => "false"} /
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Fc/F
              are connected. A zig-zag path between them, by precomposition with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
