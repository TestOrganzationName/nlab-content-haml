          %h2#idea Idea
          %p
            Every functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F:C\to D
            factors as a
            %a.existingWikiWord{:href => "/nlab/show/final+functor"} final functor
            followed by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+fibration"} discrete fibration
          %h2#Statement Statement
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be the class of
              %a.existingWikiWord{:href => "/nlab/show/final+functors"} final functors
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be the class of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+fibrations"} discrete fibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              = succeed "." do
                %strong comprehensive factorization system
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F:C\to D
              be a functor. Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo :
                    %mi D
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} K:D\to Set
              as the left Kan extension of the constant presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
