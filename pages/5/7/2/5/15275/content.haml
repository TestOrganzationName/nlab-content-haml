            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/membrane+instanton"} membrane instanton
          %h2#references References
          %h3#general General
          %p Original articles include
          %ul
            %li#Kashaev95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rinat+Kashaev"}> Rinat Kashaev
                ,
                = succeed "," do
                  %em A Link Invariant from Quantum Dilogarithm
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/q-alg/9504020"} arXiv:q-alg/9504020
            %li#Kashaev95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rinat+Kashaev"}> Rinat Kashaev
                ,
                %em The Hyperbolic Volume Of Knots From The Quantum Dilogarithm
                Lett. Math. Phys. 39 (1997) 269-275 (
                %a{:href => "https://arxiv.org/abs/q-alg/9601025"}> arXiv:q-alg/9601025
                )
            %li#KashaevTirkkonen99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rinat+Kashaev"}> Rinat Kashaev
                , O. Tirkkonen,
                = succeed "," do
                  %em Proof of the volume conjecture for torus knots
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/9912210"} arXiv:math/9912210
            %li#MurakamiMurakami01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Murakami"}> Hitoshi Murakami
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jun+Murakami"} Jun Murakami
                = succeed "," do
                  %em The Colored Jones Polynomial And The Simplicial Volume Of A Knot
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.acta/1485891370"} euclid.acta/1485891370
            %li#MMOTY02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Murakami"}> Hitoshi Murakami
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jun+Murakami"} Jun Murakami
                = succeed "," do
                  %em Kashaev’s Conjecture And The Chern-Simons Invariants Of Knots And Links
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0203119"} arXiv:math/0203119
            %li#Murakami04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Murakami"}> Hitoshi Murakami
                ,
                = succeed "," do
                  %em Asymptotic Behaviors Of The Colored Jones Polynomials Of A Torus Knot
          %p
            Generalization to
            %a.existingWikiWord{:href => "/nlab/show/Reshetikhin-Turaev+construction"} Reshetikhin-Turaev construction
            on closed manifold, to the
            %a.existingWikiWord{:href => "/nlab/show/Turaev-Viro+construction"} Turaev-Viro construction
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/manifolds+with+boundary"} manifolds with boundary
            %a.existingWikiWord{:href => "/nlab/show/roots+of+unity"} roots of unity
            than considered before is in
          %ul
            %li#ChenYang15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Qingtao+Chen"}> Qingtao Chen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tian+Yang"} Tian Yang
                %em A volume conjecture for a family of Turaev-Viro type invariants of 3-manifolds with boundary
                (
                %a{:href => "http://arxiv.org/abs/1503.02547"}> arXiv:1503.02547
                )
            %li
              %p
                Dongmin Gang, Mauricio Romo, Masahito Yamazaki,
                = succeed "," do
                  %em All-Order Volume Conjecture for Closed 3-Manifolds from Complex Chern-Simons Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1704.00918"} arXiv:1704.00918
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-018-3115-y"} doi:10.1007/s00220-018-3115-y
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"} SU(n)
          %ul
            %li#ChenLiuZhu15
              %a.existingWikiWord{:href => "/nlab/show/Qingtao+Chen"}> Qingtao Chen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kefeng+Liu"} Kefeng Liu
              %em
                Volume conjecture for
                = succeed "-invariants" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(n)
              (
              %a{:href => "https://arxiv.org/abs/1511.00658"}> arXiv:1511.00658
              )
          %p Review includes
          %ul
            %li#Murakami11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hitoshi+Murakami"}> Hitoshi Murakami
                ,
                %em An Introduction to the Volume Conjecture
                (
                %a{:href => "https://arxiv.org/abs/1002.0126"}> arXiv:1002.0126
                ) In:
                = succeed "," do
                  %em Interactions Between Hyperbolic Geometry, Quantum Topology and Number Theory
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1090/conm/541"} doi:10.1090/conm/541
            %li#Witten14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
                , pp. 4 of
                %em Two Lectures On The Jones Polynomial And Khovanov Homology
                (
                %a{:href => "http://arxiv.org/abs/1401.6996"}> arXiv:1401.6996
                )
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Volume_conjecture"} Volume conjecture
          %p See also
          %ul
            %li#Neumann03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Walter+Neumann"}> Walter Neumann
                ,
                = succeed "," do
                  %em Extended Bloch group and the Cheeger-Chern-Simons class
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0307092"} arXiv:math/0307092
            %li#Zickert07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christian+Zickert"}> Christian Zickert
                ,
                = succeed "," do
                  %em The volume and Chern-Simons invariant of a representation
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0710.2049"} arXiv:0710.2049
            %li#Neumann11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Walter+Neumann"}> Walter Neumann
                ,
                = succeed "," do
                  %em Realizing arithmetic invariants of hyperbolic 3-manifolds
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1108.0062"} arXiv:1108.0062
            %li#GaroufalidisThurstonZickert11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stavros+Garoufalidis"}> Stavros Garoufalidis
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+Thurston"} Dylan Thurston
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christian+Zickert"} Christian Zickert
                %em
                  The complex volume of
                  = succeed "-representations" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo ,
                          %mi ℂ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SL(n,\mathbb{C})
                (
                %a{:href => "http://arxiv.org/abs/1111.2828"}> arXiv:1111.2828
                ,
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.dmj/1259332507"} Euclid
          %h3#via_string_theory Via string theory
          %h4#general_2 General
          %p
            Speculative discussion in terms of
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            or
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            includes
          %ul
            %li#Gukov03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"}> Sergei Gukov
                ,
                = succeed "," do
                  %em Three-Dimensional Quantum Gravity, Chern-Simons Theory, And The A-Polynomial
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0306165"} arXiv:hep-th/0306165
            %li#DijkgraafFuji09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"}> Robbert Dijkgraaf
                , Hiroyuki Fuji,
                %em The Volume Conjecture and Topological Strings
                (
                %a{:href => "http://arxiv.org/abs/0903.2084"}> arXiv:0903.2084
                )
            %li#DimofteGukov10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tudor+Dimofte"}> Tudor Dimofte
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sergei+Gukov"} Sergei Gukov
                = succeed "," do
                  %em Quantum Field Theory and the Volume Conjecture
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1003.4808"} arxiv:1003.4808
            %li#Dimofte16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tudor+Dimofte"}> Tudor Dimofte
                , Section 4.1 of:
                = succeed "," do
                  %em Perturbative and nonperturbative aspects of complex Chern-Simons Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1608.02961"} arXiv:1608.02961
          %p
            A conceptual explanation of the volume conjecture via
            %a.existingWikiWord{:href => "/nlab/show/analytically+continued+Chern-Simons+theory"} analytically continued Chern-Simons theory
            was proposed in
          %ul
            %li#Witten10
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              = succeed "," do
                %em Analytic Continuation Of Chern-Simons Theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1001.2933"} arXiv:1001.2933
          %p (but it seems that as a sketch or strategy for a rigorous proof, it didn’t catch on).
          %h4#as_adscft__3d3d_duality_for_wrapped_m5branes As AdS/CFT + 3d/3d duality for wrapped M5-branes
          %p
            Suggestion that the statement of the
            %a.existingWikiWord{:href => "/nlab/show/volume+conjecture"} volume conjecture
            is really
            %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+duality"} AdS-CFT duality
            combined with the
            %a.existingWikiWord{:href => "/nlab/show/3d-3d+correspondence"} 3d-3d correspondence
            for
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} wrapped
            on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/hyperbolic+3-manifolds"} hyperbolic 3-manifolds
          %ul
            %li#GangKimLee14b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dongmin+Gang"}> Dongmin Gang
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"} Nakwoo Kim
                = succeed "," do
                  %em
                    Holography of 3d-3d correspondence at Large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1409.6206"} arXiv:1409.6206
            %li#GangKim18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dongmin+Gang"}> Dongmin Gang
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"} Nakwoo Kim
                = succeed "," do
                  %em
                    Large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    twisted partition functions in 3d-3d correspondence and Holography
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1808.02797"} arXiv:1808.02797
