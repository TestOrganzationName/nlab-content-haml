              %li
                %a{:href => "#relation_to_other_topological_structures"} Relation to other topological structures
              %ul
                %li
                  %a{:href => "#topological_spaces"} Topological spaces
                %li
                  %a{:href => "#proximity_spaces"} Proximity spaces
                %li
