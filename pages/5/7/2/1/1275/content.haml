                      %mo ⊗
                      %mi A
                    %mi Γ
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                    %mover
                      %mo ⟶
                      %mrow
                        %mi c
                        %msub
                          %mo ⊗
                          %mi A
                        %mi id
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\overset{\Psi}{\longrightarrow}
                    N \otimes_A \Gamma
                    \\overset{\simeq}{\longrightarrow}
                    \\Gamma \otimes_A N
                    \\overset{c \otimes_A id}{\longrightarrow}
                    \\Gamma \otimes_A N
                    \\,.
          #CotensorProductOfComodules.num_defn
            %h6#definition_3 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed ")," do
                %a{:href => "commutative+Hopf+algebroid#CommutativeHopfAlgebroidDefinitionInExplicitComponents"} def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              a right
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              a left comodule (
              %a{:href => "commutative+Hopf+algebroid#CommutativeHopfAlgebroidComodule"}> def.
              ), then their
              %strong cotensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo □
                      %mi Γ
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1 \Box_\Gamma N_2
              is the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the difference of the two coaction morphisms:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo □
                      %mi Γ
                    %msub
                      %mi N
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi ker
                    %mrow
                      %mo (
                      %msub
                        %mi N
                        %mn 1
                      %msub
                        %mo ⊗
                        %mi A
                      %msub
                        %mi N
                        %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Ψ
                            %mrow
                              %msub
                                %mi N
                                %mn 1
                          %msub
                            %mo ⊗
                            %mi A
                          %mi id
                          %mo −
                          %mi id
                          %msub
                            %mo ⊗
                            %mi A
                          %msub
                            %mi Ψ
                            %mrow
                              %msub
                                %mi N
                                %mn 2
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_1 \Box_\Gamma N_2
                    \\;\coloneqq\;
                    ker
                    \\left(
                    N_1 \otimes_A N_2
                    \\overset{\Psi_{N_1}\otimes_{A} id - id \otimes_A \Psi_{N_2} }{\longrightarrow}
                    \\right)
                    \\,.
            %p
              If both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              are left comodules, then their cotensor product is the cotensor product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              regarded as a right comodule via prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LeftComodulesToRightComodules"}
          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, def. A1.1.4
            ).
          #PrimitiveElementInAComodule.num_example
            %h6#example Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed ")," do
                %a{:href => "commutative+Hopf+algebroid#CommutativeHopfAlgebroidDefinitionInExplicitComponents"} def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              a left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")." do
                %a{:href => "commutative+Hopf+algebroid#CommutativeHopfAlgebroidComodule"} def.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              itself canonically as a right
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prim
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi A
                    %msub
                      %mo □
                      %mi Γ
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    Prim(N) \coloneqq A \Box_\Gamma N
            %p
              is called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/primitive+elements"} primitive elements
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prim
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi n
                    %mo ∈
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ψ
                      %mi N
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ⊗
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Prim(N) = \{ n \in N \;\vert\; \Psi_N(n) = 1 \otimes n \}
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1, N_2
              two left
              = succeed "-comodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CotensorProductOfComodules"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo □
                    %msub
                      %mi N
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mn 2
                    %mo □
                    %msub
                      %mi N
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_1 \Box N_2 \;\simeq\; N_2 \Box N_1
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, prop. A1.1.5
          #ComoduleHomInTermsOfCotensorProduct.num_lemma
            %h6#lemma Lemma
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1, N_2
              two left
              = succeed "-comodules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              is
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective
              as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
            %ol
              %li
                %p The morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %mi f
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %mi id
                            %msub
                              %mo ⊗
                              %mi A
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo ∘
                            %msub
                              %mi Ψ
                              %mrow
                                %msub
                                  %mi N
                                  %mn 1
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mi A
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"}
                        Hom_A(N_1, A)
                        \\overset{f \mapsto (id \otimes_A f) \circ \Psi_{N_1}}{\longrightarrow}
                        Hom_A(N_1, \Gamma \otimes_A A)
                        \\simeq
                        Hom_A(N_1, \Gamma)
                        \\simeq
                        Hom_A(N_1, A) \otimes_A \Gamma
                %p
                  gives
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_A(N_1,A)
                  the structure of a right
                  = succeed "-comodule;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/cotensor+product"} cotensor product
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CotensorProductOfComodules"}
                  = succeed "-comodules:" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo □
                          %mi Γ
                        %msub
                          %mi N
                          %mn 2
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi Γ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %msub
                          %mi N
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Hom_A(N_1, A) \Box_\Gamma N_2
                        \\simeq
                        Hom_\Gamma(N_1, N_2)
                        \\,.
                %p Hence in particular
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %msub
                          %mo □
                          %mi Γ
                        %msub
                          %mi N
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %msub
                          %mi N
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        A \Box_\Gamma N_2
                        \\;\simeq\;
                        Hom_\Gamma(A,N_2)
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, lemma A1.1.6
          .num_remark
            %h6#remark Remark
            %p
              In computing the second page of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
              %a.maruku-ref{:href => "#ComoduleHomInTermsOfCotensorProduct"}
              is the key translation that makes the comodule
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed "-groups." do
                %a.existingWikiWord{:href => "/nlab/show/Cotor"} Cotor
              %a.existingWikiWord{:href => "/nlab/show/Lambda-algebra"} Lambda-algebra
              or via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/May+spectral+sequence"} May spectral sequence
          %h2#related_concepts Related concepts
          %ul
            %li
              a special case of the cotensor product as a functor of one variable is the
              %a.existingWikiWord{:href => "/nlab/show/induced+comodule"} induced comodule
              construction
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of cotensoring is called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cotor"} Cotor
          %h2#references References
          %p
            Cotensor products in
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            appear in the role of
            %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            of
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+principal+bundle"} quantum principal bundle
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Hopf-Galois+extensions"} Hopf-Galois extensions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Shahn+Majid"}> Shahn Majid
              ,
              = succeed "," do
                %em Foundations of quantum groups theory
          %p Basic homological algebra of cotensor products for coalgebras over a field is advanced in
          %ul
            %li
              Yukio Doi,
              = succeed "," do
                %em Homological coalgebra
              = succeed ":1" do
                %strong 33
              %a{:href => "https://mathscinet.ams.org/mathscinet-getitem?mr=597479"} MR597479
              %a{:href => "https://projecteuclid.org/euclid.jmsj/1239888030"} euclid
          %p
            (Co)flatness conditions play major role for study of cotensor products when coalgebras are over commutative rings, or in the categories of bimodules (
            %a.existingWikiWord{:href => "/nlab/show/coring"}> coring
            s),
          %ul
            %li
              Leonid Positselski,
              = succeed "," do
                %em Homological algebra of semimodules and semicontramodules: Semi-infinite homological algebra of associative algebraic structures
              %a{:href => "https://arxiv.org/abs/0708.3398"} arxiv/0708.3398
            %li
              %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
              , R. Wisbauer,
              = succeed "," do
                %em Corings and comodules
          %p
            For a nonaffine extension of the sections of associated quantum vector bundle, using
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            theory see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
              ,
              = succeed "," do
                %em Coherent states for Hopf algebras
              %p
                Lett. Math. Phys. 81 (2007), no. 1, 1–17. (
                %a{:href => "http://front.math.ucdavis.edu/0303.5357"}> arXiv:math.QA/0303357
                )
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            theory motivated by algebraic topology, cotensor products appear as early as in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Milnor"}> John Milnor
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Moore"} John Moore
              = succeed "," do
                %em On the structure of Hopf algebras
          %p
            and along with its derived functor Cotor used in computation of
            = succeed "-term" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E^2
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            of a
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"}> Samuel Eilenberg
              , John. C Moore,
              = succeed "," do
                %em Homology and fibrations. I. Coalgebras, cotensor product and its derived functors
              %strong 40
              (1966) 199–236
              %a{:href => "https://mathscinet.ams.org/mathscinet-getitem?mr=203730"} MR203730
              %a{:href => "http://doi.org/10.1007/BF02564371"} doi
          %p The authors mention that they learned the notion from Mac Lane who knew it earlier in more general contexts.
          %p A textbook account is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"}> Doug Ravenel
              , section A1.1 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Complex+cobordism+and+stable+homotopy+groups+of+spheres"} Complex cobordism and stable homotopy groups of spheres
          %p
            An important problem is that the cotensor product of bicomodules is in general (even for
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo =
                    %msub
                      %mrow
                      %mi k
                    %mi{:mathvariant => "normal"} Mod
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}={}_k\mathrm{Mod}
            = succeed "," do
              %em not associative
          %p
            Cotensor products play a prominent role in various treatments of
            %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            in
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebraic+geometry"} noncommutative algebraic geometry
            based on usage of monoidal categories, as sketched in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tomasz+Maszczyk"}> Tomasz Maszczyk
              , Noncommutative geometry through monoidal categories I,
              %a{:href => "http://front.math.ucdavis.edu/0707.1542"} arXiv:0707.1542
        .revisedby
