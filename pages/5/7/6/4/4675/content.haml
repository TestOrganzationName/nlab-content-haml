          #LongFiberSequenceOnLieAlgebras.num_prop
            %h6#observation_3 Observation
            %p
              The defining projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
