          %h2#idea Idea
          %p
            Where a
            %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            is a trivialization of a class in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            %em differential string structure
            or
            %em geometric string structure
            is the trivialization of this class refined to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            the first fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi B
                  %mi Spin
                  %mo →
                  %msup
                    %mi B
                    %mn 4
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2} p_1 : B Spin \to B^4 \mathbb{Z}
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            has a refinement to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\mathbf{p}_1 : \mathbf{B}Spin \to \mathbf{B}^3 U(1)
          %p
            – the
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#SmoothFirstFracPontryaginClass"} smooth first fractional Pontryagin class
          %p
            The induced morphism on
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\mathbf{p}_1
                  \:
                  \\mathbf{H}(X,\mathbf{B} Spin)
                  \\stackrel{}{\to}
                  \\mathbf{H}(X,\mathbf{B}^3 U(1))
          %p
            sends a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to its corresponding
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}\mathbf{p}_1(P)
          %p
            A choice of trivialization of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}p_1(P)
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            of smooth string structures is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\mathbf{p}_1
            over the trivial
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory+in+Smooth%E2%88%9EGrpd"} Chern-Weil theory in Smooth∞Grpd
            this morphism may be further refined to a
            %a.existingWikiWord{:href => "/nlab/show/differential+characteristic+class"} differential characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1
            that lands in the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}(X, \mathbf{B}^3 U(1))
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundles with connection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi conn
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\hat \mathbf{p}_1
                  \:
                  \\mathbf{H}_{conn}(X,\mathbf{B} Spin)
                  \\stackrel{}{\to}
                  \\mathbf{H}_{diff}(X,\mathbf{B}^3 U(1))
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            of
            %strong differential string structures
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of this refinement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1
            over the
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} trivial circle 3-bundle with trivial connection
            or more generally over the trivial circle 3-bundles with possibly non-trivial connection
          %p
            Such a differential string structure over a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is characterized by a tuple consisting of
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
                on a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                a choice of trivial
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundle
                with connection
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %msub
                          %mi H
                          %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (0, H_3)
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mn 3
                        %mo ∈
                        %msup
                          %mi Ω
                          %mn 3
