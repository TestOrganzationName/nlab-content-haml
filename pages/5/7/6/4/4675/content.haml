                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
