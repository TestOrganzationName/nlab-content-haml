                        %mi μ
                        %mo ,
                        %mi b
                        %mo ↦
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ←
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ↦
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
