            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          %p
            At
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory+in+Smooth%E2%88%9EGrpd"} Chern-Weil theory in Smooth∞Grpd
            the following statement is proven (
            %a{:href => "#FSS"}> FSS
            ).
          #LieIntegrationToPOne.num_prop
            %h6#proposition Proposition
            %p
              The image under
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra 3-cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %mi 𝔰𝔬
                    %mo →
                    %msup
                      %mi b
                      %mn 2
