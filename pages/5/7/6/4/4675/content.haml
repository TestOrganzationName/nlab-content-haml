                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H_3 = d B + CS(\omega) - CS(A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi H
                    %mn 3
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi ω
                  %mo ∧
                  %msub
                    %mi F
                    %mi ω
                  %mo{:stretchy => "false"} ⟩
                  %mo −
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d H_3 = \langle F_\omega \wedge F_\omega \rangle
                  \-
                  \\langle F_A \wedge F_A \rangle
                  \\,.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 3
                %annotation{:encoding => "application/x-tex"} H_3
            is the would-be
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connection
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equation"} Maxwell equation
            that exhibits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi mag
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi ω
                  %mo ∧
                  %msub
                    %mi F
                    %mi ω
                  %mo{:stretchy => "false"} ⟩
                  %mo −
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  j_{mag}
                  \:=
                  \\langle F_\omega \wedge F_\omega \rangle
                  \-
                  \\langle F_A \wedge F_A \rangle
          %p
            as the
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            distribution that twists this 2-bundle. This may be interpreted as the magnetic charge density of a classical background density of magnetic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+brane"} fivebranes
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
          %p
            More precisely, the twisted differential string structure of the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            in heterotic
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            for fixed gauge bundles are therefore given by the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi GSBackground
                            %mrow
                              %mi fixed
                              %mi gauge
                              %mi bundle
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi π
                            %mn 0
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi conn
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
