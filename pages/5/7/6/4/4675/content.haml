            %p
              whose image under the
              %a{:href => "http://nlab.mathforge.org/nlab/show/Euclidean-topological%20infinity-groupoid#GeometricHomotopy"} the fundamental ∞-groupoid (∞,1)-functor/ geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \Pi : Smooth \infty Grpd \to
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is the ordinary fractional
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mi p
                      %mn 1
                    %mo :
                    %mi B
                    %mi Spin
                    %mo →
                    %msup
                      %mi B
                      %mn 4
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{2}p_1 : B Spin \to B^4 \mathbb{Z}
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#ChernWeilTheory"} refined differential characteristic class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
