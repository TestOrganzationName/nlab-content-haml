                %annotation{:encoding => "application/x-tex"} \hookrightarrow
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            and thus canonically as an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
