                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in the following. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi Spin
                %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin
            for the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                %annotation{:encoding => "application/x-tex"} Spin
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            = succeed ")." do
              %a{:href => "http://nlab.mathforge.org/nlab/show/smooth+infinity-groupoid#LieGroups"} here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
