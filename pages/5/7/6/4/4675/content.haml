                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{2}\hat \mathbf{p}_1 :
                    \\mathbf{H}_{conn}(-,\mathbf{B}Spin)
                    \\to
