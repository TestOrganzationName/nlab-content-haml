                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k = 3
              the lifting problems
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi ℝ
                            %mo →
                            %msub
                              %mi 𝔤
                              %mi μ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi smp
                                %mo ,
                                %mi ChW
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi smp
                                %mo ,
                                %mi ChW
                            %mo{:stretchy => "false"} /
                            %mi ℤ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[k]_i
                    \&amp;\to &amp;
                    \\exp(b\mathbb{R} \to \mathfrak{g}_{\mu})_{smp,ChW}(U)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[k]
                    \&amp;\to&amp;
                    \\exp(b^2 \mathbb{R})_{smp,ChW}/\mathbb{Z}(U)
                    }
            %p
              may all be equivalently reformulated as lifting against a
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi k
                    %mo ↪
                    %msup
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D^k \hookrightarrow D^k \times [0,1]
              by using the sitting instants of all forms.
            %p
              We have then a 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi si
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C \in \Omega^3_{si}(U \times D^{k-1}\times [0,1])
              with horizontal curvature
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \in \Omega^4(U)
              and differential form data
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} U \times D^{k-1}
              given. We may always extend
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              along the cylinder direction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              (its vertical part is equivalently a based smooth function to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} Spin
              which we may extend constantly).
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              has to be horizontal so it is to be constantly extended along the cylinder.
            %p
              We can then use the kind of formula that proves the
              %a.existingWikiWord{:href => "/nlab/show/Poincare+lemma"} Poincare lemma
              to extend
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi k
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi : (D^k \times [0,1]) \times [0,1] \to (D^k  \times [0,1])
              be a smooth contraction. Then while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo −
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d(H - CS(A) + C)
              may be non-vanishing, by horizonatlity of their
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %msubsup
                      %mi Ψ
                      %mi t
                      %mo *
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo −
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota_{\partial_t} \Psi_t^* d(H - CS(A) + C)
              vanishes (since the contraction vanishes).
            %p Therefore the 2-form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi t
                    %msubsup
                      %mi Ψ
                      %mi t
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo −
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde B := \int_{[0,1]} \iota_{\partial_t} \Psi_t^*(H - CS(A) + C)
            %p
              satisfies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ˜
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo −
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d \tilde B = (H - CS(A) + C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo −
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi t
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} B - \tilde B|_{t = 0}
              is a closed form on the left boundary of the cylinder. We may find some closed 2-form on the other boundary such that the integral around the boundary vanishes. Then the argument from the proof of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie n-algebra
              applies and we find an extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              to a closed 2-form on the interior. The sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mo =
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mo +
                    %mi λ
                  %annotation{:encoding => "application/x-tex"}
                    \\hat B := \tilde B + \lambda
            %p
              then still satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mi H
                    %mo −
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi C
                  %annotation{:encoding => "application/x-tex"} d \hat B = H - CS(A) - C
              and it coincides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              on the left boundary.
            %p
              Notice that here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde B
              indeed has sitting instants: since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CS
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CS(A)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              have sitting instants they are constant on their value at the boundary in a neighbourhood perpendicular to the boundary, which means for these 3-forms in the degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} \leq 3
              that they
              %em vanish
              in a neighbourhood of the boundary, hence that the above integral is towards the boundary over a vanishing integrand.
            %p In degree 4 the nature of the lifting problem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mn 4
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi ℝ
                            %mo →
                            %msub
                              %mi 𝔤
                              %mi μ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 4
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mrow
                                %mi ChW
                                %mo ,
                                %mi ch
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[4]_i &amp;\to&amp; \mathbf{cosk}_3\exp(b\mathbb{R} \to \mathfrak{g}_\mu)(U)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[4] &amp;\to&amp; \mathbf{B}^3 \mathbb{R}/\mathbb{Z}_{ChW,ch}
                    }
            %p
              starts out differently, due to the presence of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi cosk
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3
            %p
              We have four functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} U \to \mathbb{R}/\mathbb{Z}
              which we may realize as the
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of a 3-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 4
                      %mo{:stretchy => "false"} ]
                      %mo ∖
                      %msub
                        %mi δ
                        %mi i
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 3
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \times (\partial \Delta[4] \setminus \delta_i \Delta[3])
              = succeed "-data" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi C
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B,C, H)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 4
                    %mo{:stretchy => "false"} ]
                    %mo ∖
                    %msub
                      %mi δ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \times (\partial \Delta[4]\setminus \delta_i(\Delta[3]))
              (the boundary of the 4-simplex minus one of its 3-simplex faces).
            %p We observe that we can
            %ul
              %li
                %p
                  always extend
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  smoothly to the remaining 3-face such that its
                  %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
                  there reproduces the signed difference of the four given functions corresponding to the other faces (choose any smooth 3-form with sitting instants and with non-vanishing integral and rescale smoothly);
              %li
                %p
                  fill the
                  = succeed "-data" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi Spin
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \pi_2 (Spin) = 0
              %li
                %p
                  the
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
            %p
              Moreover, by the fact that the 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              already is defined on all of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 4
                    %mo{:stretchy => "false"} ]
                    %mo ∖
                    %msub
                      %mi δ
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \partial \Delta[4] \setminus \delta_i(\Delta[3])
              its fiber integral over the boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \partial \Delta[3]
              coincides with the fiber integral of
