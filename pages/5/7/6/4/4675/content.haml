            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} ^
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \hat \mathbf{c}_2
            against each other.
          %p
            More discussion of this is in (
            %a{:href => "#SSSIII"}> SSSIII
            ).
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi dR
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{dR}(X, \mathbf{B}^3 U(1))
            is abelian, we may consider the corresponding
            %a{:href => "http://ncatlab.org/nlab/show/fiber%20sequence#MayerVietoris"} Mayer-Vietoris
            sequence by realizing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GSBackground
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GSBackground(X)
            equivalently as the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the difference of differential cocycles
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 2
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo −
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1 - \hat \mathbf{c}_2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi GSBackground
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi conn
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Spin
                          %mo ×
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo −
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi c
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi dR
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 4
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  GSBackground(X) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                  \\\
                  \\mathbf{H}_{conn}(X,\mathbf{B}Spin \times \mathbf{B}U)
                  \&amp;\stackrel{\frac{1}{2}\hat \mathbf{p}_1-\hat \mathbf{c}_2}{\to}&amp;
                  \\mathbf{H}_{dR}(X, \mathbf{B}^4 U(1))
                  }
                  \\,.
          %p
            Indeed, the above explicit presentation by simplicial presheaves generalizes immediately to describe this case, realizing
            = succeed "-twisted" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-twisted-string-structures\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            We may usefully formalize this further by defining the
            = succeed "-2-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi String
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} String^{\mathbf{c}_2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msup
                            %mi String
                            %mrow
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mi Spin
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi p
                                %mn 1
                              %mo −
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mn 2
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B} String^{\mathbf{c}_2} &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{G}(Spin \times U)
                  \&amp;\stackrel{\frac{1}{2}\mathbf{p}_1 - \mathbf{c}_2}{\to}&amp;
                  \\mathbf{B}^3 U(1)
                  }
                  \\,.
          %p
            We have then that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi GSBackground
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GSBackground(X)
            is the 3-groupoid of
            %em untwisted
            differential
            = succeed "-structures." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi String
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}String^{\mathbf{c}_2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi GSBackground
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mn 0
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi conn
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi Spin
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo −
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mn 2
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi dR
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 4
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  GSBackground(X) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{0}
                  \\\
                  \\mathbf{H}_{conn}(\mathbf{B} (Spin \times U))
                  \&amp;\stackrel{\frac{1}{2}\hat \mathbf{p}_1 - \mathbf{c}_2}{\to}&amp;
                  \\mathbf{H}_{dR}(X, \mathbf{B}^4 U(1))
                  }
                  \\,.
          %p
            More on this in (
            %a{:href => "#FiSaSc"}> FiSaSc
            ).
          %p
            This is supposed to be (see section 12 of (
            %a{:href => "#DFM"}> DFM
            )) the restriction to the boundary of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            = succeed "-pullback" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                          %mi Field
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msubsup
                            %mi H
                            %mi dR
                            %mn 4
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi d
                                %msub
                                  %mi C
                                  %mn 3
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi Spin
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                              %mo −
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi c
                                %mn 2
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 4
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C Field(Y) &amp;\to&amp; H^4_{dR}(Y)
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{d C_3}}
                  \\\
                  \\mathbf{H}(Y,\mathbf{B} (Spin \times U))
                  \&amp;\stackrel{\frac{1}{2}\hat \mathbf{p}_1 - \mathbf{c}_2}{\to}&amp;
                  \\mathbf{H}(Y, \mathbf{B}^4 U(1))
                  }
                  \\,.
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is 11-dimensional with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} parital
                    %mi Y
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \parital Y = X
            %em without
            connection, or equivalently (when computing the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            by an ordinary pullback along a fibration) with
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/pseudo-connection"} pseudo-connection
          %p
            By the discussion at
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            under a shift of connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mn 1
                  %mo ↦
                  %msub
                    %mo ∇
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \nabla_1 \mapsto \nabla_2
            the
            = succeed "-field" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 2
                  %mo =
                  %msub
                    %mi C
                    %mn 1
                  %mo +
                  %mi CS
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∇
                    %mn 1
                  %mo ,
                  %msub
                    %mo ∇
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C_2 = C_1 + CS(\nabla_1, \nabla_2)
                  \\,,
          %p
            where on the right we have the relative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
          %ol
            %li
              %p
                the supergravity
                = succeed "-field" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p the gauge bundles develop genuine connections.
          %h3#relation_to_string_2connections Relation to string 2-connections
          %p
            By the discussion at
            %em
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} connection on an ∞-bundle
            we have that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo :
                  %mo =
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G := \mathbf{cosk}_{n+1} \exp(\mathfrak{g})
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth Lie n-group
            obtained from it by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connections
            on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo :
                  %mo =
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B}G_{conn} := \mathbf{cosk}_{n+1} \exp(\mathfrak{g})_{conn}
                  \\,,
          %p
            where on the very right we have the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mrow
                    %mo {
                    %mi A
                    %mo :
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi vertically
                    %mspace{:width => "thickmathspace"}
                    %mi flat
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi horizontal
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(\mathfrak{g}) : (U,[k]) \mapsto
                  \\left\{
                  A : CE(\mathfrak{g}) \to \Omega^\bullet(U \times \Delta^n)
                  |
                  A\;is\;vertically\;flat\; and\;F_A\;is \; horizontal
                  \\right\}
                  \\,.
          %p
            (See
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            for details).
          #StringConnectionsFromDiffStringStructzres.num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
              of entirely untwisted differential string structures on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (the twist being
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %msubsup
                        %mi H
                        %mi diff
                        %mn 4
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \in H^4_{diff}(X)
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} 2-connection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi String
                      %mrow
                        %mi diff
                        %mo ,
                        %mi tw
                        %mo =
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi String
                    %mn 2
                    %msub
                      %mi Bund
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    String_{diff, tw = 0}(X) \simeq String 2Bund_{\nabla}(X)
                    \\,.
          .proof
            %h6#proof_6 Proof
            %p
              By the above discussion of
              %a{:href => "#ExplicitCocycles"} Cech cocycles
              we compute
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi String
                      %mrow
                        %mi diff
                        %mo ,
                        %mi tw
                        %mo =
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} String_{diff, tw = 0}(X)
              as the ordinary fiber of the morphism of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi diff
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [CartSp^{op}, sSet](
                    C(\{U_i\}),  \mathbf{cosk}_3 \exp(b \mathbb{R} \to \mathfrak{g}_\mu))
                    \\to
                    [CartSp^{op}, sSet](
                    C(\{U_i\}), \mathbf{B}^3 U(1)_{diff})
            %p over the identically vanishing cocycle.
            %p
              In terms of the component formulas spelled out in the
              %a{:href => "#InheteroticSugra"} above discussion
              of the GS-mechanism, this amounts to restricting to those cocycles for which in each degree the equations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    C = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    G = 0
            %p holds.
            %p
              Comparing this to the explicit formulas for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(b \mathbb{R} \to \mathfrak{g}_\mu)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \exp(b \mathbb{R} \to \mathfrak{g}_\mu)_{conn}
              in the
              %a{:href => "#PresentationOfClassByFibration"} above
              we see that these cocycles are exactly those that factor through the canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}_\mu \to (b \mathbb{R} \to \mathfrak{g}_\mu)
            %p
              from observation
              %a.maruku-ref{:href => "#LongFiberSequenceOnLieAlgebras"}
              of the
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
              into the
              %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
              Lie 3-algebra of the extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} b \mathbb{R} \to \mathfrak{g}_\mu \to \mathfrak{g}
              that defines it.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+differential+cohomology"} nonabelian differential cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
                of the
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/spin+structure"}> spin structure
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/twisted+spin+structure"} twisted spin structure
                    %a.existingWikiWord{:href => "/nlab/show/differential+spin+structure"} differential spin structure
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"} twisted spin^c structure
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/string+structure"}> string structure
                    ,
                    %strong differential string structure
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/chiral+Dolbeault+complex"} chiral Dolbeault complex
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/fivebrane+structure"} fivebrane structure
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/schreiber/show/Hypothesis+H"} Hypothesis H
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/twisted+differential+c-structure"} twisted differential c-structure
                  %ul
                    %li
                      %p
                        %strong differential string structure
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/twisted+differential+fivebrane+structure"} twisted differential fivebrane structure
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/differential+T-duality"} differential T-duality
          %h2#references References
          %p
            A discussion of differential string structures in terms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
          %ul
            %li#Waldorf
              %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
              ,
              = succeed "," do
                %em String Connections and Chern-Simons Theory
              %strong 365
              (2013), 4393-4432, (
              %a{:href => "http://arxiv.org/abs/0906.0117"}> arXiv:0906.0117
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1090/S0002-9947-2013-05816-3"} doi:10.1090/S0002-9947-2013-05816-3
          %p
            The description of the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
            is in section 3 of
          %ul
            %li#DFM
              E. Diaconescu,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Greg+Moore"} Greg Moore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"} Dan Freed
              %em
                The
                = succeed "-theory" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "-gauge" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mn 8
                      %annotation{:encoding => "application/x-tex"} E_8
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/0312069"}> arXiv:hep-th/0312069
              \&amp;rbrack;
          %p
            The local data for the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+valued+differential+forms"} ∞-Lie algebra valued differential forms
            for the description of twisted differential string structures as above was given in
          %ul
            %li#SSSIII
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Twisted+Differential+String+and+Fivebrane+Structures"} Twisted Differential String and Fivebrane Structures
              %strong 315
              1 (2012) 169-213 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0910.4001"}> arXiv:0910.4001
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-012-1510-3"} doi:10.1007/s00220-012-1510-3
          %p The full Čech-Deligne cocycles induced by this (but not yet the homotopy fibers over them) were discussed in
          %ul
            %li#FiorenzaSatiSchreiber12
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/%C4%8Cech+Cocycles+for+Differential+Characteristic+Classes"} Čech Cocycles for Differential Characteristic Classes
              %strong 16
              1 (2012) 149-250 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1011.4735"}> arXiv:1011.4735
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BF02104916"} doi:10.1007/BF02104916
          %p A comprehensive discussion including all the formal background and the applications is attempted at
          %ul
            %li#dcct
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              , section 4.2 of:
              %em
                %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"} differential cohomology in a cohesive topos
          %p
            The translation between the
            = succeed "-picture" do
              %a.existingWikiWord{:href => "/nlab/show/bundle+2-gerbe"} bundle 2-gerbe
            %a{:href => "#Waldorf"} Waldorf
            and the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi String
                  %annotation{:encoding => "application/x-tex"} String
            = succeed "-piucture" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            = succeed "," do
              %a{:href => "#SSSIII"} Sati et al.
            %a{:href => "#FiorenzaSatiSchreiber12"} Fiorenza et al.
            and
            %a{:href => "#dcct"} dcct
            is worked out in some detail in:
          %ul
            %li
              Alessandra Capotosti,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/From+String+structures+to+Spin+structures+on+loop+spaces"} From String structures to Spin structures on loop spaces
              = succeed "," do
                %a{:href => "http://www.matfis.uniroma3.it/Allegati/Dottorato/TESI/capotosti/PhD%20Thesis%202016%20A%20Capotosti.pdf"} thesis pdf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/Capotosti-FromStringStructures.pdf", :title => "pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Capotosti-FromStringStruc-Slides.pdf", :title => "pdf"} pdf
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
            cancellation in
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            has been first discussed in
          %ul
            %li#Killingback
              Killingback,
              %em World-sheet anomalies and loop geometry
              Nuclear Physics B Volume 288, 1987, Pages 578-588
          %p and given a rigorous treatment in
          %ul
            %li#Bunke
              %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
              ,
              %em String structures and trivialisations of a Pfaffian line bundle
              (
              %a{:href => "http://arxiv.org/abs/0909.0846"}> arXiv
              )
          %p More discussion on the relation to spin structures on smooth loop space is in
          %ul
            %li
              Alessandra Capotosti,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/From+String+structures+to+Spin+structures+on+loop+spaces"} From String structures to Spin structures on loop spaces
