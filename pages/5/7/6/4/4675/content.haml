                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} (b \mathbb{R} \to \mathfrak{g}_\mu) \to \mathfrak{g}
              by the canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}_\mu \to (b \mathbb{R} \to \mathfrak{g}_\mu)
                    \\,,
            %p
              which dually on
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                    %annotation{:encoding => "application/x-tex"} CE
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi t
                      %mi a
                    %mo ↦
                    %msup
                      %mi t
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    t^a \mapsto t^a
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ↦
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi b
                  %annotation{:encoding => "application/x-tex"}
                    b \mapsto - b
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c \mapsto 0
                    \\,.
            %p
              In total we are looking at a convenient presentation of the long
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              of the
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
              extension:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi ℝ
                            %mo →
                            %msub
                              %mi 𝔤
                              %mi μ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi b
                              %mn 2
                            %mi ℝ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi b
                            %mi ℝ
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi 𝔤
                              %mi μ
                          %mtd
                            %mo →
                          %mtd
                            %mi 𝔤
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; (b \mathbb{R} \to \mathfrak{g}_\mu) &amp;\to&amp; b^2 \mathbb{R}
                    \\\
                    \&amp;&amp; &amp; \nearrow &amp; \downarrow^{\mathrlap{\simeq}}
                    \\\
                    b \mathbb{R} &amp;\to&amp; \mathfrak{g}_\mu &amp;\to&amp; \mathfrak{g}
                    }
                    \\,.
          %p (The signs appearing here are just unimportant convention made in order for some of the formulas below to come out nice.)
          #BareFibration.num_prop
            %h6#proposition_4 Proposition
            %p
              The image under
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the above factorization is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi cosk
                      %mn 3
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mi c
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mu)
                    \:
                    \\mathbf{cosk}_3\exp(\mathfrak{g})
                    \\to
                    \\mathbf{cosk}_3\exp(b \mathbb{R} \to \mathfrak{g}_\mu)
                    \\to
                    \\mathbf{B}^3 \mathbb{R}/\mathbb{Z}_c
            %p
              where the first morphism is a weak equivalence followed by a fibration in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi smooth
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp_{smooth}^{op}, sSet]_{proj}
          .proof
            %h6#proof_3 Proof
            %p
              To see that the left morphism is objectwise a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(b \mathbb{R} \to \mathfrak{g}_\mu)
              consists of a triple
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B,C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a vertical flat
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} U\times\Delta^k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a vertical 2-form and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a 3-form on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} U\times\Delta^k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi B
                    %mo =
                    %mi C
                    %mo −
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d B=C-\mu(A,A,A)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi C
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d C=0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is flat. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is uniquely determined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(b \mathbb{R} \to \mathfrak{g}_\mu)
              is identified with a pair consisting of a based
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msup
                      %mi Δ
                      %mi k
                    %mo →
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} f : \Delta^k \to Spin
              and a
              %a.existingWikiWord{:href => "/nlab/show/vertical+differential+form"} vertical 2-form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ∈
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi si
                          %mo ,
                          %mi vert
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ×
                      %msup
                        %mi Δ
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B \in \Omega^2_{si,vert}(U \times \Delta^k)
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+group"} simplicial homotopy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(b \mathbb{R} \to \mathfrak{g}_\mu)(U)
              are the same as those of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(U)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and picks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} B = 0
              and is hence clearly an isomorphism on homotopy groups.
            %p We turn now to discussing that the second morphism is a fibration. The nontrivial degrees of the lifting problem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi cosk
                              %mn 3
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mi ℝ
                            %mo →
                            %msub
                              %mi 𝔤
                              %mi μ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 3
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[k]_i
                    \&amp;\to&amp;
                    \\mathbf{cosk}_3\exp(b\mathbb{R} \to \mathfrak{g}_\mu)(U)
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\Delta[k] &amp;\to&amp; \mathbf{B}^3 \mathbb{R}/\mathbb{Z}_c(U)
                    }
            %p
              are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k = 3
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} k = 4
            %p
              Notice that a
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} 3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^3 \mathbb{R}/ \mathbb{Z}_c(U)
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} U \to \mathbb{R}/\mathbb{Z}
              and that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi ℝ
                    %mo →
                    %msub
                      %mi 𝔤
                      %mi μ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 3
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \exp(b\mathbb{R} \to \mathfrak{g}_\mu) \to \mathbf{B}^3 \mathbb{R}/\mathbb{Z}_c
              sends the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,B)
              to the
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi Δ
                            %mn 3
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} ⟨
                      %mi θ
                      %mo ∧
                      %mo{:stretchy => "false"} [
                      %mi θ
                      %mo ∧
                      %mi θ
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ⟩
                      %mo +
                      %mi d
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mi mod
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \int_{\Delta^3}(f^* \langle \theta \wedge [\theta \wedge \theta]\rangle + d B) mod \mathbb{Z}
            %p
              Our lifting problem in degree 3, has given a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 3
                    %mo →
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} c : U \times \Delta^3 \to \mathbb{R}/\mathbb{Z}
              and a smooth function (with sitting instants at the subfaces)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi U
                    %mo ×
                    %msubsup
                      %mi Λ
                      %mi i
                      %mn 3
                    %mo →
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} f : U \times \Lambda^3_i \to Spin
              together with a 2-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              on the
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %msubsup
                        %mi Λ
                        %mi i
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} U \times \Lambda^3_i
            %p
              By pullback along the standard
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
