          %h2#idea Idea
          %p
            Where a
            %em
              %a.existingWikiWord{:href => "/nlab/show/triangulation"} triangulation
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is its
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
            identification with the
            %a.existingWikiWord{:href => "/nlab/show/topological+realization"} topological realization
            of a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            (
            %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"}> simplicial complex
            ), the analogous construction with
            %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
            may be referred to as “cubulation”.
          %h2#the_category_of_cubes The category of cubes
          %p
            The
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cubes"} category of cubes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cube
                  %annotation{:encoding => "application/x-tex"} Cube
            %a.existingWikiWord{:href => "/nlab/show/walking+structure"} walking
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            among
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            that are equipped with an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi i
                    %mn 0
                  %mo ,
                  %msub
                    %mi i
                    %mn 1
                  %mo :
                  %mn 1
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} i_0, i_1: 1 \to I
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the monoidal unit) and a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi I
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p: I \to 1
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %msub
                      %mi i
                      %mn 0
                    %mo =
                    %msub
                      %mi id
                      %mn 1
                    %mo =
                    %mi p
                    %mo ∘
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p \circ i_0 = id_1 = p \circ i_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cube
                %annotation{:encoding => "application/x-tex"} Cube
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo :
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} !: X \to 1
            for any object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cube
                %annotation{:encoding => "application/x-tex"} Cube
            monoidally generates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cube
                %annotation{:encoding => "application/x-tex"} Cube
            in the sense of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/PROP"} PROS
          %p
            It may be shown that if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi n
                      %mi m
                    %mo )
                  %msup
                    %mn 2
                    %mrow
                      %mi n
                      %mo −
                      %mi m
                %annotation{:encoding => "application/x-tex"} \binom{n}{m}2^{n-m}
            injections
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mrow
                        %mo ⊗
                        %mi m
                    %mo →
                    %msup
                      %mi I
                      %mrow
                        %mo ⊗
                        %mi n
                  %annotation{:encoding => "application/x-tex"} I^{\otimes m} \to I^{\otimes n}
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "-cube." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %ul
            %li
              A different possibility is to consider the
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
              of two constants, which gives a different category of cubes with diagonal maps.
          %h2#standard_geometric_cube_functor Standard geometric cube functor
          %p
            From the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cube
                  %annotation{:encoding => "application/x-tex"} Cube
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is considered as a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
            equipped with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0, 1]
            in this sense of interval, we get an induced monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                  %mo :
                  %mi Cube
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} \Box: Cube \to Top
          %p
            The monoidal product on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cube
                %annotation{:encoding => "application/x-tex"} Cube
            induces a monoidal product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Cube
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{Cube^{op}}
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %a.existingWikiWord{:href => "/nlab/show/topological+realization+of+cubical+sets"} cubical realization functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Cube
                        %mi op
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} R_{cub}: Set^{Cube^{op}} \to Top
            is, up to isomorphism, the unique
            %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            which extends the monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                %annotation{:encoding => "application/x-tex"} \Box
            along the Yoneda embedding; therefore
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                %annotation{:encoding => "application/x-tex"} R_{cub}
            takes
            = succeed "-products" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
            to the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} cartesian products of spaces
          %p
            In terms of an explicit formula, the
            %a.existingWikiWord{:href => "/nlab/show/topological+cubical+realization+of+a+cubical+set"} topological cubical realization of a cubical set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cube
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C: \Cube^{op} \to Set
            is given by the
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                  %mi C
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mi m
                      %mo ∈
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi Cube
                      %mo{:stretchy => "false"} )
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo □
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R_{cub} C = \int^{m \in Ob(Cube)} C(m) \times \Box(m)
          %h2#definition Definition
          %p
            A
            %strong cubulation
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a
            %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo :
                  %msup
                    %mi Cube
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C: Cube^{op} \to Set
            together with a
            %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi R
                      %mi cub
                    %mi C
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} h: R_{cub}C \to Y
          %h2#relation_between_triangulation_and_cubulation Relation between triangulation and cubulation
          %p
            In rough terms, a space can be
            %a.existingWikiWord{:href => "/nlab/show/triangulation"} triangulated
            if and only if it can be cubulated. This can be shown by simple conceptual arguments, as follows.
          %h3#cubulating_a_triangulated_space Cubulating a triangulated space
          %p
            In this section,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            may be taken to be the category of topological spaces, or otherwise any sufficiently
            %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
            (completeness and cocompleteness are baseline assumptions).
          %h4#simplices_as_cubical_sets Simplices as cubical sets
          %p We define a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo :
                  %mi Δ
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Cube
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Sigma: \Delta \to Set^{Cube^{op}}
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            effectively regards an
            %a.existingWikiWord{:href => "/nlab/show/n-simplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-simplex
            as an iterated
            %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
            and then produces the analogous join in the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
          %p
            To define
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo :
                    %mi Δ
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi Cube
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \Sigma: \Delta \to Set^{Cube^{op}}
            %a{:href => "http://ncatlab.org/nlab/show/triangulation#second_definition_5"} second definition
            of the affine simplex functor given at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/triangulation"} triangulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            by cubical sets and the topological simplicial join by a suitable “cubical simplicial join”. Formally, we define a monoidal structure on cubical sets by taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \star Y
            to be the pushout of the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mn 1
                        %mi X
                      %mo ⊗
                      %msub
                        %mi i
                        %mn 0
                      %mo ⊗
                      %msub
                        %mn 1
                        %mi Y
                  %mi X
                  %mo ⊗
                  %mi I
                  %mo ⊗
                  %mi Y
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mn 1
                        %mi X
                      %mo ⊗
                      %msub
                        %mi i
                        %mn 1
                      %mo ⊗
                      %msub
                        %mn 1
                        %mi Y
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi π
                        %mn 2
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \stackrel{\pi_1}{\leftarrow} X \otimes Y \stackrel{1_X \otimes i_0 \otimes 1_Y}{\to} X \otimes I \otimes Y \stackrel{1_X \otimes i_1 \otimes 1_Y}{\leftarrow} X \otimes Y \stackrel{\pi_2}{\to} Y
          %p
            where the projection maps
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \pi_2
            are defined by taking advantage of the fact that the monoidal unit of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            is terminal:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mn 1
                        %mi X
                      %mo ⊗
                      %mo !
                  %mi X
                  %mo ⊗
                  %mn 1
                  %mo ≅
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1 = (X \otimes Y \stackrel{1_X \otimes !}{\to} X \otimes 1 \cong X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⊗
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %mo !
                      %mo ⊗
                      %msub
                        %mn 1
                        %mi Y
                  %mn 1
                  %mo ⊗
                  %mi Y
                  %mo ≅
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2 = (X \otimes Y \stackrel{! \otimes 1_Y}{\to} 1 \otimes Y \cong Y)
          %p The terminal cubical set is of course a monoid with respect to this monoidal product, so by the walking monoid property we obtain a monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo :
                  %mi Δ
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Cube
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Sigma: \Delta \to Set^{Cube^{op}}
          %p
            which plays a role analogous to the affine simplex functor into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
          %h4#cubulating_geometric_simplices Cubulating geometric simplices
          %p
            Observe that geometric realization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Cube
                        %mi op
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} R_{cub}: Set^{Cube^{op}} \to Top
            takes cubical simplicial joins to topological simplicial joins, because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                %annotation{:encoding => "application/x-tex"} R_{cub}
            sends
            = succeed "-products" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
            %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
            because it is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi Δ
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} \sigma: \Delta \to Top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi cub
                  %mo ∘
                  %mi Σ
                  %mo :
                  %mi Δ
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} R_{cub} \circ \Sigma: \Delta \to Top
            take monoidal products in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            to topological simplicial joins, and both take the walking monoid of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            to the one-point space. By the universal property of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo ≅
                  %msub
                    %mi R
                    %mi cub
                  %mo ∘
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \sigma \cong R_{cub} \circ \Sigma
          %p (as monoidal functors), giving the canonical cubulation of affine simplices. In terms of an explicit formula, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mo ∫
                    %mi m
                  %msub
                    %mi Σ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo □
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sigma(n) \cong \int^m \Sigma_n(m) \cdot \Box(m)
          %h4#standard_cubulation_of_a_triangulated_space Standard cubulation of a triangulated space
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/triangulation"} triangulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi h
                  %mo :
                  %mi R
                  %mi X
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, h: R X \to Y)
            of a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi n
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi n
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∫
                            %mi m
                          %msub
                            %mi Σ
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo □
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi cubulation
                          %mi of
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi m
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∫
                            %mi n
                          %mi X
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mi Σ
                            %mi n
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo □
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi interchange
                          %mi of
                          %mi coends
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y &amp; \cong &amp; \int^n X(n) \cdot \sigma(n) &amp; &amp; \\
                  \&amp; \cong &amp; \int^n X(n) \cdot (\int^m \Sigma_n(m) \cdot \Box(m)) &amp; &amp; cubulation of \sigma(n) \\
                  \&amp; \cong &amp; \int^m (\int^n X(n) \cdot \Sigma_n(m)) \cdot \Box(m) &amp; &amp; interchange of coends
                  }
          %p
            where in the last line we used the
            = succeed "." do
              %a{:href => "end#Fubini"} coend Fubini theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mo ∫
                    %mi n
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mi Σ
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(m) = \int^n X(n) \cdot \Sigma_n(m)
          %p
            we have a homeomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ≅
                    %msup
                      %mo ∫
                      %mi m
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo □
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi R
                      %mi cub
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Y \cong \int^m C(m) \cdot \Box(m) = R_{cub} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %h3#triangulating_a_cubulated_space Triangulating a cubulated space
          %p
            In this section we assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+spaces"} convenient category of spaces
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            of simplicial sets is product-preserving (see
            = succeed ")." do
              %a{:href => "geometric+realization#GeometricRealizationIsLeftExact"} there
          %h4#cubes_as_simplicial_sets Cubes as simplicial sets
          %p
            Define a monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo □
                    %mi δ
                  %mo :
                  %mi Cube
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Box_{\delta}: Cube \to Set^{\Delta^{op}}
            as follows: regard the category of simplicial sets as a cartesian monoidal category equipped with the representable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom(-, [1])
            as an interval (with two face maps from and a projection to the terminal object
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} hom(-, [0])
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cube
                  %annotation{:encoding => "application/x-tex"} Cube
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo □
                    %mi δ
                  %mo :
                  %mi Cube
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Box_{\delta}: Cube \to Set^{\Delta^{op}}
          %h4#triangulating_geometric_cubes Triangulating geometric cubes
          %p
            Next, because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo →
                  %mi Top
                %annotation{:encoding => "application/x-tex"} R: Set^{\Delta^{op}} \to Top
            is preserves cartesian products and preserves the interval objects, we have an isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo □
                  %mo :
                  %mi Cube
                  %mo →
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi Cube
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo □
                        %mi δ
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mover
                    %mo →
                    %mi R
                  %mi Top
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Box: Cube \to Top) \cong (Cube \stackrel{\Box_\delta}{\to} Set^{\Delta^{op}} \stackrel{R}{\to} Top) \qquad (2)
          %p
            by the universal property of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cube
                  %annotation{:encoding => "application/x-tex"} Cube
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo □
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mo ∫
                    %mi n
                  %msub
                    %mo □
                    %mrow
                      %mi δ
                      %mi m
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Box(m) \cong \int^n \Box_{\delta m}(n) \cdot \sigma(n)
          %h4#standard_triangulation_of_a_cubulated_space Standard triangulation of a cubulated space
          %p
            Given a cubulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi h
                  %mo :
                  %msub
                    %mi R
                    %mi cub
                  %mi X
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, h: R_{cub} X \to Y)
            of a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi m
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo □
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi m
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∫
                            %mi n
                          %msub
                            %mo □
                            %mrow
                              %mi δ
                              %mi m
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi triangulation
                          %mi of
                          %mo □
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                        %mtd
                          %msup
                            %mo ∫
                            %mi n
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∫
                            %mi m
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi m
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mo □
                            %mrow
                              %mi δ
                              %mi m
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %mi interchange
                          %mi of
                          %mi coends
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y &amp; \cong &amp; \int^m C(m) \cdot \Box(m) &amp; &amp; \\
                  \&amp; \cong &amp; \int^m C(m) \cdot (\int^n \Box_{\delta m}(n) \cdot \sigma(n)) &amp; &amp; triangulation of \Box(m) \\
                  \&amp; \cong &amp; \int^n (\int^m C(m) \cdot \Box_{\delta m}(n)) \cdot \sigma(n) &amp; &amp; interchange of coends
                  }
          %p
            where in the last line we used the
            = succeed "." do
              %a{:href => "end#Fubini"} coend Fubini theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mo ∫
                    %mi m
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msub
                    %mo □
                    %mrow
                      %mi δ
                      %mi m
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(n) = \int^m C(m) \cdot \Box_{\delta m}(n)
          %p
            we have a homeomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ≅
                    %msup
                      %mo ∫
                      %mi n
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi R
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \cong \int^n X(n) \cdot \sigma(n) = R X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
