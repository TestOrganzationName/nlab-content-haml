          #GrothendieckTopologyFromLocalEpimorphisms.num_defn
            %h6#definition_4 Definition
            %p
              %strong (Grothendieck topology from local epimorphisms)
            %p
              Conversely, assume a system of local epimorphisms as in Def.
              %a.maruku-ref{:href => "#SystemOfLocalEpimorphisms"}
              is given.
            %p
              Declare a
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              to be a
              %a.existingWikiWord{:href => "/nlab/show/covering+sieve"} covering sieve
              precisely if the inclusion morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↪
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F \hookrightarrow U
              is a local epimorphism. Then this defines a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              encoded by the collection of local epimorphisms.
          %h3#relation_to_simplicial_presheaves Relation to simplicial presheaves
          #CechNerveProjectionOfLocalEpimorphismIsLocalWeakEquivalence.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                of
                %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/local+weak+equivalence"} local weak equivalence
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi f
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    A \overset{f}{\longrightarrow} B
                    \\;\colon\;
                    [\mathcal{S}^{op}, Set]
            %p
              be a local epimorphism (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalEpimorphismFromGrothendieckTopology"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    C(f) \longrightarrow B
                    \\;\;\;\;
                    \\in [\mathcal{S}^{op}, sSet]
            %p
              out of the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi A
                          %msub
                            %mo ×
                            %mi B
                          %mi ⋯
                          %msub
                            %mo ×
                            %mi B
                          %mi A
                        %mo ⏟
                      %mrow
                        %mi k
                        %mspace{:width => "thickmathspace"}
                        %mtext factors
                  %annotation{:encoding => "application/x-tex"}
                    C(f)_k \;\coloneqq\;
                    \\underset{
                    k \; \text{factors}
                    }{
                    \\underbrace{
                    A \times_B \cdots \times_B A
                    }}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in the projective local
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒮
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [\mathcal{S}^{op}, sSet_{Qu}]_{proj,loc}
          %p
