          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with two
            %a.existingWikiWord{:href => "/nlab/show/model+structures"} model structures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 1
                  %mo ,
                  %msub
                    %mi F
                    %mn 1
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C_1,F_1,W)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 2
                  %mo ,
                  %msub
                    %mi F
                    %mn 2
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C_2,F_2,W)
            having the same class of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            be a
            %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊆
                    %mi L
                    %mo ⊆
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_1 \subseteq L \subseteq C_2
          %p
            The following theorem is essentially due to
            = succeed "." do
              %a{:href => "#Jardine"} Jardine
          #IMS.num_theorem
            %h6#theorem Theorem
            %p
              There is a (necessarily unique)
              %strong intermediate model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,F_i,W)
              with the same weak equivalences and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              as the cofibrations.
          .proof
            %h6#proof Proof
            %p
              Define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_i
              to be the class of morphisms having the right lifting property with respect to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∩
                      %mi W
                    %annotation{:encoding => "application/x-tex"} L\cap W
            %ul
              %li
                The assumption
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                      %mo ⊆
                      %mi L
                      %mo ⊆
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_1 \subseteq L \subseteq C_2
                implies
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mo ∩
                        %mi W
                        %mo ⊆
                        %mi R
                        %mo ⊆
                        %msub
                          %mi F
                          %mn 2
                        %mo ∩
                        %mi W
                      %annotation{:encoding => "application/x-tex"} F_2 \cap W \subseteq R \subseteq F_2\cap W
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ⊆
                        %mi W
                      %annotation{:encoding => "application/x-tex"} R\subseteq W
              %li
                We also have
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 1
                        %mo ∩
                        %mi W
                        %mo ⊆
                        %mi L
                        %mo ∩
                        %mi W
                        %mo ⊆
                        %msub
                          %mi C
                          %mn 2
                        %mo ∩
                        %mi W
                      %annotation{:encoding => "application/x-tex"} C_1\cap W \subseteq L\cap W \subseteq C_2\cap W
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mo ⊆
                        %msub
                          %mi F
                          %mi i
                        %mo ⊆
                        %msub
                          %mi F
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} F_2 \subseteq F_i \subseteq F_1
              %li
                Finally,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∩
                      %mi W
                      %mo ⊆
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L\cap W\subseteq L
                implies
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ⊆
                        %msub
                          %mi F
                          %mi i
                      %annotation{:encoding => "application/x-tex"} R\subseteq F_i
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ⊆
                        %msub
                          %mi F
                          %mi i
                        %mo ∩
                        %mi W
                      %annotation{:encoding => "application/x-tex"} R\subseteq F_i \cap W
            %p
              Now one of the weak factorization systems in the desired model structure is just
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ∩
                      %mi W
                      %mo ,
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L\cap W, F_i)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi i
                  %annotation{:encoding => "application/x-tex"} p i
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p\in F_2
              (hence also
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p\in F_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi C
                        %mn 2
                      %mo ∩
                      %mi W
                    %annotation{:encoding => "application/x-tex"} i\in C_2\cap W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi j
                  %annotation{:encoding => "application/x-tex"} q j
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} j\in L
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi R
                    %annotation{:encoding => "application/x-tex"} q\in R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %msub
                        %mi F
                        %mi i
                      %mo ∩
                      %mi W
                    %annotation{:encoding => "application/x-tex"} q\in F_i \cap W
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∈
                      %mi W
                    %annotation{:encoding => "application/x-tex"} j\in W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mi j
                  %annotation{:encoding => "application/x-tex"} f = (p q) j
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi L
                    %mo ∩
                    %mi W
                  %annotation{:encoding => "application/x-tex"} j\in L\cap W
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                      %mo ∈
                      %msub
                        %mi F
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p q\in F_i
            %p
              It remains only to show that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi i
                      %mo ∩
                      %mi W
                      %mo ⊆
                      %mi R
                    %annotation{:encoding => "application/x-tex"} F_i \cap W \subseteq R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msub
                        %mi F
                        %mi i
                      %mo ∩
                      %mi W
                    %annotation{:encoding => "application/x-tex"} f\in F_i \cap W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi i
                  %annotation{:encoding => "application/x-tex"} p i
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} p\in R
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi L
                    %annotation{:encoding => "application/x-tex"} i\in L
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi W
                    %annotation{:encoding => "application/x-tex"} p\in W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi L
                    %mo ∩
                    %mi W
                  %annotation{:encoding => "application/x-tex"} i\in L\cap W
              as well. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has the right lifting property with respect to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p We also have:
          #CofGen.num_theorem
            %h6#theorem_2 Theorem
            %p
              If in the above situation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              and either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %msub
                      %mi F
                      %mn 1
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_1,F_1,W)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %msub
                      %mi F
                      %mn 2
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_2,F_2,W)
              is
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              (hence
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
              is cofibrantly generated, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,F_i,W)
              is also combinatorial.
          .proof
            %h6#proof_2 Proof
            %p
              The assumption about
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 1
                    %mo ,
                    %msub
                      %mi F
                      %mn 1
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_1,F_1,W)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 2
                    %mo ,
                    %msub
                      %mi F
                      %mn 2
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_2,F_2,W)
              ensures that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Arr
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Arr_W(C)
              is an accessibly embedded accessible full subcategory of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Arr
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Arr(C)
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
              are automatically satisfied because we already know that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,F_i,W)
              is a model category.
          %h2#examples Examples
          %h3#model_structures_on_diagram_categories Model structures on diagram categories
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a small category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi C
                %annotation{:encoding => "application/x-tex"} M^C
            has a
            %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi proj
                  %mo ,
                  %msub
                    %mi F
                    %mi proj
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C_{proj},F_{proj},W)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi proj
                %annotation{:encoding => "application/x-tex"} F_{proj}
            the objectwise fibrations, and an
            %a.existingWikiWord{:href => "/nlab/show/injective+model+structure"} injective model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi inj
                  %mo ,
                  %msub
                    %mi F
                    %mi inj
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C_{inj},F_{inj},W)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi inj
                %annotation{:encoding => "application/x-tex"} C_{inj}
            the objectwise cofibrations, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            in both cases the objectwise weak equivalences.
          %p
            Thus, from any weak factorization system
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,R)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi M
                    %mi C
                %annotation{:encoding => "application/x-tex"} M^C
            in which (1) every
            = succeed "-map" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "-map" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ,
                  %msub
                    %mi F
                    %mi i
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (L,F_i,W)
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mi C
                  %annotation{:encoding => "application/x-tex"} M^C
          %p Specific examples include:
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is a set of cofibrations in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mi C
                    %annotation{:encoding => "application/x-tex"} M^C
                containing the generating projective cofibrations, then by the small object argument it generates a weak factorization system
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,R)
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi proj
                        %mo ⊆
                        %mi L
                        %mo ⊆
                        %msub
                          %mi C
                          %mi inj
                      %annotation{:encoding => "application/x-tex"} C_{proj} \subseteq L \subseteq C_{inj}
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
                (or a
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+category"} generalized Reedy category
            %li
              %p
                By the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+small+object+argument"} algebraic small object argument
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+systems"} algebraic weak factorization systems
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mi C
                    %annotation{:encoding => "application/x-tex"} M^C
                to which the theorem and its dual can be applied.
