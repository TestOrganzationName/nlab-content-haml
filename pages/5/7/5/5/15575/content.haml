          %title Intermediate model structures
          %h1#intermediate_model_structures Intermediate model structures
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %ul
                %li
                  %a{:href => "#model_structures_on_diagram_categories"} Model structures on diagram categories
              %li
