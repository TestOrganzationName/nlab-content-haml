            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi i
                  %mo :
                  %msub
                    %mi X
                    %mi i
                  %mo →
                  %msub
                    %mi Y
                    %mi i
                %annotation{:encoding => "application/x-tex"} e_i:X_i\to Y_i
            be
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi i
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %msub
                              %mi id
                              %mrow
                                %msub
                                  %mi X
                                  %mi i
                          %mtd
                            %mi i
                            %mo ∈
                            %mi F
                            %mo ;
                        %mtr
                          %mtd
                            %msub
                              %mi del
                              %mrow
                                %msub
                                  %mi X
                                  %mi i
                          %mtd
                            %mi i
                            %mo ∉
                            %mi F
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  e_i = \begin{cases}
                  id_{X_i} &amp; i\in F ; \\
                  del_{X_i} &amp; i\notin F.
                  \\end{cases}
          %p
