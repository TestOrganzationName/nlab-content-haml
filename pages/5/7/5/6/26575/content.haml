          %h2#idea Idea
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with all
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "." do
              %em infinite products
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
          %p
            In measure-theoretic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kolmogorov%27s+extension+theorem"} Kolmogorov's extension theorem
          %ul
            %li
              In a category with products, an infinite product can be expressed as a
              %a.existingWikiWord{:href => "/nlab/show/cofiltered+limit"} cofiltered limit
              of finite products.
            %li
              Similarly, one can define an
              %em infinitary tensor product
              as a cofiltered limit, if it exists, of finite
              %em tensor
              products
              %em .
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⊗
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\otimes,I)
            be a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            equipped with a distinguished map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi del
                    %mi X
                  %mo :
                  %mi X
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} del_X:X\to I
            for each object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+category"} semicartesian
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov or copy-discard structure
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be a possibly infinite set, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi J
                %annotation{:encoding => "application/x-tex"} (X_i)_{i\in J}
            be a
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            For every finite subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi J
                  %annotation{:encoding => "application/x-tex"} F\subseteq J
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⨂
                    %mrow
                      %mi i
                      %mo ∈
                      %mi F
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"}
                  \\bigotimes_{i\in F} X_i
          %p
            the tensor product of the family
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi F
                  %annotation{:encoding => "application/x-tex"} (X_i)_{i\in F}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is not ordered, but the ordering of the terms in the tensor product does not matter up to coherent isomorphism, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is symmetric monoidal.)
          %p
            Consider now finite subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊆
                  %mi G
                %annotation{:encoding => "application/x-tex"} F\subseteq G
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
