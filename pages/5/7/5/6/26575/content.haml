            defined as follows. First of all, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} i\in G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mi i
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi i
                          %mtd
                            %mi i
                            %mo ∈
                            %mi F
                            %mo ;
                        %mtr
                          %mtd
                            %mi I
                          %mtd
                            %mi i
                            %mo ∉
                            %mi F
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  Y_i = \begin{cases}
                  X_i &amp; i\in F ; \\
                  I &amp; i\notin F.
                  \\end{cases}
          %p
