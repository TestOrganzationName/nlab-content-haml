                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒳
                    %annotation{:encoding => "application/x-tex"} \mathcal{X}
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 7.2.2.11 (1)
          %p
            The inverse to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo :
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PointedConnected
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} : Grp(\mathcal{X}) \to PointedConnected(\mathcal{X})
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Grp(\mathcal{X})
            we call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
