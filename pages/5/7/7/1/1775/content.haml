              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                  %annotation{:encoding => "application/x-tex"} \Delta_{/K}
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+simplices"} category of simplices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in \mathcal{C}^{\Delta^{op}}
              a simplicial object, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Δ
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi K
                      %mi op
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                    %mover
                      %mo →
                      %mi X
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    X[K] \colon \Delta^{op}_{/K} \to \Delta^{op} \stackrel{X}{\to} \mathcal{C}
            %p
              for the precomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              with the canonical projection. Moreover, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munder
                      %mi lim
                      %mo ←
                    %mi X
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    X(K) \coloneqq \underset{\leftarrow}{\lim} X[K]
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              over this composite
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (if it exists). (Notice: square brackets for the composite functor, round brackets for its
              = succeed "-limit.)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          #EquivalenceOfConeCategoriesAndLimits.num_remark
            %h6#remark_4 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %msup
                      %mi 𝒞
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in \mathcal{C}^{\Delta^{op}}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K \to K'
              the following are equivalent
            %ol
              %li
                %p
                  the induced morphism of cone
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo{:stretchy => "false"} ]
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo ′
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{X[K]} \to \mathcal{C}_{X[K']}
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              %li
                %p
                  the induced morphism of
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi K
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(K) \to X(K')
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          %p
            (The first perspective is used in (
            %a{:href => "#Lurie"}> Lurie
            ), the second in (
            %a{:href => "#Lurie2"}> Lurie2
            ).)
          .proof
            %h6#proof Proof
            %p
              In one direction: the limit is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object+in+an+%28%E2%88%9E%2C1%29-category"} terminal object
              in the cone category, and so is preserved by equivalences of cone categories. (This direction appears as (
              %a{:href => "#Lurie"}> Lurie, prop. 4.1.1.8
              )). Conversely, the limits is the object representing cones, and hence an equivalence of limits induces an equivalence of cone categories.
          #EquivalentCharacterizationsViaSlicesAndPowering.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a groupoid object if the following equivalent conditions hold.
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo →
                        %mi K
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} K \to K'
                  is a morphism in
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  which is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                  on
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                  %a.existingWikiWord{:href => "/nlab/show/slice-%28%E2%88%9E%2C1%29-categories"} slice-(∞,1)-categories
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo{:stretchy => "false"} ]
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} [
                            %mi K
                            %mo ′
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{C}_{/X[K]}
                        \\to
                        \\mathcal{C}_{/X[K']}
                %p
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
                  (a
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                  in the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              %li
                %p
                  For every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 2
                      %annotation{:encoding => "application/x-tex"} n \geq 2
                  and every
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                          %mo ≤
                          %mi i
                          %mo ≤
                          %mi n
                        %annotation{:encoding => "application/x-tex"} 0 \leq i \leq n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Δ
                              %mi n
                            %mo{:stretchy => "false"} ]
                        %mo →
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi Λ
                              %mi i
                              %mi n
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X[\Delta^n]} \to \mathcal{C}_{/X[\Lambda^n_i]}
                  is an weak equivalence in the
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
              %li
                %p (…)
            %p
              Using remark
              %a.maruku-ref{:href => "#EquivalenceOfConeCategoriesAndLimits"}
              this means equivalently that the simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is a groupoid precisely if the following
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  satisfies the ordinary
                  %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
                  and the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Λ
                          %mn 0
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(\Delta^2) \to X(\Lambda^2_0)
                  is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              %li
                %p (…)
          %p
            The first items appear as (
            %a{:href => "#Lurie"}> Lurie, prop. 6.1.2.6
            ). The second ones appear in the proofs of (
            %a{:href => "#Lurie2"}> Lurie2, prop. 1.1.8, lemma 1.2.25
            ).
          %h3#the_category_of_groupoid_objects
            The
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28%E2%88%9E%2C1%29-category"} reflective sub-(∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Grpd(C)
                    \\stackrel{\overset{}{\leftarrow}}{\hookrightarrow}
                    Func(\Delta^{op}, C)
                    \\,.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 6.1.2.9
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} C = \mathbf{H}
              in an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-semitopos"} (∞,1)-semitopos
              there is a natural
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi I
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi eff
                  %annotation{:encoding => "application/x-tex"}
                    Grpd(\mathbf{H})
                    \\simeq
                    (\mathbf{H}^I)_{eff}
            %p
              between the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              (the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor+%28%E2%88%9E%2C1%29-category"} (∞,1)-functor (∞,1)-category
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func(\Delta[1], \mathbf{H})
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphisms
          %p
            This appears below
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. 6.2.3.5
          %h3#cech_nerves Cech nerves
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            for the augmented
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            (including the object
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1]
          .num_prop
            %h6#proposition_4 Proposition
            %p
              An augmented simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A^+ : \Delta_a^{op} \to C
              is the right
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              of its restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ←
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi A
                                  %mo +
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mo ≤
                                    %mn 0
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi A
                                    %mo +
                        %mtr
                          %mtd
                            %msubsup
                              %mi Δ
                              %mi a
                              %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{[-1] \leftarrow [0]\} &amp;\stackrel{A^+|_{\leq 0}}{\to}&amp; C
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{A^+}}
                    \\\
                    \\Delta_a^{op}
                    }
            %p
              precisley if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo +
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} A^+|_{\geq 0}
              is a groupoid object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_1 &amp;\to&amp; A_0
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    A_0 &amp;\to&amp; A_{-1}
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is called the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 0
                  %mo →
                  %msub
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} A_0 \to A_{-1}
            if the equivalent conditions of this proposition are satisfied.
          %h3#Effective Effective quotients
          .num_prop
            %h6#proposition_5 Proposition
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                  %annotation{:encoding => "application/x-tex"} C =
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              every groupoid object is an effective quotient, def.
              = succeed "." do
                %a.maruku-ref{:href => "#EffectiveGroupoid"}
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, below remark 6.1.2.15
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. 6.1.3.20
          %p
            More generally, this is true for every
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          .num_prop
            %h6#proposition_6 Proposition
            %p
              In
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an effective quotient, def.
              = succeed "." do
                %a.maruku-ref{:href => "#EffectiveGroupoid"}
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 6.1.0.6 (4) iv)
          %h3#Delooping Delooping
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                %annotation{:encoding => "application/x-tex"} \mathcal{X}
            an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : * \to X
            a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            object in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                  %mo :
                  %mo =
                  %mo *
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi X
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\Omega_x X := {*} \prod_{X} {*}
          %p hence the object universally filling the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi x
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo →
                            %mi x
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Omega_x X &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{x}}
                  \\\
                  * &amp;\stackrel{x}{\to}&amp; X
                  }
                  \\,.
          %p
            Since this is the beginning of the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} * \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi x
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Omega_x X
            is naturally equipped with the structure of an
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              objects constitutes an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo :
                    %mi PointedConnected
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega : PointedConnected(\mathcal{X}) \stackrel{\simeq}{\to}
                    Grp(\mathcal{X})
            %p
              from the full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} under-(∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo{:stretchy => "false"} /
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} */\mathcal{X}
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              %a.existingWikiWord{:href => "/nlab/show/0-connected"} 0-connected
              (hence those that have an essentially unique point) with the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
