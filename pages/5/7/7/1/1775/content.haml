                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          %h2#examples Examples
          %h3#group_objects_in_an_topos
            Group objects in an
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
