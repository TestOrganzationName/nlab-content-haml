                  \\,.
          %p The Quillen equivalence itself is in section 6 there.
          .num_prop
            %h6#proposition_8 Proposition
            %p
              There exists the
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              on the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sGrp
                  %annotation{:encoding => "application/x-tex"} sGrp
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi sGrp
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    U : sGrp \to sSet_{Quillen}
            %p
              to the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %p
              This means that a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sGrp
                  %annotation{:encoding => "application/x-tex"} sGrp
              is a
            %ul
              %li
                %p weak equivalences
              %li
                %p or fibration
            %p
              precisely if it is so in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
          %p
            This appears as (
            %a{:href => "GoerssJardine"}> GoerssJardine, ch V, theorem. 2.3
            ).
          .num_prop
            %h6#proposition_9 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} sSet_0
              (
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              with a single vertex) whose
            %ul
              %li
                %p weak equivalences
              %li
                %p and cofibrations
            %p
              are those in the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          %p
            This appears as (
            %a{:href => "GoerssJardine"}> GoerssJardine, ch V, prop. 6.2
            ).
          .num_prop
            %h6#proposition_10 Proposition
            %p
              The simplicial loop space functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and the delooping functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar W(-)
              (discussed at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ⊣
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi sGr
                    %mover
                      %munder
                        %mo →
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                      %mover
                        %mo ←
                        %mi G
                    %msub
                      %mi sSet
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (G \dashv \bar W) : sGr \stackrel{\overset{G}{\leftarrow}}{\underset{\bar W}{\to}}
                    sSet_0
                    \\,.
            %p
              The
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ⊣
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G \dashv \bar W)
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              and counit are weak equivalences:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \stackrel{\simeq}{\to} \bar W G X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                    %mover
                      %mo →
                      %mo ≃
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G \bar W G \stackrel{\simeq}{\to} G
                    \\,.
          %p
            This appears as (
            %a{:href => "#GoerssJardine"}> GoerssJardine, ch. V prop. 6.3
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/groupoid+object"}> groupoid object
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
                %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoid"} simplicial groupoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/groupoid+objects+in+an+%28%E2%88%9E%2C1%29-topos+are+effective"} groupoid objects in an (∞,1)-topos are effective
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/monoid"}> monoid
                \.
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
                %a.existingWikiWord{:href => "/nlab/show/monoid+object+in+an+%28%E2%88%9E%2C1%29-category"} monoid object in an (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group"}> group
                ,
                %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ring"}> ring
                ,
                %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
          %h2#references References
          %p
            Groupoid objects in
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            A standard textbook reference on
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            is
          %ul
            %li#GoerssJardine
              %a.existingWikiWord{:href => "/nlab/show/Paul+Goerss"}> Paul Goerss
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rick+Jardine"} Rick Jardine
              %em
                %a.existingWikiWord{:href => "/nlab/show/Simplicial+homotopy+theory"} Simplicial homotopy theory
              = succeed "." do
                %a{:href => "http://www.maths.abdn.ac.uk/~bensondj/papers/g/goerss-jardine/ch-5.dvi"} chapter V
          %p
            Discussion from the point of view of
            %a.existingWikiWord{:href => "/nlab/show/category+objects+in+an+%28%E2%88%9E%2C1%29-category"} category objects in an (∞,1)-category
            is in
          %ul
            %li#Lurie2
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-Categories+and+the+Goodwillie+Calculus"} (∞,2)-Categories and the Goodwillie Calculus
              (
