              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Geometric+Orbifold+Cohomology"} Geometric Orbifold Cohomology
          %h3#in_string_theory In string theory
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactified
            (and
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/wrapped+brane"} wrapped
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spindle+orbifolds"} spindle orbifolds
          %ul
