          %h2#idea Idea
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/coprime"} coprime
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mo +
                    %mo ,
                    %msub
                      %mi n
                      %mo −
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} n_+, n_- \in \mathbb{N}_{\geq 1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi qcd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mo +
                    %mo ,
                    %msub
                      %mi n
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} qcd(n_+, n_-) = 1
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mo +
                    %mo ,
                    %msub
                      %mi n
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n_+, n_-)
              \-spindle
            is the 2-
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            whose
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            coarse
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            is the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
            %a.existingWikiWord{:href => "/nlab/show/poles"} poles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo ∈
                  %mi ℂ
                  %msup
                    %mi P
                    %mn 1
                %annotation{:encoding => "application/x-tex"} 0, \infty \in \mathbb{C}P^1
            are
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            tips of order
