                          %mi X
                    %msup
                      %mi Z
                      %mi X
                    %mo ×
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ev
                          %mrow
                            %mi X
                            %mo ,
                            %mi Z
                    %mi Z
                    %mo{:stretchy => "false"} )
