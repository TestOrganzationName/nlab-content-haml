                  \&amp;=&amp;  \int_{y\in \mathcal{C}} \mathcal{D}\left(H(y), G(y)^{F(y)}\right)\\
                  \&amp;=&amp;  \int_{y\in \mathcal{C}} \mathcal{D}\left(H(y)\times F(y), G(y)\right)\\
                  \&amp;=&amp; \mathcal{D}^{\mathcal{C}}(H\times F, G).
