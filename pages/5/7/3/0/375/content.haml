                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                    %mo :
                    %msup
                      %mi Z
                      %mi Y
                    %mo ×
                    %msup
                      %mi Y
                      %mi X
                    %mo →
                    %msup
                      %mi Z
                      %mi X
                  %annotation{:encoding => "application/x-tex"} c_{X, Y, Z}: Z^Y \times Y^X \to Z^X
              is the unique map such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
