          .proof
            %h6#proof_sketch Proof (sketch)
            %p
              On objects,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde{F}(a) = F(a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f \colon a \to b
              be a map of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} C[c]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %mo ×
                    %mi a
                    %mo →
                    %mi b
                  %annotation{:encoding => "application/x-tex"} g \colon c \times a \to b
              be the corresponding map in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde{F}(f)
              to be the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mn 1
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi t
                        %mo ×
                        %mn 1
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ×
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(a) \cong 1 \times F(a) \stackrel{t \times 1}{\to} F(c) \times F(a) \cong F(c \times a) \stackrel{F(g)}{\to} F(b)
            %p
              It is straightforward to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{F}
              is a cartesian closed functor and is, up to isomorphism, the unique cartesian closed functor taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
