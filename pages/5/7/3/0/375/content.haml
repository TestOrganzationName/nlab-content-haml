                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} ]
