          %h2#idea Idea
          %p
            An
            %em invariant set
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            which is
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under a given
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            or a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            (or a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m\in M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            again by
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} m:X\to X
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is called
            %strong
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            if and only if for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m\in M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                  %annotation{:encoding => "application/x-tex"} m^{-1}(S)=S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x\in X
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} x\in S
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} m(x)\in S
          %p
            Note that the
            %em
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            (“points”) of an invariant set need not themselves be
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h3#variations_of_the_definition Variations of the definition
          %p
            Since the original definition was given for the case of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} S\subseteq X
            %em invariant
            if and only if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi S
                  %annotation{:encoding => "application/x-tex"} m^{-1}(S)\subseteq S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x\in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} m(x)\in S
            as well. (Without requiring that if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} m(x)\in S
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x\in S
            %em absorbing set
            instead. (But that term may itself be used for other concepts, to make matters even worse.)
          %p
            Also, in different categories than
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %ul
            %li
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              action, one is often interested in invariant
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/closed+sets"} closed sets
            %li
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/measurable+sets"} measurable sets
            %li
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/submanifolds"} submanifolds
          %p …and so on.
          %h2#examples Examples
          %ul
            %li
              %p
                Each
                %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
                of a
                %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
                is an invariant set. Moreover, a set is invariant if and only if it is a (possibly empty) union of orbits.
            %li
              %p
                In
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
                %a.existingWikiWord{:href => "/nlab/show/exchangeable+event"} exchangeable event
                is a
                %a.existingWikiWord{:href => "/nlab/show/measurable+subset"} measurable subset
                which is invariant under finite
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
                %a.existingWikiWord{:href => "/nlab/show/tail+event"} tail event
                is invariant under
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/shifts"} shifts
          %h2#invariant_sigmaalgebras Invariant sigma-algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measurable+set"} measurable set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            (or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            via measurable functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} m:X\to X
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/measurable+subset"} measurable subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} A\subseteq X
            is called
            %strong invariant
            if and only if for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m\in M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi m
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi A
                  %annotation{:encoding => "application/x-tex"} m^{-1}(A)=A
          %p
            Invariant sets form naturally a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"} sigma-algebra
            = succeed "." do
              %strong invariant sigma-algebra
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/exchangeable+sigma-algebra"} exchangeable sigma-algebra
            is an example of this. (Sometimes one uses the almost sure version, see
            = succeed ".)" do
              %a{:href => "#almost_surely_invariant_sets"} below
          %p
            The invariant sigma-algebra gives a
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            of the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in the
            %a.existingWikiWord{:href => "/nlab/show/Stoch"} category of Markov kernels
            (
            %a{:href => "#markov_ergodic"}> MP’23
            ). More precisely, denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi inv
                %annotation{:encoding => "application/x-tex"} X_inv
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with the invariant sigma-algebra, and denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mi X
                  %mo →
                  %msub
                    %mi X
                    %mi inv
                %annotation{:encoding => "application/x-tex"} q:X\to X_inv
            the kernel
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#kernels_from_deterministic_functions"} induced by
            the set-theoretic identity. Then the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi inv
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_inv,q)
            forms a universal
            %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            (i.e.
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} k:X\to Y
            satisfying
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∘
                    %mi m
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k\circ m=k
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %msub
                    %mi X
                    %mi inv
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} u:X_inv\to Y
            making the following diagram commute,
