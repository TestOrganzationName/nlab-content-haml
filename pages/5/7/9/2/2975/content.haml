            represented by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi MGL
                      %mi S
                  %annotation{:encoding => "application/x-tex"} MGL_S
          %p … formula here …
          %h2#properties Properties
          %h3#the_2nngraded_part The (2n,n)-graded part
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S = Spec(k)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a field of characteristic zero. A geometric description of the
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2n,n)
            %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"} Marc Levine
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
            %a{:href => "#LevineMorel"} Levine-Morel
            constructed the universal
            %em oriented cohomology theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo *
                    %mo :
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Sm
                      %mi k
                    %mo →
                    %msup
                      %mi CRing
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Omega^* : \Sm_k \to CRing^*
            %em oriented
            signifies the existence of
            %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            or
            %a.existingWikiWord{:href => "/nlab/show/Gysin+homomorphisms"} Gysin homomorphisms
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+morphisms+of+schemes"} proper morphisms of schemes
            %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong>
                (
                %a{:href => "#LevineMorel"}> Levine-Morel
                )
              \. There is a canonical isomorphism of graded rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo *
                    %mover
                      %mo ⟶
                      %mo ∼
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Spec
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}^* \stackrel{\sim}{\longrightarrow} \Omega^*(\Spec(k))
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}^*
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              with an appropriate grading.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong>
                (
                %a{:href => "#LevineMorel"}> Levine-Morel
                )
              \. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi Z
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i : Z \hookrightarrow X
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+immersion"} closed immersion
              of smooth
              = succeed "-schemes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi U
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j : U \hookrightarrow X
              the complementary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+immersion"} open immersion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mo *
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi d
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi i
                          %mo *
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi j
                          %mo *
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \Omega^{*-d}(Z) \stackrel{i_*}{\to} \Omega^*(X) \stackrel{j^*}{\to} \Omega^*(U) \to 0,
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo =
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} codim
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d = \codim(Z, X)
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong>
                (
                %a{:href => "#LevineMorel"}> Levine-Morel
                )
              \. Given an embedding
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ↪
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} k \hookrightarrow \mathbf{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi MU
                      %mrow
                        %mn 2
                        %mo *
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^*(k) \longrightarrow MU^{2*}(pt)
            %p is invertible.
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              %strong>
                (
                %a{:href => "#Levine2008"}> Levine 2008
                )
              \. The canonical homomorphisms of graded rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi MGL
                      %mrow
                        %mn 2
                        %mo *
                        %mo ,
                        %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^*(X) \longrightarrow MGL^{2*,*}(X)
            %p
              are invertible for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Sm
                        %mi k
                    %annotation{:encoding => "application/x-tex"} X \in \Sm_k
          %h2#related_concepts Related concepts
          %ul
            %li
