              %a{:href => "/nlab/new/generalized+motivic+cohomology+theory"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi MGL
                    %mi S
