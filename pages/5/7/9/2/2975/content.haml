                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} MU^*[u_2,u_2^{-1}]
            where
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            is the (topological)
            %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology"} complex cobordism cohomology
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mn 2
                %annotation{:encoding => "application/x-tex"} u_2
            is the periodicity element.
          %p
            Then Snaith introduces a variant of such constructions with a more general ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            replacing the complex numbers; and uses the Quillen’s description of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            of a ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in terms of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B GL(A)
          %p
            Later,
            %a{:href => "#GepnerSnaith08"} Gepner-Snaith 08
            returned to the question of algebraic cobordism this time using the motivic version of algebraic cobordism of Voevodsky, namely the
            %a.existingWikiWord{:href => "/nlab/show/motivic+spectrum"} motivic spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi GL
                %annotation{:encoding => "application/x-tex"} M GL
            representing universal oriented motivic cohomology theory (which is different from Morel-Voevodsky algebraic cobordism), and to the motivic version of
            %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+isomorphism"} Conner-Floyd isomorphism
            for which they give a comparably short proof.
          %h3#morellevines_construction Morel-Levine’s construction
          %ul
            %li#LevineMorel01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
                = succeed "," do
                  %em Cobordisme algébrique I
                = succeed ");" do
                  %a{:href => "http://dx.doi.org/10.1016/S0764-4442(01)01833-X"} doi:10.1016/S0764-4442(01)01833-X
                = succeed "," do
                  %em Cobordisme algébrique II
                = succeed ")." do
                  %a{:href => "http://dx.doi.org/10.1016/S0764-4442(01)01832-8"} doi:10.1016/S0764-4442(01)01832-8
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %em Algebraic cobordism
                %a{:href => "http://arxiv.org/abs/math/0304206"} math.KT/0304206
            %li#LevineMorel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
                = succeed "," do
                  %em Algebraic cobordism
                = succeed "." do
                  %a{:href => "https://www.uni-due.de/~bm0032/publ/AlgCobordBook4.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                %em A survey of algebraic cobordism
                (
                %a{:href => "http://www.uni-due.de/~bm0032/publ/SurveyAlgCobord.pdf&#8206;"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %em Three lectures on algebraic cobordism
                = succeed "," do
                  %a{:href => "http://www.uni-due.de/~bm0032/publ/CobordismLec1LS.pdf"} Lecture I
                = succeed "," do
                  %a{:href => "http://www.uni-due.de/~bm0032/publ/CobordismLec2LS.pdf"} Lecture II
                = succeed "." do
                  %a{:href => "http://www.uni-due.de/~bm0032/publ/CobordismLec4LS.pdf"} Lecture III
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
                %a.existingWikiWord{:href => "/nlab/show/Oberwolfach"} Oberwolfach
                Arbeitsgemeinschaft mit aktuellem Thema, April 2005
                = succeed "," do
                  %a{:href => "http://www.ems-ph.org/journals/show_abstract.php?issn=1660-8933&vol=2&iss=2&rank=2"} report
                %a{:href => "http://www.ems-ph.org/journals/show_pdf.php?issn=1660-8933&vol=2&iss=2&rank=2"} notes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ivan+Panin"}> Ivan Panin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Konstantin+Pimenov"} Konstantin Pimenov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+R%C3%B6ndigs"} Oliver Röndigs
                = succeed "," do
                  %em A universality theorem for Voevodsky’s algebraic cobordism spectrum
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0709.4116"} arXiv:0709.4116
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ivan+Panin"}> Ivan Panin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Konstantin+Pimenov"} Konstantin Pimenov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+R%C3%B6ndigs"} Oliver Röndigs
                = succeed "," do
                  %em On the relation of Voevodsky’s algebraic cobordism to Quillen’s K-theory
                = succeed "," do
                  %a{:href => "http://citeseerx.ist.psu.edu/viewdoc/summary?doi=10.1.1.244.7301"} doi:10.1.1.244.7301
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/0709.4124"} arXiv:0709.4124
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"}> Marc Hoyois
                ,
                = succeed "," do
                  %em From algebraic cobordism to motivic cohomology
                = succeed "," do
                  %a{:href => "http://math.mit.edu/~hoyois/papers/hopkinsmorel.pdf"} pdf
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1210.7182"} arXiv
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Spitzweck"}> Markus Spitzweck
                ,
                %em Algebraic cobordism in mixed characteristic
                (
                %a{:href => "http://arxiv.org/abs/1404.2542"}> arXiv:1404.2542
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
                ,
                = succeed "," do
                  %span.newWikiWord
                    Girja Shanker Tripathi
                    %a{:href => "/nlab/new/Girja+Shanker+Tripathi"} ?
                = succeed "," do
                  %em Quotients of MGL, their slices and their geometric parts
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1501.02436"} arXiv:1501.02436
          %p
            More chat about the relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/motivic+homotopy+theory"} motivic homotopy theory
          %ul
            %li
              %em> Interdependence between A^1-homotopy theory and algebraic cobordism
              ,
              = succeed "." do
                %a{:href => "http://mathoverflow.net/questions/36659/interdependence-between-a1-homotopy-theory-and-algebraic-cobordism/36698#36698"} MO/36659
          %p A simpler construction was given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rahul+Pandharipande"} Rahul Pandharipande
              %em Algebraic cobordism revisited
              (
              %a{:href => "http://arxiv.org/abs/math/0605196"}> math.AG/0605196
              )
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Borel-Moore+homology"} Borel-Moore homology
            version of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi MGL
                    %mrow
                      %mo *
                      %mo ,
                      %mo *
                %annotation{:encoding => "application/x-tex"} MGL^{*,*}
            is considered in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
              ,
              = succeed "," do
                %em Oriented cohomology, Borel-Moore homology and algebraic cobordism
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/0807.2257"} arXiv
          %p
            The comparison with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi MGL
                    %mrow
                      %mn 2
                      %mo *
                      %mo ,
                      %mo *
                %annotation{:encoding => "application/x-tex"} MGL^{2*,*}
            is in
          %ul
            %li#Levine2008
              %a.existingWikiWord{:href => "/nlab/show/Marc+Levine"}> Marc Levine
              ,
              = succeed "," do
                %em Comparison of cobordism theories
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/0807.2238"} arXiv
          %p
            The construction was extended to
            %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"} derived schemes
            in the paper
          %ul
            %li
              Parker Lowrey,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Timo+Schuerg"} Timo Schuerg
              = succeed "," do
                %em Derived algebraic bordism
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1211.7023"} arXiv:1211.7023
          %p
            The close connection of algebraic cobordism with
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            is discussed in
          %ul
            %li
              José Luis González, Kalle Karu.
              = succeed "." do
                %em Universality of K-theory
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1301.3815"} arXiv:1301.3815
          %p An algebraic analogue of h-cobordism:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Aravind+Asok"}> Aravind Asok
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fabien+Morel"} Fabien Morel
              %em
                Smooth varieties up to
                = succeed "-homotopy" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝔸
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              (
              %a{:href => "http://arxiv.org/abs/0810.0324"}> arXiv:0810.0324
              ).
          %p
            A construction of algebraic cobordism as a non-
            %a.existingWikiWord{:href => "/nlab/show/A1-homotopy+theory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-invariant
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            on
            %a.existingWikiWord{:href => "/nlab/show/derived+schemes"} derived schemes
            and the resulting
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+isomorphism"} Conner-Floyd isomorphism
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Toni+Annala"}> Toni Annala
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Marc+Hoyois"} Marc Hoyois
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ryomei+Iwasa"} Ryomei Iwasa
              %em Algebraic cobordism and a Conner-Floyd isomorphism for algebraic K-theory
              (
              %a{:href => "https://arxiv.org/abs/2303.02051"}> arXiv:2303.02051
              ).
