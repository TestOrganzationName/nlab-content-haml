            the
            %a.existingWikiWord{:href => "/nlab/show/motivic+Thom+spectrum"} motivic Thom spectrum
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
