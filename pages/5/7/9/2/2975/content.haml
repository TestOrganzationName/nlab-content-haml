          %h2#idea Idea
          %p
            %em Algebraic cobordism
            is the bigraded
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology+theory"} generalized cohomology theory
            represented by the
            %a.existingWikiWord{:href => "/nlab/show/motivic+Thom+spectrum"} motivic Thom spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi MGL
                  %annotation{:encoding => "application/x-tex"} MGL
            %a.existingWikiWord{:href => "/nlab/show/motives"} motivic
            analogue of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+cobordism"} complex cobordism
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
