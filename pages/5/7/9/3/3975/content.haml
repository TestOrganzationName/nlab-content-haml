                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat{F}\colon F([X,Y]) \to [F(X),F(Y)]
              to be the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              under the
              %a.existingWikiWord{:href => "/nlab/show/internal-hom"} internal-hom
              adjunction of the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ⊗
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} F([X,Y]) \otimes F(X) \to F([X,Y] \otimes X) \to F(Y).
            %p
              Conversely, from a lax closed functor between closed monoidal categories we can recover a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)\otimes F(Y) \to F(X\otimes Y)
              being adjunct to the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F(X) \to F([Y,X\otimes Y]) \to [F(Y), F(X\otimes Y)]
            %p
              where the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ,
                    %mi X
                    %mo ⊗
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X\to [Y,X\otimes Y]
              is adjunct to the identity of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\otimes Y
              %a.existingWikiWord{:href => "/nlab/show/bijective"} bijective
              correspondence.
            %p
              Note, however, that for such a functor to be
              %em
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
              or
              %em strong closed
              are generally independent conditions. Since any lax (or strong) monoidal functor is automatically a lax closed functor, the term
              %strong closed monoidal functor
              is usually used to mean one which is
              %em strong
              closed (or at least for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{F}
              is an isomorphism).
          .num_example
            %h6#example_2 Example
            %p
              The same idea works more generally for closed unital
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
          .num_remark
            %h6#remark Remark
            %p However, there does not seem to be a natural notion of “colax” functor between closed categories. One could, of course, simply ask for transformations in the other direction, but such things do not seem to arise much in practice, and would not correspond to colax monoidal functors in the same way.
          .num_example
            %h6#example_3 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F\colon C\to D
              is automatically colax monoidal, and it is strong (hence also lax) monoidal iff it preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              %em strong
              closed functor, we call it a
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+functor"} locally cartesian closed functor
          .num_example
            %h6#example_4 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              in an
              %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              between
              %a.existingWikiWord{:href => "/nlab/show/toposes"} toposes
              is a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
              (see there).
          .num_example
            %h6#example_5 Example
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of functors between
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
              is a “
              %a.existingWikiWord{:href => "/nlab/show/Wirthm%C3%BCller+context"} Wirthmüller context
              of
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/six+operations"} six operations
          .num_example
            %h6#example_6 Example
            %p
              A class of examples of strong closed functors that are not strong monoidal comes from the inclusions of
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+ideals"} exponential ideals
              %a.existingWikiWord{:href => "/nlab/show/Day%27s+reflection+theorem"} Day's reflection theorem
              implies that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a closed monoidal category and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ⊆
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E\subseteq C
              is a reflective subcategory that is an exponential ideal in the monoidal sense (i.e.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x\in C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} y\in E
              imply
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} [x,y]\in E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a closed monoidal category with the induced internal-hom and a
              %em reflected
              tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ⊗
                      %mi E
                    %mi y
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo ⊗
                      %mi C
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\otimes_E y = R(x\otimes_C y)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is the reflector. Then the inclusion functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ↪
                    %mi C
                  %annotation{:encoding => "application/x-tex"} E\hookrightarrow C
              preserves internal-homs but is only lax monoidal (in contrast to its left adjoint, the reflection, which is strong monoidal). It doesn’t in general preserve the unit strongly, but there are cases when it does.
            %p
              For instance, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi P
                    %mi A
                  %annotation{:encoding => "application/x-tex"} C = P A
              be a
              %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
              with a
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              monoidal structure induced by a monoidal structure on a small category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              be the subcategory of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                    %annotation{:encoding => "application/x-tex"} \Phi
              %a.existingWikiWord{:href => "/nlab/show/continuous+functor"} continuous
              presheaves for some set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              of colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              that are preserved on both sides by the tensor product (e.g. if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is itself closed). Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a reflective exponential ideal, and contains the unit object since the latter is a
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
              (at the
              %a.existingWikiWord{:href => "/nlab/show/unit+object"} unit object
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/indexed+closed+monoidal+category"} indexed closed monoidal category
            %li
