                      %mi F
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} F_\sigma
              is
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weakly homotopy equivalent
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#FibersOfSerreFibrations"}> exmpl.
              ).
            %p This implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
