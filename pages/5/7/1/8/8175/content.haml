              unreduced
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology functor
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ReducedGeneralizedCohomologyHomotopyHomotopicalFunctor"}> def.
              ). Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi π
                    %mi B
                  %annotation{:encoding => "application/x-tex"} X \stackrel{\pi}{\to} B
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              are
              %a.existingWikiWord{:href => "/nlab/show/weakly+contractible+topological+space"} weakly contractible
              or such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
