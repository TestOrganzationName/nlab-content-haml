                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Mackey+functor"} Mackey functor
            = succeed "):" do
              %a{:href => "#Kronholm10"} Kronholm 10, theorem 3.1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
