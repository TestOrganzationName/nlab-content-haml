                    \\\
                    \&amp; \nwarrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; \underset{s,t}{\prod} A^{s+t}(X_{s}, X_{s-1})
                    }
                    \\;\;\;\;\;\;\;
                    \\left(
                    \\array{
                    A^{s+t}(X_s) &amp; \longrightarrow &amp; A^{s+t}(X_{s-1})
                    \\\
                    \\uparrow &amp;&amp; \downarrow_{\mathrlap{\delta}}
                    \\\
                    A^{s+t}(X_s, X_{s-1}) &amp;&amp; A^{s+t+1}(X_{s}, X_{s-1})
                    }
                    \\right)
                    \\,,
            %p
              where we take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo ≫
                        %mn 1
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_{\gg 1} = X
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mo &lt;
                          %mn 0
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} X_{\lt 0} = \emptyset
            %p
              In order to determine the
              = succeed "-page," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} E_2
              = succeed "-page:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
