              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-
                %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
          %p
            There is a canonical projection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ρ
                      %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \overline{\rho} \;\colon\; V// G \to \mathbf{B}G
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+associated+infinity-bundle"} universal rho-associated bundle
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quotient"}> quotient
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                %a.existingWikiWord{:href => "/nlab/show/quotient+type"} quotient type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"}> action groupoid
                ,
                %a.existingWikiWord{:href => "/nlab/show/global+quotient+orbifold"} global quotient orbifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+quotient+stack"} local quotient stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-colimit"}> (infinity,1)-colimit
                ,
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orbifold"}> orbifold
                ,
                %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+stack"} Deligne-Mumford stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+invariant+theory"} geometric invariant theory
          %h2#References References
          %h3#as_stackification_of_action_groupoids As stackification of action groupoids
          %p
            The definition of quotient stacks as
            %a.existingWikiWord{:href => "/nlab/show/stackifications"} stackifications
            of (
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-presheaves"}> presheaves of
            )
            %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
            is considered for instance in:
          %ul
            %li#LaumontMoret-Bailly
              %p
                %a.existingWikiWord{:href => "/nlab/show/G%C3%A9rard+Laumon"}> Gérard Laumon
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Laurent+Moret-Bailly"} Laurent Moret-Bailly
                = succeed "," do
                  %em Champs algébriques
                = succeed "," do
                  %strong 39
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-24899-6"} doi:10.1007/978-3-540-24899-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stacks+Project"}> Stacks Project
                , Definition 77.20.1 in:
                %em Quotient Stacks
                \&amp;lbrack;
                %a{:href => "https://stacks.math.columbia.edu/tag/044Q"}> tag:044Q
                \&amp;rbrack;
          %h3#as_presheaves_of_equivariant_maps_out_of_principal_bundles As presheaves of equivariant maps out of principal bundles
          %p
            The construction of quotient stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⫽
                  %mi G
                %annotation{:encoding => "application/x-tex"} X\sslash G
            as
            %a.existingWikiWord{:href => "/nlab/show/prestacks"} prestacks
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
            equipped with
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+maps"} equivariant maps
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is considered for instance in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jochen+Heinloth"}> Jochen Heinloth
                , Exp. 1.5 in:
                %em Notes on differentiable stacks
                (2004) &amp;lbrack;
                %a{:href => "https://math.nyu.edu/~tschinke/WS04/pdf/heinloth.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Heinloth-DifferentiableStacks.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+Neumann"}> Frank Neumann
                , p. 28 in:
                = succeed "," do
                  %em Algebraic Stacks and Moduli of Vector Bundles
                = succeed "," do
                  %a{:href => "https://impa.br/wp-content/uploads/2017/04/PM_36.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cimat.mx/~luis/seminarios/Pilas-algebraicas/neumann-Stacks.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Groechenig"}> Michael Groechenig
                , Def. 5.23 in:
                = succeed "," do
                  %em Algebraic Stacks
                = succeed "," do
                  %a{:href => "http://individual.utoronto.ca/groechenig/stacks.html"} web
                = succeed "," do
                  %a{:href => "http://individual.utoronto.ca/groechenig/stacks.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Groechenig-AlgebraicStacks.pdf", :title => "pdf"} pdf
            %li#Halpern-Leistner20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Halpern-Leistner"}> Daniel Halpern-Leistner
                , Section 7.1 of:
                = succeed "," do
                  %em Moduli theory
                = succeed "," do
                  %a{:href => "http://pi.math.cornell.edu/~danielhl/moduli_theory_notes.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Halpern-Leistner_ModuliTheory.pdf", :title => "pdf"} pdf
          %p
            Discussion of sufficient conditions for this construction to really yield a
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            (instead of just a
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/prestack"} prestack
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Elena+Caviglia"}> Elena Caviglia
              ,
              = succeed "," do
                %em Generalized principal bundles and quotient stacks
              %strong 39
              20 (2023) 567-597 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2302.07852"}> arXiv:2302.07852
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/39/20/39-20abs.html"} tac:39-20
          %h3#ReferencesAsFibrationsOverBG
            As fibrations over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            The characterization of quotient stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⫽
                  %mi G
                %annotation{:encoding => "application/x-tex"} X \sslash G
            as fibrations over
            %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} delooping stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo ⫽
                  %mi G
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \ast \sslash G \simeq \mathbf{B}G
            with
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (cf. also the discussion at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-action
          %ul
            %li#NSS12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Principal+%E2%88%9E-bundles+--+models+and+general+theory"}
                      Principal
                      = succeed "-bundles" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mn ∞
                            %annotation{:encoding => "application/x-tex"} \infty
                %strong 10
                4 (2015) 749-801 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1207.0248"}> arXiv:1207.0248
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://link.springer.com/article/10.1007/s40062-014-0083-6"} doi:10.1007/s40062-014-0083-6
            %li#SatiSchreiber20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Proper+Orbifold+Cohomology"} Proper Orbifold Cohomology
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2008.01101"}> arXiv:2008.01101
                \&amp;rbrack;
            %li#SatiSchreiber21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Equivariant+principal+infinity-bundles"}
                    Equivariant principal
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2112.13654"}> arXiv:2112.13654
                \&amp;rbrack;
            %li
              %p
                %a{:href => "#Halpern-Leistner20"} Halpern-Leistner (2020), Exc. 7.2
