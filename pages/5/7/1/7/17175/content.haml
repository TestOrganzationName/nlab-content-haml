                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msup
                                %mi Σ
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %msup
                                %mn 1
                                %mi E
                              %mo{:stretchy => "false"} )
                        %mtd
