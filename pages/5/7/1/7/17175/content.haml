                            %mn ∞
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbb{C}P^1
                  \&amp;
                  \\overset
                  { \Sigma^2 (1^E) }
                  {\longrightarrow}
                  \&amp;
                  E_2
                  \\\
                  \\big\downarrow &amp; \nearrow_{ \mathrlap{ c_1^E } }
                  \\\
                  \\mathbb{C}P^\infty
                  }
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex orientation
            in
            = succeed "-cohomology." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
