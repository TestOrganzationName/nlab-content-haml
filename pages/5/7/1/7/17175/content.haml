          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/projective+bundle"} projective bundle
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
