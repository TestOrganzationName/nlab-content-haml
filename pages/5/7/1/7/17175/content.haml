                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E^\bullet(X)
                %a.existingWikiWord{:href => "/nlab/show/module"} module
                %a.existingWikiWord{:href => "/nlab/show/linear+span"} spanned
                by the first
                %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup powers
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi ℒ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} c_1^E(\mathcal{L})
              #eq:ECohomologyOfProjectiveBundle.maruku-equation
                %span.maruku-eq-number (3)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi 𝒱
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟨
                      %mn 1
                      %mo ,
                      %mstyle{:mathcolor => "orange"}
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi ℒ
                        %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathcolor => "orange"}
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi ℒ
                        %mo{:stretchy => "false"} )
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mn 2
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathcolor => "orange"}
                        %msubsup
                          %mi c
                          %mn 1
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi ℒ
                        %mo{:stretchy => "false"} )
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi n
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} ⟩
                      %mspace{:width => "thinmathspace"}
                      %mo ;
                    %annotation{:encoding => "application/x-tex"}
                      E^\bullet\big( P(\mathcal{V})  \big)
                      \\;\simeq\;
                      E^\bullet(X)
                      \\Big\langle
                      1,
                      {\color{orange}
                      c_1^E(\mathcal{L})
                      }
                      ,
                      \\big(
                      {\color{orange}
                      c_1^E(\mathcal{L})
                      }
                      \\big)^2
                      ,
                      \\cdots
                      ,
                      \\big(
                      {\color{orange}
                      c_1^E(\mathcal{L})
                      }
                      \\big)^n
                      \\Big\rangle
                      \\,;
            %li
              %p and in particular
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi π
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mrow
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                      %msup
                        %mi E
                        %mo •
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi 𝒱
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\pi^\ast
                      \\;\colon\;
                      E^\bullet( X )
                      \\overset{\;\;\;\;\;}{\hookrightarrow}
                      E^\bullet\big( P(\mathcal{V}) \big)
              %p
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
          %p
            because this means that
            %a.maruku-eqref{:href => "#eq:DefiningConditionOnConnerFloydChernClasses"} (2)
            has a unique solution for the classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathcolor => "blue"}
                    %msubsup
                      %mi c
                      %mi k
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi 𝒱
                    %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi E
                    %mrow
                      %mn 2
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\color{blue} c_k^E(\mathcal{V})} \,\in\, E^{2k}(X)
            – these are the Conner-Floyd Chern classes of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
          %p
            But
            %a.maruku-eqref{:href => "#eq:ECohomologyOfProjectiveBundle"} (3)
            holds on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
            after
            %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi fib
                    %mi x
                %annotation{:encoding => "application/x-tex"} fib_x
            (by standard arguments in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            = succeed ")" do
              %a{:href => "#LurieLecture"} Lurie 10, Lecture 4, Example 8
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\mathcal{V})
            by the generalized-cohomology version of the
            %a.existingWikiWord{:href => "/nlab/show/Leray-Hirsch+theorem"} Leray-Hirsch theorem
            (
            %a{:href => "#ConnerFloyd66"}> Conner-Floyd 66, Thm. 7.4
            ).
          %p
            Since this construction is natural, one finds the following
            %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+classes"} universal characteristic classes
            in
            = succeed "-cohomology:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          #ConnerFloyedClasses.num_prop
            %h6#proposition Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with complex orientation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi c
                        %mn 1
                        %mi E
                    %annotation{:encoding => "application/x-tex"} c_1^E
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %span.newWikiWord
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
                %a{:href => "/nlab/new/BU%28n%29"} ?
              is freely generated over the
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}> prop.
              ) by classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mi k
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_k^E
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \leq n
              of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd-Chern+classes"} Conner-Floyd-Chern classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo ,
                    %msubsup
                      %mi c
                      %mn 2
                      %mi E
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi c
                      %mi n
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(B U(n))
                    \\;\simeq\;
                    \\pi_\bullet(E)[ [ c_1^E, c_2^E, \cdots, c_n^E ] ]
                    \\,.
            %p
              Moreover, pullback along the canonical inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n) \to B U(n+1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mi k
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_k^E
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
              and sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_{n+1}^E
              to zero.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                  %annotation{:encoding => "application/x-tex"} E =
              %a.existingWikiWord{:href => "/nlab/show/HA"} HZ
              this reduces to the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
          %h2#references References
          %p The concept was introduced for:
          %ul
            %li#ConnerFloyd66
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Conner"}> Pierre Conner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edwin+Floyd"} Edwin Floyd
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/The+Relation+of+Cobordism+to+K-Theories"} The Relation of Cobordism to K-Theories
                %strong 28
                Springer 1966 (
                %a{:href => "https://link.springer.com/book/10.1007/BFb0071091"}> doi:10.1007/BFb0071091
                ,
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=216511"} MR216511
              %blockquote
                %p
                  (with the example of
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/MSp"} MSp
                  = succeed "-cohomology" do
                    %a.existingWikiWord{:href => "/nlab/show/MU"} MU
          %p
            An early account in a broader context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
          %ul
            %li#Adams74
              %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
              , part I.4, part II.2, part III.10 of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Stable+homotopy+and+generalised+homology"} Stable homotopy and generalised homology
          %p More recent accounts:
          %ul
            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , Section 4.3 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#TamakiKono06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dai+Tamaki"}> Dai Tamaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Akira+Kono"} Akira Kono
                = succeed "," do
                  %em Generalized Cohomology
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/mmono-230"} ISBN: 978-0-8218-3514-2
            %li#Lurie10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chromatic+Homotopy+Theory"} Chromatic Homotopy Theory
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture4.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture5.pdf"} pdf
