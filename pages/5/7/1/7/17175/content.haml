          %p Using the defining conditions on the total Conner-Floyd Chern class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mn 1
                  %mo +
                  %msubsup
                    %mi c
                    %mn 1
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi 𝒱
                  %mo{:stretchy => "false"} )
                  %mo +
