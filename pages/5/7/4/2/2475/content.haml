          %title SEAR+
          %h1#sear
            SEAR+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
