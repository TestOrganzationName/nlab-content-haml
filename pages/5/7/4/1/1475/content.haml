                  was not maximal, contradiction. Hence any set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  may be well-ordered.
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
                  follows: suppose given a
                  %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo :
                          %mi E
                          %mo →
                          %mi B
                        %annotation{:encoding => "application/x-tex"} p: E \to B
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p^{-1}(b)
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo :
                        %mi B
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} s: B \to E
                  by letting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
