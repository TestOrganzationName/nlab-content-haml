                        %mrow
                          %mi X
                          %mo =
                          %mi A
                        %annotation{:encoding => "application/x-tex"} X = A
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  be a member of the complement
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ¬
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \neg X
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∪
                          %mo{:stretchy => "false"} {
                          %mi x
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} X \cup \{x\}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  by deeming
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  to be the final element. This shows
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
