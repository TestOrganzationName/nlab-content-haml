                        %annotation{:encoding => "application/x-tex"} p
          %h2#bourbakiwitt_theorem Bourbaki-Witt theorem
          %p
            Many accounts of the proof of Zorn’s lemma start by establishing first the so-called Bourbaki-Witt theorem, which does not require AC and is of interest in its own right. However, it too does not admit a constructive proof; see
            %a{:href => "#Bauer"} Bauer
            for a demonstration that it is not valid in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/effective+topos"} effective topos
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            (
            %a{:href => "#Bauer-Lumsdaine_13"}> Bauer-Lumsdaine 2013
            ).
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (Bourbaki-Witt)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              be an inhabited
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              such that every chain has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/supremum"} least upper bound
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi P
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} s: P \to P
              a function that is
              = succeed ":" do
                %em inflationary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \leq s(x)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              has a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} s(x) = x
          .proof
            %h6#proof_4 Proof
            %p
              Without loss of generality, assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              has a bottom element
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} a \in P
              and replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              with the upward set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ↑
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \uparrow a
            %p
              Say that a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} I \subseteq P
              is
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
                \-inductive
              if:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} 0 \in I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is closed under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi I
                  %annotation{:encoding => "application/x-tex"} s(I) \subseteq I
              ), and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              contains the sup of any chain in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
              = succeed "-inductive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              = succeed "-inductive," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              of all
              = succeed "-inductive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              = succeed "-inductive." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
            %p
              The idea is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is totally ordered (is a chain) by the following intuition: the elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              are
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi s
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi …
                      %msup
                        %mi s
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi …
                    %annotation{:encoding => "application/x-tex"} 0, s(0), s s(0), \ldots s^n(0), \ldots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi s
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s^\alpha(0)
              to be the sup of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi s
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi β
                      %mo &lt;
                      %mi α
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{s^\beta(0): \beta \lt \alpha\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi s
                        %mrow
                          %mi α
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi s
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s^{\alpha + 1}(0) = s(s^\alpha(0))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi s
                        %mrow
                          %mi α
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi s
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s^{\alpha + 1}(0) = s^\alpha(0)
              %a{:href => "https://golem.ph.utexas.edu/category/2012/10/the_zorn_identity.html#c042428"} comment
              by Lumsdaine.) In any case, once we prove
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is totally ordered, the sup of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is obviously a fixed point.
            %p
              Without getting into ordinals, one may prove
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is totally ordered as follows. Call an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} c \in M
              a
              %em cap
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &lt;
                    %mi c
                  %annotation{:encoding => "application/x-tex"} x \lt c
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} x\in M
              implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi c
                    %annotation{:encoding => "application/x-tex"} s(x) \leq c
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} c \in M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi c
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %mi M
                      %mo :
                      %mi x
                      %mo ≤
                      %mi c
                      %mo ∨
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi x
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} M_c = \{x \in M: x \leq c \vee s(c) \leq x\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi c
                  %annotation{:encoding => "application/x-tex"} M_c
              is
              = succeed "-inductive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is a cap, so in fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi c
                    %mo =
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M_c = M
              by minimality of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "-inductive." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi c
                    %mo =
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M_c = M
              for any cap (but consult Appendix 2 in Lang’s Algebra if you get stuck). So again by minimality of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a cap. Finally, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ,
                      %mi d
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} c, d \in M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is a cap to conclude either that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} d \leq c
              or
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi d
                    %annotation{:encoding => "application/x-tex"} s(c) \leq d
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ≤
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi d
                    %annotation{:encoding => "application/x-tex"} c \leq s(c) \leq d
          %p
            For a discussion of how to get from Bourbaki-Witt to Zorn, see either Lang or this
            = succeed "-Category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a{:href => "https://golem.ph.utexas.edu/category/2012/10/the_zorn_identity.html"} post
            by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tom+Leinster"} Tom Leinster
            %a{:href => "https://golem.ph.utexas.edu/category/2012/10/the_zorn_identity.html#c042422"} here
            which brings in Bourbaki-Witt.
          .num_remark
            %h6#remark_3 Remark
            %p
              An alternative proof of Bourbaki-Witt would be along lines similar to those used to show AC implies Zorn’s lemma. Given the inflationary function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                    %annotation{:encoding => "application/x-tex"} s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Well
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} f: Well(S) \to S
              which takes a well-ordered subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi sup
                      %mi W
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s(\sup W)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              has no fixed points, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(W)
              will always be a strict upper bound of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
          .num_remark
            %h6#remark_4 Remark
            %p
              The Bourbaki-Witt theorem is an example of a fixed-point theorem. We should point out its kinship with the quite remarkable fixed-point theorem due to Pataraia, who observed that the conclusion of the Bourbaki-Witt theorem may be strengthened quite considerably, and proved constructively (!), if we change the hypothesis to say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is a monotone operator (preserves the order
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                    %annotation{:encoding => "application/x-tex"} \leq
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dcpo"} dcpo
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
              for a brief account, and this
              %a{:href => "https://topology.lmf.cnrs.fr/bourbaki-witt-and-dito-pataraia/"} blog post
              for some appreciative commentary.
          %h2#wellordered_formulation Well-ordered formulation
          %p
            %a.existingWikiWord{:href => "/nlab/show/Terry+Tao"} Terry Tao
            %a{:href => "https://terrytao.wordpress.com/2009/01/28/245b-notes-7-well-ordered-sets-ordinals-and-zorns-lemma-optional/"} points out
            (Remark 14) that the proof of Zorn’s Lemma uses only the well-ordered chains, allowing a weakened hypothesis. This is most naturally stated in the context of
            %a.existingWikiWord{:href => "/nlab/show/quosets"} quosets
            rather than
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/posets"} posets
          #WellChainAndStrictUpperBound.num_defn
            %h6#definition_3 Definition
            %ul
              %li
                %p
                  Given a
                  %a.existingWikiWord{:href => "/nlab/show/quasiordered+set"} quasiordered set
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ,
                          %mo &lt;
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (S, \lt)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/maximal+element"} maximal
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo &lt;
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \lt y
                  never holds.
              %li
                %p
                  A
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/well-ordered+set"} well-ordered
                    chain
                  (or a
                  %em well-ordered subset
                  or simply a
                  = succeed ")" do
                    %em well-chain
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↪
                        %mi S
                      %annotation{:encoding => "application/x-tex"} A \hookrightarrow S
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo &lt;
                      %annotation{:encoding => "application/x-tex"} \lt
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/well+order"} well order
                  on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  A
                  %em
                    %span.newWikiWord
                      strict upper bound
                      %a{:href => "/nlab/new/strict+upper+bound"} ?
                  of a subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is an element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo &lt;
                        %mi x
                      %annotation{:encoding => "application/x-tex"} y \lt x
                  whenever
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi A
                        %annotation{:encoding => "application/x-tex"} y \in A
          %p
            The change to
            %em strict
            upper bounds is natural in a quasiordered context; it makes no difference in the presence of excluded middle, since we wish to conclude that a maximal element exists; if there is no maximal element, then any set with an upper bound immediately gets a strict upper bound along with it.
          #wellStatement.num_defn
            %h6#definition_4 Definition
            %p
              The well-ordered
              %strong Zorn's Lemma
              states that any quasiordered set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              has a maximal element if every well-chain in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              has a strict upper bound, or more simply that it is not possible in a quasiordered set that every well-chain has a strict upper bound. Or from another perspective, if every well-ordered subset of a quasiordered
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              has a strict upper bound, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
          %p
            The ‘more simply’ formulation is equivalent (even constructively) because, on the one hand, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is a maximal element, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} {m}
            is a well-chain with no strict upper bound, contradicting the hypothesis; while on the other hand, anything whatsoever is true of a nonexistent quoset
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            Assuming excluded middle, this is (a priori) stronger than the usual Zorn’s Lemma, since only well-ordered chains are required to have upper bounds. (Of course, once all the proofs are in, they are both simply equivalent to the Axiom of Choice.) In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            has no maximal element, that doesn’t mean that every upper bound has a strict upper bound; and even if this could be fixed, we would only conclude that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            does
            %a.existingWikiWord{:href => "/nlab/show/not+not"} not not
            have a maximal element. However, I intend to argue that this version of Zorn’s Lemma should be regarded as more constructively acceptable; some relativized versions are flat-out true.
          %h2#usageapplications Usage/applications
          %p
            It is very common, when starting with a preordered set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            itself but to an
            %a.existingWikiWord{:href => "/nlab/show/up-set"} up-set
            (an
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and proves the existence of a maximal element comparable to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p Zorn's lemma may be used to prove all of the following:
          %ul
            %li
              The
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+maximal+principle"} Hausdorff maximal principle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is contained in a maximal chain.
            %li
              The
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter+theorem"} ultrafilter theorem
              %a.existingWikiWord{:href => "/nlab/show/filter"} filter
              on a set may be extended to an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
            %li
              The
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/maximal+ideal+theorem"} maximal ideal theorem
              %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
              in a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              may be extended to a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            %li
              The
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/basis+theorem"} basis theorem
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              (over a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
            %li etc …
          %p Some of these are equivalent to Zorn's lemma, while some are weaker; conversely, some additionally require excluded middle.
          %h2#references References
          %p Due Kuratowski and, independently later, Zorn:
          %ul
            %li
              %p
                Casimir Kuratowski,
                = succeed "," do
                  %em Une méthode d’élimination des nombres transfinis des raisonnements mathématiques
                %strong 3
                (1922) 76–108
                %a{:href => "https://doi.org/10.4064/fm-3-1-76-108"} doi
            %li
              %p
                Max Zorn,
                = succeed "," do
                  %em A remark on method in transfinite algebra
                %strong 41
                (10): 667–670 (1935)
                %a{:href => "https://doi.org/10.1090/S0002-9904-1935-06166-X"} doi
            %li
              %p
                Serge Lang,
                %em Algebra
                (third edition), Addison-Wesley 1993.
            %li#Osius
              %p
                Gerhard Osius,
                = succeed "," do
                  %em Categorical set theory: a characterization of the category of sets
                %a{:href => "https://doi.org/10.1016/0022-4049%2874%2990032-2"} 10.1016/0022-4049(74)90032-2
            %li#Bauer
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
                ,
                = succeed "," do
                  %em On the Failure of Fixed-Point Theorems for Chain-complete Lattices in the Effective Topos
                %strong 249
                (2009) 157–167, doi:
                %a{:href => "https://doi.org/10.1016/j.entcs.2009.07.089"} 10.1016/j.entcs.2009.07.089
                %em and
              %p
                Theoretical Computer Science,
                %strong 430
                (2012) 43–50, doi:
                %a{:href => "https://doi.org/10.1016/j.tcs.2011.12.005"}> 10.1016/j.tcs.2011.12.005
                \. arXiv:
                %a{:href => "https://arxiv.org/abs/0911.0068"}> 0911.0068
                \.
            %li#Bauer-Lumsdaine_13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+LeFanu+Lumsdaine"} Peter LeFanu Lumsdaine
                = succeed "," do
                  %em On the Bourbaki-Witt Principle in Toposes
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/S0305004113000108"} 10.1017/S0305004113000108
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1201.0340"} 1201.0340
            %li#Kneser
              %p
                Hellmuth Kneser,
                = succeed "," do
                  %em Das Auswahlaxiom und das Lemma von Zorn
                %a{:href => "http://resolver.sub.uni-goettingen.de/purl?PPN266833020_0096"} here
          %p
            On Zorn’s lemma and
            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+type+theories"} intuitionistic type theories
          %ul
            %li#Bell
              %a.existingWikiWord{:href => "/nlab/show/John+Lane+Bell"}> John Lane Bell
              ,
              = succeed "," do
                %em Zorn’s lemma and complete Boolean algebras in intuitionistic type theories
              = succeed ")" do
                %a{:href => "https://doi.org/10.2307/2275642"} doi:10.2307/2275642
        .revisedby
