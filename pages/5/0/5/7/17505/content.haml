          %p
            where . is whiskering/horizontal composition. Furthermore, given composable
            = succeed "-morphisms" do
              %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
