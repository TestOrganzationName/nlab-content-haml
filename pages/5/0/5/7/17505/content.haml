                          %mo{:stretchy => "false"} )
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} F(y,y,x,x) \xrightarrow{F(1,1,f,f)} F(y,y,y,y) \xrightarrow{\alpha_y} G(y,y,y,y) \xrightarrow{G(f,f,1,1)} G(x,x,y,y).
              %p
                (This is a generalization of the hexagon identity for an ordinary
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/dinatural+transformation"} dinatural transformation
            %li
              %p
                For any 2-morphism
                %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo :
                      %mi f
                      %mo →
                      %mi g
                      %mo :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \mu:f\to g:x\to y
