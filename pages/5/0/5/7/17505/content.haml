                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi α
                            %mi x
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
