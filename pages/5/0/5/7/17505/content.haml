                          %mi f
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(y,y,x,x) \xrightarrow{F(f,f,1,1)} F(x,x,x,x) \xrightarrow{\alpha_x} G(x,x,x,x) \xrightarrow{G(1,1,f,f)} G(x,x,y,y)
              %p to the composite
              .maruku-equation
                %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_10.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
