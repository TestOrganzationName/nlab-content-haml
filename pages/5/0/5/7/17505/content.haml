          %h2#idea Idea
          %p
            A
            %em 2-dinatural transformation
            is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dinatural+transformation"} dinatural transformation
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite 2-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/lax+natural+transformation"} lax
          %h2#definition Definition
          %p
            Let
            %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be
            %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
            and let
          .maruku-equation
            %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_3.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                  %mo :
                  %msup
                    %mi C
                    %mi coop
                  %mo ×
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %msup
                    %mi C
                    %mi co
                  %mo ×
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F,G: C^{coop}\times C^{op}\times C^{co} \times C\to D
          %p
            be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
            %strong lax 2-dinatural transformation
            %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha:F\to G
            consists of
          %ol
            %li
              %p
                For each
                = succeed "," do
                  %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi C
                      %annotation{:encoding => "application/x-tex"} x\in C
              .maruku-equation
                %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi x
                      %mo :
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha_x : F(x,x,x,x) \to G(x,x,x,x)
            %li
              %p
                For each 1-morphism
                %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f:x\to y
                in
                = succeed "," do
                  %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              .maruku-equation
                %math#mathml_be326cef0e7413391cfd49c43af9f165d84d02b8_9.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi y
                      %mo ,
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi f
                          %mo ,
                          %mn 1
                          %mo ,
