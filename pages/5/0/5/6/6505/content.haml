          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/symplectic+geometry"} symplectic geometry
            a
            %em momentum map
            (French:
            = succeed "," do
              %em application moment
            = succeed ")" do
              %em moment map
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by (
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+symplectomorphisms"}> Hamiltonian
            )
            %a.existingWikiWord{:href => "/nlab/show/symplectomorphisms"} symplectomorphisms
            corresponds
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimally
            to a Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            from the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            to the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonians"} Hamiltonians
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} \to (C^\infty(X), \{-,-\})
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dualization
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            homomorphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi X
                  %mo ⟶
                  %msup
                    %mi 𝔤
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mu
                  \\,\colon\,
                  X \longrightarrow \mathfrak{g}^*
                  \\,.
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is called the
            %strong momentum map
            of the Hamiltonian action (in fact it is commonly called the
            %em moment map
            even if that is a misnomer arising from erroneous translation of the French term
            = succeed "." do
              %em application moment
            %a{:href => "https://mathoverflow.net/q/242468"} this mathoverflow question
            for the history of the name).
          %p
            The name derives from the special and historically first case of
            %a.existingWikiWord{:href => "/nlab/show/angular+momentum"} angular momentum
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rigid+body+dynamics"} dynamics of rigid bodies
            %em
              %a{:href => "#AngularMomentum"} Examples - Angular momentum
            below.
          %h2#definition Definition
          %p
            The
            %a{:href => "#Preliminaries"} Preliminaries
            below review some basics of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
            = succeed "." do
              %em
                %a{:href => "#HamiltonianActionAndTheMomentumMap"} Hamiltonian action and the momentum map
          %h3#Preliminaries Preliminaries
          %p
            This section briefly reviews the notion of
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
            on a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
          %p
            The basic setup is the following: Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\omega)
            be a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            with a
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %mo ×
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \nu\colon G \times M \to M
            via
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/symplectomorphism"} symplectomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ν
                    %mi g
                %annotation{:encoding => "application/x-tex"} \nu_g
            such that
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ν
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \nu_g^*(\omega) = \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+field"} symplectic
            if the corresponding flow preserves (again by pullbacks)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi(M,\omega)
            of the Lie algebra of all smooth vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi(M)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            with respect to the Lie bracket.
          %p
            By the
            %a.existingWikiWord{:href => "/nlab/show/Cartan+homotopy+formula"} Cartan homotopy formula
            and closedness
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ω
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d \omega = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi X
                  %mi ω
                  %mo =
                  %mi d
                  %msub
                    %mi ι
                    %mi X
                  %mi ω
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_X \omega = d \iota_X \omega
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_X
            denotes the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is symplectic iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mi ω
                  %mo =
                  %mi d
                  %mi H
                %annotation{:encoding => "application/x-tex"} \iota(X)\omega = d H
            for some function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H\in C^\infty(M)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is determined by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            up to a locally constant function. Such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mi X
                    %mi H
                %annotation{:encoding => "application/x-tex"} X = X_H
            is called the
            %strong Hamiltonian vector field
            corresponding to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the bracket
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo ,
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{,\}
            on functions may be given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} }
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mi f
                  %mo ,
                  %msub
                    %mi X
                    %mi g
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\{ f, g\} := [X_f,X_g]
          %p where there is a Lie bracket of vector fields on the right hand side.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,\omega)
            a connected symplectic manifold, there is an exact sequence of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  0 \to \mathbf{R}\to (C^\infty(M), \{-,-\}) \to \chi(M,\omega) \to 0
                  \\,.
          %p
            See at
            = succeed "." do
              %em
                %a{:href => "Hamiltonian+vector+field#RelationToFunctions"} Hamiltonian vector field – Relation to Poisson bracket
          %h3#HamiltonianActionAndTheMomentumMap Hamiltonian action and momentum map
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            be a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C^\infty(X), \{-,-\})
            for the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            Lie algebra underlying the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
          #MomentumMap.num_defn
            %h6#definition_2 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \mu \;\colon\; \mathfrak{g} \longrightarrow (C^\infty(X), \{-,-\})
                    \\,.
            %p The corresponding function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \;\colon\; X \longrightarrow \mathfrak{g}^*
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ↦
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \;\colon\; x \mapsto \tilde \mu(-)(x)
            %p
              is the corresponding
              = succeed "." do
                %strong momentum map
          #Notation.num_remark
            %h6#remark Remark
            %p If one writes the evaluation pairing as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo :
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ⊗
                    %mi 𝔤
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -,-\rangle : \mathfrak{g}^* \otimes \mathfrak{g} \to \mathbb{R}
            %p
              then the equation characterizing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              in def.
              %a.maruku-ref{:href => "#MomentumMap"}
              reads for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} v \in \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle \mu(x), v \rangle = \tilde \mu(v)(x)
                    \\,.
            %p This is the way it is often written in the literature.
            %p Notice that this in turn means that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi μ
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi μ
                      %mo *
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \mu(v)= \mu^\ast \langle -,v\rangle
                    \\,.
          #EquivalenceOfLieAndPoissonFormulation.num_prop
            %h6#proposition Proposition
            %p The following are equivalent
            %ol
              %li
                %p
                  the linear map underlying
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi μ
                          %mo{:stretchy => "false"} ˜
