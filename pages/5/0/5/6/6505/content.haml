                = succeed ")" do
                  %a{:href => "https://www.math.sunysb.edu/~mmovshev/MAT570Spring2008/BOOKS/atiyahbott_moment.pdf"} pdf
          %p Further developments are in
          %ul
            %li
              %p
                M. Spera,
                = succeed "," do
                  %em
                    On a generalized uncertainty principle,
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/coherent+state"} coherent state
                %strong 12
                (1993) 165-182,
                = succeed "," do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=1237511"} MR94m:58097
                %a{:href => "http://dx.doi.org/10.1016/0393-0440(93)90032-A"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ctirad+Klim%C4%8Dik"}> Ctirad Klimčik
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pavol+%C5%A0evera"} Pavol Ševera
                = succeed "," do
