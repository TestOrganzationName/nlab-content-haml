                %annotation{:encoding => "application/x-tex"} k \geq 2
          %p and hence
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_167.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
