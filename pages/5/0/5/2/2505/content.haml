                  \= \mathbb{Z}/12 \mathbb{Z}
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_150.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
