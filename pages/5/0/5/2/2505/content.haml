          %blockquote
            %p compare
          %h1#moduli_stackorbifold_of_elliptic_curves moduli stack/orbifold of elliptic curves
          %p
            %strong definition
          %p Define now the global orbifold
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_146.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
