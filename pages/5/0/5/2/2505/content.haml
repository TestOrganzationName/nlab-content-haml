            and similarly for the (group)cohomology
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_155.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
