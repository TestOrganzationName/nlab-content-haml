              %li
                %a{:href => "#compactified_moduli_stack"} compactified moduli stack
              %li
                %a{:href => "#gromovwitten_invariants"} Gromov-Witten invariants
                %ul
                  %li
                    %a{:href => "#example_"}
                      example:
                      %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} ⟨
                            %msub
                              %mi τ
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} ⟩
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \langle \tau_1\rangle_1
              %li
                %a{:href => "#extending_structures_to_the_compactified_moduli_space"} extending structures to the compactified moduli space
                %ul
                  %li
                    %a{:href => "#extending_the_line_bundles"} extending the line bundles
                  %li
                    %a{:href => "#extending_the_universal_family_of_elliptic_curves"} extending the universal family of elliptic curves
          %h1#elliptic_curves elliptic curves
          %p
            %strong Definition
            An
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is equivalently
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                of
                %a.existingWikiWord{:href => "/nlab/show/genus"} genus
                1 with a fixed point
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P \in X
            %li
              %p
                a quotient
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} /
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}/\Lambda
                where
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Λ
                    %annotation{:encoding => "application/x-tex"} \Lambda
                is a
                %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
                in
                = succeed ";" do
                  %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %li
              %p
                a compact complex
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                of dimension 1.
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth
                %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
                of degree 3 in
                = succeed "." do
                  %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒫
                      %annotation{:encoding => "application/x-tex"} \mathcal{P}
          %p
            %strong Remark
            The third definition is the one that is easiest to generalize. For our simple purposes, though, the second one will be the most convenient.
          %p
            From the second definition it follows that to study the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+elliptic+curves"} moduli space of elliptic curves
            it suffices to study the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            %strong Definition
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/framed+elliptic+curve"} framed elliptic curve
            is an
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,P)
            (in the sense of the first definition above) together with an ordered basis
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            of
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_1(X, \mathbb{Z})
            with
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (a \cdot b) = 1
          %p
            A
            %strong framed lattice
            in
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is a lattice
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            together with an ordered basis
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mn 1
                  %mo ,
                  %msub
                    %mi λ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\lambda_1, \lambda_2)
            of
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                %annotation{:encoding => "application/x-tex"} \Lambda
            such that
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi λ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Im(\lambda_2/\lambda_1) \gt 0
          %p
            (So turning
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \lambda_1
            to
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \lambda_2
            in the plane means going counterclockwise).
          %h1#moduli_spaces_of_elliptic_curves moduli spaces of elliptic curves
          %p this implies that
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}
            is in bijection with framed lattices in
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            which in turn is in bijection with
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            classes of framed elliptic curves over
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_24.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mi framed
                  %mo ~
                  %mi lattices
                  %mo ~
                  %mi in
                  %mo ~
                  %mi ℂ
                  %mo{:stretchy => "false"} }
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mi framed
                  %mo ~
                  %mi elliptic
                  %mo ~
                  %mi curves
                  %mo ~
                  %mi over
                  %mo ~
                  %mi ℂ
                  %mo{:stretchy => "false"} }
                  %msub
                    %mo{:stretchy => "false"} /
                    %mo ∼
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{h}
                  \\simeq
                  \\{framed~lattices~in~\mathbb{C}\}
                  \\simeq
                  \\{framed~elliptic~curves~over~\mathbb{C}\}/_\sim
          %p and we have
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_25.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi elliptic
                  %mo ~
                  %mi curves
                  %mo ~
                  %mi over
                  %mo ~
                  %mi ℂ
                  %msub
                    %mo{:stretchy => "false"} }
                    %mo ∼
                  %mo ≃
                  %mi 𝔥
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi SL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\{elliptic~curves~over~\mathbb{C}\}_\sim
                  \\simeq
                  \\mathfrak{h}/{SL_2(\mathbb{Z})}
          %p
            where
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi a
                            %mtd
                              %mi b
                          %mtr
                            %mtd
                              %mi c
                            %mtd
                              %mi d
                      %mo )
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mi d
                    %mo −
                    %mi c
                    %mi d
                    %mo =
                    %mn 1
                    %mo }
                %annotation{:encoding => "application/x-tex"} SL_2(\mathbb{Z}) = \left\{ \left(\array{a &amp; b \\ c &amp; d }\right)| a d - c d = 1\right\}
            acts by
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_27.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ↦
                  %mfrac
                    %mrow
                      %mi a
                      %mi τ
                      %mo +
                      %mi b
                    %mrow
                      %mi c
                      %mi τ
                      %mo +
                      %mi d
                %annotation{:encoding => "application/x-tex"}
                  \\tau \mapsto \frac{a \tau + b}{c \tau + d}
          %p
            %strong Claim
            the quotient
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                  %msub
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msub
                        %mi SL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}/_{SL_2(\mathbb{Z})}
            is
            %a.existingWikiWord{:href => "/nlab/show/biholomorphic+map"} biholomorphic
            to the disk and has a unique structure of a
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            which makes the quotient map
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                  %mo →
                  %mi 𝔥
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{h} \to \mathfrak{h}/SL_2(\mathbb{Z})
            a
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+map"} holomorphic map
          %blockquote
            %p
              %strong warning
              possibly something wrong here, audience doesn’t believe the bit about the disk
          %p
            %strong definition
            write
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo :
                  %mo =
                  %mi 𝔥
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi SL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M_{1,1} := \mathfrak{h}/SL_2(\mathbb{Z})
          %p
            %strong definition
            a
            %strong
              homolorphic family of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is
          %ul
            %li
              %p
                a holomorphic map
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo :
                      %mi X
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \pi : X \to T
            %li
              %p
                together with a
                %a.existingWikiWord{:href => "/nlab/show/section"} section
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo :
                      %mi T
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s : T \to X
                of
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
                such that for any
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mi T
                    %annotation{:encoding => "application/x-tex"} t \in T
                the pair
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mi t
                      %mo ,
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X_t, s(t))
                is an
                %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
                (using the first definition above).
          %p For every family
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_37.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi π
                      %mtr
                        %mtd
                          %mi T
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \\ \downarrow^\pi \\ T
                  }
          %p
            we would like to have
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %msub
                    %mi M
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} F \to M_{1,1}
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_39.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mo ≃
                          %msup
                            %mi ϕ
                            %mo *
                          %mi F
                        %mtd
                          %mo →
                        %mtd
                          %mi F
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi T
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi M
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \simeq \phi^* F &amp;\to&amp; F
                  \\\
                  \\downarrow &amp; &amp; \downarrow
                  \\\
                  T &amp;\to&amp; M_{1,1}
                  }
          %p where
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi t
                  %mo ↦
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mi t
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\phi:   t \mapsto [X_t, s(t)]
          %p such that
          %ul
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi T
                      %mo →
                      %msub
                        %mi M
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \phi : T \to M_{1,1}
                is a
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+map"} holomorphic map
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+map"} holomorphic map
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo →
                      %msub
                        %mi M
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} T \to M_{1,1}
                corresponds to a family over
                = succeed ";" do
                  %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                      %annotation{:encoding => "application/x-tex"} t
            %li
              %p
                there is a universal family over
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} M_{1,1}
          %p
            This is
            %em impossible
            \. One can construct explicit counterexamples. These counterexamples involved
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
          %p For instance
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_45.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi ℙ
                    %mn 2
                  %mo ×
                  %mi X
                  %mo :
                  %msup
                    %mi y
                    %mn 2
                  %mo =
                  %mi x
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo −
                  %mi λ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi X
                  %mo :
                  %mo =
                  %msup
                    %mi ℙ
                    %mn 1
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{
                  (x,y,z) \in \mathbb{P}^2 \times X :
                  y^2 = x(x-1)(x-\lambda)
                  \\}
                  \\to
                  X := \mathbb{P}^1 - \{0,1,\infty\}
          %blockquote
            %p
              but see the discussion at
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              for a discussion of the statement “it’s te automorphisms that prevent the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              from existing”
          %p consider
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_46.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℤ
                    %mn 2
                  %mo ↪
                  %mi ℂ
                  %mo ×
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}^2 \hookrightarrow \mathbb{C} \times \mathfrak{h}
          %p given by
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_47.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo +
                  %mi m
                  %mi τ
                  %mo +
                  %mi n
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (m,n) :
                  (z,\tau)
                  \\mapsto
                  (z + m \tau + n, \tau)
          %p Then consider the family
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_48.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi E
                          %mo :
                          %mo =
                          %mi ℂ
                          %msub
                            %mo{:stretchy => "false"} /
                            %mrow
                              %msup
                                %mi ℤ
                                %mn 2
                          %mo ×
                          %mi 𝔥
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi 𝔥
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  E := \mathbb{C}/_{\mathbb{Z}^2} \times \mathfrak{h}
                  \\\ \downarrow \\ \mathfrak{h}
                  }
          %p
            is a family of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}
          %p
            and
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi τ
                  %mo =
                  %mi ℂ
                  %mo{:stretchy => "false"} /
                  %mrow
                    %msub
                      %mi Λ
                      %mi τ
                %annotation{:encoding => "application/x-tex"} E_\tau = \mathbb{C}/{\Lambda_\tau}
            with
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_51.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mi τ
                  %mo :
                  %mo =
                  %mi ℤ
                  %mo ⋅
                  %mn 1
                  %mo ⊕
                  %mi ℤ
                  %mo ⋅
                  %mi τ
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda_{\tau} := \mathbb{Z}\cdot 1 \oplus \mathbb{Z}\cdot \tau
          %p is a family of framed elliptic curves.
          %p
            %strong fact
            the space
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \mathfrak{h}
            with the family
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} E \to \mathfrak{h}
            is a
            %a.existingWikiWord{:href => "/nlab/show/fine+moduli+space"} fine moduli space
            for
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/framed+elliptic+curve"} framed elliptic curve
          %p
            Consider any map
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi T
                  %mo →
                  %mi 𝔥
                %annotation{:encoding => "application/x-tex"} \phi : T \to \mathfrak{h}
          %p with pullback of the universal family
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_55.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mover
                            %mo →
                            %mo ?
                          %msup
                            %mi ϕ
                            %mo *
                          %mi E
                        %mtd
                          %mo →
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi T
                        %mtd
                          %mover
                            %mo →
                            %mi ϕ
                        %mtd
                          %mi 𝔥
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \stackrel{?}{\to} \phi^* E &amp;\to &amp; E
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  T &amp;\stackrel{\phi}{\to}&amp;
                  \\mathfrak{h}
                  }
          %p
            %strong claim
            for every point
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi T
                %annotation{:encoding => "application/x-tex"} t \in T
            there is an open neighbourhood
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mn 0
                  %mo ∈
                  %mi U
                  %mo ↪
                  %mi T
                %annotation{:encoding => "application/x-tex"} t_0 \in U \hookrightarrow T
            such that one can choose
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} 1-forms
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ω
                    %mi t
                %annotation{:encoding => "application/x-tex"} \omega_t
            on
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi τ
                %annotation{:encoding => "application/x-tex"} X_\tau
            which vary holomorphically with respect to
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
          %p
            Notice that
            %em locally
            every family of elliptic curves is framed (since we can locally extend a choice of basis for
            = succeed ")." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} H_1
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_62.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi 𝔥
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msub
                                %mi SL
                                %mn 2
                              %mo{:stretchy => "false"} (
                              %mi ℤ
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi M
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 1
                        %mtd
                          %mover
                            %mo →
                            %mi Id
                        %mtd
                          %msub
                            %mi M
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathfrak{h}
                  \\\
                  \&amp;&amp; \downarrow^{SL_2(\mathbb{Z})}
                  \\\
                  M_{1,1} &amp;\stackrel{Id}{\to}&amp;
                  M_{1,1}
                  }
          %p
            at
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi π
                      %mi i
                      %mo{:stretchy => "false"} /
                      %mn 6
                %annotation{:encoding => "application/x-tex"} \rho = e^{2\pi i/6}
            ,
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo ±
                  %mi I
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} C = \{\pm I\}
          %p
            isn’t locally liftable at
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            and
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            so it is not a univresal family of unframed curves.
          %h1#orbifolds orbifolds
          %p
            %strong definition
            A
            %strong basic pointed orbifold
            (basic meaning global) is a triple
            = succeed "," do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi Γ
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Γ
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X//\Gamma := (X,\Gamma,\rho)
          %ul
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
                and
                %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                (or in other variants a
                %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
                or whatever is under consideration)
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                is a discrete
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %mi Γ
                      %mo →
                      %mi Aut
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho : \Gamma \to Aut(X)
                is a group homomorphism
          %p
            (here “pointed” because we specified the action
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            instead of its iso-class under the following morphisms)
          %p
            A morphism from
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi γ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\gamma, \rho)
            to
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ′
                  %mo ,
                  %mi Γ
                  %mo ′
                  %mo ,
                  %mi ρ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X', \Gamma', \rho')
            is a pair
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_75.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (f,\phi)
          %p where
          %ul
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi X
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f : X \to X'
                is a continuous map
            %li
              %p
                %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi Γ
                      %mo →
                      %mi Γ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \phi : \Gamma \to \Gamma'
                is a group homomorphism
          %p
            such that for all
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ∈
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \gamma \in \Gamma
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_79.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi X
                          %mo ′
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi γ
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi γ
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mi f
                        %mtd
                          %mi X
                          %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{f}{\to}&amp; X'
                  \\\
                  \\downarrow^{\gamma} &amp;&amp; \downarrow^{\phi(\gamma)}
                  \\\
                  X &amp;\stackrel{f}{\to}&amp; X'
                  }
          %p This really leads an enlargement of the plain category of spaces:
          %p
            %strong remark
            We have a faithful embedding of spaxces into orbifolds defined this way: for any connected semi-locally simply connected space
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %a.existingWikiWord{:href => "/nlab/show/universal+cover"} universal cover
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde X
            we have
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_82.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ˜
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X \mapsto \tilde X //\pi_1(X)
          %blockquote
            %p
              %strong warning
              notice all the simply-connectedness assumoptions above for making sense of this
          %p
            %strong remark
            let
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nice+topological+space"} nice topological space
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = \pi_1(X)
            be its first
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            and let a discrete group
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            action on
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p then define
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_87.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Γ
                    %mo{:stretchy => "false"} ˜
                  %mo :
                  %mo =
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Γ
                    %mo ×
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi p
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi p
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi γ
                          %mtd
                            %mi X
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\tilde \Gamma :=
                  \\left\{
                  (\gamma,g)
                  \\in
                  \\Gamma \times Aut(\tilde X)
                  |
                  \\array{
                  \\tilde X &amp;\stackrel{g}{\to}&amp; \tilde X
                  \\\
                  \\downarrow^p &amp;&amp; \downarrow^p
                  \\\
                  X &amp;\stackrel{\gamma}{\to}&amp; X
                  }
                  \\right\}
          %p then we have an exact sequence
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_88.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi G
                  %mo →
                  %mover
                    %mi Γ
                    %mo{:stretchy => "false"} ˜
                  %mo →
                  %mi Γ
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  1 \to G \to \tilde \Gamma \to \Gamma \to 1
          %p
            where
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mover
                    %mi Γ
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} G \to \tilde \Gamma
            is given by
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (g \mapsto (1,g))
            and
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Γ
                    %mo{:stretchy => "false"} ˜
                  %mo →
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \tilde \Gamma \to \Gamma
            by
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_92.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} (\gamma,g) \mapsto \gamma
          %p
            %strong definition
          %p
            For an
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_93.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Γ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\Gamma,\rho)
            write
            = succeed "." do
              %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
