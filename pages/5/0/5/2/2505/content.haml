                  \\simeq
                  H^l(SL_2(\mathbb{Z}), V)^{SL_2(\mathbb{Z}/m\mathbb{Z})}
          %p due to the freeness we have also that
          .maruku-equation
            %math#mathml_8d24bba2eaa7b67c110c19e681c5170b710a5bc6_165.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
