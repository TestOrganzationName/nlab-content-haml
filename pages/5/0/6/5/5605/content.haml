          %h2#idea Idea
          %p
            The
            %em Barratt-Eccles operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is a specific realization of an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+operad"} E-infinity operad
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of the
            %a.existingWikiWord{:href => "/nlab/show/commutative+operad"} commutative operad
            (in the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operads"} model structure on operads
          %p
            As a
            %a.existingWikiWord{:href => "/nlab/show/topological+operad"} topological operad
            it is given by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mi n
                    %mo :
                    %mo =
                    %mi E
                    %msub
                      %mi Σ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_n := E \Sigma_n
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            for the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
