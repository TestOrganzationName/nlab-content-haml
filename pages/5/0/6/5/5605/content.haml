                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mi n
                        %annotation{:encoding => "application/x-tex"} E_n
              %a{:href => "http://math.unice.fr/~cberger/config.pdf"} pdf
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clemens+Berger"}> Clemens Berger
              ,
              %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"} Benoit Fresse
              = succeed "," do
