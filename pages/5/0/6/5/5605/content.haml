                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi Σ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Sigma_n // \Sigma_n
            is (the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of) the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
