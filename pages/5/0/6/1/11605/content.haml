                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^1(\Sigma)
          #J1IsPicard.num_prop
            %h6#proposition_5 Proposition
            %p
              The intermediate Jacobian
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi J
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^1(\Sigma)
              = succeed "," do
                %a.maruku-ref{:href => "#PlainIJacobian"}
              %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(\Sigma) = 1
              ) coincides with the connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Pic
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pic_0(\Sigma)
              of the
              %a.existingWikiWord{:href => "/nlab/show/Picard+variety"} Picard variety
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pic
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pic(\Sigma)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/Jacobian+variety"} Jacobian variety
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Jac
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Jac(\Sigma)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Pic
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Jac
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J^1(\Sigma) = Pic_0(\Sigma) = Jac(\Sigma)
                    \\,.
          %p
            First consider the elementary proof by direct inspection (e.g.
            = succeed "):" do
              %a{:href => "#Polishchuk03"} Polishchuk 03, section 16.4
          .proof
            %h6#proof_2 Proof
            %p Notice that the canonical map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^1(\Sigma,\mathbb{R})
                    \\hookrightarrow
                    H^1(\Sigma, \mathbb{C})
                    \\to
                    H^{0,1}(\Sigma)
                    \\stackrel{\simeq}{\to} H^1(\Sigma, \mathcal{O}_{\Sigma})
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mi i
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1(\Sigma, \mathbb{C}) \simeq H^1(\Sigma,\mathbb{R})\oplus i H^1(\Sigma,\mathbb{R})
              given by
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              and the second by the splitting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi H
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1(\Sigma,\mathbb{C}) \simeq H^{0,1}(\Sigma)\oplus H^{1,0}(\Sigma)
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dolbeault+cohomology"} Dolbeault cohomology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dolbeault+isomorphism"} Dolbeault isomorphism
            %p
              Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+cohomology"} long exact sequence in cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/exponential+exact+sequence"} exponential exact sequence
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi J
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msup
                              %mi H
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %mi ℝ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi H
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %msub
                              %mi 𝒪
                              %mi Σ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi H
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi H
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %msubsup
                              %mi 𝒪
                              %mi Σ
                              %mo ×
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msup
                              %mi H
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo ,
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Pic
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    J^1(\Sigma)
                    \&amp; \coloneqq
                    H^1(\Sigma, \mathbb{R})/H^1(\Sigma, \mathbb{Z})
                    \\\
                    \&amp; \simeq
                    H^1(\Sigma,\mathcal{O}_{\Sigma})/H^1(\Sigma, \mathbb{Z})
                    \\\
                    \&amp; \simeq
                    ker(H^1(\Sigma, \mathcal{O}^\times_{\Sigma})\to H^2(\Sigma, \mathbb{Z}))
                    \\\
                    \&amp; =
                    Pic_0(\Sigma)
                    \\end{aligned}
            %p
              is the connected component of the
              %a.existingWikiWord{:href => "/nlab/show/Picard+variety"} Picard variety
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            Alternatively, prop.
            %a.maruku-ref{:href => "#J1IsPicard"}
            derives from theorem
            %a.maruku-ref{:href => "#DeligneTheorem"}
            as follows:
          .proof
            %h6#proof_3 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^2\mathbb{Z}(k+1)_D\simeq \mathbf{B}\mathbb{G}_m
              is just the universal moduli stack of line bundles without connection and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi 𝔾
                      %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{2k+2}(\Sigma, \mathbb{Z}(k+1)_D ) \simeq H(\Sigma,\mathbf{B}\mathbb{G}_m)
              is the full
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Picard+variety"} Picard variety
              %a.maruku-ref{:href => "#DeligneTheorem"}
              then restricts this to the elements which have trivial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Jacobian+variety"} Jacobian variety
          #GeneralizationToModuliOfGPrincipalConnections.num_remark
            %h6#remark_3 Remark
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian
              generalization of this statement that the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+flat+connections"} moduli space of
              real bundles with flat connections is equivalently a moduli space of complex-analytic bundles, but without connection. This is a corollary of the
              %a.existingWikiWord{:href => "/nlab/show/Narasimhan-Seshadri+theorem"} Narasimhan-Seshadri theorem
              (for
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi dim
                        %mi ℂ
                      %mi Σ
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}\Sigma = 1
              %a.existingWikiWord{:href => "/nlab/show/Donaldson-Uhlenbeck-Yau+theorem"} Donaldson-Uhlenbeck-Yau theorem
              (for
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifolds"} Kähler manifolds
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %a.existingWikiWord{:href => "/nlab/show/Kobayashi-Hitchin+correspondence"} Kobayashi-Hitchin correspondence
              (for arbitrary complex
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              = succeed "):" do
                %a{:href => "#ScheinostSchottenloher96"} Scheinost-Schottenloher 96, corollary 1.16
            %p
              the moduli space of
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU(n)
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is equivalently the moduli space of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} SL(n,C)
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+vector+bundles"} holomorphic vector bundles
              which have vanishing
              %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
              and are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+vector+bundle"} semi-stable
          %h3#ExampleAlbanese
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = n-1
            \: Albanese variety
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            any space of complex dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≔
                  %msub
                    %mi dim
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} n \coloneqq dim_{\mathbb{C}}(\Sigma)
            then with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = n-1
            the
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J^{n-1}(\Sigma) = H^{2k-1}(\Sigma,\mathbb{R})/H^{2k-1}(\Sigma, \mathbb{Z})
                  \\,.
          %p
            This
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %em
              %a.existingWikiWord{:href => "/nlab/show/Albanese+variety"} Albanese variety
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %h3#ExampleCY Of Calabi-Yau varieties
          %p
            A review of intermediate Jacobians of
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+varieties"} Calabi-Yau varieties
            of (
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"}> complex
            )
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            3 is in (
            %a{:href => "#Baarsma11"}> Baarsma 11, section 2
            ).
          %p
            The (real) dimensional of the intermediate Jacobian of a CY3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %msup
                    %mi h
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  dim (J(X)) = 2(1+ h^{1,2})
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Baarsma11"} Baarsma 11, (2.21)
          %p
            Hence the intermediate Jacobian of a rigid CY3 (with
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} h^{1,2} = 0
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            (e.g.
            = succeed ")." do
              %a{:href => "#BKNPP09"} BKNPP 09, (1.8)
          %h3#_supergravity_cfield
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n = 3
            \: supergravity C-field
          %p
            For the moment see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/7d+Chern-Simons+theory"} 7d Chern-Simons theory
            and at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
          %h3#_type_ii_3form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 3
