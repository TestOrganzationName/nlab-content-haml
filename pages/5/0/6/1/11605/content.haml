                    \\mathbb{Z}(p)[-2k-2]
                    \&amp;&amp; &amp;&amp;
                    \\Omega^{\bullet \geq k+1}[-2k-2]
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
