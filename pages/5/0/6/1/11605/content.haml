                              %mi Ω
                              %mi k
                            %mo →
                            %mn 0
                            %mo →
                            %mi ⋯
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
