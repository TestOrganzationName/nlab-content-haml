                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            %em intermediate Jacobian variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
            of a
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+space"} complex analytic space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of its
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 2k+1
            with
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            by that with
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            coefficients
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J^{k+1}(\Sigma) \coloneqq H^{2k+1}(\Sigma, \mathbb{R}) / H^{2k+1}(\Sigma, \mathbb{Z})
                  \\,.
          %p
            This space naturally carries the structure of a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            (in fact two such structures, named after Griffiths and after Weil) and this complex analytic space, which is in fact a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/complex+torus"} complex torus
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            %em intermediate Jacobian variety
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %em
              %a.existingWikiWord{:href => "/nlab/show/Jacobian+variety"} Jacobian variety
            which is the (historically earlier) special case for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k = 0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} dim_{\mathbb{C}}(\Sigma) = 1
          %p
            Notice that, conceptually, we may (cf. at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            the
            %a{:href => "Deligne+cohomology#ExactSequenceForCurvatureAndCharacteristicClass"} exact sequences
            and generally at
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+hexagon"} differential cohomology hexagon
          %ul
            %li
              %p
                think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{R})
                as the space of those
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  \-form connections
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                which are both
                %a.existingWikiWord{:href => "/nlab/show/flat+infinity-connection"} flat
                and have trivial
                %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/line+n-bundle"}
                    line
                    = succeed "-bundle" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^{2k + 1}(\Sigma,\mathbb{Z})
                as the group of “large” (i.e.: not connected to the identity)
                %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher
                %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
                acting on these gauge fields;
            %li
              %p
                hence understand
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi J
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
                as the
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
                of flat
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-bundles." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            This turns out to be a natural and useful perspective on intermediate Jacobians:
            %em Deligne’s theorem
            (discussed as theorem
            %a.maruku-ref{:href => "#DeligneTheorem"}
            below) characterizes the intermediate Jacobians as subgroups of the relevant
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            group of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            is a model for
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            that classifies these
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} line n-bundles with connection
            %a.maruku-ref{:href => "#AsFiberOf0TruncationOnFractureSquare"}
            below, Deligne’s theorem in the formulation of
            %a{:href => "#EsnaultViehweg88"} Esnault &amp; Viehweg (1988)
            may be rephrased such as to manifestly give a formal incarnation of the the statement that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
            is just that subgroup of the Deligne complex given by
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"}
              line
              = succeed "-connections" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            with trivial
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            and trivial
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/line+n-bundle"}
                line
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p
            This formulation, in turn, has an evident generalization from
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            to general (namely
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            = succeed "." do
              %a{:href => "#GeneralDescripion"} below
          %p
            This perspective on intermediate Jacobians from
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge theory
            also faithfully reflects their role in fundamental
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            (in
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "," do
              %a{:href => "#Witten96"} Witten (1996)
            = succeed "&rbrack;." do
              %a{:href => "#HopkinsSinger02"} Hopkins &amp; Singer (2002)
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            has as
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            certain
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+fields"} higher gauge fields
            specified by some type of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            of its
            %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            (of solutions to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the higher Chern-Simons
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            produces a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            on the intermediate Jacobian, which is the
            %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
            of the theory. By
            %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            one has to choose a
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
            for this line bundle and the Weil complex structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
            is precisely that. In terms of
            %a.existingWikiWord{:href => "/nlab/show/complex+geometry"} complex geometry
            this state of affairs directly translates into the statement that the Weil intermediate Jacobians are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polarized+varieties"} polarized varieties
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principally+polarized+variety"} principally polarized
            %a.existingWikiWord{:href => "/nlab/show/metaplectic+correction"} metaplectic correction
            of the
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
            used for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization"} geometric quantization
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+section"} holomorphic section
            of the resulting
            %a.existingWikiWord{:href => "/nlab/show/Theta+characteristic"} Theta characteristic
            on the intermediate Jacobian is physically the
            %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
            of
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            (see there for more) which mathematically is the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
          %p
            By way of these deep relations intermediate Jacobians play an important role in (
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"}> higher
            )
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
          %h2#definition Definition
          %h3#InComplexGeometry For differential ordinary cohomology
          %h4#the_underlying_real_manifold The underlying real manifold
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a
            %a.existingWikiWord{:href => "/nlab/show/projective+variety"} projective
            %a.existingWikiWord{:href => "/nlab/show/smooth+variety"} smooth
            %a.existingWikiWord{:href => "/nlab/show/complex+variety"} complex variety
            (see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/GAGA"} GAGA
          #PlainIJacobian.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                th intermediate Jacobian
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+manifold"} real manifold
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    J^{k+1}(\Sigma)
                    \\coloneqq
                    H^{2k+1}(\Sigma,\mathbb{R})/H^{2k+1}(\Sigma,\mathbb{Z})
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              and of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ↪
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \hookrightarrow \mathbb{R}
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{R})
            is naturally a
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            over the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            and this is what induces the
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          %p
            For the purpose of eventually equipping this with the
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            one may realizes it as the quotient of the
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
            of
            %a.existingWikiWord{:href => "/nlab/show/complex+cohomology"} complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
          .num_remark
            %h6#remark Remark
            %p
              A real
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;\in\;
                    \\Omega^{2k+1}_{\mathbb{R}}(\Sigma)
            %p
              is, by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+theorem"} Hodge theorem
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+complex"} Dolbeault bidegree
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi α
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo +
                    %msup
                      %mi α
                      %mrow
                        %mn 2
                        %mi k
                        %mo ,
                        %mn 1
                    %mo +
                    %mi ⋯
                    %mo +
                    %msup
                      %mi α
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                        %mo ,
                        %mi k
                    %mo +
                    %mover
                      %mrow
                        %msup
                          %mi α
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                            %mo ,
                            %mi k
                      %mo ¯
                    %mo +
                    %mi ⋯
                    %mo +
                    %mover
                      %mrow
                        %msup
                          %mi α
                          %mrow
                            %mn 2
                            %mi k
                            %mo ,
                            %mn 1
                      %mo ¯
                    %mo +
                    %mover
                      %mrow
                        %msup
                          %mi α
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                            %mo ,
                            %mn 0
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;=\;
                    \\alpha^{2k+1,0}+ \alpha^{2k,1}
                    +
                    \\cdots
                    +
                    \\alpha^{k+1,k}
                    +
                    \\overline{\alpha^{k+1,k}}
                    +
                    \\cdots
                    +
                    \\overline{\alpha^{2k,1}} + \overline{\alpha^{2k+1,0}}
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mrow
                        %mi q
                        %mo ,
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{(-)}
                    \\;\colon\;
                    \\Omega^{p,q}(\Sigma)\longrightarrow \Omega^{q,p}(\Sigma)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/antilinear+function"} antilinear function
              on complex differential forms given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
          %p
            It follows with the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
            that:
          #AsQuotientByHodgeFiltering.num_prop
            %h6#proposition Proposition
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1}(\Sigma, \mathbb{R})
                    \\;\simeq\;
                    H^{2k+1}(\Sigma,\mathbb{C})/(F^{k+1} H^{2k+1}(\Sigma,\mathbb{C}))
                    \\,,
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mrow
                        %mi p
                        %mo ≥
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo ,
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                        %mo −
                        %mi p
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F^{k+1} H^{2k+1}(\Sigma,\mathbb{C})
                    \\;\coloneqq\;
                    \\underset{p \geq k+1}{\oplus} H^{p,2k+1-p}(\Sigma)
            %p
              is the
              = succeed "st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo ,
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{C})
          %p
            Hence an equivalent way of writing the intermediate Jacobian (still as a real manifold) is as the
            %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
            of the real manifold underlying a complex vector space, as follows:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The intermediate Jacobian of def.
              %a.maruku-ref{:href => "#PlainIJacobian"}
              is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ⊕
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J^{k+1}(\Sigma)
                    \\;\simeq\;
                    H^{2k+1}(\Sigma,\mathbb{C})
                    \/
                    \\big(
                    F^{k+1} H^{2k+1}(\Sigma, \mathbb{C})
                    \\,\oplus\,
                    H^{2k+1}(\Sigma,\mathbb{Z})
                    \\big)
                    \\,.
          %p
            Yet one more reformulation is useful when properly working in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"} complex analytic geometry
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/GAGA"} GAGA
          #ModuliOfHolomorphickConnections.num_defn
            %h6#definition_3 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi k
                    %msub
                      %mi 𝔾
                      %mi a
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \big(\mathbf{B}^k \mathbb{G}_a\big)_{conn}
              for the
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              on
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              of
              %a.existingWikiWord{:href => "/nlab/show/complex+manifolds"} complex manifolds
              which assigns the truncated
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+complexes"} de Rham complexes
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+differential+forms"} holomorphic differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi k
                    %msub
                      %mi 𝔾
                      %mi a
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi conn
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi 𝒪
                      %mover
                        %mo →
                        %mo ∂
                      %msup
                        %mi Ω
                        %mn 1
                      %mover
                        %mo →
                        %mo ∂
                      %mi ⋯
                      %mover
                        %mo →
                        %mo ∂
                      %msup
                        %mi Ω
                        %mi k
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(\mathbf{B}^k \mathbb{G}_a\big)_{conn}
                    \\;\coloneqq\;
                    \\left(
                    \\mathcal{O}
                    \\stackrel{\partial }{\to}
                    \\Omega^{1}
                    \\stackrel{\partial}{\to}
                    \\cdots
                    \\stackrel{\partial}{\to}
                    \\Omega^{k}
                    \\right)
            %p
              regarded as sitting in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              to 0.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#EsnaultViehweg88"} Esnault &amp; Viehweg (1988), top of p. 14
          #ReplacingHodgeFiltrationQuotientByHolomorphicConnections.num_prop
            %h6#proposition_3 Proposition
            %p
              The quotient in prop.
              %a.maruku-ref{:href => "#AsQuotientByHodgeFiltering"}
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf
              %a.existingWikiWord{:href => "/nlab/show/hypercohomology"} hypercohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mn 2
                        %mi k
                    %msub
                      %mi 𝔾
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}^{2k}\mathbb{G}_a
              of def.
              = succeed ":" do
                %a.maruku-ref{:href => "#ModuliOfHolomorphickConnections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Σ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi F
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} [
                    %mi Σ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi k
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi k
                    %msub
                      %mi 𝔾
                      %mi a
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi conn
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{2k+1}\big(
                    \\Sigma
                    ,\,
                    \\mathbb{C}
                    \\big)
                    \/
                    F^{k+1}
                    H^{2k+1}(\Sigma, \mathbb{C})
                    \\;\simeq\;
                    \\Big[
                    \\Sigma
                    ,\,
                    \\mathbf{B}^k\big(\mathbf{B}^k \mathbb{G}_a\big)_conn
                    \\Big]
                    \\,.
          %p
            (e.g.
            = succeed ")." do
              %a{:href => "#EsnaultViehweg88"} Esnault &amp; Viehweg (1988), 2.5 b)
          %p
            There are two canonical ways of equipping
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{C})
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
          %ol
            %li
              %p
                %em>
                  %a{:href => "#GriffithIntermediateJacobian"} Griffith intermediate Jacobian
                ,
            %li
              %p
                %em>
                  %a{:href => "#WeilIntermediateJacobian"} Weil intermediate Jacobian
                \.
          %h4#CharacterizationAsHodgeTrivialDeligneCohomology Characterization as Hodge-trivial Deligne cohomology
          %p
            A theorem due to
            %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"} Pierre Deligne
            says that the intermediate Jacobian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} J^k(\Sigma)
            is characterised as being the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of a canonical map from (
            %a.existingWikiWord{:href => "/nlab/show/complex+analytic+geometry"}> complex analytic
            )
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
            to the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
          #HodgeCohomologyClasses.num_defn
            %h6#definition_4 Definition
            %p
              The group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Hdg
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hdg^{k+1}(\Sigma)
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hodge+cocycle"} Hodge cohomology classes
              is the subgroup of
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}(k+1)
              = succeed "st" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Hdg
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi F
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %msup
                              %mi H
                              %mrow
                                %mn 2
