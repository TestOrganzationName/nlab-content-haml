                    %mi dim
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k = dim_{\mathbb{C}}(\Sigma)= 1
            go by special names, the
          %ul
            %li
              %p
                %a{:href => "#ExamplePicard"} Picard variety
            %li
              %p
                %a{:href => "#ExampleAlbanese"} Albanese variety
          %p respectively.
          %p Of special interest are also the intermediate Jacobian
          %ul
            %li
              %a{:href => "#ExampleCY"}> of Calabi-Yau varieties
              \.
          %h3#ExamplePicard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k = 0
            \: the Picard variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mn 1
