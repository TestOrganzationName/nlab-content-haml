                                %msub
                                  %mi θ
                                  %mover
                                    %mi E
                                    %mo{:stretchy => "false"} ^
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mover
                            %mi E
