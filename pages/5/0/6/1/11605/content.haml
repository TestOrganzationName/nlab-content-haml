          #DeligneTheorem.num_theorem
            %h6#theorem Theorem
            %p
              %strong (Deligne)
            %p
              As an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              the intermediate Jacobian
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi J
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J^k(\Sigma)
              = succeed "," do
                %a.maruku-ref{:href => "#PlainIJacobian"}
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of the canonical map from
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne cohomology
              to Hodge cohomology classes, has as fitting into a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the following form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi J
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi Σ
                    %mo ;
                    %mspace{:width => "thinmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⟶
