                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 2
                        %mi k
                        %mo −
                        %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi τ
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo ≥
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                    %mi k
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J^{k+1}(\Sigma)
                    \\longrightarrow
                    \\tau_0\left(
                    [\Sigma,\mathbb{Z}(p)[-2k-2]]
                    \\underset{[\Sigma, \mathbb{C}[-2k-2]]}{\times}
                    \\Omega^{\bullet \geq k+1}[-2k-2]
                    \\right)
                    \\longrightarrow
                    \\tau_0 [\Sigma,\mathbb{Z}(p)[-2k-2]]
                    \\underset{\tau_0 [\Sigma, \mathbb{C}[-2k-2]]}{\times}
                    \\tau_0 [\Sigma, \Omega^{\bullet \geq k+1}[-2k-2]]
                    \\,.
          %p
            This formulation of the intermediate Jacobian has a straightforward generalization from
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            to
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Whitehead-generalized+cohomology"} Whitehead-generalized cohomology
            = succeed "." do
              %a{:href => "#GeneralDescripion"} below
          %h4#GriffithIntermediateJacobian The Griffith complex structure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mi ℝ
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^{2k+1}(\Sigma , \mathbb{C})
                  \\simeq
                  H^{2k+1}(\Sigma , \mathbb{R})\otimes_{\mathbb{R}} (\mathbb{C})
          %p
            induces a
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma , \mathbb{C})
            and hence the structure of a
            %a.existingWikiWord{:href => "/nlab/show/complex+torus"} complex torus
            on
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a{:href => "#Griffiths68a"} Griffiths 68a
            = succeed ")" do
              %a{:href => "#Griffiths68b"} Griffiths 68b
            = succeed "." do
              %em Griffith intermediate Jacobian
            = succeed "," do
              %a{:href => "#Walls12"} Walls (2012)
            = succeed ")." do
              %a{:href => "#EsnaultViehweg88"} Esnault &amp; Viehweg (1988), section 7.8
          %h4#WeilIntermediateJacobian The Weil complex structure
          %p
            There is another natural
            %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{2k-1}(X, \mathbb{R})/H^{2k-1}(X, \mathbb{Z})
            = succeed "." do
              %em Weil intermediate Jacobian
          %p
            Let as before
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} n \,\coloneqq\, dim_{\mathbb{C}}(\Sigma)
            %a.existingWikiWord{:href => "/nlab/show/Hermitian+manifold"} Hermitian manifold
            structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/Serre+duality"} Serre duality
            on forms of total odd degree
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ⋆
                    %mo{:stretchy => "false"} ¯
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mrow
                      %mi p
                      %mo ,
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                      %mo −
                      %mi p
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mrow
                      %mi n
                      %mo −
                      %mi p
                      %mo −
                      %mn 2
                      %mi k
                      %mo −
                      %mn 1
                      %mo ,
                      %mi p
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\bar \star \;\colon\; \Omega^{p,2k+1-p}(\Sigma) \longrightarrow \Omega^{n-p-2k-1,p}(\Sigma)
          %p
            is an
            %a.existingWikiWord{:href => "/nlab/show/antilinear+function"} antilinear function
            which squares to -1. Therefore
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mover
                    %mo ⋆
                    %mo{:stretchy => "false"} ¯
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  i \bar \star \;\colon\;  H^{2k+1}(\Sigma,\mathbb{C}) \to  H^{2k+1}(\Sigma,\mathbb{C})
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/real+structure"} real structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{C})
            %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^{2k+1}(\Sigma,\mathbb{C})
            and hence on the above
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            which is the intermediate Jacobian
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
            = succeed "." do
              %em Weil intermediate Jacobian
          %h4#MidDimensionalWeilIntermediateJacobian The polarized mid-dimensional Weil (Lazzeri) intermediate Jacobian
          %p The Weil intermediate Jacobian is particularly interesting in mid degree, hence if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %msub
                    %mi dim
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 2
                  %mi k
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  n =dim_{\mathbb{C}}(\Sigma) = 2k+1
          %p
            then for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi J
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^{k+1}(\Sigma)
            %em Lazzeri’s Jacobians
            see (
            %a{:href => "#Rubei98"}> Rubei 98
            ).
          %p
            In this case the
            %a.existingWikiWord{:href => "/nlab/show/intersection+pairing"} intersection pairing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi α
                  %mo ∧
                  %mi β
                %annotation{:encoding => "application/x-tex"}
                  (\alpha, \beta) \mapsto \int_{\Sigma}\alpha \wedge \beta
          %p
            defines a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            %a.existingWikiWord{:href => "/nlab/show/Hodge+star"} Hodge star
            operator is a compatible
            %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
            and hence the
            = succeed "-pairing" do
              %a.existingWikiWord{:href => "/nlab/show/Serre+duality"} Serre duality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi α
                  %mo ∧
                  %mo ⋆
                  %mi β
                %annotation{:encoding => "application/x-tex"}
                  (\alpha, \beta) \mapsto \int_{\Sigma}\alpha \wedge \star \beta
          %p
            is the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polarized+variety"} polarized variety
          %p Notice that the holomorphic coordinates in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ker
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo +
                  %mi i
                  %mover
                    %mo ⋆
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi H
                    %mrow
                      %mn 2
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ker \tfrac{1}{2}( 1 + i \bar \star  ) \in H^{2k+1}(\Sigma, \mathbb{C})
          %p
            may be thought of as the mid-degree
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+fields"} self-dual higher gauge fields
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
            of the
            %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
            on
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
            in dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 4
                    %mi k
                    %mo +
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 4k+3
          %h4#the_intermediate_jacobian_of_a_hodge_structure The intermediate Jacobian of a Hodge structure
          %p
            By prop.
            %a.maruku-ref{:href => "#AsQuotientByHodgeFiltering"}
            above the intermediate Jacobian is defined by the canonical
            %a.existingWikiWord{:href => "/nlab/show/Hodge+filtering"} Hodge filtering
            on complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            %a.existingWikiWord{:href => "/nlab/show/Hodge+structures"} Hodge structures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            and hence one speaks more generally of the intermediate Jacobian
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi H
                    %mi ℂ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mi ℤ
                  %mo ⊕
                  %msup
                    %mi F
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  J(H)= H_{\mathbb{C}}/(H_\mathbb{Z}\oplus F^{k+1})
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            has weight
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 2k+1
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#PetersSteenbrink08"} Peters-Steenbrink 08, example 3.30, section 7.1.2
          %h3#GeneralDescripion For differential generalized cohomology
          %h4#general_construction General construction
          %blockquote
            %p
              under construction, see also (
              %a{:href => "#HopkinsQuick12"}> Hopkins-Quick 12
              )…
          %p
            The formulation of the traditional intermediate Jacobian by remark
            %a.maruku-ref{:href => "#AsFiberOf0TruncationOnFractureSquare"}
            above suggest the following generalization.
          %p
            (We use notation from
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+hexagon"} differential cohomology hexagon
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E
            (hence a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+hexagon"} differential cohomology hexagon
            part of which is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
