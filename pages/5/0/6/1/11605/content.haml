                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %msub
                            %mo ↗
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ch
                                  %mover
                                    %mi E
                                    %mo{:stretchy => "false"} ^
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Π
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \flat_{dR} \hat E
                  \\\
                  \&amp; {}^{\mathllap{\theta_{\hat E}}}\nearrow &amp;&amp; \searrow
                  \\\
                  \\hat E &amp;&amp; &amp;&amp; \Pi \flat_{dR} \hat E
                  \\\
                  \&amp; \searrow &amp;&amp; \nearrow_{\mathrlap{ch_{\hat E}}}
                  \\\
                  \&amp;&amp; \Pi \hat E
                  }
                  \\,.
          %p
            Hence for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
