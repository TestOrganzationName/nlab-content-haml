                    %mi SteinSp
                  %annotation{:encoding => "application/x-tex"} SteinSp
              of
              %a.existingWikiWord{:href => "/nlab/show/Stein+manifolds"} Stein manifolds
              (see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/complex+analytic+%E2%88%9E-groupoid"} complex analytic ∞-groupoid
              for more on this):
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
