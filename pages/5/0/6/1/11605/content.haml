          %p
            (e.g.
            = succeed ";" do
              %a{:href => "#EsnaultViehweg88"} Esnault &amp; Viehweg (1988), (7.9)
            = succeed ")" do
              %a{:href => "#PetersSteenbrink08"} Peters &amp; Steenbrink (2008), lemma 7.20
          .proof
            %h6#proof Proof
            %p
              Use prop.
              %a.maruku-ref{:href => "#ReplacingHodgeFiltrationQuotientByHolomorphicConnections"}
              and the
              %a{:href => "ordinary%20differential%20cohomology#CurvatureAndCharClass"} characteristic long exact sequences
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          #AsFiberOf0TruncationOnFractureSquare.num_remark
            %h6#remark_2 Remark
            %p
              The
              = succeed "-incarnation" do
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
