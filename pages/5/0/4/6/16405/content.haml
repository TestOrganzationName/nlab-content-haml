          #CartanGeometry.num_defn
            %h6#definition_3 Definition
            %p
              Consider an
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(V)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              which linearizes to the canonical
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔻
                      %mi e
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^V_e
              by def.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneralLinearGroup"}
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ⋊
                      %mi V
                    %annotation{:encoding => "application/x-tex"} GL(V) \rtimes V
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G\to GL(V)
            %p
              A
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo →
                      %mi G
                      %mo ⋊
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G\to G\rtimes V)
                \-
                %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
              is a
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#GStructure"}
              %em (infinitesimally) integrable
              if the
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#IntegrabilityOfGStructure"}
          .num_remark
            %h6#remark_2 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.maruku-ref{:href => "#IntegrabilityOfGStructure"}
              comes down to the
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
              vanishing. But for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+group"} nonabelian group
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk"} infinitesimal disk
              the intrinsic left-invariant torsion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              itself.
            %p
              Traditionally this is rarely considered, matching the fact that ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              %a.existingWikiWord{:href => "/nlab/show/translation+groups"} translation groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              regarded (in suitable dimension) as
              %a.existingWikiWord{:href => "/nlab/show/super+translation+groups"} super translation groups
              are
              %em
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+groups"} nonabelian groups
              (we discuss this in detail below in
              = succeed ")." do
                %em
                  %a{:href => "#SuperMinkowskiSpacetime"} The super-Klein geometry: super-Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              may carry intrinsic torsion, and therefore first-order integrable
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Indeed, this is a phenomenon known as the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/torsion+constraints+in+supergravity"} torsion constraints in supergravity
              %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
              the
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
              of the gravity theory are
              %em equivalent
              to the super-Cartan geometry satisfying this torsion constraint. This way super-Cartan geometry gives a direct general abstract route right into the heart of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/M-theory"} M-theory
