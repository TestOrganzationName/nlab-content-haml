          #GStructure.num_defn
            %h6#definition Definition
            %p
              Given a homomorphism of groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ⟶
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \longrightarrow GL(V)
              %em
                %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              on a
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}
              of the
              %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              of prop.
              %a.maruku-ref{:href => "#FrameBundle"}
              through this map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi τ
                                    %mi X
                            %mo ↘
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \stackrel{}{\longrightarrow} &amp;&amp; G
                    \\\
                    \&amp; {}_{\mathllap{\tau_X}}\searrow &amp;\swArrow&amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbf{B}GL(V)
                    }
                    \\,.
          #ModuliForGStructures.num_remark
            %h6#remark Remark
            %p
              As in remark
              = succeed "," do
                %a.maruku-ref{:href => "#ModuliForFramings"}
              %a.maruku-ref{:href => "#GStructure"}
              in terms of the
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL(V)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\mathbf{Struc}\in \mathbf{H}_{/\mathbf{B}GL(V)}
              for the given map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G\to \mathbf{B}GL(V)
              regarded as an object in the slice. Then a
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.maruku-ref{:href => "#GStructure"}
              is equivalently a choice of morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}GL(V)}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi X
                    %mo ⟶
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c} \;\colon\; \tau_X \longrightarrow G\mathbf{Struc}
                    \\,.
            %p
              In other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                    %mo ∈
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi v
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\mathbf{Struc} \in \mathbf{H}_{/\mathbf{B}GL(v)}
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
              for
              = succeed "-structures." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          #GStructureFromLeftTranslationFraming.num_example
            %h6#example Example
            %p
              A choice of
              %a.existingWikiWord{:href => "/nlab/show/framing"} framing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed "," do
                %a.maruku-ref{:href => "#Framing"}
              = succeed "-manifold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              induces a
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi GL
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; \ast &amp;\longrightarrow&amp;
                    \\\
                    \&amp; \searrow &amp; \downarrow &amp; \swarrow
                    \\\
                    \&amp;&amp; \mathbf{B}GL(V)
                    }
            %p
              or equivalently, via remark
              %a.maruku-ref{:href => "#ModuliForFramings"}
              and remark
              = succeed "," do
                %a.maruku-ref{:href => "#ModuliForGStructures"}
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mi li
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi X
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %mi V
                    %mstyle{:mathvariant => "bold"}
                      %mi Frame
                    %mo ⟶
                    %mi G
                    %mstyle{:mathvariant => "bold"}
                      %mi Struc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c}_{li}
                    \\;\colon\;
                    \\tau_X \stackrel{\phi}{\longrightarrow} V\mathbf{Frame} \longrightarrow G\mathbf{Struc}\,.
            %p
              We call this the
              = succeed "." do
                %em
                  left invariant
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
