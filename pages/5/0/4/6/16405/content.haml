              of example
              = succeed "," do
                %a.maruku-ref{:href => "#GStructureFromLeftTranslationFraming"}
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              in the double
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
