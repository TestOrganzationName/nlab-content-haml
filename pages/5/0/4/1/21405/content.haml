          %h4#properties Properties
          #HodgePairing.num_prop
            %h6#proposition Proposition
            %p
              %strong (Hodge pairing)
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/differential+p-form"} differential p-form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mi p
                          %mo !
                    %msub
                      %mi α
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi p
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mi d
                    %msup
                      %mi x
                      %mrow
                        %msub
                          %mi μ
                          %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;\coloneqq\;
                    \\tfrac{1}{p!}
                    \\alpha_{\mu_1 \cdots \mu_p}
                    d x^{\mu_1}
                    \\wedge \cdots \wedge
                    d x^{\mu_p}
              on
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              its
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              with its
              %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
              %a.maruku-eqref{:href => "#eq:HodgeStar"} (7)
              is
            #eq:AlphaWedgeStarAlpha.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∧
                    %mo ⋆
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mstyle{:mathcolor => "magenta"}
                          %mo −
                          %mn 1
                        %mrow
                          %mi p
                          %mo !
                    %msub
                      %mi α
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi p
                    %msup
                      %mi α
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %mi ⋯
                        %msub
                          %mi μ
                          %mi p
                    %mspace{:width => "thinmathspace"}
                    %mi dvol
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha \wedge \star \alpha
                    \\;=\;
                    \\tfrac{ \color{magenta} -1 }{
                    { p! }
                    }
                    \\alpha_{ \mu_1 \cdots \mu_p }
                    \\alpha^{ \mu_1 \cdots \mu_p }
                    \\,
                    dvol
                    \\,.
          .proof
            %h6#proof Proof
            %p We compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi α
                            %mo ∧
                            %mo ⋆
                            %mi α
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mstyle{:mathcolor => "green"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "orange"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "blue"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mi p
                                    %mo{:stretchy => "false"} )
                                    %mo !
                            %msub
                              %mi α
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi μ
                                  %mi p
                            %mi d
                            %msup
                              %mi x
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mi p
                            %mo ∧
                            %msup
                              %mi α
                              %mstyle{:mathcolor => "orange"}
                                %msub
                                  %mi ν
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi ν
                                  %mi p
                            %msub
                              %mi ι
                              %mstyle{:mathcolor => "orange"}
                                %msub
                                  %mi ν
                                  %mi p
                            %mi ⋯
                            %msub
                              %mi ι
                              %mstyle{:mathcolor => "orange"}
                                %msub
                                  %mi ν
                                  %mn 1
                            %mi dvol
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mstyle{:mathcolor => "green"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "orange"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "blue"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mi p
                                    %mo{:stretchy => "false"} )
                                    %mo !
                            %msub
                              %mi α
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi μ
                                  %mi p
