                                %mn 1
                                %mrow
                                  %mstyle{:mathcolor => "green"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "orange"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mi p
                                    %mo{:stretchy => "false"} )
                                    %mo !
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi α
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi μ
                                  %mi p
                            %msub
                              %mi ι
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mi p
                            %mi ⋯
                            %msub
                              %mi ι
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                            %mspace{:width => "thinmathspace"}
                            %mi dvol
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mstyle{:mathcolor => "green"}
                                    %mi p
                                    %mo !
                                  %mstyle{:mathcolor => "orange"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mi p
                                    %mo{:stretchy => "false"} )
                                    %mo !
                            %mspace{:width => "thinmathspace"}
                            %msup
                              %mi α
                              %mstyle{:mathcolor => "green"}
                                %msub
                                  %mi μ
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi μ
                                  %mi p
                            %msub
                              %mi ϵ
                              %mrow
                                %mstyle{:mathcolor => "green"}
                                  %msub
                                    %mi μ
                                    %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mi p
                                %mstyle{:mathcolor => "orange"}
                                  %msub
                                    %mi μ
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mn 1
                                  %mi ⋯
                                  %msub
                                    %mi μ
                                    %mi D
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %msup
                              %mi x
                              %mstyle{:mathcolor => "orange"}
                                %msub
                                  %mi μ
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mn 1
                            %mo ∧
                            %mi ⋯
                            %mo ∧
                            %mi d
                            %msup
                              %mi x
                              %mstyle{:mathcolor => "orange"}
                                %msub
                                  %mi μ
                                  %mi D
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\star
                    \\alpha
                    \&amp; \coloneqq
                    \\tfrac{1}{
                    { \color{green} p! }
                    { \color{orange} (D-p)! }
                    }
                    \\,
                    \\alpha^{ \color{green} \mu_1 \cdots \mu_p }
                    \\iota_{ \color{green} \mu_p }
                    \\cdots
                    \\iota_{ \color{green} \mu_1 }
                    \\,
                    dvol
                    \\\
                    \&amp; =
                    \\tfrac{1}{
                    { \color{green} p! }
                    { \color{orange} (D-p)! }
                    }
                    \\,
                    \\alpha^{ \color{green} \mu_1 \cdots \mu_p }
                    \\epsilon_{
                    { \color{green} \mu_1 \cdots \mu_p }
                    { \color{orange} \mu_{p+1} \cdots \mu_D }
