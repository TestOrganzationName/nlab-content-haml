                    \\;\coloneqq\;
                    \\tfrac{1}{ \color{green} p! }
                    \\alpha_{ \color{green} \mu_1 \cdots \mu_p}
                    d x^{ \color{green} \mu_1 }
                    \\wedge \cdots \wedge
                    d x^{ \color{green} \mu_p }
            %p
              its
              %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
              is:
            #eq:HodgeStar.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ⋆
                            %mi α
                          %mtd
                            %mo ≔
                            %mstyle{:displaystyle => "false"}
