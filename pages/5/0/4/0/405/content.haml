                %a{:href => "https://dx.doi.org/10.1016/j.jpaa.2010.08.001"} doi:10.1016/j.jpaa.2010.08.001
          %p Cubes with diagonals:
          %ul
            %li#ABCFHL
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carlo+Angiuli"}> Carlo Angiuli
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Guillaume+Brunerie"} Guillaume Brunerie
                = succeed "," do
