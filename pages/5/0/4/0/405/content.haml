                %em Relative elegance and cartesian cubes with one connection
                (2022). &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2211.14801"}> arXiv:2211.14801
                \&amp;rbrack;
          %p On Eilenberg–Zilber structures:
          %ul
            %li#Campion2023
              %a.existingWikiWord{:href => "/nlab/show/Tim+Campion"}> Tim Campion
              ,
              = succeed "," do
                %em Cubical sites as Eilenberg-Zilber categories
              %a{:href => "https://arxiv.org/abs/2303.06206"} arXiv:2303.06206
          %p Cubes with monotone interval-preserving maps:
          %ul
            %li#KrishnanRudman2025
              %a.existingWikiWord{:href => "/nlab/show/Sanjeevi+Krishnan"}> Sanjeevi Krishnan
              , Emily Rudman:
              %em A convenient category of cubes
              (2025) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2503.13663"}> arXiv:2503.13663
              \&amp;rbrack;
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            model of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            in a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+model+category"} Quillen model category
            of equivariant
            %a.existingWikiWord{:href => "/nlab/show/cartesian+cube+category"} cartesian
            %a.existingWikiWord{:href => "/nlab/show/cubical+sets"} cubical sets
            that
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classically
            presents the usual
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Steve+Awodey"}> Steve Awodey
              ,
