                              %mi l
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo ⋅
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi δ
                              %mi l
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi δ
                              %mi l
                            %mo{:stretchy => "false"} (
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi δ
                              %mi l
                            %mo{:stretchy => "false"} (
                            %mi σ
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi hb
                              %mi l
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ha
                              %mi l
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta_l(a)
                    \&amp; = \delta_l(\sigma \cdot b)
                    \\\
                    \&amp; = \delta_l(\sigma) \cdot \delta_l(b)
                    \\\
                    \&amp; = \delta_l(\sigma) \cdot hb_l
                    \\\
                    \&amp; = ha_l
                    \\end{aligned}
                    \\,.
            %p
              Moreover, by construction,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              is a filler in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mi i
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi ha
                                %mo ,
                                %mi hb
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo ,
                                %mi b
                                %mo{:stretchy => "false"} )
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mover
                              %mo →
                              %mi σ
                          %mtd
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Lambda[k]^i &amp;\stackrel{(ha, hb)}{\to}&amp; B(U) \times B(U)
                    \\\
                    \\downarrow^{\mathrlap{i}}
                    \&amp;{}^{(a,b)}\nearrow&amp;
                    \\downarrow
                    \\\
                    \\Delta[k] &amp;\stackrel{\sigma}{\to}&amp; B(U)
                    }
                    \\,.
            %p
              Since therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ×
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} - \colon B \times B \to B
              is a projective fibration, it follows as before that the ordinary pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
