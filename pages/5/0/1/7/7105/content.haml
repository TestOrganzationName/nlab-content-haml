            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          #SequenceOverGroupObjectIn1LocalicSituation.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object as above, the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi B
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times_B Y
              is equivalently given by the
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mi B
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi f
