                                %mrow
                                  %msub
                                    %mi Δ
                                    %mi B
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi e
                        %mtr
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B &amp;\to&amp; *
                    \\\
                    \\downarrow^{\mathrlap{\Delta_B}} &amp;&amp; \downarrow^{e}
                    \\\
                    B \times B &amp;\stackrel{-}{\to}&amp; B
