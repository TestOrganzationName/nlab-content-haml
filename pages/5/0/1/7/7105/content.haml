                                  %mi g
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times_B Y &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{0}}
                    \\\
                    X \times Y &amp;\stackrel{f \cdot g^{-1}}{\to}&amp; B
                    }
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#SequenceFromDiagonal"}
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ×
                      %mi B
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times_B Y
              is the
              = succeed "-pullback" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mi B
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Δ
                                    %mi B
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times_B Y &amp;\to&amp; B
                    \\\
                    \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow^{\mathrlap{\Delta_B}}
                    \\\
                    X \times Y &amp;\stackrel{(f,g)}{\to}&amp; B \times B
                    }
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              this is equivalently given by the composite pullback of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %msub
                              %mo ×
                              %mi B
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Δ
                                    %mi B
                          %mtd
                            %msub
                              %mo ⇙
                              %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi B
                            %mo ×
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X \times_B Y &amp;\to&amp; B &amp;\to&amp; *
                    \\\
                    \\downarrow
                    \&amp;\swArrow_{\simeq}&amp;
                    \\downarrow^{\mathrlap{\Delta_B}}
                    \&amp;\swArrow_{\simeq}&amp;
                    \\downarrow^{\mathrlap{0}}
                    \\\
                    X \times Y &amp;\stackrel{(f,g)}{\to}&amp; B \times B
                    \&amp;\stackrel{-}{\to}&amp; B
                    }
                    \\,.
            %p
              Here the composite bottom morphism is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f - g)
          %p Summing this up:
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              an
              = succeed "-object" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon X \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g \colon Y\to B
              two morphisms, then there is a long
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi B
                    %mo ⟶
                    %mi X
                    %msub
                      %mo ×
                      %mi B
                    %mi Y
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mi f
                        %mo ⋅
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega B \longrightarrow X \times_B Y \longrightarrow X \times Y
                    \\stackrel{f \cdot g^{-1}}{\longrightarrow} B
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              of definition, there is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mover
                      %mo ↪
                      %mo ⟵
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{H} \stackrel{\longleftarrow}{\hookrightarrow}
                    [C^{op},\infty Grpd]
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              into an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            %p
              By prop.
              %a.maruku-ref{:href => "#SequenceOverGroupObjectIn1LocalicSituation"}
              the statement holds in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mn ∞
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op},\infty Grpd]
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+%28%E2%88%9E%2C1%29-limits"} finite (∞,1)-limits
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p Still more generally and more simply:
          #HTTArgumentForPullback.num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+Cartesian+closed+%28%E2%88%9E%2C1%29-category"} locally Cartesian closed (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object (or just a grouplike
              = succeed "-object)." do
                %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo ⟶
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \phi \colon D \longrightarrow G
              any morphism we have a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              square of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %mi D
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi D
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ϕ
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G \times D &amp;\longrightarrow&amp; D
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}}
                    \\\
                    G \times G &amp;\stackrel{(-)\cdot (-)^{-1}}{\longrightarrow}&amp; G
                    }
                    \\,.
          %p
            (
            %a{:href => "http://nforum.mathforge.org/discussion/6403/generality-of-mayervietoris-in-an-infinitytopos-/?Focus=51417#Comment_51417"}> nForum discussion
            )
          #ProofOfHTTArgumentForPullback.proof
            %h6#proof_4 Proof
            %p
              By
              %a{:href => "locally+cartesian+closed+infinity,1-category#InternalLogic"} this discussion
              we may use
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              reasoning. Starting out with the discussion at
              %em
                %a{:href => "homotopy+pullback#InHomotopyTypeTheory"} homotopy pullback – In homotopy type theory
              we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi D
                            %msub
                              %mo ×
                              %mi G
                            %mo{:stretchy => "false"} (
                            %mi G
                            %mo ×
                            %mi G
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi d
                                %mo :
                                %mi D
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 1
                                %mo :
                                %mi G
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 2
                                %mo :
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo ⋅
                            %msubsup
                              %mi g
                              %mn 2
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi d
                                %mo :
                                %mi D
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 1
                                %mo :
                                %mi G
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 2
                                %mo :
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi d
                                %mo :
                                %mi D
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 2
                                %mo :
                                %mi G
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 1
                                %mo :
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi d
                                %mo :
                                %mi D
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msub
                                  %mi g
                                  %mn 2
                                %mo :
                                %mi G
                            %mstyle{:mathvariant => "bold"}
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi D
                            %mo ×
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    D\times_G  (G\times G)
                    \&amp;= \sum_{d:D} \sum_{g_1:G} \sum_{g_2:G} (g_1\cdot g_2^{-1} = \phi(d)) \\
                    \&amp;= \sum_{d:D} \sum_{g_1:G} \sum_{g_2:G} (g_1 = \phi(d)\cdot g_2) \\
                    \&amp;= \sum_{d:D} \sum_{g_2:G} \sum_{g_1:G} (g_1 = \phi(d)\cdot g_2) \\
                    \&amp;= \sum_{d:D} \sum_{g_2:G} \mathbf{1}\\
                    \&amp;= D\times G
                    \\end{aligned}
                    \\,,
            %p
              where the second but last step consists of observing a contractible based
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              (see the discussion at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
          .num_prop
            %h6#corollary_2 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+Cartesian+closed+%28%E2%88%9E%2C1%29-category"} locally Cartesian closed (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              object (or just a grouplike
              = succeed "-object)." do
                %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} f \colon X \to G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \colon Y \to G
              two morphisms, there is a Mayer-Vietoris-type
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %mi Ω
                    %mi G
                    %mo ⟶
                    %mi X
                    %msub
                      %mo ×
                      %mi G
                    %mi Y
                    %mo ⟶
                    %mi X
                    %mo ×
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mi f
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} )
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to \Omega G
                    \\longrightarrow
                    X \times_G Y
                    \\longrightarrow
                    X \times Y
                    \\stackrel{f \cdot (g^{-1})}{\longrightarrow}
                    G
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              Use prop.
              %a.maruku-ref{:href => "#HTTArgumentForPullback"}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              being the canonical point, i.e. the inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} e \colon \ast \to G
              of
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              neutral element to find the homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi Δ
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi e
                        %mtr
                          %mtd
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G  &amp;\longrightarrow&amp; \ast
                    \\\
                    \\downarrow^{\mathrlap{\Delta}} &amp;&amp; \downarrow^{\mathrlap{e}}
                    \\\
                    G \times G &amp;\stackrel{(-)\cdot (-)^{-1}}{\longrightarrow}&amp; G
                    }
                    \\,.
            %p
              Then use the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              as above.
          %h2#examples Examples
          %h3#CohomologyOfACover (Co)Homology of a cover
          %p
            A special case of the general Mayer-Vietoris sequence, corollary
            %a.maruku-ref{:href => "#LongExactSequenceOfHomotopyGroups"}
            – which historically was the first case considered – applies to the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U, V\}
          %p
            Being a
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            means (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism+in+an+%28%E2%88%9E%2C1%29-category"} effective epimorphism in an (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi U
                          %mo ∩
                          %mi V
                        %mtd
                          %mo ↪
                        %mtd
                          %mi U
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  U \cap V &amp;\hookrightarrow&amp; U
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  V &amp;\to&amp; X
                  }
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %p
            When this is
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            or in terms of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+spaces"} model structure on topological spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
          %p
            Let then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mn ∞
                  %mi Grpd
                  %mo ≃
                  %mi Top
                %annotation{:encoding => "application/x-tex"} A \in \infty Grpd \simeq Top
            be some coefficient object, for instance an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^n G
            (
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cdots \simeq K(G,n)
            %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
            with coefficients in an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Then applying the
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi op
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(-, A) : \mathbf{H}^{op} \to \infty Grpd
            yields the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ∩
                          %mi V
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}(X, A) &amp;\to&amp; \mathbf{H}(U,A)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbf{H}(V,A) &amp;\to&amp; \mathbf{H}(U \cap V, A)
                  }
          %p to which we can apply the homotopical Mayer-Vietoris sequence.
          %p
            Notice that (as discussed in detail at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,\mathbf{B}^n G)
            are the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi k
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_k \mathbf{H}(X, \mathbf{B}^n G)
                  \\simeq
                  H^{n-k}(X, G)
                  \\,.
          %p
            By the above
            %a{:href => "GeneralProperties"} general properties
            the above homotopy pullback is equivalent to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ∩
                  %mi V
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(X,A) \to \mathbf{H}(U,A) \times \mathbf{H}(V,A)
                  \\to \mathbf{H}(U \cap V, A)
          %p
            being a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            in
            = succeed "-cohomology." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            By duality (see
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/diamond+principle"} diamond principle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brown-Gersten+property"} Brown-Gersten property
          %h2#references References
          %p An original reference is
          %ul
            %li#EckmannHilton
              %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"} Beno Eckmann
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
              = succeed "," do
                %em Unions and intersections in homotopy theory
              %a{:href => "http://dx.doi.org/10.1007/BF02566918"} doi
          %p
            A more modern review that emphasizes the role of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequences"} homotopy fiber sequences
            is in
          %ul
            %li#DyerRoitberg80
              %a.existingWikiWord{:href => "/nlab/show/Eldon+Dyer"}> Eldon Dyer
              , Joseph Roitberg,
              = succeed "," do
                %em Note on sequence of Mayer-Vietoris type
              = succeed ")" do
                %a{:href => "http://www.ams.org/journals/proc/1980-080-04/S0002-9939-1980-0587950-8/S0002-9939-1980-0587950-8.pdf"} pdf
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/stable+model+categories"} stable model categories
            includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
              , lemma 5.7 of
              = succeed "," do
                %em The additivity of traces in triangulated categories
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~may/PAPERS/AddJan01.pdf"} pdf
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            includes
          %ul
            %li
              E Cavallo et al,
              %em Exactness of the Mayer-Vietoris Sequence in Homotopy Type Theory
              (
              %a{:href => "http://www.contrib.andrew.cmu.edu/~ecavallo/works/mayer-vietoris.pdf"}> pdf
              )
        .revisedby
