                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{ n_1 + n_2 -1 }
                    \&amp;
                    \\overset{
                    f_{n_1,n_2}
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    S^{n_1}
                    \\vee
                    S^{n_2}
                    \&amp;
                    \\overset{
                    (\phi_1, \phi_2)
                    }{\longrightarrow}
                    \&amp;
                    X
                    \\\
                    \\big\downarrow
                    \&amp;
                    (po)
                    \&amp;
                    \\big\downarrow
                    \\\
                    D^{ n_1 + n_2 }
                    \&amp;\underset{}{\longrightarrow}&amp;
                    S^{n_1} \times S^{n_2}
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} f_{n_1, n_2}
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %a.existingWikiWord{:href => "/nlab/show/attaching+map"} attaching map
              exhibiting the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times S^{n_2}
              as the result of a
              %a.existingWikiWord{:href => "/nlab/show/cell+attachment"} cell attachment
              to the
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ∨
                      %msup
                        %mi S
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} S^{n_1} \vee S^{n_2}
          %p
            In this form this appears for instance in
            = succeed "." do
              %a{:href => "#FelixHalperinThomas00"} Félix-Halperin-Thomas, p. 176 with p. 177
          %h3#generalized_version Generalized version
          %p
            There is also a
            %strong generalized Whitehead product
            where we can take more general homotopy classes (
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            up to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mo ⋅
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \alpha\in [S^\cdot Y,X]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi S
                    %mo ⋅
                  %mi Z
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \beta\in [S^\cdot Z,X]
            to produce a class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi α
                    %mo ,
                    %mi β
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Wh
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi Y
                    %mo ⋆
                    %mi Z
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\alpha,\beta]_{Wh}\in[Y\star Z,X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mo ⋅
                %annotation{:encoding => "application/x-tex"} S^\cdot
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
            operation on pointed spaces and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/join+of+spaces"} join
            of CW-complexes. Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi pt
                  %mo ⋆
                  %mi Z
                  %mo =
                  %msup
                    %mi C
                    %mo ⋅
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} pt\star Z = C^\cdot(Z)
            and the reduced
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            of a point is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} C^\cdot(pt)=S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mi Z
                  %mo =
                  %mi pt
                %annotation{:encoding => "application/x-tex"} Y=Z=pt
            the generalized Whitehead product reduced to the usual Whitehead product.
          %h2#properties Properties
          %h3#SuperLieAlgebraStructure Super Lie algebra structure
          %p
            If one assigns degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n-1
            to the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \pi_n
            %a.maruku-eqref{:href => "#eq:WhiteheadProductMapInSingleDegrees"} (1)
            organize into a single degree-0 bilinear pairing on the
            %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
            which is the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of all the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
          #eq:DegreeShiftedHomotopyGroups.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mrow
                              %mo •
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo =
                        %mtd
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⊕
                        %mtd
                          %msub
                            %mi π
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⊕
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ⊕
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                          %mi deg
                          %mo =
                        %mtd
                          %mn 0
                        %mtd
                        %mtd
                          %mn 1
                        %mtd
                        %mtd
                          %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_{\bullet + 1}(X)
                  \=
                  \&amp;
                  \\pi_1(X)
                  \&amp;\oplus&amp;
                  \\pi_2(X)
                  \&amp;\oplus&amp;
                  \\pi_3(X)
                  \&amp;\oplus&amp;
                  \\cdots
                  \\\
                  deg =
                  \&amp;
                  0
                  \&amp;&amp;
                  1
                  \&amp;&amp;
                  2
                  }
          %p
            This unified Whitehead product is
            %em graded
            skew-symmetric in that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi i
                  %mo ∈
                  %msub
                    %mi π
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \phi_i \in \pi_{n_i}\big( X \big)
            it satisfies
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi ϕ
                    %mn 1
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi ϕ
                    %mn 2
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mi Wh
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %msub
                        %mi n
                        %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msub
                    %mi ϕ
                    %mn 2
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi ϕ
                    %mn 1
                  %msub
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mi Wh
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  \\phi_1,
                  \\,
                  \\phi_2
                  \\big]_{Wh}
                  \\;=\;
                  (-1)^{ n_1 n_2 }
                  \\big[
                  \\phi_2,
                  \\,
                  \\phi_1
                  \\big]_{Wh}
          %p
            and it satisfies the corresponding graded
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            (
            %a{:href => "#Hilton55"}> Hilton 55, Theorem B
            ).
          %p
            This makes the Whitehead bracket the
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            of a
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{\bullet-1}(X)
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:DegreeShiftedHomotopyGroups"} (2)
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            of
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            (sometimes called, in this context, a
            = succeed "," do
              %em graded quasi-Lie algebra
            = succeed ")." do
              %a{:href => "#OfAnElementWithItself"} below
          %h3#OfAnElementWithItself Of elements with themselves
          %p
            Beware that the skew-symmetry of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            of
            %a.existingWikiWord{:href => "/nlab/show/even+number"} even
            homogeneous degree – hence here for elements of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            in
            %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd
            degree – only that the bracket with itself vanishes after multiplication by 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo ,
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Wh
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo ,
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Wh
                  %mphantom
                    %mi AA
                  %mtext hence equivalently
                  %mphantom
                    %mi AA
                  %mn 2
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo ,
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Wh
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  [\phi,\phi]_{Wh} = - [\phi,\phi]_{Wh}
                  \\phantom{AA}
                  \\text{hence equivalently}
                  \\phantom{AA}
                  2 \cdot [\phi,\phi]_{Wh} = 0
          %p
            but not necessarily that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ϕ
                  %mo ,
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Wh
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} [\phi,\phi]_{Wh} = 0
            by itself – since
            %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            by 2 is not an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          %p
            But this means that the Whitehead bracket of any even-degree
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            with itself – hence of any
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            of a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            in
            %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd
            degree – has
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group+element"} order
            at most 2, hence is in the 2-
            %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion subgroup
            of the respective
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
          %h3#as_primary_homotopy_operations As primary homotopy operations
          %p
            The Whitehead products form one of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/primary+homotopy+operations"} primary homotopy operations
          %p
            In fact, together with
            %a.existingWikiWord{:href => "/nlab/show/composition+operations"} composition operations
            and
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            they
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generate
            all such operations.
          %p
            This is related to the definition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pi-algebras"} Pi-algebras
          %h3#RelationToPontrjaginProduct Relation to Pontrjagin product
          %p
            Under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
            %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
            of the
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+product"} Pontrjagin product
            on integral
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} homology
            groups of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
          %p
            This is due to
            %a{:href => "#Samelson53"} Samelson (1953)
            and for higher Whitehead brackets due to
            = succeed "." do
              %a{:href => "#Arkowitz71"} Arkowitz (1971)
          %p
            In fact, in
            %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            the
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+ring"} Pontrjagin ring
            is the
            %a.existingWikiWord{:href => "/nlab/show/universal+enveloping+algebra"} universal enveloping algebra
            of the Whitehead bracket
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            \&amp;lbrack;
            %a{:href => "#MilnorMoore65"}> Milnor &amp; Moore (1965) Appendix
            \&amp;rbrack;.
          %p
            A textbook account is in
            = succeed "." do
              %a{:href => "#Whitehead78"} Whitehead (1978) Thm. X.7.10
          %h3#InTermsOfSamelsonProducts In terms of Samelson products
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
            %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %mo ≔
                  %mi Ω
                  %mi X
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{G} \coloneqq \Omega X
                  \\mathrlap{\,,}
          %p
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/grouplike+space"} grouplike space
            with a
            %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle-,-\rangle
            (essentially the
            %a.existingWikiWord{:href => "/nlab/show/group+commutator"} group commutator
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/looping+and+delooping"} looping and delooping
            relation)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %mi B
                  %mi 𝒢
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  X \simeq B \mathcal{G}
                  \\mathrlap{\,.}
          %p Then we have:
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
                on the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi π
                        %mi m
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msub
                        %mi π
                        %mrow
                          %mi n
                          %mo +
                          %mi m
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\langle -, - \rangle
                      \\;\colon\;
                      \\pi_n(\mathcal{G}) \times \pi_m(\mathcal{G})
                      \\longrightarrow
                      \\pi_{n+m}(\mathcal{G})
                      \\mathrlap{\,.}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+bracket"} Whitehead bracket
                on the homotopy groups of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msub
                        %mi π
                        %mi m
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %msub
                        %mi π
                        %mrow
                          %mi n
                          %mo +
                          %mi m
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      [- , - ]
                      \\;\colon\;
                      \\pi_n(X) \times \pi_m(X)
                      \\longrightarrow
                      \\pi_{n+m-1}(X)
                      \\mathrlap{\,,}
            %li
              %p
                the canonical
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              #eq:HomotopyGroupsUnderLoopingAndDelooping.maruku-equation
                %span.maruku-eq-number (3)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi π
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ∼
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\tau
                      \\,\colon\,
                      \\pi_{n+1}(X)
                      \\xrightarrow{ \sim }
                      \\pi_n(\mathcal{G})
                      \\mathrlap{\,.}
          %p
          .num_prop
            %h6 Proposition
            %p
              Under the isomorphism
              %a.maruku-eqref{:href => "#eq:HomotopyGroupsUnderLoopingAndDelooping"} (3)
              the
              %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
              on the homotopy groups of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              coincides up to a sign with the Whitehead bracket on the homotopy groups of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ≃
                      %mi B
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} X \simeq B \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi p
                      %mo ∈
                      %msub
                        %mi π
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha_p \in \pi_{p+1}(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi q
                    %mo ∈
                    %msub
                      %mi π
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta_q \in \pi_{q+1}(X)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi α
                      %mi p
                    %mo ,
                    %msub
                      %mi β
                      %mi q
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                    %mi τ
                    %msub
                      %mi α
                      %mi p
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi τ
                    %msub
                      %mi β
                      %mi q
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tau[\alpha_p, \beta_q]
                    \\;=\;
                    (-1)^p
                    \\big\langle
                    \\tau \alpha_p
                    ,\,
                    \\tau \beta_q
                    \\big\rangle
                    \\mathrlap{\,.}
            %p
          (cf.
          = succeed ")" do
            %a{:href => "#Whitehead78"} Whitehead 1978 §X.7 Thm 7.10 (p. 476)
          %p
          .num_remark
            %h6 Remark
            %p
            %p
              In the context of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
              representing
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
              %a.existingWikiWord{:href => "/nlab/show/shuffle"} shuffle
              product that is a kind of non-commutative version of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/product+of+simplices"} product of simplices
            %p
              This formula for the Whitehead product is due to
              %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"} Dan Kan
              and can be found in the old survey article of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Ed+Curtis"} Ed Curtis
              = succeed "." do
                %a{:href => "https://mathoverflow.net/q/296479/381"} MO:q/296479/381
            %p
          %h3#RelationToSullivanModels Relation to the Sullivan models
          %p
            We discuss (Prop.
            %a.maruku-ref{:href => "#CoBinarySullivanDifferentialIsWhiteheadProduct"}
            below) how the
            %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
            of the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
            is the co-binary part of the
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan differential
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %p
            In the following, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded module
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ∧
                  %mi W
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Sym
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi W
                  %mo ⊗
                  %mi W
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo{:stretchy => "false"} /
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi α
                  %mo ⊗
                  %mi β
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi n
                        %mi α
                      %msub
                        %mi n
                        %mi β
                  %mi β
                  %mo ⊗
                  %mi α
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  W \wedge W
                  \\;\coloneqq\;
                  Sym^2(W)
                  \\;\coloneqq\;
                  \\big(
                  W \otimes W
                  \\big)
                  \/
                  \\big(
                  \\alpha \otimes \beta
                  \\sim
                  (-1)^{ n_\alpha n_\beta }
                  \\beta \otimes \alpha
                  \\big)
                  \\,,
          %p
            where on the right
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ,
                  %mi β
                  %mo ∈
                  %mi W
                %annotation{:encoding => "application/x-tex"} \alpha, \beta \in W
            are elements of homogeneous degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi α
                    %mo ,
                    %msub
                      %mi n
                      %mi β
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n_\alpha, n_\beta \in \mathbb{Z}
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\wedge(-)
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebras"} Grassmann algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
            with
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
          #eq:SullivanModelX.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔩
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ,
                  %msub
                    %mi d
                    %mi X
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  CE( \mathfrak{l} X )
                  \\;=\;
                  \\big(
                  Sym^\bullet\big(V^\ast\big), d_X
                  \\big)
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"} V^\ast
            the
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            of generators, which is the
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %a.existingWikiWord{:href => "/nlab/show/dual+space"} dual
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            of the
            %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            (=
            %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"}> graded abelian group
            ) of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Hom
                    %mi Ab
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℚ
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  V^\ast
                  \\;\coloneqq\;
                  Hom_{Ab}\big(
                  \\pi_\bullet(X),
                  \\mathbb{Q}
                  \\big)
                  \\,.
          %p
            Declare the
            %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
            pairing to be given by
          #eq:WedgeProductNormalization.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi V
                            %mo *
                          %mo ∧
                          %msup
                            %mi V
                            %mo *
                        %mtd
                          %mover
                            %mo ⟶
                            %mi Φ
                        %mtd
                          %msub
                            %mi Hom
                            %mi Ab
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ℚ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo ,
                          %mi β
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mi v
                          %mo ∧
                          %mi w
                          %mspace{:width => "thickmathspace"}
                          %mo ↦
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi n
                                %mi α
                              %mo ⋅
                              %msub
                                %mi n
                                %mi β
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi β
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi α
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V^\ast
                  \\wedge
                  V^\ast
                  \&amp;\overset{\Phi}{\longrightarrow}&amp;
                  Hom_{Ab}
                  \\big(
                  \\pi_\bullet(X) \wedge \pi_\bullet(X)
                  ,
                  \\mathbb{Q}
                  \\big)
                  \\\
                  (\alpha, \beta)
                  \&amp;\mapsto&amp;
                  \\Big(
                  v \wedge w
                  \\;\mapsto\;
                  (-1)^{ n_\alpha \cdot n_\beta }
                  \\alpha(v)\cdot \beta(w)
                  +
                  \\beta(v)\cdot \alpha(w)
                  \\Big)
                  }
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            are assumed to be of homogeneous degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi α
                    %mo ,
                    %msub
                      %mi n
                      %mi β
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_\alpha, n_\beta \in \mathbb{N}
          %p
            (Notice that the usual normalization factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 1/2
            is
            %em not
            included on the right. This normalization follows
            = succeed ".)" do
              %a{:href => "#AndrewsArkowitz78"} Andrews &amp; Arkowitz 1978, above Thm. 6.1
          %p Finally, write
          #eq:PojectionToBinary.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Sym
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi V
                    %mo *
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi V
                    %mo *
                  %mo ∧
                  %msup
                    %mi V
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  [-]_2
                  \\;\colon\;
                  Sym^\bullet\big(V^\ast\big)
                  \\longrightarrow
                  V^\ast \wedge V^\ast
          %p
            for the linear projection on quadratic polynomials in the graded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+algebra"} symmetric algebra
          %p Then:
          #CoBinarySullivanDifferentialIsWhiteheadProduct.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/co-binary+Sullivan+differential+is+Whitehead+product"}> co-binary Sullivan differential is Whitehead product
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected topological space
              of rational
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              with Sullivan differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi X
                  %annotation{:encoding => "application/x-tex"} d_X
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SullivanModelX"} (4)
            %p
              Then the co-binary component
              %a.maruku-eqref{:href => "#eq:PojectionToBinary"} (6)
              of the Sullivan differential equals the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              %a.existingWikiWord{:href => "/nlab/show/linear+dual+map"} linear dual map
              of the
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi X
                  %annotation{:encoding => "application/x-tex"} [-,-]_X
              on the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi d
                      %mi X
                    %mi α
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mi X
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [d_X \alpha]_2
                    \\;=\;
                    [-,-]_X^\ast
                    \\,.
            %p
              More explicitly, the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi V
                              %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mn 2
                                %mo ∘
                                %msub
                                  %mi d
                                  %mi X
                          %mtd
                            %msup
                              %mi V
                              %mo *
                            %mo ∧
                            %msup
                              %mi V
                              %mo *
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mo =
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mo
                                  %mi Φ
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi Ab
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ℚ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi Hom
                                  %mi Ab
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msub
                                  %mo{:stretchy => "false"} ]
                                  %mi X
                                %mo ,
                                %mspace{:width => "thickmathspace"}
                                %mi ℚ
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %msub
                              %mi Hom
                              %mi Ab
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thickmathspace"}
                            %mi ℚ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V^\ast
                    \&amp;\overset{ [-]_2\circ d_X }{\longrightarrow}&amp;
                    V^\ast \wedge V^\ast
                    \\\
                    \\big\downarrow\mathrlap{^=}
                    \&amp;&amp;
                    \\big\downarrow\mathrlap{^\Phi}
                    \\\
                    Hom_{Ab}
                    \\big(
                    \\pi_\bullet(X),
                    \\mathbb{Q}
                    \\big)
                    \&amp;
                    \\underset{
                    Hom_{Ab}\big(
                    [-,-]_X
                    ,
                    \\;
                    \\mathbb{Q}
                    \\big)
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    Hom_{Ab}
                    \\big(
                    \\pi_\bullet(X)
                    \\wedge
                    \\pi_\bullet(X),
                    \\;
                    \\mathbb{Q}
                    \\big)
                    }
                    \\,,
            %p
              where the wedge product on the right is normalized as in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:WedgeProductNormalization"} (5)
          %p
            (
            %a{:href => "#AndrewsArkowitz78"}> Andrews &amp; Arkowitz 1978, Thm. 6.1
            , following
            = succeed ")" do
              %a{:href => "#DeligneGriffithsMorganSullivan75"} Deligne, Griffiths, Morgan &amp; Sullivan 1975
          %p
          #AbsenceOfJacobiatorInWhiteheadBracket.num_remark
            %h6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#CoBinarySullivanDifferentialIsWhiteheadProduct"}
              says in particular that the binary bracket of the
              %a.existingWikiWord{:href => "/nlab/show/L-infinity-algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebra
              dual to a
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
              is always an actual
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+bracket"} super Lie bracket
              in that it satisfies its super-
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"}> Jacobi identity
              , even if there happens to also be a nontrivial trinary bracket which would serve as a “
              %a.existingWikiWord{:href => "/nlab/show/Jacobiator"}> Jacobiator
              ”.
            %p
              This is due to the
              %a.existingWikiWord{:href => "/nlab/show/minimal+model"} minimality
              of Sullivan models, which implies that the co-unary part of their
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              vanishes, and hence that that the unary bracket of the corresponding
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
          %h3#relation_to_goodwillie_calculus Relation to Goodwillie Calculus:
          %p
            On the relation to
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+calculus"} Goodwillie calculus
            see e.g.
            = succeed "," do
              %a{:href => "#SchererChorny11"} Scherer &amp; Chorny 2011, Sec. 1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Samelson+products"} Samelson products
          %h2#examples Examples
          #WhiteheadProductCorrespondingToComplexHopfFibration.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Whitehead+product"} Whitehead product
                corresponding to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X = S^2
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              of its
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups+of+spheres"}> of spheres
              , as it were):
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi id
                          %mrow
                            %msup
                              %mi S
                              %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi π
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} [id_{S^2}] \in \pi_2\big( S^2 \big)
                  (represented by the
                  %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 2
                          %mo →
                          %msup
                            %mi S
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} S^2 \to S^2
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi h
                          %mi ℂ
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi π
                          %mn 3
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} [h_{\mathbb{C}}] \in \pi_3\big(  S^2 \big)
                  (represented by the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/complex+Hopf+fibration"} complex Hopf fibration
            %p Then the Whitehead product satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi id
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 2
                    %mo ⋅
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi h
                      %mi ℂ
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≕
                    %mn 2
                    %mi η
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    [id_{S^2}],
                    \\;
                    [id_{S^2}]
                    \\big]
                    \\;=\;
                    2 \cdot [h_{\mathbb{C}}]
                    \\eqqcolon 2 \eta
                    \\,.
          %p
            Generally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi k
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  [id_{S^{2k}}],
                  \\;
                  [id_{S^{2k}}]
                  \\big]
            has
            %a.existingWikiWord{:href => "/nlab/show/Hopf+invariant"} Hopf invariant
            2 (
            %a{:href => "#Whitehead78"}> Whitehead 1978 Thm. 2.5 on p. 495
            , using the notation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi n
                  %mo ≔
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \iota_n \coloneqq [id_{S^{n}}]
            introduced on p. 194).
          %p So we have similarly that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 4
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi h
                    %mi ℍ
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≕
                  %mn 2
                  %mi ν
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  [id_{S^4}],
                  \\;
                  [id_{S^4}]
                  \\big]
                  \\;=\;
                  2 \cdot [h_{\mathbb{H}}]
                  \\eqqcolon 2 \nu
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi ℍ
                %annotation{:encoding => "application/x-tex"} h_{\mathbb{H}}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 8
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi id
                    %mrow
                      %msup
                        %mi S
                        %mn 8
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 2
                  %mo ⋅
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi h
                    %mi 𝕆
                  %mo{:stretchy => "false"} ]
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ≕
                  %mn 2
                  %mi σ
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  [id_{S^8}],
                  \\;
                  [id_{S^8}]
                  \\big]
                  \\;=\;
                  2 \cdot [h_{\mathbb{O}}]
                  \\eqqcolon 2 \sigma
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi 𝕆
                %annotation{:encoding => "application/x-tex"} h_{\mathbb{O}}
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/octonionic+Hopf+fibration"} octonionic Hopf fibration
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+product"} Pontrjagin product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Samelson+product"} Samelson product
          %h2#references References
          %h3#general General
          %p The concept is due to
          %ul
            %li#Whitehead41
              %a.existingWikiWord{:href => "/nlab/show/J.+H.+C.+Whitehead"}> J. H. C. Whitehead
              , Section 3 ofL
              = succeed "," do
                %em On Adding Relations to Homotopy Groups
              %strong 42
              2 (1941) 409-428 &amp;lbrack;
              %a{:href => "https://www.jstor.org/stable/1968907"}> jstor:1968907
              \&amp;rbrack;
          %p with further early discussion in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/George+W.+Whitehead"}> George W. Whitehead
                \:
                = succeed "," do
                  %em On Products in Homotopy Groups
                %strong 47
                3 (1946) 460-475 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/1969085"}> doi:10.2307/1969085
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/1969085"} jstor:1969085
            %li#HiltonWhitehead53
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"}> Peter Hilton
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/J.+H.+C.+Whitehead"} J. H. C. Whitehead
                = succeed "," do
                  %em Note on the Whitehead Product
                %strong 58
                3 (1953) 429-442 &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/1969746"}> jstor:1969746
                \&amp;rbrack;
            %li#Hilton55
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"}> Peter Hilton
                ,
                = succeed "," do
                  %em On the homotopy groups of unions of spheres
                %strong 30
                (1955) 154–172 &amp;lbrack;
