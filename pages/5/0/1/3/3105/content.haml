              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-6318-0"} doi:10.1007/978-1-4612-6318-0
          %p See also
          %ul
            %li
              Wikipedia
              %em
                %a{:href => "http://en.wikipedia.org/wiki/Whitehead_product"} Whitehead product
          %p
